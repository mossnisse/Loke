// Lexical path operations (standard-library-plan "`core:path`").
//
// Everything here is **lexical**: no procedure in this package touches the
// filesystem. `clean` removes redundant separators and `.`/`..` elements without
// resolving a symlink or asking whether anything exists, which is why it can be
// used on a path for a file that has not been created yet. Resolution against a
// real filesystem belongs in `core:fs`, and returns an I/O error.
//
// Paths are UTF-8 `string_view`s. Results that own storage take an allocator,
// like every other owning result in the library.
@(public)
package path;

import "core:mem";
import "core:strings";

// design.md's rule for platform code: one file, `when` inside it, no per-target
// source selection. `LOKE_OS` is a fixed `.Windows` today, so the other branch
// exists and is never taken.
when (LOKE_OS == .Windows) {
	SEPARATOR :: '\\';
	@(private) ALTERNATE :: '/';
} else {
	SEPARATOR :: '/';
	@(private) ALTERNATE :: '/';
}

separator :: proc() -> rune { return SEPARATOR; }

@(private)
is_separator :: proc(value: u8) -> bool {
	return value == u8(SEPARATOR) || value == u8(ALTERNATE);
}

// Whether the path names a location without needing a current directory *or* a
// current drive. On Windows `C:\x` and `\\server\share\x` are absolute, while
// `\x` (drive-relative) and `C:x` (directory-relative) are not — a distinction
// that only shows up in tests written for it.
is_absolute :: proc(path: string_view) -> bool {
	volume := volume_length(path);
	if (volume == 0) { return false; }
	rest := path.bytes()[volume:];
	// A UNC volume is already `\\server\share`, which is rooted by construction.
	if (volume > 2) { return true; }
	return len(rest) > 0 && is_separator(rest[0]);
}

// The leading volume, or "": `C:` for a drive path, `\\server\share` for a UNC
// one. Nothing above it can be created, removed, or walked, which is what a
// caller needs it for.
volume :: proc(path: string_view) -> string_view {
	return path[0:volume_length(path)];
}

// The length of the leading volume: `C:`, `\\server\share`, or nothing.
@(private)
volume_length :: proc(path: string_view) -> int {
	bytes := path.bytes();
	if (len(bytes) >= 2 && bytes[1] == u8(':') && is_drive_letter(bytes[0])) {
		return 2;
	}
	if (len(bytes) < 5 || !is_separator(bytes[0]) || !is_separator(bytes[1])) {
		return 0;
	}
	// `\\server\share`: two elements, both non-empty.
	at := 2;
	for (; at < len(bytes) && !is_separator(bytes[at]); at += 1) {}
	if (at == 2 || at >= len(bytes)) { return 0; }
	at += 1;
	start := at;
	for (; at < len(bytes) && !is_separator(bytes[at]); at += 1) {}
	return 0 if at == start else at;
}

@(private)
is_drive_letter :: proc(value: u8) -> bool {
	return (value >= u8('a') && value <= u8('z')) || (value >= u8('A') && value <= u8('Z'));
}

// The last element. A trailing separator is ignored, so `base("a/b/")` is `b`.
base :: proc(path: string_view) -> string_view {
	trimmed := without_trailing_separators(path);
	bytes := trimmed.bytes();
	at := len(bytes);
	for (; at > 0 && !is_separator(bytes[at - 1]); at -= 1) {}
	return trimmed[at:];
}

// Everything before the last element, with no trailing separator except at a
// root. A path with no separator at all has the directory `.`.
directory :: proc(path: string_view) -> string_view {
	trimmed := without_trailing_separators(path);
	bytes := trimmed.bytes();
	volume := volume_length(trimmed);
	at := len(bytes);
	for (; at > volume && !is_separator(bytes[at - 1]); at -= 1) {}
	if (at == volume) {
		return "." if volume == 0 else trimmed[0:volume];
	}
	// Keep exactly one separator when it is the root itself.
	if (at == volume + 1) { return trimmed[0:at]; }
	return trimmed[0:at - 1];
}

// The extension of the last element, **including** the dot, or "". A leading dot
// names a hidden file rather than an extension, so `extension(".config")` is "".
extension :: proc(path: string_view) -> string_view {
	name := base(path);
	bytes := name.bytes();
	for (at := len(bytes); at > 1; at -= 1) {
		if (bytes[at - 1] == u8('.')) {
			return name[at - 1:];
		}
	}
	return "";
}

// The last element without its extension.
stem :: proc(path: string_view) -> string_view {
	name := base(path);
	return name[0:len(name) - len(extension(name))];
}

@(private)
without_trailing_separators :: proc(path: string_view) -> string_view {
	volume := volume_length(path);
	bytes := path.bytes();
	end := len(bytes);
	// Never past the root: `C:\` and `\` keep their separator.
	for (; end > volume + 1 && is_separator(bytes[end - 1]); end -= 1) {}
	return path[0:end];
}

// The parts as one path, cleaned. Empty parts are dropped, so joining with ""
// changes nothing.
//
// A slice rather than a variadic: a variadic absorbs every trailing argument, so
// a defaulted allocator before one could never be omitted and one after it could
// never be supplied.
join :: proc(
	parts: []string_view, allocator: Allocator = mem.default_allocator(),
) -> string {
	builder := strings.init(allocator);
	foreach (part in parts) {
		if (len(part) == 0) { continue; }
		if (builder.len() > 0) { builder.append(SEPARATOR); }
		builder.append(part);
	}
	joined := builder.finish();
	cleaned := clean(joined, allocator);
	return cleaned;
}

// Redundant separators, `.` elements, and resolvable `..` elements removed. The
// result uses the target's separator throughout.
//
// This is a *lexical* rewrite: `a/b/../c` becomes `a\c` whether or not `b` is a
// symbolic link, which is why `fs` gets a separate resolving operation.
//
// ponytail: an extended-length `\\?\` path is returned unchanged. Those exist
// precisely to bypass normalization — Windows passes them to the filesystem
// verbatim — so rewriting one would be wrong. Full support means understanding
// `\\?\UNC\`, and belongs with whatever first needs it.
clean :: proc(path: string_view, allocator: Allocator = mem.default_allocator()) -> string {
	if (strings.starts_with(path, "\\\\?\\")) {
		return strings.clone(path, allocator);
	}
	volume := volume_length(path);
	rest := path[volume:];
	rooted := len(rest) > 0 && is_separator(rest.bytes()[0]);

	// The element stack, as offsets into `rest`: cleaning never invents text.
	elements, made := make([dynamic]string_view, 0, 8, allocator);
	if (made != nil) { panic("path cleaning allocation failed"); }
	foreach (element in split_elements(rest)) {
		if (len(element) == 0 || element == ".") { continue; }
		if (element == "..") {
			if (len(elements) > 0 && elements[len(elements) - 1] != "..") {
				elements.pop();
				continue;
			}
			// A rooted path has nothing above its root to name.
			if (rooted) { continue; }
		}
		elements.append(element);
	}

	builder := strings.init(allocator);
	builder.append(path[0:volume]);
	if (rooted) { builder.append(SEPARATOR); }
	foreach (element, index in elements) {
		if (index > 0) { builder.append(SEPARATOR); }
		builder.append(element);
	}
	if (builder.len() == 0) { builder.append("."); }
	return builder.finish();
}

// Elements between separators, in order. Empty elements are yielded and the
// caller drops them, which is what collapses a run of separators.
@(private)
split_elements :: proc(path: string_view) -> Element_Iterator {
	return Element_Iterator{path, false};
}

@(private)
Element_Iterator :: struct {
	rest: string_view,
	done: bool,
}

impl Element_Iterator {
	Element  :: string_view;
	Iterator :: Element_Iterator;

	iter :: proc(self) -> Element_Iterator { return self; }

	next :: proc(self: inout Element_Iterator) -> (string_view, bool) {
		if (self.done) { return "", false; }
		bytes := self.rest.bytes();
		at := 0;
		for (; at < len(bytes) && !is_separator(bytes[at]); at += 1) {}
		element := self.rest[0:at];
		if (at == len(bytes)) {
			self.done = true;
			return element, len(element) > 0;
		}
		self.rest = self.rest[at + 1:];
		return element, true;
	}
}
