// Generated by `lokec -api` from this directory's .loke files. Do not edit.

// Lexical path operations.
//
// Everything here is **lexical**: no procedure in this package touches the
// filesystem. `clean` removes redundant separators and `.`/`..` elements without
// resolving a symlink or asking whether anything exists, which is why it can be
// used on a path for a file that has not been created yet. Resolution against a
// real filesystem belongs in `core:fs`, and returns an I/O error.
//
// Paths are UTF-8 `string_view`s. Results that own storage take an allocator,
// like every other owning result in the library.
package path;

import "core:mem";

separator :: proc() -> rune ---;

// Whether the path names a location without needing a current directory *or* a
// current drive. On Windows `C:\x` and `\\server\share\x` are absolute, while
// `\x` (drive-relative) and `C:x` (directory-relative) are not.
is_absolute :: proc(path: string_view) -> bool ---;

// The leading volume, or "": `C:` for a drive path, `\\server\share` or
// `\\?\UNC\server\share` for a UNC one. Nothing above it can be created,
// removed, or walked, which is what a caller needs it for.
volume :: proc(path: string_view) -> string_view ---;

// The last element. A trailing separator is ignored, so `base("a/b/")` is `b`,
// and the volume is never part of it: `base("C:a")` is `a`, while a root -- a
// `C:\` or a `\\server\share` -- has no last element at all.
base :: proc(path: string_view) -> string_view ---;

// Everything before the last element, with no trailing separator except at a
// root. A path with no separator at all has the directory `.`.
directory :: proc(path: string_view) -> string_view ---;

// The extension of the last element, **including** the dot, or "". A leading dot
// names a hidden file rather than an extension, so `extension(".config")` is "",
// and `..` names the parent rather than a file with the extension `.`.
extension :: proc(path: string_view) -> string_view ---;

// The last element without its extension.
stem :: proc(path: string_view) -> string_view ---;

// The parts as one path, cleaned. Empty parts are dropped, so joining with ""
// changes nothing.
join :: proc(
	parts: []string_view, allocator: Allocator = mem.default_allocator(),
) -> string ---;

// Redundant separators, `.` elements, and resolvable `..` elements removed. The
// result uses the target's separator throughout.
//
// This is a *lexical* rewrite: `a/b/../c` becomes `a\c` whether or not `b` is a
// symbolic link, which is why `fs` gets a separate resolving operation.
//
// `allocator` takes the scratch as well as the result: the element stack and the
// builder both come from it. Against the heap that is invisible, but a caller
// sizing a `mem.Arena` should budget a few times the result rather than exactly
// it — a bump region reclaims a dropped temporary only at `free_all`.
//
// An extended-length `\\?\` path is returned unchanged. Those exist
// precisely to bypass normalization — Windows passes them to the filesystem
// verbatim — so rewriting one would be wrong.
clean :: proc(path: string_view, allocator: Allocator = mem.default_allocator()) -> string ---;
