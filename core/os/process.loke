/**
	Process state: the environment, the working directory, and the executable's
	own path.

	Files are **not** here. `core:os` is process state; opening a file is
	`core:fs.open`. Starting another process is `core:process`.
*/
// standard-library "`core:os` additions".
@(public)
package os;

import "core:encoding/utf16";
import "core:io";
import "core:mem";
import "core:unsafe";

// No non-Windows backend yet; `LOKE_OS` is a fixed `.Windows`.
when (LOKE_OS == .Windows) {

/**
	The value of `name`, or `.none` when it is not set at all. `Option` is what
	separates a missing variable from one whose value is the empty string; the
	owning result uses the supplied allocator.

	A name or value that is not valid Unicode is `Invalid_Data`: the library's
	contract is UTF-8, and a native string that cannot be represented is reported
	rather than silently changed.
	All environment operations reject an empty name, `=`, or U+0000 before the
	platform call.
*/
// standard-library "`core:os` additions".
get_environment :: proc(
	name: string_view, allocator: Allocator = mem.default_allocator(),
) -> Result(Option(string), io.Error) {
	encoded := wide_environment_name(name) or_return;

	// A short value fits the stack buffer, which needs no size query. A call too
	// small for the value answers the length *including* the terminator; one that
	// fits answers the length without it. Another thread can resize or remove the
	// variable between calls, so grow and retry until the value fits.
	//
	// An empty value that fits answers zero, as a failure does, and a successful
	// call leaves the thread's last error as it was. So the last error is cleared
	// before each call, and a zero with it still clear is the empty value -- the
	// case `Option` exists to tell from `.none`.
	small: [256]u16 = {};
	heap: [dynamic]u16 = {};
	units := small[mut :];
	for (;;) {
		rt_set_last_error(0);
		written := rt_get_environment(unsafe.raw_data(encoded), unsafe.raw_data(units), u32(units.len()));
		if (written == 0) {
			code := rt_last_error();
			if (code == 0) { return .ok(.some(from_wide({}, allocator, .Environment) or_return)); }
			error := io.from_native_code(code, .Environment);
			if (io.is(error, .Not_Found)) { return .ok(.none); }
			return .err(error);
		}
		if (int(written) < units.len()) {
			return .ok(.some(from_wide(units[0:int(written)], allocator, .Environment) or_return));
		}
		heap = wide_buffer(int(written), .Environment) or_return;
		units = heap[mut :];
	}
}

/**
	A variable set to the empty string is present and empty: a later
	`get_environment` answers `.some("")`, not `.none`.
*/
set_environment :: proc(name: string_view, value: string_view) -> Status(io.Error) {
	encoded_name := wide_environment_name(name) or_return;
	encoded_value := wide(value, .Environment) or_return;
	if (rt_set_environment(unsafe.raw_data(encoded_name), unsafe.raw_data(encoded_value)) == 0) {
		return .err(from_last_error(.Environment));
	}
}

unset_environment :: proc(name: string_view) -> Status(io.Error) {
	encoded := wide_environment_name(name) or_return;
	// A null value removes the variable.
	if (rt_set_environment(unsafe.raw_data(encoded), nil) == 0) {
		return .err(from_last_error(.Environment));
	}
}

working_directory :: proc(
	allocator: Allocator = mem.default_allocator(),
) -> Result(string, io.Error) {
	// The same grow and retry as `get_environment`: another thread can change the
	// directory between calls.
	small: [260]u16 = {};
	heap: [dynamic]u16 = {};
	units := small[mut :];
	for (;;) {
		written := rt_get_directory(u32(units.len()), unsafe.raw_data(units));
		if (written == 0) {
			return .err(from_last_error(.Working_Directory));
		}
		if (int(written) < units.len()) {
			return from_wide(units[0:int(written)], allocator, .Working_Directory);
		}
		heap = wide_buffer(int(written), .Working_Directory) or_return;
		units = heap[mut :];
	}
}

set_working_directory :: proc(path: string_view) -> Status(io.Error) {
	encoded := wide(path, .Working_Directory) or_return;
	if (rt_set_directory(unsafe.raw_data(encoded)) == 0) {
		return .err(from_last_error(.Working_Directory));
	}
}

executable_path :: proc(
	allocator: Allocator = mem.default_allocator(),
) -> Result(string, io.Error) {
	// `GetModuleFileNameW` has no size query: it fills whatever it is given and
	// says so, which is indistinguishable from "it exactly fitted". Growing until
	// the answer is shorter than the buffer is the documented way to be sure.
	small: [260]u16 = {};
	heap: [dynamic]u16 = {};
	units := small[mut :];
	for (;;) {
		written := rt_module_file_name(0, unsafe.raw_data(units), u32(units.len()));
		if (written == 0) {
			return .err(from_last_error(.Executable_Path));
		}
		if (int(written) < units.len()) {
			return from_wide(units[0:int(written)], allocator, .Executable_Path);
		}
		if (units.len() * 2 > 65536) {
			return .err(io.make_error(.Limit_Exceeded, .Executable_Path));
		}
		heap = wide_buffer(units.len() * 2, .Executable_Path) or_return;
		units = heap[mut :];
	}
}

foreign import kernel32 "system:kernel32.lib";

@(private)
foreign kernel32 {
	@(link_name="GetEnvironmentVariableW")
	rt_get_environment :: proc "stdcall" (name: [^]u16, buffer: [^]u16, size: u32) -> u32 ---;
	@(link_name="SetEnvironmentVariableW")
	rt_set_environment :: proc "stdcall" (name: [^]u16, value: [^]u16) -> i32 ---;
	@(link_name="GetCurrentDirectoryW")
	rt_get_directory :: proc "stdcall" (size: u32, buffer: [^]u16) -> u32 ---;
	@(link_name="SetCurrentDirectoryW")
	rt_set_directory :: proc "stdcall" (path: [^]u16) -> i32 ---;
	@(link_name="GetModuleFileNameW")
	rt_module_file_name :: proc "stdcall" (module: int, buffer: [^]u16, size: u32) -> u32 ---;
	@(link_name="GetLastError")
	rt_last_error :: proc "stdcall" () -> u32 ---;
	@(link_name="SetLastError")
	rt_set_last_error :: proc "stdcall" (code: u32) ---;
}

@(private)
from_last_error :: proc(operation: io.Operation) -> io.Error {
	return io.from_native_code(rt_last_error(), operation);
}

// A validated environment variable name, encoded for the platform call.
@(private)
wide_environment_name :: proc(name: string_view) -> Result([dynamic]u16, io.Error) {
	if (name.len() == 0) { return .err(io.make_error(.Invalid_Data, .Environment)); }
	foreach (byte in name.bytes()) {
		if (byte == 0 || byte == u8('=')) {
			return .err(io.make_error(.Invalid_Data, .Environment));
		}
	}
	return wide(name, .Environment);
}

@(private)
wide :: proc(text: string_view, operation: io.Operation) -> Result([dynamic]u16, io.Error) {
	switch (utf16.encode(text, mem.default_allocator())) {
	case .ok(units):
		return move(units);
	case .err(error):
		code := io.Code.Out_Of_Memory if error == .Out_Of_Memory else io.Code.Invalid_Data;
		return .err(io.make_error(code, operation));
	}
}

// A heap buffer of `count` units for a read the stack buffer could not hold.
@(private)
wide_buffer :: proc(count: int, operation: io.Operation) -> Result([dynamic]u16, io.Error) {
	switch (try_make([dynamic]u16, count, count, mem.default_allocator())) {
	case .ok(made):
		return move(made);
	case .err:
		return .err(io.make_error(.Out_Of_Memory, operation));
	}
}

// Decodes a wide buffer into an owning `string`.
@(private)
from_wide :: proc(
	units: []u16, allocator: Allocator, operation: io.Operation,
) -> Result(string, io.Error) {
	switch (utf16.decode(units, allocator)) {
	case .ok(text):
		return text;
	case .err(error):
		code := io.Code.Out_Of_Memory if error == .Out_Of_Memory else io.Code.Invalid_Data;
		return .err(io.make_error(code, operation));
	}
}

}
