/// `Atomic(T)`, `fence`, `Once`, and `Lazy(T)`.
///
/// **Ordering arguments are `$` parameters throughout**, so an ordering must
/// be a constant at the call.
///
/// Data races are not checked: a race is undefined behaviour, and there are no
/// implicit `Send`/`Sync` interfaces.
// design.md "Concurrency and the memory model", design.md "Atomic operations
// and Once".
//
// The compiler owns the operations whose ordering is part of the instruction,
// and everything here is ordinary Loke over them. A constant at the caller
// does not make an ordinary parameter constant inside this body, and the
// intrinsics require a constant — so forwarding an ordering through a runtime
// parameter would not compile, and a `$` one keeps it constant across the
// boundary. The compiler lowers the memory model rather than verifying it.
@(public)
package sync;

import "base:interfaces";
import "core:unsafe";

// The compiler contributes `Memory_Order`, the `base:runtime` enum, publicly as
// `sync.Memory_Order` (described below), and, package-privately:
//
//   atomic_load, atomic_store, atomic_exchange, atomic_compare_exchange
//   atomic_add, atomic_sub, atomic_and, atomic_or, atomic_xor
//   atomic_fence
//
// The fence intrinsic is `atomic_fence` and the public wrapper is `fence`,
// because a contributed name and a source declaration share one package scope
// and two `fence`s would be a redeclaration.

/// The ordering an atomic operation asks for: `base:runtime`'s enum, so an
/// ordering forwarded through a `$` parameter keeps meaning what it meant.
@(intrinsic)
Memory_Order :: enum { Relaxed, Acquire, Release, Acquire_Release, Sequentially_Consistent }

/// The atomic types are `bool`, the integer and rune types, an enum over a
/// supported integer, and any pointer. The arithmetic operations are integers
/// only.
///
/// The zero value is `T`'s zero, and nothing has to run before it is usable.
///
/// `move_only`, because a copy of an atomic is a *non-atomic* read of it that
/// hands back a second, unrelated atomic. A record holding one is move-only
/// too.
// Integers only is design.md's own rule that an enum member is a named
// constant rather than a number with a name. design.md propagates `move_only`
// structurally, so `Once` below is move-only too.
Atomic :: move_only struct($T: type) {
	/// Public, because a caller that has exclusive access — during
	/// construction, or after joining every other thread — reads and writes it
	/// without paying for a synchronizing operation. Every *atomic* access goes
	/// through the methods below.
	///
	/// Synchronized: outside this package, `value` is reached only through an
	/// owner nothing borrows, or through `^mut`, `[]mut`, or `inout`, never
	/// through a read-only `^`, where an atomic operation may be writing it.
	@(public, synchronized) value: T,
}

// Every operation takes a read-only `^` receiver, writes included: no atomic
// access conflicts with another (design.md "Concurrency and the memory model"),
// so an atomic reached through a `^T`, such as a `Shared(T)` payload, still
// updates. A copy of the receiver would be a non-atomic read, so even `load`
// borrows rather than taking a plain `self`.
impl Atomic($T) {
	load :: proc(self: ^, $order: Memory_Order = Memory_Order.Sequentially_Consistent) -> T {
		return atomic_load(&self.value, order);
	}

	store :: proc(
		self: ^, value: T,
		$order: Memory_Order = Memory_Order.Sequentially_Consistent,
	) {
		atomic_store(&self.value, value, order);
	}

	/// The previous value.
	exchange :: proc(
		self: ^, value: T,
		$order: Memory_Order = Memory_Order.Sequentially_Consistent,
	) -> T {
		return atomic_exchange(&self.value, value, order);
	}

	/// Writes `desired` if the value is `expected`. `swapped` says whether the
	/// write happened, and `observed` is what was there — the value replaced when
	/// it swapped, and the value that stopped it when it did not.
	// Both orderings stay constants across this boundary, which is what the two
	// `$` parameters are for.
	compare_exchange :: proc(
		self: ^, expected: T, desired: T,
		$success: Memory_Order = Memory_Order.Sequentially_Consistent,
		$failure: Memory_Order = Memory_Order.Sequentially_Consistent,
	) -> (observed: T, swapped: bool) {
		switch (atomic_compare_exchange(&self.value, expected, desired, success, failure)) {
		case .some(found): return {observed = found, swapped = false};
		case .none: return {observed = expected, swapped = true};
		}
		return {observed = expected, swapped = false};
	}

	/// The five read-modify-writes, each answering the *previous* value.
	add :: proc(
		self: ^, value: T,
		$order: Memory_Order = Memory_Order.Sequentially_Consistent,
	) -> T {
		return atomic_add(&self.value, value, order);
	}

	sub :: proc(
		self: ^, value: T,
		$order: Memory_Order = Memory_Order.Sequentially_Consistent,
	) -> T {
		return atomic_sub(&self.value, value, order);
	}

	bit_and :: proc(
		self: ^, value: T,
		$order: Memory_Order = Memory_Order.Sequentially_Consistent,
	) -> T {
		return atomic_and(&self.value, value, order);
	}

	bit_or :: proc(
		self: ^, value: T,
		$order: Memory_Order = Memory_Order.Sequentially_Consistent,
	) -> T {
		return atomic_or(&self.value, value, order);
	}

	bit_xor :: proc(
		self: ^, value: T,
		$order: Memory_Order = Memory_Order.Sequentially_Consistent,
	) -> T {
		return atomic_xor(&self.value, value, order);
	}
}

/// A standalone barrier. `.Relaxed` orders nothing and is rejected: a fence that
/// does nothing is a mistake, not a no-op.
fence :: proc($order: Memory_Order = Memory_Order.Sequentially_Consistent) {
	atomic_fence(order);
}

/// The way to guard lazy setup: file-scope and `static` storage are initialized
/// by constants, so anything that must *run* runs on first use instead.
///
/// The zero value is an unfired `Once`, which is what lets it live in `static`
/// storage with no initializer. It works wherever it can be reached: in
/// `static` storage, and behind the `^T` a `Shared(T)` hands out.
// design.md "Program entry and exit" names `Once` for this, and design.md
// "Storage modifiers" gives static storage constant initialization. `do` fires
// through a read-only `^` receiver, as every atomic operation does.
Once :: struct {
	@(private) state: Atomic(u32),
}

@(private)
ONCE_IDLE :: u32(0);

@(private)
ONCE_RUNNING :: u32(1);

@(private)
ONCE_DONE :: u32(2);

// The action panicked. Unwinding still runs `defer`s and drops, and one that
// reached this `Once` would otherwise wait forever on an action that will never
// finish, turning a terminating panic into a hang.
@(private)
ONCE_POISONED :: u32(3);

impl Once {
	/// Runs `action` exactly once across every thread that reaches this. A caller
	/// that arrives while another thread is still running it waits, so `do`
	/// returning means the action has *completed*, not merely started. Whatever
	/// the action wrote is visible to every thread that returns from `do`.
	///
	/// An action must not reach its own `once`: a re-entrant `do` waits for itself
	/// and never returns, and nothing reports it.
	// The winner publishes with a release store and every other thread observes
	// with an acquire load.
	//
	// The thread running the action is the one the wait below spins on. Detecting
	// re-entry needs a thread identity, which the library does not expose, so it
	// is a rule rather than a diagnostic.
	do :: proc(self: ^Once, action: proc()) {
		if (!self.claim()) { return; }
		// Runs on the way out whether `action` returned or panicked.
		finished := false;
		defer self.settle(finished);
		action();
		finished = true;
	}

	/// Has the action completed? A `false` may be stale the moment it is read;
	/// only `true` is a durable answer.
	is_done :: proc(self: ^) -> bool {
		return self.state.load(Memory_Order.Acquire) == ONCE_DONE;
	}

	// Whether this caller won the right to run the action, which it must then
	// `settle`. A caller that lost returns once the winner has finished, and
	// panics if the winner panicked.
	@(private)
	claim :: proc(self: ^) -> bool {
		if (self.state.load(Memory_Order.Acquire) == ONCE_DONE) { return false; }
		observed, won := self.state.compare_exchange(
			ONCE_IDLE, ONCE_RUNNING, Memory_Order.Acquire, Memory_Order.Acquire,
		);
		if (won) { return true; }
		// Another thread is running it. Spin on the acquire load rather than
		// blocking: this implementation has no blocking wait for an atomic
		// state change.
		//
		// ponytail: a spin, with no yield and no backoff. If a `Once` ever guards
		// something slow, give this a platform wait — the state values already
		// distinguish "running" from "done", which is what such a wait needs.
		for (; observed == ONCE_RUNNING; observed = self.state.load(Memory_Order.Acquire)) { }
		if (observed == ONCE_POISONED) { panic("a `Once` action panicked"); }
		return false;
	}

	@(private)
	settle :: proc(self: ^, finished: bool) {
		self.state.store(ONCE_DONE if finished else ONCE_POISONED, Memory_Order.Release);
	}
}

/// A `T` made on first use, by whichever thread asks first, and then shared by
/// every thread that asks. It is a `Once` holding the value it guards, so lazy
/// setup writes no file-scope storage of its own and a task may run it.
///
/// The zero value is empty, whatever `T` is, so a `Lazy` may live in `static`
/// storage with no initializer. Like `Once`, it works behind the `^T` a
/// `Shared(T)` hands out, and it is move-only.
// design.md "Atomic operations and Once". The value is synchronized: this
// package writes it once, before publishing it, and only reads it after, so a
// task that calls `get` on a global `Lazy` writes no global
// (design.md "Globals while tasks run").
Lazy :: struct($T: type) {
	@(private) once: Once,
	@(private, synchronized) slot: Option(T),
}

impl Lazy($T) {
	/// The value, made by calling `init` if no thread has yet. A caller that
	/// arrives while another thread is still making it waits, so the value is
	/// always complete. If `init` panics, the `Lazy` is poisoned as a `Once`
	/// is: every later call, and every call waiting on it, panics.
	///
	/// `init` must not reach this `Lazy`: a re-entrant `get` waits for itself
	/// and never returns, and nothing reports it.
	///
	/// Any thread may reach the value, as long as the process runs, so it is
	/// checked as an item a channel sends is: `init` borrows only what lasts
	/// that long, and the value it makes borrows no `thread_local` storage,
	/// holds nothing `@(thread_affine)`, and owns nothing in a region that ends
	/// sooner.
	// The result borrows the receiver through the payload binding below, which
	// carries the receiver's provenance; only the one write goes through an
	// unchecked address, as `Mutex`'s guard does, after `publish`'s parameter
	// has checked what it keeps.
	get :: proc(self: ^, @(escape=static) init: $F) -> ^T where interfaces.Callable(F, proc() -> T) {
		if (self.once.claim()) {
			finished := false;
			defer self.once.settle(finished);
			self.publish(init());
			finished = true;
		}
		switch (self.slot) {
		case .some(value): return &value;
		case .none: panic("a `Lazy` was read before it was made");
		}
	}

	/// Has the value been made? A `false` may be stale the moment it is read;
	/// only `true` is a durable answer.
	is_done :: proc(self: ^) -> bool {
		return self.once.is_done();
	}

	// Every thread that calls `get` may reach the value, for as long as this
	// `Lazy` lasts, so it is checked as an item a channel sends is.
	@(private)
	publish :: proc(self: ^, @(cross_thread, escape=static) value: move T) {
		made: Option(T) = .some(move(value));
		(^mut Option(T))(rawptr(&self.slot))^ = move(made);
	}
}
