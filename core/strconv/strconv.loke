/**
	Scalar parsing.

	Every procedure here consumes the **whole** text after permitted surrounding
	ASCII whitespace. Formatting scalars is `core:fmt`'s.
*/
// standard-library "`core:strconv`".
//
// Parsing is not a string algorithm: it interprets text as another type, so it
// does not belong in `core:strings`. This package deliberately grows no second
// formatting system. A scanner that consumes a prefix and reports how far it
// got is a later, separate API.
@(public)
package strconv;

import "core:unsafe";

/**
	What went wrong: the failure payload of each parser's `Result`, so a parse
	composes with `or_return` like every other fallible call in the library.
*/
Parse_Error :: enum {
	/**
		The text is not a number at all: no digits, a stray sign, a misplaced
		underscore, an exponent with no digits.
	*/
	Invalid_Syntax,
	/**
		A base outside 2 to 36. A prefix is recognised only when the base is 0, so
		`0x` under an explicit base is ordinary non-digit text and reports
		`Trailing_Data` rather than arriving here.
	*/
	Invalid_Base,
	/// The value does not fit the destination type.
	Overflow,
	/// A number followed by something that is not whitespace.
	Trailing_Data,
}

/**
	`true` or `false`, or `.none` for anything else.

	Accepts `true`, `True`, `TRUE`, `1`, and the matching `false` spellings and
	`0`; not `tRUE`.
*/
// Absence is the whole story here, so this one reports `Option` rather than an
// error value.
parse_bool :: proc(text: string_view) -> Option(bool) {
	switch (trim_ascii_space(text)) {
	case "true", "True", "TRUE", "1":   return true;
	case "false", "False", "FALSE", "0": return false;
	case: return .none;
	}
}

/**
	`base == 0` recognises the language's own prefixes — `0b`, `0o`, `0x` — and
	otherwise reads decimal. Any other base is 2 through 36, with no prefix
	accepted. Underscores may separate digits, as in a Loke literal.
*/
parse_u64 :: proc(text: string_view, base: int = 0) -> Result(u64, Parse_Error) {
	split := split_number(text, base) or_return;
	if (split.negative) { return .err(.Invalid_Syntax); }
	return accumulate(split.digits, split.radix, 0xFFFFFFFFFFFFFFFF);
}

parse_i64 :: proc(text: string_view, base: int = 0) -> Result(i64, Parse_Error) {
	split := split_number(text, base) or_return;
	// One more magnitude is representable on the negative side, which is the
	// whole reason the sign is handled here rather than after the conversion.
	limit: u64 = 0x8000000000000000 if split.negative else 0x7FFFFFFFFFFFFFFF;
	magnitude := accumulate(split.digits, split.radix, limit) or_return;
	// `magnitude - 1` keeps the minimum's magnitude in range; `-0` has none.
	if (split.negative && magnitude != 0) {
		return -i64(magnitude - 1) - 1;
	}
	return i64(magnitude);
}

/**
	`int` and `uint` are the target's pointer-sized integers, which on every
	supported target is 64 bits; these exist so a caller need not convert.
*/
parse_int :: proc(text: string_view, base: int = 0) -> Result(int, Parse_Error) {
	return int(parse_i64(text, base) or_return);
}

parse_uint :: proc(text: string_view, base: int = 0) -> Result(uint, Parse_Error) {
	return uint(parse_u64(text, base) or_return);
}

/**
	Accepts `[+-]digits[.digits][(e|E)[+-]digits]`, where either digit run around
	the point may be empty but not both. Underscores may follow any digit, the
	rule `parse_u64` applies, in all three digit runs.

	The result is correctly rounded, to the nearest `f64` with a tie going to
	the even one, and what `fmt` prints this parses to the same value. The
	point is always `.`: no locale is consulted. It allocates nothing, however
	long the text, and calls no foreign code, so it can initialize a constant.

	Infinities and NaNs are not spellable; a caller that needs them tests for the
	words itself. A finite spelling that rounds past the largest `f64` is
	`Overflow`; one too small for the smallest subnormal rounds to a signed zero.
*/
// The lexer takes underscores in a written literal's mantissa but not its
// exponent; that asymmetry carries no reason this package can see, so one rule
// covers all three digit runs here.
//
// standard-library "`core:strconv`": written in Loke, with the C library's
// `strtod` nowhere behind it. The first 19 significant digits fit a `u64`, and
// `round_decimal` rounds that times a power of ten correctly. Digits past them
// rarely matter: the value lies between the mantissa and the mantissa plus one
// at the same power of ten, and when both round to one `f64`, that is it.
// Otherwise they round to neighbours, since the two are one part in ten to the
// 18th apart and doubles a thousand times that, and `above_halfway` compares
// every digit with the point halfway between the two.
parse_f64 :: proc(text: string_view) -> Result(f64, Parse_Error) {
	bytes := trim_ascii_space(text).bytes();
	at := 0;
	negative := skip_sign(bytes, inout at);
	first := at;
	// The value is `mantissa` times ten to `exponent`, more when `truncated`: a
	// nonzero digit followed the `MANTISSA_DIGITS` significant ones kept.
	mantissa: u64 = 0;
	significant := 0;
	exponent := 0;
	truncated := false;
	after_point := false;
	// Either run around the point may be empty, but not both. An underscore
	// may follow only a digit in its own run.
	any_digit := false;
	in_run := false;
	for (; at < bytes.len(); at += 1) {
		byte := bytes[at];
		if (byte == u8('_') && in_run) { continue; }
		if (byte == u8('.') && !after_point) {
			after_point = true;
			in_run = false;
			continue;
		}
		if (!is_digit(byte)) { break; }
		in_run = true;
		any_digit = true;
		if (significant < MANTISSA_DIGITS) {
			// A leading zero leaves the mantissa zero and is not counted.
			mantissa = mantissa * 10 + u64(byte - u8('0'));
			if (mantissa != 0) { significant += 1; }
			if (after_point) { exponent -= 1; }
		} else {
			if (byte != u8('0')) { truncated = true; }
			if (!after_point) { exponent += 1; }
		}
	}
	if (!any_digit) { return .err(.Invalid_Syntax); }
	digits := bytes[first:at];

	// The written exponent saturates only past `ceiling`. The digits moved
	// `exponent` by at most the text's length either way, so a written one
	// beyond that and the limit leaves the total beyond the limit, in its own
	// direction, whatever the digits cancel; one below it is read exactly. Both
	// stay far from overflowing, since no text in memory is within a tenth of
	// the largest `int`.
	if (at < bytes.len() && (bytes[at] == u8('e') || bytes[at] == u8('E'))) {
		at += 1;
		minus := skip_sign(bytes, inout at);
		ceiling := bytes.len() + EXPONENT_LIMIT;
		written := 0;
		in_run = false;
		for (; at < bytes.len(); at += 1) {
			byte := bytes[at];
			if (byte == u8('_') && in_run) { continue; }
			if (!is_digit(byte)) { break; }
			in_run = true;
			if (written <= ceiling) { written = written * 10 + int(byte - u8('0')); }
		}
		if (!in_run) { return .err(.Invalid_Syntax); }
		exponent += -written if minus else written;
	}
	if (at != bytes.len()) { return .err(.Trailing_Data); }

	bits := round_decimal(mantissa, exponent);
	if (truncated && bits != round_decimal(mantissa + 1, exponent) && above_halfway(digits, exponent, bits)) {
		// The next `f64` up, the infinity after the largest included.
		bits += 1;
	}
	// A finite decimal outside f64's range must not quietly become an infinity:
	// infinities are not accepted spellings, and `Parse_Error.Overflow` exists
	// precisely for a value the destination cannot hold.
	if (bits == INFINITY) { return .err(.Overflow); }
	// Every digit zero is zero, and `-0.0` keeps the sign.
	if (negative) { bits |= SIGN; }
	return unsafe.transmute(f64, bits);
}

// ---------------------------------------------------------------- private --

// The significant digits `parse_f64` keeps in a `u64`: every 19-digit number
// fits, and so does one more than the largest.
@(private)
MANTISSA_DIGITS :: 19;

// More significant digits than this cannot change how a double rounds, as long
// as a nonzero digit past them is remembered: the longest double has 767, and
// the longest point halfway between two of them has 768, the one between the
// largest subnormal and the smallest normal among them.
@(private)
KEPT_DIGITS :: 768;

// Past ten to this power either way a nonzero mantissa of up to
// `MANTISSA_DIGITS` digits overflows or underflows whatever its digits, so the
// written exponent need not be read exactly beyond it.
@(private)
EXPONENT_LIMIT :: 400;

// An `f64`'s bits: the sign, the infinity, and the bit a normal mantissa
// leaves implicit.
@(private)
SIGN :: u64(0x8000000000000000);
@(private)
INFINITY :: u64(0x7FF0000000000000);
@(private)
IMPLICIT_BIT :: u64(0x0010000000000000);

// The bits of the `f64` nearest `mantissa` times ten to `exponent`, a tie
// going to the even one: zero when it is too small for the smallest
// subnormal, `INFINITY` past the largest.
//
// This is the Eisel-Lemire algorithm as the `fast_float` library has it. Ten to
// `exponent` is two to it times five to it, and the first only moves the binary
// exponent, so the bits wanted are the top of `mantissa` times a power of five.
// `POWERS_OF_FIVE` holds 128 bits of each power, and the product of those with
// a 64-bit mantissa always has the 55 bits used here right, which
// "powers_of_five.loke" gives the reference for; so no input needs a fallback.
@(private)
round_decimal :: proc(mantissa: u64, exponent: int) -> u64 {
	// The largest mantissa `parse_f64` passes, ten to the 19th, is at ten to the
	// -343 still below half the smallest subnormal, and the smallest, one, is at
	// ten to the 309 above the largest `f64`.
	if (mantissa == 0 || exponent < MIN_POWER_OF_FIVE) { return 0; }
	if (exponent > MAX_POWER_OF_FIVE) { return INFINITY; }

	// The mantissa with its top bit set, and the `zeros` that were above it.
	w := mantissa;
	zeros := 0;
	for (step := 32; step > 0; step /= 2) {
		if (w >> (64 - step) == 0) {
			w <<= step;
			zeros += step;
		}
	}

	// The 55 bits are the 53 of an `f64`'s mantissa, one to round by, and one
	// more because the product's top bit may be clear. The low half of the power
	// can change them only when the nine bits below them are all ones.
	index := 2 * (exponent - MIN_POWER_OF_FIVE);
	product := u128(w) *% u128(POWERS_OF_FIVE[index]);
	if ((product >> 64) & 0x1FF == 0x1FF) {
		product += (u128(w) *% u128(POWERS_OF_FIVE[index + 1])) >> 64;
	}
	high := u64(product >> 64);
	low := u64(product & 0xFFFFFFFFFFFFFFFF);
	top := int(high >> 63);
	// 54 bits: the mantissa with its implicit bit, and the rounding bit.
	shift := top + 9;
	rounded := high >> shift;
	// The biased exponent of a normal result. `217706 / 65536` is the base-two
	// logarithm of ten, near enough that the shift floors `exponent` times it.
	biased := ((217706 * exponent) >> 16) + 1086 + top - zeros;
	if (biased <= 0) {
		// Subnormal, where the mantissa loses `1 - biased` bits, every one when
		// that is its width or more, and the bits are the mantissa alone. No tie
		// can occur: a point halfway between two subnormals has over 700
		// significant digits. Rounding up to the smallest normal gives that
		// one's bits as well.
		rounded >>= 1 - biased;
		return (rounded + (rounded & 1)) >> 1;
	}
	// The rounding bit alone, below an even mantissa, rounds up unless the
	// value is exactly halfway: the bits dropped below it are all zero. Only a
	// power of five small enough to leave or divide a 64-bit mantissa exactly
	// can do that, and the rounded-up reciprocal of a negative power may then
	// leave a one in `low`.
	if (low <= 1 && exponent >= -4 && exponent <= 23 && rounded & 3 == 1 && rounded << shift == high) {
		rounded -= 1;
	}
	// Adding the mantissa in carries a round up to the next power of two into
	// the exponent, and past the largest exponent into the infinity's.
	bits := (u64(biased - 1) << 52) + ((rounded + (rounded & 1)) >> 1);
	return bits if bits < INFINITY else INFINITY;
}

// A natural number as little-endian 64-bit limbs, for `above_halfway`. Neither
// side of its comparison reaches 2^2607: the largest is a halfway point's 54
// bits times five to the 1092, for `KEPT_DIGITS` and a sticky digit at the
// smallest power of ten, times two to the 17.
@(private)
BIG_LIMBS :: 41;

@(private)
Big :: struct {
	limbs: [BIG_LIMBS]u64,
	used:  int,
}

impl Big {
	// `self` times `factor`, plus `addend`.
	@(private)
	mul_add :: proc(self: inout Big, factor: u64, addend: u64) {
		carry := addend;
		for (i := 0; i < self.used; i += 1) {
			wide := u128(self.limbs[i]) *% u128(factor) + u128(carry);
			self.limbs[i] = u64(wide & 0xFFFFFFFFFFFFFFFF);
			carry = u64(wide >> 64);
		}
		if (carry != 0) {
			self.limbs[self.used] = carry;
			self.used += 1;
		}
	}

	// `self` times `base` to the `power`, as many factors at a time as a `u64`
	// holds. A `power` of zero or less changes nothing.
	@(private)
	scale :: proc(self: inout Big, base: u64, power: int) {
		factor: u64 = 1;
		for (left := power; left > 0; left -= 1) {
			factor *= base;
			if (left == 1 || factor > 0xFFFFFFFFFFFFFFFF / base) {
				self.mul_add(factor, 0);
				factor = 1;
			}
		}
	}
}

// Whether the decimal `digits`, which may hold underscores and a point, rounds
// to the `f64` after the one with bits `low` rather than to that one. `low` is
// not negative, `exponent` is the power of ten of the decimal's first
// `MANTISSA_DIGITS` significant digits, and the decimal lies between those two
// values.
//
// The decimal is compared with the point halfway between them, exactly: both
// are an integer times powers of two and five, a negative power on one side is
// a positive one on the other, and what is left is two integers. `KEPT_DIGITS`
// says why a sticky one may stand for the digits past those.
@(private)
above_halfway :: proc(digits: []u8, exponent: int, low: u64) -> bool {
	// `decimal` times ten to `power10`.
	decimal: Big = {};
	count := 0;
	sticky := false;
	foreach (byte in digits) {
		if (!is_digit(byte) || (count == 0 && byte == u8('0'))) { continue; }
		if (count < KEPT_DIGITS) {
			decimal.mul_add(10, u64(byte - u8('0')));
			count += 1;
		} else if (byte != u8('0')) {
			sticky = true;
		}
	}
	if (sticky) {
		decimal.mul_add(10, 1);
		count += 1;
	}
	power10 := exponent + MANTISSA_DIGITS - count;

	// `halfway` times two to `power2`: an `f64` is its mantissa times two to
	// the -1074 when subnormal, and otherwise has the implicit bit and a biased
	// exponent that counts from there. Halfway to the next is twice the mantissa
	// plus one, at one power less.
	mantissa := low & (IMPLICIT_BIT - 1);
	power2 := -1075;
	if (low >= IMPLICIT_BIT) {
		mantissa |= IMPLICIT_BIT;
		power2 = int(low >> 52) - 1076;
	}
	halfway: Big = {};
	halfway.mul_add(1, 2 * mantissa + 1);

	decimal.scale(5, power10);
	halfway.scale(5, -power10);
	decimal.scale(2, power10 - power2);
	halfway.scale(2, power2 - power10);
	if (decimal.used != halfway.used) { return decimal.used > halfway.used; }
	for (i := decimal.used - 1; i >= 0; i -= 1) {
		if (decimal.limbs[i] != halfway.limbs[i]) { return decimal.limbs[i] > halfway.limbs[i]; }
	}
	// A tie goes to the even mantissa, which is the odd one's neighbour.
	return low & 1 == 1;
}

// Steps `at` past a leading `+` or `-`, answering whether it was a minus.
@(private)
skip_sign :: proc(bytes: []u8, at: inout int) -> bool {
	if (at >= bytes.len() || (bytes[at] != u8('+') && bytes[at] != u8('-'))) { return false; }
	at += 1;
	return bytes[at - 1] == u8('-');
}

@(private)
is_digit :: proc(value: u8) -> bool { return value >= u8('0') && value <= u8('9'); }

@(private)
is_ascii_space :: proc(value: u8) -> bool {
	return value == u8(' ') || (value >= 0x09 && value <= 0x0D);
}

// Only ASCII whitespace, and only around the number: a numeric grammar has no
// reason to know about U+2003.
@(private)
trim_ascii_space :: proc(text: string_view) -> string_view {
	bytes := text.bytes();
	start := 0;
	for (; start < bytes.len() && is_ascii_space(bytes[start]); start += 1) {}
	end := bytes.len();
	for (; end > start && is_ascii_space(bytes[end - 1]); end -= 1) {}
	return text[start:end];
}

// The sign, the base, and the digits with any prefix removed. Every syntactic
// judgement that does not depend on the destination type happens here.
// One result, because `Result` carries one payload: the three facts travel in a
// record rather than as a tuple with a trailing status.
@(private)
Split :: struct { digits: string_view, radix: int, negative: bool }

@(private)
split_number :: proc(text: string_view, base: int) -> Result(Split, Parse_Error) {
	if (base != 0 && (base < 2 || base > 36)) {
		return .err(.Invalid_Base);
	}
	rest := trim_ascii_space(text);
	bytes := rest.bytes();
	at := 0;
	sign := skip_sign(bytes, inout at);
	// Lower case only, as grammar.md "Literals" spells them.
	selected := 10 if base == 0 else base;
	prefixed := false;
	if (base == 0 && at + 1 < bytes.len() && bytes[at] == u8('0')) {
		marker := bytes[at + 1];
		if (marker == u8('b')) { selected = 2; }
		else if (marker == u8('o')) { selected = 8; }
		else if (marker == u8('x')) { selected = 16; }
		prefixed = selected != 10;
		if (prefixed) { at += 2; }
	}
	// Only a prefix may be followed straight by an underscore: `0x_ff` is a
	// literal, `_ff` a name.
	if (at >= bytes.len() || (bytes[at] == u8('_') && !prefixed)) {
		return .err(.Invalid_Syntax);
	}
	return Split{rest[at:], selected, sign};
}

// The digits themselves, in `radix`, refusing anything above `limit`.
//
// Underscores are ignored among the digits, which is what the lexer does with
// a written literal — `1_000`, `0x_ff` and `12_` all lex; `split_number` has
// already refused one that leads without a prefix. At least one digit is still
// required.
@(private)
accumulate :: proc(digits: string_view, radix: int, limit: u64) -> Result(u64, Parse_Error) {
	scale := u64(radix);
	// A value above `cutoff`, or at it with a digit above `last`, would pass
	// `limit` once the digit is appended; no division is left in the loop.
	cutoff := limit / scale;
	last := int(limit % scale);
	value: u64 = 0;
	seen := false;
	foreach (byte in digits.bytes()) {
		if (byte == u8('_')) { continue; }
		digit := digit_value(byte);
		if (digit < 0 || digit >= radix) {
			// Something followed a number, rather than the text not being one.
			return .err(Parse_Error.Trailing_Data if seen else Parse_Error.Invalid_Syntax);
		}
		seen = true;
		if (value > cutoff || (value == cutoff && digit > last)) { return .err(.Overflow); }
		value = value * scale + u64(digit);
	}
	if (!seen) { return .err(.Invalid_Syntax); }
	return value;
}

@(private)
digit_value :: proc(byte: u8) -> int {
	if (byte >= u8('0') && byte <= u8('9')) { return int(byte - u8('0')); }
	if (byte >= u8('a') && byte <= u8('z')) { return int(byte - u8('a')) + 10; }
	if (byte >= u8('A') && byte <= u8('Z')) { return int(byte - u8('A')) + 10; }
	return -1;
}
