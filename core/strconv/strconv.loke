/// Scalar parsing.
///
/// Every procedure here consumes the **whole** text after permitted surrounding
/// ASCII whitespace. Formatting scalars is `core:fmt`'s.
// standard-library "`core:strconv`".
//
// Parsing is not a string algorithm: it interprets text as another type, so it
// does not belong in `core:strings`. This package deliberately grows no second
// formatting system. A scanner that consumes a prefix and reports how far it
// got is a later, separate API.
@(public)
package strconv;

import "core:unsafe";

/// What went wrong: the failure payload of each parser's `Result`, so a parse
/// composes with `or_return` like every other fallible call in the library.
Parse_Error :: enum {
	/// The text is not a number at all: no digits, a stray sign, a misplaced
	/// underscore, an exponent with no digits.
	Invalid_Syntax,
	/// A base outside 2 to 36. A prefix is recognised only when the base is 0, so
	/// `0x` under an explicit base is ordinary non-digit text and reports
	/// `Trailing_Data` rather than arriving here.
	Invalid_Base,
	/// The value does not fit the destination type.
	Overflow,
	/// A number followed by something that is not whitespace.
	Trailing_Data,
}

/// `true` or `false`, or `.none` for anything else.
///
/// Accepts `true`, `True`, `TRUE`, `1`, and the matching `false` spellings and
/// `0`; not `tRUE`.
// Absence is the whole story here, so this one reports `Option` rather than an
// error value.
parse_bool :: proc(text: string_view) -> Option(bool) {
	trimmed := trim_ascii_space(text);
	if (trimmed == "true" || trimmed == "TRUE" || trimmed == "True" || trimmed == "1") {
		return true;
	}
	if (trimmed == "false" || trimmed == "FALSE" || trimmed == "False" || trimmed == "0") {
		return false;
	}
	return .none;
}

/// `base == 0` recognises the language's own prefixes — `0b`, `0o`, `0x` — and
/// otherwise reads decimal. Any other base is 2 through 36, with no prefix
/// accepted. Underscores may separate digits, as in a Loke literal.
parse_u64 :: proc(text: string_view, base: int = 0) -> Result(u64, Parse_Error) {
	split := split_number(text, base) or_return;
	if (split.negative) { return .err(.Invalid_Syntax); }
	return accumulate(split.digits, split.radix, 0xFFFFFFFFFFFFFFFF);
}

parse_i64 :: proc(text: string_view, base: int = 0) -> Result(i64, Parse_Error) {
	split := split_number(text, base) or_return;
	// One more magnitude is representable on the negative side, which is the
	// whole reason the sign is handled here rather than after the conversion.
	limit: u64 = 0x8000000000000000 if split.negative else 0x7FFFFFFFFFFFFFFF;
	magnitude := accumulate(split.digits, split.radix, limit) or_return;
	// `magnitude - 1` keeps the minimum's magnitude in range; `-0` has none.
	if (split.negative && magnitude != 0) {
		return -i64(magnitude - 1) - 1;
	}
	return i64(magnitude);
}

/// `int` and `uint` are the target's pointer-sized integers, which on every
/// supported target is 64 bits; these exist so a caller need not convert.
parse_int :: proc(text: string_view, base: int = 0) -> Result(int, Parse_Error) {
	return int(parse_i64(text, base) or_return);
}

parse_uint :: proc(text: string_view, base: int = 0) -> Result(uint, Parse_Error) {
	return uint(parse_u64(text, base) or_return);
}

/// Accepts `[+-]digits[.digits][(e|E)[+-]digits]`, where either digit run around
/// the point may be empty but not both. Underscores may follow any digit, the
/// rule `parse_u64` applies, in all three digit runs.
///
/// The result is correctly rounded, and what `fmt` prints this parses to the
/// same value. Parsing is in the "C" numeric locale, so a program that sets a
/// decimal-comma locale for its own C code still parses `1.5` as one and a
/// half. It allocates nothing, however long the text.
///
/// Infinities and NaNs are not spellable; a caller that needs them tests for the
/// words itself. A finite spelling past the largest `f64` is `Overflow`; one
/// too small for the smallest subnormal rounds to a signed zero.
///
/// Making that locale can fail, which panics here; `try_parse_f64` reports it.
// The lexer takes underscores in a written literal's mantissa but not its
// exponent; that asymmetry carries no reason this package can see, so one rule
// covers all three digit runs here.
parse_f64 :: proc(text: string_view) -> Result(f64, Parse_Error) {
	switch (try_parse_f64(text)) {
	case .ok(value): return value;
	case .err(failure):
		switch (failure) {
		case .parse(error): return .err(error);
		case .backend: panic("cannot create the \"C\" numeric locale for float text");
		}
	}
}

/// What can stop a float conversion other than its text: the "C" numeric
/// locale it runs in could not be made. `Out_Of_Memory` when that was an
/// allocation failure, `Unavailable` otherwise.
// `core:fmt` has the same two answers for spelling a float, as its own type
// because neither package imports the other.
Backend_Error :: enum {
	Out_Of_Memory,
	Unavailable,
}

/// `parse_f64`, answering a `Backend_Error` where that panics. Every other
/// answer is the same.
// standard-library "`core:strconv`": the shared fallible conversion that
// `core:encoding/json` reads numbers with.
//
// The syntax is checked here and the rounding is the C library's `strtod`, the
// same one `fmt` relies on to find the shortest spelling that reads back.
try_parse_f64 :: proc(
	text: string_view,
) -> Result(f64, (parse: Parse_Error | backend: Backend_Error)) {
	bytes := trim_ascii_space(text).bytes();
	at := 0;
	if (at < bytes.len() && (bytes[at] == u8('+') || bytes[at] == u8('-'))) { at += 1; }
	whole := digit_run(bytes, at);
	fraction := whole;
	if (whole < bytes.len() && bytes[whole] == u8('.')) { fraction = digit_run(bytes, whole + 1); }
	if (whole == at && fraction <= whole + 1) { return .err(.parse(.Invalid_Syntax)); }
	at = fraction;
	if (at < bytes.len() && (bytes[at] == u8('e') || bytes[at] == u8('E'))) {
		at += 1;
		if (at < bytes.len() && (bytes[at] == u8('+') || bytes[at] == u8('-'))) { at += 1; }
		exponent := digit_run(bytes, at);
		if (exponent == at) { return .err(.parse(.Invalid_Syntax)); }
		at = exponent;
	}
	if (at != bytes.len()) { return .err(.parse(.Trailing_Data)); }

	// `strtod` reads to a terminator, which a view does not have, and knows
	// nothing of underscores.
	spelled: [SPELLED]u8 = {};
	normalize_float(bytes, &mut spelled);
	value: f64 = 0;
	switch (rt_try_parse_f64(unsafe.cstring_view(unsafe.raw_data(spelled[:])), &mut value)) {
	case 0:
	case NUMERIC_OUT_OF_MEMORY: return .err(.backend(.Out_Of_Memory));
	case NUMERIC_UNAVAILABLE:   return .err(.backend(.Unavailable));
	// The syntax was checked above, so this is the C library disagreeing with
	// it. A short conversion is still not a value to return.
	case: return .err(.parse(.Invalid_Syntax));
	}
	// A finite decimal outside f64's range must not quietly become an infinity:
	// infinities are not accepted spellings, and `Parse_Error.Overflow` exists
	// precisely for a value the destination cannot hold.
	if (value > 1.7976931348623157e308 || value < -1.7976931348623157e308) {
		return .err(.parse(.Overflow));
	}
	return value;
}

// ---------------------------------------------------------------- private --

// `strtod` in the runtime's "C" numeric locale, which also checks that it read
// the whole spelling. Private, or the file-wide `@(public)` would export it as
// `strconv.rt_try_parse_f64`.
@(private)
foreign loke_runtime {
	@(link_name="loke_rt_v1_try_parse_f64")
	rt_try_parse_f64 :: proc "c" (text: cstring_view, value: ^mut f64) -> i32 ---;
}

// `loke_rt.h`'s answers besides 0 and `LOKE_RT_NUMERIC_REJECTED`.
@(private)
NUMERIC_OUT_OF_MEMORY :: 2;
@(private)
NUMERIC_UNAVAILABLE :: 3;

// More significant digits than this cannot change how a double rounds, as long
// as a nonzero digit past them is remembered: no double, and no point halfway
// between two of them, has more. The UCRT's `strtod` reads only the first 768
// and ignores the rest, so a longer spelling handed to it whole could round the
// wrong way; this many and the sticky digit are exactly what it reads.
@(private)
KEPT_DIGITS :: 767;

// Past this many powers of ten every kept mantissa overflows or underflows
// whatever its digits, so a longer exponent saturates here.
@(private)
EXPONENT_LIMIT :: 100000;

// `-0.`, the kept digits, a sticky digit, `e-100000`, and the terminator.
@(private)
SPELLED :: 3 + KEPT_DIGITS + 1 + 8 + 1;

// The checked spelling in `bytes` as `[-]0.DIGITSe[-]N`, with no underscores,
// no leading zeros, and at most `KEPT_DIGITS` significant digits, so that
// `strtod` reads any length of text out of a fixed buffer. A one stands in for
// the digits dropped past those when any of them is not zero.
@(private)
normalize_float :: proc(bytes: []u8, spelled: ^mut [SPELLED]u8) {
	used := 0;
	at := 0;
	if (at < bytes.len() && (bytes[at] == u8('+') || bytes[at] == u8('-'))) {
		if (bytes[at] == u8('-')) {
			spelled[used] = u8('-');
			used += 1;
		}
		at += 1;
	}
	spelled[used] = u8('0');
	spelled[used + 1] = u8('.');
	used += 2;
	first := used;
	// The value is 0.DIGITS times ten to `scale` plus the written exponent.
	scale := 0;
	significant := false;
	dropped := false;
	after_point := false;
	for (; at < bytes.len(); at += 1) {
		byte := bytes[at];
		if (byte == u8('_')) { continue; }
		if (byte == u8('.')) {
			after_point = true;
			continue;
		}
		if (!is_digit(byte)) { break; }
		if (!significant && byte == u8('0')) {
			if (after_point) { scale -= 1; }
			continue;
		}
		significant = true;
		if (!after_point) { scale += 1; }
		if (used - first < KEPT_DIGITS) {
			spelled[used] = byte;
			used += 1;
		} else if (byte != u8('0')) {
			dropped = true;
		}
	}
	if (!significant) {
		// Every digit was zero, and `0.0` keeps the sign.
		spelled[used] = u8('0');
		spelled[used + 1] = 0;
		return;
	}
	if (dropped) {
		spelled[used] = u8('1');
		used += 1;
	}
	exponent := 0;
	negative := false;
	if (at < bytes.len()) {
		at += 1; // the `e`
		if (bytes[at] == u8('+') || bytes[at] == u8('-')) {
			negative = bytes[at] == u8('-');
			at += 1;
		}
		for (; at < bytes.len(); at += 1) {
			if (bytes[at] == u8('_')) { continue; }
			if (exponent <= EXPONENT_LIMIT) {
				exponent = exponent * 10 + int(bytes[at] - u8('0'));
			}
		}
	}
	if (negative) { exponent = -exponent; }
	// `scale` is bounded by the text's length, so the sum cannot overflow.
	total := scale + exponent;
	if (total > EXPONENT_LIMIT) { total = EXPONENT_LIMIT; }
	if (total < -EXPONENT_LIMIT) { total = -EXPONENT_LIMIT; }
	spelled[used] = u8('e');
	used += 1;
	if (total < 0) {
		spelled[used] = u8('-');
		used += 1;
		total = -total;
	}
	digits: [8]u8 = {};
	count := 0;
	for (;;) {
		digits[count] = u8('0') + u8(total % 10);
		count += 1;
		total /= 10;
		if (total == 0) { break; }
	}
	for (; count > 0; count -= 1) {
		spelled[used] = digits[count - 1];
		used += 1;
	}
	spelled[used] = 0;
}

// The end of the digits starting at `start`: nothing unless the first is a
// digit, and underscores only after one.
@(private)
digit_run :: proc(bytes: []u8, start: int) -> int {
	if (start >= bytes.len() || !is_digit(bytes[start])) { return start; }
	at := start + 1;
	for (; at < bytes.len() && (is_digit(bytes[at]) || bytes[at] == u8('_')); at += 1) {}
	return at;
}

@(private)
is_digit :: proc(value: u8) -> bool { return value >= u8('0') && value <= u8('9'); }

@(private)
is_ascii_space :: proc(value: u8) -> bool {
	return value == u8(' ') || (value >= 0x09 && value <= 0x0D);
}

// Only ASCII whitespace, and only around the number: a numeric grammar has no
// reason to know about U+2003.
@(private)
trim_ascii_space :: proc(text: string_view) -> string_view {
	bytes := text.bytes();
	start := 0;
	for (; start < bytes.len() && is_ascii_space(bytes[start]); start += 1) {}
	end := bytes.len();
	for (; end > start && is_ascii_space(bytes[end - 1]); end -= 1) {}
	return text[start:end];
}

// The sign, the base, and the digits with any prefix removed. Every syntactic
// judgement that does not depend on the destination type happens here.
// One result, because `Result` carries one payload: the three facts travel in a
// record rather than as a tuple with a trailing status.
@(private)
Split :: struct { digits: string_view, radix: int, negative: bool }

@(private)
split_number :: proc(text: string_view, base: int) -> Result(Split, Parse_Error) {
	if (base != 0 && (base < 2 || base > 36)) {
		return .err(.Invalid_Base);
	}
	rest := trim_ascii_space(text);
	bytes := rest.bytes();
	at := 0;
	sign := false;
	if (bytes.len() > 0 && (bytes[at] == u8('+') || bytes[at] == u8('-'))) {
		sign = bytes[at] == u8('-');
		at += 1;
	}
	// Lower case only, as grammar.md "Literals" spells them.
	selected := 10 if base == 0 else base;
	prefixed := false;
	if (base == 0 && at + 1 < bytes.len() && bytes[at] == u8('0')) {
		marker := bytes[at + 1];
		if (marker == u8('b')) { selected = 2; }
		else if (marker == u8('o')) { selected = 8; }
		else if (marker == u8('x')) { selected = 16; }
		prefixed = selected != 10;
		if (prefixed) { at += 2; }
	}
	// Only a prefix may be followed straight by an underscore: `0x_ff` is a
	// literal, `_ff` a name.
	if (at >= bytes.len() || (bytes[at] == u8('_') && !prefixed)) {
		return .err(.Invalid_Syntax);
	}
	return Split{rest[at:], selected, sign};
}

// The digits themselves, in `radix`, refusing anything above `limit`.
//
// Underscores are ignored among the digits, which is what the lexer does with
// a written literal — `1_000`, `0x_ff` and `12_` all lex; `split_number` has
// already refused one that leads without a prefix. At least one digit is still
// required.
@(private)
accumulate :: proc(digits: string_view, radix: int, limit: u64) -> Result(u64, Parse_Error) {
	bytes := digits.bytes();
	value: u64 = 0;
	scale := u64(radix);
	seen := 0;
	foreach (byte in bytes) {
		if (byte == u8('_')) { continue; }
		digit := digit_value(byte);
		if (digit < 0 || digit >= radix) {
			// Something followed a number, rather than the text not being one.
			return .err(Parse_Error.Trailing_Data if seen > 0 else Parse_Error.Invalid_Syntax);
		}
		seen += 1;
		// Both halves of the overflow test, before the value is committed.
		if (value > (limit - u64(digit)) / scale) {
			return .err(.Overflow);
		}
		value = value * scale + u64(digit);
	}
	if (seen == 0) { return .err(.Invalid_Syntax); }
	return value;
}

@(private)
digit_value :: proc(byte: u8) -> int {
	if (byte >= u8('0') && byte <= u8('9')) { return int(byte - u8('0')); }
	if (byte >= u8('a') && byte <= u8('z')) { return int(byte - u8('a')) + 10; }
	if (byte >= u8('A') && byte <= u8('Z')) { return int(byte - u8('A')) + 10; }
	return -1;
}
