// Scalar parsing (standard-library "`core:strconv`").
//
// Parsing is not a string algorithm: it interprets text as another type, so it
// does not belong in `core:strings`. Formatting scalars stays in `core:fmt`;
// this package deliberately grows no second formatting system.
//
// Every procedure here consumes the **whole** text after permitted surrounding
// ASCII whitespace. A scanner that consumes a prefix and reports how far it got
// is a later, separate API.
@(public)
package strconv;

// What went wrong: the failure payload of each parser's `Result`, so a parse
// composes with `or_return` like every other fallible call in the library.
Parse_Error :: enum {
	// The text is not a number at all: no digits, a stray sign, a misplaced
	// underscore, an exponent with no digits.
	Invalid_Syntax,
	// A base outside 2 to 36. A prefix is recognised only when the base is 0, so
	// `0x` under an explicit base is ordinary non-digit text and reports
	// `Trailing_Data` rather than arriving here.
	Invalid_Base,
	// The value does not fit the destination type.
	Overflow,
	// A number followed by something that is not whitespace.
	Trailing_Data,
}

// Absence is the whole story here, so this one reports `Option` rather than an
// error value.
//
// Accepts `true`/`false` in either case, and `1`/`0`.
parse_bool :: proc(text: string_view) -> Option(bool) {
	trimmed := trim_ascii_space(text);
	if (trimmed == "true" || trimmed == "TRUE" || trimmed == "True" || trimmed == "1") {
		return .some(true);
	}
	if (trimmed == "false" || trimmed == "FALSE" || trimmed == "False" || trimmed == "0") {
		return .some(false);
	}
	return .none;
}

// `base == 0` recognises the language's own prefixes — `0b`, `0o`, `0x` — and
// otherwise reads decimal. Any other base is 2 through 36, with no prefix
// accepted. Underscores may separate digits, as in a Loke literal.
parse_u64 :: proc(text: string_view, base: int = 0) -> Result(u64, Parse_Error) {
	split := split_number(text, base) or_return;
	if (split.negative) { return .err(.Invalid_Syntax); }
	return accumulate(split.digits, split.radix, 0xFFFFFFFFFFFFFFFF);
}

parse_i64 :: proc(text: string_view, base: int = 0) -> Result(i64, Parse_Error) {
	split := split_number(text, base) or_return;
	// One more magnitude is representable on the negative side, which is the
	// whole reason the sign is handled here rather than after the conversion.
	limit: u64 = 0x8000000000000000 if split.negative else 0x7FFFFFFFFFFFFFFF;
	magnitude := accumulate(split.digits, split.radix, limit) or_return;
	if (split.negative) {
		return .ok(-i64(magnitude - 1) - 1);
	}
	return .ok(i64(magnitude));
}

// `int` and `uint` are the target's pointer-sized integers, which on every
// supported target is 64 bits; these exist so a caller need not convert.
parse_int :: proc(text: string_view, base: int = 0) -> Result(int, Parse_Error) {
	return .ok(int(parse_i64(text, base) or_return));
}

parse_uint :: proc(text: string_view, base: int = 0) -> Result(uint, Parse_Error) {
	return .ok(uint(parse_u64(text, base) or_return));
}

// ponytail: a decimal mantissa scaled by a power of ten. Exact when the mantissa
// fits 53 bits and the exponent is within the exactly representable powers
// (|exponent| <= 22) — the common case, including every value a program wrote
// itself — and correct to within an ulp or two outside it. Correctly rounded
// parsing (Eisel-Lemire, or a big-integer fallback) goes behind this same
// signature when something needs bit-exact round-tripping.
//
// Accepts `[+-]digits[.digits][(e|E)[+-]digits]`, with underscores ignored among
// the digits exactly as `parse_u64` ignores them. The lexer takes them in a
// written literal's mantissa but not its exponent; that asymmetry carries no
// reason this package can see, so one rule covers all three digit runs here.
//
// Infinities and NaNs are not spellable; a caller that needs them tests for the
// words itself.
parse_f64 :: proc(text: string_view) -> Result(f64, Parse_Error) {
	trimmed := trim_ascii_space(text);
	if (trimmed.len() == 0) { return .err(.Invalid_Syntax); }
	bytes := trimmed.bytes();
	at := 0;
	negative := false;
	if (bytes[at] == u8('+') || bytes[at] == u8('-')) {
		negative = bytes[at] == u8('-');
		at += 1;
	}

	mantissa: u64 = 0;
	exponent := 0;
	digits := 0;
	// Digits past the point where a u64 mantissa saturates change the exponent
	// instead of the mantissa; they are below the precision of the result.
	saturated := false;
	for (; at < bytes.len() && (is_digit(bytes[at]) || bytes[at] == u8('_')); at += 1) {
		if (bytes[at] == u8('_')) { continue; }
		digits += 1;
		if (saturated) {
			exponent += 1;
			continue;
		}
		digit := u64(bytes[at] - u8('0'));
		if (mantissa > (0xFFFFFFFFFFFFFFFF - digit) / 10) {
			saturated = true;
			exponent += 1;
			continue;
		}
		mantissa = mantissa * 10 + digit;
	}
	if (at < bytes.len() && bytes[at] == u8('.')) {
		at += 1;
		for (; at < bytes.len() && (is_digit(bytes[at]) || bytes[at] == u8('_')); at += 1) {
			if (bytes[at] == u8('_')) { continue; }
			digits += 1;
			if (saturated) { continue; }
			digit := u64(bytes[at] - u8('0'));
			if (mantissa > (0xFFFFFFFFFFFFFFFF - digit) / 10) {
				saturated = true;
				continue;
			}
			mantissa = mantissa * 10 + digit;
			exponent -= 1;
		}
	}
	if (digits == 0) { return .err(.Invalid_Syntax); }

	if (at < bytes.len() && (bytes[at] == u8('e') || bytes[at] == u8('E'))) {
		at += 1;
		exponent_negative := false;
		if (at < bytes.len() && (bytes[at] == u8('+') || bytes[at] == u8('-'))) {
			exponent_negative = bytes[at] == u8('-');
			at += 1;
		}
		written := 0;
		value := 0;
		for (; at < bytes.len() && (is_digit(bytes[at]) || bytes[at] == u8('_')); at += 1) {
			if (bytes[at] == u8('_')) { continue; }
			written += 1;
			// Any exponent past this is already infinity or zero; clamping keeps the
			// accumulation from wrapping.
			if (value < 100000) {
				value = value * 10 + int(bytes[at] - u8('0'));
			}
		}
		if (written == 0) { return .err(.Invalid_Syntax); }
		exponent += -value if exponent_negative else value;
	}
	if (at != bytes.len()) { return .err(.Trailing_Data); }

	value := scale(f64(mantissa), exponent);
	// Scaling a finite decimal outside f64's range must not quietly manufacture
	// an infinity: infinities are not accepted spellings, and `Parse_Error.Overflow`
	// exists precisely for a value the destination cannot hold.
	if (mantissa != 0 && value > 1.7976931348623157e308) {
		return .err(.Overflow);
	}
	return .ok(-value if negative else value);
}

// ---------------------------------------------------------------- private --

@(private)
POWERS_OF_TEN :: [23]f64{
	1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
	1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22,
};

// One multiply or divide by an exactly representable power of ten is exactly
// rounded; beyond that the scaling repeats and the error compounds.
//
// The table is indexed where it is declared. Binding it to a local first reads
// as a convenience, but a constant aggregate materializes into the frame: that
// spelling emitted an `alloca [23 x double]` and stored all 184 bytes on every
// call.
@(private)
scale :: proc(value: f64, exponent: int) -> f64 {
	if (exponent >= 0) {
		if (exponent <= 22) { return value * POWERS_OF_TEN[exponent]; }
		scaled := value;
		left := exponent;
		for (; left > 22; left -= 22) { scaled *= POWERS_OF_TEN[22]; }
		return scaled * POWERS_OF_TEN[left];
	}
	if (exponent >= -22) { return value / POWERS_OF_TEN[-exponent]; }
	scaled := value;
	left := -exponent;
	for (; left > 22; left -= 22) { scaled /= POWERS_OF_TEN[22]; }
	return scaled / POWERS_OF_TEN[left];
}

@(private)
is_digit :: proc(value: u8) -> bool { return value >= u8('0') && value <= u8('9'); }

@(private)
is_ascii_space :: proc(value: u8) -> bool {
	return value == u8(' ') || (value >= 0x09 && value <= 0x0D);
}

// Only ASCII whitespace, and only around the number: a numeric grammar has no
// reason to know about U+2003.
@(private)
trim_ascii_space :: proc(text: string_view) -> string_view {
	bytes := text.bytes();
	start := 0;
	for (; start < bytes.len() && is_ascii_space(bytes[start]); start += 1) {}
	end := bytes.len();
	for (; end > start && is_ascii_space(bytes[end - 1]); end -= 1) {}
	return text[start:end];
}

// The sign, the base, and the digits with any prefix removed. Every syntactic
// judgement that does not depend on the destination type happens here.
// One result, because `Result` carries one payload: the three facts travel in a
// record rather than as a tuple with a trailing status.
@(private)
Split :: struct { digits: string_view, radix: int, negative: bool }

@(private)
split_number :: proc(text: string_view, base: int) -> Result(Split, Parse_Error) {
	if (base != 0 && (base < 2 || base > 36)) {
		return .err(.Invalid_Base);
	}
	rest := trim_ascii_space(text);
	bytes := rest.bytes();
	at := 0;
	sign := false;
	if (bytes.len() > 0 && (bytes[at] == u8('+') || bytes[at] == u8('-'))) {
		sign = bytes[at] == u8('-');
		at += 1;
	}
	selected := 10 if base == 0 else base;
	if (base == 0 && at + 1 < bytes.len() && bytes[at] == u8('0')) {
		marker := bytes[at + 1];
		if (marker == u8('b') || marker == u8('B')) { selected = 2; at += 2; }
		else if (marker == u8('o') || marker == u8('O')) { selected = 8; at += 2; }
		else if (marker == u8('x') || marker == u8('X')) { selected = 16; at += 2; }
	}
	if (at >= bytes.len()) {
		return .err(.Invalid_Syntax);
	}
	return .ok(Split{rest[at:], selected, sign});
}

// The digits themselves, in `radix`, refusing anything above `limit`.
//
// Underscores are ignored wherever they appear among the digits, which is
// exactly what the lexer does with a written literal — `1_000`, `0x_ff` and
// `12_` all lex. At least one digit is still required.
@(private)
accumulate :: proc(digits: string_view, radix: int, limit: u64) -> Result(u64, Parse_Error) {
	bytes := digits.bytes();
	value: u64 = 0;
	scale := u64(radix);
	seen := 0;
	foreach (byte in bytes) {
		if (byte == u8('_')) { continue; }
		digit := digit_value(byte);
		if (digit < 0 || digit >= radix) {
			// Something followed a number, rather than the text not being one.
			return .err(Parse_Error.Trailing_Data if seen > 0 else Parse_Error.Invalid_Syntax);
		}
		seen += 1;
		// Both halves of the overflow test, before the value is committed.
		if (value > (limit - u64(digit)) / scale) {
			return .err(.Overflow);
		}
		value = value * scale + u64(digit);
	}
	if (seen == 0) { return .err(.Invalid_Syntax); }
	return .ok(value);
}

@(private)
digit_value :: proc(byte: u8) -> int {
	if (byte >= u8('0') && byte <= u8('9')) { return int(byte - u8('0')); }
	if (byte >= u8('a') && byte <= u8('z')) { return int(byte - u8('a')) + 10; }
	if (byte >= u8('A') && byte <= u8('Z')) { return int(byte - u8('A')) + 10; }
	return -1;
}
