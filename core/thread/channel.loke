// standard-library "Channels": a bounded queue between tasks, reached through
// the endpoints one `split` makes, written over `Monitor`.
@(public)
package thread;

import "core:unsafe";

/// A bounded queue between tasks, owning its queued items. A task reaches it
/// through an endpoint that borrows it: a `Sender` sends and a `Receiver`
/// receives. `split` makes the first of each together, and `fork` adds more.
///
/// A side closes for good when its last endpoint drops, or both do at
/// `close`. Dropping the channel drops the items still queued. It is
/// move-only and has no zero value.
Channel :: struct($T: type) {
	@(private) state: Monitor(Channel_State(T)),
	// Required, so a channel has no zero value: `init` makes one.
	@(private, required) capacity: int,
}

// The queue is a ring over `capacity` slots, each `.none` unless it holds a
// committed item, so no slot needs `T`'s zero.
@(private)
Channel_State :: struct($T: type) {
	slots: [dynamic]Option(T),
	head: int,
	count: int,
	senders: int,
	receivers: int,
	split: bool,
	sending_closed: bool,
	receiving_closed: bool,
}

impl Channel_State($T) {
	closed :: proc(self: ^) -> bool {
		return self.sending_closed || self.receiving_closed;
	}

	// A send can go on: it commits, or it fails because a side closed.
	can_send :: proc(self: ^Channel_State(T)) -> bool {
		return self.closed() || self.count < self.slots.len();
	}

	// A receive can go on: it takes an item, or the stream has ended.
	can_receive :: proc(self: ^Channel_State(T)) -> bool {
		return self.count > 0 || self.sending_closed;
	}

	push :: proc(self: inout, @(escape=stored) value: move T) {
		at := (self.head + self.count) % self.slots.len();
		self.slots[at] = .some(move(value));
		self.count += 1;
	}

	pop :: proc(self: inout) -> Option(T) {
		if (self.count == 0) { return .none; }
		item := exchange(inout self.slots[self.head], .none);
		self.head = (self.head + 1) % self.slots.len();
		self.count -= 1;
		return item;
	}
}

/// Why a send handed its item back: a side of the channel has closed, or, for
/// `try_send` alone, the queue is full. Dropping it drops the item.
Unsent :: union($T: type) { closed: T, full: T }

/// What `try_receive` found: an item, an empty queue that more may reach, or
/// the end of the stream.
Received :: union($T: type) { item: T, empty, closed }

/// Sends into the channel it borrows. Move-only; `fork` makes another.
Sender :: move_only struct($T: type) @(wakes_on_drop) {
	@(private) channel: ^Channel(T),
}

/// Receives from the channel it borrows. Move-only; `fork` makes another.
/// `foreach (item in receiver)` receives until the stream ends.
Receiver :: move_only struct($T: type) @(wakes_on_drop) {
	@(private) channel: ^Channel(T),
}

/// What `foreach` over a `Receiver` steps with.
Receiver_Iterator :: struct($T: type) {
	@(private) channel: ^Channel(T),
}

impl Channel($T) {
	/// A channel holding at most `capacity` items, from the default allocator.
	/// A capacity below one panics.
	init :: proc(capacity: int) -> Channel(T) {
		if (capacity < 1) { panic("thread.Channel capacity must be positive"); }
		channel := Channel(T){capacity = capacity};
		channel.state.value.slots.resize(capacity);
		return channel;
	}

	/// The first sender and receiver, made together. Splitting again, or after
	/// `close`, panics.
	split :: proc(self: ^) -> (sender: Sender(T), receiver: Receiver(T)) {
		{
			state := self.state.lock();
			if (state.read().split) { panic("thread.Channel is already split"); }
			if (state.read().closed()) { panic("thread.Channel is closed"); }
			opened := &mut state.get();
			opened.split = true;
			opened.senders = 1;
			opened.receivers = 1;
		}
		return {Sender(T){self}, Receiver(T){self}};
	}

	/// Closes both sides for good and wakes every waiter: sends fail from now
	/// on, and receivers drain what is queued, then see the end. Closing again
	/// does nothing more. Closing before `split` prevents splitting.
	close :: proc(self: ^) {
		state := self.state.lock();
		closing := &mut state.get();
		closing.sending_closed = true;
		closing.receiving_closed = true;
	}

	// The receive of `Receiver.receive` and of iteration.
	@(private)
	take :: proc(self: ^) -> Option(T) {
		state := self.state.lock_when(Channel_State(T).can_receive) or_else return .none;
		return queue_of(&mut state.get()).pop();
	}
}

// The queue past the guard's provenance. An item carries no borrow of storage
// shorter than the process, as the send operations' `@(escape=static)` says,
// so one taken out borrows nothing of the guard, which its provenance would
// otherwise claim.
@(private)
queue_of :: proc(state: ^mut Channel_State($T)) -> ^mut Channel_State(T) {
	return (^mut Channel_State(T))(rawptr(state));
}

@(private)
MAX_ENDPOINTS :: 0x7FFF_FFFF_FFFF_FFFF;

impl Sender($T) {
	/// Another sender on the same channel, keeping the sending side open while
	/// either lives. It borrows the channel, not this sender.
	fork :: proc(self: ^) -> Sender(T) {
		{
			state := self.channel.state.lock();
			if (state.read().senders == MAX_ENDPOINTS) { panic("too many thread.Channel senders"); }
			state.get().senders += 1;
		}
		return Sender(T){self.channel};
	}

	/// Waits while the queue is full and both sides are open, then commits the
	/// item. If either side has closed, the item comes back as `.closed`.
	send :: proc(self: ^, @(cross_thread, escape=static) value: move T) -> Status(Unsent(T)) {
		state := self.channel.state.lock_when(Channel_State(T).can_send) or_else
			return .err(.closed(move(value)));
		if (state.read().closed()) { return .err(.closed(move(value))); }
		state.get().push(move(value));
		return .ok;
	}

	/// Commits the item without waiting: `.full` hands it back from a full,
	/// open queue, and `.closed` from a closed one, which takes precedence.
	try_send :: proc(self: ^, @(cross_thread, escape=static) value: move T) -> Status(Unsent(T)) {
		state := self.channel.state.lock();
		if (state.read().closed()) { return .err(.closed(move(value))); }
		if (state.read().count == state.read().slots.len()) { return .err(.full(move(value))); }
		state.get().push(move(value));
		return .ok;
	}

	// The last sender to drop closes the sending side, and the changed guard
	// wakes the receivers to drain and see the end.
	@(private)
	release :: hook(drop) proc(self: inout) {
		state := self.channel.state.lock();
		leaving := &mut state.get();
		leaving.senders -= 1;
		if (leaving.senders == 0) { leaving.sending_closed = true; }
	}
}

impl Receiver($T) {
	Element :: T;

	/// Another receiver on the same channel, keeping the receiving side open
	/// while either lives. It borrows the channel, not this receiver.
	fork :: proc(self: ^) -> Receiver(T) {
		{
			state := self.channel.state.lock();
			if (state.read().receivers == MAX_ENDPOINTS) { panic("too many thread.Channel receivers"); }
			state.get().receivers += 1;
		}
		return Receiver(T){self.channel};
	}

	/// Waits while the queue is empty and the sending side is open, then takes
	/// the oldest item; `.none` once the sending side has closed and the queue
	/// is empty.
	receive :: proc(self: ^) -> Option(T) {
		return self.channel.take();
	}

	/// Takes the oldest item without waiting: `.empty` means more may come,
	/// and `.closed` that the sending side has closed and nothing is queued.
	try_receive :: proc(self: ^) -> Received(T) {
		state := self.channel.state.lock();
		if (state.read().count > 0) {
			item := queue_of(&mut state.get()).pop() or_else return .empty;
			return .item(move(item));
		}
		if (state.read().sending_closed) { return .closed; }
		return .empty;
	}

	/// Receives item by item: each step waits as `receive` does, and the
	/// loop ends with the stream.
	iter :: proc(self) -> Receiver_Iterator(T) {
		return Receiver_Iterator(T){self.channel};
	}

	// The last receiver to drop closes the receiving side, and the changed
	// guard wakes the senders, whose sends then fail.
	@(private)
	release :: hook(drop) proc(self: inout) {
		state := self.channel.state.lock();
		leaving := &mut state.get();
		leaving.receivers -= 1;
		if (leaving.receivers == 0) { leaving.receiving_closed = true; }
	}
}

impl Receiver_Iterator($T) {
	/// The next item, as `receive` answers it.
	next :: proc(self: inout) -> Option(T) {
		return self.channel.take();
	}
}
