/// Threads, and the mutexes and monitors that guard what they share.
///
/// `spawn` and `join` supply the thread start and join edges of happens-before,
/// and `Mutex` and `Monitor` the unlock-to-lock edge.
// standard-library "`core:thread`", design.md "Concurrency and the memory
// model".
//
// Ordinary Loke over kernel32 and two runtime entry points. The kernel32 calls
// sit behind `when (LOKE_OS == .Windows)`, as in `core:process`.
@(public)
package thread;

import "base:interfaces";
import "core:sync";
import "core:unsafe";

when (LOKE_OS == .Windows) {

foreign import kernel32 "system:kernel32.lib";

// A handle is an `int`, as in `core:fs` and `core:process`: a symbol two packages
// declare must have one type, or a program importing both does not compile.
@(private)
foreign kernel32 {
	@(link_name="CreateThread")
	rt_create_thread :: proc "stdcall" (
		attributes: rawptr, stack_size: uint, start: proc "stdcall" (parameter: rawptr) -> u32,
		parameter: rawptr, flags: u32, thread_id: rawptr,
	) -> int ---;
	@(link_name="WaitForSingleObject")
	rt_wait :: proc "stdcall" (handle: int, milliseconds: u32) -> u32 ---;
	@(link_name="CloseHandle")
	rt_close :: proc "stdcall" (handle: int) -> i32 ---;
	@(link_name="AcquireSRWLockExclusive")
	rt_lock :: proc "stdcall" (lock: rawptr) ---;
	@(link_name="ReleaseSRWLockExclusive")
	rt_unlock :: proc "stdcall" (lock: rawptr) ---;
	@(link_name="SleepConditionVariableSRW")
	rt_sleep :: proc "stdcall" (condition: rawptr, lock: rawptr, milliseconds: u32, flags: u32) -> i32 ---;
	@(link_name="WakeAllConditionVariable")
	rt_wake_all :: proc "stdcall" (condition: rawptr) ---;
	@(link_name="GetActiveProcessorCount")
	rt_processor_count :: proc "stdcall" (group: u16) -> u32 ---;
}

}

// A spawned thread attaches to the runtime's panic state first, and detaching
// runs its managed `thread_local` drops (design.md "Values that outlive every
// scope").
@(private)
foreign loke_runtime {
	@(link_name="loke_rt_v1_thread_attach")
	rt_attach :: proc "c" () ---;
	@(link_name="loke_rt_v1_thread_detach")
	rt_detach :: proc "c" () ---;
}

@(private) INFINITE :: u32(0xFFFFFFFF);
@(private) ALL_PROCESSOR_GROUPS :: u16(0xFFFF);

/// How many threads can run at once on this machine: its logical processors, in
/// every processor group, and never less than one.
processor_count :: proc() -> int {
	count := int(rt_processor_count(ALL_PROCESSOR_GROUPS));
	return count if count > 0 else 1;
}

/// A running thread. Dropping one joins it, so a thread never outlives the owner
/// of its handle; `join` says so at the point it happens.
Thread :: move_only struct {
	@(private) handle: int,
}

impl Thread {
	/// Waits for the thread to return. Its writes, and its `thread_local` drops,
	/// happen before this returns.
	join :: proc(self: inout) {
		if (self.handle == 0) { return; }
		rt_wait(self.handle, INFINITE);
		rt_close(self.handle);
		self.handle = 0;
	}

	@(private)
	wait :: hook(drop) proc(self: inout) {
		self.join();
	}
}

// What a new thread starts from: the entry and its argument, on the heap until
// the thread takes them. `run` leads so the non-generic `thread_main` can find
// the instantiation that knows `T`. The argument is capacity (design.md
// "Uninitialized capacity"), so the block is allocated before it holds one.
@(private)
Start :: struct($T: type) {
	run:   proc(block: rawptr),
	entry: proc(value: move T),
	@(initialized = live) arg: [1]T,
	live:  int,
}

@(private)
Start_Header :: struct {
	run: proc(block: rawptr),
}

impl Start($T) {
	begin :: proc(raw: rawptr) {
		block := (^mut Start(T))(raw);
		entry := block^.entry;
		block^.live = 0;
		arg := unsafe.take(block^.arg[0]);
		unsafe.free(block);
		entry(move(arg));
	}
}

@(private)
thread_main :: proc "stdcall" (raw: rawptr) -> u32 {
	rt_attach();
	(^Start_Header)(raw)^.run(raw);
	rt_detach();
	return 0;
}

// Runs `entry(arg)` on a new thread. The argument is moved in, and any borrow it
// carries must be of process-lifetime storage, so nothing the thread holds can
// end under it. Both cross to the new thread, which is what makes the compiler
// check them (design.md "@(cross_thread)"). Running out of memory or threads
// panics.
@(private)
spawn_with :: proc(
	@(cross_thread) entry: proc(value: move $T),
	@(cross_thread, escape=static) arg: move T,
) -> Thread {
	block := (^mut Start(T))(unsafe.new(Start(T){run = Start(T).begin, entry = entry}));
	unsafe.write(block^.arg[0], move(arg));
	block^.live = 1;
	handle := rt_create_thread(nil, 0, thread_main, rawptr(block), 0, nil);
	if (handle == 0) {
		// No thread took the block, so it and the argument are still this
		// call's: the argument comes back out, as `begin` takes it, and the
		// unwind drops it (design.md "What the unwind runs, and what it does
		// not").
		block^.live = 0;
		unclaimed := unsafe.take(block^.arg[0]);
		unsafe.free(block);
		panic("thread creation failed");
	}
	return Thread{handle};
}

@(private)
spawn_plain :: proc(@(cross_thread) entry: proc()) -> Thread {
	plain := entry;
	return spawn_with(run_plain, move(plain));
}

@(private)
run_plain :: proc(entry: move proc()) {
	entry();
}

spawn :: proc{spawn_with, spawn_plain};

// The tasks of one `parallel` block (compiler-architecture.md "Lowering
// parallel blocks"). The compiler declares one per block, zero until its first
// spawn, and calls `start` through what it registered when it checked this
// package; no source names either. Dropping the scope is the block's join.
@(private)
Task_Scope :: move_only struct {
	threads: [dynamic]int,
}

impl Task_Scope {
	// Starts the task `frame` holds on a new thread. A frame leads with a slot
	// for the procedure that runs it, which `thread_main` calls. The thread's
	// place in the list is reserved first, so once the thread exists nothing
	// here can fail; until then no thread has the frame, and a failure panics
	// with it still the caller's (design.md "Failure to start a task").
	start :: proc(self: inout, run: proc(frame: rawptr), frame: rawptr) {
		wanted := self.threads.len() + 1;
		self.threads.reserve(wanted);
		(^mut Start_Header)(frame)^.run = run;
		handle := rt_create_thread(nil, 0, thread_main, frame, 0, nil);
		if (handle == 0) {
			panic("thread creation failed");
		}
		self.threads.append(handle);
	}

	// Joins every task, in start order: each one's writes, and its thread's
	// `thread_local` drops, happen before the block is left.
	@(private)
	join :: hook(drop) proc(self: inout) {
		foreach (handle in self.threads) {
			rt_wait(handle, INFINITE);
			rt_close(handle);
		}
	}
}

/// A `T` that one thread at a time may reach. `lock` blocks until the calling
/// thread holds it and answers a guard; the guard reaches the value, and
/// dropping it unlocks. An unlock happens before the next lock.
///
/// Every operation takes a read-only `^` receiver, so a `Mutex` works in
/// file-scope storage and behind a `Shared(T)`. It is move-only.
// As `sync.Atomic`'s do. Move-only because the lock word is an `Atomic`.
Mutex :: struct($T: type) {
	// A Windows SRWLOCK: one pointer, unlocked at zero, written only by the
	// system's own atomic operations.
	@(private) word: sync.Atomic(uintptr),
	/// For a caller that owns the mutex outright, before spawning or after joining,
	/// which needs no lock. Synchronized, as `Atomic`'s `value` is: outside this
	/// package it is reached only with exclusive access to the mutex.
	// Public for the same reason `Atomic`'s `value` is.
	@(synchronized) value: T,
}

impl Mutex($T) {
	/// Locking a mutex this thread already holds never returns.
	lock :: proc(self: ^) -> Guard(T) {
		rt_lock(rawptr(&self.word.value));
		return Guard(T){self};
	}
}

/// The pointer borrows the mutex, so it cannot move or end while locked.
Guard :: move_only struct($T: type) {
	@(private) mutex: ^Mutex(T),
}

impl Guard($T) {
	/// The guarded value, for as long as this guard holds the lock: an `inout`
	/// result borrows the guard, so nothing reached through it outlives the lock.
	get :: proc(self: inout) -> inout T {
		return inout (^mut T)(rawptr(&self.mutex.value))^;
	}

	@(private)
	unlock :: hook(drop) proc(self: inout) {
		rt_unlock(rawptr(&self.mutex.word.value));
	}
}

/// A `T` that one thread at a time may reach, whose holder can wait for it to
/// reach a state. `lock` and the guard work as `Mutex`'s do; `lock_when` waits
/// until `ready` answers `true` for the value, and `close` ends every such wait.
///
/// Dropping a guard on which `get` was called wakes every thread waiting in
/// `lock_when`, so a waiter checks its condition again after every change made
/// under the lock. A guard used only through `read` wakes no one. A `Mutex` is
/// the choice where no one waits for a state.
///
/// Its zero value is unlocked and open and holds `T`'s zero. Every operation
/// takes a read-only `^` receiver, so a `Monitor` works in file-scope storage
/// and behind a `Shared(T)`. It is move-only.
// standard-library "Monitors". Move-only, as `Mutex` is, because its lock
// and condition words are `Atomic`s.
Monitor :: struct($T: type) {
	// A Windows SRWLOCK, as `Mutex`'s is.
	@(private) word: sync.Atomic(uintptr),
	// A Windows CONDITION_VARIABLE over `word`: one pointer, ready at zero,
	// written only by the system's own atomic operations.
	@(private) wake: sync.Atomic(uintptr),
	// Written by `close` and read by `lock_when`, both under the lock; atomic
	// only because they reach it through `^`.
	@(private) closed: sync.Atomic(bool),
	/// For a caller that owns the monitor outright, before spawning or after
	/// joining, which needs no lock. Synchronized, as `Mutex`'s `value` is.
	@(synchronized) value: T,
}

impl Monitor($T) {
	/// Locking a monitor this thread already holds never returns.
	lock :: proc(self: ^) -> Monitor_Guard(T) {
		rt_lock(rawptr(&self.word.value));
		return Monitor_Guard(T){monitor = self};
	}

	/// Locks once `ready` answers `true` for the value, and answers the guard
	/// still holding the lock, so the state `ready` saw is the state the guard
	/// reaches. While `ready` answers `false` and the monitor is open, the
	/// thread releases the lock and sleeps in one step, then relocks and asks
	/// again when woken; a spurious wakeup only repeats the question. Once the
	/// monitor is closed, a `false` answer returns `.none` instead of sleeping.
	///
	/// `ready` runs on this thread with the lock held. It must answer the same
	/// for unchanged state, must not block, and must change nothing. Every
	/// mutable input to its answer must be guarded by this monitor and changed
	/// through a guard's `get`: nothing else wakes a waiter. The compiler does
	/// not check this.
	// The question and the sleep both happen with the lock held, and the sleep
	// releases it atomically, so a change made between them is impossible: it
	// waits for the lock until this thread is asleep and registered to be woken.
	lock_when :: proc(self: ^, ready: $C) -> Option(Monitor_Guard(T))
		where interfaces.Callable(C, proc(value: ^T) -> bool) {
		// A panic out of `ready` drops the guard on the unwind, unlocking.
		guard := self.lock();
		for (;;) {
			if (ready(guard.read())) { return .some(move(guard)); }
			if (self.closed.load()) { return .none; }
			rt_sleep(rawptr(&self.wake.value), rawptr(&self.word.value), INFINITE, 0);
		}
	}

	/// Closes the monitor and wakes every waiter. From then on a `lock_when`
	/// whose `ready` answers `false` returns `.none`; one whose `ready` answers
	/// `true` still returns its guard, so a closed monitor can be drained.
	/// `lock` and the guards keep working. Closing again does nothing more.
	///
	/// `close` takes the lock: calling it while this thread holds it never
	/// returns. Closing does not stop a waiter whose `ready` stays `true`.
	close :: proc(self: ^) {
		rt_lock(rawptr(&self.word.value));
		self.closed.store(true);
		rt_unlock(rawptr(&self.word.value));
		rt_wake_all(rawptr(&self.wake.value));
	}
}

/// The pointer borrows the monitor, so it cannot move or end while locked.
Monitor_Guard :: move_only struct($T: type) {
	@(private) monitor: ^Monitor(T),
	// Whether `get` was called, so dropping the guard wakes the waiters.
	@(private) changed: bool,
}

impl Monitor_Guard($T) {
	/// The guarded value, for as long as this guard holds the lock, as
	/// `Guard.get` answers it. Calling it marks the guard changed, whether or
	/// not the caller writes, so dropping the guard wakes every waiter.
	get :: proc(self: inout) -> inout T {
		self.changed = true;
		return inout (^mut T)(rawptr(&self.monitor.value))^;
	}

	/// The guarded value, read-only, for as long as this guard holds the lock.
	/// It leaves the guard unchanged, so dropping it wakes no one; an atomic
	/// updated through it wakes no one either.
	read :: proc(self: ^) -> ^T {
		// A pointer rebuilt from a `rawptr` has no checked provenance, so the
		// call goes through a plain procedure type, whose result derives from
		// its borrowed argument (design.md "Procedure result contracts"): the
		// result borrows this guard and cannot outlive the lock.
		reach: proc(guard: ^Monitor_Guard(T)) -> ^T = Monitor_Guard(T).value_of;
		return reach(self);
	}

	@(private)
	value_of :: proc(guard: ^Monitor_Guard(T)) -> ^T {
		return (^T)(rawptr(&guard.monitor.value));
	}

	// The waiters are woken after the unlock, so each can take the lock at
	// once. None is missed: a sleeping waiter registered before it released
	// the lock this guard then took.
	@(private)
	unlock :: hook(drop) proc(self: inout) {
		rt_unlock(rawptr(&self.monitor.word.value));
		if (self.changed) {
			rt_wake_all(rawptr(&self.monitor.wake.value));
		}
	}
}
