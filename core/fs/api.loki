}

Seek_Origin :: enum {Start, Current, End}

/*
	A `Shared` lock admits other shared locks and keeps out an exclusive one;
	an `Exclusive` lock keeps out every other lock.
*/
Lock_Mode :: enum {Shared, Exclusive}

/*
	`Other` is reserved; no operation produces it today. A reparse point reads
	by its directory bit until links are supported as such.
*/
