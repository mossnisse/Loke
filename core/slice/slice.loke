/**
	Slice algorithms.

	Only `clone`/`try_clone` allocate storage of their own, and say so by
	returning an owner. Copying an element can allocate through its copy hook,
	so `fill`, and the one result copy `min` and `max` return, may allocate as
	well.

	The mutating procedures take `[]mut T`, so passing a read-only `[]T` is a
	compile-time error rather than a silent no-op.

	`partition` and `select_nth_by` reorder in O(n) where a sort would cost
	O(n log n): by a predicate, or around the element at one sorted position.

	`make_heap` and its relatives keep a binary heap in a slice the caller owns.
*/
// design.md "Slices", standard-library.md "Sorting slices",
// standard-library.md "Partitioning and selection", and
// standard-library.md "Slice queries and copies".
//
// The public surface is ordinary Loke over `[]T` and `[]mut T`. Only `sort` and
// `reverse_sort` reach the runtime, through the contributed `values.sort()`.
@(public)
package slice;

import "core:mem";

// ---------------------------------------------------------------- ordering --

/**
	Sorts in place according to `less`: a plain procedure, or a value whose
	`call` method compares, such as a record carrying configuration or checked
	borrows. It is borrowed for the call and retained nowhere, and sorting
	allocates nothing. The sort is not stable.
*/
// standard-library.md "Sorting slices".
//
// Introsort over selection's helpers: the pivot sample and Hoare partition of
// select.loke, and insertion sort for a short range. Past 2*floor(log2(n))
// rounds, the standard introsort limit, a range is heapsorted, so the worst
// case is O(n log n). Every element moves by `swap`, as in selection.
sort_by :: proc(values: []mut $T, less: $C) where Callable(C, proc(left, right: T) -> bool) {
	depth := 0;
	span := values.len();
	for (span > 1) {
		span /= 2;
		depth += 2;
	}
	sort_range(values, 0, values.len(), less, depth);
}

// Sorts `values[low:high]`, recursing into the shorter side and looping on the
// longer, so the stack stays logarithmic whatever the partitions are like.
@(private)
sort_range :: proc(values: []mut $T, low_in: int, high_in: int, less: $C, depth_in: int)
	where Callable(C, proc(left, right: T) -> bool) {
	low := low_in;
	high := high_in;
	depth := depth_in;
	for (high - low > SMALL_RANGE) {
		if (depth == 0) {
			heap_sort(values[mut low:high], less);
			return;
		}
		depth -= 1;
		pivot_sample(values, low, high, less);
		p := partition_at_low(values, low, high, less);
		if (p - low < high - p - 1) {
			sort_range(values, low, p, less, depth);
			low = p + 1;
		} else {
			sort_range(values, p + 1, high, less, depth);
			high = p;
		}
	}
	insertion_sort_range(values, low, high, less);
}

// A heap under the reversed order has the last element first, so each
// `pop_heap` moves the largest remaining element to the end of what is left.
@(private)
heap_sort :: proc(values: []mut $T, less: $C) where Callable(C, proc(left, right: T) -> bool) {
	reversed := Ordering(T, C){&less, true};
	make_heap(values, reversed);
	end := values.len();
	for (end > 1) {
		pop_heap(values[mut :end], reversed);
		end -= 1;
	}
}

// Calls a borrowed comparator, with its operands swapped if `reversed`. The
// bound is repeated on `call` because it is what grants `less(...)` the caller's
// `call` method inside a capture literal or another bounded procedure, where
// this package could not otherwise see it.
@(private)
Ordering :: struct($T, $C: type) { less: ^C, reversed: bool }

impl Ordering($T, $C) {
	call :: proc(self, left, right: T) -> bool where Callable(C, proc(left, right: T) -> bool) {
		if (self.reversed) { return self.less^(right, left); }
		return self.less^(left, right);
	}
}

/**
	Ascending, in place. No allocation, and no comparator: `Ordered` is the
	precondition, and `Ordered` is IEEE-754 for floats, so a slice containing
	NaN sorts to an unspecified permutation rather than trapping. The same as
	`values.sort()`. The sort is not stable.
*/
// This is standard-library.md's free spelling of the contributed `values.sort()` member,
// and it forwards to it: one introsort in the runtime, reached by both, so the
// two spellings cannot drift apart.
sort :: proc(values: []mut $T) where Ordered(T) {
	values.sort();
}

/// Descending. The sort is not stable.
// Sorting with the comparison reversed, not sorting and then reversing: the
// two differ for equal-comparing elements only, and neither order is stable,
// so one pass is enough.
reverse_sort :: proc(values: []mut $T) where Ordered(T) {
	values.reverse_sort();
}

/**
	Whether `sort` would leave the slice as it is. `Ordered` is IEEE-754 for
	floats here too, so a NaN is neither `<` nor `>=` anything: `is_sorted` says
	true of a slice a NaN sits in the middle of, and `sort` may still move it.
	The two agree that no pair is out of order, which is all either claims.
*/
is_sorted :: proc(values: []$T) -> bool where Ordered(T) {
	foreach (i in 1 ..< values.len()) {
		if (values[i] < values[i - 1]) { return false; }
	}
	return true;
}

is_reverse_sorted :: proc(values: []$T) -> bool where Ordered(T) {
	foreach (i in 1 ..< values.len()) {
		if (values[i - 1] < values[i]) { return false; }
	}
	return true;
}

/**
	The leftmost index at which `wanted` could be inserted while keeping the
	slice sorted, plus whether it is already there. `values` must be sorted
	ascending; a caller who has not sorted gets a meaningless answer, not a trap.
*/
binary_search :: proc(values: []$T, wanted: T) -> (index: int, found: bool)
	where Ordered(T) {
	low := partition_point(values, proc(value: T) -> bool capture(&wanted) { return value < wanted; });
	return {index = low, found = low < values.len() && values[low] == wanted};
}

// ------------------------------------------------------------------ places --

/**
	The elements at `left` and `right` trade contents: no copy or drop hook runs
	on either, so it reaches a move-only element and one with no zero value
	alike. Each index is bounds-checked, and two equal indices leave the element
	as it is. The same as `values.swap()`.
*/
// The one rearrangement that installs no new value: no vacated slot has to be
// filled. `exchange` needs a replacement, and the zero is the only one
// available without a copy, which an element type may not have at all.
//
// This is standard-library.md's free spelling of the contributed `values.swap()` member,
// and it forwards to it exactly as `sort` does: one implementation, reached by
// both spellings.
swap :: proc(values: []mut $T, left: int, right: int) {
	values.swap(left, right);
}

/**
	Reverses the order of the elements in place. Built on `swap`, so it reaches a
	move-only element for the same reason `swap` does.
*/
reverse :: proc(values: []mut $T) {
	last := values.len() - 1;
	foreach (i in 0 ..< values.len() / 2) { swap(values, i, last - i); }
}

fill :: proc(values: []mut $T, @(escape=stored) value: T) {
	foreach (&mut element in values) { element = value; }
}

// ----------------------------------------------------------------- queries --

index_of :: proc(values: []$T, wanted: T) -> Option(int) where Equatable(T) {
	foreach (value, i in values.indexed()) {
		if (value == wanted) { return i; }
	}
	return .none;
}

last_index_of :: proc(values: []$T, wanted: T) -> Option(int) where Equatable(T) {
	foreach (i in (0 ..< values.len()).reversed()) {
		if (values[i] == wanted) { return i; }
	}
	return .none;
}

contains :: proc(values: []$T, wanted: T) -> bool where Equatable(T) {
	return index_of(values, wanted) != .none;
}

equal :: proc(left: []$T, right: []T) -> bool where Equatable(T) {
	if (left.len() != right.len()) { return false; }
	foreach (value, i in left.indexed()) {
		if (value != right[i]) { return false; }
	}
	return true;
}

/**
	The smallest element, or `.none` for an empty slice. Ties keep the earliest,
	and a NaN wins only from index 0; `max` is the same with `<` reversed. Only
	the result is copied.
*/
// There is no minimum of nothing, and returning the zero value would be a
// wrong answer rather than a missing one.
min :: proc(values: []$T) -> Option(T) where Ordered(T) {
	if (values.len() == 0) { return .none; }
	return values[least_index(values, Ascending(T){})];
}

max :: proc(values: []$T) -> Option(T) where Ordered(T) {
	if (values.len() == 0) { return .none; }
	return values[least_index(values, Descending(T){})];
}

// The index of the first least element of a non-empty slice under `less`: the
// candidate changes only for an element `less` than it, in one comparison per
// later element. Shared with selecting the first or last rank.
//
// The scan keeps the winner's index rather than a copy of it, so `min` and `max`
// copy only the result: a candidate whose copy hook allocates is not cloned at
// every improvement.
@(private)
least_index :: proc(values: []$T, less: $C) -> int where Callable(C, proc(left, right: T) -> bool) {
	best := 0;
	foreach (i in 1 ..< values.len()) {
		if (less(values[i], values[best])) { best = i; }
	}
	return best;
}

// --------------------------------------------------------------- ownership --

/// An owned copy of `values`: the way to keep data after its owner expires.
// design.md "Slices".
clone :: proc(values: []$T, allocator: Allocator = mem.default_allocator()) -> [dynamic]T {
	// `slice.try_clone` below, not a receiver member: a slice is a borrow and
	// owns nothing to clone. Failure follows the allocator's policy.
	switch (try_clone(values, allocator)) {
	case .ok(copied): return copied;
	case .err(error): allocation_failed(error, allocator);
	}
}

try_clone :: proc(
	values: []$T, allocator: Allocator = mem.default_allocator(),
) -> Result([dynamic]T, Allocator_Error) {
	owned := try_make([dynamic]T, 0, values.len(), allocator) or_return;
	owned.try_append(..values) or_return;
	return .ok(move(owned));
}
