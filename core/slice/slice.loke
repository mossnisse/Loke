// Slice algorithms: design.md "Slices", design.md "Sorting slices", and
// design.md "Slice queries and copies".
//
// The public surface is ordinary Loke over `[]T` and `[]mut T`. The one private
// sorting bridge reaches the runtime's raw relocation machinery. Nothing here
// allocates except `clone`/`try_clone`, which say so by returning an owner.
//
// The mutating procedures take `[]mut T`, so passing a read-only `[]T` is the
// compile-time error design.md promises rather than a silent no-op.
@(public)
package slice;

import "base:interfaces";
import "core:mem";

// ---------------------------------------------------------------- ordering --

// A typed ordering policy. The comparator is an ordinary value, so a record
// may carry configuration or checked borrows without allocating or passing
// user state through `rawptr`. `call` borrows that record and the two elements;
// sorting never retains any of them.
Comparator :: interface($C, $T: type) {
	slot call: proc(self, left, right: T) -> bool;
}

// Sorts in place according to `comparator`: a `Comparator` value, or a plain
// procedure, which is a comparator with no state.
sort_by :: proc{sort_by_comparator, sort_by_procedure};

// The package-private intrinsic owns only the bridge to the shared
// byte-relocating runtime introsort: it receives the comparator's address for
// this call and generates a typed adapter to `C.call`. The public operation and
// all callback state remain ordinary Loke.
sort_by_comparator :: proc(values: []mut $T, comparator: $C) where Comparator(C, T) {
	sort_by_intrinsic(values, &comparator);
}

// An ordinary record around the procedure, so the procedure path is checked and
// lowered exactly as a comparator a caller writes by hand.
sort_by_procedure :: proc(values: []mut $T, less: proc(left, right: T) -> bool) {
	comparator := Procedure_Comparator(T){less};
	sort_by_intrinsic(values, &comparator);
}

@(private)
Procedure_Comparator :: struct($T: type) { less: proc(left, right: T) -> bool }

impl Procedure_Comparator($T) {
	call :: proc(self, left, right: T) -> bool { return self.less(left, right); }
}

// Ascending, in place. No allocation, and no comparator: `Ordered` is the
// precondition, and design.md's `Ordered` is IEEE-754 for floats, so a slice
// containing NaN sorts to an unspecified permutation rather than trapping.
//
// This is design.md's free spelling of the contributed `values.sort()` member,
// and it forwards to it: one introsort in the runtime, reached by both, so the
// two spellings cannot drift apart. The sort is not stable.
sort :: proc(values: []mut $T) where interfaces.Ordered(T) {
	values.sort();
}

// Descending. Sorting with the comparison reversed, not sorting and then
// reversing: the two differ for equal-comparing elements only, and neither
// order is stable, so one pass is enough.
reverse_sort :: proc(values: []mut $T) where interfaces.Ordered(T) {
	values.reverse_sort();
}

// Whether `sort` would leave the slice as it is. `Ordered` is IEEE-754 for
// floats here too, so a NaN is neither `<` nor `>=` anything: `is_sorted` says
// true of a slice a NaN sits in the middle of, and `sort` may still move it.
// The two agree that no pair is out of order, which is all either claims.
is_sorted :: proc(values: []$T) -> bool where interfaces.Ordered(T) {
	foreach (i in 1 ..< values.len()) {
		if (values[i] < values[i - 1]) { return false; }
	}
	return true;
}

is_reverse_sorted :: proc(values: []$T) -> bool where interfaces.Ordered(T) {
	foreach (i in 1 ..< values.len()) {
		if (values[i - 1] < values[i]) { return false; }
	}
	return true;
}

// The leftmost index at which `wanted` could be inserted while keeping the
// slice sorted, plus whether it is already there. `values` must be sorted
// ascending; a caller who has not sorted gets a meaningless answer, not a trap.
binary_search :: proc(values: []$T, wanted: T) -> (index: int, found: bool)
	where interfaces.Ordered(T) {
	low := 0;
	high := values.len();
	for (low < high) {
		middle := low + (high - low)/2;
		if (values[middle] < wanted) { low = middle + 1; } else { high = middle; }
	}
	return {index = low, found = low < values.len() && values[low] == wanted};
}

// ------------------------------------------------------------------ places --

// Two elements trade contents, which is the one rearrangement that installs no
// new value: no copy or drop hook runs on either element, and no vacated slot
// has to be filled. That is what reaches a move-only element and a no-zero one
// alike -- `exchange` needs a replacement, and the zero is the only one
// available without a copy, which an element type may not have at all.
//
// This is design.md's free spelling of the contributed `values.swap()` member,
// and it forwards to it exactly as `sort` does: one implementation, reached by
// both spellings. Each index is bounds-checked there, and two equal indices
// leave the element as it is.
swap :: proc(values: []mut $T, left: int, right: int) {
	values.swap(left, right);
}

// Reverses the order of the elements in place. Built on `swap`, so it reaches a
// move-only element for the same reason `swap` does.
reverse :: proc(values: []mut $T) {
	low := 0;
	high := values.len();
	for (low + 1 < high) {
		high -= 1;
		swap(values, low, high);
		low += 1;
	}
}

fill :: proc(values: []mut $T, @(escape=stored) value: T) {
	foreach (i in 0 ..< values.len()) { values[i] = value; }
}

// ----------------------------------------------------------------- queries --

index_of :: proc(values: []$T, wanted: T) -> Option(int) where interfaces.Equatable(T) {
	foreach (value, i in values.indexed()) {
		if (value == wanted) { return .some(i); }
	}
	return .none;
}

last_index_of :: proc(values: []$T, wanted: T) -> Option(int) where interfaces.Equatable(T) {
	i := values.len();
	for (i > 0) {
		i -= 1;
		if (values[i] == wanted) { return .some(i); }
	}
	return .none;
}

contains :: proc(values: []$T, wanted: T) -> bool where interfaces.Equatable(T) {
	switch (_ in index_of(values, wanted)) {
	case .some: return true;
	case .none: return false;
	}
	return false;
}

equal :: proc(left: []$T, right: []T) -> bool where interfaces.Equatable(T) {
	if (left.len() != right.len()) { return false; }
	foreach (value, i in left.indexed()) {
		if (value != right[i]) { return false; }
	}
	return true;
}

// `.none` for an empty slice: there is no minimum of nothing, and returning the
// zero value would be a wrong answer rather than a missing one. The candidate
// changes only for an element `<` it, so ties keep the earliest and a NaN wins
// only from index 0; `max` is the same with `<` reversed.
min :: proc(values: []$T) -> Option(T) where interfaces.Ordered(T) {
	if (values.len() == 0) { return .none; }
	best := values[0];
	foreach (i in 1 ..< values.len()) {
		if (values[i] < best) { best = values[i]; }
	}
	return .some(best);
}

max :: proc(values: []$T) -> Option(T) where interfaces.Ordered(T) {
	if (values.len() == 0) { return .none; }
	best := values[0];
	foreach (i in 1 ..< values.len()) {
		if (best < values[i]) { best = values[i]; }
	}
	return .some(best);
}

// --------------------------------------------------------------- ownership --

// design.md "Slices": the way to keep data after its owner expires.
clone :: proc(values: []$T, allocator: Allocator = mem.default_allocator()) -> [dynamic]T {
	// `slice.try_clone` below, not a receiver member: a slice is a borrow and
	// owns nothing to clone.
	return try_clone(values, allocator) or_else panic("slice clone allocation failed");
}

try_clone :: proc(
	values: []$T, allocator: Allocator = mem.default_allocator(),
) -> Result([dynamic]T, Allocator_Error) {
	owned := try_make([dynamic]T, 0, values.len(), allocator) or_return;
	owned.try_append(..values) or_return;
	return .ok(move(owned));
}
