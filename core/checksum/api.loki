/*
	Checksums, for finding accidental corruption.

	A CRC is not an identity, since collisions are easy to construct, and not
	security, since anyone can recompute it. A stable content hash is a separate
	decision for a separate package.

	`Crc_Params` holds the fields of the CRC RevEng catalogue, so a format's CRC is
	pinned by copying its row:

	    crc: checksum.Crc32 = {};
	    crc.update(header);
	    crc.update(body);
	    if (crc.sum() != stored) { return .err(.Corrupt); }

	A running checksum is also an `io.Writer`, so `io.copy(inout crc, inout file)`
	checksums a stream with no whole-file buffer.
*/
package checksum;

import "base:interfaces";
import "core:io";

/*
	A CRC in the Rocksoft model. `polynomial` is in normal form with the top bit
	implied, whatever the reflection: CRC-32 is `0x04C11DB7`, never its reversed
	form `0xEDB88320`. `T` is an unsigned integer as wide as `width` or wider.
*/
Crc_Params :: struct($T: type) where interfaces.Integral(T) {
	width:       int,
	polynomial:  T,
	initial:     T,
	reflect_in:  bool,
	reflect_out: bool,
	final_xor:   T,
}

/*
	Whether `P` describes a CRC a `T` can hold: an unsigned `T`, a width that fits,
	an odd polynomial, and no value with bits above `width`.
*/
valid_params :: proc($T: type, P: Crc_Params(T)) -> bool ---;

/*
	A running checksum. The zero value is the checksum of no bytes, so
	`c: checksum.Crc32 = {}` is the only way to start, a forgotten initialization
	cannot exist, and `c = {}` resets.

	`update` in any pieces gives the same sum, an empty piece included, and `sum`
	does not disturb the state, so a running checksum can be read and continued.
*/
Crc :: struct($T: type, $P: Crc_Params(T)) where valid_params(T, P) {
	// and fields private to the package
}

impl Crc($T, $P) {
	// The checksum of `bytes`, in one call.
	of :: proc(bytes: []u8) -> T ---;

	// Adds `bytes` to the checksum.
	update :: proc(self: inout, bytes: []u8) ---;

	// The checksum of everything so far.
	sum :: proc(self) -> T ---;

	// The `io.Writer` slot. It never fails.
	write :: proc(self: inout, source: []u8) -> Result(int, io.Error) ---;
}

