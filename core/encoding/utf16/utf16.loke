// UTF-8 to UTF-16 and back (standard-library "`core:encoding/utf16`").
//
// Windows is a wide-character operating system: every path, environment
// variable, and console record it hands out is UTF-16. The library's public
// contract is UTF-8, so `core:fs`, `core:os`, and `core:term` convert through
// here rather than each growing a surrogate decoder of its own.
//
// One decoder stays outside that: `runtime/args.c` converts the `wmain`
// argument vector before the initial thread attaches, so there is no Loke code
// for it to call yet. It also answers a different question. design.md "Program
// entry and exit" types `os.args[i]` as `string`, with no failure channel, so an
// argument that Windows never promised to be well-formed becomes U+FFFD there.
// Every caller reaching this package has a `Result` to fail into, and gets
// `Invalid_Data` rather than a quietly changed name.
@(public)
package utf16;

import "core:mem";
import "core:strings";

Error :: enum {
	// An unpaired surrogate: valid UTF-16 has none, and no Unicode scalar value
	// corresponds to one. A native name that cannot be represented is reported
	// rather than silently changed.
	Invalid_Data,
	Out_Of_Memory,
	// U+0000 in text to encode. The result is zero-terminated for a wide call,
	// so a zero inside would end the name there: `a\0b` would open `a`.
	Contains_Zero,
}

// The text as zero-terminated UTF-16, ready for a wide operating-system call.
// The terminator is part of the buffer but not of its length contract: callers
// pass the data pointer, and `result.len() - 1` is the unit count.
//
// A `string_view` is valid UTF-8 by construction, so the only failures are an
// interior zero and allocation.
encode :: proc(
	text: string_view, allocator: Allocator = mem.default_allocator(),
) -> Result([dynamic]u16, Error) {
	switch (units in make([dynamic]u16, 0, text.len() + 1, allocator)) {
	case .ok:
		// No scalar value takes fewer UTF-8 bytes than UTF-16 units, so the
		// capacity covers every append below and none can fail.
		foreach (codepoint in text) {
			value := int(codepoint);
			if (value == 0) {
				return .err(.Contains_Zero);
			}
			if (value < 0x10000) {
				units.append(u16(value));
				continue;
			}
			rest := value - 0x10000;
			units.append(u16(0xD800 + (rest >> 10)), u16(0xDC00 + (rest & 0x3FF)));
		}
		units.append(0);
		return .ok(move(units));
	case .err:
		return .err(.Out_Of_Memory);
	}
}

// The units as an owning UTF-8 `string`. A zero unit does not end the input:
// pass the exact range to convert, which is what every Windows API that reports
// a length gives.
decode :: proc(
	units: []u16, allocator: Allocator = mem.default_allocator(),
) -> Result(string, Error) {
	builder := strings.init(allocator);
	at := 0;
	for (; at < units.len(); at += 1) {
		value := int(units[at]);
		if (value >= 0xD800 && value <= 0xDBFF) {
			if (at + 1 >= units.len()) { return .err(.Invalid_Data); }
			low := int(units[at + 1]);
			if (low < 0xDC00 || low > 0xDFFF) { return .err(.Invalid_Data); }
			combined := 0x10000 + ((value - 0xD800) << 10) + (low - 0xDC00);
			switch (added in builder.try_append(rune(combined))) {
			case .ok:
			case .err: return .err(.Out_Of_Memory);
			}
			at += 1;
			continue;
		}
		if (value >= 0xDC00 && value <= 0xDFFF) {
			return .err(.Invalid_Data);
		}
		switch (added in builder.try_append(rune(value))) {
		case .ok:
		case .err: return .err(.Out_Of_Memory);
		}
	}
	switch (finished in builder.try_finish()) {
	case .ok:  return .ok(finished);
	case .err: return .err(.Out_Of_Memory);
	}
}

// The units up to the first zero, which is what a wide API returning a
// terminated buffer gives.
length_of :: proc(units: []u16) -> int {
	foreach (unit, index in units.indexed()) {
		if (unit == 0) { return index; }
	}
	return units.len();
}
