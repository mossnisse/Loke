// `Little_Endian(T)` and `Big_Endian(T)`: storage wrappers that fix a field's
// byte order regardless of the target's (standard-library "`core:endian`").
//
// The wrapper is the *stored* form. Nothing arithmetic is defined on it: a
// caller `store`s a host value into one and `load`s a host value back out, and
// the byte swap — if the target needs one at all — happens exactly at those two
// points. That is the whole reason to have the type instead of remembering to
// swap at each use.
//
//     header: struct { magic: endian.Big_Endian(u32) };
//     header.magic = endian.Big_Endian(u32).store(0xCAFEBABE);
//     fmt.println(header.magic.load());
//
// `T` is an integer type. A one-byte `T` needs no swap and gets none.
@(public)
package endian;

import "base:interfaces";
import "core:fmt";

Little_Endian :: struct($T: type) where interfaces.Integral(T) {
	// Little-endian bytes of the value, held in a `T` because that is the only
	// storage of the right size and alignment the language offers. Reading it
	// directly is meaningless on a big-endian target, which is what `@(private)`
	// is here to prevent.
	//
	// The default structural equality over this one field is already the right
	// answer, so there is no `==` overload below: two wrappers hold equal values
	// exactly when their stored bytes match, and that needs no swap.
	@(private) stored: T,
}

impl Little_Endian($T) {
	// A host value in little-endian storage.
	store :: proc(value: T) -> Little_Endian(T) {
		return {host_to(value, Order.Little)};
	}

	// The host value back. On a little-endian target both directions are the
	// identity, and `host_to` folds them away rather than leaving a branch for
	// the optimizer.
	load :: proc(self) -> T {
		return host_to(self.stored, Order.Little);
	}

	// Explicit only: a silent conversion from `T` would put a host value where a
	// stored one belongs at every assignment, which is the bug this type exists
	// to prevent. `Little_Endian(u32)(x)` is the written form.
	from_host :: hook(convert) proc(value: T) -> Little_Endian(T) {
		return {host_to(value, Order.Little)};
	}

	// The value, not the storage: printing the swapped bytes would be a puzzle.
	// `format_to_with`, so a caller asking for hex gets hex.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to_with(writer, options, self.load());
	}
}

Big_Endian :: struct($T: type) where interfaces.Integral(T) {
	@(private) stored: T,
}

impl Big_Endian($T) {
	store :: proc(value: T) -> Big_Endian(T) {
		return {host_to(value, Order.Big)};
	}

	load :: proc(self) -> T {
		return host_to(self.stored, Order.Big);
	}

	from_host :: hook(convert) proc(value: T) -> Big_Endian(T) {
		return {host_to(value, Order.Big)};
	}

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to_with(writer, options, self.load());
	}
}

// The two byte orders, named here rather than reused from `LOKE_ENDIAN` so this
// package's public surface does not depend on a compiler-provided enum's
// spelling.
Order :: enum { Little, Big };

// The host order, as this package spells it.
host_order :: proc() -> Order {
	when (LOKE_ENDIAN == .Big) { return Order.Big; } else { return Order.Little; }
}

// Host to `wanted`, and `wanted` back to host: a byte swap is its own inverse,
// so one procedure serves both directions.
//
// `wanted` is a generic *value* parameter, so the comparison against the host
// order folds during checking and a target needing no swap emits none. As a
// runtime parameter this was a call and a branch on every `store` and `load`,
// removable only by an optimizer that the default `-opt=none` build does not
// run — in a type whose whole purpose is to make the swap free where it is not
// needed.
@(private)
host_to :: proc(value: $T, $wanted: Order) -> T where interfaces.Integral(T) {
	when (host_order() == wanted) {
		return value;
	} else {
		return byte_swap(value);
	}
}

// A one-byte value has nothing to swap, and the `when` keeps the wide-mask
// arithmetic below out of checking for it — `T(0xFF)` does not fit in an `i8`.
byte_swap :: proc(value: $T) -> T where interfaces.Integral(T) {
	when (size_of(T) == 1) {
		return value;
	} else {
		width := size_of(T);
		mask := T(0xFF);
		result := T(0);
		foreach (i in 0 ..< width) {
			part := (value >> uint(8*i)) & mask;
			result |= part << uint(8*(width - 1 - i));
		}
		return result;
	}
}
