/**
	`Endian(T, order)`, spelled `Little_Endian(T)` and `Big_Endian(T)`: storage
	wrappers that fix a field's byte order regardless of the target's.

	The wrapper is the *stored* form. Nothing arithmetic is defined on it: a
	caller `store`s a host value into one and `load`s a host value back out, and
	the byte swap — if the target needs one at all — happens exactly at those two
	points. That is the whole reason to have the type instead of remembering to
	swap at each use.

	    header: (magic: endian.Big_Endian(u32)) = {};
	    header.magic = endian.Big_Endian(u32).store(0xCAFEBABE);
	    fmt.println(header.magic.load());

	`T` is an integer type. A one-byte `T` needs no swap and gets none.

	`load` and `store` read and write a field of a byte slice in a named order,
	for offsets already validated. Untrusted input goes through
	`core:encoding/binary`.
*/
// standard-library "`core:endian`".
@(public)
package endian;

import "core:fmt";
import "core:math";
import "core:unsafe";

/**
	A value of `T` stored in byte order `order`, whatever the target's.
	`Little_Endian(T)` and `Big_Endian(T)` name the two orders.
*/
Endian :: struct($T: type, $order: Order) where Integral(T) {
	// The value's bytes in `order`, held in a `T` because that is the only
	// storage of the right size and alignment the language offers. Reading it
	// directly is meaningless on a target of the other order, which is what
	// `@(private)` is here to prevent.
	//
	// The default structural equality over this one field is already the right
	// answer, so there is no `==` overload below: two wrappers hold equal values
	// exactly when their stored bytes match, and that needs no swap.
	@(private) stored: T,
}

impl Endian($T, $order) {
	/// A host value in `order`'s storage.
	store :: proc(value: T) -> Endian(T, order) {
		return {host_to(value, order)};
	}

	/// The host value back.
	// On a target of `order` both directions are the identity, and `host_to`
	// folds them away rather than leaving a branch for the optimizer.
	load :: proc(self) -> T {
		return host_to(self.stored, order);
	}

	/**
		Explicit only: a silent conversion from `T` would put a host value where a
		stored one belongs at every assignment, which is the bug this type exists
		to prevent. `Little_Endian(u32)(x)` is the written form.
	*/
	from_host :: hook(convert) proc(value: T) -> Endian(T, order) {
		return {host_to(value, order)};
	}

	/**
		Prints the host value, not the stored bytes, with the caller's options, so
		a caller asking for hex gets hex.
	*/
	// `format_to_with` does that; printing the swapped bytes would be a puzzle.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to_with(writer, options, self.load());
	}
}

/// `T` in little-endian storage.
Little_Endian :: Endian($T, Order.Little);

/// `T` in big-endian storage.
Big_Endian :: Endian($T, Order.Big);

/// The two byte orders.
// Named here rather than reused from `LOKE_ENDIAN` so this package's public
// surface does not depend on a compiler-provided enum's spelling.
Order :: enum { Little, Big };

/// The host order, as this package spells it.
host_order :: proc() -> Order {
	when (LOKE_ENDIAN == .Big) { return Order.Big; } else { return Order.Little; }
}

// Host to `wanted`, and `wanted` back to host: a byte swap is its own inverse,
// so one procedure serves both directions.
//
// `wanted` is a generic *value* parameter, so the comparison against the host
// order folds during checking and a target needing no swap emits none. As a
// runtime parameter this was a call and a branch on every `store` and `load`,
// removable only by an optimizer that the default `-opt=none` build does not
// run — in a type whose whole purpose is to make the swap free where it is not
// needed.
@(private)
host_to :: proc(value: $T, $wanted: Order) -> T where Integral(T) {
	when (host_order() == wanted) {
		return value;
	} else {
		return byte_swap(value);
	}
}

/**
	`value` with its bytes in the opposite order. A one-byte value comes back
	unchanged.
*/
// The `when` keeps the wide-mask arithmetic below out of checking for a
// one-byte `T`: `T(0xFF)` does not fit in an `i8`. The static `foreach` leaves
// no loop or shift-count arithmetic even in an unoptimized build.
byte_swap :: proc(value: $T) -> T where Integral(T) {
	when (size_of(T) == 1) {
		return value;
	} else {
		result := T(0);
		foreach ($i in 0 ..< size_of(T)) {
			result |= ((value >> uint(8*i)) & T(0xFF)) << uint(8*(size_of(T) - 1 - i));
		}
		return result;
	}
}

/**
	Whether a format can name `T`: `u8` through `u128`, `i8` through `i128`, `f16`,
	`f32`, and `f64`. `int`, `uint`, `uintptr`, `bool`, `rune`, and enums leave a
	width or a representation to the target or the compiler.
*/
is_fixed_width :: proc($T: type) -> bool {
	return T == u8 || T == u16 || T == u32 || T == u64 || T == u128 ||
		T == i8 || T == i16 || T == i32 || T == i64 || T == i128 ||
		T == f16 || T == f32 || T == f64;
}

// The unsigned integer as wide as `T`: a field's bytes are assembled in one,
// swapped once for a big-endian field, and bit-cast to or from `T`, so a float
// keeps its exact bits and integers and floats share one codec.
@(private)
Word :: proc($T: type) -> type {
	when (size_of(T) == 1) {
		return u8;
	} else when (size_of(T) == 2) {
		return u16;
	} else when (size_of(T) == 4) {
		return u32;
	} else when (size_of(T) == 8) {
		return u64;
	} else {
		return u128;
	}
}

/**
	The `T` held by the first `size_of(T)` bytes, in `order`. A shorter slice
	panics: the caller has already validated the offset.
*/
load :: proc($T: type, bytes: []u8, order: Order) -> T where is_fixed_width(T) {
	field := bytes[:size_of(T)];
	word := Word(T)(0);
	foreach ($i in 0 ..< size_of(T)) {
		word |= Word(T)(field[i]) << uint(8*i);
	}
	if (order == .Big) { word = byte_swap(word); }
	return unsafe.transmute(T, word);
}

/**
	`value` into the first `size_of(T)` bytes, in `order`. A shorter slice panics
	and writes nothing.
*/
// The slice is cut before the first write, so a short one traps with the
// field untouched.
store :: proc(bytes: []mut u8, value: $T, order: Order) where is_fixed_width(T) {
	field := bytes[mut :size_of(T)];
	word := unsafe.transmute(Word(T), value);
	if (order == .Big) { word = byte_swap(word); }
	foreach ($i in 0 ..< size_of(T)) {
		field[i] = math.wrap(u8, word >> uint(8*i));
	}
}
