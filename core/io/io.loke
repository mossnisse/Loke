/**
	Byte streams and the shared I/O error.

	This package owns the error type used by `io`, `fs`, `term`, and fallible
	process I/O. It is **not** a universal application error type: it describes
	what a byte stream or an operating system did, and nothing else.

	Everything here is synchronous and blocking, and there are no buffered
	wrappers: `read_to_end` plus a caller's own `[]mut u8` covers most needs.
*/
// standard-library "Shared I/O contract".
//
// Buffered wrappers are deliberately absent: buffering policy is worth
// designing against a measured cost. When it arrives it will be an explicit
// wrapper value, never hidden global state.
@(public)
package io;

import "core:fmt";
import "core:mem";
import "core:strings";

// ----------------------------------------------------------------- errors --

/**
	A normalized failure. Platform error numbers stay in `native_code`; nothing
	here is a Windows or POSIX constant.
*/
Code :: enum {
	End_Of_Input,
	Unexpected_End,
	Not_Found,
	Permission_Denied,
	Already_Exists,
	Invalid_Path,
	Invalid_Data,
	Interrupted,
	Would_Block,
	Broken_Pipe,
	Not_A_Terminal,
	/**
		The stream was closed before this call. Distinct from `Unsupported`, which
		is a live stream asked for a direction it does not have.
	*/
	Closed,
	Directory_Not_Empty,
	Out_Of_Space,
	Out_Of_Memory,
	Limit_Exceeded,
	Unsupported,
	Other,
}

/**
	A closed, non-owning description of *which* operation failed, so an error
	can never outlive its diagnostic text.
*/
// It replaces a borrowed operation string. Add a member when a public
// operation needs a distinct diagnostic; do not put paths or other caller data
// in an error merely for context.
Operation :: enum {
	Read,
	Write,
	Open,
	Close,
	Flush,
	Seek,
	Read_Line,
	Read_To_End,
	Metadata,
	Remove,
	Remove_Directory,
	Rename,
	Create_Directory,
	Read_Directory,
	Terminal_Mode,
	Read_Key,
	Environment,
	Working_Directory,
	Executable_Path,
	Spawn,
	Wait,
	Kill,
	Other,
}

/**
	Owned scalars only: no borrowed path, and no allocation merely to report a
	failure. The fields are package-private; the queries below are the access.
	Every fallible procedure here returns `Result(T, Error)` and composes with
	`or_return`.
*/
// design.md "Typed fallibility": failure is a payload inside `Result`, not a
// nil-status wrapper around one.
Error :: struct {
	@(private) code:        Code,
	@(private) native_code: u32,
	@(private) operation:   Operation,
}

/**
	An `Error` for a `Reader` or `Writer` implementation, or another package
	that calls the platform, to report.
*/
// Public because Loke has package and public visibility only: `core:fs`,
// `core:term`, `core:os`, and third-party `Reader`/`Writer` implementations
// cannot call a package-private constructor. Both take owned scalar data, so
// exposing them does not weaken the lifetime guarantee.
make_error :: proc(code: Code, operation: Operation, native_code: u32 = 0) -> Error {
	return Error{code, native_code, operation};
}

/**
	The portable `Error` for a platform error number. The numbers are Windows
	system error codes; a number the table does not know is `Other`.
*/
// The one table from a platform error number to a portable code, shared by
// every package that calls the platform. Windows is the only backend so far.
from_native_code :: proc(native_code: u32, operation: Operation) -> Error {
	n := native_code;
	code := Code.Other;
	if (n == 2 || n == 3 || n == 203) { code = .Not_Found; }
	else if (n == 5 || n == 19 || n == 32) { code = .Permission_Denied; }
	else if (n == 80 || n == 183) { code = .Already_Exists; }
	else if (n == 8 || n == 14) { code = .Out_Of_Memory; }
	else if (n == 38) { code = .End_Of_Input; }
	else if (n == 109 || n == 232) { code = .Broken_Pipe; }
	else if (n == 112) { code = .Out_Of_Space; }
	else if (n == 145) { code = .Directory_Not_Empty; }
	else if (n == 123 || n == 161 || n == 206 || n == 267) { code = .Invalid_Path; }
	else if (n == 193 || n == 216) { code = .Invalid_Data; }
	else if (n == 995) { code = .Interrupted; }
	else if (n == 1 || n == 50) { code = .Unsupported; }
	return Error{code, native_code, operation};
}

/**
	The `Error` for an allocation failure. No procedure here returns both an
	`Allocator_Error` and an `Error`.
*/
// The one conversion point between the two vocabularies. A procedure here that
// allocates takes an allocator, uses the `try_` form internally, destroys any
// partial result, and converts the failure exactly once.
from_allocator_error :: proc(operation: Operation) -> Error {
	return Error{.Out_Of_Memory, 0, operation};
}

is :: proc(error: Error, code: Code) -> bool { return error.code == code; }

code_of :: proc(error: Error) -> Code { return error.code; }

operation_of :: proc(error: Error) -> Operation { return error.operation; }

native_code_of :: proc(error: Error) -> u32 { return error.native_code; }

impl Error {
	/**
		Prints the operation and the code, so `fmt.eprintln("error:", error)` reads
		as a sentence rather than three raw fields.
	*/
	// design.md's coherence rule: a `format` is eligible only in the value type's
	// own package, and this is that package.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, self.operation, "failed:", self.code);
		if (self.native_code != 0) {
			// One call per piece: `format_to` separates *its own* arguments with a
			// space, and the spacing wanted here is not that.
			fmt.format_to(writer, " (native ");
			fmt.format_to(writer, self.native_code);
			fmt.format_to(writer, ")");
		}
	}
}

// ---------------------------------------------------------------- streams --

/**
	The two protocols. Both slots take `inout self`, and both interfaces have
	`dyn` views, `dyn mut Reader` and `dyn mut Writer`.
*/
// Both are declared with `slot` requirements, which is what dyn-compatibility
// needs — and that is what makes `dyn mut Writer` exist for the formatting
// adapter below.
///
/// The contracts are:
///
///   - a count is always between zero and the supplied slice length;
///   - an empty slice succeeds immediately with a zero count;
///   - a read reports `End_Of_Input` only when it produced no more bytes;
///   - an implementation that made progress reports the count and surfaces the
///     failure on the *next* call, because a `Result` carries one or the other
///     and progress must never be lost;
///   - a zero count with no error is permitted only for an empty slice;
///   - `write` may write only a prefix — `write_all` handles partial writes; and
///   - an implementation retries an interrupted platform call where that is safe
///     and no observable progress has happened.
Reader :: interface($Self: type) {
	slot read: proc(self: inout Self, destination: []mut u8) -> Result(int, Error);
}

Writer :: interface($Self: type) {
	slot write: proc(self: inout Self, source: []u8) -> Result(int, Error);
}

Line_Options :: struct { keep_ending: bool }

// The buffer a helper uses when the caller supplies none. Big enough that a
// whole-file copy is not dominated by call overhead, small enough for a frame.
@(private)
CHUNK :: 4096;

/**
	Fills `destination` completely, or fails. A stream that ends early is
	`Unexpected_End`, which is the difference between this and `read`.

	"Or fails" is not "or leaves the buffer alone": a failure part way through
	has already written the bytes it did read, and a `Result` carries the error
	rather than the count, so a caller cannot learn how far it got. Read into a
	scratch buffer instead when the destination must stay intact on failure.
*/
read_exact :: proc(reader: inout $R, destination: []mut u8) -> Status(Error) where Reader(R) {
	filled := 0;
	for (; filled < destination.len(); ) {
		switch (reader.read(&mut destination[filled:])) {
		case .ok(outcome):
			if (outcome == 0) { return .err(make_error(.Unexpected_End, .Read)); }
			filled += outcome;
		case .err(outcome):
			if (is(outcome, .End_Of_Input)) {
				return .err(make_error(.Unexpected_End, .Read));
			}
			return .err(outcome);
		}
	}
}

/// Writes every byte, looping over partial writes.
write_all :: proc(writer: inout $W, source: []u8) -> Status(Error) where Writer(W) {
	written := 0;
	for (; written < source.len(); ) {
		count := writer.write(source[written:]) or_return;
		// The slice is never empty here, so a conforming writer never answers zero
		// -- this is a writer breaking the contract, and the guard is what keeps
		// that from spinning forever. `Broken_Pipe` because a sink that accepts
		// nothing and a sink that has gone away are the same thing from here.
		if (count == 0) {
			return .err(make_error(.Broken_Pipe, .Write));
		}
		written += count;
	}
}

write_string :: proc(writer: inout $W, text: string_view) -> Status(Error) where Writer(W) {
	return write_all(inout writer, text.bytes());
}

/**
	Everything the reader has left, as owned bytes.

	A `limit` of zero or less means no library-imposed limit. A positive limit is
	what keeps an untrusted stream from causing an unbounded allocation: input
	that would make the result exceed it destroys the partial result and returns
	`Limit_Exceeded` alone.
*/
read_to_end :: proc(
	reader: inout $R,
	allocator: Allocator = mem.default_allocator(),
	limit: int = 0,
) -> Result([dynamic]u8, Error) where Reader(R) {
	collected := make([dynamic]u8, 0, 0, allocator);
	chunk: [CHUNK]u8 = {};
	for (;;) {
		count := 0;
		switch (reader.read(&mut chunk[:])) {
		case .ok(outcome): count = outcome;
		case .err(outcome):
			if (is(outcome, .End_Of_Input)) { return move(collected); }
			return .err(outcome);
		}
		if (count == 0) { return move(collected); }
		if (limit > 0 && collected.len() + count > limit) {
			return .err(make_error(.Limit_Exceeded, .Read_To_End));
		}
		switch (collected.try_append(..chunk[0:count])) {
		case .ok:
		case .err:
			return .err(from_allocator_error(.Read_To_End));
		}
	}
}

/**
	Bytes from `source` into `destination` until the source ends, answering how
	many moved. A caller's `buffer` avoids the frame-sized one.

	The count is a success answer only. A `Result` carries the error instead on
	failure, so a partial transfer reports no total and cannot be resumed from
	one -- a caller who needs that owns the loop and calls `read` and `write_all`
	itself.
*/
copy :: proc(
	destination: inout $W, source: inout $R, buffer: []mut u8 = {},
) -> Result(u64, Error) where Writer(W), Reader(R) {
	own: [CHUNK]u8 = {};
	window := buffer if buffer.len() > 0 else &mut own[:];
	moved: u64 = 0;
	for (;;) {
		count := 0;
		switch (source.read(window)) {
		case .ok(outcome): count = outcome;
		case .err(outcome):
			if (is(outcome, .End_Of_Input)) { return moved; }
			return .err(outcome);
		}
		if (count == 0) { return moved; }
		write_all(inout destination, window[0:count]) or_return;
		moved += u64(count);
	}
}

/**
	One line, without its ending unless `keep_ending` asks for it. `\r\n` and `\n`
	both end a line; an unterminated final line is returned successfully, and end
	of input before any byte at all is `End_Of_Input`.

	It reads one byte per `read`, which suits a terminal or a small file.
*/
// ponytail: one `read` per byte, because this package has no buffered reader
// yet. The obvious thing to revisit when the buffered wrapper lands — it goes
// behind this same signature.
read_line :: proc(
	reader: inout $R,
	allocator: Allocator = mem.default_allocator(),
	options: Line_Options = {},
) -> Result(string, Error) where Reader(R) {
	collected := make([dynamic]u8, 0, 0, allocator);
	one: [1]u8 = {};
	for (;;) {
		count := 0;
		switch (reader.read(&mut one[:])) {
		case .ok(outcome): count = outcome;
		case .err(outcome):
			if (!is(outcome, .End_Of_Input)) {
				return .err(outcome);
			}
			// The end leaves `count` at zero, read just below.
		}
		if (count == 0) {
			// Every byte before a newline is collected, so nothing collected means
			// nothing read: the end of the stream rather than an empty last line.
			if (collected.len() == 0) {
				return .err(make_error(.End_Of_Input, .Read_Line));
			}
			break;
		}
		newline := one[0] == u8('\n');
		if (newline && !options.keep_ending) {
			// The `\r` of a `\r\n` ending goes with it.
			kept := collected.len() - 1;
			if (kept >= 0 && collected[kept] == u8('\r')) {
				collected.resize(kept);
			}
			break;
		}
		switch (collected.try_append(one[0])) {
		case .ok:
		case .err:
			return .err(from_allocator_error(.Read_Line));
		}
		if (newline) { break; }
	}
	// The byte-to-text boundary: a line is only a `string` if it is valid UTF-8.
	switch (string_view.from_utf8(collected[:])) {
	case .some(view):
		// A blank line and a failed copy are different answers, and only one of
		// them is a line: this converts the allocator failure instead of standing
		// in an empty string for it.
		switch (strings.try_copy(view, allocator)) {
		case .ok(text):  return text;
		case .err: return .err(from_allocator_error(.Read_Line));
		}
	case .none:
		return .err(make_error(.Invalid_Data, .Read_Line));
	}
}

// ------------------------------------------------------------ byte buffer --

/**
	An owning, growing byte sink: a `Writer` whose bytes land in memory, to be
	read back with `bytes` or taken with `into_bytes`. A write either appends
	all of its bytes or fails with `Out_Of_Memory` and appends none.

	**The zero value is a usable, empty, allocator-unbound buffer**: the first
	growth binds the default provider. `init` selects another one up front.
*/
// standard-library "Byte buffer". A `[dynamic]u8` is not itself a `Writer`, and
// an extension making it one would be visible only in the package declaring it.
Buffer_Writer :: struct {
	@(private) data: [dynamic]u8,
}

impl Buffer_Writer {
	/**
		An empty buffer whose storage comes from `allocator`. Nothing is
		allocated until the first write.
	*/
	init :: proc(allocator: Allocator = mem.default_allocator()) -> Buffer_Writer {
		return Buffer_Writer{make([dynamic]u8, 0, 0, allocator)};
	}

	write :: proc(self: inout, source: []u8) -> Result(int, Error) {
		switch (self.data.try_append(..source)) {
		case .ok:  return source.len();
		case .err: return .err(from_allocator_error(.Write));
		}
	}

	/**
		Everything written so far, borrowed: a write while the view is in use is
		rejected.
	*/
	bytes :: proc(self: ^) -> []u8 { return self.data[:]; }

	len :: proc(self) -> int { return self.data.len(); }

	/// Forgets the contents and keeps the allocation, for the next document.
	clear :: proc(self: inout) { self.data.clear(); }

	/// The contents as owned bytes, without a copy.
	into_bytes :: proc(self: move) -> [dynamic]u8 { return exchange(inout self.data, {}); }
}

// ------------------------------------------------------- formatting bridge --

/**
	A `fmt.Sink` cannot report a failure, which is fine for a diagnostic sink and
	wrong for a file. These two format through a sink that writes into an
	`io.Writer`, latch the first `Error`, make every later write a no-op, and
	return the latched error when formatting is done.
*/
write_formatted :: proc(writer: inout $W, args: ..any_view) -> Status(Error) where Writer(W) {
	latch := Latch{(dyn mut Writer)(&mut writer), .none};
	fmt.format_to((fmt.Writer)(&mut latch), ..args);
	return latched(latch.error);
}

write_formatted_line :: proc(writer: inout $W, args: ..any_view) -> Status(Error) where Writer(W) {
	latch := Latch{(dyn mut Writer)(&mut writer), .none};
	fmt.format_to((fmt.Writer)(&mut latch), ..args);
	fmt.format_to((fmt.Writer)(&mut latch), "\n");
	return latched(latch.error);
}

// `Option(Error)` rather than `Result`, because a latch records *whether* a
// failure happened rather than standing in for a value.
@(private)
Latch :: struct {
	writer: dyn mut Writer,
	error:  Option(Error),
}

impl Latch {
	write :: proc(self: inout, bytes: []u8) {
		// The first failure wins and every later write does nothing, so a
		// half-formatted value cannot turn into a second, more confusing error.
		switch (self.error) {
		case .some: return;
		case .none:
		}
		switch (write_all(inout self.writer, bytes)) {
		case .ok:
		case .err(error): self.error = .some(error);
		}
	}
}

// The failure alone: taking the whole `Latch` would copy its `dyn mut Writer`
// to read one scalar field beside it.
@(private)
latched :: proc(error: Option(Error)) -> Status(Error) {
	switch (error) {
	case .some(failure): return .err(failure);
	case .none: return .ok;
	}
}
