// Byte streams and the shared I/O error (standard-library-plan "Shared I/O
// contract").
//
// This package owns the error type used by `io`, `fs`, `term`, and fallible
// process I/O. It is **not** a universal application error type: it describes
// what a byte stream or an operating system did, and nothing else.
//
// The first release is synchronous and blocking. Buffered wrappers are
// deliberately absent — `read_to_end` plus a caller's own `[]mut u8` covers what
// the rest of the library needs, and buffering policy is worth designing against
// a measured cost. When it arrives it will be an explicit wrapper value, never
// hidden global state.
@(public)
package io;

import "core:fmt";
import "core:mem";
import "core:strings";
import "core:unsafe";

// ----------------------------------------------------------------- errors --

// A normalized failure. Platform error numbers stay in `native_code`; nothing
// here is a Windows or POSIX constant.
Code :: enum {
	End_Of_Input,
	Unexpected_End,
	Not_Found,
	Permission_Denied,
	Already_Exists,
	Invalid_Path,
	Invalid_Data,
	Interrupted,
	Would_Block,
	Broken_Pipe,
	Not_A_Terminal,
	Out_Of_Space,
	Out_Of_Memory,
	Limit_Exceeded,
	Unsupported,
	Other,
}

// A closed, non-owning description of *which* operation failed. It replaces a
// borrowed operation string, so an error can never outlive its diagnostic text.
// Add a member when a public operation needs a distinct diagnostic; do not put
// paths or other caller data in an error merely for context.
Operation :: enum {
	Read,
	Write,
	Open,
	Close,
	Flush,
	Seek,
	Copy,
	Read_Line,
	Read_To_End,
	Metadata,
	Exists,
	Remove,
	Rename,
	Create_Directory,
	Read_Directory,
	Path_Conversion,
	Terminal_Mode,
	Read_Key,
	Environment,
	Working_Directory,
	Executable_Path,
	Other,
}

// Owned scalars only: no borrowed path, and no allocation merely to report a
// failure. The fields are package-private; the queries below are the access.
Error_Info :: struct {
	@(private) code:        Code,
	@(private) native_code: u32,
	@(private) operation:   Operation,
}

// nil is success, which is what makes every fallible procedure here compose with
// `or_return`.
Error :: union {Error_Info}

// Public because Loke has package and public visibility only: `core:fs`,
// `core:term`, `core:os`, and third-party `Reader`/`Writer` implementations
// cannot call a package-private constructor. Both take owned scalar data, so
// exposing them does not weaken the lifetime guarantee.
make_error :: proc(code: Code, operation: Operation, native_code: u32 = 0) -> Error {
	return Error_Info{code, native_code, operation};
}

// The one conversion point between the two vocabularies. A procedure here that
// allocates takes an allocator, uses the `try_` form internally, destroys any
// partial result, and converts the failure exactly once — so no procedure ever
// returns both an `Allocator_Error` and an `Error`.
from_allocator_error :: proc(error: Allocator_Error, operation: Operation) -> Error {
	if (error == nil) { return nil; }
	return Error_Info{.Out_Of_Memory, 0, operation};
}

is :: proc(error: Error, code: Code) -> bool {
	info, present := error.(Error_Info);
	return present && info.code == code;
}

code_of :: proc(error: Error) -> Code {
	info, present := error.(Error_Info);
	return info.code if present else .Other;
}

operation_of :: proc(error: Error) -> Operation {
	info, present := error.(Error_Info);
	return info.operation if present else .Other;
}

native_code_of :: proc(error: Error) -> u32 {
	info, present := error.(Error_Info);
	return info.native_code if present else 0;
}

impl Error_Info {
	// design.md's coherence rule: a `format` is eligible only in the value type's
	// own package, and this is that package. `fmt.eprintln("error:", error)`
	// therefore prints the operation and the code rather than three raw fields.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, self.operation, "failed:", self.code);
		if (self.native_code != 0) {
			// One call per piece: `format_to` separates *its own* arguments with a
			// space, and the spacing wanted here is not that.
			fmt.format_to(writer, " (native ");
			fmt.format_to(writer, self.native_code);
			fmt.format_to(writer, ")");
		}
	}
}

// ---------------------------------------------------------------- streams --

// The two protocols. Both are declared with `slot` requirements: an expression
// requirement's result is a single type and there is no tuple type, so
// `-> (int, Error)` is not expressible that way — and `slot` is also what
// dyn-compatibility needs, which is what makes `dyn mut Writer` exist for the
// formatting adapter below. Both slots take `inout self`, so both views are
// mutable ones.
//
// The contracts are:
//
//   - a count is always between zero and the supplied slice length;
//   - an empty slice succeeds immediately with a zero count;
//   - a read reports `End_Of_Input` only when it produced no more bytes;
//   - an implementation may return a positive count *and* an error together, and
//     a caller must consume the count before handling the error;
//   - a zero count with no error is permitted only for an empty slice;
//   - `write` may write only a prefix — `write_all` handles partial writes; and
//   - an implementation retries an interrupted platform call where that is safe
//     and no observable progress has happened.
Reader :: interface($Self: type) {
	slot read: proc(self: inout Self, destination: []mut u8) -> (int, Error);
}

Writer :: interface($Self: type) {
	slot write: proc(self: inout Self, source: []u8) -> (int, Error);
}

Line_Options :: struct { keep_ending: bool }

// The buffer a helper uses when the caller supplies none. Big enough that a
// whole-file copy is not dominated by call overhead, small enough for a frame.
@(private)
CHUNK :: 4096;

// Fills `destination` completely, or fails. A stream that ends early is
// `Unexpected_End`, which is the difference between this and `read`.
read_exact :: proc(reader: inout $R, destination: []mut u8) -> Error where Reader(R) {
	filled := 0;
	for (; filled < len(destination); ) {
		count, error := reader.read(destination[filled:]);
		filled += count;
		if (error != nil) {
			if (is(error, .End_Of_Input)) {
				return make_error(.Unexpected_End, .Read);
			}
			return error;
		}
		if (count == 0) {
			return make_error(.Unexpected_End, .Read);
		}
	}
	return nil;
}

// Writes every byte, looping over partial writes.
write_all :: proc(writer: inout $W, source: []u8) -> Error where Writer(W) {
	written := 0;
	for (; written < len(source); ) {
		count, error := writer.write(source[written:]);
		written += count;
		if (error != nil) { return error; }
		if (count == 0) {
			return make_error(.Broken_Pipe, .Write);
		}
	}
	return nil;
}

write_string :: proc(writer: inout $W, text: string_view) -> Error where Writer(W) {
	return write_all(inout writer, text.bytes());
}

// Everything the reader has left, as owned bytes.
//
// `limit == 0` means no library-imposed limit. A nonzero limit is what keeps an
// untrusted stream from causing an unbounded allocation: input that would make
// the result exceed it returns `Limit_Exceeded`, destroys the partial result,
// and returns the zero value.
read_to_end :: proc(
	reader: inout $R,
	allocator: Allocator = mem.default_allocator(),
	limit: int = 0,
) -> ([dynamic]u8, Error) where Reader(R) {
	collected, made := make([dynamic]u8, 0, 0, allocator);
	if (made != nil) {
		return collected, from_allocator_error(made, .Read_To_End);
	}
	chunk: [CHUNK]u8 = {};
	for (;;) {
		count, error := reader.read(chunk[:]);
		if (count > 0) {
			if (limit > 0 && len(collected) + count > limit) {
				drop(collected);
				return {}, make_error(.Limit_Exceeded, .Read_To_End);
			}
			if (failed := collected.try_append(..chunk[0:count]); failed != nil) {
				drop(collected);
				return {}, from_allocator_error(failed, .Read_To_End);
			}
		}
		if (error != nil) {
			if (is(error, .End_Of_Input)) { return collected, nil; }
			drop(collected);
			return {}, error;
		}
		if (count == 0) { return collected, nil; }
	}
}

// Bytes from `source` into `destination` until the source ends, answering how
// many moved. A caller's `buffer` avoids the frame-sized one.
copy :: proc(
	destination: inout $W, source: inout $R, buffer: []mut u8 = nil,
) -> (u64, Error) where Writer(W), Reader(R) {
	own: [CHUNK]u8 = {};
	window := buffer if len(buffer) > 0 else own[:];
	moved: u64 = 0;
	for (;;) {
		count, error := source.read(window);
		if (count > 0) {
			if (failed := write_all(inout destination, window[0:count]); failed != nil) {
				return moved, failed;
			}
			moved += u64(count);
		}
		if (error != nil) {
			if (is(error, .End_Of_Input)) { return moved, nil; }
			return moved, error;
		}
		if (count == 0) { return moved, nil; }
	}
}

// One line, without its ending unless `keep_ending` asks for it. `\r\n` and `\n`
// both end a line; an unterminated final line is returned successfully, and end
// of input before any byte at all is `End_Of_Input`.
//
// ponytail: one `read` per byte, because this package has no buffered reader
// yet. Correct for a terminal and for a small file, and the obvious thing to
// revisit when the buffered wrapper lands — it goes behind this same signature.
read_line :: proc(
	reader: inout $R,
	allocator: Allocator = mem.default_allocator(),
	options: Line_Options = {},
) -> (string, Error) where Reader(R) {
	collected, made := make([dynamic]u8, 0, 0, allocator);
	if (made != nil) {
		return "", from_allocator_error(made, .Read_Line);
	}
	one: [1]u8 = {};
	seen := 0;
	ended := false;
	for (; !ended; ) {
		count, error := reader.read(one[:]);
		if (count == 1) {
			seen += 1;
			if (one[0] == u8('\n')) {
				ended = true;
				if (!options.keep_ending) {
					// The `\r` of a `\r\n` ending goes with it.
					kept := len(collected) - 1;
					if (kept >= 0 && collected[kept] == u8('\r')) {
						collected.resize(kept);
					}
					if (error != nil && !is(error, .End_Of_Input)) {
						return "", error;
					}
					break;
				}
			}
			if (failed := collected.try_append(one[0]); failed != nil) {
				return "", from_allocator_error(failed, .Read_Line);
			}
			// A reader may make progress and report a failure in the same call. The
			// byte belongs to this line, but the accompanying failure must not be
			// replaced by whatever the next read happens to return.
			if (error != nil) {
				if (!is(error, .End_Of_Input)) { return "", error; }
				ended = true;
			}
			continue;
		}
		if (error != nil && !is(error, .End_Of_Input)) {
			return "", error;
		}
		if (seen == 0) {
			return "", make_error(.End_Of_Input, .Read_Line);
		}
		ended = true;
	}
	// The byte-to-text boundary: a line is only a `string` if it is valid UTF-8.
	view, valid := string_view(collected[:]);
	if (!valid) {
		return "", make_error(.Invalid_Data, .Read_Line);
	}
	text, allocation := strings.try_copy(view, allocator);
	if (allocation != nil) {
		return "", from_allocator_error(allocation, .Read_Line);
	}
	return text, nil;
}

// ------------------------------------------------------- formatting bridge --

// The existing `fmt.Writer` callback cannot report a failure, which is fine for
// a diagnostic sink and wrong for a file. These two present a `fmt.Writer` that
// writes into an `io.Writer`, latch the first `Error`, make every later callback
// a no-op, and return the latched error when formatting is done.
//
// **This is not a safe construction and must not be described as one.**
// `fmt.Writer.state` is a `rawptr`, so the adapter holds a local latch record
// and passes its address through that untyped field. The resulting `fmt.Writer`
// is valid only for the enclosing call: it is constructed, used, and discarded
// inside these bodies, and the raw pointer is never a value a caller holds.
write_formatted :: proc(writer: inout $W, args: ..any_view) -> Error where Writer(W) {
	latch := Latch{(dyn mut Writer)(&mut writer), nil};
	fmt.format_to(fmt.Writer{latch_sink, &mut latch}, ..args);
	return latch.error;
}

write_formatted_line :: proc(writer: inout $W, args: ..any_view) -> Error where Writer(W) {
	latch := Latch{(dyn mut Writer)(&mut writer), nil};
	adapter := fmt.Writer{latch_sink, &mut latch};
	fmt.format_to(adapter, ..args);
	fmt.format_to(adapter, "\n");
	return latch.error;
}

@(private)
Latch :: struct {
	writer: dyn mut Writer,
	error:  Error,
}

@(private)
latch_sink :: proc(state: rawptr, bytes: [^]u8, count: int) {
	latch := (^mut Latch)(state);
	// The first failure wins and every later callback does nothing, so a
	// half-formatted value cannot turn into a second, more confusing error.
	if (latch^.error != nil || count <= 0) { return; }
	latch^.error = write_all(inout latch^.writer, bytes[0:count]);
}
