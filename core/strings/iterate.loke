// Borrowing iterators: split, fields, and lines (standard-library
// "Borrowing transformations and iterators").
//
// None of these allocates. Every part borrows the text it was built from, so it
// cannot outlive it — which is exactly what a `string_view` already promises.
// Each is an ordinary iteration protocol implementation, so `foreach` walks it
// and generic code sees the same `Element`/`Iterator`/`iter`/`next` members a
// built-in container contributes.
@(public)
package strings;

// Every part between occurrences of `separator`, left to right. A trailing
// separator therefore yields a final empty part, and an empty separator yields
// the whole text once.
split :: proc(text: string_view, separator: string_view) -> Split_Iterator {
	return Split_Iterator{text, separator, false};
}

Split_Iterator :: struct {
	@(private) rest:      string_view,
	@(private) separator: string_view,
	@(private) done:      bool,
}

impl Split_Iterator {
	Element  :: string_view;
	Iterator :: Split_Iterator;

	iter :: proc(self) -> Split_Iterator { return self; }

	next :: proc(self: inout Split_Iterator) -> Option(string_view) {
		if (self.done) { return .none; }
		switch (index(self.rest, self.separator)) {
		case .some(at):
			if (self.separator.len() == 0) {
				self.done = true;
				return .some(self.rest);
			}
			part := self.rest[0:at];
			self.rest = self.rest[at + self.separator.len():];
			return .some(part);
		case .none:
			self.done = true;
			return .some(self.rest);
		}
	}
}

// Runs of non-whitespace, with every run of Unicode White_Space between them
// discarded. Empty and all-whitespace text yield nothing.
fields :: proc(text: string_view) -> Fields_Iterator {
	return Fields_Iterator{text};
}

Fields_Iterator :: struct {
	@(private) rest: string_view,
}

impl Fields_Iterator {
	Element  :: string_view;
	Iterator :: Fields_Iterator;

	iter :: proc(self) -> Fields_Iterator { return self; }

	next :: proc(self: inout Fields_Iterator) -> Option(string_view) {
		start := self.rest.len();
		foreach (codepoint, offset in self.rest.rune_offsets()) {
			if (!is_space(codepoint)) {
				start = offset;
				break;
			}
		}
		rest := self.rest[start:];
		if (rest.len() == 0) {
			self.rest = rest;
			return .none;
		}
		end := rest.len();
		foreach (codepoint, offset in rest.rune_offsets()) {
			if (is_space(codepoint)) {
				end = offset;
				break;
			}
		}
		self.rest = rest[end:];
		return .some(rest[0:end]);
	}
}

// Lines separated by `\n` or `\r\n`, with the ending removed. A final
// unterminated line is yielded; a final ending is not followed by an empty line.
lines :: proc(text: string_view) -> Lines_Iterator {
	return Lines_Iterator{text, false};
}

Lines_Iterator :: struct {
	@(private) rest: string_view,
	@(private) done: bool,
}

impl Lines_Iterator {
	Element  :: string_view;
	Iterator :: Lines_Iterator;

	iter :: proc(self) -> Lines_Iterator { return self; }

	next :: proc(self: inout Lines_Iterator) -> Option(string_view) {
		if (self.done) { return .none; }
		at := 0;
		switch (found in index_byte(self.rest, u8('\n'))) {
		case .some: at = found;
		case .none:
			self.done = true;
			if (self.rest.len() == 0) { return .none; }
			return .some(self.rest);
		}
		line := self.rest[0:at];
		// A byte read, not a subrange: `line.len() - 1` is the middle of a code
		// point whenever the line ends with a multi-byte one.
		if (line.len() > 0 && line.bytes()[line.len() - 1] == u8('\r')) {
			line = line[0:line.len() - 1];
		}
		self.rest = self.rest[at + 1:];
		return .some(line);
	}
}
