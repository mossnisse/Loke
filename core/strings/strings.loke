/**
	UTF-8 algorithms and efficient construction.

	The built-in `string` already owns validation, byte and rune counts,
	comparison, slicing, concatenation, rune iteration and the conversions. This
	package adds what those primitives do not: search, trimming, splitting,
	joining, and a builder that turns repeated appends into one allocation.

	Every index and length here is a **byte offset**. A name says `rune` when it
	means a scalar value; nothing in this package counts graphemes.
*/
// standard-library "`core:strings`".
//
// The compiler contributes one package-private primitive:
//
//   allocate_string(text: string_view, allocator: Allocator)
//       -> Result(string, Allocator_Error)
//
// which copies known-valid UTF-8 into string storage from a *supplied*
// allocator. Every built-in text operation allocates from the default provider,
// so this is the one thing a library cannot express — `copy` and `try_copy`
// below are its public face. `String_Builder.copy_string` and `fmt.to_string`
// call it directly, and the rest of the standard library goes through `copy` and
// `try_copy` or a builder.
@(public)
package strings;

import "core:mem";
import "core:unsafe";

// ------------------------------------------------------------ allocation --

/**
	A copy of `text` in storage from `allocator`. Failure follows the allocator's
	failure policy, like every other implicitly allocating operation.
*/
copy :: proc(text: string_view, allocator: Allocator = mem.default_allocator()) -> string {
	switch (allocate_string(text, allocator)) {
	case .ok(copied): return copied;
	case .err(error): allocation_failed(error, allocator);
	}
}

/// The fallible half: the error, with nothing allocated.
try_copy :: proc(
	text: string_view, allocator: Allocator = mem.default_allocator(),
) -> Result(string, Allocator_Error) {
	return allocate_string(text, allocator);
}

// --------------------------------------------------------------- queries --

// All of these are byte offsets, and all of them are non-allocating.
//
// The empty needle matches at offset zero, `last_index` answers `text.len()`,
// and `count` answers `text.len() + 1` — one match before every byte and one
// after the last.

contains :: proc(text: string_view, needle: string_view) -> bool {
	return index(text, needle) != .none;
}

starts_with :: proc(text: string_view, prefix: string_view) -> bool {
	if (prefix.len() > text.len()) { return false; }
	return matches_at(text.bytes(), 0, prefix.bytes());
}

ends_with :: proc(text: string_view, suffix: string_view) -> bool {
	if (suffix.len() > text.len()) { return false; }
	return matches_at(text.bytes(), text.len() - suffix.len(), suffix.bytes());
}

// Searching compares **bytes**, never subranges: slicing a view at an offset
// that splits a code point is a runtime failure, and a candidate offset is not
// known to be a boundary until it matches. A match always is one, because UTF-8
// is self-synchronising — no valid sequence begins with a continuation byte.
@(private)
matches_at :: proc(text: []u8, offset: int, needle: []u8) -> bool {
	foreach (value, index in needle.indexed()) {
		if (text[offset + index] != value) { return false; }
	}
	return true;
}

/// The byte offset of the first occurrence of `needle` in `text`, if any.
// ponytail: a naive O(text.len() * needle.len()) scan. Every first-release caller
// searches short needles in short lines; a two-way or Boyer-Moore search goes
// here when a measurement asks for one, behind this same signature. A one-byte
// needle goes to `memchr` instead. A needle longer than the text leaves `last`
// negative, so the loop never runs.
index :: proc(text: string_view, needle: string_view) -> Option(int) {
	if (needle.len() == 0) { return 0; }
	if (needle.len() == 1) { return index_byte(text, needle.bytes()[0]); }
	haystack, wanted := text.bytes(), needle.bytes();
	last := text.len() - needle.len();
	for (offset := 0; offset <= last; offset += 1) {
		if (matches_at(haystack, offset, wanted)) {
			return offset;
		}
	}
	return .none;
}

last_index :: proc(text: string_view, needle: string_view) -> Option(int) {
	if (needle.len() == 0) { return text.len(); }
	haystack, wanted := text.bytes(), needle.bytes();
	for (offset := text.len() - needle.len(); offset >= 0; offset -= 1) {
		if (matches_at(haystack, offset, wanted)) {
			return offset;
		}
	}
	return .none;
}

// The C runtime's `memchr` and `memcpy` work a word or vector at a time; a Loke
// loop handles one byte per iteration. That runtime is part of every link, as
// the `exit` binding in `core:os` relies on, so no `foreign import` names it.
@(private)
foreign loke_runtime {
	@(link_name="memchr")
	rt_memchr :: proc "c" (data: [^]u8, value: i32, count: uint) -> [^]u8 ---;
	@(link_name="memcpy")
	rt_memcpy :: proc "c" (target: [^]u8, source: [^]u8, count: uint) -> [^]u8 ---;
}

index_byte :: proc(text: string_view, value: u8) -> Option(int) {
	// C requires an address even for zero bytes, which an empty view need not have.
	if (text.len() == 0) { return .none; }
	start := unsafe.raw_data(text.bytes());
	found := rt_memchr(start, i32(value), uint(text.len()));
	if (found == nil) { return .none; }
	return int(unsafe.transmute(uintptr, found) - unsafe.transmute(uintptr, start));
}

/**
	The byte offset where the scalar value begins. A rune never matches a
	continuation byte of another one.
*/
// The loop only visits boundaries. An ASCII byte never occurs inside a multibyte
// code point, so an ASCII rune is a byte search.
index_rune :: proc(text: string_view, value: rune) -> Option(int) {
	if (value >= 0 && value < 0x80) { return index_byte(text, u8(value)); }
	foreach (codepoint, offset in text.rune_offsets()) {
		if (codepoint == value) { return offset; }
	}
	return .none;
}

/// Non-overlapping occurrences, left to right.
count :: proc(text: string_view, needle: string_view) -> int {
	if (needle.len() == 0) { return text.len() + 1; }
	total := 0;
	rest := text;
	for (rest.len() >= needle.len()) {
		at := index(rest, needle) or_else break;
		total += 1;
		rest = rest[at + needle.len():];
	}
	return total;
}

// ------------------------------------------------------------- trimming --

/// Whether `value` is Unicode White_Space, not only one of the ASCII five.
// design.md's rule for this package.
is_space :: proc(value: rune) -> bool {
	if (value == 0x20 || (value >= 0x09 && value <= 0x0D)) { return true; }
	if (value < 0x85) { return false; }
	if (value == 0x85 || value == 0xA0 || value == 0x1680) { return true; }
	if (value >= 0x2000 && value <= 0x200A) { return true; }
	if (value == 0x2028 || value == 0x2029 || value == 0x202F) { return true; }
	return value == 0x205F || value == 0x3000;
}

trim_left_space :: proc(text: string_view) -> string_view {
	foreach (codepoint, offset in text.rune_offsets()) {
		if (!is_space(codepoint)) { return text[offset:]; }
	}
	return text[text.len():];
}

/// `text` without the white space at its end.
// There is no reverse rune iteration, so each step backs up to the boundary
// before `end` and decodes the one rune between them. The scan stops at the
// first non-space, so it reads only the suffix it trims.
trim_right_space :: proc(text: string_view) -> string_view {
	end := text.len();
	for (end > 0) {
		start := floor_boundary(text, end - 1);
		last: rune = 0;
		foreach (codepoint in text[start:end]) { last = codepoint; }
		if (!is_space(last)) { break; }
		end = start;
	}
	return text[0:end];
}

trim_space :: proc(text: string_view) -> string_view {
	return trim_left_space(trim_right_space(text));
}

/// Trims any scalar value that appears in `cutset` from both ends.
trim :: proc(text: string_view, cutset: string_view) -> string_view {
	if (cutset.len() == 0) { return text; }
	start := text.len();
	end := 0;
	foreach (codepoint, offset in text.rune_offsets()) {
		if (index_rune(cutset, codepoint) == .none) {
			if (offset < start) { start = offset; }
			end = offset + rune_size(codepoint);
		}
	}
	if (start >= end) { return text[text.len():]; }
	return text[start:end];
}

// The UTF-8 length of one scalar value, which is what a byte offset must
// advance by to reach the next boundary.
@(private)
rune_size :: proc(value: rune) -> int {
	if (value < 0x80) { return 1; }
	if (value < 0x800) { return 2; }
	if (value < 0x10000) { return 3; }
	return 4;
}

// ------------------------------------------------------------- splitting --

/**
	The two halves around the first occurrence of `separator`, or `.none` when it
	does not occur.
*/
Cut :: struct { before: string_view, after: string_view }

cut :: proc(text: string_view, separator: string_view) -> Option(Cut) {
	at := index(text, separator) or_return;
	return Cut{text[0:at], text[at + separator.len():]};
}

// ------------------------------------------------------------ boundaries --

// A slice bound must fall where a code point begins or at the end (design.md
// "String views"); `text[low:high]` panics otherwise, as an out-of-range index
// does. An offset from `index`, `cut`, or `rune_offsets()` always qualifies.
// These are for one that may not: read from input, or computed by arithmetic.

/**
	`text[low:high]`, or `.none` where that slice would panic: a bound out of
	range, `low` after `high`, or a bound inside a code point.
*/
try_slice :: proc(text: string_view, low, high: int) -> Option(string_view) {
	if (low < 0 || low > high || high > text.len()) { return .none; }
	if (!is_boundary(text, low) || !is_boundary(text, high)) { return .none; }
	return text[low:high];
}

/**
	The nearest boundary at or before `offset`, so `text[:floor_boundary(text, n)]`
	is the longest prefix of at most `n` bytes. Past the end, the end; a negative
	offset panics, as an index does.
*/
floor_boundary :: proc(text: string_view, offset: int) -> int {
	if (offset >= text.len()) { return text.len(); }
	at := offset;
	for (!is_boundary(text, at)) { at -= 1; }
	return at;
}

/**
	The nearest boundary at or after `offset`. Past the end, the end; a negative
	offset panics, as an index does.
*/
ceil_boundary :: proc(text: string_view, offset: int) -> int {
	if (offset >= text.len()) { return text.len(); }
	at := offset;
	for (!is_boundary(text, at)) { at += 1; }
	return at;
}

/// The first `limit` scalar values, or all of `text` when it has fewer.
prefix_runes :: proc(text: string_view, limit: int) -> string_view {
	assert(limit >= 0, "strings.prefix_runes needs a non-negative limit");
	seen := 0;
	foreach (_, offset in text.rune_offsets()) {
		if (seen == limit) { return text[0:offset]; }
		seen += 1;
	}
	return text;
}

// Valid UTF-8 continues a code point only with a `10xxxxxx` byte, so every
// other byte begins one.
@(private)
is_boundary :: proc(text: string_view, offset: int) -> bool {
	return offset == text.len() || (text.bytes()[offset] & 0xC0) != 0x80;
}

// ------------------------------------------------- allocating transforms --

// Every one of these builds its result in a `String_Builder` and finishes it
// with the supplied allocator, so one growing buffer becomes one string.
//
// They follow the allocator's failure policy. There is no `try_` twin: a caller
// that must survive allocation failure builds the same result in a builder,
// where `try_append` and `try_finish` report instead of panicking.

join :: proc(
	parts: []string_view,
	separator: string_view = "",
	allocator: Allocator = mem.default_allocator(),
) -> string {
	builder := init(allocator);
	foreach (part, index in parts.indexed()) {
		if (index > 0) { builder.append(separator); }
		builder.append(part);
	}
	return builder.finish();
}

repeat :: proc(
	text: string_view, times: int, allocator: Allocator = mem.default_allocator(),
) -> string {
	if (times < 0) { panic("repeat count is negative"); }
	// A result longer than the largest `int` is reserved as that, so it fails up
	// front as an allocation rather than as an overflowing multiplication.
	too_long := text.len() > 0 && times > LARGEST_LENGTH / text.len();
	total := LARGEST_LENGTH if too_long else text.len() * times;
	builder := init(allocator);
	builder.reserve(total);
	// Empty text must not cost a loop however large the count.
	if (total == 0) { return builder.finish(); }
	builder.append(text);
	// Each pass copies the written prefix after itself, so the number of copies
	// grows with the logarithm of `times`. A copy is never longer than the
	// prefix it reads, so the two never overlap.
	builder.data.resize(total);
	start := unsafe.raw_data(builder.data);
	for (written := text.len(); written < total;) {
		left := total - written;
		length := written if written < left else left;
		rt_memcpy(start[written:], start, uint(length));
		written += length;
	}
	return builder.finish();
}

/**
	Replaces up to `limit` non-overlapping occurrences, or every one when `limit`
	is negative. An empty `old` matches nowhere, which keeps the result finite.
*/
replace :: proc(
	text: string_view,
	old: string_view,
	new: string_view,
	limit: int = -1,
	allocator: Allocator = mem.default_allocator(),
) -> string {
	builder := init(allocator);
	rest := text;
	done := 0;
	for (old.len() > 0 && (limit < 0 || done < limit)) {
		at := index(rest, old) or_else break;
		builder.append(rest[0:at]);
		builder.append(new);
		rest = rest[at + old.len():];
		done += 1;
	}
	builder.append(rest);
	return builder.finish();
}

/**
	`text` in upper case. Only ASCII letters change: every non-ASCII scalar value
	is copied as it stands.
*/
// ponytail: ASCII case only. Full Unicode case conversion needs the mapping
// tables of a `core:unicode` package, and guessing a subset of them would be
// worse than passing the rest through unchanged. The signature already returns
// owned storage, so the tables can arrive without changing a caller.
to_upper :: proc(text: string_view, allocator: Allocator = mem.default_allocator()) -> string {
	return flip_ascii_case(text, u8('a'), allocator);
}

to_lower :: proc(text: string_view, allocator: Allocator = mem.default_allocator()) -> string {
	return flip_ascii_case(text, u8('A'), allocator);
}

// Copies `text` and flips the case of the ASCII letters from `first` through the
// 26th after it, in the byte buffer. Every byte of a multibyte code point is
// above ASCII, so the result stays valid UTF-8.
@(private)
flip_ascii_case :: proc(text: string_view, first: u8, allocator: Allocator) -> string {
	builder := init(allocator);
	builder.reserve(text.len());
	builder.append(text);
	foreach (&mut value in builder.data[mut :]) {
		if (value >= first && value - first < 26) { value ~= 0x20; }
	}
	return builder.finish();
}
