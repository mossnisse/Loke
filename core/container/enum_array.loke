// `Enum_Array(Enum, T)`: one `T` per declared member (design.md's catalogue row
// for enum iteration, and "Iterating an enumeration").
//
// Indexed by the member, not by a number: `counts[.North] += 1`. A member's slot
// is its declaration position, so an enum with holes costs one slot per member
// rather than one per representable value.
//
// The zero value holds every member's zero value, so no construction is needed
// when `T` has one. A `T` without a zero value is held too: `filled` builds
// every slot from the value it is given.
@(public)
package container;

import "core:fmt";
import "core:unsafe";

Enum_Array :: struct($E: type, $T: type) {
	@(private) slots: [E.values().len()]T,
}

impl Enum_Array($E, $T) {
	// Every slot set to `value`, which copies it once per member and so is not
	// part of a move-only instantiation (design.md "where clauses").
	//
	// Starting from the zero value would demand one `T` has no use for, so the
	// slots are built in a `Small_Array`, whose storage is capacity rather than
	// values (design.md "Uninitialized capacity"). A copy that panics partway
	// leaves it holding what was built, which its drop releases. Once full, its
	// count goes to zero so that drop releases nothing, and the whole array is
	// taken out of it.
	filled :: proc(value: T) -> Enum_Array(E, T) where is_copyable(T) {
		// No members is no slots, whose zero value exists whatever `T` is, and a
		// `Small_Array` cannot have a capacity of zero.
		when (E.values().len() == 0) {
			return {};
		} else {
			building: Small_Array(T, E.values().len()) = {};
			for (!building.is_full()) { building.append(value); }
			building.count = 0;
			return {unsafe.take(building.items)};
		}
	}

	// The number of declared members, which is also the number of slots: an
	// `Enum_Array` is never partly present.
	len :: proc(self) -> int { return E.values().len(); }
	cap :: proc(self) -> int { return E.values().len(); }

	// Reading a slot out by value is a copy; `get_mut` reaches it without one.
	get :: operator([]) proc(self, member: E) -> T where is_copyable(T) {
		return self.slots[position_of(member)];
	}

	get_mut :: operator([]) proc(self: inout, member: E) -> inout T {
		return inout self.slots[position_of(member)];
	}

	// A slot lent where it is stored, so an immutable array reaches an element
	// `get` cannot copy: `slots.at(.First).id`. A `self: ^` receiver is the
	// caller's value (design.md "Receiver forms"), as for `Small_Array.view`.
	at :: proc(self: ^, member: E) -> ^T {
		return &self.slots[position_of(member)];
	}

	// -------------------------------------------------------- iteration --

	// Iteration yields `{key, value}` entries, the shape design.md gives a map's
	// `Element` — an enum-keyed container is a keyed container, so a bare value
	// would lose the half a caller usually wants.
	Element  :: Enum_Entry(E, T);

	// The iterator borrows the slots rather than carrying a copy of the whole
	// array: a `self: ^` receiver designates the caller's value (design.md
	// "Receiver forms"), so a view of its inline storage is derived from the
	// caller's root.
	iter :: proc(self: ^) -> Enum_Array_Iterator(E, T) { return {self.slots[:], 0}; }

	iter_mut :: proc(self: inout) -> Enum_Array_Mut_Iterator(E, T) { return {self.slots[:], 0}; }

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, "{");
		foreach (member, index in E.values().indexed()) {
			// One argument per call: `format_to` puts a space between arguments,
			// which is right for `println` and wrong inside a literal layout.
			if (index > 0) { fmt.format_to(writer, ", "); }
			fmt.format_to(writer, member);
			fmt.format_to(writer, " = ");
			fmt.format_to(writer, self.slots[index]);
		}
		fmt.format_to(writer, "}");
	}
}

Enum_Entry :: struct($E: type, $T: type) {
	key:   E,
	value: T,
}

// A borrow of the array's slots plus the traversal position. The array cannot
// be mutated, moved, or dropped while this is live, which is the ordinary borrow
// rule rather than anything this type arranges.
Enum_Array_Iterator :: struct($E: type, $T: type) {
	@(private) slots: []T,
	@(private) at:    int,
}

impl Enum_Array_Iterator($E, $T) {
	Element  :: Enum_Entry(E, T);
	// design.md "Borrowing iteration": the key is an enum member, a value made
	// per step; the value is lent where the array stores it.
	Yield    :: (key: Yield_Owned, value: Yield_Borrowed);

	iter :: proc(self) -> Enum_Array_Iterator(E, T) { return self; }

	next :: proc(self: inout) -> Option((key: E, value: ^T)) {
		members := E.values();
		if (self.at >= members.len()) { return .none; }
		index := self.at;
		self.at += 1;
		return .some({members[index], &self.slots[index]});
	}
}

// `foreach (key, &value in array)`: the key is still made per step, and the
// value is lent mutably until the next step.
Enum_Array_Mut_Iterator :: struct($E: type, $T: type) {
	@(private) slots: []mut T,
	@(private) at:    int,
}

impl Enum_Array_Mut_Iterator($E, $T) {
	Yield :: (key: Yield_Owned, value: Yield_Mutable);

	next :: proc(self: inout) -> Option((key: E, value: ^mut T)) {
		members := E.values();
		if (self.at >= members.len()) { return .none; }
		index := self.at;
		self.at += 1;
		return .some({members[index], &mut self.slots[index]});
	}
}
