/**
	`Small_Array(T, N)`: a growable sequence with inline fixed capacity.

	Its backing storage never allocates. Operations that would exceed `N` panic;
	their `try_` forms report `Capacity_Error` and leave the value completely
	unchanged on capacity failure — the library-wide `try_` contract, applied to
	a capacity limit. Element copying follows the ordinary copy rules.

	The zero value is a usable, empty array, so `x: Small_Array(int, 8) = {};`
	needs no construction.

	A move-only element is held too. The members that copy one — `get` and the
	`_copied` insertions — are not members of such an instance. `append`,
	`insert`, and their `try_` forms also take an element by `move`, so
	`values.append(move(token))` is the way in, just as it is for a dynamic
	array, and everything that reaches an element without copying it is
	unchanged.
*/
// standard-library.md "Fixed-capacity arrays". The copying members are bound on
// `is_copyable(T)` (design.md "where clauses"), and the insertions are
// procedure groups whose other member consumes.
@(public)
package container;

import "base:interfaces";
import "core:fmt";
import "core:unsafe";

/// What a `try_` operation reports when the array is full.
// standard-library.md writes `try_append` as `Status(Capacity_Error)`, so this is
// the payload inside that result union, not a second fallible shape. Nothing
// about it is compiler-known: it is an ordinary record with ordinary queries.
Capacity_Error :: struct {
	@(private) requested: int,
	@(private) capacity:  int,
}

impl Capacity_Error {
	/// How many elements the operation would have needed room for.
	requested_of :: proc(self) -> int { return self.requested; }
	/// The fixed `N` it could not exceed.
	capacity_of :: proc(self) -> int { return self.capacity; }

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		// One argument per call, spacing written out: `format_to` puts a space
		// between its own arguments, which is right for `println` and wrong inside
		// a sentence.
		fmt.format_to(writer, self.requested);
		fmt.format_to(writer, " elements exceed capacity ");
		fmt.format_to(writer, self.capacity);
	}
}

/// `N` is at least 1.
// `N > 0` because a zero-capacity growable array can only panic, and a caller
// who wants no storage wants no container.
Small_Array :: struct($T: type, $N: int) where N > 0 {
	// design.md "Uninitialized capacity": the storage holds a value in slots
	// `0 ..< count` and nothing behind them, so the element type needs no zero
	// value -- an empty `Small_Array(T, N)` is as free of `T` as an empty
	// `[dynamic]T` is. The storage has no copy, drop, or `==` of its own; the
	// hooks below visit the elements.
	//
	// Every update writes and then lengthens, or shortens and then takes, so
	// `count` is accurate wherever a panic can unwind from.
	@(private) items: Uninit([N]T),
	@(private) count: int,
}

impl Small_Array($T, $N) {
	// ------------------------------------------------------------ sequence --

	Element  :: T;

	/// The number of elements.
	// The queries borrow: a plain `self` of trivial elements is passed by value
	// (design.md "Parameter semantics and ABI lowering"), which here would copy
	// all `N` slots to read one count.
	len :: proc(self: ^) -> int { return self.count; }
	cap :: proc(self: ^) -> int { return N; }
	is_empty :: proc(self: ^) -> bool { return self.count == 0; }
	is_full :: proc(self: ^) -> bool { return self.count == N; }
	space :: proc(self: ^) -> int { return N - self.count; }

	/**
		Reading an element out by value is a written `clone`, because it may
		allocate, so a move-only instance has no `get`. `get_mut`, `view` and
		`slice` reach the element without a copy, and `remove` hands it over
		entirely.
	*/
	// design.md "where clauses".
	get :: operator([]) proc(self: ^, index: int) -> T where is_copyable(T) {
		self.check_index(index);
		return self.view()[index].clone();
	}

	get_mut :: operator([]) proc(self: inout, index: int) -> inout T {
		self.check_index(index);
		return inout unsafe.storage(&mut self.items)[index];
	}

	/**
		`x[a:b]` over the live elements only, not the `N - count` trailing slots of
		capacity. It reads on any array, not only a mutable one.
	*/
	// This is why it is not the built-in fixed array's own slicing.
	span :: operator([:]) proc(self: ^, low: int, high: int) -> []T {
		self.check_span(low, high);
		return self.view()[low:high];
	}

	/// The writable subrange, which `x[mut a:b]` selects.
	// design.md "Indexing and slicing".
	span_mut :: operator([:]) proc(self: inout, low: int, high: int) -> []mut T {
		self.check_span(low, high);
		return self.slice()[mut low:high];
	}

	/// The whole live prefix as one mutable view.
	slice :: proc(self: inout) -> []mut T {
		return unsafe.storage(&mut self.items)^[mut 0:self.count];
	}

	// ----------------------------------------------------------- iteration --

	/**
		The whole live prefix as one read-only view: the immutable counterpart of
		`slice`.
	*/
	// A `self: ^` receiver is the caller's value (design.md "Receiver forms"), so
	// a view of its inline storage is derived from the caller's root and needs no
	// `inout`.
	view :: proc(self: ^) -> []T {
		return unsafe.storage(&self.items)^[0:self.count];
	}

	/**
		The iterator borrows the live prefix. It allocates nothing, copies no
		element, and its size does not depend on `N`.
	*/
	iter :: proc(self: ^) -> Small_Array_Iterator(T) {
		return {self.view(), 0, false};
	}

	iter_reverse :: proc(self: ^) -> Small_Array_Iterator(T) {
		return {self.view(), 0, true};
	}

	iter_mut :: proc(self: inout) -> Small_Array_Mut_Iterator(T) {
		return {self.slice(), 0};
	}

	// ------------------------------------------------------------ mutation --

	append_copied :: proc(
		self: inout, @(escape=stored) values: ..T,
	) where is_copyable(T) {
		switch (self.try_append(..values)) {
		case .ok:
		case .err: panic("Small_Array is full");
		}
	}

	// A single borrowed element copies once, straight into its slot. Through
	// `append_copied` it would be copied into the variadic pack first and then
	// again out of it.
	@(private)
	append_one_copied :: proc(
		self: inout, @(escape=stored) value: T,
	) where is_copyable(T) {
		index := self.count;
		self.insert_copied(index, value);
	}

	/// Nothing is written unless everything fits, which is the `try_` promise.
	try_append_copied :: proc(
		self: inout, @(escape=stored) values: ..T,
	) -> Status(Capacity_Error) where is_copyable(T) {
		wanted := self.count + values.len();
		if (wanted > N) {
			return .err(Capacity_Error{wanted, N});
		}
		foreach (value in values) { self.put(value.clone()); }
		return .ok;
	}

	insert_copied :: proc(
		self: inout, index: int, @(escape=stored) value: T,
	) where is_copyable(T) {
		switch (self.try_insert(index, value)) {
		case .ok:
		case .err: panic("Small_Array is full");
		}
	}

	/**
		Like `try_append_copied`, at `index`. Capacity failure leaves the array
		untouched; a bad index panics even when the array is full.
	*/
	// The index is validated even when full: a bad index is always a programmer
	// error.
	try_insert_copied :: proc(
		self: inout, index: int, @(escape=stored) value: T,
	) -> Status(Capacity_Error) where is_copyable(T) {
		if (index < 0 || index > self.count) {
			panic("Small_Array index is out of range");
		}
		if (self.count == N) { return .err(Capacity_Error{N + 1, N}); }
		self.put(value.clone());
		self.move_last_to(index);
		return .ok;
	}

	/**
		The consuming half of the insertion groups below: it takes its element with
		`move`, and an argument that owns its value — a temporary or `move(...)` —
		selects it. A failed `try_` form drops the value it took, as built-in
		insertion does.
	*/
	// The copying members read out of a borrowed argument, which a move-only
	// element cannot do (design.md "Operator lookup and overload resolution",
	// tie-breaker 1; design.md "Container insertion").
	try_append_moved :: proc(
		self: inout, @(escape=stored) value: move T,
	) -> Status(Capacity_Error) {
		if (self.count == N) { return .err(Capacity_Error{N + 1, N}); }
		self.put(move(value));
		return .ok;
	}

	try_insert_moved :: proc(
		self: inout, index: int, @(escape=stored) value: move T,
	) -> Status(Capacity_Error) {
		if (index < 0 || index > self.count) {
			panic("Small_Array index is out of range");
		}
		if (self.count == N) { return .err(Capacity_Error{N + 1, N}); }
		self.put(move(value));
		self.move_last_to(index);
		return .ok;
	}

	append_moved :: proc(self: inout, @(escape=stored) value: move T) {
		index := self.count;
		self.insert_moved(index, move(value));
	}

	insert_moved :: proc(
		self: inout, index: int, @(escape=stored) value: move T,
	) {
		if (index < 0 || index > self.count) {
			panic("Small_Array index is out of range");
		}
		if (self.count == N) { panic("Small_Array is full"); }
		self.put(move(value));
		self.move_last_to(index);
	}

	/**
		One name per operation, exactly as built-in insertion has one: a borrowed
		place copies, a temporary or `move(...)` transfers. The call site therefore
		reads the same here as on `[dynamic]T`.
	*/
	append :: proc{append_one_copied, append_copied, append_moved};
	insert :: proc{insert_copied, insert_moved};
	try_append :: proc{try_append_copied, try_append_moved};
	try_insert :: proc{try_insert_copied, try_insert_moved};

	/// The last element, removed, or .none when empty, like a dynamic array.
	// Every retirement below shortens around the element it takes, so the slot it
	// leaves behind is capacity again: no element is ever reachable from two
	// indices at once, and none is left where the drop of `self` would release it
	// a second time.
	pop :: proc(self: inout) -> Option(T) {
		if (self.count == 0) { return .none; }
		self.count -= 1;
		return unsafe.take(unsafe.storage(&mut self.items)[self.count]);
	}

	/// Order-preserving: each following element moves down into the vacant slot.
	remove :: proc(self: inout, index: int) -> T {
		self.check_index(index);
		slots := unsafe.storage(&mut self.items);
		removed := unsafe.take(slots[index]);
		at := index;
		for (at + 1 < self.count) {
			unsafe.write(slots[at], unsafe.take(slots[at + 1]));
			at += 1;
		}
		self.count -= 1;
		return removed;
	}

	/// O(1), at the cost of the order: the last element takes the hole.
	remove_unordered :: proc(self: inout, index: int) -> T {
		self.check_index(index);
		slots := unsafe.storage(&mut self.items);
		removed := unsafe.take(slots[index]);
		self.count -= 1;
		if (index != self.count) {
			unsafe.write(slots[index], unsafe.take(slots[self.count]));
		}
		return removed;
	}

	/**
		Sets the length to zero, dropping each element, last to first. If a drop
		panics, the remaining elements still drop in the same order.
	*/
	// A hook that panics is not invoked again, and the storage has no cleanup of
	// its own, so the deferred drain is what releases the rest under unwind.
	// After a normal drain it has nothing left to do. A second panic aborts:
	// design.md "Panic during unwinding".
	clear :: proc(self: inout) {
		defer self.drain();
		self.drain();
	}

	// ------------------------------------------------------- whole values --

	/// Equal lengths and equal elements, in order.
	equal :: operator(==) proc(left, right: Small_Array(T, N)) -> bool where interfaces.Equatable(T) {
		if (left.count != right.count) { return false; }
		foreach (i in 0 ..< left.count) {
			if (left.view()[i] != right.view()[i]) { return false; }
		}
		return true;
	}

	/// Prints as an array, in order.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, "[");
		foreach (i in 0 ..< self.count) {
			if (i > 0) { fmt.format_to(writer, ", "); }
			fmt.format_to(writer, self.view()[i]);
		}
		fmt.format_to(writer, "]");
	}

	release :: hook(drop) proc(self: inout) { self.clear(); }

	// Clones in order. What it has cloned so far is dropped with `out` if a later
	// element fails.
	duplicate :: hook(copy) proc(self, allocator: Allocator) -> Result(Small_Array(T, N), Allocator_Error) where is_copyable(T) {
		out: Small_Array(T, N) = {};
		foreach (item in self.view()) {
			copied := item.try_clone(allocator) or_return;
			out.put(move(copied));
		}
		return .ok(move(out));
	}

	// ---------------------------------------------------------------- guts --

	@(private)
	check_index :: proc(self: ^, index: int) {
		if (index < 0 || index >= self.count) {
			panic("Small_Array index is out of range");
		}
	}

	// Writes `value` behind the last element, which the caller has checked there
	// is room for, and then lengthens.
	@(private)
	put :: proc(self: inout, @(escape=stored) value: move T) {
		unsafe.write(unsafe.storage(&mut self.items)[self.count], move(value));
		self.count += 1;
	}

	// The count is accurate before each user drop hook runs.
	@(private)
	drain :: proc(self: inout) {
		for (self.count > 0) { _ = self.pop(); }
	}

	// The appended last element moves down to `index`. Every slot is live before
	// the first swap, so the operation never reads raw capacity as a value.
	@(private)
	move_last_to :: proc(self: inout, index: int) {
		at := self.count - 1;
		for (at > index) {
			self.slice().swap(at, at - 1);
			at -= 1;
		}
	}

	@(private)
	check_span :: proc(self: ^, low: int, high: int) {
		if (low < 0 || high < low || high > self.count) {
			panic("Small_Array slice is out of range");
		}
	}
}

/**
	A borrow of a small array's live prefix plus the traversal state. The array
	it came from cannot be mutated, moved, or dropped while this is live. One
	iterator serves both directions.
*/
Small_Array_Iterator :: Slice_Iterator($T);

/**
	A borrow of a container's elements, held as one slice, plus the traversal
	state. The container cannot change while this is live. One iterator serves
	both directions. `Small_Array_Iterator` and `Priority_Queue_Iterator` name it.
*/
// That is the ordinary borrow rule rather than anything this type arranges.
// design.md "Iteration protocol": both directions differ only in which end
// `at` counts from.
Slice_Iterator :: struct($T: type) {
	@(private) items:   []T,
	@(private) at:      int,
	@(private) reverse: bool,
}

impl Slice_Iterator($T) {
	Element  :: T;
	// design.md "Borrowing iteration": each element is lent where the array
	// stores it, so traversal copies nothing and a move-only `T` is read too.

	iter :: proc(self) -> Slice_Iterator(T) { return self; }

	next :: proc(self: inout) -> Option(^T) {
		if (self.at >= self.items.len()) { return .none; }
		index := self.items.len() - 1 - self.at if self.reverse else self.at;
		self.at += 1;
		return &self.items[index];
	}
}

/**
	A mutable traversal borrows the same inline prefix. Each pointer returned by
	next() is a loan of the iterator and must end before it is advanced again.
*/
Small_Array_Mut_Iterator :: struct($T: type) {
	@(private) items: []mut T,
	@(private) at: int,
}

impl Small_Array_Mut_Iterator($T) {
	next :: proc(self: inout) -> Option(^mut T) {
		if (self.at >= self.items.len()) { return .none; }
		index := self.at;
		self.at += 1;
		return &mut self.items[index];
	}
}
