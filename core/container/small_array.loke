// `Small_Array(T, N)`: a growable sequence with inline fixed capacity
// (design.md "Fixed-capacity arrays").
//
// Its backing storage never allocates. Operations that would exceed `N` panic;
// their `try_` forms report `Capacity_Error` and leave the value completely
// unchanged on capacity failure — the library-wide `try_` contract, applied to
// a capacity limit. Element copying follows the ordinary copy rules.
//
// The zero value is a usable, empty array, so `x: Small_Array(int, 8) = {};`
// needs no construction.
//
// A move-only element is held too. The methods that copy one — `get`,
// `append`, `insert`, their `try_` forms, and by-value iteration — are bound
// on `is_copyable(T)`, so they are simply not members of such an instance
// (design.md "where clauses"); `append_moved` and `insert_moved` are the way
// in, and everything that reaches an element without copying it is unchanged.
@(public)
package container;

import "core:fmt";

// design.md writes `try_append` as `Result(Unit, Capacity_Error)`, so this is
// the payload inside that result union, not a second fallible shape. Nothing
// about it is compiler-known: it is an ordinary record with ordinary queries.
Capacity_Error :: struct {
	@(private) requested: int,
	@(private) capacity:  int,
}

impl Capacity_Error {
	// How many elements the operation would have needed room for.
	requested_of :: proc(self) -> int { return self.requested; }
	// The fixed `N` it could not exceed.
	capacity_of :: proc(self) -> int { return self.capacity; }

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		// One argument per call, spacing written out: `format_to` puts a space
		// between its own arguments, which is right for `println` and wrong inside
		// a sentence.
		fmt.format_to(writer, "capacity ");
		fmt.format_to(writer, self.capacity);
		fmt.format_to(writer, " exceeded by ");
		fmt.format_to(writer, self.requested);
	}
}

// `N > 0` because a zero-capacity growable array can only panic, and a caller
// who wants no storage wants no container.
Small_Array :: struct($T: type, $N: int) where N > 0 {
	// Elements at `count ..< N` are the zero value, never live: `pop` and
	// `remove` overwrite what they retire so a managed element is not left
	// duplicated behind the length.
	@(private) items: [N]T,
	@(private) count: int,
}

impl Small_Array($T, $N) {
	// ------------------------------------------------------------ sequence --

	Element  :: T;
	Iterator :: Small_Array_Iterator(T);
	Mut_Iterator :: Small_Array_Mut_Iterator(T);

	len :: proc(self) -> int { return self.count; }
	cap :: proc(self) -> int { return N; }
	is_empty :: proc(self) -> bool { return self.count == 0; }
	is_full :: proc(self) -> bool { return self.count == N; }
	space :: proc(self) -> int { return N - self.count; }

	// Reading an element out by value is a copy, so this is not part of a
	// move-only instantiation (design.md "where clauses"). `get_mut`, `view` and
	// `slice` reach the element without one, and `remove` hands it over entirely.
	get :: operator([]) proc(self, index: int) -> T where is_copyable(T) {
		self.check_index(index);
		return self.items[index];
	}

	get_mut :: operator([]) proc(self: inout, index: int) -> inout T {
		self.check_index(index);
		return inout self.items[index];
	}

	// `x[a:b]` over the live prefix only, which is why this is not the built-in
	// fixed array's own slicing: the `N - count` trailing zero values are not
	// elements.
	//
	// The receiver is immutable, so `x[a:b]` reads on any array rather than only
	// on a mutable one. A writable subrange is `slice()[a:b]`: built-in slicing of
	// the mutable whole-prefix view, already bounded by the live prefix.
	span :: operator([:]) proc(self, low: int, high: int) -> []T {
		self.check_span(low, high);
		return self.items[low:high];
	}

	// The whole live prefix as one mutable view.
	slice :: proc(self: inout) -> []mut T {
		return self.items[0:self.count];
	}

	// ----------------------------------------------------------- iteration --

	// The whole live prefix as one read-only view. The immutable counterpart of
	// `slice`: a `self` receiver is a borrow of the caller's value (design.md
	// "Receiver forms"), so a view of its inline storage is derived from the
	// caller's root and needs no `inout`.
	view :: proc(self) -> []T {
		return self.items[0:self.count];
	}

	// The iterator borrows the live prefix. It allocates nothing, copies no
	// element, and its size does not depend on `N`.
	iter :: proc(self) -> Small_Array_Iterator(T) {
		return {self.view(), 0, false};
	}

	iter_reverse :: proc(self) -> Small_Array_Iterator(T) {
		return {self.view(), 0, true};
	}

	iter_mut :: proc(self: inout) -> Small_Array_Mut_Iterator(T) {
		return {self.slice(), 0};
	}

	// ------------------------------------------------------------ mutation --

	append :: proc(
		self: inout, @(escape=stored) values: ..T,
	) where is_copyable(T) {
		switch (_ in self.try_append(..values)) {
		case .ok:
		case .err: panic("Small_Array is full");
		}
	}

	// Nothing is written unless everything fits, which is the `try_` promise.
	try_append :: proc(
		self: inout, @(escape=stored) values: ..T,
	) -> Result(Unit, Capacity_Error) where is_copyable(T) {
		wanted := self.count + values.len();
		if (wanted > N) {
			return .err(Capacity_Error{wanted, N});
		}
		foreach (value in values) {
			self.items[self.count] = value;
			self.count += 1;
		}
		return .ok({});
	}

	insert :: proc(
		self: inout, index: int, @(escape=stored) value: T,
	) where is_copyable(T) {
		switch (_ in self.try_insert(index, value)) {
		case .ok:
		case .err: panic("Small_Array is full");
		}
	}

	// Validate the index even when full. Capacity failure leaves the array
	// untouched; a bad index is always a programmer error.
	try_insert :: proc(
		self: inout, index: int, @(escape=stored) value: T,
	) -> Result(Unit, Capacity_Error) where is_copyable(T) {
		if (index < 0 || index > self.count) {
			panic("Small_Array index is out of range");
		}
		if (self.count == N) { return .err(Capacity_Error{N + 1, N}); }
		self.open_slot(index);
		self.items[index] = value;
		self.count += 1;
		return .ok({});
	}

	// The move-only way in. `append` and `insert` copy out of a borrowed
	// argument, which a move-only element cannot do, so these consume theirs
	// instead: `values.append_moved(move(token))`.
	//
	// Neither has a `try_` form. A capacity failure would arrive having already
	// taken the value it could not store, which is the opposite of what this
	// file's `try_` contract promises; a caller who must not panic asks `space()`
	// or `is_full()` first, and those are exact.
	append_moved :: proc(self: inout, @(escape=stored) value: move T) {
		if (self.count == N) { panic("Small_Array is full"); }
		self.items[self.count] = move(value);
		self.count += 1;
	}

	insert_moved :: proc(
		self: inout, index: int, @(escape=stored) value: move T,
	) {
		if (index < 0 || index > self.count) {
			panic("Small_Array index is out of range");
		}
		if (self.count == N) { panic("Small_Array is full"); }
		self.open_slot(index);
		self.items[index] = move(value);
		self.count += 1;
	}

	// The last element, removed, or .none when empty, like a dynamic array.
	//
	// Every retirement below is one `exchange`: it takes the element out and
	// leaves the zero value behind as a single operation, so no element is ever
	// reachable from two indices at once, and — where `T` is a borrow carrier —
	// the value taken out is not a borrow of `self` that the rest of the body
	// would then have to leave alone.
	pop :: proc(self: inout) -> Option(T) {
		if (self.count == 0) { return .none; }
		self.count -= 1;
		last := self.count;
		return .some(exchange(inout self.items[last], {}));
	}

	// Order-preserving: everything after `index` shifts down one place.
	remove :: proc(self: inout, index: int) -> T {
		self.check_index(index);
		removed := exchange(inout self.items[index], {});
		at := index;
		for (at + 1 < self.count) {
			_ = exchange(inout self.items[at], exchange(inout self.items[at + 1], {}));
			at += 1;
		}
		// The last shift — or the removal itself, when nothing shifted — already
		// left the zero value in the slot that falls behind the new length.
		self.count -= 1;
		return removed;
	}

	// O(1), at the cost of the order: the last element takes the hole.
	remove_unordered :: proc(self: inout, index: int) -> T {
		self.check_index(index);
		removed := exchange(inout self.items[index], {});
		self.count -= 1;
		last := self.count;
		if (index != last) {
			_ = exchange(inout self.items[index], exchange(inout self.items[last], {}));
		}
		return removed;
	}

	// Length only. The retired elements are overwritten so nothing stays live
	// behind the length.
	clear :: proc(self: inout) {
		foreach (i in 0 ..< self.count) { _ = exchange(inout self.items[i], {}); }
		self.count = 0;
	}

	// --------------------------------------------------------- diagnostics --

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, "[");
		foreach (i in 0 ..< self.count) {
			if (i > 0) { fmt.format_to(writer, ", "); }
			fmt.format_to(writer, self.items[i]);
		}
		fmt.format_to(writer, "]");
	}

	// ---------------------------------------------------------------- guts --

	@(private)
	check_index :: proc(self, index: int) {
		if (index < 0 || index >= self.count) {
			panic("Small_Array index is out of range");
		}
	}

	// Everything from `index` up moves one slot along, leaving `index` holding the
	// zero value for the caller to store into. A shift is a move, not a copy:
	// `exchange` leaves the zero behind, so no managed element is cloned and none
	// is briefly live at two indices. Each discarded result is the zero the
	// previous step left behind.
	//
	// It takes no bound: the moving insert needs the same shift as the copying
	// one, and shifting has never been the part that copies.
	@(private)
	open_slot :: proc(self: inout, index: int) {
		at := self.count;
		for (at > index) {
			_ = exchange(inout self.items[at], exchange(inout self.items[at - 1], {}));
			at -= 1;
		}
	}

	@(private)
	check_span :: proc(self, low: int, high: int) {
		if (low < 0 || high < low || high > self.count) {
			panic("Small_Array slice is out of range");
		}
	}
}

// design.md "Iteration protocol": one iterator serving both directions, because
// they differ only in which end `at` counts from.
// A borrow of the array's live prefix plus the traversal state. The array it
// came from cannot be mutated, moved, or dropped while this is live, which is
// the ordinary borrow rule rather than anything this type arranges.
Small_Array_Iterator :: struct($T: type) {
	@(private) items:   []T,
	@(private) at:      int,
	@(private) reverse: bool,
}

// A mutable traversal borrows the same inline prefix. Each pointer returned by
// next() is a loan of the iterator and must end before it is advanced again.
Small_Array_Mut_Iterator :: struct($T: type) {
	@(private) items: []mut T,
	@(private) at: int,
}

impl Small_Array_Mut_Iterator($T) {
	next :: proc(self: inout) -> Option(^mut T) {
		if (self.at >= self.items.len()) { return .none; }
		index := self.at;
		self.at += 1;
		return .some(&mut self.items[index]);
	}
}

impl Small_Array_Iterator($T) {
	Element  :: T;
	Iterator :: Small_Array_Iterator(T);

	iter :: proc(self) -> Small_Array_Iterator(T) { return self; }

	// Yielding an element by value is a copy, so a move-only `T` gets no `next`
	// here and therefore no by-value `foreach` — design.md "Element bindings"
	// sends such an element through `refs()` or `&value` instead, which is what
	// `view().refs()` and `iter_mut` already provide.
	next :: proc(self: inout) -> Option(T) where is_copyable(T) {
		if (self.at >= self.items.len()) { return .none; }
		index := self.items.len() - 1 - self.at if self.reverse else self.at;
		self.at += 1;
		return .some(self.items[index]);
	}
}
