/**
	`Bit_Set(Enum)`: a set of enum members held as bits.

	A member's bit is its *declaration position*, not its numeric value, so an
	enum with holes — `enum { A, B = 4, C = 7 }` — still needs exactly three
	bits. That is also why this is not a hardware register layout; use an
	integer mask with explicit accessors for one.

	The zero value is the empty set.
*/
// design.md's catalogue row for flag sets, and "Iterating an enumeration".
// design.md keeps hardware register layouts on integer masks.
@(public)
package container;

import "core:fmt";

Bit_Set :: struct($E: type) {
	// Member `i` is index `i` of an index set, which already holds any number of
	// bits inline and supplies the word-at-a-time operations below.
	@(private) bits: Index_Set(E.values().len()),
}

impl Bit_Set($E) {
	// ------------------------------------------------------- construction --

	/// Every listed member, and nothing else. `Bit_Set(Direction).of(.North, .West)`.
	of :: proc(members: ..E) -> Bit_Set(E) {
		result: Bit_Set(E) = {};
		foreach (member in members) { result.set(member); }
		return result;
	}

	/// Every declared member.
	all :: proc() -> Bit_Set(E) { return {Index_Set(E.values().len()).all()}; }

	// ----------------------------------------------------------- queries --

	contains :: proc(self, member: E) -> bool { return self.bits.contains(position_of(member)); }

	/// The number of members present, not the enum's size — `cap` is that.
	len :: proc(self) -> int { return self.bits.len(); }

	cap :: proc(self) -> int { return E.values().len(); }
	is_empty :: proc(self) -> bool { return self.bits.is_empty(); }

	// --------------------------------------------------------- mutation --

	set :: proc(self: inout, member: E) { self.bits.set(position_of(member)); }
	unset :: proc(self: inout, member: E) { self.bits.unset(position_of(member)); }
	toggle :: proc(self: inout, member: E) { self.bits.toggle(position_of(member)); }
	clear :: proc(self: inout) { self.bits.clear(); }

	// -------------------------------------------------------- operators --

	/**
		Union, intersection, difference, and symmetric difference, spelled with the
		integer operators: `|`, `&`, `&~` and `~`. `==` compares two sets.
	*/
	// Each is the index set's operator. `==` is not written here: the record's
	// generated field-wise equality is the index set's, which compares exactly
	// the members' bits.
	union_with :: operator(|) proc(left, right: Bit_Set(E)) -> Bit_Set(E) { return {left.bits | right.bits}; }
	intersect :: operator(&) proc(left, right: Bit_Set(E)) -> Bit_Set(E) { return {left.bits & right.bits}; }
	difference :: operator(&~) proc(left, right: Bit_Set(E)) -> Bit_Set(E) { return {left.bits &~ right.bits}; }
	symmetric_difference :: operator(~) proc(left, right: Bit_Set(E)) -> Bit_Set(E) { return {left.bits ~ right.bits}; }

	/// Every member `self` does not hold.
	complement :: operator(~) proc(self: Bit_Set(E)) -> Bit_Set(E) { return {~self.bits}; }

	is_subset_of :: proc(self, other: Bit_Set(E)) -> bool { return self.bits.is_subset_of(other.bits.view()); }

	// -------------------------------------------------------- iteration --

	Element  :: E;

	iter :: proc(self) -> Bit_Set_Iterator(E) { return {self.bits, -1, 0}; }

	// --------------------------------------------------------- printing --

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, "{");
		foreach (member, index in self.iter().indexed()) {
			if (index > 0) { fmt.format_to(writer, ", "); }
			fmt.format_to(writer, member);
		}
		fmt.format_to(writer, "}");
	}
}

/**
	Iterating a set yields the members it holds, in declaration order. The
	iterator holds a copy of the set, not a borrow of it.
*/
// A set is one `u64` per 64 members, so for every enum worth writing the copy
// is no larger than the slice header a borrow would need.
Bit_Set_Iterator :: struct($E: type) {
	@(private) held:    Index_Set(E.values().len()),
	@(private) at:      int,   // the word `pending` came from, as for `Index_Iterator`
	@(private) pending: u64,   // that word's members not yet yielded
}

impl Bit_Set_Iterator($E) {
	Element  :: E;

	iter :: proc(self) -> Bit_Set_Iterator(E) { return self; }

	next :: proc(self: inout) -> Option(E) {
		members :: E.values();
		switch (next_index(self.held.words[:], members.len(), inout self.at, inout self.pending)) {
		case .some(at): return members[at];
		case .none:     return .none;
		}
	}
}

// A member's declaration position. Linear in the number of members, which is
// what makes an enum with holes work at all; enums are small, and the search is
// over a compile-time constant array.
@(private)
position_of :: proc(member: $E) -> int {
	foreach (declared, index in E.values().indexed()) {
		if (declared == member) { return index; }
	}
	// design.md "Enumerations": safe enum values always name a variant. Keep a
	// defensive check for invalid representations supplied across unsafe boundaries.
	panic("invalid enum representation");
}
