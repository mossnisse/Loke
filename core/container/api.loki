*/
Index_View :: struct {
	// and fields private to the package
}

impl Index_View {
	/*
		The set of capacity `cap` in `words`, whose length must be
		`words_for_bits(cap)`. The bits of the final word at or above `cap` are
		ignored.
	*/
	over :: proc(words: []u64, cap: int) -> Index_View ---;

	cap :: proc(self) -> int ---;

	len :: proc(self) -> int ---;

	is_empty :: proc(self) -> bool ---;

	contains :: proc(self, index: int) -> bool ---;

	count_range :: proc(self, low, high: int) -> int ---;

	next_member :: proc(self, from: int) -> Option(int) ---;

	next_absent :: proc(self, from: int) -> Option(int) ---;

	is_subset_of :: proc(self, other: Index_View) -> bool ---;

	intersects :: proc(self, other: Index_View) -> bool ---;

	// Equal capacities and equal members; the bits past the capacity are not compared.
	equal :: operator(==) proc(left, right: Index_View) -> bool ---;

	// `index in set`: whether `index` is present, as `contains`.
	is_member :: operator(in) proc(index: int, set: Index_View) -> bool ---;

	store_bytes :: proc(self, out: []mut u8) ---;

	Element :: int;

	iter :: proc(self) -> Index_Iterator ---;

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) ---;
}

/*
	A mutable index set stored in the caller's words, laid out as
	`Index_View`. It borrows the words exclusively. A write never changes the
	bits of the final word at or above the capacity.
*/
Index_View_Mut :: struct {
	// and fields private to the package
}

impl Index_View_Mut {
	// As `Index_View.over`, writable.
	over :: proc(words: []mut u64, cap: int) -> Index_View_Mut ---;

	// The same set, read-only, borrowed from this view.
	as_view :: proc(self: ^) -> Index_View ---;

	cap :: proc(self: ^) -> int ---;

	len :: proc(self: ^) -> int ---;

	is_empty :: proc(self: ^) -> bool ---;

	contains :: proc(self: ^, index: int) -> bool ---;

	count_range :: proc(self: ^, low, high: int) -> int ---;

	next_member :: proc(self: ^, from: int) -> Option(int) ---;

	next_absent :: proc(self: ^, from: int) -> Option(int) ---;

	is_subset_of :: proc(self: ^, other: Index_View) -> bool ---;

	intersects :: proc(self: ^, other: Index_View) -> bool ---;

	set :: proc(self: inout, index: int) ---;

	unset :: proc(self: inout, index: int) ---;

	toggle :: proc(self: inout, index: int) ---;

	clear :: proc(self: inout) ---;

	fill :: proc(self: inout) ---;

	set_range :: proc(self: inout, low, high: int) ---;

	unset_range :: proc(self: inout, low, high: int) ---;

	toggle_range :: proc(self: inout, low, high: int) ---;

	insert_all :: proc(self: inout, other: Index_View) ---;

	retain_all :: proc(self: inout, other: Index_View) ---;

	remove_all :: proc(self: inout, other: Index_View) ---;

	toggle_all :: proc(self: inout, other: Index_View) ---;

	// `index in set`: whether `index` is present, as `contains`.
	is_member :: operator(in) proc(index: int, set: Index_View_Mut) -> bool ---;

	store_bytes :: proc(self: ^, out: []mut u8) ---;

	load_bytes :: proc(self: inout, bytes: []u8) -> bool ---;

	Element :: int;

	iter :: proc(self: ^) -> Index_Iterator ---;

	format :: proc(self: ^, writer: fmt.Writer, options: fmt.Options) ---;
}

/*
	Yields the indices a set holds, in increasing order, one trailing-zero
	count per index. It borrows the set's words.
*/
Index_Iterator :: struct {
	// and fields private to the package
}

impl Index_Iterator {
	Element :: int;

	iter :: proc(self) -> Index_Iterator ---;

	next :: proc(self: inout) -> Option(int) ---;
}

/*
	A queue of `T` in the order `C` defines. Use `Min_Queue` or `Max_Queue` for an
	element's own order.
*/
Priority_Queue :: struct($T, $C: type) where interfaces.Callable(C, proc(left, right: T) -> bool) {
	// and fields private to the package
}

// Smallest first, by the element's own `<`. The zero value is an empty queue.
Min_Queue :: Priority_Queue($T, slice.Ascending(T));

// Largest first, by the element's own `<`. The zero value is an empty queue.
Max_Queue :: Priority_Queue($T, slice.Descending(T));

/*
	`Priority_Queue(T, C).init` with `C` inferred, which spares naming the type of
	a capture literal: `priority_queue(int, move(less))`.
*/
priority_queue :: proc(
	$T: type, less: move $C, capacity: int = 0, allocator: Allocator = mem.default_allocator(),
) -> Priority_Queue(T, C) where interfaces.Callable(C, proc(left, right: T) -> bool) ---;

impl Priority_Queue($T, $C) {
	Element :: T;

	/*
		A queue with room for `capacity` elements, drawing on `allocator`. A negative
		`capacity` panics. A stateless comparator is spelled `{}`.
	*/
	init :: proc(
		less: move C, capacity: int = 0, allocator: Allocator = mem.default_allocator(),
	) -> Priority_Queue(T, C) ---;

	// As `init`, but a failure to allocate is returned rather than handled by the allocator's failure policy.
	try_init :: proc(
		less: move C, capacity: int = 0, allocator: Allocator = mem.default_allocator(),
	) -> Result(Priority_Queue(T, C), Allocator_Error) ---;

	// Takes over an array and its allocator and orders it, in O(n): much faster than pushing each element.
	from_items :: proc(items: move [dynamic]T, less: move C) -> Priority_Queue(T, C) ---;

	len :: proc(self: ^) -> int ---;

	cap :: proc(self: ^) -> int ---;

	is_empty :: proc(self: ^) -> bool ---;

	// The element `pop` would return, lent until the queue next changes.
	peek :: proc(self: ^) -> Option(^T) ---;

	// Every element, in unspecified order.
	view :: proc(self: ^) -> []T ---;

	// Reads every element, in unspecified order.
	iter :: proc(self: ^) -> Priority_Queue_Iterator(T) ---;

	push_copied :: proc(self: inout, @(escape=stored) value: T) where is_copyable(T) ---;

	push_moved :: proc(self: inout, @(escape=stored) value: move T) ---;

	try_push_copied :: proc(self: inout, @(escape=stored) value: T) -> Status(Allocator_Error) where is_copyable(T) ---;

	try_push_moved :: proc(self: inout, @(escape=stored) value: move T) -> Status(Allocator_Error) ---;

	/*
		Adds an element, in amortized O(log n). A borrowed place is copied, and a
		temporary or `move(x)` transfers.
	*/
	push :: proc{push_copied, push_moved};

	/*
		As `push`, but a failure to allocate is returned and leaves the queue unchanged.
		An element that was moved in is dropped then, so a caller who must keep it
		calls `try_reserve` first.
	*/
	try_push :: proc{try_push_copied, try_push_moved};

	// Removes and returns the first element, in O(log n). Never allocates.
	pop :: proc(self: inout) -> Option(T) ---;

	push_pop_copied :: proc(self: inout, @(escape=stored) value: T) -> T where is_copyable(T) ---;

	push_pop_moved :: proc(self: inout, @(escape=stored) value: move T) -> T ---;

	/*
		As `push` then `pop` with one sift, in O(log n). Never allocates, so it works
		on a full queue. Keeps the k largest with a `Min_Queue` of k elements.
	*/
	push_pop :: proc{push_pop_copied, push_pop_moved};

	/*
		Runs `change` on the first element and restores the order, in O(log n), or is
		false when the queue is empty. It is the only way to reach an element mutably,
		so the order cannot be left wrong.
	*/
	update_top :: proc(self: inout, change: $F) -> bool where interfaces.Callable(F, proc(top: inout T)) ---;

	// Drops each element for which `keep(item)` is false, then restores the order, in O(n).
	retain :: proc(self: inout, keep: $F) where interfaces.Callable(F, proc(item: T) -> bool) ---;

	reserve :: proc(self: inout, capacity: int) ---;

	// As `reserve`, but a failure to allocate is returned.
	try_reserve :: proc(self: inout, capacity: int) -> Status(Allocator_Error) ---;

	shrink :: proc(self: inout, minimum: int = 0) ---;

	// As `shrink`, but a failure to allocate is returned.
	try_shrink :: proc(self: inout, minimum: int = 0) -> Status(Allocator_Error) ---;

	// Drops every element and keeps the capacity.
	clear :: proc(self: inout) ---;

	// The elements in unspecified order, with their storage, in O(1).
	into_items :: proc(self: move) -> [dynamic]T ---;

	// The elements in `pop` order, in place, in O(n log n).
	into_sorted :: proc(self: move) -> [dynamic]T ---;

	// Prints as an array, in unspecified order.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) ---;
}

/*
	A borrow of the queue's elements. The queue cannot change while this is live.
	Elements are lent where the queue stores them, so a move-only `T` is read too.
*/
Priority_Queue_Iterator :: struct($T: type) {
	// and fields private to the package
}

impl Priority_Queue_Iterator($T) {
	Element :: T;

	iter :: proc(self) -> Priority_Queue_Iterator(T) ---;

	next :: proc(self: inout) -> Option(^T) ---;
}

// What a `try_` operation reports when the array is full.
Capacity_Error :: struct {
	// and fields private to the package
}

impl Capacity_Error {
	// How many elements the operation would have needed room for.
	requested_of :: proc(self) -> int ---;

	// The fixed `N` it could not exceed.
	capacity_of :: proc(self) -> int ---;

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) ---;
}

// `N` is at least 1.
Small_Array :: struct($T: type, $N: int) where N > 0 {
	// and fields private to the package
}

impl Small_Array($T, $N) {
	Element  :: T;

	// The number of elements.
	len :: proc(self: ^) -> int ---;

	cap :: proc(self: ^) -> int ---;

	is_empty :: proc(self: ^) -> bool ---;

	is_full :: proc(self: ^) -> bool ---;

	space :: proc(self: ^) -> int ---;

	/*
		Reading an element out by value is a written `clone`, because it may
		allocate, so a move-only instance has no `get`. `get_mut`, `view` and
		`slice` reach the element without a copy, and `remove` hands it over
		entirely.
	*/
	get :: operator([]) proc(self: ^, index: int) -> T where is_copyable(T) ---;

	get_mut :: operator([]) proc(self: inout, index: int) -> inout T ---;

	/*
		`x[a:b]` over the live elements only, not the `N - count` trailing slots of
		capacity. It reads on any array, not only a mutable one.
	*/
	span :: operator([:]) proc(self: ^, low: int, high: int) -> []T ---;

	// The writable subrange, which `&mut x[a:b]` selects.
	span_mut :: operator([:]) proc(self: inout, low: int, high: int) -> []mut T ---;

	// The whole live prefix as one mutable view.
	slice :: proc(self: inout) -> []mut T ---;

	/*
		The whole live prefix as one read-only view: the immutable counterpart of
		`slice`.
	*/
	view :: proc(self: ^) -> []T ---;

	/*
		The iterator borrows the live prefix. It allocates nothing, copies no
		element, and its size does not depend on `N`.
	*/
	iter :: proc(self: ^) -> Small_Array_Iterator(T) ---;

	iter_reverse :: proc(self: ^) -> Small_Array_Iterator(T) ---;

	iter_mut :: proc(self: inout) -> Small_Array_Mut_Iterator(T) ---;

	append_copied :: proc(
		self: inout, @(escape=stored) values: ..T,
	) where is_copyable(T) ---;

	// Private to the package, but a public declaration names it.
	append_one_copied :: proc(
		self: inout, @(escape=stored) value: T,
	) where is_copyable(T) ---;

	// Nothing is written unless everything fits, which is the `try_` promise.
	try_append_copied :: proc(
		self: inout, @(escape=stored) values: ..T,
	) -> Status(Capacity_Error) where is_copyable(T) ---;

	insert_copied :: proc(
		self: inout, index: int, @(escape=stored) value: T,
	) where is_copyable(T) ---;

	/*
		Like `try_append_copied`, at `index`. Capacity failure leaves the array
		untouched; a bad index panics even when the array is full.
	*/
	try_insert_copied :: proc(
		self: inout, index: int, @(escape=stored) value: T,
	) -> Status(Capacity_Error) where is_copyable(T) ---;

	/*
		The consuming half of the insertion groups below: it takes its element with
		`move`, and an argument that owns its value — a temporary or `move(...)` —
		selects it. A failed `try_` form drops the value it took, as built-in
		insertion does.
	*/
	try_append_moved :: proc(
		self: inout, @(escape=stored) value: move T,
	) -> Status(Capacity_Error) ---;

	try_insert_moved :: proc(
		self: inout, index: int, @(escape=stored) value: move T,
	) -> Status(Capacity_Error) ---;

	append_moved :: proc(self: inout, @(escape=stored) value: move T) ---;

	insert_moved :: proc(
		self: inout, index: int, @(escape=stored) value: move T,
	) ---;

	/*
		One name per operation, exactly as built-in insertion has one: a borrowed
		place copies, a temporary or `move(...)` transfers. The call site therefore
		reads the same here as on `[dynamic]T`.
	*/
	append :: proc{append_one_copied, append_copied, append_moved};

	insert :: proc{insert_copied, insert_moved};

	try_append :: proc{try_append_copied, try_append_moved};

	try_insert :: proc{try_insert_copied, try_insert_moved};

	// The last element, removed, or .none when empty, like a dynamic array.
	pop :: proc(self: inout) -> Option(T) ---;

	// Order-preserving: each following element moves down into the vacant slot.
	remove :: proc(self: inout, index: int) -> T ---;

	// O(1), at the cost of the order: the last element takes the hole.
	remove_unordered :: proc(self: inout, index: int) -> T ---;

	// Sets the length to zero, dropping each element.
	clear :: proc(self: inout) ---;

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) ---;
}

/*
	A borrow of the array's live prefix plus the traversal state. The array it
	came from cannot be mutated, moved, or dropped while this is live. One
	iterator serves both directions.
*/
Small_Array_Iterator :: struct($T: type) {
	// and fields private to the package
}

impl Small_Array_Iterator($T) {
	Element  :: T;

	iter :: proc(self) -> Small_Array_Iterator(T) ---;

	next :: proc(self: inout) -> Option(^T) ---;
}

/*
	A mutable traversal borrows the same inline prefix. Each pointer returned by
	next() is a loan of the iterator and must end before it is advanced again.
*/
Small_Array_Mut_Iterator :: struct($T: type) {
	// and fields private to the package
}

impl Small_Array_Mut_Iterator($T) {
	next :: proc(self: inout) -> Option(^mut T) ---;
}
