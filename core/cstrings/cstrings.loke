// Owned zero-terminated buffers for foreign APIs (design.md "C string views",
// standard-library "`core:cstrings`").
//
// `cstring_view` from `string.to_c_view()` is valid only through the enclosing
// expression. A foreign API that *retains* the pointer needs storage that
// outlives the call, and that is what `C_String` is.
//
// Unlike `string`, it does not promise UTF-8: a foreign encoding is exactly the
// case it exists for. It only promises that the bytes it owns end at the
// terminator and contain no other zero.
@(public)
package cstrings;

import "core:mem";

Error :: enum {
	// A Loke `string` may legitimately contain U+0000; a retained C string
	// cannot, because the terminator would end it early.
	Contains_Zero,
	Out_Of_Memory,
}

C_String :: struct {
	// The bytes *including* the terminator, so `view` never has to add one and
	// the buffer is exactly what the foreign side sees.
	@(private) data: [dynamic]u8,
}

from_string :: proc(
	text: string_view, allocator: Allocator = mem.default_allocator(),
) -> Result(C_String, Error) {
	foreach (byte in text.bytes()) {
		if (byte == 0) {
			return .err(.Contains_Zero);
		}
	}
	switch (buffer in try_make([dynamic]u8, 0, text.len() + 1, allocator)) {
	case .ok:
		// The capacity covers the text and the terminator, so neither append
		// can grow the buffer, and neither can fail.
		buffer.append(..text.bytes());
		buffer.append(0);
		// `move`, because a copy would clone the bytes into the *default*
		// allocator and discard the one the caller chose.
		return .ok(C_String{move(buffer)});
	case .err:
		return .err(.Out_Of_Memory);
	}
}

impl C_String {
	// design.md spells the accessor as a method, so the whole surface is one.
	//
	// The view borrows storage this value owns, hence `self: ^` (design.md
	// "Receiver forms"), and the compiler tracks that borrow. Once the pointer
	// crosses into foreign code, keeping the `C_String` alive for as long as the
	// foreign side holds it is the caller's obligation, and is the whole reason
	// this type exists.
	view :: proc(self: ^) -> cstring_view {
		// Only the zero value has no terminator.
		return cstring_view.from_bytes(self.data[:]) or_else "";
	}

	// Excludes the terminator.
	len :: proc(self) -> int {
		return 0 if self.data.len() == 0 else self.data.len() - 1;
	}
}
