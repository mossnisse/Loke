// Formatted output (design.md "String format printing").
//
// The protocol is a `value.format(writer, options)` method. `Writer` is a
// borrowed byte sink — a `dyn mut Sink` view — and `Options` is what a formatter
// reads to spell a scalar. Both layouts are shared with the seed runtime, which
// is where a formatter's bytes finally go.
//
// design.md's coherence rule: runtime formatting has one formatter per concrete
// `typeid`. Built-ins receive compiler-generated formatters, and a user
// customization is eligible only when its `format` is declared in the value
// type's own package. An extension `impl` elsewhere may still declare a `format`
// and call it explicitly, but it cannot change what `print` does — an `any_view`
// carries only a pointer and a `typeid`, so a callee has no way to recover a
// call-site-specific overload.
@(public)
package fmt;

// One byte sink. Any record with this `write` is one, so the same view serves a
// stream, a buffer, and a counting sink; `(fmt.Writer)(&mut sink)` makes it.
@(public)
Sink :: interface($Self: type) {
	slot write: proc(self: inout Self, bytes: []u8);
}

// The view a formatter writes through. It borrows the sink for the call, which
// is as long as any formatter keeps it.
@(public)
Writer :: dyn mut Sink;

// How a formatter spells a scalar. `base` is 2 to 36; anything else reads as 10.
@(public)
Options :: struct {
	@(public) base:      int,
	@(public) uppercase: bool,
}

@(public)
DEFAULT_OPTIONS :: Options{10, false};

// The compiler contributes:
//
//   stdout_writer()      the process output sink
//   stderr_writer()      the process error sink
//   write_bytes(w, view) one string view, straight through the sink
//   format_any(v, w, o)  dispatch through the private per-typeid formatter table
//
// `format_any` is the erased half of the coherence rule: it looks the value's
// concrete formatter up by `typeid`, which is the only thing an `any_view`
// carries, so two packages cannot give one type two erased spellings.

@(public)
print :: proc(args: ..any_view) {
	emit(stdout_writer(), DEFAULT_OPTIONS, ..args);
}

@(public)
println :: proc(args: ..any_view) {
	w := stdout_writer();
	emit(w, DEFAULT_OPTIONS, ..args);
	write_bytes(w, "\n");
}

@(public)
eprint :: proc(args: ..any_view) {
	emit(stderr_writer(), DEFAULT_OPTIONS, ..args);
}

@(public)
eprintln :: proc(args: ..any_view) {
	w := stderr_writer();
	emit(w, DEFAULT_OPTIONS, ..args);
	write_bytes(w, "\n");
}

// The process sinks, as ordinary values. The intrinsics behind them are
// package-private — nothing outside this package should reach the dispatch
// table — so these are what a caller writing to a `Writer` uses.
@(public)
stdout :: proc() -> Writer { return stdout_writer(); }

@(public)
stderr :: proc() -> Writer { return stderr_writer(); }

// design.md's own examples separate arguments with a space:
// `fmt.println(offset, codepoint)` prints `0 A`.
@(public)
format_to :: proc(w: Writer, args: ..any_view) {
	emit(w, DEFAULT_OPTIONS, ..args);
}

// The same, with the caller choosing how a scalar is spelled: `Options{16, true}`
// writes `CAFEBABE` where the default writes `3405691582`. The seed runtime has
// always implemented base 2 to 36 and both digit cases; until this procedure
// existed nothing could ask for them, because `format_any` is package-private
// and every call site here passed `DEFAULT_OPTIONS`.
//
// `options` leads for the same reason `to_string`'s allocator does: a variadic
// absorbs the trailing arguments. The name differs rather than overloading
// `format_to`, because an `Options` is itself a formattable value — so
// `format_to(w, options, x)` would be an ambiguous call rather than an obvious
// one.
@(public)
format_to_with :: proc(w: Writer, options: Options, args: ..any_view) {
	emit(w, options, ..args);
}

// The same formatting, into memory instead of a stream.
//
// The allocator is a required *leading* parameter, not a defaulted trailing one:
// a variadic absorbs the trailing arguments, so nothing after it can be supplied
// and nothing defaulted before it can be omitted.
//
// Together with `io.write_string` this is the simple fallback for any sink:
// format in memory, then write the result and handle that write's error. To
// append to a `strings.String_Builder`, pass the result to its own `append` —
// that one line is why this package does not import `core:strings` for an
// `append_to` of its own. Almost every program imports `core:fmt`, an imported
// package is emitted whole, and the measured cost of that import was hello
// world's IR going from 397 lines to 4923.
@(public)
to_string :: proc(allocator: Allocator, args: ..any_view) -> string {
	sink := make([dynamic]u8, 0, 64, allocator);
	// `move`, because a named local in a composite literal is copy initialization
	// and not a transfer. Without it the collector clones the buffer from the
	// *selected* allocator and formats there, so `allocator` reached only the
	// returned string and every call allocated twice.
	collector := Collector{move(sink)};
	emit((Writer)(&mut collector), DEFAULT_OPTIONS, ..args);
	// Every formatter writes UTF-8; a `format` overload that does not is the
	// one way here, and a wrong one.
	view := string_view.from_utf8(collector.bytes[:]) or_else panic("formatted output is not valid UTF-8");
	// The compiler contributes `allocate_string`: a copy of known-valid UTF-8
	// into string storage from a *supplied* allocator. `core:strings` wraps the
	// same primitive as `clone`.
	return allocate_string(view, allocator) or_else panic("formatting allocation failed");
}

@(private)
Collector :: struct { bytes: [dynamic]u8 }

impl Collector {
	write :: proc(self: inout, bytes: []u8) { self.bytes.append(..bytes); }
}

@(private)
emit :: proc(w: Writer, options: Options, args: ..any_view) {
	first := true;
	foreach (a in args) {
		if (!first) {
			write_bytes(w, " ");
		}
		first = false;
		format_any(a, w, options);
	}
}
