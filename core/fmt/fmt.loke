/**
	Formatted output.

	`Formattable` supplies `value.format(writer, options)`. `Writer` is a
	borrowed byte sink — a `dyn mut Sink` view — and `Options` is what a formatter
	reads to spell a scalar.

	The compiler supplies default methods for printable types. The printers take
	`..dyn Formattable`, which views each argument with the same coherent witness
	an explicit `(dyn Formattable)(&value)` uses; importing an extension cannot
	change a type's printed representation.
*/
// standard-library.md "Printed forms". Both layouts are shared with the seed
// runtime, which is where a formatter's bytes finally go.
@(public)
package fmt;

import "base:interfaces";

/**
	One byte sink. Any record with this `write` is one, so the same view serves a
	stream, a buffer, and a counting sink; `(fmt.Writer)(&mut sink)` makes it.
*/
@(public)
Sink :: interface($Self: type) {
	slot write: proc(self: inout Self, bytes: []u8);
}

/**
	The view a formatter writes through. It borrows the sink for the call, which
	is as long as any formatter keeps it.
*/
@(public)
Writer :: dyn mut Sink;

/// How a formatter spells a scalar. `base` is 2 to 36; anything else reads as 10.
@(public)
Options :: struct {
	@(public) base:      int,
	@(public) uppercase: bool,
}

@(public)
DEFAULT_OPTIONS :: Options{10, false};

/**
	One borrowed printed representation. Inherent methods customize it; the
	compiler supplies defaults for other printable runtime types.
*/
@(public)
Formattable :: interface($Self: type) {
	slot format: proc(self: ^, writer: Writer, options: Options);
}

// The compiler finds printing's interface through this name.
@(private)
Format_View :: dyn Formattable;

// The compiler contributes:
//
//   stdout_writer()      the process output sink
//   stderr_writer()      the process error sink
//   write_bytes(w, view) one string view, straight through the sink
//
// A `..dyn Formattable` pack views each argument where it is written
// (design.md "Variadic parameters"), so formatting one is a slot call.

@(public)
print :: proc(args: ..dyn Formattable) {
	emit(stdout_writer(), DEFAULT_OPTIONS, ..args);
}

@(public)
println :: proc(args: ..dyn Formattable) {
	w := stdout_writer();
	emit(w, DEFAULT_OPTIONS, ..args);
	write_bytes(w, "\n");
}

@(public)
eprint :: proc(args: ..dyn Formattable) {
	emit(stderr_writer(), DEFAULT_OPTIONS, ..args);
}

@(public)
eprintln :: proc(args: ..dyn Formattable) {
	w := stderr_writer();
	emit(w, DEFAULT_OPTIONS, ..args);
	write_bytes(w, "\n");
}

/**
	The process sinks, as ordinary values: what a caller writing to a `Writer`
	uses.
*/
// The intrinsics behind them are package-private — nothing outside this
// package should reach the dispatch table.
@(public)
stdout :: proc() -> Writer { return stdout_writer(); }

@(public)
stderr :: proc() -> Writer { return stderr_writer(); }

/**
	The arguments, separated by a space: `fmt.println(offset, codepoint)` prints
	`0 A`.
*/
// As design.md's own examples separate them.
@(public)
format_to :: proc(w: Writer, args: ..dyn Formattable) {
	emit(w, DEFAULT_OPTIONS, ..args);
}

/**
	The arguments back to back, with nothing between: what a `format` method
	uses to write `(3, 4)`, and anything else whose punctuation is its own.
*/
@(public)
concat_to :: proc(w: Writer, args: ..dyn Formattable) {
	foreach (a in args) {
		a.format(w, DEFAULT_OPTIONS);
	}
}

/**
	The same, with the caller choosing how a scalar is spelled: `Options{16, true}`
	writes `CAFEBABE` where the default writes `3405691582`. `options` comes
	first because a variadic absorbs the trailing arguments.
*/
// The seed runtime has always implemented base 2 to 36 and both digit cases;
// until this procedure existed nothing could ask for them, because every
// printer here passed `DEFAULT_OPTIONS`.
//
// The name differs rather than overloading `format_to`, because an `Options`
// is itself a formattable value — so `format_to(w, options, x)` would be an
// ambiguous call rather than an obvious one.
@(public)
format_to_with :: proc(w: Writer, options: Options, args: ..dyn Formattable) {
	emit(w, options, ..args);
}

/**
	The same formatting, into memory instead of a stream. The allocator comes
	first because a variadic absorbs the trailing arguments.

	Together with `io.write_string` this is the simple fallback for any sink:
	format in memory, then write the result and handle that write's error. To
	append to a `strings.String_Builder`, pass the result to its own `append`.
*/
// The allocator is a required *leading* parameter, not a defaulted trailing
// one: nothing after a variadic can be supplied and nothing defaulted before
// it can be omitted.
//
// That one `append` line is why this package does not import `core:strings`
// for an `append_to` of its own. Almost every program imports `core:fmt`, an
// imported package is emitted whole, and the measured cost of that import was
// hello world's IR going from 397 lines to 4923.
@(public)
to_string :: proc(allocator: Allocator, args: ..dyn Formattable) -> string {
	collector := Collector{make([dynamic]u8, 0, 64, allocator)};
	emit((Writer)(&mut collector), DEFAULT_OPTIONS, ..args);
	// Every formatter writes UTF-8; a `format` overload that does not is the
	// one way here, and a wrong one.
	view := string_view.from_utf8(collector.bytes[:]) or_else panic("formatted output is not valid UTF-8");
	// The compiler contributes `allocate_string`: a copy of known-valid UTF-8
	// into string storage from a *supplied* allocator. `core:strings` wraps the
	// same primitive as `clone`. Failure follows the allocator's policy.
	switch (allocate_string(view, allocator)) {
	case .ok(copied): return copied;
	case .err(error): allocation_failed(error, allocator);
	}
}

@(private)
Collector :: struct { bytes: [dynamic]u8 }

impl Collector {
	write :: proc(self: inout, bytes: []u8) { self.bytes.append(..bytes); }
}

@(private)
emit :: proc(w: Writer, options: Options, args: ..dyn Formattable) {
	first := true;
	foreach (a in args) {
		if (!first) {
			write_bytes(w, " ");
		}
		first = false;
		a.format(w, options);
	}
}

// ------------------------------------------------------ width and precision --

/**
	`value` with exactly `digits` digits after the point, rounded to nearest with
	ties to even: `fixed(3.14159, 2)` prints `3.14`. `digits` is 0 to 40; a value
	outside reads as the nearer end. NaN and the infinities print as any float.
*/
@(public)
fixed :: proc(value: f64, digits: int) -> Fixed {
	return Fixed{value, digits};
}

@(public)
Fixed :: struct { @(private) value: f64, @(private) digits: int }

impl Fixed {
	format :: proc(self, writer: Writer, options: Options) {
		rt_fmt_fixed(&writer, self.value, self.digits);
	}
}

/**
	`value` printed in at least `width` runes, padded with spaces on the left so
	that a column of them lines up on the right: `pad_left(42, 5)` prints `   42`.
	A longer value prints whole. `width` counts runes, not display columns.
*/
@(public)
pad_left :: proc(value: $T, width: int) -> Padded(T) {
	return Padded(T){value, width, .Left};
}

/// The same, padded on the right, for a column that lines up on the left.
@(public)
pad_right :: proc(value: $T, width: int) -> Padded(T) {
	return Padded(T){value, width, .Right};
}

/**
	An integer padded with zeros after its sign, so `zero_pad(7, 3)` prints `007`
	and `zero_pad(-7, 3)` prints `-07`. The sign counts toward `width`, and a
	leading `+` from a type's own `format` is a sign too. A `rune` is `Integral`
	but prints as its character, so it is rejected; `int(r)` pads its code point.
*/
@(public)
zero_pad :: proc(value: $T, width: int) -> Padded(T) where interfaces.Integral(T), T != rune {
	return Padded(T){value, width, .Zero};
}

@(public)
Padded :: struct($T: type) { @(private) value: T, @(private) width: int, @(private) fill: Fill }

// Where `Padded` puts its fill: spaces before the value or after it, or zeros
// between the sign and the digits.
@(private)
Fill :: enum { Left, Right, Zero }

impl Padded($T) {
	format :: proc(self, writer: Writer, options: Options) {
		// ponytail: the value is formatted twice, once to count it, rather than
		// buffered; a `format` with side effects runs them twice.
		counter := Rune_Counter{};
		emit((Writer)(&mut counter), options, self.value);
		if (self.fill == .Right) {
			emit(writer, options, self.value);
		}
		if (self.fill == .Zero) {
			write_bytes(writer, counter.sign);
		}
		pad: string_view = " ";
		if (self.fill == .Zero) { pad = "0"; }
		for (i := counter.runes; i < self.width; i += 1) {
			write_bytes(writer, pad);
		}
		if (self.fill == .Left) {
			emit(writer, options, self.value);
		} else if (self.fill == .Zero) {
			unsigned := Unsigned{writer, counter.sign != ""};
			emit((Writer)(&mut unsigned), options, self.value);
		}
	}
}

@(private)
Rune_Counter :: struct { runes: int, sign: string_view }

impl Rune_Counter {
	// Every byte but a UTF-8 continuation byte starts a rune. A leading `-` or
	// `+` is also the sign `zero_pad` writes ahead of its zeros.
	write :: proc(self: inout, bytes: []u8) {
		foreach (b in bytes) {
			if (self.runes == 0 && b == '-') { self.sign = "-"; }
			if (self.runes == 0 && b == '+') { self.sign = "+"; }
			if ((b & 0xC0) != 0x80) { self.runes += 1; }
		}
	}
}

// Forwards to `target`, dropping the sign `zero_pad` already wrote.
@(private)
Unsigned :: struct { target: Writer, skip: bool }

impl Unsigned {
	// A loop rather than `bytes.len()`, which would emit the slice's built-in
	// members into every program that imports this package.
	write :: proc(self: inout, bytes: []u8) {
		if (self.skip) {
			foreach (_ in bytes) {
				self.skip = false;
				self.target.write(bytes[1:]);
				return;
			}
		}
		self.target.write(bytes);
	}
}

// ------------------------------------------------------ fallible spelling --

/**
	What can stop `try_spell_f64`: the "C" numeric locale every float spelling
	goes through could not be made. `Out_Of_Memory` when that was an allocation
	failure, `Unavailable` otherwise. Printing panics instead, because a sink
	has no way to report it.
*/
// `core:strconv` has the same two answers for reading a float, as its own type
// because neither package imports the other.
@(public)
Backend_Error :: enum { Out_Of_Memory, Unavailable }

/// The most bytes `try_spell_f64` writes.
@(public)
FLOAT_SPELLING_MAX :: 32;

/**
	`value` as `print` spells it, written to the start of `destination`,
	answering how many bytes it took: the shortest text that reads back as the
	same value, or `nan`, `inf`, and `-inf`. It neither allocates nor writes
	through a sink, so a writer that must report every failure can spell a
	float without one.
*/
// standard-library "`core:fmt`": the shared fallible primitive
// `core:encoding/json` writes floats with.
@(public)
try_spell_f64 :: proc(
	value: f64, destination: ^mut [FLOAT_SPELLING_MAX]u8,
) -> Result(int, Backend_Error) {
	used := rt_try_spell_f64(destination, value);
	if (used == -NUMERIC_OUT_OF_MEMORY) { return .err(.Out_Of_Memory); }
	if (used < 0) { return .err(.Unavailable); }
	return used;
}

// `loke_rt.h`'s answer for a locale that failed to allocate.
@(private)
NUMERIC_OUT_OF_MEMORY :: 2;

// The seed runtime is part of every link, and a `Writer` has its writer record's
// layout. Private, or the file-wide `@(public)` would export them as
// `fmt.rt_fmt_fixed` and `fmt.rt_try_spell_f64`.
@(private)
foreign loke_runtime {
	@(link_name="loke_rt_v1_fmt_fixed")
	rt_fmt_fixed :: proc "c" (writer: ^Writer, value: f64, digits: int) ---;
	@(link_name="loke_rt_v1_try_spell_f64")
	rt_try_spell_f64 :: proc "c" (out: ^mut [FLOAT_SPELLING_MAX]u8, value: f64) -> int ---;
}
