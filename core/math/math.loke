/**
	The elementary functions and the constants.

	Every float-specific procedure has exactly two concrete spellings: the
	unsuffixed name takes and returns `f64`, and the `_f32` name takes and
	returns `f32`. They are not a procedure group, so `math.sqrt(2.0)` is not
	ambiguous. `f16` gets nothing.

	The CRT-backed procedures promise the classifications, signs, poles, and
	domain results documented on each one. They do not promise correctly rounded
	transcendental results, a particular NaN payload, or portable `errno`
	contents. They never turn a floating-point exception or an `errno` value
	into a panic.

	The transcendental procedures are **not deterministic**: `pow`, `exp`, `log`,
	`log2`, `log10`, `hypot`, `sin`, `cos`, `tan`, `asin`, `acos`, `atan`, and
	`atan2`, in both widths, can give different last bits for the same
	arguments. The C library chooses its algorithm by the processor's features,
	so one executable can disagree with itself on another machine; an optimized
	build can evaluate a call with constant arguments using the compiling
	machine's library; and another platform has another library. Code whose
	results must agree bit for bit everywhere, such as a lockstep simulation or
	content generated from a shared seed, should not use them;
	`core:math/repro` has what it implements with results that agree.
	Everything else here is exact or correctly rounded, and so deterministic,
	except the `abs` of `Complex` and `Quaternion`, which uses `hypot`, and
	whose agreeing counterparts are `core:math/repro`'s `complex_abs` and
	`quaternion_abs`.
*/
// standard-library "`core:math`". The variation was measured: on one machine,
// the C library's FMA3 and legacy paths disagree on about one `sin` in a
// hundred. open-questions.md "Deterministic math functions" records the
// proposed fix.
//
// Deliberately not a procedure group — design.md "Operator lookup and overload
// resolution" leaves `f32` vs `f64` overloads ambiguous for an untyped literal,
// so `math.sqrt(2.0)` would not compile if they were one. Both widths ship
// together because Loke has no implicit `f32` -> `f64` widening: an `f32`
// caller without a twin would write `f32(math.sqrt(f64(x)))`, which rounds
// twice. The C library has no `f16` variants.
@(public)
package math;

import "base:interfaces";
import "core:unsafe";

// ------------------------------------------------------------- constants --
//
// Unfixed, so each converts at the point of use to whichever floating type the
// context wants. A limit is a property of one format, so those carry the format
// in the name instead.

PI       :: 3.14159265358979323846264338327950288;
TAU      :: 6.28318530717958647692528676655900577;
E        :: 2.71828182845904523536028747135266250;
LN2      :: 0.693147180559945309417232121458176568;
LN10     :: 2.30258509299404568401799145468436421;
SQRT_TWO :: 1.41421356237309504880168872420969808;

/**
	`EPSILON` is the gap from `1` to the next representable value; `MIN_NORMAL`
	is the smallest positive normal value and `MIN_SUBNORMAL` the smallest
	positive subnormal one. The NaN payload is canonical only for the constant —
	a procedure may propagate or return another quiet payload.
*/
// Infinity and the canonical quiet NaN have no literal spelling, and a decimal
// literal for a limit is a transcription no reader can check. Every typed limit
// is therefore its exact IEEE-754 pattern, folded at compile time. The unsafe
// dependency is an implementation detail: nothing in the public surface below
// takes or returns anything from `core:unsafe`.
F32_EPSILON       :: unsafe.transmute(f32, u32(0x34000000));
F64_EPSILON       :: unsafe.transmute(f64, u64(0x3cb0000000000000));
F32_MAX           :: unsafe.transmute(f32, u32(0x7f7fffff));
F64_MAX           :: unsafe.transmute(f64, u64(0x7fefffffffffffff));
F32_MIN_NORMAL    :: unsafe.transmute(f32, u32(0x00800000));
F64_MIN_NORMAL    :: unsafe.transmute(f64, u64(0x0010000000000000));
F32_MIN_SUBNORMAL :: unsafe.transmute(f32, u32(0x00000001));
F64_MIN_SUBNORMAL :: unsafe.transmute(f64, u64(0x0000000000000001));
F32_INFINITY      :: unsafe.transmute(f32, u32(0x7f800000));
F64_INFINITY      :: unsafe.transmute(f64, u64(0x7ff0000000000000));
F32_NAN           :: unsafe.transmute(f32, u32(0x7fc00000));
F64_NAN           :: unsafe.transmute(f64, u64(0x7ff8000000000000));

// The masks the classification and sign procedures are written over. Everything
// below is a bit test: no CRT call, no rounding, and no quieting of a NaN.
@(private) F32_SIGN     :: u32(0x80000000);
@(private) F32_MAGNITUDE :: u32(0x7fffffff);
@(private) F32_EXPONENT :: u32(0x7f800000);
@(private) F64_SIGN     :: u64(0x8000000000000000);
@(private) F64_MAGNITUDE :: u64(0x7fffffffffffffff);
@(private) F64_EXPONENT :: u64(0x7ff0000000000000);

// Exact powers of two for scaling small complex division operands: `2^512` and
// `2^-512` for `f64`, `2^64` and `2^-64` for `f32`. Scaled by them, even the
// smallest subnormal lands in the normal range, and compensating costs one
// power-of-two multiply.
@(private) F64_SCALE_UP   :: unsafe.transmute(f64, u64(0x5ff0000000000000));
@(private) F64_SCALE_DOWN :: unsafe.transmute(f64, u64(0x1ff0000000000000));
@(private) F32_SCALE_UP   :: unsafe.transmute(f32, u32(0x5f800000));
@(private) F32_SCALE_DOWN :: unsafe.transmute(f32, u32(0x1f800000));

// --------------------------------------------- classification and sign --

/**
	Whether `x` is a NaN: the maximum exponent with a non-zero significand. True
	for both quiet and signalling NaNs, and for either sign.
*/
is_nan :: proc(x: f64) -> bool {
	return (unsafe.transmute(u64, x) & F64_MAGNITUDE) > F64_EXPONENT;
}

is_nan_f32 :: proc(x: f32) -> bool {
	return (unsafe.transmute(u32, x) & F32_MAGNITUDE) > F32_EXPONENT;
}

/// Whether `x` is either infinity.
is_infinite :: proc(x: f64) -> bool {
	return (unsafe.transmute(u64, x) & F64_MAGNITUDE) == F64_EXPONENT;
}

is_infinite_f32 :: proc(x: f32) -> bool {
	return (unsafe.transmute(u32, x) & F32_MAGNITUDE) == F32_EXPONENT;
}

/// Whether `x` is neither infinite nor a NaN. Zeros and subnormals are finite.
is_finite :: proc(x: f64) -> bool {
	return (unsafe.transmute(u64, x) & F64_EXPONENT) != F64_EXPONENT;
}

is_finite_f32 :: proc(x: f32) -> bool {
	return (unsafe.transmute(u32, x) & F32_EXPONENT) != F32_EXPONENT;
}

/**
	The sign bit itself, not `x < 0`: true for `-0.0` and for a negative NaN,
	which is the whole reason to ask.
*/
sign_bit :: proc(x: f64) -> bool {
	return (unsafe.transmute(u64, x) & F64_SIGN) != 0;
}

sign_bit_f32 :: proc(x: f32) -> bool {
	return (unsafe.transmute(u32, x) & F32_SIGN) != 0;
}

/**
	The magnitude of `x`. Clearing the sign bit maps `-0.0` to `+0.0` and leaves
	a NaN's payload and quiet/signalling bit exactly as they were.
*/
abs :: proc(x: f64) -> f64 {
	return unsafe.transmute(f64, unsafe.transmute(u64, x) & F64_MAGNITUDE);
}

abs_f32 :: proc(x: f32) -> f32 {
	return unsafe.transmute(f32, unsafe.transmute(u32, x) & F32_MAGNITUDE);
}

/**
	The magnitude of `magnitude` with the sign bit of `sign`. Both operands keep
	their payloads: this composes representations, it does not compute.
*/
copy_sign :: proc(magnitude: f64, sign: f64) -> f64 {
	return unsafe.transmute(f64,
		(unsafe.transmute(u64, magnitude) & F64_MAGNITUDE) |
		(unsafe.transmute(u64, sign) & F64_SIGN));
}

copy_sign_f32 :: proc(magnitude: f32, sign: f32) -> f32 {
	return unsafe.transmute(f32,
		(unsafe.transmute(u32, magnitude) & F32_MAGNITUDE) |
		(unsafe.transmute(u32, sign) & F32_SIGN));
}

// ------------------------------------------------------------ comparison --
//
// Numeric scalars, not everything that happens to be ordered: strings, enums,
// and pointers do not acquire arithmetic-looking operations from `core:math`.
// `core:slice` already has `min`/`max` over a slice; these are the scalar forms.

/**
	`a` when `a < b`, and `b` otherwise. Equal or unordered operands therefore
	select the second argument — including two signed zeros, and a NaN in either
	position.
*/
min :: proc(a, b: $T) -> T where interfaces.Numeric(T), interfaces.Ordered(T) {
	return a if a < b else b;
}

/// `a` when `b < a`, and `b` otherwise, with the same tie and NaN rule as `min`.
max :: proc(a, b: $T) -> T where interfaces.Numeric(T), interfaces.Ordered(T) {
	return a if b < a else b;
}

/**
	`value` brought inside `[low, high]`. Reversed bounds are a caller mistake
	with no defensible answer, so they panic rather than silently picking one.
	A NaN `value` is returned unchanged, and a NaN bound is unordered against
	everything and so does not clamp on that side.
*/
clamp :: proc(value, low, high: $T) -> T where interfaces.Numeric(T), interfaces.Ordered(T) {
	assert(!(high < low), "math.clamp needs low <= high");
	if (value < low) { return low; }
	if (high < value) { return high; }
	return value;
}

/**
	`value` as a `To`, keeping the low bits of its two's-complement
	representation, as the wrapping operators do, where `To(value)` would panic.

	`value` is an integer, rune, or enum, and `To` an integer or rune type; a
	SIMD vector converts lane by lane to one of the same lane count. A constant
	folds.

	    count := 300;
	    low := math.wrap(u8, count);   // 44
*/
// design.md "Type conversion": a checked `T(value)` cannot keep the low bits,
// so the conversion that does is compiler-known.
@(intrinsic)
wrap :: proc($To: type, value: $From) -> To ---;

/**
	`value` as a `To`, or `.none` when `To` cannot represent it exactly.

	`To(value)` panics when the value does not fit, and `wrap(To, value)` keeps
	its low bits instead. This asks, which is what
	validating input wants. It is the scalar twin of `Enum.from_int`: it neither
	traps nor silently narrows.
*/
// design.md "Type conversion".
//
// The check is a round trip plus a sign comparison. The round trip alone is not
// enough, because between two types of the same width it always succeeds —
// `i32(-1)` wraps to `u32` and back unchanged — and only the sign test catches
// that. `Integral` is here to exclude floats, whose conversions round rather
// than wrap; nothing in the body needs its bit operations.
to :: proc($To: type, value: $From) -> Option(To)
	where interfaces.Integral(From), interfaces.Ordered(From),
	interfaces.Integral(To), interfaces.Ordered(To) {
	converted := wrap(To, value);
	if (wrap(From, converted) != value) { return .none; }
	if ((value < From(0)) != (converted < To(0))) { return .none; }
	return converted;
}

// --------------------------------------------- integer arithmetic policies --
//
// `+`, `-`, and `*` panic on overflow (design.md "Integer overflow"). The
// `wrapping_` forms keep the low bits instead, as `+%`, `-%`, and `*%` do, and
// the `checked_` forms answer `.none` where the operator would panic. They are
// for generic code and procedure values. `floor_div` and `floor_mod` are the
// floored counterparts of the truncating `/` and `%`.
//
// `interfaces.Integral` does not require the wrapping operators, so a distinct
// integer that satisfies it may have none. The low bits of a sum, difference,
// or product depend only on the low bits of its operands, so the wrapping forms
// compute in `u128`, which holds every integer's bits, and wrap back. The
// optimizer narrows the arithmetic again.
//
// SIMD lanes follow the scalar rule (design.md "Lane-wise operators"), so the
// wrapping forms also take two vectors of integer lanes. A lane-wise operator
// applies to a distinct lane type through its representation, so the vector
// forms need no conversion.

wrapping_add :: proc{wrapping_add_integer, wrapping_add_lanes};
wrapping_sub :: proc{wrapping_sub_integer, wrapping_sub_lanes};
wrapping_mul :: proc{wrapping_mul_integer, wrapping_mul_lanes};

wrapping_add_integer :: proc(a: $T, b: T) -> T where interfaces.Integral(T) {
	return wrap(T, wrap(u128, a) +% wrap(u128, b));
}

wrapping_sub_integer :: proc(a: $T, b: T) -> T where interfaces.Integral(T) {
	return wrap(T, wrap(u128, a) -% wrap(u128, b));
}

wrapping_mul_integer :: proc(a: $T, b: T) -> T where interfaces.Integral(T) {
	return wrap(T, wrap(u128, a) *% wrap(u128, b));
}

wrapping_add_lanes :: proc(a: Simd($T, $N), b: Simd(T, N)) -> Simd(T, N) where interfaces.Integral(T) {
	return a +% b;
}

wrapping_sub_lanes :: proc(a: Simd($T, $N), b: Simd(T, N)) -> Simd(T, N) where interfaces.Integral(T) {
	return a -% b;
}

wrapping_mul_lanes :: proc(a: Simd($T, $N), b: Simd(T, N)) -> Simd(T, N) where interfaces.Integral(T) {
	return a *% b;
}

/// `a + b`, or `.none` when the sum does not fit in `T`.
// An overflowing sum wraps past the end that `b`'s sign points to, so it lands
// on the wrong side of `a`.
checked_add :: proc(a: $T, b: T) -> Option(T) where interfaces.Integral(T), interfaces.Ordered(T) {
	sum := wrapping_add(a, b);
	if ((b < T(0)) != (sum < a)) { return .none; }
	return sum;
}

checked_sub :: proc(a: $T, b: T) -> Option(T) where interfaces.Integral(T), interfaces.Ordered(T) {
	difference := wrapping_sub(a, b);
	if ((b < T(0)) != (a < difference)) { return .none; }
	return difference;
}

/// `a * b`, or `.none` when the product does not fit in `T`.
// A product overflowed exactly when dividing it by `a` does not give back `b`.
// For a signed `a` of -1 that division could itself overflow, at the minimum,
// the one value whose negation does not fit — and there the product is `b`.
// `a + 1 == 0` names -1 without the constant `0 - 1`, which an unsigned `T`
// cannot hold.
checked_mul :: proc(a: $T, b: T) -> Option(T) where interfaces.Integral(T), interfaces.Ordered(T) {
	product := wrapping_mul(a, b);
	if (a == T(0)) { return product; }
	if (a < T(0) && wrapping_add(a, T(1)) == T(0)) {
		if (b != T(0) && product == b) { return .none; }
		return product;
	}
	if (product / a != b) { return .none; }
	return product;
}

/**
	`x / y` rounded toward negative infinity, where `/` truncates toward zero:
	`floor_div(-1, 16)` is `-1`, not `0`. A zero divisor panics, and so does
	`floor_div(MIN, -1)`, whose quotient does not fit, as for `/`.
*/
// design.md "Integer operators". The truncated quotient is one too large
// exactly when the division is inexact and the operands' signs differ. The
// correction cannot overflow: an inexact division has `|y| >= 2`, so the
// truncated quotient is at most half of `T`'s range.
floor_div :: proc(x: $T, y: T) -> T where interfaces.Integral(T), interfaces.Ordered(T) {
	quotient := x / y;
	if (x % y != T(0) && (x < T(0)) != (y < T(0))) { quotient = quotient - T(1); }
	return quotient;
}

/**
	The remainder that goes with `floor_div`, so that
	`x == floor_div(x, y)*y + floor_mod(x, y)`. A non-zero result has `y`'s
	sign, so for a positive `y` it lies in `[0, y)`: `floor_mod(-1, 16)` is
	`15`. A zero divisor panics; `floor_mod(MIN, -1)` is `0`, as for `%`.
*/
// The truncated remainder has `x`'s sign. Where that is not `y`'s, adding `y`
// brings it into range, and cannot overflow, since the two signs differ.
floor_mod :: proc(x: $T, y: T) -> T where interfaces.Integral(T), interfaces.Ordered(T) {
	remainder := x % y;
	if (remainder != T(0) && (remainder < T(0)) != (y < T(0))) { remainder = remainder + y; }
	return remainder;
}

// ------------------------------------------------------- bit operations --
//
// standard-library "`core:math`". Each reads the operand's two's-complement
// pattern at its type's width, so a signed and an unsigned value with the same
// bits give the same answer. They are compiler-known because none can be
// written as one instruction in Loke, and each is one where the CPU level has
// it: `rol` and `ror` everywhere, `popcnt` from `x86-64-v2`, `lzcnt` and
// `tzcnt` from `x86-64-v3`, and a short sequence below those. Written over
// `interfaces.Integral(T)` instead, they would accept a record that has the
// operators but no width to count or rotate at.

/**
	The number of set bits in `value`, which is a value of an integer type:
	`count_ones(u8(0b1011))` is `3`, and `count_ones(i32(-1))` is `32`. A
	constant argument gives a constant.
*/
@(intrinsic)
count_ones :: proc(value: $T) -> int ---;

/**
	The number of zero bits above the highest set bit of `value`, which is a
	value of an integer type. Zero gives the width: `leading_zeros(u32(0))` is
	`32`, and `leading_zeros(u32(1))` is `31`. A negative value gives `0`. So
	`width - leading_zeros(x)` is the number of bits `x` needs, and for a
	non-zero `x` the index of its highest set bit is one less.
*/
@(intrinsic)
leading_zeros :: proc(value: $T) -> int ---;

/**
	The number of zero bits below the lowest set bit of `value`, which is a
	value of an integer type, and so the index of that bit. Zero gives the
	width: `trailing_zeros(u64(0))` is `64`, and `trailing_zeros(u8(0b1000))`
	is `3`.
*/
@(intrinsic)
trailing_zeros :: proc(value: $T) -> int ---;

/**
	`value`, which is a value of an integer type, with its bits rotated
	`count` places toward the high end: the bits shifted out at the top come
	back in at the bottom. The count is taken modulo the width, floored, so
	every `int` is defined and a negative count rotates right:
	`rotate_left(u8(0b1000_0001), 1)` is `0b0000_0011`, and
	`rotate_left(x, -1) == rotate_right(x, 1)`.
*/
@(intrinsic)
rotate_left :: proc(value: $T, count: int) -> T ---;

/// As `rotate_left`, toward the low end.
@(intrinsic)
rotate_right :: proc(value: $T, count: int) -> T ---;

// ------------------------------------------------ platform math bindings --
//
// The Windows x64 toolchain links the CRT. Bind each width directly to its
// C math function; f32 uses the float entry points without promotion to double.
@(private)
foreign platform_math {
	@(link_name="exp")
	rt_exp_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="expf")
	rt_exp_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="log")
	rt_log_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="logf")
	rt_log_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="log2")
	rt_log2_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="log2f")
	rt_log2_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="log10")
	rt_log10_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="log10f")
	rt_log10_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="sin")
	rt_sin_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="sinf")
	rt_sin_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="cos")
	rt_cos_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="cosf")
	rt_cos_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="tan")
	rt_tan_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="tanf")
	rt_tan_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="asin")
	rt_asin_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="asinf")
	rt_asin_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="acos")
	rt_acos_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="acosf")
	rt_acos_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="atan")
	rt_atan_f64 :: proc "c" (x: f64) -> f64 ---;
	@(link_name="atanf")
	rt_atan_f32 :: proc "c" (x: f32) -> f32 ---;
	@(link_name="hypot")
	rt_hypot_f64 :: proc "c" (a: f64, b: f64) -> f64 ---;
	@(link_name="hypotf")
	rt_hypot_f32 :: proc "c" (a: f32, b: f32) -> f32 ---;
	@(link_name="pow")
	rt_pow_f64 :: proc "c" (a: f64, b: f64) -> f64 ---;
	@(link_name="powf")
	rt_pow_f32 :: proc "c" (a: f32, b: f32) -> f32 ---;
	@(link_name="atan2")
	rt_atan2_f64 :: proc "c" (a: f64, b: f64) -> f64 ---;
	@(link_name="atan2f")
	rt_atan2_f32 :: proc "c" (a: f32, b: f32) -> f32 ---;
}
// --------------------------------------------------- rounding and remainder --
//
// A NaN argument propagates to a quiet NaN throughout this section, and an
// infinite argument to `floor`, `ceil`, `round` or `trunc` returns itself.
// All four preserve the sign of a zero, are exact, and are evaluated at compile
// time when their argument is constant.

/// The largest integral value not greater than `x`.
floor :: proc(x: f64) -> f64 { return floor_instruction(x); }
floor_f32 :: proc(x: f32) -> f32 { return floor_instruction(x); }

/// The smallest integral value not less than `x`.
ceil :: proc(x: f64) -> f64 { return ceil_instruction(x); }
ceil_f32 :: proc(x: f32) -> f32 { return ceil_instruction(x); }

/**
	The nearest integral value, with halfway cases rounded *away from zero* —
	`round(0.5)` is `1` and `round(-0.5)` is `-1`. This is not the current
	rounding mode's tie rule, which rounds halves to even.
*/
round :: proc(x: f64) -> f64 { return round_instruction(x); }
round_f32 :: proc(x: f32) -> f32 { return round_instruction(x); }

/// `x` with its fractional part discarded: the integral value nearest to zero.
trunc :: proc(x: f64) -> f64 { return trunc_instruction(x); }
trunc_f32 :: proc(x: f32) -> f32 { return trunc_instruction(x); }

/**
	Rounding to an integral value, for an `f32` or `f64` operand: SSE4.1's
	instruction from `x86-64-v2`, and below it the C library's function, whose
	result is the same, since the rounding is exact. Evaluated at compile time
	from the exact result.
*/
@(intrinsic)
@(private)
floor_instruction :: proc(x: $T) -> T ---;
@(intrinsic)
@(private)
ceil_instruction :: proc(x: $T) -> T ---;
@(intrinsic)
@(private)
trunc_instruction :: proc(x: $T) -> T ---;
@(intrinsic)
@(private)
round_instruction :: proc(x: $T) -> T ---;

/**
	The floating remainder: the mathematical result of `x - trunc(x/y)*y`,
	without computing that overflow-prone expression. Floating types have no `%`
	operator, so this is that operator's name in Loke terms.

	  y is zero, or x is infinite  -> NaN
	  x finite, y infinite         -> x
	  otherwise                    -> a result whose sign matches x, including
	                                  an exact zero, which keeps x's zero sign

	The result is exact, and a call with constant arguments has a compile-time
	value.
*/
mod :: proc(x: f64, y: f64) -> f64 { return mod_instruction(x, y); }
mod_f32 :: proc(x: f32, y: f32) -> f32 { return mod_instruction(x, y); }

/**
	The floating remainder, LLVM's `frem`, for two `f32` or two `f64` operands:
	on every x86-64 level a call to the C library's `fmod`, which is exact.
	Evaluated at compile time from the exact result.
*/
@(intrinsic)
@(private)
mod_instruction :: proc(x: $T, y: T) -> T ---;

// ------------------------------------------- roots, powers, logarithms --
//
// None of these panics on a floating domain or a pole: the result is a NaN or
// an infinity, which is what the type can already represent.

/**
	The non-negative square root, correctly rounded, so the same everywhere,
	and evaluated at compile time when its argument is constant.

	  -0.0            -> -0.0   (the sign of zero is preserved)
	  x < 0           -> NaN
	  +infinity       -> +infinity
*/
sqrt :: proc(x: f64) -> f64 { return sqrt_instruction(x); }
sqrt_f32 :: proc(x: f32) -> f32 { return sqrt_instruction(x); }

/**
	The square root instruction, for an `f32` or `f64` operand, which IEEE 754
	makes correctly rounded. Evaluated at compile time from the exact result.
*/
@(intrinsic)
@(private)
sqrt_instruction :: proc(x: $T) -> T ---;

/**
	`sqrt(a*a + b*b)`, computed without the intermediate overflow or underflow
	that spelling causes. Always non-negative, and an infinite operand wins over
	a NaN operand: `hypot(infinity, NaN)` is `+infinity`.
	Not deterministic: see the package documentation.
*/
hypot :: proc(a: f64, b: f64) -> f64 { return rt_hypot_f64(a, b); }
hypot_f32 :: proc(a: f32, b: f32) -> f32 { return rt_hypot_f32(a, b); }

/**
	`a*b + c` with a single rounding: the product is not rounded before the sum.
	Unlike a transcendental function's, the result is promised correctly
	rounded. A NaN operand gives a NaN, and otherwise the special cases are
	those of the exact product and the sum:

	  a or b infinite, the other zero          -> NaN
	  a or b infinite, c the opposite infinity -> NaN
	  a*b + c exactly zero                     -> +0, unless a*b and c are both
	                                              negative zeros

	A finite product never overflows on its way to the sum, so
	`fma(1.0e308, 2.0, -infinity)` is `-infinity`.
*/
// design.md "Floating-point operators".
//
// One instruction in code compiled for a CPU level that has it
// (compiler-guide.md "CPU levels", design.md "@(cpu_dispatch=<string>)"), and
// otherwise integer arithmetic rather than the C library, whose `fma` is not
// correctly rounded in every version a toolchain may link. Both round once, so
// they agree on every finite result.
fma :: proc(a: f64, b: f64, c: f64) -> f64 {
	if (fma_is_instruction()) { return fma_instruction(a, b, c); }
	if (!is_finite(a) || !is_finite(b) || a == 0.0 || b == 0.0) {
		// The product is exact: an infinity, a NaN, or a signed zero.
		return a*b + c;
	}
	if (!is_finite(c)) { return c; }
	bits := fused_multiply_add(unsafe.transmute(u64, a), unsafe.transmute(u64, b),
		unsafe.transmute(u64, c), 53, 1023);
	return unsafe.transmute(f64, bits);
}

fma_f32 :: proc(a: f32, b: f32, c: f32) -> f32 {
	if (fma_is_instruction()) { return fma_instruction(a, b, c); }
	if (!is_finite_f32(a) || !is_finite_f32(b) || a == f32(0.0) || b == f32(0.0)) {
		return a*b + c;
	}
	if (!is_finite_f32(c)) { return c; }
	bits := fused_multiply_add(u64(unsafe.transmute(u32, a)), u64(unsafe.transmute(u32, b)),
		u64(unsafe.transmute(u32, c)), 24, 127);
	return unsafe.transmute(f32, u32(bits));
}

/**
	Whether `fma` and `fma_f32` are one instruction in the code calling this,
	rather than slower integer arithmetic: in a build for a CPU level with FMA,
	such as `-cpu=x86-64-v3`, and in a procedure's copy for such a level, which
	`@(cpu_dispatch)` makes. An `if` can choose between an algorithm that calls
	`fma` and one that does not, and the optimizer keeps only the branch taken:

	    if (math.fma_is_instruction()) { ... }

	It is not a constant, since one procedure's copies answer differently. At
	compile time, in a constant or a `when`, it answers for the build's level.
	The results of `fma` are the same either way.
*/
@(intrinsic)
fma_is_instruction :: proc() -> bool ---;

/**
	`a*b + c` in one instruction, for three `f32` or three `f64` operands, in
	code compiled for a CPU level that has it, where `fma_is_instruction()` is
	true; elsewhere it traps. Evaluated at compile time from the exact result.
*/
@(intrinsic)
@(private)
fma_instruction :: proc(a: $T, b: T, c: T) -> T ---;

// One finite operand of `fused_multiply_add`: `significand * 2^exponent`.
@(private)
Fused_Operand :: struct {
	negative:    bool,
	significand: u128,
	exponent:    int,
}

// The encoding of a finite `a*b + c` in a binary format of `precision`
// significand bits and maximum exponent `max_exponent`, given the encodings of
// its finite operands, `a` and `b` non-zero. The product is exact in `u128`;
// both terms are aligned with their top bit at bit 125, which leaves room for
// a carry, and a term shifted right keeps a sticky bit for whatever it lost.
@(private)
fused_multiply_add :: proc(a: u64, b: u64, c: u64, precision: int, max_exponent: int) -> u64 {
	x := fused_operand(a, precision, max_exponent);
	y := fused_operand(b, precision, max_exponent);
	z := fused_operand(c, precision, max_exponent);

	// Below 2^106, so the product cannot overflow; `*%` keeps the 128-bit
	// multiply free of an overflow check.
	product := Fused_Operand{
		negative    = x.negative != y.negative,
		significand = x.significand *% y.significand,
		exponent    = x.exponent + y.exponent,
	};
	high := fused_align(product);
	sum := high.significand;
	if (z.significand != 0) {
		low := fused_align(z);
		// Make `high` the larger term.
		if (low.exponent > high.exponent || (low.exponent == high.exponent && low.significand > high.significand)) {
			high, low = low, high;
		}
		// A shift of at most 20 loses nothing: the terms' low 20 bits are
		// zero. A longer one leaves the larger term's top bit, and the sum's,
		// far above the sticky bit.
		shift := high.exponent - low.exponent;
		aligned := low.significand >> shift;
		if (aligned << shift != low.significand) { aligned |= 1; }
		if (high.negative == low.negative) {
			sum = high.significand + aligned;
		} else {
			sum = high.significand - aligned;
		}
	}
	if (sum == 0) {
		// Exact cancellation, which round-to-nearest makes `+0`.
		return 0;
	}

	// Normalize the sum to bit 127 and round at the bit worth the result's
	// unit in the last place: the format's precision for a normal result, or
	// the smallest subnormal's for a smaller one.
	top := leading_zeros(sum);
	sum <<= top;
	exponent := high.exponent - top;
	min_exponent := 1 - max_exponent;
	unit := 128 - precision;
	subnormal_unit := min_exponent - precision + 1 - exponent;
	if (subnormal_unit > unit) { unit = subnormal_unit; }
	// The exponent field holds `2*max_exponent + 1` at most, so the sign bit
	// is the next one up.
	sign := u64(0);
	if (high.negative) { sign = u64(2*max_exponent + 2) << (precision - 1); }
	if (unit > 128) {
		// Below half the smallest subnormal.
		return sign;
	}
	significand := sum >> unit;
	remainder := sum - (significand << unit);
	half := u128(1) << (unit - 1);
	if (remainder > half || (remainder == half && (significand & 1) == 1)) {
		significand += 1;
	}

	if (unit > 128 - precision) {
		// A subnormal encodes its significand as it is, and one that rounds up
		// to the smallest normal carries into the exponent field by itself.
		return sign | u64(significand);
	}
	result_exponent := 127 + exponent;
	if (significand >> precision != 0) {
		significand >>= 1;
		result_exponent += 1;
	}
	if (result_exponent > max_exponent) {
		return sign | (u64(2*max_exponent + 1) << (precision - 1));
	}
	// The significand's leading bit adds one to the biased exponent below it.
	return sign | ((u64(result_exponent + max_exponent - 1) << (precision - 1)) + u64(significand));
}

// The operand an encoding holds, a subnormal one included.
@(private)
fused_operand :: proc(bits: u64, precision: int, max_exponent: int) -> Fused_Operand {
	fraction_bits := precision - 1;
	field := bits >> fraction_bits;
	biased := int(field & u64(2*max_exponent + 1));
	fraction := u128(bits & ((u64(1) << fraction_bits) - 1));
	if (biased == 0) {
		return {negative = field > u64(2*max_exponent + 1), significand = fraction,
			exponent = 2 - max_exponent - precision};
	}
	return {negative = field > u64(2*max_exponent + 1),
		significand = fraction | (u128(1) << fraction_bits),
		exponent = biased - max_exponent - fraction_bits};
}

// A non-zero term shifted so that its top bit is bit 125.
@(private)
fused_align :: proc(term: Fused_Operand) -> Fused_Operand {
	shift := leading_zeros(term.significand) - 2;
	return {negative = term.negative, significand = term.significand << shift,
		exponent = term.exponent - shift};
}

/**
	`base` raised to `exponent`, following the IEC 60559 special-case table:

	  pow(x, +-0)                          -> 1, for every x including NaN
	  pow(1, y)                            -> 1, for every y including NaN
	  pow(x, 1)                            -> x
	  pow(NaN, y != 0)                     -> NaN
	  pow(x < 0, y non-integral)           -> NaN
	  pow(+-0, y < 0 odd integer)          -> +-infinity
	  pow(+-0, y < 0 otherwise)            -> +infinity
	  pow(+-0, y > 0 odd integer)          -> +-0
	  pow(+-0, y > 0 otherwise)            -> +0
	  pow(-1, +-infinity)                  -> 1
	  pow(abs(x) < 1, -infinity)           -> +infinity
	  pow(abs(x) < 1, +infinity)           -> +0
	  pow(abs(x) > 1, -infinity)           -> +0
	  pow(abs(x) > 1, +infinity)           -> +infinity
	  pow(-infinity, y)                    -> pow(-0, -y)
	  pow(+infinity, y < 0)                -> +0
	  pow(+infinity, y > 0)                -> +infinity

	Not deterministic: see the package documentation.
*/
pow :: proc(base: f64, exponent: f64) -> f64 { return rt_pow_f64(base, exponent); }
pow_f32 :: proc(base: f32, exponent: f32) -> f32 { return rt_pow_f32(base, exponent); }

/**
	`e` raised to `x`. Overflow gives `+infinity` and underflow `+0`.
	Not deterministic: see the package documentation.
*/
exp :: proc(x: f64) -> f64 { return rt_exp_f64(x); }
exp_f32 :: proc(x: f32) -> f32 { return rt_exp_f32(x); }

/**
	The natural logarithm, and the two other bases. All three share the poles:

	  x < 0           -> NaN
	  +-0             -> -infinity
	  +infinity       -> +infinity

	Not deterministic: see the package documentation.
*/
log :: proc(x: f64) -> f64 { return rt_log_f64(x); }
log_f32 :: proc(x: f32) -> f32 { return rt_log_f32(x); }

/// Not deterministic: see the package documentation.
log2 :: proc(x: f64) -> f64 { return rt_log2_f64(x); }
log2_f32 :: proc(x: f32) -> f32 { return rt_log2_f32(x); }

/// Not deterministic: see the package documentation.
log10 :: proc(x: f64) -> f64 { return rt_log10_f64(x); }
log10_f32 :: proc(x: f32) -> f32 { return rt_log10_f32(x); }

// ---------------------------------------------------------- trigonometry --
//
// Angles are radians. An infinite argument to `sin`, `cos` or `tan` is a NaN:
// there is no answer to give.

/// Not deterministic: see the package documentation.
sin :: proc(x: f64) -> f64 { return rt_sin_f64(x); }
sin_f32 :: proc(x: f32) -> f32 { return rt_sin_f32(x); }

/// Not deterministic: see the package documentation.
cos :: proc(x: f64) -> f64 { return rt_cos_f64(x); }
cos_f32 :: proc(x: f32) -> f32 { return rt_cos_f32(x); }

/// Not deterministic: see the package documentation.
tan :: proc(x: f64) -> f64 { return rt_tan_f64(x); }
tan_f32 :: proc(x: f32) -> f32 { return rt_tan_f32(x); }

/**
	The inverse sine, in `[-PI/2, PI/2]`. Outside `[-1, 1]` the result is a NaN.
	Not deterministic: see the package documentation.
*/
asin :: proc(x: f64) -> f64 { return rt_asin_f64(x); }
asin_f32 :: proc(x: f32) -> f32 { return rt_asin_f32(x); }

/**
	The inverse cosine, in `[0, PI]`. Outside `[-1, 1]` the result is a NaN.
	Not deterministic: see the package documentation.
*/
acos :: proc(x: f64) -> f64 { return rt_acos_f64(x); }
acos_f32 :: proc(x: f32) -> f32 { return rt_acos_f32(x); }

/**
	The inverse tangent of one operand, in `[-PI/2, PI/2]`.
	Not deterministic: see the package documentation.
*/
atan :: proc(x: f64) -> f64 { return rt_atan_f64(x); }
atan_f32 :: proc(x: f32) -> f32 { return rt_atan_f32(x); }

/**
	The inverse tangent of `y/x`, using the signs of both to place the result in
	the correct quadrant, in `[-PI, PI]`. The signed-zero and infinity cases are
	the ones IEC 60559 defines, so `atan2(+0, -0)` is `+PI` and `atan2(-0, +0)`
	is `-0`.
	Not deterministic: see the package documentation.
*/
atan2 :: proc(y: f64, x: f64) -> f64 { return rt_atan2_f64(y, x); }
atan2_f32 :: proc(y: f32, x: f32) -> f32 { return rt_atan2_f32(y, x); }

/// Degrees to radians and back.
// One multiply each, and the two conversions every caller otherwise open-codes
// with a constant that is a digit short.
to_radians :: proc(degrees: f64) -> f64 { return degrees*(PI/180.0); }
to_radians_f32 :: proc(degrees: f32) -> f32 { return degrees*f32(PI/180.0); }

to_degrees :: proc(radians: f64) -> f64 { return radians*(180.0/PI); }
to_degrees_f32 :: proc(radians: f32) -> f32 { return radians*f32(180.0/PI); }
