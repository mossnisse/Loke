	`a - d`, `b - d`, and `c - d`.

	Exact for `f32` over its whole finite range, for `f64` coordinates whose
	magnitudes are 0 or between `2^-280` and `2^300`, and for integers whose
	products do not overflow; otherwise as for `orient2d`.
*/
orient3d :: proc(a, b, c, d: linalg.Vector3($T)) -> Sign where interfaces.Numeric(T), interfaces.Ordered(T) ---;

/*
	Whether `d` is inside the circle through `a`, `b`, and `c`, given in
	counterclockwise order: `.Positive` inside, `.Negative` outside, and
	`.Zero` on it; the signs swap for clockwise `a`, `b`, `c`. It is the sign
	of the determinant of the rows `(p.x - d.x, p.y - d.y, |p - d|^2)` for `p`
	in `a`, `b`, `c`.

	Exact for `f32` over its whole finite range, for `f64` coordinates whose
	magnitudes are 0 or between `2^-200` and `2^220`, and for integers whose
	products do not overflow; otherwise as for `orient2d`.
*/
incircle :: proc(a, b, c, d: linalg.Vector2($T)) -> Sign where interfaces.Numeric(T), interfaces.Ordered(T) ---;

/*
	Whether `e` is inside the sphere through `a`, `b`, `c`, and `d`, given so
	that `orient3d(a, b, c, d)` is `.Positive`: `.Positive` inside,
	`.Negative` outside, and `.Zero` on it; the signs swap for the other
	orientation. It is the sign of the determinant of the rows
	`(p.x - e.x, p.y - e.y, p.z - e.z, |p - e|^2)` for `p` in `a`, `b`, `c`,
	`d`.

	Exact for `f32` over its whole finite range, for `f64` coordinates whose
	magnitudes are 0 or between `2^-150` and `2^180`, and for integers whose
	products do not overflow; otherwise as for `orient2d`. Its exact path, met
	only near a degenerate configuration, uses about 120 KB of stack.
*/
insphere :: proc(a, b, c, d, e: linalg.Vector3($T)) -> Sign where interfaces.Numeric(T), interfaces.Ordered(T) ---;

// The points `origin + t*direction`; `direction` need not be a unit vector, and `t` is in units of its length.
Ray2 :: struct($T: type) where interfaces.Numeric(T) {
	origin, direction: linalg.Vector2(T),
}

// The points `origin + t*direction`; `direction` need not be a unit vector, and `t` is in units of its length.
Ray3 :: struct($T: type) where interfaces.Numeric(T) {
	origin, direction: linalg.Vector3(T),
}

/*
	Where a ray meets a triangle: at distance `t`, the point
	`barycentric.x*a + barycentric.y*b + barycentric.z*c`, its coordinates
	summing to 1.
*/
Triangle_Hit :: struct($T: type) where interfaces.Numeric(T) {
	t: T,
	barycentric: linalg.Vector3(T),
}

impl Ray2($T) {
	from_origin_direction :: proc(origin, direction: linalg.Vector2(T)) -> Ray2(T) ---;

	// The ray from `from` with direction `to - from`, so `t` from 0 to 1 is the segment between them.
	from_points :: proc(from, to: linalg.Vector2(T)) -> Ray2(T) ---;

	// `origin + direction*t`.
	at :: proc(self, t: T) -> linalg.Vector2(T) ---;

	// `1/direction` per component, infinite for a zero one, which `cast` against many boxes takes.
	inverse_direction :: proc(self) -> linalg.Vector2(T) where linalg.Real(T) ---;
}

impl Ray3($T) {
	from_origin_direction :: proc(origin, direction: linalg.Vector3(T)) -> Ray3(T) ---;

	// The ray from `from` with direction `to - from`, so `t` from 0 to 1 is the segment between them.
	from_points :: proc(from, to: linalg.Vector3(T)) -> Ray3(T) ---;

	// `origin + direction*t`.
	at :: proc(self, t: T) -> linalg.Vector3(T) ---;

	// `1/direction` per component, infinite for a zero one, which `cast` against many boxes takes.
	inverse_direction :: proc(self) -> linalg.Vector3(T) where linalg.Real(T) ---;
}

/*
	The first distance `t` in `[t_min, t_max]` at which the ray meets the
	shape, or `.none`:

	- `cast(ray, box, t_min, t_max)` and `cast(ray, ray.inverse_direction(),
	  box, t_min, t_max)`, for an `Aabb2` or an `Aabb3`, is the slab test. It
	  is conservative: it never misses a box the exact ray meets in the range
	  while the distances it computes are finite and normal, and may report a
	  box the ray passes within a few ulps of. Its `t` is the entry distance
	  as computed, `t_min` for a ray starting inside. A zero direction
	  component, `0` or `-0`, gives an unbounded slab when the origin is
	  between that axis's faces, on one included, and none otherwise, and
	  an empty box is never hit.
	- `cast(ray, circle, ...)` and `cast(ray, sphere, ...)` solve the
	  quadratic, `t_min` for a ray starting inside, in scaled `f64` where
	  an `f32` or `f64` square overflows or underflows. A ray with a zero
	  direction is its origin, met at `t_min` when the origin is inside.
	- `cast(ray, plane, ...)` is `(offset - dot(normal, origin))/dot(normal,
	  direction)`, `.none` for a ray parallel to the plane.
	- `cast(ray, triangle, ...)` returns a `Triangle_Hit`, by the watertight
	  test of Woop, Benthin, and Wald: a ray through an edge or a corner that
	  triangles share hits at least one of them, for small and large
	  triangles too, whose edge functions are computed again in `f64` where
	  they overflow or underflow. A ray in the triangle's plane, or a
	  triangle of no area, gives `.none`.
*/
cast :: proc{
	cast_ray2_box2,
	cast_ray2_box2_inverse,
	cast_ray3_box3,
	cast_ray3_box3_inverse,
	cast_ray2_circle,
	cast_ray3_sphere,
	cast_ray3_plane,
	cast_ray3_triangle3,
};

// Private to the package, but a public declaration names it.
cast_ray2_box2_inverse :: proc(ray: Ray2($T), inverse_direction: linalg.Vector2(T), box: Aabb2(T), t_min, t_max: T) -> Option(T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
cast_ray2_box2 :: proc(ray: Ray2($T), box: Aabb2(T), t_min, t_max: T) -> Option(T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
cast_ray3_box3_inverse :: proc(ray: Ray3($T), inverse_direction: linalg.Vector3(T), box: Aabb3(T), t_min, t_max: T) -> Option(T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
cast_ray3_box3 :: proc(ray: Ray3($T), box: Aabb3(T), t_min, t_max: T) -> Option(T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
cast_ray2_circle :: proc(ray: Ray2($T), circle: Circle(T), t_min, t_max: T) -> Option(T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
cast_ray3_sphere :: proc(ray: Ray3($T), sphere: Sphere(T), t_min, t_max: T) -> Option(T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
cast_ray3_plane :: proc(ray: Ray3($T), plane: Plane(T), t_min, t_max: T) -> Option(T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
cast_ray3_triangle3 :: proc(ray: Ray3($T), triangle: Triangle3(T), t_min, t_max: T) -> Option(Triangle_Hit(T)) where linalg.Real(T) ---;

// The points from `a` to `b`, both ends included.
Segment2 :: struct($T: type) where interfaces.Numeric(T) {
	a, b: linalg.Vector2(T),
}

// The points from `a` to `b`, both ends included.
Segment3 :: struct($T: type) where interfaces.Numeric(T) {
	a, b: linalg.Vector3(T),
}

// The solid triangle with corners `a`, `b`, and `c`, its edges included.
Triangle2 :: struct($T: type) where interfaces.Numeric(T) {
	a, b, c: linalg.Vector2(T),
}

// The solid triangle with corners `a`, `b`, and `c`, its edges included.
Triangle3 :: struct($T: type) where interfaces.Numeric(T) {
	a, b, c: linalg.Vector3(T),
}

/*
	The parameters `s` and `t` of the closest points of two segments,
	`a.at(s)` and `b.at(t)`, each in `[0, 1]` (Ericson, 5.1.9). Where many
	pairs are closest, as for overlapping parallel segments, it is one of
	them. A segment of no length has parameter 0.
*/
closest_points :: proc{closest_points_segment2, closest_points_segment3};

// Private to the package, but a public declaration names it.
closest_points_segment2 :: proc(a, b: Segment2($T)) -> (s: T, t: T) where linalg.Real(T) ---;

// Private to the package, but a public declaration names it.
closest_points_segment3 :: proc(a, b: Segment3($T)) -> (s: T, t: T) where linalg.Real(T) ---;

impl Segment2($T) {
	from_points :: proc(a, b: linalg.Vector2(T)) -> Segment2(T) ---;

	// `a + (b - a)*t`.
	at :: proc(self, t: T) -> linalg.Vector2(T) ---;

	length :: proc(self) -> T where linalg.Real(T) ---;

	bounds :: proc(self) -> Aabb2(T) where interfaces.Ordered(T) ---;

	// The point of the segment nearest `p`.
	closest_point :: proc(self, p: linalg.Vector2(T)) -> linalg.Vector2(T) where linalg.Real(T) ---;

	distance_squared :: proc(self, p: linalg.Vector2(T)) -> T where linalg.Real(T) ---;

	distance :: proc(self, p: linalg.Vector2(T)) -> T where linalg.Real(T) ---;
}

impl Segment3($T) {
	from_points :: proc(a, b: linalg.Vector3(T)) -> Segment3(T) ---;

	// `a + (b - a)*t`.
	at :: proc(self, t: T) -> linalg.Vector3(T) ---;

	length :: proc(self) -> T where linalg.Real(T) ---;

	bounds :: proc(self) -> Aabb3(T) where interfaces.Ordered(T) ---;

	// The point of the segment nearest `p`.
	closest_point :: proc(self, p: linalg.Vector3(T)) -> linalg.Vector3(T) where linalg.Real(T) ---;

	distance_squared :: proc(self, p: linalg.Vector3(T)) -> T where linalg.Real(T) ---;

	distance :: proc(self, p: linalg.Vector3(T)) -> T where linalg.Real(T) ---;
}

impl Triangle2($T) {
	from_points :: proc(a, b, c: linalg.Vector2(T)) -> Triangle2(T) ---;

	/*
		Whether `p` is in the triangle, its edges included, from three exact
		`orient2d` tests, so it is exact for `f32`, `f64`, and integers and
		holds for either winding. A triangle of no area is the segment, or
		the point, its corners span.
	*/
	contains :: proc(self, p: linalg.Vector2(T)) -> bool where interfaces.Ordered(T) ---;

	// Half the absolute cross product of two edges.
	area :: proc(self) -> T where linalg.Real(T) ---;

	bounds :: proc(self) -> Aabb2(T) where interfaces.Ordered(T) ---;

	// The point of the triangle nearest `p`: `p` itself when `contains(p)`, and otherwise a point of an edge.
	closest_point :: proc(self, p: linalg.Vector2(T)) -> linalg.Vector2(T) where linalg.Real(T) ---;

	distance_squared :: proc(self, p: linalg.Vector2(T)) -> T where linalg.Real(T) ---;

	distance :: proc(self, p: linalg.Vector2(T)) -> T where linalg.Real(T) ---;

	/*
		`(u, v, w)` with `p = u a + v b + w c` and `u + v + w = 1`, or `.none`
		for a triangle of no area.
	*/
	barycentric :: proc(self, p: linalg.Vector2(T)) -> Option(linalg.Vector3(T)) where linalg.Real(T) ---;
}

impl Triangle3($T) {
	from_points :: proc(a, b, c: linalg.Vector3(T)) -> Triangle3(T) ---;

	// The unit normal toward the side from which `a`, `b`, `c` appear counterclockwise, or `.none` for no area.
	normal :: proc(self) -> Option(linalg.Vector3(T)) where linalg.Real(T) ---;

	// Half the length of the cross product of two edges.
	area :: proc(self) -> T where linalg.Real(T) ---;

	bounds :: proc(self) -> Aabb3(T) where interfaces.Ordered(T) ---;

	// The point of the triangle nearest `p`.
	closest_point :: proc(self, p: linalg.Vector3(T)) -> linalg.Vector3(T) where linalg.Real(T) ---;

	distance_squared :: proc(self, p: linalg.Vector3(T)) -> T where linalg.Real(T) ---;

	distance :: proc(self, p: linalg.Vector3(T)) -> T where linalg.Real(T) ---;

	/*
		`(u, v, w)` of `p`'s projection onto the triangle's plane, with
		`u + v + w = 1`, or `.none` for a triangle of no area.
	*/
	barycentric :: proc(self, p: linalg.Vector3(T)) -> Option(linalg.Vector3(T)) where linalg.Real(T) ---;
}

// The disc of the points at most `radius` from `center`, its boundary included.
Circle :: struct($T: type) where interfaces.Numeric(T) {
	center: linalg.Vector2(T),
	radius: T,
}

// The ball of the points at most `radius` from `center`, its surface included.
Sphere :: struct($T: type) where interfaces.Numeric(T) {
	center: linalg.Vector3(T),
	radius: T,
}

impl Circle($T) {
	from_center_radius :: proc(center: linalg.Vector2(T), radius: T) -> Circle(T) ---;

	// Whether `p` is in the disc, `|p - center|^2 <= radius^2`, exact for integers and free of overflow and underflow for `f32` and `f64`.
	contains :: proc(self, p: linalg.Vector2(T)) -> bool where interfaces.Ordered(T) ---;

	// The square around the disc.
	bounds :: proc(self) -> Aabb2(T) where interfaces.Ordered(T) ---;

	/*
		The point of the disc nearest `p`: `p` inside it, and otherwise
		`center + (p - center)*(radius/|p - center|)`.
	*/
	closest_point :: proc(self, p: linalg.Vector2(T)) -> linalg.Vector2(T) where linalg.Real(T) ---;

	// The distance from `p` to the disc, `|p - center| - radius`, and 0 inside it.
	distance :: proc(self, p: linalg.Vector2(T)) -> T where linalg.Real(T) ---;
}

impl Sphere($T) {
	from_center_radius :: proc(center: linalg.Vector3(T), radius: T) -> Sphere(T) ---;

	// Whether `p` is in the ball, `|p - center|^2 <= radius^2`, exact for integers and free of overflow and underflow for `f32` and `f64`.
	contains :: proc(self, p: linalg.Vector3(T)) -> bool where interfaces.Ordered(T) ---;

	// The cube around the ball.
	bounds :: proc(self) -> Aabb3(T) where interfaces.Ordered(T) ---;

	/*
		The point of the ball nearest `p`: `p` inside it, and otherwise
		`center + (p - center)*(radius/|p - center|)`.
	*/
	closest_point :: proc(self, p: linalg.Vector3(T)) -> linalg.Vector3(T) where linalg.Real(T) ---;

	// The distance from `p` to the ball, `|p - center| - radius`, and 0 inside it.
	distance :: proc(self, p: linalg.Vector3(T)) -> T where linalg.Real(T) ---;
}

/*
	The box around the transformed box: `transform_box(m, box)` for a 4 x 4
	affine `m` and an `Aabb3`, or a 3 x 3 `m` and an `Aabb2`, the last row
	taken as the identity's, as `transform_point` takes it. Each bound is the
	sum, in `transform_point`'s order, of each element's product with the
	box's minimum or maximum, whichever is smaller (or larger), so it is
	exactly the bound of the box's corners as `transform_point` moves them,
	without forming them, and exact for integers. It bounds the transformed
	box, not the shape inside it. An empty box stays empty.
*/
transform_box :: proc{transform_box2, transform_box3};

// Private to the package, but a public declaration names it.
transform_box3 :: proc(m: linalg.Matrix($T, 4, 4), box: Aabb3(T)) -> Aabb3(T) where interfaces.Ordered(T) ---;

// Private to the package, but a public declaration names it.
transform_box2 :: proc(m: linalg.Matrix($T, 3, 3), box: Aabb2(T)) -> Aabb2(T) where interfaces.Ordered(T) ---;

/*
	The plane `m` moves `plane` to, for a 4 x 4 affine `m`: its normal through
	`m.normal_matrix()`, its offset `offset + dot(normal', translation)`, both
	divided by the new normal's length, so any normal, unit or not, gives a
	unit one. `.none` when `m`'s linear part has no inverse or the new normal
	does not normalize.
*/
transform_plane :: proc(m: linalg.Matrix($T, 4, 4), plane: Plane(T)) -> Option(Plane(T)) where linalg.Real(T) ---;
