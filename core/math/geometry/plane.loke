// standard-library.md "`core:math/geometry`": the points with
// `dot(normal, p) == offset`, the normal a unit vector from every constructor.
@(public)
package geometry;

import "base:interfaces";
import "core:math/linalg";

/**
	The plane of the points `p` with `dot(normal, p) == offset`. Its positive
	side is the one `normal` points to. The constructors give it a unit
	normal, which makes `signed_distance` a distance and `offset` the plane's
	distance from the origin along the normal; a literal is taken as written.
*/
Plane :: struct($T: type) where interfaces.Numeric(T) { normal: linalg.Vector3(T), offset: T }

impl Plane($T) {
	/// The plane with `normal` and `offset` as given, unnormalized.
	from_normal_offset :: proc(normal: linalg.Vector3(T), offset: T) -> Plane(T) { return {normal, offset}; }
	/// The plane through `point` with the direction of `normal`, or `.none` when `normal` does not normalize.
	from_point_normal :: proc(point, normal: linalg.Vector3(T)) -> Option(Plane(T)) where linalg.Real(T) {
		unit := normal.normalize() or_return;
		return .some(Plane(T){unit, unit.dot(point)});
	}
	/**
		The plane through `a`, `b`, and `c`, its normal toward the side from
		which they appear counterclockwise, or `.none` when they are collinear
		or the cross product `(b - a) x (c - a)` does not normalize.
	*/
	from_points :: proc(a, b, c: linalg.Vector3(T)) -> Option(Plane(T)) where linalg.Real(T) {
		unit := (b - a).cross(c - a).normalize() or_return;
		return .some(Plane(T){unit, unit.dot(a)});
	}

	/// `dot(normal, p) - offset`: the distance of `p` from the plane for a unit normal, positive on the normal's side.
	signed_distance :: proc(self, p: linalg.Vector3(T)) -> T { return self.normal.dot(p) - self.offset; }
	/// The point of the plane nearest `p`, `p - normal*signed_distance(p)`, for a unit normal.
	project :: proc(self, p: linalg.Vector3(T)) -> linalg.Vector3(T) {
		return p - self.normal*self.signed_distance(p);
	}
	/// The same plane with the other side positive.
	flip :: proc(self) -> Plane(T) where linalg.Real(T) { return {-self.normal, -self.offset}; }
}

/**
	The one point the three planes share, or `.none` when two of them are
	parallel or the three meet in a line, which is when
	`dot(a.normal, b.normal x c.normal)` is zero, and when the point is not
	finite. It is `(a.offset (b.n x c.n) + b.offset (c.n x a.n) + c.offset
	(a.n x b.n)) / dot(a.n, b.n x c.n)`.
*/
intersection_point :: proc(a, b, c: Plane($T)) -> Option(linalg.Vector3(T)) where linalg.Real(T) {
	bc := b.normal.cross(c.normal);
	denominator := a.normal.dot(bc);
	if (denominator == T(0)) { return .none; }
	p := (bc*a.offset + c.normal.cross(a.normal)*b.offset + a.normal.cross(b.normal)*c.offset)/denominator;
	if (!(p.x.is_finite() && p.y.is_finite() && p.z.is_finite())) { return .none; }
	return .some(p);
}
