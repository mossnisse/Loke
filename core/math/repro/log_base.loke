// deterministic-math-and-targets-plan.md "Reproducible result contract":
// `log2` and `log10` in both widths.
//
// log2 x and log10 x are log x times 1/ln 2 or 1/ln 10, from `log_kernel`'s
// h + l, within 2^-67.9 relative, and the constant as a pair within 2^-106
// of it: h times its high part is exact as a pair (`two_product`), and the
// cross products and their sum round by under 2^-104 of the result, so the
// product is within 2^-67.9 relative, and is returned when it is decided as
// `log`'s is. For an `f32` argument, `log_quick`, within 6 ulps of log x,
// times the high part comes first: within 14 ulps of its own value, so
// narrowing it rounds correctly unless an `f32` midpoint is within 16; then
// the double-`f64` result, within one ulp, decides, and the slow path if
// that does not. The slow path takes `log_fixed`'s log x, within 2^-305
// absolute, times the constant in fixed point.
//
// For a positive rational x, log2 x and log10 x are rational only at x = 2^k
// and x = 10^k: were log10 x = p/q in lowest terms with q > 1, x^q = 10^p
// would make x irrational. There the result is the integer k, which is a
// float in either width, so none is a midpoint, and every approximation here
// that is close enough rounds to k. |log x| is over 2^-54 for every `f64` x
// other than 1, so the slow path is within 2^-248 relative. No published
// search for binary64 log2 or log10 is relied on here; `tests/repro_test.odin`
// checks both paths against an independent oracle. No result is subnormal or
// overflows.
package repro;

import "core:unsafe";

// `log2` or `log10` by `base`, 0 or 1: `log`'s special cases, which give
// the same results here, through `log`, then the general one. Every
// negative argument and every NaN is at or above +Inf's pattern.
log_base :: proc(x: f64, base: int) -> f64 {
	bits := unsafe.transmute(u64, x);
	if (bits == 0 || bits >= 0x7ff0000000000000 || bits == 0x3ff0000000000000) { return log(x); }
	return log_base_f64_of(x, base);
}

log_base_f32 :: proc(x: f32, base: int) -> f32 {
	bits := unsafe.transmute(u32, x);
	if (bits == 0 || bits >= 0x7f800000 || bits == 0x3f800000) { return log_f32(x); }
	return log_base_f32_of(f64(x), base);
}

// log x times the constant of `base`, 0 for 2 and 1 for 10, as h + l, for a
// positive finite x other than 1.
log_base_kernel :: proc(x: f64, base: int) -> (high: f64, low: f64) {
	h, l := log_kernel(x);
	ch := from_bits(LOG_BASE_PAIRS[2*base]);
	cl := from_bits(LOG_BASE_PAIRS[2*base + 1]);
	ph, pl := two_product(h, ch);
	return fast_two_sum(ph, pl + (h*cl + l*ch));
}

log_base_f64_of :: proc(x: f64, base: int) -> f64 {
	h, l := log_base_kernel(x, base);
	decided, y := f64_decided(h, l);
	if (decided) { return y; }
	return unsafe.transmute(f64, log_base_slow(x, base, F64_LAYOUT));
}

log_base_f32_of :: proc(x: f64, base: int) -> f32 {
	quick := log_quick(x)*from_bits(LOG_BASE_PAIRS[2*base]);
	if (F32_FIRST_APPROXIMATION && f32_decided(quick, 16)) { return f32(quick); }

	h, l := log_base_kernel(x, base);
	near := h + l;
	if (f32_decided(near, 1)) { return f32(near); }
	return unsafe.transmute(f32, u32(log_base_slow(x, base, F32_LAYOUT)));
}

// The result correctly rounded to `layout`, as its bit pattern.
log_base_slow :: proc(x: f64, base: int, layout: Float_Layout) -> u64 {
	negative, value := log_fixed(x);
	pattern := fixed_round(fixed_times(value, LOG_BASE_FIXED[base]), 0 - FRACTION_BITS, layout);
	if (negative) { return pattern | (u64(1) << (layout.width - 1)); }
	return pattern;
}

// Generated by `log_base_constants_source` in tests/math_oracle.odin, which
// `tests/repro_test.odin` checks this block against.
// BEGIN GENERATED
LOG_BASE_PAIRS :: [4]u64{0x3ff71547652b82fe, 0x3c7777d0ffda0d24, 0x3fdbcb7b1526e50e, 0x3c695355baaafad3};
LOG_BASE_FIXED :: [2][6]u64{
	{0xbc3887eeaa2ed9ac, 0x164a2cd9a342648f, 0xd6aef551bad2b4b1, 0x7d0ffda0d23a7d11, 0x71547652b82fe177, 0x0000000000000001},
	{0x3aa1277d0a0179f9, 0x1d1f96a27bc7529e, 0x1f71a30122e4d101, 0x9aadd557d699ee19, 0x6f2dec549b9438ca, 0x0000000000000000},
};
