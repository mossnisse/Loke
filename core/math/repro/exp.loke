// deterministic-math-and-targets-plan.md "Reproducible result contract": `exp`
// in both widths.
//
// The fast path writes x = (128m + i) ln 2/128 + r with |r| <= ln 2/256, and
// e^x = 2^m 2^(i/128) e^r, with 2^(i/128) from a table of `f64` pairs and e^r
// from its Taylor series, both in double-`f64` arithmetic. Its result h + l has
// a relative error under 2^-67:
//
// - r = rh + rl is exact to about 2^-114: k ln 2/128 is split into three
//   parts, the first two of 35 bits so k times each is exact for |k| < 2^18,
//   x - k HI is exact (both are multiples of 2^-61 and the difference is under
//   2^-8, and k is 0 below that), and `two_sum` keeps the next subtraction
//   exact.
// - The series stops at r^6/720; the rest is under |r|^7/7! < 2^-72. Its
//   terms past 1 + r sum to under 2^-18 and are evaluated with a relative
//   error under 2.5 ulps, under 2^-69.7 absolute; the r^2 term's cross part
//   rh rl is added, and the others are below 2^-78.
// - Each table pair is within 2^-106 of 2^(i/128). Its product with e^r is
//   th + th rh, exact (`two_product`, `fast_two_sum`), plus terms below
//   2^-17 th, whose products and sums round by under 2^-69.9 and 2^-70.
//
// These sum to under 2^-68.2.
//
// A result is returned when both ends of h + l ± 2^-66 h round alike, twice
// the bound, which also covers rounding l ± the bound itself. Otherwise, and
// for the results that could be subnormal, the slow path recomputes e^x in
// 320-bit fixed point and rounds that. No binary64 argument of exp is known
// to need more than about 2^-120 relative accuracy to round correctly
// (Lefèvre and Muller's exhaustive searches), and the slow path's error is
// under 2^-300, so it rounds every argument correctly; `tests/repro_test.odin`
// checks both paths against an independent oracle.
package repro;

import "core:unsafe";

// 128/ln 2 and 1/ln 2, to choose k; any rounding of them works, since the
// reduction itself uses the split constants.
INV_LN2_128 :: 184.6649652337873;
INV_LN2     :: 1.4426950408889634;

// x + tail = k ln 2/128 + r, and 2^(i/128) e^r as h + l, |l| <= ulp(h)/2,
// for |x| under 746 and |tail| <= ulp(x), where i is k's low seven bits.
// `exp` passes no tail; `pow` passes y log x as a pair, whose tail joins r
// within 2^-97.
exp_kernel :: proc(x: f64, tail: f64) -> (k: int, high: f64, low: f64) {
	kf := (x*INV_LN2_128 + ROUND_SHIFTER) - ROUND_SHIFTER;
	k := int(kf);
	r1 := x - kf*unsafe.transmute(f64, u64(LN2_128_HI));
	rh, rl := two_sum(r1, 0.0 - kf*unsafe.transmute(f64, u64(LN2_128_MID)));
	rl = (rl - kf*unsafe.transmute(f64, u64(LN2_128_LO))) + tail;
	rh, rl = two_sum(rh, rl);

	// e^r - 1 - rh, the cross term of r^2 included.
	q := rl + (rh*rh*(0.5 + rh*(1.0/6.0 + rh*(1.0/24.0 + rh*(1.0/120.0 + rh*(1.0/720.0))))) + rh*rl);

	// T e^r = th + th rh + th q + tl (1 + rh + q): th rh exactly, the others
	// below 2^-17 th and rounded.
	i := k & 127;
	th := unsafe.transmute(f64, EXP_TABLE[2*i]);
	tl := unsafe.transmute(f64, EXP_TABLE[2*i + 1]);
	ph, pl := two_product(th, rh);
	s, e := fast_two_sum(th, ph);
	h, l := fast_two_sum(s, e + (pl + (th*q + (tl + tl*rh))));
	return {k, h, l};
}

exp_f64_of :: proc(x: f64) -> f64 {
	k, h, l := exp_kernel(x, 0.0);
	m := k >> 7;
	decided, y := f64_decided(h, l);
	if (decided && m >= -1021) {
		// Exact scalings: the result is normal, and h + l is in [0.99, 2.01).
		if (m <= 1023) { return y*power_of_two(m); }
		return y*power_of_two(1023)*2.0;
	}
	return unsafe.transmute(f64, exp_slow(x, F64_LAYOUT));
}

// For an `f32` argument, |x| < 104, so the results here, scaled by 2^m, are
// normal `f64` values. A single-`f64` approximation comes first: th (1 + p),
// p the series of e^r - 1 to r^5/120 (the rest under 2^-60), with r from
// two of the three parts of ln 2/128 (the third, times k < 2^15, is under
// 2^-68), is within 1.1 ulps of e^x, tl's omission and the last rounding
// being half an ulp each. Narrowing it rounds e^x correctly unless an `f32`
// midpoint is within 4 ulps, which its low bits show; then the double-`f64`
// result, within one ulp, decides, and the slow path if that does not.
exp_f32_of :: proc(x: f64) -> f32 {
	kf := (x*INV_LN2_128 + ROUND_SHIFTER) - ROUND_SHIFTER;
	k := int(kf);
	r := (x - kf*unsafe.transmute(f64, u64(LN2_128_HI))) - kf*unsafe.transmute(f64, u64(LN2_128_MID));
	p := r*(1.0 + r*(0.5 + r*(1.0/6.0 + r*(1.0/24.0 + r*(1.0/120.0)))));
	th := unsafe.transmute(f64, EXP_TABLE[2*(k & 127)]);
	scale := power_of_two(k >> 7);
	quick := (th + th*p)*scale;
	if (f32_decided(quick, 4)) { return f32(quick); }

	_, h, l := exp_kernel(x, 0.0);
	y := h*scale + l*scale;
	if (f32_decided(y, 1)) { return f32(y); }
	return unsafe.transmute(f32, u32(exp_slow(x, F32_LAYOUT)));
}

// e^x correctly rounded to `layout`, as its bit pattern.
exp_slow :: proc(x: f64, layout: Float_Layout) -> u64 {
	ax := x;
	if (x < 0.0) { ax = 0.0 - x; }
	sum, exponent := exp_fixed(x < 0.0, fixed_of(ax), x);
	return fixed_round(sum, exponent, layout);
}

// e^z as sum 2^exponent, sum in fixed point, for z = ±magnitude, |z| under
// 746, whose nearest `f64` is about `estimate`, of z's sign: z = k ln 2 + r
// with r in [ln 2/2, 3 ln 2/2], e^r = (e^(r/256))^256, and e^(r/256) from
// its Taylor series. Each operation truncates, by under 2^-320; the 256th
// power multiplies the relative error by 256, which leaves it under 2^-300.
exp_fixed :: proc(negative: bool, magnitude: Fixed, estimate: f64) -> (sum: Fixed, exponent: int) {
	k := int((estimate*INV_LN2 + ROUND_SHIFTER) - ROUND_SHIFTER) - 1;
	multiple := fixed_times_small(LN2_FIXED, u64(abs_int(k)));
	r: Fixed = {};
	if (negative) {
		r = fixed_minus(multiple, magnitude);
	} else if (k < 0) {
		r = fixed_plus(magnitude, multiple);
	} else {
		r = fixed_minus(magnitude, multiple);
	}
	small := fixed_shift_down(r, 8);
	sum := FIXED_ONE;
	term := FIXED_ONE;
	for (n: u64 = 1; ; n += 1) {
		term = fixed_divided_small(fixed_times(term, small), n);
		if (fixed_is_zero(term)) { break; }
		sum = fixed_plus(sum, term);
	}
	foreach (_ in 0 ..< 8) { sum = fixed_times(sum, sum); }
	return {sum, k - FRACTION_BITS};
}

