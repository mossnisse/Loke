// deterministic-math-and-targets-plan.md "Reproducible result contract": `sin`
// and `cos` in both widths.
//
// |x| = q pi/2 + r, |r| at most a little over pi/4, and sin or cos of |r| by
// q's low two bits. The reduction gives r as an `f64` pair within 2^-130 of
// it, which is relative 2^-68 even for the r nearest zero any `f64` gives,
// about 2^-61 (Kahan and McDonald):
//
// - Below pi/4, r is the argument.
// - Below 2^20 pi/2, Cody and Waite's: pi/2 in four parts, the first three of
//   33 bits so q times each is exact for q < 2^20. |x| - q P1 is exact (both
//   are multiples of 2^-53 and the difference is under 1), `two_sum` keeps the
//   next two subtractions exact, and the fourth part is within 2^-152 of the
//   rest of pi/2, its product rounded by under 2^-132.
// - Above, Payne and Hanek's: x 2/pi modulo 4 from 448 bits of 2/pi at x's
//   scale, in integers, which leaves q and a 320-bit fraction exact to
//   2^-390. Its top 106 bits times pi/2 as an `f64` pair give r.
//
// sin and cos of r come from a table of both at j/256, j the nearest integer
// to 256 |r|, with t = |r| - j/256, |t| <= 2^-9, and their series in t: the
// table entries are within 2^-106, the series are cut off below 2^-75
// relative, and sin t - t and cos t - 1 are below 2^-19 relative to the
// result and evaluated within a few ulps of it, with every leading product
// exact (`two_product`). For j = 0, sin r is its series in r. The relative
// error of h + l stays under 2^-68.
//
// The fast path returns h + l when it is decided within twice 2^-67; the
// slow path recomputes the reduction and the series in 320-bit fixed point
// and rounds that, its error under 2^-300 relative to any result.
package repro;

import "core:unsafe";

// 2/pi, to choose q; any rounding of it works, since the reduction itself
// uses the split constants.
TWO_OVER_PI_F64 :: 0.6366197723675814;
// The `f64` below pi/4, under which the argument is its own reduction.
QUARTER_PI :: 0.7853981633974483;
// Under 2^20 pi/2, so q < 2^20 in Cody and Waite's reduction.
CODY_WAITE_LIMIT :: 1647099.0;

// 64 bits of 2/pi from bit `start`, counted from 1 after the binary point.
two_over_pi_word :: proc(start: int) -> u64 {
	index := start - 1;
	word := index / 64;
	offset := index % 64;
	if (offset == 0) { return TWO_OVER_PI[word]; }
	return (TWO_OVER_PI[word] << offset) | (TWO_OVER_PI[word + 1] >> (64 - offset));
}

// For a finite x above pi/4: x 2/pi modulo 4 as the nearest quadrant q and
// the fraction f, |f| <= 1/2, with f's sign apart and |f| in fixed point.
// For x = m 2^e, the bits of 2/pi before bit e - 1 contribute multiples of 4,
// and the 448 from there on leave an error under 2^(53 - 446) in f.
payne_hanek :: proc(x: f64) -> (quadrant: int, negative: bool, fraction: Fixed) {
	pattern := unsafe.transmute(u64, x);
	e := int(pattern >> 52) - 1075;
	m := (pattern & 0x000fffffffffffff) | 0x0010000000000000;
	first := e - 1;
	if (first < 1) { first = 1; }
	// m times the window W = the 448 bits from `first`, the most significant
	// limb of W holding bits first ..< first + 64.
	product: [8]u64 = {};
	carry: u128 = 0;
	foreach (i in 0 ..< 7) {
		t := u128(two_over_pi_word(first + 384 - 64*i)) *% u128(m) +% carry;
		product[i] = u64(t & LOW_64);
		carry = t >> 64;
	}
	product[7] = u64(carry);
	// x 2/pi = product 2^-point, modulo 4.
	point := first + 447 - e;
	f: Fixed = {};
	foreach (i in 0 ..< 5) { f[i] = product_field(product, point - 320 + 64*i); }
	q := int(product_field(product, point) & 3);
	if ((f[4] >> 63) != 0) {
		return {(q + 1) & 3, true, fixed_minus(FIXED_ONE, f)};
	}
	return {q, false, f};
}

// The 64 bits of p from `position` up.
product_field :: proc(p: [8]u64, position: int) -> u64 {
	word := position / 64;
	offset := position % 64;
	low := p[word] >> offset;
	if (offset == 0 || word == 7) { return low; }
	return low | (p[word + 1] << (64 - offset));
}

// |x| = quadrant pi/2 + (high + low), for a finite x at least 2^-27 in
// magnitude. A quadrant of -1 asks for the slow path, for an r too close to
// zero for the pair, which no `f64` gives.
reduce :: proc(ax: f64) -> (quadrant: int, high: f64, low: f64) {
	if (ax <= QUARTER_PI) { return {0, ax, 0.0}; }
	if (ax < CODY_WAITE_LIMIT) {
		qf := (ax*TWO_OVER_PI_F64 + ROUND_SHIFTER) - ROUND_SHIFTER;
		a := ax - qf*from_bits(PIO2_1);
		rh, rl := two_sum(a, 0.0 - qf*from_bits(PIO2_2));
		rh2, e := two_sum(rh, 0.0 - qf*from_bits(PIO2_3));
		h, l := fast_two_sum(rh2, (rl + e) - qf*from_bits(PIO2_4));
		return {int(qf) & 3, h, l};
	}
	quadrant, negative, fraction := payne_hanek(ax);
	top := fixed_top_bit(fraction);
	if (top < 200) { return {-1, 0.0, 0.0}; }
	fh := f64(fixed_field(fraction, top - 52, 53))*power_of_two(top - 52 - FRACTION_BITS);
	fl := f64(fixed_field(fraction, top - 105, 53))*power_of_two(top - 105 - FRACTION_BITS);
	ph, pl := two_product(fh, from_bits(PIO2_HI));
	h, l := fast_two_sum(ph, pl + (fh*from_bits(PIO2_LO) + fl*from_bits(PIO2_HI)));
	if (negative) { return {quadrant, 0.0 - h, 0.0 - l}; }
	return {quadrant, h, l};
}

// The nearest integer to 256 ah, ties to even, for 0 <= ah < 1, so that
// t = ah - j/256 is exact (Sterbenz) and |t| <= 2^-9. Adding 0.5 and
// truncating would not do: below 2^-9, 256 ah + 0.5 can round up to 1.
table_index :: proc(ah: f64) -> int {
	return int((ah*256.0 + ROUND_SHIFTER) - ROUND_SHIFTER);
}

// sin(a) for a = ah + al, 0 <= ah <= pi/4 + 2^-40, as h + l.
sin_kernel :: proc(ah: f64, al: f64) -> (high: f64, low: f64) {
	j := table_index(ah);
	th := ah - f64(j)*(1.0/256.0);
	t2 := th*th;
	// sin t - t without the cross terms of al, which are below 2^-70.
	s1 := th*t2*(-1.0/6.0 + t2*(1.0/120.0 + t2*(-1.0/5040.0)));
	if (j == 0) { return fast_two_sum(th, al + s1); }
	// cos t - 1, with t^2's cross term.
	c1 := t2*(-0.5 + t2*(1.0/24.0 + t2*(-1.0/720.0))) - th*al;
	sa := from_bits(SIN_COS_TABLE[4*j]);
	sal := from_bits(SIN_COS_TABLE[4*j + 1]);
	ca := from_bits(SIN_COS_TABLE[4*j + 2]);
	cal := from_bits(SIN_COS_TABLE[4*j + 3]);
	// sa cos t + ca sin t = sa + ca th, exactly, and the rest.
	ph, pl := two_product(ca, th);
	s, e := fast_two_sum(sa, ph);
	return fast_two_sum(s, e + (pl + (sal + ((ca*al + cal*th) + (sa*c1 + ca*s1)))));
}

// cos(a) for a = ah + al, 0 <= ah <= pi/4 + 2^-40, as h + l.
cos_kernel :: proc(ah: f64, al: f64) -> (high: f64, low: f64) {
	j := table_index(ah);
	th := ah - f64(j)*(1.0/256.0);
	t2 := th*th;
	c1 := t2*(-0.5 + t2*(1.0/24.0 + t2*(-1.0/720.0))) - th*al;
	if (j == 0) { return fast_two_sum(1.0, c1); }
	s1 := th*t2*(-1.0/6.0 + t2*(1.0/120.0 + t2*(-1.0/5040.0)));
	sa := from_bits(SIN_COS_TABLE[4*j]);
	sal := from_bits(SIN_COS_TABLE[4*j + 1]);
	ca := from_bits(SIN_COS_TABLE[4*j + 2]);
	cal := from_bits(SIN_COS_TABLE[4*j + 3]);
	// ca cos t - sa sin t = ca - sa th, exactly, and the rest.
	ph, pl := two_product(sa, th);
	s, e := fast_two_sum(ca, 0.0 - ph);
	return fast_two_sum(s, e + ((cal - pl) + ((ca*c1 - sa*s1) - (sa*al + sal*th))));
}

// Whether the result for this quadrant and sign of r is negative, given
// whether it is sin r's magnitude or cos r's, before x's own sign.
trig_negative :: proc(want_cos: bool, quadrant: int, use_sin: bool, r_negative: bool) -> bool {
	negative := quadrant >= 2;
	if (want_cos) { negative = quadrant == 1 || quadrant == 2; }
	if (use_sin && r_negative) { negative = !negative; }
	return negative;
}

// The result's magnitude for |x| as h + l, and whether it is negative, or
// a quadrant of -1 for the slow path.
trig_kernel :: proc(ax: f64, want_cos: bool) -> (decidable: bool, negative: bool, high: f64, low: f64) {
	quadrant, rh, rl := reduce(ax);
	if (quadrant < 0) { return {false, false, 0.0, 0.0}; }
	r_negative := rh < 0.0;
	if (r_negative) {
		rh = 0.0 - rh;
		rl = 0.0 - rl;
	}
	use_sin := (quadrant % 2 == 0) != want_cos;
	h := 0.0;
	l := 0.0;
	if (use_sin) {
		h, l = sin_kernel(rh, rl);
	} else {
		h, l = cos_kernel(rh, rl);
	}
	return {true, trig_negative(want_cos, quadrant, use_sin, r_negative), h, l};
}

// sin or cos of a finite x at least 2^-27 in magnitude.
trig_f64 :: proc(x: f64, want_cos: bool) -> f64 {
	ax := x;
	if (x < 0.0) { ax = 0.0 - x; }
	flip := !want_cos && x < 0.0;
	decidable, negative, h, l := trig_kernel(ax, want_cos);
	if (decidable) {
		decided, y := f64_decided(h, l);
		if (decided) {
			if (negative != flip) { return 0.0 - y; }
			return y;
		}
	}
	return unsafe.transmute(f64, trig_slow(ax, want_cos, flip, F64_LAYOUT));
}

// The same for an `f32` argument: h + l, within an `f64` ulp of the result,
// narrows to it unless an `f32` midpoint is that close. No result here is
// subnormal.
trig_f32 :: proc(x: f64, want_cos: bool) -> f32 {
	ax := x;
	if (x < 0.0) { ax = 0.0 - x; }
	flip := !want_cos && x < 0.0;
	decidable, negative, h, l := trig_kernel(ax, want_cos);
	if (decidable) {
		y := h + l;
		if (f32_decided(y, 1)) {
			if (negative != flip) { return f32(0.0 - y); }
			return f32(y);
		}
	}
	return unsafe.transmute(f32, u32(trig_slow(ax, want_cos, flip, F32_LAYOUT)));
}

// sin or cos of |x| correctly rounded to `layout`, as its bit pattern, negated
// when `flip`: the reduction in fixed point, r = f pi/2 for the fraction
// Payne and Hanek's leaves, and the series in r, alternating and decreasing
// from its first term, so every partial sum stays positive.
trig_slow :: proc(ax: f64, want_cos: bool, flip: bool, layout: Float_Layout) -> u64 {
	quadrant, r_negative, r := reduce_fixed(ax);
	use_sin := (quadrant % 2 == 0) != want_cos;
	sum := trig_series(r, fixed_times(r, r), use_sin);
	pattern := fixed_round(sum, 0 - FRACTION_BITS, layout);
	if (trig_negative(want_cos, quadrant, use_sin, r_negative) != flip) {
		pattern |= u64(1) << (layout.width - 1);
	}
	return pattern;
}

// |x| = quadrant pi/2 + r in fixed point, |r| as a fraction and its sign
// apart.
reduce_fixed :: proc(ax: f64) -> (quadrant: int, negative: bool, r: Fixed) {
	if (ax > QUARTER_PI) {
		q, negative, fraction := payne_hanek(ax);
		return {q, negative, fixed_times(fraction, PIO2_WIDE)};
	}
	return {0, false, fixed_of(ax)};
}

// sin r or cos r for r^2 = r2 in fixed point: the series, alternating and
// decreasing from its first term, so every partial sum stays positive.
trig_series :: proc(r: Fixed, r2: Fixed, use_sin: bool) -> Fixed {
	sum := FIXED_ONE;
	a: u64 = 1;
	if (use_sin) {
		sum = r;
		a = 2;
	}
	term := sum;
	subtract := true;
	for (;; a += 2) {
		term = fixed_divided_small(fixed_times(term, r2), a*(a + 1));
		if (fixed_is_zero(term)) { break; }
		if (subtract) {
			sum = fixed_minus(sum, term);
		} else {
			sum = fixed_plus(sum, term);
		}
		subtract = !subtract;
	}
	return sum;
}

