// deterministic-math-and-targets-plan.md "Reproducible result contract": `log`
// in both widths.
//
// The fast path writes x = 2^e y, y in [1, 2), takes i, the nearest integer
// to 128 (y - 1), and from a table d near 1/y and L = -log d, with
// log x = E ln 2 + L + log(1 + r), r = y d - 1, |r| <= 2^-8. From i = 53 on,
// y is above about sqrt 2, and the table's L is -log 2d with E = e + 1, so
// E ln 2 + L is never near zero unless both are zero: d is exactly 1 at
// i = 0 and 1/2 at i = 128, the two buckets either side of x = 1, where
// log x is log(1 + r) alone. Elsewhere |log x| is over 2^-9, and over 1/3
// when E is not zero. Its result h + l has a relative error under 2^-67:
//
// - r = rh + rl exactly: d has 29 bits, y d is exact as `two_product`'s
//   pair, its high part minus 1 is exact (Sterbenz), and `two_sum` adds the
//   low part exactly.
// - log(1 + r) is r - r^2/2 + c, c the series from r^3/3 to r^9/9, the rest
//   under |r|^9/10 < 2^-75 relative to r. rh^2 is exact (`two_product`),
//   halving it is exact, and rh - rh^2/2 is exact as a pair; the parts of r^2
//   and r^3 with rl that matter, -rh rl and rh^2 rl, are added, and those
//   left out are below 2^-77 relative. c is under 2^-17.5 relative to r and
//   evaluated within 6.02 ulps of itself, under 2^-67.99 of r: three for
//   rh^3, and three for its cofactor, by Estrin's scheme, from four roundings
//   of values near 1/3, each under 2^-55. |r| is at most |log x| where the
//   table's part is not zero.
// - E ln 2 is E times a 42-bit part, exactly for |E| <= 1075, plus E times
//   the rest, both within 2^-85 absolute; each L is within 2^-106 of itself;
//   and every sum is exact as a pair (`two_sum`) but for the low parts, which
//   are under 2^-50 of the result and round by under 2^-103.
//
// These sum to under 2^-67.9. A result is returned when both ends of h + l
// ± 2^-66 h round alike. Otherwise the slow path recomputes log x in 320-bit
// fixed point as E ln 2 + 2 atanh((y' - 1)/(y' + 1)), y' = y or y/2 as E
// above, and rounds that; its error is under 2^-300 absolute, and |log x|
// is over 2^-54 for every `f64` x other than 1. No binary64 argument of log
// is known to need more than about 2^-120 relative accuracy to round
// correctly (Lefèvre and Muller's exhaustive searches), so it rounds every
// argument correctly; `tests/repro_test.odin` checks both paths against an
// independent oracle. No result is subnormal or overflows.
package repro;

import "core:unsafe";

// The table's index, its multiplier, and the exponent with log x =
// E ln 2 + L + log(y d), for a positive normal x with fraction bits
// `fraction` and unbiased exponent e.
log_bucket :: proc(fraction: u64, e: int) -> (i: int, big_e: int) {
	i := int((fraction + (u64(1) << 44)) >> 45);
	if (i >= 53) { return {i, e + 1}; }
	return {i, e};
}

// x's unbiased exponent and fraction bits, for a positive finite x,
// normalizing a subnormal one.
log_split :: proc(x: f64) -> (e: int, fraction: u64) {
	pattern := unsafe.transmute(u64, x);
	if (pattern >> 52 == 0) {
		// Exact: x 2^54 is normal.
		normal := unsafe.transmute(u64, x*18014398509481984.0);
		return {int(normal >> 52) - 1077, normal & 0x000fffffffffffff};
	}
	return {int(pattern >> 52) - 1023, pattern & 0x000fffffffffffff};
}

// log x as h + l, |l| <= ulp(h)/2, for a positive finite x other than 1.
log_kernel :: proc(x: f64) -> (high: f64, low: f64) {
	e, fraction := log_split(x);
	i, big_e := log_bucket(fraction, e);
	y := unsafe.transmute(f64, fraction | 0x3ff0000000000000);
	d := unsafe.transmute(f64, LOG_TABLE[3*i]);
	ph, pl := two_product(y, d);
	rh, rl := two_sum(ph - 1.0, pl);

	// log(1 + r) = (rh - rh^2/2) + the rest.
	sh, sl := two_product(rh, rh);
	t1, t2 := two_sum(rh, 0.0 - 0.5*sh);
	// c = rh^3 Q, Q by Estrin's scheme, so that c does not wait on a chain
	// of seven products and sums, most of this kernel's latency.
	s4 := sh*sh;
	q := ((1.0/3.0 - rh*0.25) + sh*(0.2 - rh*(1.0/6.0))) + s4*((1.0/7.0 - rh*0.125) + sh*(1.0/9.0));
	c := sh*rh*q;
	tail := t2 + ((rl - 0.5*sl) + (c + (sh*rl - rh*rl)));

	ef := f64(big_e);
	s1, e1 := two_sum(ef*unsafe.transmute(f64, u64(LN2_HI)), unsafe.transmute(f64, LOG_TABLE[3*i + 1]));
	s2, e2 := two_sum(s1, t1);
	rest := (e1 + e2) + (tail + (unsafe.transmute(f64, LOG_TABLE[3*i + 2]) + ef*unsafe.transmute(f64, u64(LN2_LO))));
	h, l := fast_two_sum(s2, rest);
	return {h, l};
}

log_f64_of :: proc(x: f64) -> f64 {
	h, l := log_kernel(x);
	decided, y := f64_decided(h, l);
	if (decided) { return y; }
	return unsafe.transmute(f64, log_slow(x, F64_LAYOUT));
}

// For an `f32` argument, a positive normal `f64` other than 1, y has 24
// bits, so r = y d - 1 is exact in one `f64`, and |E| <= 150. A single-`f64`
// approximation comes first: E ln 2's two parts and L's pair, with log(1 + r)
// as its series to r^7/7, the rest under 2^-59 relative, is within 6 ulps of
// log x, and within 12 ulps of its own value if that is in the binade below.
// Narrowing it rounds log x correctly unless an `f32` midpoint is within 16
// ulps, which its low bits show; then the double-`f64` result, within one
// ulp, decides, and the slow path if that does not.
log_f32_of :: proc(x: f64) -> f32 {
	quick := log_quick(x);
	if (F32_FIRST_APPROXIMATION && f32_decided(quick, 16)) { return f32(quick); }

	h, l := log_kernel(x);
	near := h + l;
	if (f32_decided(near, 1)) { return f32(near); }
	return unsafe.transmute(f32, u32(log_slow(x, F32_LAYOUT)));
}

// The single-`f64` approximation `log_f32_of` describes, for an `f32` x.
log_quick :: proc(x: f64) -> f64 {
	e, fraction := log_split(x);
	i, big_e := log_bucket(fraction, e);
	y := unsafe.transmute(f64, fraction | 0x3ff0000000000000);
	r := y*unsafe.transmute(f64, LOG_TABLE[3*i]) - 1.0;
	p := r - r*r*(0.5 - r*(1.0/3.0 - r*(0.25 - r*(0.2 - r*(1.0/6.0 - r*(1.0/7.0))))));
	ef := f64(big_e);
	return (ef*unsafe.transmute(f64, u64(LN2_HI)) + unsafe.transmute(f64, LOG_TABLE[3*i + 1]))
		+ (p + (unsafe.transmute(f64, LOG_TABLE[3*i + 2]) + ef*unsafe.transmute(f64, u64(LN2_LO))));
}

// log x correctly rounded to `layout`, as its bit pattern, for a positive
// finite x other than 1, from fixed-point arithmetic: E ln 2 + 2 atanh z,
// z = |y' - 1|/(y' + 1) < 0.18 and its sign apart, with y' = y, or y/2 when
// E = e + 1, which is in [0.70, 1.42). z is within 2^-318, from the
// reciprocal of y' + 1; each term of the series truncates by under 2^-320,
// and the terms fall by over 5 bits each; E ln 2 is within 1075 2^-320, so
// the error is under 2^-305.
@(cold)
log_slow :: proc(x: f64, layout: Float_Layout) -> u64 {
	negative, value := log_fixed(x);
	pattern := fixed_round(value, 0 - FRACTION_BITS, layout);
	if (negative) { return pattern | (u64(1) << (layout.width - 1)); }
	return pattern;
}

// log_slow's value, log x as its sign and magnitude in fixed point.
log_fixed :: proc(x: f64) -> (negative: bool, value: Fixed) {
	e, fraction := log_split(x);
	_, big_e := log_bucket(fraction, e);
	y := unsafe.transmute(f64, fraction | 0x3ff0000000000000);
	if (big_e != e) { y = 0.5*y; }
	scaled := fixed_of(y);
	below_one := y < 1.0;
	difference: Fixed = {};
	if (below_one) {
		difference = fixed_minus(FIXED_ONE, scaled);
	} else {
		difference = fixed_minus(scaled, FIXED_ONE);
	}
	z := fixed_times(difference, fixed_reciprocal(fixed_plus(scaled, FIXED_ONE), y + 1.0));
	z2 := fixed_times(z, z);
	sum := z;
	power := z;
	for (n: u64 = 3; ; n += 2) {
		power = fixed_times(power, z2);
		term := fixed_divided_small(power, n);
		if (fixed_is_zero(term)) { break; }
		sum = fixed_plus(sum, term);
	}
	part := fixed_plus(sum, sum);

	// |E| ln 2 is at least ln 2, over |log y'|, so a difference of the two
	// takes the sign of E.
	value := part;
	negative := below_one;
	if (big_e != 0) {
		multiple := fixed_times_small(LN2_FIXED, u64(abs_int(big_e)));
		negative = big_e < 0;
		if (negative == below_one) {
			value = fixed_plus(multiple, part);
		} else {
			value = fixed_minus(multiple, part);
		}
	}
	return {negative, value};
}

