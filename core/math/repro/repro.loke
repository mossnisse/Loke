/**
	Correctly rounded elementary functions, with the same bits everywhere.

	Each function returns its exact mathematical result rounded once to the
	result's width, to nearest with ties to even, with gradual underflow and
	overflow to infinity. That result is defined by the arithmetic alone, so it
	is the same on every machine, CPU level, and optimization level, and when a
	call is evaluated at compile time. Special cases, including every NaN
	result, which is the positive quiet NaN with no payload, follow the table on
	each function. No procedure here calls the C library.

	The package holds only what has been implemented and checked: today `exp`,
	`log`, `log2`, `log10`, `pow`, `sin`, `cos`, `tan`, `asin`, `acos`,
	`atan`, `atan2`, and `hypot`, each in both widths. A function missing here
	is not provided by falling back to `core:math`.
*/
@(public)
package repro;

import "core:unsafe";

/**
	e^x. NaN gives NaN, +Inf gives +Inf, -Inf gives +0, and ±0 gives exactly 1;
	a finite result too large for `f64` is +Inf, and one too small is a
	subnormal or +0.
*/
exp :: proc(x: f64) -> f64 {
	bits := unsafe.transmute(u64, x);
	magnitude := bits & 0x7fffffffffffffff;
	// Below 2^-54 in magnitude, e^x is within half an ulp of 1 on either side;
	// this also takes both zeros.
	if (magnitude < 0x3c90000000000000) { return 1.0; }
	if (magnitude >= 0x7ff0000000000000) {
		if (magnitude > 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
		if (bits >> 63 != 0) { return 0.0; }
		return x;
	}
	// e^710 overflows and e^-746 is below half the smallest subnormal.
	if (x > 710.0) { return unsafe.transmute(f64, u64(0x7ff0000000000000)); }
	if (x < -746.0) { return 0.0; }
	return exp_f64_of(x);
}

/**
	e^x for `f32`, with the special cases of `exp`. It is not `exp` narrowed,
	which could round twice.
*/
exp_f32 :: proc(x: f32) -> f32 {
	bits := unsafe.transmute(u32, x);
	magnitude := bits & 0x7fffffff;
	// Below 2^-25 in magnitude, e^x rounds to 1.
	if (magnitude < 0x33000000) { return f32(1.0); }
	if (magnitude >= 0x7f800000) {
		if (magnitude > 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
		if (bits >> 31 != 0) { return f32(0.0); }
		return x;
	}
	// e^89 overflows `f32` and e^-104 is below half its smallest subnormal.
	if (x > f32(89.0)) { return unsafe.transmute(f32, u32(0x7f800000)); }
	if (x < f32(-104.0)) { return f32(0.0); }
	return exp_f32_of(f64(x));
}

/**
	The natural logarithm of x. NaN and every x < 0, -Inf included, give NaN,
	±0 gives -Inf, 1 gives +0, and +Inf gives +Inf.
*/
log :: proc(x: f64) -> f64 {
	bits := unsafe.transmute(u64, x);
	// Every negative argument and every NaN is at or above +Inf's pattern.
	if (bits >= 0x7ff0000000000000) {
		if (bits == 0x7ff0000000000000) { return x; }
		if (bits == 0x8000000000000000) { return unsafe.transmute(f64, u64(0xfff0000000000000)); }
		return unsafe.transmute(f64, u64(CANONICAL_NAN_F64));
	}
	if (bits == 0) { return unsafe.transmute(f64, u64(0xfff0000000000000)); }
	if (bits == 0x3ff0000000000000) { return 0.0; }
	return log_f64_of(x);
}

/// The natural logarithm for `f32`, with the special cases of `log`.
log_f32 :: proc(x: f32) -> f32 {
	bits := unsafe.transmute(u32, x);
	if (bits >= 0x7f800000) {
		if (bits == 0x7f800000) { return x; }
		if (bits == 0x80000000) { return unsafe.transmute(f32, u32(0xff800000)); }
		return unsafe.transmute(f32, u32(CANONICAL_NAN_F32));
	}
	if (bits == 0) { return unsafe.transmute(f32, u32(0xff800000)); }
	if (bits == 0x3f800000) { return f32(0.0); }
	return log_f32_of(f64(x));
}

/**
	The base-2 logarithm, with the special cases of `log`. At a power of two
	the result is its exponent exactly.
*/
log2 :: proc(x: f64) -> f64 { return log_base(x, 0); }

/// The base-2 logarithm for `f32`, with the special cases of `log`.
log2_f32 :: proc(x: f32) -> f32 { return log_base_f32(x, 0); }

/**
	The base-10 logarithm, with the special cases of `log`. At a power of ten
	the result is its exponent exactly.
*/
log10 :: proc(x: f64) -> f64 { return log_base(x, 1); }

/// The base-10 logarithm for `f32`, with the special cases of `log`.
log10_f32 :: proc(x: f32) -> f32 { return log_base_f32(x, 1); }

/**
	x raised to the power y, with the special cases of IEC 60559 and C17's
	annex F but for NaN results, which are the canonical NaN, in this order:
	y = ±0 gives 1, and so does x = +1, NaN included; any other NaN argument
	gives NaN. x = ±0 gives ±Inf for an odd integer y < 0, with x's sign,
	+Inf for any other y < 0, ±0 for an odd integer y > 0, and +0 for any
	other y > 0. x = -1 and y = ±Inf give 1; |x| < 1 gives +Inf for y = -Inf
	and +0 for +Inf, and |x| > 1 the reverse. x = -Inf gives -0 for an odd
	integer y < 0, +0 for any other y < 0, -Inf for an odd integer y > 0,
	and +Inf for any other y > 0; x = +Inf gives +0 for y < 0 and +Inf for
	y > 0. A finite x < 0 gives NaN when y is not an integer, and -|x|^y when
	y is odd. Every exact result is exact, and one exactly halfway between
	two floats rounds to even.
*/
pow :: proc(x: f64, y: f64) -> f64 {
	xb := unsafe.transmute(u64, x);
	yb := unsafe.transmute(u64, y);
	ax := xb & 0x7fffffffffffffff;
	ay := yb & 0x7fffffffffffffff;
	if (ay == 0 || xb == 0x3ff0000000000000) { return 1.0; }
	if (ax > 0x7ff0000000000000 || ay > 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
	kind := integer_kind(y);
	odd_sign := u64(0);
	if (xb >> 63 != 0 && kind == 1) { odd_sign = 0x8000000000000000; }
	if (ax == 0) {
		if (yb >> 63 != 0) { return unsafe.transmute(f64, 0x7ff0000000000000 | odd_sign); }
		return unsafe.transmute(f64, odd_sign);
	}
	if (ay == 0x7ff0000000000000) {
		if (xb == 0xbff0000000000000) { return 1.0; }
		if ((ax < 0x3ff0000000000000) == (yb >> 63 != 0)) { return unsafe.transmute(f64, u64(0x7ff0000000000000)); }
		return 0.0;
	}
	if (ax == 0x7ff0000000000000) {
		if (yb >> 63 != 0) { return unsafe.transmute(f64, odd_sign); }
		return unsafe.transmute(f64, 0x7ff0000000000000 | odd_sign);
	}
	if (xb >> 63 != 0 && kind == 0) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
	magnitude := 1.0;
	if (ax != 0x3ff0000000000000) { magnitude = pow_f64_of(unsafe.transmute(f64, ax), y); }
	return unsafe.transmute(f64, unsafe.transmute(u64, magnitude) | odd_sign);
}

/// x raised to the power y for `f32`, with the special cases of `pow`.
pow_f32 :: proc(x: f32, y: f32) -> f32 {
	xb := unsafe.transmute(u32, x);
	yb := unsafe.transmute(u32, y);
	ax := xb & 0x7fffffff;
	ay := yb & 0x7fffffff;
	if (ay == 0 || xb == 0x3f800000) { return f32(1.0); }
	if (ax > 0x7f800000 || ay > 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
	kind := integer_kind(f64(y));
	odd_sign := u32(0);
	if (xb >> 31 != 0 && kind == 1) { odd_sign = 0x80000000; }
	if (ax == 0) {
		if (yb >> 31 != 0) { return unsafe.transmute(f32, 0x7f800000 | odd_sign); }
		return unsafe.transmute(f32, odd_sign);
	}
	if (ay == 0x7f800000) {
		if (xb == 0xbf800000) { return f32(1.0); }
		if ((ax < 0x3f800000) == (yb >> 31 != 0)) { return unsafe.transmute(f32, u32(0x7f800000)); }
		return f32(0.0);
	}
	if (ax == 0x7f800000) {
		if (yb >> 31 != 0) { return unsafe.transmute(f32, odd_sign); }
		return unsafe.transmute(f32, 0x7f800000 | odd_sign);
	}
	if (xb >> 31 != 0 && kind == 0) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
	magnitude := f32(1.0);
	if (ax != 0x3f800000) { magnitude = pow_f32_of(f64(unsafe.transmute(f32, ax)), f64(y)); }
	return unsafe.transmute(f32, unsafe.transmute(u32, magnitude) | odd_sign);
}

/**
	The sine of x radians. NaN and ±Inf give NaN, and ±0 gives itself; every
	finite argument is reduced exactly, however large.
*/
sin :: proc(x: f64) -> f64 {
	magnitude := unsafe.transmute(u64, x) & 0x7fffffffffffffff;
	// Below 2^-26 in magnitude, sin x is within half an ulp of x.
	if (magnitude < 0x3e50000000000000) { return x; }
	if (magnitude >= 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
	return trig_f64(x, false);
}

/// The sine for `f32`, with the special cases of `sin`.
sin_f32 :: proc(x: f32) -> f32 {
	magnitude := unsafe.transmute(u32, x) & 0x7fffffff;
	// Below 2^-12 in magnitude, sin x is within half an ulp of x.
	if (magnitude < 0x39800000) { return x; }
	if (magnitude >= 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
	return trig_f32(f64(x), false);
}

/**
	The cosine of x radians. NaN and ±Inf give NaN, and ±0 gives exactly 1;
	every finite argument is reduced exactly, however large.
*/
cos :: proc(x: f64) -> f64 {
	magnitude := unsafe.transmute(u64, x) & 0x7fffffffffffffff;
	// Below 2^-27 in magnitude, cos x is within half an ulp of 1.
	if (magnitude < 0x3e40000000000000) { return 1.0; }
	if (magnitude >= 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
	return trig_f64(x, true);
}

/// The cosine for `f32`, with the special cases of `cos`.
cos_f32 :: proc(x: f32) -> f32 {
	magnitude := unsafe.transmute(u32, x) & 0x7fffffff;
	// Below 2^-13 in magnitude, cos x is within half an ulp of 1.
	if (magnitude < 0x39000000) { return f32(1.0); }
	if (magnitude >= 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
	return trig_f32(f64(x), true);
}

/**
	The tangent of x radians. NaN and ±Inf give NaN, and ±0 gives itself;
	every finite argument is reduced exactly, however large.
*/
tan :: proc(x: f64) -> f64 {
	magnitude := unsafe.transmute(u64, x) & 0x7fffffffffffffff;
	// Below 2^-27 in magnitude, tan x is within half an ulp of x.
	if (magnitude < 0x3e40000000000000) { return x; }
	if (magnitude >= 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
	return tan_f64(x);
}

/// The tangent for `f32`, with the special cases of `tan`.
tan_f32 :: proc(x: f32) -> f32 {
	magnitude := unsafe.transmute(u32, x) & 0x7fffffff;
	// Below 2^-12 in magnitude, tan x is within half an ulp of x.
	if (magnitude < 0x39800000) { return x; }
	if (magnitude >= 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
	return tan_f32_of(f64(x));
}

/**
	sqrt(x^2 + y^2), without overflow or underflow on the way. ±Inf in either
	argument gives +Inf, even with a NaN in the other; otherwise NaN gives
	NaN. hypot(x, ±0) is |x|, and a result too large for `f64` is +Inf. An
	exact result is exact, and one exactly halfway between two floats rounds
	to even.
*/
hypot :: proc(x: f64, y: f64) -> f64 {
	xb := unsafe.transmute(u64, x) & 0x7fffffffffffffff;
	yb := unsafe.transmute(u64, y) & 0x7fffffffffffffff;
	if (xb == 0x7ff0000000000000 || yb == 0x7ff0000000000000) { return unsafe.transmute(f64, u64(0x7ff0000000000000)); }
	if (xb > 0x7ff0000000000000 || yb > 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
	a := xb;
	b := yb;
	if (yb > xb) {
		a = yb;
		b = xb;
	}
	if (b == 0) { return unsafe.transmute(f64, a); }
	return hypot_f64_of(unsafe.transmute(f64, a), unsafe.transmute(f64, b));
}

/// hypot for `f32`, with the special cases of `hypot`.
hypot_f32 :: proc(x: f32, y: f32) -> f32 {
	xb := unsafe.transmute(u32, x) & 0x7fffffff;
	yb := unsafe.transmute(u32, y) & 0x7fffffff;
	if (xb == 0x7f800000 || yb == 0x7f800000) { return unsafe.transmute(f32, u32(0x7f800000)); }
	if (xb > 0x7f800000 || yb > 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
	a := xb;
	b := yb;
	if (yb > xb) {
		a = yb;
		b = xb;
	}
	if (b == 0) { return unsafe.transmute(f32, a); }
	return hypot_f32_of(f64(unsafe.transmute(f32, a)), f64(unsafe.transmute(f32, b)));
}

/**
	The inverse sine of x, in radians from -pi/2 to pi/2. NaN, and any x
	outside [-1, 1], ±Inf included, gives NaN; ±0 gives itself, and ±1 gives
	±pi/2, correctly rounded.
*/
asin :: proc(x: f64) -> f64 {
	bits := unsafe.transmute(u64, x);
	magnitude := bits & 0x7fffffffffffffff;
	sign := bits & 0x8000000000000000;
	// Below 2^-27 in magnitude, asin x is within half an ulp of x.
	if (magnitude < 0x3e40000000000000) { return x; }
	if (magnitude >= 0x3ff0000000000000) {
		if (magnitude > 0x3ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
		return unsafe.transmute(f64, QUARTER_TURNS[2] | sign);
	}
	return unsafe.transmute(f64, unsafe.transmute(u64, arc_f64_of(unsafe.transmute(f64, magnitude), false, false)) | sign);
}

/// The inverse sine for `f32`, with the special cases of `asin`.
asin_f32 :: proc(x: f32) -> f32 {
	bits := unsafe.transmute(u32, x);
	magnitude := bits & 0x7fffffff;
	sign := bits & 0x80000000;
	// Below 2^-12 in magnitude, asin x is within half an ulp of x.
	if (magnitude < 0x39800000) { return x; }
	if (magnitude >= 0x3f800000) {
		if (magnitude > 0x3f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
		return unsafe.transmute(f32, u32(QUARTER_TURNS_F32[2]) | sign);
	}
	return unsafe.transmute(f32, unsafe.transmute(u32, arc_f32_of(f64(unsafe.transmute(f32, magnitude)), false, false)) | sign);
}

/**
	The inverse cosine of x, in radians from 0 to pi. NaN, and any x outside
	[-1, 1], ±Inf included, gives NaN; 1 gives +0, -1 gives pi, and ±0 gives
	pi/2, each multiple of pi correctly rounded.
*/
acos :: proc(x: f64) -> f64 {
	bits := unsafe.transmute(u64, x);
	magnitude := bits & 0x7fffffffffffffff;
	if (magnitude >= 0x3ff0000000000000) {
		if (bits == 0x3ff0000000000000) { return 0.0; }
		if (bits == 0xbff0000000000000) { return unsafe.transmute(f64, QUARTER_TURNS[4]); }
		return unsafe.transmute(f64, u64(CANONICAL_NAN_F64));
	}
	// Below 2^-60 in magnitude, acos x = pi/2 - asin x rounds as pi/2 does.
	if (magnitude < 0x3c30000000000000) { return unsafe.transmute(f64, QUARTER_TURNS[2]); }
	return arc_f64_of(unsafe.transmute(f64, magnitude), true, bits >> 63 != 0);
}

/// The inverse cosine for `f32`, with the special cases of `acos`.
acos_f32 :: proc(x: f32) -> f32 {
	bits := unsafe.transmute(u32, x);
	magnitude := bits & 0x7fffffff;
	if (magnitude >= 0x3f800000) {
		if (bits == 0x3f800000) { return f32(0.0); }
		if (bits == 0xbf800000) { return unsafe.transmute(f32, u32(QUARTER_TURNS_F32[4])); }
		return unsafe.transmute(f32, u32(CANONICAL_NAN_F32));
	}
	// Below 2^-60 in magnitude, acos x rounds as pi/2 does.
	if (magnitude < 0x21800000) { return unsafe.transmute(f32, u32(QUARTER_TURNS_F32[2])); }
	return arc_f32_of(f64(unsafe.transmute(f32, magnitude)), true, bits >> 31 != 0);
}

/**
	The inverse tangent of x, in radians from -pi/2 to pi/2: `atan2(x, 1)`,
	whose special cases it shares. NaN gives NaN, ±0 gives itself, and ±Inf
	gives ±pi/2, correctly rounded.
*/
atan :: proc(x: f64) -> f64 {
	bits := unsafe.transmute(u64, x);
	magnitude := bits & 0x7fffffffffffffff;
	sign := bits & 0x8000000000000000;
	// Below 2^-27 in magnitude, atan x is within half an ulp of x.
	if (magnitude < 0x3e40000000000000) { return x; }
	if (magnitude >= 0x7ff0000000000000) {
		if (magnitude > 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
		return unsafe.transmute(f64, QUARTER_TURNS[2] | sign);
	}
	return unsafe.transmute(f64, unsafe.transmute(u64, atan2_f64_of(unsafe.transmute(f64, magnitude), 1.0, false)) | sign);
}

/// The inverse tangent for `f32`, with the special cases of `atan`.
atan_f32 :: proc(x: f32) -> f32 {
	bits := unsafe.transmute(u32, x);
	magnitude := bits & 0x7fffffff;
	sign := bits & 0x80000000;
	// Below 2^-12 in magnitude, atan x is within half an ulp of x.
	if (magnitude < 0x39800000) { return x; }
	if (magnitude >= 0x7f800000) {
		if (magnitude > 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
		return unsafe.transmute(f32, u32(QUARTER_TURNS_F32[2]) | sign);
	}
	return unsafe.transmute(f32, unsafe.transmute(u32, atan2_f32_of(f64(unsafe.transmute(f32, magnitude)), 1.0, false)) | sign);
}

/**
	The angle from the positive x axis to the point (x, y), in radians from
	-pi to pi, with y's sign: the inverse tangent of y/x, in the quadrant of
	(x, y). The special cases are those of IEC 60559 and C17's annex F but
	for NaN results, which are the canonical NaN: NaN gives NaN; y = ±0 gives
	±pi for x = -0 or x < 0 and ±0 for x = +0 or x > 0; any other finite y
	gives ±pi/2 for x = ±0, ±pi for x = -Inf, and ±0 for x = +Inf; and
	y = ±Inf gives ±pi/2 for a finite x, ±3pi/4 for x = -Inf, and ±pi/4 for
	x = +Inf, each multiple of pi correctly rounded. A result too small for
	`f64` is a subnormal or zero of y's sign.
*/
atan2 :: proc(y: f64, x: f64) -> f64 {
	yb := unsafe.transmute(u64, y);
	xb := unsafe.transmute(u64, x);
	ay := yb & 0x7fffffffffffffff;
	ax := xb & 0x7fffffffffffffff;
	if (ay > 0x7ff0000000000000 || ax > 0x7ff0000000000000) { return unsafe.transmute(f64, u64(CANONICAL_NAN_F64)); }
	sign := yb & 0x8000000000000000;
	x_negative := xb >> 63 != 0;
	quarters := atan2_special(ay == 0, ay == 0x7ff0000000000000, ax == 0, ax == 0x7ff0000000000000, x_negative);
	if (quarters >= 0) { return unsafe.transmute(f64, QUARTER_TURNS[quarters] | sign); }
	magnitude := atan2_f64_of(unsafe.transmute(f64, ay), unsafe.transmute(f64, ax), x_negative);
	return unsafe.transmute(f64, unsafe.transmute(u64, magnitude) | sign);
}

/// atan2 for `f32`, with the special cases of `atan2`.
atan2_f32 :: proc(y: f32, x: f32) -> f32 {
	yb := unsafe.transmute(u32, y);
	xb := unsafe.transmute(u32, x);
	ay := yb & 0x7fffffff;
	ax := xb & 0x7fffffff;
	if (ay > 0x7f800000 || ax > 0x7f800000) { return unsafe.transmute(f32, u32(CANONICAL_NAN_F32)); }
	sign := yb & 0x80000000;
	x_negative := xb >> 31 != 0;
	quarters := atan2_special(ay == 0, ay == 0x7f800000, ax == 0, ax == 0x7f800000, x_negative);
	if (quarters >= 0) { return unsafe.transmute(f32, u32(QUARTER_TURNS_F32[quarters]) | sign); }
	magnitude := atan2_f32_of(f64(unsafe.transmute(f32, ay)), f64(unsafe.transmute(f32, ax)), x_negative);
	return unsafe.transmute(f32, unsafe.transmute(u32, magnitude) | sign);
}
