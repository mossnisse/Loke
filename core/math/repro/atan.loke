// deterministic-math-and-targets-plan.md "Reproducible result contract":
// `atan2` and `atan` in both widths, past their tables of special cases.
//
// With n the smaller of |y| and |x| and d the larger, t = n/d is in (0, 1],
// and atan2(y, x) has y's sign and the magnitude atan t when |y| <= |x| and
// x > 0, pi/2 - atan t or pi/2 + atan t when |y| > |x|, as x is positive or
// negative, and pi - atan t otherwise. With a base of pi/2 or pi, the
// result is at least pi/4, so there atan t needs only an absolute bound.
// atan x is atan2(x, 1).
//
// n and d are scaled by one power of two, so that d is in [1, 2). Below
// 2^-101, t is within t^3/3 < 2^-202 t of atan t, closer than a quotient of
// two floats of either width comes to a midpoint without being one, 2^-107 t;
// so atan t rounds as t does, but for a t exactly halfway between two
// floats, which rounds toward zero, being just above atan t. That is done in
// integers, and with a base, the result is the base rounded, which no
// midpoint of either width is within 2^-60 of. Otherwise the fast path takes
// j, the nearest integer to 128 t, c = j/128, and atan t = atan c + atan u,
// u = (t - c)/(1 + t c) = (n - c d)/(d + c n), |u| at most 2^-8 and a hair,
// with atan c from a table of `f64` pairs and atan u from its series. Its
// result h + l has a relative error under 2^-68.2:
//
// - c d and c n are exact as pairs (`two_product`), so n - c d is within
//   2^-105 absolute (`two_sum`) and d + c n within 2^-105 relative; their
//   quotient as a pair, its low part from the exact remainder of the high
//   one's division, is within 2^-104 of u, and 2^-96 of the result.
// - atan u is u - u^3/3 + ... + u^9/9, the rest under 2^-91 |u|. The part
//   past u, with u^3's cross term in u's low part, is under 2^-17.5 |u| and
//   evaluated within 5.1 ulps of itself, under 2^-68.2 |u|, and |u| is at
//   most the result: at j = 1, both are about 2^-8, and from there on, or
//   with a base, the result is the larger. For j = 0, u is t's pair.
// - Each table pair, and pi/2's, is within 2^-106 relative of its value;
//   the high parts are summed exactly as pairs (`two_sum`), and the low
//   parts, under 2^-50 of the result, round by under 2^-102.
//
// A result is returned when both ends of h + l ± 2^-66 h round alike.
// Otherwise the slow path recomputes it in 320-bit fixed point, with an
// error under 2^-305 relative. No result past the tiny ones is subnormal,
// and none is a midpoint: atan of a nonzero rational is not even algebraic,
// and neither is pi/2 or pi plus or minus it, since the tangent of a
// nonzero rational is not (Lindemann and Weierstrass). But as for `pow`, no
// exhaustive search covers two binary64 arguments, so nothing proves that
// no result comes within 2^-305 of a midpoint; `tests/repro_test.odin`
// checks both paths against an independent oracle.
package repro;

import "core:unsafe";

// The correctly rounded k pi/4 for k in 0 ..= 4, in each width: the results
// of the special cases, and of a base that atan t is too small to move.
QUARTER_TURNS :: [5]u64{0, 0x3fe921fb54442d18, 0x3ff921fb54442d18, 0x4002d97c7f3321d2, 0x400921fb54442d18};
QUARTER_TURNS_F32 :: [5]u64{0, 0x3f490fdb, 0x3fc90fdb, 0x4016cbe4, 0x40490fdb};

// The magnitude of atan2's special cases in quarters of pi, or -1 for
// finite nonzero arguments, from whether each is zero or infinite and x's
// sign bit.
atan2_special :: proc(y_zero: bool, y_infinite: bool, x_zero: bool, x_infinite: bool, x_negative: bool) -> int {
	if (y_infinite) {
		if (!x_infinite) { return 2; }
		if (x_negative) { return 3; }
		return 1;
	}
	if (y_zero || x_infinite) {
		if (x_negative) { return 4; }
		return 0;
	}
	if (x_zero) { return 2; }
	return -1;
}

// Which form of atan t the result takes, as `atan2_kernel` numbers them,
// and t as the exponent gap and the fraction bits of n and d, for finite
// nonzero magnitudes ay and ax.
atan2_split :: proc(ay: f64, ax: f64, x_negative: bool) -> (part: int, gap: int, n_fraction: u64, d_fraction: u64) {
	n := ay;
	d := ax;
	part := 0;
	if (ay > ax) {
		n = ax;
		d = ay;
		part = 1;
		if (x_negative) { part = 2; }
	} else if (x_negative) {
		part = 3;
	}
	en, nf := log_split(n);
	ed, df := log_split(d);
	return {part, en - ed, nf, df};
}

// n and d scaled so that d is in [1, 2), for a gap of at least -101; n is
// then at least 2^-101.
atan2_operands :: proc(gap: int, n_fraction: u64, d_fraction: u64) -> (n: f64, d: f64) {
	return {from_bits(n_fraction | 0x3ff0000000000000)*power_of_two(gap), from_bits(d_fraction | 0x3ff0000000000000)};
}

// The magnitude of a result whose t is below 2^-101: the base's quarter
// turns, or for no base, t rounded to `layout` with a tie toward zero, from
// t = (q + rest/md) 2^(gap - 64) for the integer quotient q of the
// significands, md the divisor's.
atan2_tiny :: proc(part: int, gap: int, n_fraction: u64, d_fraction: u64, layout: Float_Layout) -> u64 {
	quarters := 2;
	if (part == 3) { quarters = 4; }
	if (part != 0) {
		if (layout.width == 32) { return QUARTER_TURNS_F32[quarters]; }
		return QUARTER_TURNS[quarters];
	}
	mn := u128(n_fraction | 0x0010000000000000) << 64;
	md := u128(d_fraction | 0x0010000000000000);
	q := mn/md;
	a: Fixed = {u64(q & LOW_64), u64(q >> 64), 0, 0, 0, 0};
	unit, drop := fixed_round_place(a, gap - 64, layout);
	kept := fixed_field(a, drop, layout.precision + 1);
	if (fixed_field(a, drop - 1, 1) == 1 && (mn % md != 0 || fixed_any_below(a, drop - 1))) { kept += 1; }
	return fixed_round_finish(kept, unit, layout);
}

// The base of a part, pi/2 or pi as a pair or 0, and whether atan t is
// subtracted from it.
atan2_base :: proc(part: int) -> (high: f64, low: f64, subtract: bool) {
	if (part == 0) { return {0.0, 0.0, false}; }
	if (part == 3) { return {2.0*from_bits(PIO2_HI), 2.0*from_bits(PIO2_LO), true}; }
	return {from_bits(PIO2_HI), from_bits(PIO2_LO), part == 1};
}

// The index into the table of atan(j/128), the nearest integer to 128 t,
// from t's nearest `f64`.
atan_index :: proc(t: f64) -> int {
	return int((t*128.0 + ROUND_SHIFTER) - ROUND_SHIFTER);
}

// The result's magnitude as h + l, for t = n/d with d in [1, 2) and n in
// [2^-102, d]: part 0 is atan t, 1 is pi/2 - atan t, 2 is pi/2 + atan t,
// and 3 is pi - atan t.
atan2_kernel :: proc(n: f64, d: f64, part: int) -> (high: f64, low: f64) {
	th := n/d;
	j := atan_index(th);
	uh := th;
	ul := 0.0;
	if (j == 0) {
		// n - th d is exact (Sterbenz), and so the remainder (`two_product`).
		ph, pl := two_product(th, d);
		ul = ((n - ph) - pl)/d;
	} else {
		c := f64(j)*(1.0/128.0);
		ch, cl := two_product(c, d);
		s, e := two_sum(n, 0.0 - ch);
		nh, nl := two_sum(s, e - cl);
		qh, ql := two_product(c, n);
		sum, err := fast_two_sum(d, qh);
		dh, dl := fast_two_sum(sum, err + ql);
		uh = nh/dh;
		ph, pl := two_product(uh, dh);
		ul = (((nh - ph) - pl) + (nl - uh*dl))/dh;
	}
	// atan u - uh, the cross term of u^3 included.
	u2 := uh*uh;
	tail := ul + (uh*u2*(-1.0/3.0 + u2*(0.2 + u2*(-1.0/7.0 + u2*(1.0/9.0)))) - u2*ul);
	ah := from_bits(ATAN_TABLE[2*j]);
	al := from_bits(ATAN_TABLE[2*j + 1]);
	bh, bl, subtract := atan2_base(part);
	if (subtract) {
		ah = 0.0 - ah;
		al = 0.0 - al;
		uh = 0.0 - uh;
		tail = 0.0 - tail;
	}
	s1, e1 := two_sum(bh, ah);
	s2, e2 := two_sum(s1, uh);
	return fast_two_sum(s2, (e1 + e2) + (bl + (al + tail)));
}

// atan2's magnitude for finite nonzero magnitudes ay and ax.
atan2_f64_of :: proc(ay: f64, ax: f64, x_negative: bool) -> f64 {
	part, gap, nf, df := atan2_split(ay, ax, x_negative);
	if (gap < -101) { return from_bits(atan2_tiny(part, gap, nf, df, F64_LAYOUT)); }
	n, d := atan2_operands(gap, nf, df);
	h, l := atan2_kernel(n, d, part);
	decided, v := f64_decided(h, l);
	if (decided) { return v; }
	return from_bits(atan2_slow(n, d, part, F64_LAYOUT));
}

// The same for `f32` arguments, here exactly as `f64` values. A
// single-`f64` approximation comes first, within 4 ulps of the result.
// Narrowing it rounds the result correctly unless an `f32` midpoint is
// within 8 ulps, which its low bits show; then the double-`f64` result,
// within one ulp, decides, and the slow path if that does not.
atan2_f32_of :: proc(ay: f64, ax: f64, x_negative: bool) -> f32 {
	part, gap, nf, df := atan2_split(ay, ax, x_negative);
	if (gap < -101) { return unsafe.transmute(f32, u32(atan2_tiny(part, gap, nf, df, F32_LAYOUT))); }
	n, d := atan2_operands(gap, nf, df);
	quick := atan2_quick(n, d, part);
	if (f32_decided(quick, 8)) { return f32(quick); }

	h, l := atan2_kernel(n, d, part);
	near := h + l;
	if (f32_decided(near, 1)) { return f32(near); }
	return unsafe.transmute(f32, u32(atan2_slow(n, d, part, F32_LAYOUT)));
}

// The result's magnitude in single-`f64` arithmetic, for `f32` arguments
// and the operands of `atan2_kernel`. n and d have 24 bits, so with j >= 1,
// n is at least 2^-9, c d, c n, n - c d, and d + c n are exact, and u =
// (n - c d)/(d + c n) rounds once; atan u's series to u^7/7, the rest under
// 2^-67 |u|, rounds once more, as do the three sums with the table pair and
// the base. That is within 4 ulps of the result, and of its own value, |u|
// being at most the result and the table entry at most twice it.
atan2_quick :: proc(n: f64, d: f64, part: int) -> f64 {
	j := atan_index(n/d);
	c := f64(j)*(1.0/128.0);
	u := (n - c*d)/(d + c*n);
	u2 := u*u;
	p := u + u*u2*(-1.0/3.0 + u2*(0.2 + u2*(-1.0/7.0)));
	ah := from_bits(ATAN_TABLE[2*j]);
	al := from_bits(ATAN_TABLE[2*j + 1]);
	bh, bl, subtract := atan2_base(part);
	if (subtract) {
		ah = 0.0 - ah;
		al = 0.0 - al;
		p = 0.0 - p;
	}
	return (bh + ah) + (p + (bl + al));
}

// atan2's magnitude correctly rounded to `layout`, as its bit pattern, for
// n, d, and part as `atan2_kernel` takes them, in fixed point. With J the
// nearest integer to 8 t and c = J/8: for J >= 1, atan t = atan c + atan u,
// u = (n - c d)/(d + c n), |u| <= 1/16 and a hair, atan c from a table, and
// u from the exact numerator and the denominator's reciprocal; for J = 0,
// t < 1/16 and a hair, and atan t is t times its series, t scaled by 2^k
// into [1/2, 2), so that a small t keeps every bit. The series alternate
// and fall by 2^-7.9 a term, each operation truncates by under 2^-320, and
// the reciprocals are within 2^-319, which leaves the result within 2^-305
// relative.
atan2_slow :: proc(n: f64, d: f64, part: int, layout: Float_Layout) -> u64 {
	big_j := int((n/d*8.0 + ROUND_SHIFTER) - ROUND_SHIFTER);
	value: Fixed = {};
	k := 0;
	if (big_j == 0) {
		e, _ := log_split(n);
		k = 0 - e;
		q := fixed_times(fixed_of(n*power_of_two(k)), fixed_reciprocal(fixed_of(d), d));
		value = atan_series(q, fixed_scaled(fixed_times(q, q), 0 - 2*k));
	} else {
		// 8n - J d and 8d + J n over 8, which loses no bit of either.
		scaled_n := fixed_of(n);
		scaled_d := fixed_of(d);
		a := fixed_times_small(scaled_n, 8);
		b := fixed_times_small(scaled_d, u64(big_j));
		below := fixed_less(a, b);
		numerator: Fixed = {};
		if (below) {
			numerator = fixed_shift_down(fixed_minus(b, a), 3);
		} else {
			numerator = fixed_shift_down(fixed_minus(a, b), 3);
		}
		denominator := fixed_shift_down(fixed_plus(fixed_times_small(scaled_d, 8), fixed_times_small(scaled_n, u64(big_j))), 3);
		u := fixed_times(numerator, fixed_reciprocal(denominator, d + f64(big_j)*0.125*n));
		atan_u := atan_series(u, fixed_times(u, u));
		if (below) {
			value = fixed_minus(ATAN_WIDE[big_j], atan_u);
		} else {
			value = fixed_plus(ATAN_WIDE[big_j], atan_u);
		}
	}
	if (part == 0) { return fixed_round(value, 0 - k - FRACTION_BITS, layout); }
	absolute := fixed_scaled(value, 0 - k);
	base := PIO2_WIDE;
	if (part == 3) { base = fixed_plus(PIO2_WIDE, PIO2_WIDE); }
	if (part == 2) { return fixed_round(fixed_plus(base, absolute), 0 - FRACTION_BITS, layout); }
	return fixed_round(fixed_minus(base, absolute), 0 - FRACTION_BITS, layout);
}

// q (1 - s/3 + s^2/5 - ...), atan q for s = q^2, or its multiple by 2^k
// for s = (q 2^-k)^2; s is under 2^-7.9.
atan_series :: proc(q: Fixed, s: Fixed) -> Fixed {
	sum := FIXED_ONE;
	power := FIXED_ONE;
	subtract := true;
	for (n: u64 = 3; ; n += 2) {
		power = fixed_times(power, s);
		term := fixed_divided_small(power, n);
		if (fixed_is_zero(term)) { break; }
		if (subtract) {
			sum = fixed_minus(sum, term);
		} else {
			sum = fixed_plus(sum, term);
		}
		subtract = !subtract;
	}
	return fixed_times(q, sum);
}

