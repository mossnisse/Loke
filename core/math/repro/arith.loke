// The double-`f64` arithmetic and the rounding decisions every function here
// shares.
//
// The one operation a CPU level changes is `two_product`'s error, a b - p for
// p = a b rounded: the FMA instruction's where `math.fma_is_instruction()`,
// and Dekker's product elsewhere, never `math.fma`'s integer arithmetic,
// which is slower than Dekker's (deterministic-math-and-targets-plan.md "CPU
// targets and FMA"). Both are exact for every call here, so every level
// computes the same bits. The error is a multiple of the operands' units
// times each other, 2^(ea - 52) 2^(eb - 52), and under ulp(p), so it is
// representable unless that unit is below 2^-1074, and the fused error, a
// sum rounded once, is then exact. Dekker's is exact when none of its steps
// overflows or underflows (Dekker, "A floating-point technique for extending
// the available precision", 1971): for operands under 2^995, so that
// Veltkamp's split does not overflow, and a product that does not overflow
// and is at least 2^-916, so that the units' product is a normal 2^-1022 or
// more. An exact error of 0 is +0 both ways, the sum of a value and its
// negation, and nothing else differs.
//
// Every call meets that. Each fast path starts from arguments past their
// special cases, at least 2^-120 or scaled near 1, and from table entries;
// sums of multiples of a unit stay multiples of it, products multiply the
// units, and quotients are of a bounded divisor, so every value is 0 or above
// 2^-300, and every operand under 2^64: `pow`'s y is, its |y log x| under 746
// and |log x| over 2^-54, and `norm`'s fast path leaves out a component below
// 2^-458 of the largest, whose square is the smallest product, 2^-916.
package repro;

import "core:math";
import "core:unsafe";

CANONICAL_NAN_F64 :: 0x7ff8000000000000;
CANONICAL_NAN_F32 :: 0x7fc00000;

// 1.5 * 2^52: adding and subtracting it rounds a value under 2^51 to an
// integer, ties to even.
ROUND_SHIFTER :: 6755399441055744.0;
// 2^27 + 1, Veltkamp's splitting constant for `f64`.
SPLITTER :: 134217729.0;
// 2^-66, twice the relative error the fast paths are bounded by: a result is
// returned when both ends of h + l ± 2^-66 h round alike, which also covers
// rounding l ± the margin itself.
MARGIN :: 1.3552527156068805e-20;

// The `f64` a constant bit pattern encodes.
from_bits :: proc(pattern: u64) -> f64 {
	return unsafe.transmute(f64, pattern);
}

// a + b exactly as a sum and its rounding error (Knuth).
two_sum :: proc(a: f64, b: f64) -> (high: f64, low: f64) {
	s := a + b;
	bb := s - a;
	return {s, (a - (s - bb)) + (b - bb)};
}

// The same, given |a| >= |b| (Dekker).
fast_two_sum :: proc(a: f64, b: f64) -> (high: f64, low: f64) {
	s := a + b;
	return {s, b - (s - a)};
}

// a * b exactly as a product and its rounding error, for operands under
// 2^995 whose product is 0 or at least 2^-916 and does not overflow: the
// fused error where FMA is an instruction, and otherwise Dekker's, as the
// file's head describes.
two_product :: proc(a: f64, b: f64) -> (high: f64, low: f64) {
	p := a*b;
	when (math.fma_is_instruction()) { return {p, math.fma(a, b, 0.0 - p)}; }
	ta := SPLITTER*a;
	ah := ta - (ta - a);
	al := a - ah;
	tb := SPLITTER*b;
	bh := tb - (tb - b);
	bl := b - bh;
	return {p, ((ah*bh - p) + ah*bl + al*bh) + al*bl};
}

// 2^n for n in -1022 ..= 1023.
power_of_two :: proc(n: int) -> f64 {
	return unsafe.transmute(f64, u64(n + 1023) << 52);
}

abs_int :: proc(n: int) -> int {
	if (n < 0) { return 0 - n; }
	return n;
}

// Whether the nearest `f64` to h + l is decided within a relative margin
// of twice the path's bound, and that `f64`, given h != 0 and |l| <= ulp(h).
f64_decided :: proc(h: f64, l: f64, relative: f64 = MARGIN) -> (decided: bool, value: f64) {
	margin := h*relative;
	low := h + (l - margin);
	return {low == h + (l + margin), low};
}

// Whether every `f64` within `ulps` of the normal y narrows to the `f32` y
// narrows to: whether no `f32` midpoint is that close. The bits of |y| below
// its `f32` unit, which is coarser for a subnormal result, show the distance:
// they are within `ulps` of the midpoint exactly when their difference from
// it, plus `ulps`, wrapping, is at most 2 `ulps`. One comparison rather than
// two joined by `||`, which compiled to a branch that random arguments
// mispredict half the time.
f32_decided :: proc(y: f64, ulps: u64) -> bool {
	pattern := unsafe.transmute(u64, y) & 0x7fffffffffffffff;
	exponent := int(pattern >> 52) - 1023;
	significand := (pattern & 0x000fffffffffffff) | 0x0010000000000000;
	drop := 29;
	if (exponent < -126) { drop = 29 + (-126 - exponent); }
	below := significand & ((u64(1) << drop) - 1);
	half := u64(1) << (drop - 1);
	return (below -% half) +% ulps > 2*ulps;
}
