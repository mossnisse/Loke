// standard-library.md "`core:math/repro`": `pow`
// in both widths, past its table of special cases.
//
// x^y = e^z, z = y log x, for x > 0 other than 1. The fast path computes
// log x as a pair within 2^-83 relative, z = y log x as a pair from it
// (`two_product`, its low part rounded by under 2^-106 |z|), and e^z by
// `exp`'s kernel, whose relative error is under 2^-67.8. A result that is
// not infinite, 0, or 1 has |z| < 746, so z's error, under 2^-73.5, adds to
// that for under 2^-67.7, and the result is returned, as `exp`'s are, when
// both ends of h + l ± 2^-66 h round alike.
//
// log x takes `log`'s table and a second one: r1 = y d1 - 1 exactly, as in
// `log`, |r1| <= 2^-8; k, the nearest integer to 2^15 r1, picks d2 near
// 1/(1 + k 2^-15), and r2 = (1 + r1) d2 - 1 = (d2 - 1) + r1 d2, |r2| under
// 2^-15.99, as rh + rl within 2^-113 absolute: d2 - 1 is exact (Sterbenz),
// the product with r1's high part exact as a pair, and `two_sum` adds them
// exactly. rh is that sum rounded, and the rest, rl, under 2^-60.4, is not
// renormalized into it, so that the series need not wait. log x = E ln 2 +
// L1 + L2 + log(1 + r2):
//
// - d2 is exactly 1 at k = 0, where L2 is 0 and r2 is r1 exactly, so where
//   both tables' parts are 0, log x is the series alone, with no absolute
//   error to divide by a small result; elsewhere |log x| is over 2^-17.
// - log(1 + r2) is r2 - r2^2/2 + c, c the series from r^3/3 to r^6/6, the
//   rest under 2^-96 relative, with rh^2 exact and rl's terms to rh^2 rl
//   added, those left out under 2^-92 relative; c is under 2^-33.5 relative
//   and, by Estrin's scheme, within 5.1 ulps of itself, under 2^-84.2
//   relative: three for rh^3, and two for its cofactor near 1/3.
// - E ln 2 is E times a 42-bit part, exact, and E times the rest, exact as a
//   pair, both within 2^-86.9 absolute of E ln 2, which is over 1/3 when E
//   is not zero; each table pair is within 2^-106 relative of its value.
// - The high parts are summed exactly as pairs (`two_sum`). The low parts
//   hold c, so they too reach 2^-33.5 of the result, where E is 0, and six
//   of their sums round at c's scale, by under 2^-83.97 in all; the others
//   round by under 2^-93. Where E is not 0, |log x| is over 1/3 and c,
//   under 2^-49.5, is under 2^-47.9 of it.
//
// These sum to under 2^-83.
//
// Otherwise, and for results that could be subnormal, the slow path
// recomputes x^y in 320-bit fixed point: log x within 2^-305 absolute from
// `log`'s slow path, times y exactly but for truncations under 2^-320, which
// leaves z within |y| 2^-305 < 2^-241 since |log x| > 2^-54 bounds |y| below
// 2^63.6, and e^z from `exp`'s slow path, within 2^-240 relative in all.
// Unlike the other functions, x^y can be exactly a midpoint between two
// floats, such as (1 + 2^-12)^2 in `f32`, which no approximation decides: a
// value within 2^-230 relative of a midpoint is tested for being exactly it,
// in integers, and rounded to even if it is. No binary64 pow argument is
// known to come closer than that to a midpoint without being one, but no
// exhaustive search covers two binary64 arguments, so nothing proves it;
// `tests/repro_test.odin` checks both paths against an independent oracle.
//
// `f32` arguments first take a single-`f64` approximation: z = y log x from
// `log_f32`'s, within 6 ulps of log x, and so within 6.5 2^-52 of z
// relative with the product's rounding, and e^z from `exp_f32`'s, within 1.1
// ulps. For a result in the normal `f32` range, |z| < 88, z's error is under
// 88 6.5 2^-52 = 2^-42.8 absolute, which moves e^z by under 2^-42.8
// relative, so the result is within 2^10.2 `f64` ulps. When no `f32` midpoint is within 2^11 ulps,
// narrowing it rounds correctly; an exact midpoint never is, so it goes on,
// with every result outside that range, to the double-`f64` path above, and
// then the slow path.
package repro;

import "core:unsafe";

// The window, in `f64` ulps, of `pow_f32`'s first approximation, past its
// bound of 2^10.2.
QUICK_POW_ULPS :: 2048;

// log x as h + l, within 2^-83 relative, for a positive finite x other
// than 1.
pow_log :: proc(x: f64) -> (high: f64, low: f64) {
	e, fraction := log_split(x);
	i, big_e := log_bucket(fraction, e);
	y := from_bits(fraction | 0x3ff0000000000000);
	ph, pl := two_product(y, from_bits(LOG_TABLE[3*i]));
	r1h, r1l := two_sum(ph - 1.0, pl);

	// k in -128 ..= 128, since |r1| <= 2^-8.
	k := int((r1h*32768.0 + ROUND_SHIFTER) - ROUND_SHIFTER);
	fine := 3*(k + 128);
	d2 := from_bits(LOG_FINE_TABLE[fine]);
	qh, ql := two_product(r1h, d2);
	// r2 = rh + rl, rl not renormalized into rh, so that the series need
	// not wait for it.
	rh, err := two_sum(d2 - 1.0, qh);
	rl := err + (ql + r1l*d2);

	// log(1 + r2) = (rh - rh^2/2) + the rest, c by Estrin's scheme.
	sh, sl := two_product(rh, rh);
	t1, t2 := two_sum(rh, 0.0 - 0.5*sh);
	c := sh*rh*((1.0/3.0 - rh*0.25) + sh*(0.2 - rh*(1.0/6.0)));
	tail := t2 + ((rl - 0.5*sl) + (c + (sh*rl - rh*rl)));

	ef := f64(big_e);
	bh, bl := two_product(ef, from_bits(LN2_LO));
	s0, e0 := two_sum(ef*from_bits(LN2_HI), bh);
	s1, e1 := two_sum(s0, from_bits(LOG_TABLE[3*i + 1]));
	s2, e2 := two_sum(s1, from_bits(LOG_FINE_TABLE[fine + 1]));
	s3, e3 := two_sum(s2, t1);
	rest := ((e0 + e1) + (e2 + e3))
		+ ((bl + from_bits(LOG_TABLE[3*i + 2])) + (from_bits(LOG_FINE_TABLE[fine + 2]) + tail));
	return fast_two_sum(s3, rest);
}

// x^y for a positive finite x other than 1 and a finite nonzero y.
pow_f64_of :: proc(x: f64, y: f64) -> f64 {
	lh, ll := pow_log(x);
	zh := y*lh;
	// e^710 overflows and e^-746 is below half the smallest subnormal; below
	// 2^-55 in magnitude, e^z is within half an ulp of 1 on either side.
	if (zh > 710.0) { return from_bits(0x7ff0000000000000); }
	if (zh < -746.0) { return 0.0; }
	if (zh < 2.7755575615628914e-17 && zh > -2.7755575615628914e-17) { return 1.0; }
	ph, pl := two_product(y, lh);
	k, h, l := exp_kernel(ph, pl + y*ll);
	m := k >> 7;
	decided, v := f64_decided(h, l);
	if (decided && m >= -1021) {
		if (m <= 1023) { return v*power_of_two(m); }
		return v*power_of_two(1023)*2.0;
	}
	return from_bits(pow_slow(x, y, zh, F64_LAYOUT));
}

// x^y for `f32` arguments, x positive and not 1 and y nonzero, here exactly
// as `f64` values: the single-`f64` approximation first, and then the same
// pair, scaled into a normal `f64` within one ulp of x^y, which rounds x^y
// correctly unless an `f32` midpoint is that close, as it is when x^y is
// one; then the slow path.
pow_f32_of :: proc(x: f64, y: f64) -> f32 {
	z := y*log_quick(x);
	if (F32_FIRST_APPROXIMATION && z > -87.0 && z < 88.0) {
		quick := exp_quick(z);
		if (f32_decided(quick, QUICK_POW_ULPS)) { return f32(quick); }
	}

	lh, ll := pow_log(x);
	zh := y*lh;
	// e^89 overflows `f32` and e^-104 is below half its smallest subnormal;
	// below 2^-26 in magnitude, e^z rounds to 1.
	if (zh > 89.0) { return unsafe.transmute(f32, u32(0x7f800000)); }
	if (zh < -104.0) { return f32(0.0); }
	if (zh < 1.4901161193847656e-08 && zh > -1.4901161193847656e-08) { return f32(1.0); }
	ph, pl := two_product(y, lh);
	k, h, l := exp_kernel(ph, pl + y*ll);
	scale := power_of_two(k >> 7);
	near := h*scale + l*scale;
	if (f32_decided(near, 1)) { return f32(near); }
	return unsafe.transmute(f32, u32(pow_slow(x, y, zh, F32_LAYOUT)));
}

// x^y correctly rounded to `layout`, as its bit pattern, for a positive
// finite x other than 1 and a finite nonzero y with |y log x| under 746,
// whose nearest `f64` is about `estimate`.
@(cold)
pow_slow :: proc(x: f64, y: f64, estimate: f64, layout: Float_Layout) -> u64 {
	log_negative, log_value := log_fixed(x);
	odd, exponent := odd_split(from_bits(unsafe.transmute(u64, y) & 0x7fffffffffffffff));
	z := fixed_scaled(fixed_times_small(log_value, odd), exponent);
	sum, sum_exponent := exp_fixed(log_negative != (y < 0.0), z, estimate);

	unit, drop := fixed_round_place(sum, sum_exponent, layout);
	if (fixed_near_half(sum, drop, fixed_top_bit(sum) - 230)) {
		kept := fixed_field(sum, drop, layout.precision + 1);
		if (pow_is_exactly(x, y, 2*kept + 1, drop - 1 + sum_exponent)) {
			return fixed_round_finish(kept + (kept & 1), unit, layout);
		}
	}
	return fixed_round(sum, sum_exponent, layout);
}

// Whether a is within 2^low of the midpoint between multiples of 2^drop
// next to it: its bit below `drop` set and those from `low` up to that one
// clear, or the reverse.
fixed_near_half :: proc(a: Fixed, drop: int, low: int) -> bool {
	half := fixed_field(a, drop - 1, 1);
	for (position := low; position < drop - 1; position += 64) {
		count := drop - 1 - position;
		if (count > 64) { count = 64; }
		field := fixed_field(a, position, count);
		if (half == 1 && field != 0) { return false; }
		if (half == 0 && field != (u64(0xffffffffffffffff) >> (64 - count))) { return false; }
	}
	return true;
}

// A positive finite x as an odd integer a and a power of two, x = a 2^b.
odd_split :: proc(x: f64) -> (odd: u64, exponent: int) {
	e, fraction := log_split(x);
	odd := fraction | 0x0010000000000000;
	exponent := e - 52;
	for (odd & 1 == 0) {
		odd >>= 1;
		exponent += 1;
	}
	return {odd, exponent};
}

// Whether x^y is exactly m 2^t, for x > 0, a finite nonzero y, and an odd
// m < 2^55. With x = a 2^b and |y| = c 2^d, a and c odd, x^y = a^y 2^(b y),
// and a^y is an odd integer or not a dyadic value at all, so that needs
// b y = t and a^y = m: a = 1 and m = 1, or y > 0 and a the 2^-d-th power of
// an integer whose c 2^d-th power is m. Every integer here is small: |t| is
// under 1200, and a^y = m < 2^55 with a >= 3 bounds both c 2^d and 2^-d by
// 35.
pow_is_exactly :: proc(x: f64, y: f64, m: u64, t: int) -> bool {
	a, b := odd_split(x);
	ay := y;
	if (y < 0.0) { ay = 0.0 - y; }
	c, d := odd_split(ay);
	// b y = b c 2^d, with |b c| < 2^64.
	product := i128(b)*i128(c);
	if (y < 0.0) { product = 0 - product; }
	if (product == 0) {
		if (t != 0) { return false; }
	} else if (d >= 0) {
		if (d > 12 || product > 4096 || product < -4096) { return false; }
		if (product*(i128(1) << d) != i128(t)) { return false; }
	} else {
		if (d < -100) { return false; }
		if (product != i128(t)*(i128(1) << (0 - d))) { return false; }
	}
	if (a == 1) { return m == 1; }
	if (y < 0.0 || d < -6 || d > 6) { return false; }
	root := a;
	if (d < 0) {
		foreach (_ in 0 ..< 0 - d) {
			s := integer_square_root(root);
			if (s*s != root) { return false; }
			root = s;
		}
	}
	power := c;
	if (d > 0) { power = c << d; }
	if (power > 40) { return false; }
	value: u128 = 1;
	foreach (_ in 0 ..< int(power)) {
		value *= u128(root);
		if (value > u128(m)) { return false; }
	}
	return value == u128(m);
}

// floor(sqrt n), by Newton's iteration from above.
integer_square_root :: proc(n: u64) -> u64 {
	if (n < 2) { return n; }
	x := n;
	next := x/2 + 1;
	for (next < x) {
		x = next;
		next = (x + n/x)/2;
	}
	return x;
}

// For a finite y: 0 if it is not an integer, 1 if it is an odd one, and 2
// if an even one.
integer_kind :: proc(y: f64) -> int {
	pattern := unsafe.transmute(u64, y) & 0x7fffffffffffffff;
	biased := int(pattern >> 52);
	if (pattern == 0) { return 2; }
	if (biased < 1023) { return 0; }
	// The weight of the significand's last bit is 2^(biased - 1075).
	if (biased > 1075) { return 2; }
	significand := (pattern & 0x000fffffffffffff) | 0x0010000000000000;
	fraction_bits := 1075 - biased;
	if (fraction_bits > 0 && significand & ((u64(1) << fraction_bits) - 1) != 0) { return 0; }
	if ((significand >> fraction_bits) & 1 == 1) { return 1; }
	return 2;
}
