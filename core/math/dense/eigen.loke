// dense-matrix-plan.md "Algorithms": the symmetric and Hermitian eigensolver,
// Householder tridiagonalization as LAPACK's `sytd2` and `hetd2` do it from
// the lower triangle, then
// implicit QL with Wilkinson shifts, as EISPACK's `imtql2` and Numerical
// Recipes' `tqli` do it. Convergence is decided by rounding, with no epsilon:
// an off-diagonal element is negligible when adding it to the magnitudes of
// its two diagonal neighbours changes nothing.
@(public)
package dense;

import "core:math/linalg";
import "core:mem";
import "core:unsafe";

/**
	The eigendecomposition `A = V D V^H` of a Hermitian `A`, which for a real
	`T` is `A = V D V^T` of a symmetric one: the eigenvalues, which are real,
	in ascending order, and `V` orthogonal, or unitary, with eigenvector `i`
	as column `i`. `symmetric_eigen(a)` makes one.
*/
Symmetric_Eigen :: struct($T: type) where linalg.Scalar(T) {
	@(private) eigenvalues:  [dynamic]T.Real,   // ascending
	@(private) eigenvectors: Matrix(T),         // as columns
}

/**
	The eigenvalues and eigenvectors of the symmetric `a`, or Hermitian for a
	complex `T`, from its lower triangle: the elements above the diagonal are
	not read, and nor is the imaginary part of the diagonal, so `A` is taken
	as symmetric, or Hermitian, without a check. Allocated from `allocator`.

	A matrix whose largest part of an element has a magnitude above `big`,
	the largest power of two whose square is finite (`2^511` for `f64` and
	`2^63` for `f32`), is first multiplied by `1/big`, and one whose largest
	is below `1/big` but not zero by `big`, and the eigenvalues are
	multiplied back at the end. No step then overflows, and since a power
	of two changes the rounding of no value that is not subnormal, the
	results are those of the unscaled method wherever it neither overflows
	nor reaches a subnormal value.

	`A` is reduced to a real tridiagonal `T = Q^H A Q` by `n - 2` Householder
	reflectors built as `qr_in_place` builds them, each applied to the lower
	triangle of the trailing block as `A = (A - v w^H) - w v^H` with
	`w = p - (tau (p^H v) / 2) v` and `p = tau A v`, each sum in increasing
	order and the diagonal kept real; `^H` is `^T` for a real `T`. Then
	implicit QL with Wilkinson shifts reduces `T` to a diagonal,
	the rotations accumulated into `Q`, in at most `30 n` sweeps in all, a
	limit pooled as `svd`'s is rather than 30 for each eigenvalue. An
	off-diagonal element `e` beside the diagonal elements `d0` and `d1` is
	negligible when `t + |e| == t` for `t = |d0| + |d1|`.

	The eigenvalues are sorted ascending, by a selection sort that takes the
	first of equal ones, and each eigenvector is signed so that its first
	component of largest magnitude is positive: for a complex `T`, it is
	multiplied by the unit `conj(z) / |z|` for that component `z`, the
	magnitude being the modulus, and the component is then exactly `|z|`.
	So the vectors and not only the subspaces are the same on every machine.
	The results are only as unique as the problem: for equal eigenvalues,
	any orthonormal basis of their subspace is a solution, and this is the
	one the method finds.

	`.No_Convergence` past the iteration limit, which for a finite matrix is
	a bug to report, for an element that is read and is not finite, which
	the iteration cannot reduce, or for an eigenvalue too large for
	`T.Real`, so that a successful decomposition is always finite. A
	non-square matrix panics.
*/
symmetric_eigen :: proc(a: View($T), allocator: Allocator = mem.default_allocator()) -> Result(Symmetric_Eigen(T), Error) where linalg.Scalar(T) {
	n := a.row_count;
	assert(a.column_count == n, "dense.symmetric_eigen needs a square matrix");
	work := Matrix(T).zeros(n, n, allocator);
	largest := T.Real(0);
	foreach (c in 0 ..< n) {
		foreach (r in c ..< n) {
			// The diagonal's imaginary part is dropped before it is read.
			x := a[r, c] if r != c else real_only(a[r, c]);
			if (!finite(x)) { return .err(.No_Convergence); }
			largest = larger_of(largest, part_magnitude(x));
			work[r, c] = x;
		}
	}
	scale := matrix_scale(largest);
	if (!(scale == T.Real(1))) { work.view_mut().scale_by(T(scale)); }
	values := zeros_of(T.Real, n, allocator);
	off_diagonal := zeros_of(T.Real, n, allocator);
	scales := zeros_of(T, n, allocator);
	scratch := zeros_of(T, n, allocator);
	tridiagonalize(work.view_mut(), &mut values[:], &mut off_diagonal[:], &mut scales[:], &mut scratch[:]);

	// Q = H_0 H_1 ... H_{n-3}, applied to the identity from the last
	// reflector to the first. Reflector `k` leaves columns `0 ..= k` of the
	// partial product as they are, so it is applied to the others alone.
	vectors := Matrix(T).identity(n, allocator);
	packed := work.view();
	for (k := n - 2; k >= 0; k -= 1) {
		reflect(packed, k + 1, k, scales[k], vectors.view_mut().block(0, k + 1, n, n - k - 1));
	}
	tridiagonal_ql(&mut values[:], &mut off_diagonal[:], vectors.view_mut()) or_return;
	if (!(scale == T.Real(1))) {
		unscale := T.Real(1)/scale;
		foreach (i in 0 ..< n) { values[i] = values[i]*unscale; }
	}
	if (!reals_finite(values[:]) || !view_finite(vectors.view())) { return .err(.No_Convergence); }

	foreach (i in 0 ..< n) {
		smallest := i;
		foreach (j in i + 1 ..< n) {
			if (values[j] < values[smallest]) { smallest = j; }
		}
		if (smallest != i) {
			held := values[i];
			values[i] = values[smallest];
			values[smallest] = held;
			swap_columns(vectors.view_mut(), i, smallest);
		}
	}
	foreach (i in 0 ..< n) {
		lead := leading_unit(vectors.view(), i);
		apply_unit(vectors.view_mut(), i, lead.unit);
		when (T != T.Real) {
			if (lead.unit != T(1)) { vectors[lead.row, i] = T(lead.size); }
		}
	}
	return .ok(Symmetric_Eigen(T){move(values), move(vectors)});
}

impl Symmetric_Eigen($T) {
	/// The order of the matrix.
	size :: proc(self) -> int { return self.eigenvectors.row_count; }

	/// The eigenvalues, ascending.
	values :: proc(self: ^) -> []T.Real where linalg.Scalar(T) { return self.eigenvalues[:]; }

	/// The eigenvectors as the columns of an orthogonal, or unitary, matrix, column `i` for `values()[i]`.
	vectors :: proc(self: ^) -> View(T) { return self.eigenvectors.view(); }
}

// `sytd2`, or `hetd2` for a complex `T`, with `uplo = 'L'`: reduces the
// lower triangle of the square `a` to a real tridiagonal form, leaving the
// diagonal in `d`, the subdiagonal in `e` with `e[n - 1] = 0`, each
// reflector's scale in `tau` and its vector in `a` below the subdiagonal.
// `work` holds `p` and then `w`. The diagonal's imaginary parts start at
// zero and are kept there.
@(private)
tridiagonalize :: proc(a: View_Mut($T), d, e: []mut $R, tau, work: []mut T) where linalg.Scalar(T), R == T.Real {
	n := a.row_count;
	x := unsafe.raw_data(a.data);
	rs := a.row_stride;
	cs := a.column_stride;
	two := from_f64(T, 2.0);
	foreach (k in 0 ..< n - 1) {
		scale := householder(x, rs, cs, k + 1, k, n);
		tau[k] = scale;
		e[k] = x[offset(k + 1, k, rs, cs)].real_part();
		if (scale == T(0)) { continue; }
		// The vector's first element is 1 while the block is updated, as
		// `sytd2` sets it, so `v` reads straight from column `k`; a product
		// with 1 is exact.
		x[offset(k + 1, k, rs, cs)] = T(1);
		foreach (i in k + 1 ..< n) {
			sum := hermitian_element(x, i, k + 1, rs, cs)*x[offset(k + 1, k, rs, cs)];
			foreach (j in k + 2 ..< n) { sum = sum + hermitian_element(x, i, j, rs, cs)*x[offset(j, k, rs, cs)]; }
			work[i] = scale*sum;
		}
		dot := conj(work[k + 1])*x[offset(k + 1, k, rs, cs)];
		foreach (i in k + 2 ..< n) { dot = dot + conj(work[i])*x[offset(i, k, rs, cs)]; }
		adjust := -(scale*dot)/two;
		foreach (i in k + 1 ..< n) { work[i] = work[i] + adjust*x[offset(i, k, rs, cs)]; }
		foreach (j in k + 1 ..< n) {
			vj := conj(x[offset(j, k, rs, cs)]);
			wj := conj(work[j]);
			foreach (i in j ..< n) {
				place := offset(i, j, rs, cs);
				x[place] = (x[place] - x[offset(i, k, rs, cs)]*wj) - work[i]*vj;
			}
			when (T != T.Real) {
				diagonal := offset(j, j, rs, cs);
				x[diagonal] = real_only(x[diagonal]);
			}
		}
		x[offset(k + 1, k, rs, cs)] = T(e[k]);
	}
	foreach (i in 0 ..< n) { d[i] = x[offset(i, i, rs, cs)].real_part(); }
	if (n > 0) { e[n - 1] = R(0); }
}

// Element `(i, j)` of the Hermitian matrix whose lower triangle `x` holds:
// the element itself on and below the diagonal, and above it the conjugate
// of `(j, i)`.
@(private)
hermitian_element :: proc(x: [^]$T, i, j, rs, cs: int) -> T where linalg.Scalar(T) {
	if (j <= i) { return x[offset(i, j, rs, cs)]; }
	return conj(x[offset(j, i, rs, cs)]);
}

// Implicit QL with Wilkinson shifts on the symmetric tridiagonal matrix with
// diagonal `d` and subdiagonal `e`, as `tqli` does it, each rotation also
// applied to the columns of `z`. Leaves the eigenvalues in `d`, unsorted.
@(private)
tridiagonal_ql :: proc(d, e: []mut $T, z: View_Mut($S)) -> Status(Error) where linalg.Real(T), linalg.Scalar(S), S.Real == T {
	n := d.len();
	sweeps := 0;
	foreach (l in 0 ..< n) {
		for (;;) {
			m := n - 1;
			foreach (j in l ..< n - 1) {
				t := d[j].abs() + d[j + 1].abs();
				if (t + e[j].abs() == t) {
					m = j;
					break;
				}
			}
			if (m == l) { break; }
			if (sweeps == 30*n) { return .err(.No_Convergence); }
			sweeps += 1;
			// The shift is the eigenvalue of the leading 2 x 2 block nearer
			// to d[l].
			g := (d[l + 1] - d[l])/(T(2)*e[l]);
			r := hypot(g, T(1));
			g = (d[m] - d[l]) + e[l]/(g + (-r if g < T(0) else r));
			s := T(1);
			c := T(1);
			p := T(0);
			underflow := false;
			for (i := m - 1; i >= l; i -= 1) {
				f := s*e[i];
				b := c*e[i];
				r = hypot(f, g);
				e[i + 1] = r;
				if (r == T(0)) {
					// The rotation underflowed: deflate here and sweep again.
					d[i + 1] = d[i + 1] - p;
					e[m] = T(0);
					underflow = true;
					break;
				}
				s = f/r;
				c = g/r;
				g = d[i + 1] - p;
				r = (d[i] - g)*s + (T(2)*c)*b;
				p = s*r;
				d[i + 1] = g + p;
				g = c*r - b;
				rotate_columns(z, i + 1, i, c, s);
			}
			if (underflow) { continue; }
			d[l] = d[l] - p;
			e[l] = g;
			e[m] = T(0);
		}
	}
	return .ok;
}

// BLAS's `rot` on columns `a` and `b` of `x`, with a real rotation: each row
// becomes `(c*xa + s*xb, c*xb - s*xa)`.
@(private)
rotate_columns :: proc(x: View_Mut($T), a, b: int, c, s: $R) where linalg.Scalar(T), R == T.Real {
	p := unsafe.raw_data(x.data);
	first := a*%x.column_stride;
	second := b*%x.column_stride;
	foreach (i in 0 ..< x.row_count) {
		row := i*%x.row_stride;
		u := p[row +% first];
		w := p[row +% second];
		p[row +% first] = times_real(c, u) + times_real(s, w);
		p[row +% second] = times_real(c, w) - times_real(s, u);
	}
}

@(private)
swap_columns :: proc(x: View_Mut($T), a, b: int) where linalg.Scalar(T) {
	p := unsafe.raw_data(x.data);
	foreach (i in 0 ..< x.row_count) {
		first := offset(i, a, x.row_stride, x.column_stride);
		second := offset(i, b, x.row_stride, x.column_stride);
		held := p[first];
		p[first] = p[second];
		p[second] = held;
	}
}

@(private)
negate_column :: proc(x: View_Mut($T), c: int) where linalg.Scalar(T) {
	p := unsafe.raw_data(x.data);
	foreach (i in 0 ..< x.row_count) {
		at := offset(i, c, x.row_stride, x.column_stride);
		p[at] = -p[at];
	}
}

// The first component of largest modulus in a column, its row and modulus,
// and the unit that makes it real and positive: -1 or 1 for a real `T`, and
// `conj(z) / |z|` for a complex one, or 1 for a zero column.
@(private)
Leading :: struct($T: type, $R: type) { unit: T, row: int, size: R }

@(private)
leading_unit :: proc(x: View($T), c: int) -> Leading(T, T.Real) where linalg.Scalar(T) {
	if (x.row_count == 0) { return {T(1), 0, T.Real(0)}; }
	best := x[0, c];
	row := 0;
	largest := modulus(best);
	foreach (i in 1 ..< x.row_count) {
		candidate := modulus(x[i, c]);
		if (largest < candidate) {
			best = x[i, c];
			row = i;
			largest = candidate;
		}
	}
	when (T == T.Real) {
		return {real_sign(best), row, largest};
	} else {
		return {unphase(best) if T.Real(0) < largest else T(1), row, largest};
	}
}

// Column `c` times the unit `leading_unit` gave: nothing for 1, a negation
// for -1.
@(private)
apply_unit :: proc(x: View_Mut($T), c: int, unit: T) where linalg.Scalar(T) {
	if (unit == T(1)) { return; }
	when (T == T.Real) {
		negate_column(x, c);
	} else {
		p := unsafe.raw_data(x.data);
		foreach (i in 0 ..< x.row_count) {
			at := offset(i, c, x.row_stride, x.column_stride);
			p[at] = p[at]*unit;
		}
	}
}
