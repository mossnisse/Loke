qr_in_place :: proc(a: View_Mut($T), tau: []mut T) -> Status(Error) where linalg.Scalar(T) ---;

// The QR factors of the `m x n` matrix `a`, `m >= n`, allocated from `allocator`, or `.Singular` as `qr_in_place` decides it.
qr :: proc(a: View($T), allocator: Allocator = mem.default_allocator()) -> Result(Qr(T), Error) where linalg.Scalar(T) ---;

impl Qr($T) {
	// The number of rows of the factored matrix.
	rows :: proc(self) -> int ---;

	// The number of columns of the factored matrix.
	columns :: proc(self) -> int ---;

	// Both factors in one view, as `qr_in_place` leaves them.
	factors :: proc(self: ^) -> View(T) ---;

	// `tau()[k]` is the scale of reflector `k`.
	tau :: proc(self: ^) -> []T ---;

	// `R`, `n x n` with zeros below the diagonal, allocated from `allocator`.
	r :: proc(self, allocator: Allocator = mem.default_allocator()) -> Matrix(T) ---;

	/*
		The first `n` columns of `Q`, `m x n` with orthonormal columns (in the
		complex inner product for a complex `T`):
		`apply_q_into` of the first `n` columns of the identity. The whole
		`m x m` `Q` is `apply_q_into` of the whole identity.
	*/
	q :: proc(self, allocator: Allocator = mem.default_allocator()) -> Matrix(T) ---;

	/*
		Overwrites the `m`-row `b` with `Q b`: the reflectors from the last to
		the first, each applied to each column as `qr_in_place` applies it.
	*/
	apply_q_into :: proc(self, b: View_Mut(T)) ---;

	/*
		Overwrites the `m`-row `b` with `Q^H b`, which is `Q^T b` for a real
		`T`: the reflectors from the first to the last, each as `H_k^H`, with
		the scale `conj(tau[k])`.
	*/
	apply_q_adjoint_into :: proc(self, b: View_Mut(T)) ---;

	/*
		Overwrites the `m`-row `b` as LAPACK's `gels` does: its first `n` rows
		become the `x` that minimizes `|A x - b|` in the 2-norm, for each
		column, and the other `m - n` rows the residual's components in `Q`'s
		basis, so their norm is `|A x - b|`. That is `Q^H b`, then `R x = c` for
		its first `n` rows in `solve_upper_into`'s order.
	*/
	least_squares_into :: proc(self, b: View_Mut(T)) ---;

	// The `n`-row `x` that minimizes `|A x - b|`, allocated, with a copy of `b` to work in, from `allocator`.
	least_squares :: proc(self, b: View(T), allocator: Allocator = mem.default_allocator()) -> Matrix(T) ---;
}

/*
	The `x` that minimizes `|A x - b|` in the 2-norm for the `m x n` matrix
	`a`, `m >= n`, by `qr`; `.Singular` as `qr` decides it. For a square `a`
	it is the solution of `A x = b`.
*/
least_squares :: proc(a, b: View($T), allocator: Allocator = mem.default_allocator()) -> Result(Matrix(T), Error) where linalg.Scalar(T) ---;

/*
	The thin singular value decomposition `A = U S V^H` of an `m x n` `A`,
	which is `A = U S V^T` for a real `T`, with `k = min(m, n)`: `U` is
	`m x k` and `V` is `n x k`, each with orthonormal columns, and `S` the
	`k` singular values, real, descending, and not negative. `svd(a)` makes
	one.
*/
Svd :: struct($T: type) where linalg.Scalar(T) {
	// and fields private to the package
}

/*
	The singular value decomposition of the `m x n` `a`, allocated from
	`allocator`. A wide `a` is decomposed as its adjoint, which is its
	transpose for a real `T`, with `U` and `V` exchanged, so the method below
	always sees `m >= n`.

	A matrix whose largest part of an element has a magnitude above `big`,
	the largest power of two whose square is finite (`2^511` for `f64` and
	`2^63` for `f32`), is first multiplied by `1/big`, and one whose largest
	is below `1/big` but not zero by `big`, and the singular values are
	multiplied back at the end. No step then overflows, and since a power
	of two changes the rounding of no value that is not subnormal, the
	results are those of the unscaled method wherever it neither overflows
	nor reaches a subnormal value.

	`A` is reduced to a real upper bidiagonal `B = Q^H A P` by alternating
	Householder reflectors built and applied as `qr_in_place` builds and
	applies them: reflector `k` from the left zeros column `k` below the
	diagonal, then one from the right zeros row `k` past the superdiagonal,
	built from the row as it stands and applied to the transpose's columns
	as `H^H`, which is `A G` for `G` its conjugate.
	`U` and `V` start as `Q` and `P`. Then LINPACK's `dsvdc` iteration
	reduces `B` to a diagonal, each rotation accumulated into `U` or `V`, in
	at most `30 n` shifted QR sweeps in all. The limit is pooled, unlike
	`dsvdc`'s 30 for each singular value: in a graded matrix the shift is lost
	against the block's large end, so the first value to converge can take
	many more sweeps, and the others then follow in one or two each.

	A superdiagonal element `e` beside the diagonal elements `s0` and `s1` is
	negligible when `t + |e| == t` for `t = |s0| + |s1|`, and a diagonal
	element `s` beside the superdiagonal elements `e0` and `e1` when
	`t + |s| == t` for `t = |e0| + |e1|`.

	Each singular value is made non-negative as it converges, by negating its
	column of `V`, and sorted into place, and finally each pair of columns
	is signed so that the first component of largest magnitude in `V`'s
	column is positive: for a complex `T`, both columns are multiplied by the
	unit `conj(z) / |z|` for that component `z`, by modulus, which is then
	exactly `|z|`. So the vectors and not only the subspaces are the same on
	every machine. For equal singular values the vectors are the basis the
	method finds.

	`.No_Convergence` past the iteration limit, which for a finite matrix is
	a bug to report, for an element that is not finite, or for a singular
	value too large for `T.Real`, so that a successful decomposition is
	always finite.
*/
svd :: proc(a: View($T), allocator: Allocator = mem.default_allocator()) -> Result(Svd(T), Error) where linalg.Scalar(T) ---;

impl Svd($T) {
	// The number of rows of the decomposed matrix, `m`.
	rows :: proc(self) -> int ---;

	// The number of columns of the decomposed matrix, `n`.
	columns :: proc(self) -> int ---;

	// `U`, `m x k`, borrowed from the decomposition.
	u :: proc(self: ^) -> View(T) ---;

	// The `k` singular values, descending.
	singular_values :: proc(self: ^) -> []T.Real ---;

	// `V`, `n x k`, borrowed from the decomposition; `A = U S V^H`.
	v :: proc(self: ^) -> View(T) ---;

	/*
		The number of singular values greater than `relative` times the
		largest. `relative` has no default, since the right one depends on
		the data's accuracy; a negative or NaN one panics.
	*/
	rank :: proc(self, relative: T.Real) -> int ---;

	/*
		Overwrites the `n`-row `out` with the minimum-norm `x` that minimizes
		`|A x - b|` in the 2-norm, for each column of the `m`-row `b`,
		treating the singular values not greater than `relative` times the
		largest as zero, as `rank` counts them: `x = sum of
		(u_i^H b / s_i) v_i` over the others, in increasing `i`, with each
		`u_i^H b` summed in increasing row order. `relative = 0` keeps every
		singular value that is not zero. A negative or NaN `relative`, or a
		shape mismatch, panics.
	*/
	solve_into :: proc(self, out: View_Mut(T), b: View(T), relative: T.Real) ---;

	// The minimum-norm least-squares solution of `solve_into`, `n` rows, allocated from `allocator`.
	solve :: proc(self, b: View(T), relative: T.Real, allocator: Allocator = mem.default_allocator()) -> Matrix(T) ---;
}

/*
	A read-only view of `rows x columns` elements somewhere else: element
	`(r, c)` is `data[r*row_stride + c*column_stride]`, or its conjugate in a
	view made by `adjoint`. It borrows its slice, so it cannot outlive the
	storage.
*/
View :: struct($T: type) where interfaces.Numeric(T) {
	// and fields private to the package
}

/*
	A mutable view, laid out as `View`. It borrows its slice exclusively, so
	no other view of the same elements is live while it is.
*/
View_Mut :: struct($T: type) where interfaces.Numeric(T) {
	// and fields private to the package
}

impl View($T) {
	/*
		`rows x columns` column-major elements of `data`, column `c` starting
		at `c*leading`. A `leading` below `rows`, or elements past the end of
		`data`, panic.
	*/
	from_column_major :: proc(data: []T, rows, columns: int, leading := rows) -> View(T) ---;

	// `rows x columns` row-major elements of `data`, row `r` starting at `r*leading`.
	from_row_major :: proc(data: []T, rows, columns: int, leading := columns) -> View(T) ---;

	// `values` as a column vector, `values.len() x 1`.
	from_column :: proc(values: []T) -> View(T) ---;

	rows :: proc(self) -> int ---;

	columns :: proc(self) -> int ---;

	// Element `(row, column)`; an index outside the view panics.
	get :: operator([]) proc(self, row, column: int) -> T ---;

	// The `rows x columns` block whose first element is `(row, column)`.
	block :: proc(self, row, column, rows, columns: int) -> View(T) ---;

	// The transpose, with no copy: the strides swapped.
	transpose :: proc(self) -> View(T) ---;

	/*
		The conjugate transpose `A^H`, with no copy: the strides swapped, and
		each element read as its conjugate. For a real `T` it is the
		transpose.
	*/
	adjoint :: proc(self) -> View(T) where linalg.Scalar(T) ---;

	// Row `r` as a `1 x columns` view.
	row :: proc(self, r: int) -> View(T) ---;

	// Column `c` as a `rows x 1` view.
	column :: proc(self, c: int) -> View(T) ---;

	// A copy as `linalg.Matrix(T, R, C)`; another shape panics.
	to_fixed :: proc(self, $R: int, $C: int) -> linalg.Matrix(T, R, C) ---;

	// Rows in brackets, as `Matrix(T)` prints.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) ---;
}

impl View_Mut($T) {
	// As `View.from_column_major`, writable.
	from_column_major :: proc(data: []mut T, rows, columns: int, leading := rows) -> View_Mut(T) ---;

	// As `View.from_row_major`, writable.
	from_row_major :: proc(data: []mut T, rows, columns: int, leading := columns) -> View_Mut(T) ---;

	// `values` as a writable column vector.
	from_column :: proc(values: []mut T) -> View_Mut(T) ---;

	rows :: proc(self) -> int ---;

	columns :: proc(self) -> int ---;

	get :: operator([]) proc(self, row, column: int) -> T ---;

	get_mut :: operator([]) proc(self: inout, row, column: int) -> inout T ---;

	// The same elements, read-only, borrowed from this view.
	as_view :: proc(self: ^) -> View(T) ---;

	// As `View.block`, writable. A temporary or `move(view)` is consumed, and a named view is borrowed.
	block :: proc{block_whole, block_borrowed};

	// As `View.transpose`, writable.
	transpose :: proc{transpose_whole, transpose_borrowed};

	// As `View.row`, writable.
	row :: proc{row_whole, row_borrowed};

	// As `View.column`, writable.
	column :: proc{column_whole, column_borrowed};

	/*
		The columns before `k` and from `k`, as two views that may be written
		at once. A view whose columns interleave in its slice, as a row-major
		matrix's do, panics.
	*/
	split_columns :: proc{split_columns_whole, split_columns_borrowed};

	// The rows before `k` and from `k`; a view whose rows interleave, as a column-major matrix's do, panics.
	split_rows :: proc{split_rows_whole, split_rows_borrowed};

	// Private to the package, but a public declaration names it.
	block_whole :: proc(self: move, row, column, rows, columns: int) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	block_borrowed :: proc(self: inout, row, column, rows, columns: int) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	transpose_whole :: proc(self: move) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	transpose_borrowed :: proc(self: inout) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	row_whole :: proc(self: move, r: int) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	row_borrowed :: proc(self: inout, r: int) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	column_whole :: proc(self: move, c: int) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	column_borrowed :: proc(self: inout, c: int) -> View_Mut(T) ---;

	// Private to the package, but a public declaration names it.
	split_columns_whole :: proc(self: move, k: int) -> (left: View_Mut(T), right: View_Mut(T)) ---;

	// Private to the package, but a public declaration names it.
	split_columns_borrowed :: proc(self: inout, k: int) -> (left: View_Mut(T), right: View_Mut(T)) ---;

	// Private to the package, but a public declaration names it.
	split_rows_whole :: proc(self: move, k: int) -> (left: View_Mut(T), right: View_Mut(T)) ---;

	// Private to the package, but a public declaration names it.
	split_rows_borrowed :: proc(self: inout, k: int) -> (left: View_Mut(T), right: View_Mut(T)) ---;

	// Sets every element to `value`.
	fill :: proc(self, value: T) ---;

	// Copies `source`, which must have this view's shape.
	copy_from :: proc(self, source: View(T)) ---;

	// Multiplies every element by `s`, as `element*s`.
	scale_by :: proc(self, s: T) ---;

	// Adds `s` times `a`, which must have this view's shape: each element becomes `element + s*a[r, c]`.
	add_scaled :: proc(self, s: T, a: View(T)) ---;

	// Rows in brackets, as `Matrix(T)` prints.
	format :: proc(self: ^, writer: fmt.Writer, options: fmt.Options) ---;
}
