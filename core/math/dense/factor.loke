// dense-matrix-plan.md "Factorizations are values" and "Algorithms": each
// factorization is a record that owns its factors, with an in-place form for
// a caller who owns the storage. Every update in a factorization is one
// subtraction per term into the running element, in increasing `k`, the
// order a blocked form must keep.
@(public)
package dense;

import "core:math/linalg";
import "core:mem";
import "core:thread";
import "core:unsafe";

/**
	The factors of `P A = L U` for a square `A`: `L` unit lower triangular,
	`U` upper triangular, and `P` the row swaps partial pivoting chose.
	`lu(a)` makes one.
*/
Lu :: struct($T: type) where linalg.Scalar(T) {
	@(private) packed: Matrix(T),     // L below the diagonal, U on and above
	@(private) swaps:  [dynamic]int,
	@(private) norm:   T.Real,        // the 1-norm of A over norm_scale, for reciprocal_condition
	@(private) norm_scale: T.Real,    // 1, or the scaling_limit when the 1-norm overflows
}

/**
	Overwrites the square `a` with its LU factors, `L` below the diagonal and
	`U` on and above it, and `pivots[k]` with the row swapped with row `k` at
	step `k`, as LAPACK's `getrf` does. The pivot is the first element of
	largest magnitude in its column, a complex element's magnitude being
	`|re| + |im|` as in LAPACK, the multipliers are `a[r, k] / a[k, k]`,
	and each trailing element is `((a - l[r, 0]*u[0, c]) - l[r, 1]*u[1, c]) -
	...`. `.Singular` for an exact zero pivot or a factor that is not finite,
	with `a` and `pivots` then unspecified. A shape mismatch panics.

	With a `pool`, the trailing columns of each block of steps are updated
	as tasks on its workers, each element in the same order, so the result
	is the same bits.
*/
lu_in_place :: proc(a: View_Mut($T), pivots: []mut int, pool: Option(^thread.Pool) = .none) -> Status(Error) where linalg.Scalar(T) {
	n := a.row_count;
	assert(a.column_count == n && pivots.len() == n, "dense.lu_in_place needs a square matrix and one pivot per row");
	m := unsafe.raw_data(a.data);
	rs := a.row_stride;
	cs := a.column_stride;
	switch (blocked_lu(a, pivots, pool)) {
	case .Done:
	case .Singular:
		return .err(.Singular);
	case .Not_Run:
		if (!eliminate(m, rs, cs, n, 0, n, 0, n, pivots)) { return .err(.Singular); }
	}
	foreach (c in 0 ..< n) {
		foreach (r in 0 ..< n) {
			if (!finite(m[offset(r, c, rs, cs)])) { return .err(.Singular); }
		}
	}
	return .ok;
}

// Steps `k0 ..< k1` of `lu_in_place`'s elimination on the `n x n` storage
// `m`: the pivot search in column `k`, the row swap on columns
// `first ..< last`, the multipliers, and the update of columns
// `k + 1 ..< last`. False at a zero pivot.
@(private)
eliminate :: proc(m: [^]$T, rs, cs, n, k0, k1, first, last: int, pivots: []mut int) -> bool where linalg.Scalar(T) {
	foreach (k in k0 ..< k1) {
		pivot := k;
		largest := magnitude1(m[offset(k, k, rs, cs)]);
		foreach (r in k + 1 ..< n) {
			candidate := magnitude1(m[offset(r, k, rs, cs)]);
			if (largest < candidate) {
				pivot = r;
				largest = candidate;
			}
		}
		if (!(T.Real(0) < largest)) { return false; }
		pivots[k] = pivot;
		if (pivot != k) {
			foreach (c in first ..< last) {
				held := m[offset(k, c, rs, cs)];
				m[offset(k, c, rs, cs)] = m[offset(pivot, c, rs, cs)];
				m[offset(pivot, c, rs, cs)] = held;
			}
		}
		diagonal := m[offset(k, k, rs, cs)];
		foreach (r in k + 1 ..< n) {
			at := offset(r, k, rs, cs);
			m[at] = m[at]/diagonal;
		}
		foreach (c in k + 1 ..< last) {
			factor := m[offset(k, c, rs, cs)];
			foreach (r in k + 1 ..< n) {
				at := offset(r, c, rs, cs);
				m[at] = m[at] - m[offset(r, k, rs, cs)]*factor;
			}
		}
	}
	return true;
}

// The columns of one panel of the blocked LU.
@(private) LU_PANEL :: 64;

@(private)
Blocked :: enum { Not_Run, Done, Singular }

// `lu_in_place` by blocks of `LU_PANEL` columns, for `f32` and `f64` with
// contiguous columns, the work right of each panel shared among `pool`'s
// tasks by columns when there is one: `.Not_Run`, with nothing done, for any other matrix,
// and `.Singular` at the zero pivot `eliminate` would stop at. Each element receives the same
// updates in the same order as from `eliminate` over the whole matrix:
// the panel's steps on its own columns; its row swaps, in order, on the
// other columns, which gives the same values because a row's updates use
// multipliers that move with it; the rows of `U` right of the panel,
// `((a - l0*u0) - l1*u1) - ...` in increasing `k`; and the trailing block
// `A22 - L21 U12` by `fast_product`, one subtraction per term in increasing
// `k`.
@(private)
blocked_lu :: proc(a: View_Mut($T), pivots: []mut int, pool: Option(^thread.Pool)) -> Blocked where linalg.Scalar(T) {
	n := a.row_count;
	when (T != f64 && T != f32) { return .Not_Run; }
	if (a.row_stride != 1 || n <= LU_PANEL) { return .Not_Run; }
	m := unsafe.raw_data(a.data);
	cs := a.column_stride;
	whole := a;
	k0 := 0;
	for (k0 < n) {
		k1 := k0 + LU_PANEL if k0 + LU_PANEL < n else n;
		if (!eliminate(m, 1, cs, n, k0, k1, k0, k1, pivots)) { return .Singular; }
		// The swaps left of the panel, column by column so that each column
		// is read once.
		foreach (c in 0 ..< k0) {
			column := c*%cs;
			foreach (k in k0 ..< k1) {
				p := pivots[k];
				if (p != k) { swap_elements(m, k +% column, p +% column); }
			}
		}
		if (k1 < n) {
			left, right := whole.split_columns(k1);
			panel := left.as_view().block(k0, k0, n - k0, k1 - k0);
			switch (pool) {
			case .none:    update_columns(move(right), panel, pivots[k0:k1], k0);
			case .some(p): parallel_update(move(right), panel, pivots[k0:k1], k0, p);
			}
		}
		k0 = k1;
	}
	return .Done;
}

// The columns right of a panel of `blocked_lu`, rows `0 ..< n`, given the
// panel's rows `k0 ..< n` and its pivots: the panel's swaps, in order, column
// by column; the rows of `U` the panel covers,
// `((a - l0*u0) - l1*u1) - ...` in increasing `k`; and the rows below by
// `fast_product`, one subtraction per term in increasing `k`.
@(private)
update_columns :: proc(right: View_Mut($T), panel: View(T), swaps: []int, k0: int) where linalg.Scalar(T) {
	m := unsafe.raw_data(right.data);
	l := unsafe.raw_data(panel.data);
	cs := right.column_stride;
	lc := panel.column_stride;
	n := right.row_count;
	w := panel.column_count;
	k1 := k0 + w;
	foreach (c in 0 ..< right.column_count) {
		column := c*%cs;
		top := k0 +% column;
		foreach (t in 0 ..< w) {
			p := swaps[t];
			if (p != k0 +% t) { swap_elements(m, top +% t, p +% column); }
		}
		foreach (t in 0 ..< w) {
			factor := m[top +% t];
			source := t*%lc;
			foreach (i in t + 1 ..< w) { m[top +% i] = m[top +% i] - l[i +% source]*factor; }
		}
	}
	when (T == f64) {
		fast_product(m[k1:], cs, l[w:], lc, m[k0:], 1, cs, n - k1, right.column_count, w, true, true, 4);
	}
	when (T == f32) {
		fast_product(m[k1:], cs, l[w:], lc, m[k0:], 1, cs, n - k1, right.column_count, w, true, true, 8);
	}
}

// `update_columns` on blocks of the columns, in `pool`'s tasks, until each is
// about a task's worth. Each column is updated as `update_columns` updates
// it, so the blocks change no bit.
@(private)
parallel_update :: proc(right: View_Mut($T), panel: View(T), swaps: []int, k0: int, pool: ^thread.Pool) where linalg.Scalar(T) {
	n := right.column_count;
	if (n < 2*COLUMNS || right.row_count*n*panel.column_count < 2*TASK_WORK) {
		update_columns(right, panel, swaps, k0);
		return;
	}
	half := n/2/COLUMNS*COLUMNS;
	whole := right;
	first, second := move(whole).split_columns(half);
	parallel (pool) {
		spawn parallel_update(move(first), panel, swaps, k0, pool);
		parallel_update(move(second), panel, swaps, k0, pool);
	}
}

@(private)
swap_elements :: proc(m: [^]$T, i, j: int) {
	held := m[i];
	m[i] = m[j];
	m[j] = held;
}

/// The LU factors of the square `a`, allocated from `allocator`, or `.Singular` as `lu_in_place` decides it, with its use of a `pool`.
lu :: proc(a: View($T), allocator: Allocator = mem.default_allocator(), pool: Option(^thread.Pool) = .none) -> Result(Lu(T), Error) where linalg.Scalar(T) {
	assert(a.row_count == a.column_count, "dense.lu needs a square matrix");
	factors := Matrix(T).from_view(a, allocator);
	pivots := make([dynamic]int, a.row_count, allocator);
	lu_in_place(factors.view_mut(), &mut pivots[:], pool) or_return;
	norm := norm_one(a);
	norm_scale := T.Real(1);
	if (!real_finite(norm)) {
		// The factors are finite, so the elements are and a column sum
		// overflowed: it is summed again with each element over the limit.
		norm_scale = scaling_limit(T.Real);
		norm = scaled_norm_one(a, T.Real(1)/norm_scale);
	}
	return .ok(Lu(T){move(factors), move(pivots), norm, norm_scale});
}

// `norm_one` of `a` with each element multiplied by `scale` first.
@(private)
scaled_norm_one :: proc(a: View($T), scale: T.Real) -> T.Real where linalg.Scalar(T) {
	best := T.Real(0);
	foreach (c in 0 ..< a.column_count) {
		sum := T.Real(0);
		foreach (r in 0 ..< a.row_count) { sum = sum + modulus(times_real(scale, a[r, c])); }
		if (best < sum) { best = sum; }
	}
	return best;
}

impl Lu($T) {
	/// The order of the factored matrix.
	size :: proc(self) -> int { return self.packed.row_count; }

	/// Both factors in one view, as `lu_in_place` leaves them: `L` below the diagonal, its unit diagonal not stored, and `U` on and above it.
	factors :: proc(self: ^) -> View(T) { return self.packed.view(); }

	/// `pivots()[k]` is the row swapped with row `k` at step `k`.
	pivots :: proc(self: ^) -> []int { return self.swaps[:]; }

	/**
		Overwrites `b` with the solution `x` of `A x = b`, for each of its
		columns: the row swaps in order, then `L y = b` and `U x = y` in the
		order `solve_lower_into` and `solve_upper_into` give. A shape
		mismatch panics. It does not fail: the factorization decided
		singularity, and a solution too large for `T` is infinite.
	*/
	solve_into :: proc(self, b: View_Mut(T)) {
		n := self.packed.row_count;
		assert(b.row_count == n, "dense.Lu.solve_into: shapes do not agree");
		x := b;
		foreach (k in 0 ..< n) {
			p := self.swaps[k];
			if (p != k) {
				foreach (j in 0 ..< b.column_count) {
					held := x[k, j];
					x[k, j] = x[p, j];
					x[p, j] = held;
				}
			}
		}
		f := self.packed.view();
		lower_solve(f, x, true);
		upper_solve(f, x, false);
	}

	/// The solution of `A x = b`, allocated from `allocator`.
	solve :: proc(self, b: View(T), allocator: Allocator = mem.default_allocator()) -> Matrix(T) {
		result := Matrix(T).from_view(b, allocator);
		self.solve_into(result.view_mut());
		return result;
	}

	/// `A^-1`, by solving for the identity, allocated from `allocator`.
	inverse :: proc(self, allocator: Allocator = mem.default_allocator()) -> Matrix(T) {
		result := Matrix(T).identity(self.packed.row_count, allocator);
		self.solve_into(result.view_mut());
		return result;
	}

	/// The determinant: the product of `U`'s diagonal in order, negated at each row swap.
	determinant :: proc(self) -> T {
		result := T(1);
		foreach (k in 0 ..< self.packed.row_count) {
			result = result*self.packed[k, k];
			if (self.swaps[k] != k) { result = -result; }
		}
		return result;
	}

	/**
		An estimate of `1 / (|A|_1 |A^-1|_1)`, the reciprocal of the 1-norm
		condition number: near 1 for a well-conditioned matrix, and near or
		below the precision of `T` for one that is numerically singular.
		`|A^-1|_1` is estimated as LAPACK's `gecon` does, by Hager's method
		with Higham's refinements (at most five iterations, then an
		alternating-sign test vector), which is a lower bound and rarely low
		by more than a factor of 3; for a complex `T` as `zgecon` does, the
		signs being the units `x / |x|`. 1 for a 0 x 0 matrix. Its scratch
		vector is allocated from `allocator`.

		Each vector the estimator solves for is multiplied by `sigma`, the
		largest power of two not above `|A|_1` but at least the smallest
		normal number and at most half the largest finite power of two, so
		that the solutions of a well-conditioned matrix neither overflow nor
		underflow, and the result is `(sigma / e) / |A|_1` for the estimate
		`e` of `sigma |A^-1|_1`. A power of two changes the rounding of no
		value that is not subnormal, so multiplying `A` by a power of two
		changes no bit of the result where neither the factorization nor the
		estimate reaches a subnormal value. When the sum `|A|_1` overflows,
		it is formed from each element multiplied by `1/big`, for `big` the
		largest power of two whose square is finite, and multiplied back
		within the quotient. 0 when the estimate of `sigma |A^-1|_1` is not
		finite.
	*/
	reciprocal_condition :: proc(self, allocator: Allocator = mem.default_allocator()) -> T.Real {
		n := self.packed.row_count;
		if (n == 0) { return T.Real(1); }
		if (self.norm == T.Real(0)) { return T.Real(0); }
		sigma := power_of_two_below(self.norm*self.norm_scale);
		// The alternating vector reaches 2 sigma.
		if (!real_finite(T.Real(2)*sigma)) { sigma = T.Real(0.5)*sigma; }
		estimate := self.inverse_norm_estimate(sigma, allocator);
		if (!real_finite(estimate)) { return T.Real(0); }
		return ((sigma/self.norm_scale)/estimate)/self.norm;
	}

	// Higham's form of Hager's estimator, as LAPACK's `lacn2` has it, with
	// the sign vector kept in `signs`, or as `zlacn2` has it for a complex
	// `T`, which does not test for repeated signs. Each sum is in index order.
	// Every right-hand side is multiplied by `sigma`, so the estimate is of
	// `sigma |A^-1|_1`.
	@(private) inverse_norm_estimate :: proc(self, sigma: T.Real, allocator: Allocator) -> T.Real where linalg.Scalar(T) {
		n := self.packed.row_count;
		x := Matrix(T).filled(n, 1, times_real(sigma, T(1)/from_f64(T, f64(n))), allocator);
		self.solve_into(x.view_mut());
		if (n == 1) { return modulus(x[0, 0]); }
		estimate := absolute_sum(x.view());
		signs := Matrix(T).zeros(n, 1, allocator);
		foreach (i in 0 ..< n) {
			signs[i, 0] = sign_of(x[i, 0]);
			x[i, 0] = times_real(sigma, signs[i, 0]);
		}
		self.solve_adjoint_into(x.view_mut());
		j := largest_index(x.view());
		iteration := 2;
		for (;;) {
			x.view_mut().fill(T(0));
			x[j, 0] = T(sigma);
			self.solve_into(x.view_mut());
			previous := estimate;
			estimate = absolute_sum(x.view());
			repeated := false;
			when (T == T.Real) {
				repeated = true;
				foreach (i in 0 ..< n) {
					if (!(sign_of(x[i, 0]) == signs[i, 0])) { repeated = false; }
				}
			}
			if (repeated || !(previous < estimate)) { break; }
			foreach (i in 0 ..< n) {
				signs[i, 0] = sign_of(x[i, 0]);
				x[i, 0] = times_real(sigma, signs[i, 0]);
			}
			self.solve_adjoint_into(x.view_mut());
			last := j;
			j = largest_index(x.view());
			if (modulus(x[last, 0]) == modulus(x[j, 0]) || iteration >= 5) { break; }
			iteration += 1;
		}
		alternating := T(1);
		foreach (i in 0 ..< n) {
			x[i, 0] = times_real(sigma, alternating*(T(1) + from_f64(T, f64(i))/from_f64(T, f64(n - 1))));
			alternating = -alternating;
		}
		self.solve_into(x.view_mut());
		alternative := T.Real(2)*(absolute_sum(x.view())/T.Real(f64(3*n)));
		if (estimate < alternative) { estimate = alternative; }
		return estimate;
	}

	// Overwrites `b` with the solution of `A^H x = b`: with `A = P^T L U`,
	// `U^H y = b`, then `L^H z = y`, then the row swaps undone in reverse.
	@(private) solve_adjoint_into :: proc(self, b: View_Mut(T)) {
		n := self.packed.row_count;
		x := b;
		f := self.packed.view().adjoint();
		lower_solve(f, x, false);
		upper_solve(f, x, true);
		for (k := n - 1; k >= 0; k -= 1) {
			p := self.swaps[k];
			if (p != k) {
				foreach (j in 0 ..< b.column_count) {
					held := x[k, j];
					x[k, j] = x[p, j];
					x[p, j] = held;
				}
			}
		}
	}
}

// -1 or 1 for a real `T`, and for a complex one the unit `z / |z|`, or 1
// for zero.
@(private)
sign_of :: proc(value: $T) -> T where linalg.Scalar(T) {
	when (T == T.Real) {
		return real_sign(value);
	} else {
		size := modulus(value);
		return value/T(size) if T.Real(0) < size else T(1);
	}
}

@(private)
real_sign :: proc(value: $R) -> R where linalg.Real(R) {
	return -R(1) if value < R(0) else R(1);
}

// `T(x)` through `T.Real`, which is `T(x)` itself for a real `T`.
@(private)
from_f64 :: proc($T: type, x: f64) -> T where linalg.Scalar(T) {
	return T(T.Real(x));
}

@(private)
absolute_sum :: proc(x: View($T)) -> T.Real where linalg.Scalar(T) {
	sum := T.Real(0);
	foreach (i in 0 ..< x.row_count) { sum = sum + modulus(x[i, 0]); }
	return sum;
}

// The first index of largest magnitude.
@(private)
largest_index :: proc(x: View($T)) -> int where linalg.Scalar(T) {
	best := 0;
	largest := modulus(x[0, 0]);
	foreach (i in 1 ..< x.row_count) {
		candidate := modulus(x[i, 0]);
		if (largest < candidate) {
			best = i;
			largest = candidate;
		}
	}
	return best;
}

/**
	The factor `L` of `A = L L^H` for a Hermitian positive definite `A`, with
	`L` lower triangular and a positive real diagonal; for a real `T`,
	`A = L L^T` for a symmetric `A`. `cholesky(a)` makes one.
*/
Cholesky :: struct($T: type) where linalg.Scalar(T) {
	@(private) factor: Matrix(T),   // L, with zeros above the diagonal
}

/**
	Overwrites the lower triangle of the square `a` with `L`, column by
	column; the elements above the diagonal are neither read nor written, so
	`A` is taken as Hermitian without a check. Each element of column `j` is
	`((a - l[i, 0]*conj(l[j, 0])) - l[i, 1]*conj(l[j, 1])) - ...`, `conj`
	being nothing for a real `T`; then the square root of the diagonal's real
	part, its imaginary part dropped, and the elements below it divided by
	that. `.Not_Positive_Definite`, with `a` unspecified, for a diagonal
	whose real part is not positive and finite before its square root. A
	shape mismatch panics.

	With a `pool`, the columns right of each block of columns are updated as
	tasks on its workers, each element in the same order, so the result is
	the same bits.
*/
cholesky_in_place :: proc(a: View_Mut($T), pool: Option(^thread.Pool) = .none) -> Status(Error) where linalg.Scalar(T) {
	n := a.row_count;
	assert(a.column_count == n, "dense.cholesky_in_place needs a square matrix");
	switch (blocked_cholesky(a, pool)) {
	case .Done:     return .ok;
	case .Singular: return .err(.Not_Positive_Definite);
	case .Not_Run:
	}
	m := unsafe.raw_data(a.data);
	if (!cholesky_columns(m, a.row_stride, a.column_stride, n, 0, n, 0)) { return .err(.Not_Positive_Definite); }
	return .ok;
}

// Columns `j0 ..< j1` of `cholesky_in_place`, each with its terms from
// `first` on, the earlier ones already subtracted. False at a diagonal that
// is not positive and finite.
@(private)
cholesky_columns :: proc(m: [^]$T, rs, cs, n, j0, j1, first: int) -> bool where linalg.Scalar(T) {
	foreach (j in j0 ..< j1) {
		foreach (k in first ..< j) {
			factor := conj(m[offset(j, k, rs, cs)]);
			foreach (i in j ..< n) {
				at := offset(i, j, rs, cs);
				m[at] = m[at] - m[offset(i, k, rs, cs)]*factor;
			}
		}
		// Every element below the diagonal reaches a later diagonal through
		// its squared modulus, so this test also rejects a factor that is not
		// finite.
		d := m[offset(j, j, rs, cs)].real_part();
		if (!(T.Real(0) < d && real_finite(d))) { return false; }
		root := T(real_sqrt(d));
		m[offset(j, j, rs, cs)] = root;
		foreach (i in j + 1 ..< n) {
			at := offset(i, j, rs, cs);
			m[at] = m[at]/root;
		}
	}
	return true;
}

// The columns of one panel of the blocked Cholesky.
@(private) CHOLESKY_PANEL :: 32;

// `cholesky_in_place` by blocks of `CHOLESKY_PANEL` columns, for `f32` and
// `f64` with contiguous columns: `.Not_Run`, with nothing done, for any other
// matrix, and `.Singular` where `cholesky_columns` would fail. Each element
// receives its terms in the same order as from `cholesky_columns` over the
// whole matrix. On the calling thread the blocks are left-looking, which
// moves less memory; with a `pool` they are right-looking, whose updates can
// be shared out by columns.
@(private)
blocked_cholesky :: proc(a: View_Mut($T), pool: Option(^thread.Pool)) -> Blocked where linalg.Scalar(T) {
	when (T != f64 && T != f32) { return .Not_Run; }
	if (a.row_stride != 1 || a.row_count <= CHOLESKY_PANEL) { return .Not_Run; }
	switch (pool) {
	case .none:    return left_looking(a);
	case .some(p): return right_looking(a, p);
	}
}

// Each panel's terms from the earlier columns by `fast_product`, one
// subtraction each in increasing `k`, then its own by `cholesky_columns`. The
// diagonal block is computed whole in a copy, and only its lower triangle
// written back, so nothing above the diagonal is read or written.
@(private)
left_looking :: proc(a: View_Mut($T)) -> Blocked where linalg.Scalar(T) {
	n := a.row_count;
	m := unsafe.raw_data(a.data);
	cs := a.column_stride;
	square: [CHOLESKY_PANEL*CHOLESKY_PANEL]T = {};
	block := unsafe.raw_data(&square);
	j0 := 0;
	for (j0 < n) {
		j1 := j0 + CHOLESKY_PANEL if j0 + CHOLESKY_PANEL < n else n;
		w := j1 - j0;
		if (j0 > 0) {
			foreach (c in 0 ..< w) {
				foreach (r in 0 ..< w) { block[r +% c*%w] = m[(j0 + r) +% (j0 + c)*%cs] if c <= r else T(0); }
			}
			// L[J, 0:j0] times its transpose, and L[j1:n, 0:j0] times it.
			when (T == f64) {
				fast_product(block, w, m[j0:], cs, m[j0:], cs, 1, w, w, j0, true, true, 4);
				if (j1 < n) { fast_product(m[j1 + j0*cs:], cs, m[j1:], cs, m[j0:], cs, 1, n - j1, w, j0, true, true, 4); }
			}
			when (T == f32) {
				fast_product(block, w, m[j0:], cs, m[j0:], cs, 1, w, w, j0, true, true, 8);
				if (j1 < n) { fast_product(m[j1 + j0*cs:], cs, m[j1:], cs, m[j0:], cs, 1, n - j1, w, j0, true, true, 8); }
			}
			foreach (c in 0 ..< w) {
				foreach (r in c ..< w) { m[(j0 + r) +% (j0 + c)*%cs] = block[r +% c*%w]; }
			}
		}
		if (!cholesky_columns(m, 1, cs, n, j0, j1, j0)) { return .Singular; }
		j0 = j1;
	}
	return .Done;
}

// Each panel by `cholesky_columns`, then its terms subtracted from every
// later column, those columns shared among `pool`'s tasks.
@(private)
right_looking :: proc(a: View_Mut($T), pool: ^thread.Pool) -> Blocked where linalg.Scalar(T) {
	n := a.row_count;
	m := unsafe.raw_data(a.data);
	cs := a.column_stride;
	whole := a;
	j0 := 0;
	for (j0 < n) {
		j1 := j0 + CHOLESKY_PANEL if j0 + CHOLESKY_PANEL < n else n;
		if (!cholesky_columns(m, 1, cs, n, j0, j1, j0)) { return .Singular; }
		if (j1 < n) {
			left, right := whole.split_columns(j1);
			panel := left.as_view().block(0, j0, n, j1 - j0);
			parallel_trailing(move(right), panel, j1, pool);
		}
		j0 = j1;
	}
	return .Done;
}

// Subtracts a factored panel's terms from the lower triangle of the columns
// `right` holds, rows `0 ..< n`, the first of them column `g0` of the matrix:
// `CHOLESKY_PANEL` columns at a time, the diagonal block computed whole in a
// copy and only its lower triangle written back, so nothing above the
// diagonal is read or written, and the rows below it by `fast_product`, one
// subtraction per term in increasing `k`.
@(private)
trailing_update :: proc(right: View_Mut($T), panel: View(T), g0: int) where linalg.Scalar(T) {
	m := unsafe.raw_data(right.data);
	l := unsafe.raw_data(panel.data);
	cs := right.column_stride;
	lc := panel.column_stride;
	n := right.row_count;
	w := panel.column_count;
	count := right.column_count;
	square: [CHOLESKY_PANEL*CHOLESKY_PANEL]T = {};
	block := unsafe.raw_data(&square);
	c0 := 0;
	for (c0 < count) {
		c1 := c0 + CHOLESKY_PANEL if c0 + CHOLESKY_PANEL < count else count;
		width := c1 - c0;
		g := g0 + c0;
		below := g + width;
		foreach (c in 0 ..< width) {
			foreach (r in 0 ..< width) { block[r +% c*%width] = m[(g + r) +% (c0 + c)*%cs] if c <= r else T(0); }
		}
		when (T == f64) {
			fast_product(block, width, l[g:], lc, l[g:], lc, 1, width, width, w, true, true, 4);
			if (below < n) { fast_product(m[below + c0*cs:], cs, l[below:], lc, l[g:], lc, 1, n - below, width, w, true, true, 4); }
		}
		when (T == f32) {
			fast_product(block, width, l[g:], lc, l[g:], lc, 1, width, width, w, true, true, 8);
			if (below < n) { fast_product(m[below + c0*cs:], cs, l[below:], lc, l[g:], lc, 1, n - below, width, w, true, true, 8); }
		}
		foreach (c in 0 ..< width) {
			foreach (r in c ..< width) { m[(g + r) +% (c0 + c)*%cs] = block[r +% c*%width]; }
		}
		c0 = c1;
	}
}

// `trailing_update` on blocks of the columns, in `pool`'s tasks, until each
// is about a task's worth. Each column is updated as `trailing_update`
// updates it, so the blocks change no bit.
@(private)
parallel_trailing :: proc(right: View_Mut($T), panel: View(T), g0: int, pool: ^thread.Pool) where linalg.Scalar(T) {
	n := right.column_count;
	rows := right.row_count - g0;
	if (n < 2*COLUMNS || rows*n*panel.column_count < 2*TASK_WORK) {
		trailing_update(right, panel, g0);
		return;
	}
	// The columns on the left reach further down, so they take less than half.
	half := n/3/COLUMNS*COLUMNS if n >= 3*COLUMNS else COLUMNS;
	whole := right;
	first, second := move(whole).split_columns(half);
	parallel (pool) {
		spawn parallel_trailing(move(first), panel, g0, pool);
		parallel_trailing(move(second), panel, g0 + half, pool);
	}
}

/// The Cholesky factor of the square `a`, from its lower triangle, allocated from `allocator`, with `cholesky_in_place`'s use of a `pool`.
cholesky :: proc(a: View($T), allocator: Allocator = mem.default_allocator(), pool: Option(^thread.Pool) = .none) -> Result(Cholesky(T), Error) where linalg.Scalar(T) {
	n := a.row_count;
	assert(a.column_count == n, "dense.cholesky needs a square matrix");
	factor := Matrix(T).zeros(n, n, allocator);
	foreach (c in 0 ..< n) {
		foreach (r in c ..< n) { factor[r, c] = a[r, c]; }
	}
	cholesky_in_place(factor.view_mut(), pool) or_return;
	return .ok(Cholesky(T){move(factor)});
}

impl Cholesky($T) {
	/// The order of the factored matrix.
	size :: proc(self) -> int { return self.factor.row_count; }

	/// `L`, with zeros above the diagonal, borrowed from the factorization.
	lower :: proc(self: ^) -> View(T) { return self.factor.view(); }

	/// Overwrites `b` with the solution of `A x = b`: `L y = b`, then `L^H x = y`, in the triangular solves' orders.
	solve_into :: proc(self, b: View_Mut(T)) {
		assert(b.row_count == self.factor.row_count, "dense.Cholesky.solve_into: shapes do not agree");
		f := self.factor.view();
		lower_solve(f, b, false);
		upper_solve(f.adjoint(), b, false);
	}

	/// The solution of `A x = b`, allocated from `allocator`.
	solve :: proc(self, b: View(T), allocator: Allocator = mem.default_allocator()) -> Matrix(T) {
		result := Matrix(T).from_view(b, allocator);
		self.solve_into(result.view_mut());
		return result;
	}

	/// The determinant, `p*p` for `p` the product of `L`'s diagonal in order, which is real.
	determinant :: proc(self) -> T {
		p := T(1);
		foreach (k in 0 ..< self.factor.row_count) { p = p*self.factor[k, k]; }
		return p*p;
	}
}

/// The solution of `A x = b` for the square `a`, by `lu`; `.Singular` as `lu` decides it.
solve :: proc(a, b: View($T), allocator: Allocator = mem.default_allocator()) -> Result(Matrix(T), Error) where linalg.Scalar(T) {
	factors := lu(a, allocator) or_return;
	return .ok(factors.solve(b, allocator));
}

/// `a^-1` for the square `a`, by `lu`; `.Singular` as `lu` decides it.
inverse :: proc(a: View($T), allocator: Allocator = mem.default_allocator()) -> Result(Matrix(T), Error) where linalg.Scalar(T) {
	factors := lu(a, allocator) or_return;
	return .ok(factors.inverse(allocator));
}
