	unit_x :: proc() -> Vector3(T) ---;

	unit_y :: proc() -> Vector3(T) ---;

	unit_z :: proc() -> Vector3(T) ---;

	from_array :: proc(values: [3]T) -> Vector3(T) ---;

	to_array :: proc(self) -> [3]T ---;

	// Each component converted as the scalar `T(value)` is.
	from_vector :: hook(convert) proc(v: Vector3($U)) -> Vector3(T) where Converts(U, T) ---;

	add :: operator(+) proc(left, right: Vector3(T)) -> Vector3(T) ---;

	subtract :: operator(-) proc(left, right: Vector3(T)) -> Vector3(T) ---;

	negate :: operator(-) proc(self: Vector3(T)) -> Vector3(T) ---;

	// Component-wise.
	multiply :: operator(*) proc(left, right: Vector3(T)) -> Vector3(T) ---;

	scale :: operator(*) proc(left: Vector3(T), right: T) -> Vector3(T) ---;

	scale_left :: operator(*) proc(left: T, right: Vector3(T)) -> Vector3(T) ---;

	// Component-wise.
	divide :: operator(/) proc(left, right: Vector3(T)) -> Vector3(T) ---;

	divide_scalar :: operator(/) proc(left: Vector3(T), right: T) -> Vector3(T) ---;

	// Exact and component-wise: a NaN component is unequal.
	equal :: operator(==) proc(left, right: Vector3(T)) -> bool where interfaces.Equatable(T) ---;

	// The component at `index`, 0 for `x`; any other index panics.
	get :: operator([]) proc(self, index: int) -> T ---;

	get_mut :: operator([]) proc(self: inout, index: int) -> inout T ---;

	// `(x*x' + y*y') + z*z'`.
	dot :: proc(self, other: Vector3(T)) -> T ---;

	length_squared :: proc(self) -> T ---;

	distance_squared :: proc(self, other: Vector3(T)) -> T ---;

	// The right-handed cross product: `unit_x().cross(unit_y()) == unit_z()`.
	cross :: proc(self, other: Vector3(T)) -> Vector3(T) ---;

	extend :: proc(self, w: T) -> Vector4(T) ---;

	xy :: proc(self) -> Vector2(T) ---;

	// Component-wise `math.min`.
	min :: proc(self, other: Vector3(T)) -> Vector3(T) where interfaces.Ordered(T) ---;

	// Component-wise `math.max`.
	max :: proc(self, other: Vector3(T)) -> Vector3(T) where interfaces.Ordered(T) ---;

	// The square root of `length_squared`.
	length :: proc(self) -> T where Real(T) ---;

	distance :: proc(self, other: Vector3(T)) -> T where Real(T) ---;

	/*
		The vector divided by its length, or `.none` when its squared length is
		not `is_normal`: zero, a vector whose squares underflow or overflow, or
		one with a NaN or infinite component.
	*/
	normalize :: proc(self) -> Option(Vector3(T)) where Real(T) ---;

	// `normalize`, or `fallback` where it has no answer.
	normalize_or :: proc(self, fallback: Vector3(T)) -> Vector3(T) where Real(T) ---;

	// `self*(1 - t) + other*t` per component, exact at both ends.
	lerp :: proc(self, other: Vector3(T), t: T) -> Vector3(T) where Real(T) ---;

	abs :: proc(self) -> Vector3(T) where Real(T) ---;

	floor :: proc(self) -> Vector3(T) where Real(T) ---;

	ceil :: proc(self) -> Vector3(T) where Real(T) ---;

	round :: proc(self) -> Vector3(T) where Real(T) ---;

	// `(x, y, z)`, each component with the caller's options.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) ---;
}

impl Vector4($T) {
	from_components :: proc(x, y, z, w: T) -> Vector4(T) ---;

	splat :: proc(value: T) -> Vector4(T) ---;

	unit_x :: proc() -> Vector4(T) ---;

	unit_y :: proc() -> Vector4(T) ---;

	unit_z :: proc() -> Vector4(T) ---;

	unit_w :: proc() -> Vector4(T) ---;

	from_array :: proc(values: [4]T) -> Vector4(T) ---;

	to_array :: proc(self) -> [4]T ---;

	// Each component converted as the scalar `T(value)` is.
	from_vector :: hook(convert) proc(v: Vector4($U)) -> Vector4(T) where Converts(U, T) ---;

	add :: operator(+) proc(left, right: Vector4(T)) -> Vector4(T) ---;

	subtract :: operator(-) proc(left, right: Vector4(T)) -> Vector4(T) ---;

	negate :: operator(-) proc(self: Vector4(T)) -> Vector4(T) ---;

	// Component-wise.
	multiply :: operator(*) proc(left, right: Vector4(T)) -> Vector4(T) ---;

	scale :: operator(*) proc(left: Vector4(T), right: T) -> Vector4(T) ---;

	scale_left :: operator(*) proc(left: T, right: Vector4(T)) -> Vector4(T) ---;

	// Component-wise.
	divide :: operator(/) proc(left, right: Vector4(T)) -> Vector4(T) ---;

	divide_scalar :: operator(/) proc(left: Vector4(T), right: T) -> Vector4(T) ---;

	// Exact and component-wise: a NaN component is unequal.
	equal :: operator(==) proc(left, right: Vector4(T)) -> bool where interfaces.Equatable(T) ---;

	// The component at `index`, 0 for `x`; any other index panics.
	get :: operator([]) proc(self, index: int) -> T ---;

	get_mut :: operator([]) proc(self: inout, index: int) -> inout T ---;

	// `((x*x' + y*y') + z*z') + w*w'`.
	dot :: proc(self, other: Vector4(T)) -> T ---;

	length_squared :: proc(self) -> T ---;

	distance_squared :: proc(self, other: Vector4(T)) -> T ---;

	xyz :: proc(self) -> Vector3(T) ---;

	// Component-wise `math.min`.
	min :: proc(self, other: Vector4(T)) -> Vector4(T) where interfaces.Ordered(T) ---;

	// Component-wise `math.max`.
	max :: proc(self, other: Vector4(T)) -> Vector4(T) where interfaces.Ordered(T) ---;

	// The square root of `length_squared`.
	length :: proc(self) -> T where Real(T) ---;

	distance :: proc(self, other: Vector4(T)) -> T where Real(T) ---;

	/*
		The vector divided by its length, or `.none` when its squared length is
		not `is_normal`: zero, a vector whose squares underflow or overflow, or
		one with a NaN or infinite component.
	*/
	normalize :: proc(self) -> Option(Vector4(T)) where Real(T) ---;

	// `normalize`, or `fallback` where it has no answer.
	normalize_or :: proc(self, fallback: Vector4(T)) -> Vector4(T) where Real(T) ---;

	// `self*(1 - t) + other*t` per component, exact at both ends.
	lerp :: proc(self, other: Vector4(T), t: T) -> Vector4(T) where Real(T) ---;

	abs :: proc(self) -> Vector4(T) where Real(T) ---;

	floor :: proc(self) -> Vector4(T) where Real(T) ---;

	ceil :: proc(self) -> Vector4(T) where Real(T) ---;

	round :: proc(self) -> Vector4(T) where Real(T) ---;

	// `(x, y, z, w)`, each component with the caller's options.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) ---;
}
