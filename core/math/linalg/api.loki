	add :: operator(+) proc(left, right: Vector2(T)) -> Vector2(T) ---;

	subtract :: operator(-) proc(left, right: Vector2(T)) -> Vector2(T) ---;

	negate :: operator(-) proc(self: Vector2(T)) -> Vector2(T) ---;

