// `Complex(T)` and `Quaternion(T)` (design.md "Library numeric types").
//
// Deliberately not primitive: these are ordinary structs with ordinary methods,
// operators, conversion hooks, and formatting, and they get no special
// relationship with the compiler. `tests/run/lib_numeric.loke` writes the
// `T = f64` case out by hand to show a user could.
//
// A scalar converts through `hook(convert)`, written out: `Complex(f64)(x)`.
// That is the ordinary conversion rule, not a numeric special case.
@(public)
package math;

import "core:fmt";
import "base:interfaces";

Complex :: struct($T: type) where interfaces.Numeric(T) {
	real:      T,
	imaginary: T,
}

impl Complex($T) {
	from_components :: proc(real: T, imaginary: T) -> Complex(T) {
		return {real, imaginary};
	}

	from_scalar :: hook(convert) proc(value: T) -> Complex(T) {
		return {value, T(0)};
	}

	add :: operator(+) proc(left, right: Complex(T)) -> Complex(T) {
		return {left.real + right.real, left.imaginary + right.imaginary};
	}

	subtract :: operator(-) proc(left, right: Complex(T)) -> Complex(T) {
		return {left.real - right.real, left.imaginary - right.imaginary};
	}

	negate :: operator(-) proc(self: Complex(T)) -> Complex(T) {
		return {-self.real, -self.imaginary};
	}

	multiply :: operator(*) proc(left, right: Complex(T)) -> Complex(T) {
		return {
			left.real*right.real - left.imaginary*right.imaginary,
			left.real*right.imaginary + left.imaginary*right.real,
		};
	}

	// The textbook form. It overflows for operands whose squares do not fit.
	// `T` here is any `Numeric` type, integers included, so it cannot reach the
	// scaled floating `hypot`; the `f32` and `f64` blocks below replace this
	// member for those two instantiations with one that does not form `c*c+d*d`.
	divide :: operator(/) proc(left, right: Complex(T)) -> Complex(T) {
		denominator := right.real*right.real + right.imaginary*right.imaginary;
		return {
			(left.real*right.real + left.imaginary*right.imaginary)/denominator,
			(left.imaginary*right.real - left.real*right.imaginary)/denominator,
		};
	}

	equal :: operator(==) proc(left, right: Complex(T)) -> bool {
		return left.real == right.real && left.imaginary == right.imaginary;
	}

	conjugate :: proc(self) -> Complex(T) {
		return {self.real, -self.imaginary};
	}

	// The squared magnitude, for any `Numeric` `T`. `abs` needs a square root and
	// therefore a floating `T`, so it lives in the two exact blocks below; an
	// integer instantiation still has this.
	norm_squared :: proc(self) -> T {
		return self.real*self.real + self.imaginary*self.imaginary;
	}

	// `format_to_with` for the components, so the caller's base and case reach
	// them: `T` may be an integer, and a formatter that took `options` only to
	// format with the defaults would spell a `Complex(i32)` in base 10 however
	// it was asked for. The separators are text and read nothing from `options`.
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to_with(writer, options, self.real);
		join(writer, options, self.imaginary, "i");
	}
}

// The Hamilton quaternions: one real part and three imaginary units with
// `i*j == k` and `j*i == -k`, so multiplication does not commute.
Quaternion :: struct($T: type) where interfaces.Numeric(T) {
	real: T,
	i:    T,
	j:    T,
	k:    T,
}

impl Quaternion($T) {
	from_components :: proc(real: T, i: T, j: T, k: T) -> Quaternion(T) {
		return {real, i, j, k};
	}

	from_scalar :: hook(convert) proc(value: T) -> Quaternion(T) {
		return {value, T(0), T(0), T(0)};
	}

	add :: operator(+) proc(left, right: Quaternion(T)) -> Quaternion(T) {
		return {
			left.real + right.real,
			left.i + right.i,
			left.j + right.j,
			left.k + right.k,
		};
	}

	subtract :: operator(-) proc(left, right: Quaternion(T)) -> Quaternion(T) {
		return {
			left.real - right.real,
			left.i - right.i,
			left.j - right.j,
			left.k - right.k,
		};
	}

	negate :: operator(-) proc(self: Quaternion(T)) -> Quaternion(T) {
		return {-self.real, -self.i, -self.j, -self.k};
	}

	multiply :: operator(*) proc(left, right: Quaternion(T)) -> Quaternion(T) {
		return {
			left.real*right.real - left.i*right.i - left.j*right.j - left.k*right.k,
			left.real*right.i + left.i*right.real + left.j*right.k - left.k*right.j,
			left.real*right.j - left.i*right.k + left.j*right.real + left.k*right.i,
			left.real*right.k + left.i*right.j - left.j*right.i + left.k*right.real,
		};
	}

	equal :: operator(==) proc(left, right: Quaternion(T)) -> bool {
		return left.real == right.real
			&& left.i == right.i
			&& left.j == right.j
			&& left.k == right.k;
	}

	conjugate :: proc(self) -> Quaternion(T) {
		return {self.real, -self.i, -self.j, -self.k};
	}

	norm_squared :: proc(self) -> T {
		return self.real*self.real + self.i*self.i + self.j*self.j + self.k*self.k;
	}

	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to_with(writer, options, self.real);
		join(writer, options, self.i, "i");
		join(writer, options, self.j, "j");
		join(writer, options, self.k, "k");
	}
}

// One imaginary component and its unit, after a `+` unless the component prints
// its own `-`: `1-2i`, not `1+-2i`. A float's sign bit decides, so a negative
// zero joins with its `-` too; a NaN prints as `nan` whatever its sign, so it
// takes the `+`. A `T` with no order prints no `-` that this could know about.
@(private)
join :: proc(writer: fmt.Writer, options: fmt.Options, component: $T, unit: string_view)
	where interfaces.Numeric(T) {
	negative := false;
	when (T == f64) {
		negative = sign_bit(component) && !is_nan(component);
	} else when (T == f32) {
		negative = sign_bit_f32(component) && !is_nan_f32(component);
	} else when (T == f16) {
		negative = sign_bit_f32(f32(component)) && !is_nan_f32(f32(component));
	} else when (interfaces.Ordered(T)) {
		negative = component < T(0);
	}
	if (!negative) { fmt.format_to(writer, "+"); }
	fmt.format_to_with(writer, options, component);
	fmt.format_to(writer, unit);
}

// ------------------------------------------------ the floating instances --
//
// design.md "Library numeric types". The generic blocks above are
// constrained by `interfaces.Numeric(T)`, which admits integers and implies no
// ordering, so nothing in them can call an `f32`/`f64` `hypot`. Narrowing the
// types would break existing source, so the new operations live in exact
// specialization blocks instead — a lookup form the language already has, where
// a block written for one instantiation wins for that instantiation and leaves
// every other to the unspecialized one.
//
// Each pair is the same surface twice: the `f64` block over the unsuffixed
// scalar procedures and the `f32` block over the `_f32` ones. There is no third
// spelling, because there is no `f32` -> `f64` widening to hide one behind.

impl Complex(f64) {
	// `hypot`, not `sqrt(norm_squared())`: the magnitude of a complex number
	// whose components are large is representable long after the sum of their
	// squares is not.
	abs :: proc(self) -> f64 {
		return hypot(self.real, self.imaginary);
	}

	// Smith's method: divide through by the larger denominator component, so
	// `c*c + d*d` is never formed. The guarantee is narrow and testable — finite
	// non-zero denominator components do not overflow merely because their
	// squares would. It does not claim bit-for-bit C complex semantics for every
	// NaN/infinity combination.
	divide :: operator(/) proc(left, right: Complex(f64)) -> Complex(f64) {
		// Smith's bounded ratio still leaves one addition in each numerator and
		// denominator. When the denominator is in the top binade, halve all four
		// components; when only the numerator is there, halve it and double the
		// final result. Keeping a tiny denominator unscaled avoids erasing it while
		// still keeping every intermediate addition finite.
		a, b := left.real, left.imaginary;
		c, d := right.real, right.imaginary;
		result_scale := 1.0;
		denominator_largest := max(abs(c), abs(d));
		numerator_largest := max(abs(a), abs(b));
		if (denominator_largest > F64_MAX/2.0) {
			a, b = a*0.5, b*0.5;
			c, d = c*0.5, d*0.5;
		} else if (numerator_largest > F64_MAX/2.0) {
			a, b = a*0.5, b*0.5;
			result_scale = 2.0;
		}
		if (abs(d) <= abs(c)) {
			ratio := d/c;
			denominator := c + d*ratio;
			return {
				((a + b*ratio)/denominator)*result_scale,
				((b - a*ratio)/denominator)*result_scale,
			};
		}
		ratio := c/d;
		denominator := c*ratio + d;
		return {
			((a*ratio + b)/denominator)*result_scale,
			((b*ratio - a)/denominator)*result_scale,
		};
	}

	// Through the specialised division rather than `conjugate/norm_squared`,
	// which would reintroduce the overflow that division just removed.
	inverse :: proc(self) -> Complex(f64) {
		return Complex(f64){1.0, 0.0}/self;
	}
}

impl Complex(f32) {
	abs :: proc(self) -> f32 {
		return hypot_f32(self.real, self.imaginary);
	}

	divide :: operator(/) proc(left, right: Complex(f32)) -> Complex(f32) {
		a, b := left.real, left.imaginary;
		c, d := right.real, right.imaginary;
		result_scale := f32(1.0);
		denominator_largest := max(abs_f32(c), abs_f32(d));
		numerator_largest := max(abs_f32(a), abs_f32(b));
		if (denominator_largest > F32_MAX/f32(2.0)) {
			a, b = a*f32(0.5), b*f32(0.5);
			c, d = c*f32(0.5), d*f32(0.5);
		} else if (numerator_largest > F32_MAX/f32(2.0)) {
			a, b = a*f32(0.5), b*f32(0.5);
			result_scale = f32(2.0);
		}
		if (abs_f32(d) <= abs_f32(c)) {
			ratio := d/c;
			denominator := c + d*ratio;
			return {
				((a + b*ratio)/denominator)*result_scale,
				((b - a*ratio)/denominator)*result_scale,
			};
		}
		ratio := c/d;
		denominator := c*ratio + d;
		return {
			((a*ratio + b)/denominator)*result_scale,
			((b*ratio - a)/denominator)*result_scale,
		};
	}

	inverse :: proc(self) -> Complex(f32) {
		return Complex(f32){f32(1.0), f32(0.0)}/self;
	}
}

impl Quaternion(f64) {
	// Nested `hypot` rather than the root of the sum of four squares: the same
	// overflow and underflow argument, one level deeper. The extra rounding is
	// within the target libm accuracy contract this package promises.
	abs :: proc(self) -> f64 {
		return hypot(hypot(self.real, self.i), hypot(self.j, self.k));
	}

	// `conjugate/norm_squared`, staged so no avoidable overflow happens on the
	// way: every component is divided by the largest magnitude first, which puts
	// the normalized sum of squares in `[1, 4]` whatever the input scale was.
	// A zero quaternion divides zero by zero and yields NaN components, which is
	// the scalar floating rule rather than a special case.
	inverse :: proc(self) -> Quaternion(f64) {
		scale := max(max(abs(self.real), abs(self.i)),
		             max(abs(self.j), abs(self.k)));
		real := self.real/scale;
		i := self.i/scale;
		j := self.j/scale;
		k := self.k/scale;
		sum := real*real + i*i + j*j + k*k;
		factor: f64;
		if (scale > 1.0) {
			factor = (1.0/scale)/sum;
		} else {
			factor = 1.0/(scale*sum);
		}
		return {real*factor, -(i*factor), -(j*factor), -(k*factor)};
	}
}

impl Quaternion(f32) {
	abs :: proc(self) -> f32 {
		return hypot_f32(hypot_f32(self.real, self.i), hypot_f32(self.j, self.k));
	}

	inverse :: proc(self) -> Quaternion(f32) {
		scale := max(max(abs_f32(self.real), abs_f32(self.i)),
		             max(abs_f32(self.j), abs_f32(self.k)));
		real := self.real/scale;
		i := self.i/scale;
		j := self.j/scale;
		k := self.k/scale;
		sum := real*real + i*i + j*j + k*k;
		factor: f32;
		if (scale > f32(1.0)) {
			factor = (f32(1.0)/scale)/sum;
		} else {
			factor = f32(1.0)/(scale*sum);
		}
		return {real*factor, -(i*factor), -(j*factor), -(k*factor)};
	}
}
