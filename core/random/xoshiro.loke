/**
	`Xoshiro256`: the package's general-purpose generator, xoshiro256++
	(Blackman and Vigna, "Scrambled linear pseudorandom number generators",
	2018), and SplitMix64, which seeds it.

	Outputs, jumps, and seed expansion are those of the reference C code at
	prng.di.unimi.it, bit for bit.
*/
// standard-library "Generators" and "Seeding". `tests/run/lib_random.loke`
// pins them.
@(public)
package random;

/**
	xoshiro256++ state. Move-only, so a generator cannot be duplicated by
	accident: two copies would draw the same values, which is the bug passing one
	to `thread.spawn` and then using it again would otherwise be. `split` and
	`from_state(rng.state())` are the deliberate ways to get a second one.

	The zero value is unseeded, and its first draw seeds it from the operating
	system. xoshiro's state is never all zero once seeded, so a zero state can
	only mean that.
*/
Xoshiro256 :: move_only struct {
	@(private) words: [4]u64,
}

impl Xoshiro256 {
	/**
		A generator whose sequence is fixed by `seed` forever: its state is the
		first four outputs of SplitMix64 started at `seed`, as the reference
		recommends. Those four come from distinct inputs to a bijection, so they
		are never all zero.
	*/
	from_seed :: proc(seed: u64) -> Xoshiro256 {
		counter := seed;
		words: [4]u64 = {};
		foreach (i in 0 ..< 4) {
			counter +%= SPLITMIX_GAMMA;
			words[i] = mix64(counter);
		}
		return {words};
	}

	/**
		A generator seeded from the operating system's generator, as the zero
		value seeds itself. Never reproducible; to replay a run, seed with
		`from_seed(random.secure_u64())` and record that seed.
	*/
	from_entropy :: proc() -> Xoshiro256 {
		return {entropy_words()};
	}

	/**
		A generator with exactly this state, as `state` reported it. All zeros is
		the unseeded zero value, so a snapshot of either kind restores exactly.
	*/
	from_state :: proc(state: [4]u64) -> Xoshiro256 {
		return {state};
	}

	/// The whole state, for `from_state` to restore later.
	state :: proc(self) -> [4]u64 {
		return self.words;
	}

	/// The next 64 bits. This is the `Source` slot.
	next_u64 :: proc(self: inout) -> u64 {
		if ((self.words[0] | self.words[1] | self.words[2] | self.words[3]) == 0) {
			self.words = entropy_words();
		}
		result := rotate_left(self.words[0] +% self.words[3], 23) +% self.words[0];
		shifted := self.words[1] << 17;
		self.words[2] ~= self.words[0];
		self.words[3] ~= self.words[1];
		self.words[1] ~= self.words[2];
		self.words[0] ~= self.words[3];
		self.words[2] ~= shifted;
		self.words[3] = rotate_left(self.words[3], 45);
		return result;
	}

	/**
		Advances the state as 2^128 draws would. From one root, alternating a
		hand-off with `jump` gives 2^128 workers blocks that cannot overlap.
	*/
	jump :: proc(self: inout) {
		self.jump_by(JUMP);
	}

	/// Advances the state as 2^192 draws would: 2^64 blocks for `jump` to divide.
	long_jump :: proc(self: inout) {
		self.jump_by(LONG_JUMP);
	}

	/**
		A new generator for an independent stream, such as one to move into
		`thread.spawn`. Its state is four draws from this one, each through the
		SplitMix64 finalizer, so the result depends only on this generator's
		state and splitting is reproducible however deeply it nests. Overlap
		between streams is as unlikely as two random 256-bit states meeting.
	*/
	split :: proc(self: inout) -> Xoshiro256 {
		words: [4]u64 = {};
		foreach (i in 0 ..< 4) {
			words[i] = mix64(self.next_u64());
		}
		return {words};
	}

	// The reference's polynomial jump: the state after the jump is the XOR of
	// the states the polynomial's set bits select, one draw apart. An unseeded
	// generator seeds first, so the jump starts from the state it moves.
	@(private)
	jump_by :: proc(self: inout, polynomial: [4]u64) {
		if ((self.words[0] | self.words[1] | self.words[2] | self.words[3]) == 0) {
			self.words = entropy_words();
		}
		result: [4]u64 = {};
		foreach (word in polynomial) {
			foreach (bit in 0 ..< 64) {
				if (((word >> uint(bit)) & 1) != 0) {
					foreach (i in 0 ..< 4) { result[i] ~= self.words[i]; }
				}
				self.next_u64();
			}
		}
		self.words = result;
	}
}

@(private) JUMP :: [4]u64{
	0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa, 0x39abdc4529b1661c,
};
@(private) LONG_JUMP :: [4]u64{
	0x76e15d3efefdcbbf, 0xc5004e441c522fb3, 0x77710069854ee241, 0x39109bb02acbe635,
};

// SplitMix64 (Steele, Lea, and Flood, "Fast splittable pseudorandom number
// generators", 2014): a counter stepped by the golden-ratio gamma and passed
// through this finalizer. The finalizer is a bijection on 64 bits.
@(private) SPLITMIX_GAMMA :: u64(0x9e3779b97f4a7c15);

@(private)
mix64 :: proc(value: u64) -> u64 {
	z := value;
	z = (z ~ (z >> 30)) *% 0xbf58476d1ce4e5b9;
	z = (z ~ (z >> 27)) *% 0x94d049bb133111eb;
	return z ~ (z >> 31);
}

// Shift counts at or past the width are defined (design.md "Integer
// operators"), and LLVM turns this pattern into one rotate instruction.
@(private)
rotate_left :: proc(value: u64, count: uint) -> u64 {
	return (value << count) | (value >> (64 - count));
}
