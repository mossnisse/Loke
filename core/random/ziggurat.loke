/// `normal` and `exponential` by the ziggurat method (Marsaglia and Tsang, "The
/// Ziggurat Method for Generating Random Variables", 2000), with 256 layers.
///
/// Each layer is a strip of equal area V under the density, X[i] its right edge
/// and F[i] the density there, from X[0], the base strip's virtual width, down
/// to X[256] = 0. A draw picks a layer from its low 8 bits and a position from
/// its high 52, so no bit serves both (Doornik, "An Improved Ziggurat Method",
/// 2005). A position left of the next layer's edge is under the curve and is
/// returned at once, which is about 99% of draws and needs no `core:math`
/// call; the rest test the wedge against the density with one more `unit`
/// draw, or sample the tail.
// standard-library "Distributions".
//
// The tables are literal so the common path does not depend on the C
// library's `exp` and `log`. They were computed from the published R and V
// with `core:math`; `tests/run/lib_random_ziggurat.loke` recomputes them and
// checks that this sampler's output matches one built from the recomputation.
@(public)
package random;

import "core:math";

/// A normally distributed value: `mean + standard_deviation * z` for a standard
/// normal `z`. The mean must be finite and the deviation finite and not
/// negative; a deviation of zero returns the mean after the same draws.
normal :: proc(source: inout $G, mean: f64 = 0, standard_deviation: f64 = 1) -> f64
	where Source(G) {
	if (!(math.is_finite(mean) && math.is_finite(standard_deviation) && standard_deviation >= 0.0)) {
		panic("random.normal: the mean and standard deviation must be finite, and the deviation not negative");
	}
	return mean + standard_deviation*standard_normal(inout source);
}

/// An exponentially distributed value with `rate`, so of mean `1/rate`. The rate
/// must be finite and positive.
exponential :: proc(source: inout $G, rate: f64 = 1) -> f64 where Source(G) {
	if (!(math.is_finite(rate) && rate > 0.0)) {
		panic("random.exponential: the rate must be finite and positive");
	}
	return standard_exponential(inout source) / rate;
}

// One draw per attempt; a wedge test adds a `unit` draw, and a tail attempt two
// `open_unit` draws.
@(private)
standard_normal :: proc(source: inout $G) -> f64 where Source(G) {
	for (;;) {
		bits := source.next_u64();
		layer := int(bits & 0xFF);
		// In (-1, 1), and exact: an odd multiple of 2^-52.
		u := 2.0*open_unit(bits) - 1.0;
		x := u*NORMAL_X[layer];
		if (math.abs(x) < NORMAL_X[layer + 1]) { return x; }
		if (layer == 0) { return normal_tail(inout source, u < 0.0); }
		height := NORMAL_F[layer + 1] + (NORMAL_F[layer] - NORMAL_F[layer + 1])*unit(inout source);
		if (height < math.exp(-0.5*x*x)) { return x; }
	}
}

// Beyond R, by Marsaglia's method: `R + x` for an exponential `x` of rate R,
// kept with probability `exp(-x*x/2)`.
@(private)
normal_tail :: proc(source: inout $G, negative: bool) -> f64 where Source(G) {
	for (;;) {
		x := math.log(open_unit(source.next_u64())) / NORMAL_R;
		y := math.log(open_unit(source.next_u64()));
		if (-2.0*y >= x*x) {
			return (x - NORMAL_R) if negative else (NORMAL_R - x);
		}
	}
}

@(private)
standard_exponential :: proc(source: inout $G) -> f64 where Source(G) {
	for (;;) {
		bits := source.next_u64();
		layer := int(bits & 0xFF);
		x := open_unit(bits)*EXPONENTIAL_X[layer];
		if (x < EXPONENTIAL_X[layer + 1]) { return x; }
		// The tail is the exponential again, shifted to R: it is memoryless.
		if (layer == 0) { return EXPONENTIAL_R - math.log(open_unit(source.next_u64())); }
		height := EXPONENTIAL_F[layer + 1]
			+ (EXPONENTIAL_F[layer] - EXPONENTIAL_F[layer + 1])*unit(inout source);
		if (height < math.exp(-x)) { return x; }
	}
}

// A float in (0, 1) from the top 52 bits of `bits`: (k + 1/2) * 2^-52, exact,
// and never 0, so its logarithm is finite.
@(private)
open_unit :: proc(bits: u64) -> f64 {
	return (f64(bits >> 12) + 0.5) * (1.0 / 4503599627370496.0);
}

// R, where the tail starts, for 256 layers. Each strip's area V is
// 0.00492867323399 for the normal and 0.0039496598225815571993 for the
// exponential. X[1] = R, X[0] = V / f(R), X[i] = f⁻¹(V / X[i-1] + f(X[i-1]))
// for i from 2 to 255, X[256] = 0, and F[i] = f(X[i]), where f is the density
// without its normalizing constant: exp(-x*x/2) or exp(-x).
@(private) NORMAL_R :: 3.6541528853610088;
@(private) EXPONENTIAL_R :: 7.69711747013104972;

