// The runtime ABI package (design.md "Allocators", "`type` and `typeid`",
// m6a-plan decision "Runtime metadata ABI").
//
// This package is authoritative for the layouts the compiler and the seed
// runtime both write: the allocator surface, the public type metadata, and
// `Source_Code_Location`. The compiler asserts its own layout against these
// declarations rather than the other way round, so the two record shapes cannot
// drift apart silently.
//
// `Allocator` and `Allocator_Error` are contributed by the compiler
// (`src/stdlib.odin`) and bind the *same* types the unqualified predeclared
// names do. `runtime.Allocator` and `Allocator` are one type, not two.
//
// Adding a field, or an enum member, requires a runtime ABI version bump:
// generated metadata tables are written against exactly this field order.
@(public)
package runtime;

// Every kind a `typeid` can describe. `Invalid` is the zero value, which is
// what an unknown or forged id resolves to.
@(public)
Type_Kind :: enum u8 {
	Invalid, Void, Bool, Signed_Int, Unsigned_Int, Float, Rune,
	Raw_Pointer, Pointer, C_Pointer, Array, Slice, Dynamic_Array, Map,
	Struct, Enum, Union, Proc, String, String_View, CString_View,
	Typeid, Any_View, Dyn, Distinct, Simd, Allocator, Allocator_Error,
}

@(public)
Member_Kind :: enum u8 { Field, Enum_Value, Union_Variant, Parameter, Result }

// One member of an aggregate. Names use static storage, so a `Member_Info`
// owns nothing and needs no cleanup.
//
// `value_low`/`value_high` carry an enum member's raw value in two words,
// without narrowing a signed or unsigned 128-bit value; the owning type's
// `bits` and `signed` say how to read them. Unused fields are zero.
@(public)
Member_Info :: struct {
	kind:       Member_Kind,
	name:       string_view,
	type:       typeid,
	offset:     int,
	value_low:  u64,
	value_high: u64,
}

// design.md "`type` and `typeid`": the runtime half of reflection. A `typeid` is
// an ordinary scalar, so `type_info_of` is a checked lookup rather than a
// promise that every id is valid.
//
// Aggregate member tables expose public fields only; procedure entries retain
// written parameter and result order, and union variants retain declaration
// order. Unused scalar, relation, and member fields are zero.
@(public)
Type_Info :: struct {
	id:      typeid,
	kind:    Type_Kind,
	name:    string_view,
	size:    int,
	align:   int,
	bits:    int,
	signed:  bool,
	element: typeid,
	key:     typeid,
	count:   int,
	members: []Member_Info,
}

// design.md "Concurrency and the memory model": the ordering an atomic
// operation asks for. The compiler checks these names and values against its
// own copy in `src/atomics.odin`.
@(public)
Memory_Order :: enum u8 {
	Relaxed,
	Acquire,
	Release,
	Acquire_Release,
	Sequentially_Consistent,
}

// design.md: `source_location` and `caller_location` produce one of these.
// Line and column are one-based, and both views point at static storage.
@(public)
Source_Code_Location :: struct {
	file:      string_view,
	procedure: string_view,
	line:      int,
	column:    int,
}

// design.md "Typed fallibility": the three declarations the compiler
// bootstraps and binds into the universe, so every program spells absence and
// failure with one pair of types rather than a trailing status convention.
//
// `Option` has a zero — `.none` is its first variant — so it may be stored in
// a global, a container, or a zero-initialized allocation. `Result` has none:
// there is no honest default between success and failure, so it must be
// constructed.

// design.md "Iteration protocol": an iterator's optional `Yield` says how a
// binding receives what `next` hands back -- the element itself, a pointer
// lending it, or, for a record element, a record of descriptors one per field.
// They live here, and are universe names, because the compiler contributes a
// `Yield` to the built-in iterators that lend, and a program iterating an array
// imports nothing.
@(public)
Yield_Owned :: struct {}
@(public)
Yield_Borrowed :: struct {}
@(public)
Yield_Mutable :: struct {}

// The no-payload result type. A fallible operation that produces nothing on
// success returns `Result(Unit, E)`.
@(public)
Unit :: struct {}

@(public)
Option :: union($T: type) @(zero=none, failure=none) { none:, some: T }

@(public)
@(require_results)
Result :: union($T, $E: type) @(failure=err) { ok: T, err: E }

// design.md "or_return operator": `or_return` rewraps a failure payload only
// where it is already assignable, so changing error domains is an ordinary
// operation rather than an implicit conversion. `f` names the target variant —
// a union constructor is not a callable value, so it is a one-line procedure.
//
// The success payload is relocated, never cloned, so a move-only `T` maps like
// any other. `f` owns the error it is handed, so it moves a managed or
// move-only error into the new variant rather than cloning it. `F` is `f`'s
// result, inferred from the argument (design.md "Specialization").
impl Result($T, $E) {
	map_error :: proc(self: move, f: proc(error: move E) -> $F) -> Result(T, F) {
		switch (payload in move(self)) {
		case .ok:  return .ok(move(payload));
		case .err: return .err(f(move(payload)));
		}
	}
}
