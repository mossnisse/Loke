/**
	The runtime ABI package: the layouts the compiler and the seed runtime both
	write, which are the allocator surface, the public type metadata, and
	`Source_Code_Location`.

	`Allocator` and `Allocator_Error` are the same types the unqualified
	predeclared names are: `runtime.Allocator` and `Allocator` are one type,
	not two.
*/
// design.md "Allocators", "`type` and `typeid`", m6a-plan decision "Runtime
// metadata ABI".
//
// This package is authoritative for those layouts. The compiler checks these
// declarations against the layouts it writes, field names, order, and types,
// and the enums member by member, so the two cannot drift apart silently.
// `Allocator` and `Allocator_Error` are contributed by the compiler
// (`src/stdlib.odin`) and described below with `@(intrinsic)`.
//
// Adding a field, or an enum member, requires a runtime ABI version bump:
// generated metadata tables are written against exactly this field order.
@(public)
package runtime;

import "base:interfaces";

/**
	The pointer-sized handle to an allocation provider: the predeclared
	`Allocator`, under this package's name.
*/
@(intrinsic)
Allocator :: ---;

/**
	What a fallible allocation reports: the predeclared `Allocator_Error`,
	under this package's name.
*/
@(intrinsic)
Allocator_Error :: ---;

/**
	Every kind a `typeid` can describe. `Invalid` is the zero value, which is
	what an unknown or forged id resolves to.
*/
@(public)
Type_Kind :: enum u8 {
	Invalid, Void, Bool, Signed_Int, Unsigned_Int, Float, Rune,
	Raw_Pointer, Pointer, C_Pointer, Array, Slice, Dynamic_Array, Map,
	Struct, Enum, Union, Proc, String, String_View, CString_View,
	Typeid, Dyn, Distinct, Simd, Allocator, Allocator_Error, Box,
}

/**
	The runtime half of reflection, which describes a type's shape and not its
	members: those are read where the type is known, with `fields_of`,
	`enum_values_of`, and `variants_of`. A `typeid` is an ordinary scalar, so
	`type_info_of` is a checked lookup rather than a promise that every id is
	valid.

	`element` is what a pointer, C pointer, or `Box` points at, what an array,
	slice, dynamic array, or `Simd` holds, a map's value type, an enum's
	backing type, and the type a `Distinct` entry is declared over, whose own
	entry describes the shape. `key` is a map's key type, and `count` an
	array's length or a vector's lane count. Unused fields are zero.
*/
// design.md "`type` and `typeid`".
@(public)
Type_Info :: struct {
	id:      typeid,
	kind:    Type_Kind,
	name:    string_view,
	size:    int,
	align:   int,
	element: typeid,
	key:     typeid,
	count:   int,
}

/// The ordering an atomic operation asks for.
// design.md "Concurrency and the memory model". The compiler checks these
// names and values against its own copy in `src/atomics.odin`.
@(public)
Memory_Order :: enum u8 {
	Relaxed,
	Acquire,
	Release,
	Acquire_Release,
	Sequentially_Consistent,
}

/**
	What `source_location` and `caller_location` produce. Line and column are
	one-based, and both views point at static storage.
*/
@(public)
Source_Code_Location :: struct {
	file:      string_view,
	procedure: string_view,
	line:      int,
	column:    int,
}

// design.md "Typed fallibility": the declarations the compiler bootstraps and
// binds into the universe, so every program spells absence and failure with
// these types rather than a trailing status convention.
//
// `Option` has a zero — `.none` is its first variant — so it may be stored in
// a global, a container, or a zero-initialized allocation. `Result` has none:
// there is no honest default between success and failure, so it must be
// constructed.

/// The empty type: what `or_return` yields for a success that carries nothing.
@(public)
Unit :: struct {}

@(public, zero=none, failure=none)
Option :: union($T: type) { none, some: T }

@(public)
@(require_results, failure=err)
Result :: union($T, $E: type) { ok: T, err: E }

/**
	A fallible operation that produces nothing on success: `Result(Unit, E)`
	under a shorter name, so its body may end without `return .ok;`.
*/
// design.md "Typed fallibility" and "Parametric aliases".
@(public)
Status :: Result(Unit, $E);

/**
	Storage for a `T` that holds no value: `T`'s size and alignment, and nothing
	to copy, drop, compare, or print. It needs no zero value of `T`, so a record
	holding one has a zero value whatever `T` is.

	A value is written into the storage with `unsafe.write`, read out of it with
	`unsafe.take`, and reached where it sits through the pointer
	`unsafe.storage` gives. Whether the storage holds a value at any moment is
	the record around it to know: that record's `hook(drop)` releases what is
	there, and its `hook(copy)` copies it.

	An `Uninit(T)` is copied bit for bit where `T` has a trivial lifecycle, and
	has no copy otherwise.
*/
// design.md "Uninitialized capacity". The compiler knows this declaration by
// name: it gives the field no part in the record's lifecycle, zero value,
// equality, or constant, and `unsafe.write`, `unsafe.take`, and `unsafe.storage`
// are the only ways past its privacy.
@(public)
Uninit :: struct($T: type) {
	@(private) value: T,
}

// design.md "or_return operator": `or_return` rewraps a failure payload only
// where it is already assignable, so changing error domains is an ordinary
// operation rather than an implicit conversion. `f` names the target variant,
// usually as its constructor: `App_Error.parse`.
//
// The success payload is relocated, never cloned, so a move-only `T` maps like
// any other. `f` owns the error it is handed, so it moves a managed or
// move-only error into the new variant rather than cloning it. `f` is any
// callable taking the error, and `C.Result`, what it returns, is the new error
// type (standard-library.md "Standard interface catalogue").
impl Result($T, $E) {
	map_error :: proc(self: move, f: $C) -> Result(T, C.Result)
		where interfaces.Callable(C, proc(error: move E) -> C.Result) {
		switch (move(self)) {
		case .ok(payload):  return .ok(move(payload));
		case .err(payload): return .err(f(move(payload)));
		}
	}
}

// design.md "Changing error domains": `none` carries no error, so the caller
// names the one it becomes. `error` is an ordinary argument, built before the
// call whether or not it is used.
impl Option($T) {
	ok_or :: proc(self: move, error: move $E) -> Result(T, E) {
		switch (move(self)) {
		case .some(payload): return .ok(move(payload));
		case .none: return .err(move(error));
		}
	}
}
