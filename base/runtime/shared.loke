/// `Shared(T)` and `Weak(T)`: shared ownership.
///
/// Shared ownership is a library record with custom lifecycle hooks over an
/// atomic control block: `clone` and ordinary assignment increment a count
/// instead of duplicating `T`, `drop` decrements it, and the thread that
/// releases the final strong handle drops the payload exactly once.
///
/// Five things about these types are the *language's*, not the library's: a
/// `Shared(T)` has no zero value while a `Weak(T)`'s is `{}`, `via` on such a
/// declaration is an error, `handle.get()` derives its root provenance from the
/// handle, a handle carries the borrows its payload holds, and neither is ever
/// silently moved at its last use.
///
/// The atomic count makes *handle accounting* race-free. It does not make the
/// payload safe to touch from two threads, and it does not make destruction safe
/// on every thread: the thread that releases the last strong handle runs `T`'s
/// drop and uses the control block's allocator. The compiler does not check
/// that.
// design.md "Shared ownership".
//
// It lives in `base:runtime` rather than in `core:sync` for one reason: the
// names `Shared`, `Weak`, `shared`, and `try_shared` are *universe* names — design.md
// writes `x: Shared(Node)` with no import in sight — so the package that
// declares them is loaded by every program. `base:runtime` is the package that
// already exists for exactly that, beside `Option` and `Result`; making a
// second one unconditional would put an atomics package in every hello world.
// The compiler contributes the atomic intrinsics here for the same reason it
// contributes `allocate_string` to both `core:strings` and `core:fmt`, and it
// owns the five language rules above.
@(public)
package runtime;

// One allocation per shared value: the counts, the allocator that made it, and
// the payload itself, so a handle is one pointer and the payload address is
// stable for as long as any handle holds it.
//
// `weak` counts the weak handles *plus one for the strong handles as a group*,
// which is the classic arrangement: the payload dies when `strong` reaches
// zero, and the block itself is released when `weak` does.
//
// The payload is capacity (design.md "Uninitialized capacity"), so the block
// is allocated before it holds a value: `live` says whether it does, and the
// payload is written in and taken out without a zero `T` ever standing in for
// it.
@(private)
Shared_Block :: struct($T: type) {
	strong:    int,
	weak:      int,
	allocator: Allocator,
	@(initialized = live) payload: [1]T,
	live:      int,
}

/// A strong handle: one stable, heap-allocated `T` payload and an atomic
/// strong-reference count. It has no zero value: a handle always shares a
/// payload, and `Option(Shared(T))` is the absent one.
// design.md "Shared ownership".
//
// The block travels as a `rawptr` rather than a typed pointer so the handle
// carries no borrow: a `Shared(T)` is an owner, and nothing about it should
// make it look like a view of something else.
@(public)
Shared :: struct($T: type) {
	@(private) block: rawptr,
}

/// The non-owning companion of `Shared(T)`: it keeps the control block but not
/// the payload alive, and `upgrade` returns `Option(Shared(T))`.
@(public)
Weak :: struct($T: type) {
	@(private) block: rawptr,
}

// ------------------------------------------------------------ construction --

// `shared(value)` and `shared(move(value))`. The universe binds `shared` to the
// group below, which makes the two spellings one name.
// A failed construction answers by the allocator's policy (design.md
// "Allocation failure"), as every implicitly allocating operation does.
@(private)
shared_from_clone :: proc(
	value: $T, allocator: Allocator = default_allocator(),
) -> Shared(T) where is_copyable(T) {
	switch (try_shared_from_clone(value, allocator)) {
	case .ok(handle): return handle;
	case .err(error): allocation_failed(error, allocator);
	}
}

@(private)
shared_from_move :: proc(value: move $T, allocator: Allocator = default_allocator()) -> Shared(T) {
	switch (try_shared_from_move(move(value), allocator)) {
	case .ok(handle): return handle;
	case .err(error): allocation_failed(error, allocator);
	}
}

@(public)
shared :: proc{shared_from_clone, shared_from_move};

// design.md: "use `try_shared` to handle a construction error locally."
@(private)
try_shared_from_clone :: proc(
	value: $T, allocator: Allocator = default_allocator(),
) -> Result(Shared(T), Allocator_Error) where is_copyable(T) {
	copy := value.try_clone(allocator) or_return;
	return try_shared_from_move(move(copy), allocator);
}

@(private)
try_shared_from_move :: proc(
	@(escape=stored) value: move $T, allocator: Allocator = default_allocator(),
) -> Result(Shared(T), Allocator_Error) {
	raw := unsafe_try_new(Shared_Block(T){strong = 1, weak = 1, allocator = allocator}, allocator) or_return;
	block := (^mut Shared_Block(T))(raw);
	unsafe_write(block^.payload[0], move(value));
	block^.live = 1;
	return .ok(Shared(T){rawptr(block)});
}

@(public)
try_shared :: proc{try_shared_from_clone, try_shared_from_move};

// ----------------------------------------------------------------- handles --

impl Shared($T) {
	/// A non-owning `^T` whose root provenance derives from this handle, so a
	/// borrow returned from it cannot outlive the handle. A read-only handle can
	/// still be asked.
	///
	/// It does *not* make concurrent access to `T` safe. State that changes behind
	/// a handle lives in `core:sync`'s `Atomic` or `Once` fields, whose operations
	/// work through a `^T`, or behind another protocol of the caller's own.
	// design.md "Shared ownership". That is what the `^` receiver buys: it
	// borrows the caller's handle.
	get :: proc(self: ^) -> ^T {
		block := (^mut Shared_Block(T))(self.block);
		return &block^.payload[0];
	}

	/// The number of strong handles, for tests and diagnostics. It may be stale
	/// the moment it is read whenever another thread holds a handle.
	strong_count :: proc(self) -> int {
		block := (^mut Shared_Block(T))(self.block);
		return atomic_load(&block^.strong, Memory_Order.Acquire);
	}

	/// The number of weak handles. The group of strong handles counts as one
	/// more, which is what keeps the block alive while any of them exist.
	weak_count :: proc(self) -> int {
		block := (^mut Shared_Block(T))(self.block);
		return atomic_load(&block^.weak, Memory_Order.Acquire) - 1;
	}

	/// A non-owning companion to this handle.
	downgrade :: proc(self) -> Weak(T) {
		block := (^mut Shared_Block(T))(self.block);
		atomic_add(&mut block^.weak, 1, Memory_Order.Relaxed);
		return Weak(T){self.block};
	}

	/// Another handle to the same payload: the strong count goes up and nothing
	/// is allocated, so `clone` and ordinary assignment share the control block
	/// instead of cloning `T`. The payload keeps the allocator it was made with.
	// design.md "Shared ownership". The allocator parameter is unused.
	share :: hook(copy) proc(self, allocator: Allocator) -> Result(Shared(T), Allocator_Error) {
		block := (^mut Shared_Block(T))(self.block);
		// Relaxed is enough to *add* a reference: the new handle is a copy of one
		// the caller already holds, so nothing new becomes reachable here.
		atomic_add(&mut block^.strong, 1, Memory_Order.Relaxed);
		return .ok(Shared(T){self.block});
	}

	/// Whether two handles name the same value. A handle always names one, so
	/// comparing the blocks is the whole answer.
	same :: operator(==) proc(left, right: Shared(T)) -> bool {
		return left.block == right.block;
	}

	/// Releases this handle. Releasing the last strong handle drops the payload,
	/// exactly once.
	// design.md: "`drop` decrements the count with release ordering. At the final
	// reference, it performs an acquire fence and drops the payload one time."
	//
	// The release makes every write this thread made to the payload visible to
	// whichever thread runs the final drop; the acquire fence there is what makes
	// those writes visible to *it* before the payload is destroyed.
	release :: hook(drop) proc(self: inout) {
		block := (^mut Shared_Block(T))(self.block);
		if (atomic_sub(&mut block^.strong, 1, Memory_Order.Release) != 1) { return; }
		fence(Memory_Order.Acquire);
		// Taking the payload out and dropping it is what drops it exactly once:
		// the block itself outlives this whenever a weak handle still names it, so
		// the payload cannot be destroyed by freeing the block. The block stops
		// claiming a value first, because the drop hook can panic, and the strong
		// group's weak reference is given back by a `defer`, so a panicking hook
		// still returns the block to its allocator during the unwind (design.md
		// "What the unwind runs, and what it does not").
		block^.live = 0;
		retired := unsafe_take(block^.payload[0]);
		defer release_block(block, block^.allocator);
		drop(retired);
	}
}

impl Weak($T) {
	/// A strong handle to the payload, or none when the payload is already gone.
	// The loop is what makes that answer honest under contention: a count read as
	// non-zero may reach zero before the increment lands, so the increment has to
	// be the same operation as the test.
	upgrade :: proc(self) -> Option(Shared(T)) {
		if (self.block == nil) { return .none; }
		block := (^mut Shared_Block(T))(self.block);
		for (true) {
			held := atomic_load(&block^.strong, Memory_Order.Acquire);
			if (held == 0) { return .none; }
			_, won := compare_exchange_strong(
				&mut block^.strong, held, held + 1,
			);
			// The new handle is a strong one, and the strong group already holds
			// its one weak reference, so the weak count does not change.
			if (won) { return .some(Shared(T){self.block}); }
		}
		return .none;
	}

	strong_count :: proc(self) -> int {
		if (self.block == nil) { return 0; }
		block := (^mut Shared_Block(T))(self.block);
		return atomic_load(&block^.strong, Memory_Order.Acquire);
	}

	keep :: hook(copy) proc(self, allocator: Allocator) -> Result(Weak(T), Allocator_Error) {
		if (self.block == nil) { return .ok(Weak(T){nil}); }
		block := (^mut Shared_Block(T))(self.block);
		atomic_add(&mut block^.weak, 1, Memory_Order.Relaxed);
		return .ok(Weak(T){self.block});
	}

	same :: operator(==) proc(left, right: Weak(T)) -> bool {
		return left.block == right.block;
	}

	release :: hook(drop) proc(self: inout) {
		if (self.block == nil) { return; }
		block := (^mut Shared_Block(T))(self.block);
		self.block = nil;
		release_block(block, block^.allocator);
	}
}

// One weak reference given back. The block is released when the last one goes,
// which is after the payload has already been dropped by the final strong
// handle. `allocator` is the one the block stores, read by the handle operation
// calling this, which is where the compiler takes it as that handle's region.
@(private)
release_block :: proc(block: ^mut Shared_Block($T), allocator: Allocator) {
	if (atomic_sub(&mut block^.weak, 1, Memory_Order.Release) != 1) { return; }
	fence(Memory_Order.Acquire);
	// The unchecked release. The block travels as a `rawptr` so a handle carries
	// no borrow, which is also why the compiler cannot follow this pointer back
	// to the `new` that made it — design.md's own answer for a case like this.
	unsafe_free(block, allocator);
}

// The compare-exchange `upgrade` needs, spelled once so the ordering pair is
// written in one place. Sequentially consistent on success and acquire on
// failure: the loop re-reads either way.
@(private)
compare_exchange_strong :: proc(
	place: ^mut int, expected: int, desired: int,
) -> (observed: int, swapped: bool) {
	switch (atomic_compare_exchange(
		place, expected, desired,
		Memory_Order.Sequentially_Consistent, Memory_Order.Acquire,
	)) {
	case .some(found): return {observed = found, swapped = false};
	case .none: return {observed = expected, swapped = true};
	}
	return {observed = expected, swapped = false};
}

// A standalone barrier, spelled here so this package does not depend on
// `core:sync` — which depends on nothing, but which every program would then
// have to load.
@(private)
fence :: proc($order: Memory_Order) {
	atomic_fence(order);
}
