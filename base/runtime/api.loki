/*
	The runtime ABI package: the layouts the compiler and the seed runtime both
	write, which are the allocator surface, the public type metadata, and
	`Source_Code_Location`.

	`Allocator` and `Allocator_Error` are the same types the unqualified
	predeclared names are: `runtime.Allocator` and `Allocator` are one type,
	not two.

	`Shared(T)` and `Weak(T)`: shared ownership.

	Shared ownership is a library record with custom lifecycle hooks over an
	atomic control block: `clone` and ordinary assignment increment a count
	instead of duplicating `T`, `drop` decrements it, and the thread that
	releases the final strong handle drops the payload exactly once.

	Five things about these types are the *language's*, not the library's: a
	`Shared(T)` has no zero value while a `Weak(T)`'s is `{}`, `via` on such a
	declaration is an error, `handle.get()` derives its root provenance from the
	handle, a handle carries the borrows its payload holds, and neither is ever
	silently moved at its last use.

	The atomic count makes *handle accounting* race-free. It does not make the
	payload safe to touch from two threads, and it does not make destruction safe
	on every thread: the thread that releases the last strong handle runs `T`'s
	drop and uses the control block's allocator. The compiler does not check
	that.
*/
package runtime;

import "base:interfaces";

/*
	The pointer-sized handle to an allocation provider: the predeclared
	`Allocator`, under this package's name.
*/
@(intrinsic)
Allocator :: ---;

/*
	What a fallible allocation reports: the predeclared `Allocator_Error`,
	under this package's name.
*/
@(intrinsic)
Allocator_Error :: ---;

/*
	Every kind a `typeid` can describe. `Invalid` is the zero value, which is
	what an unknown or forged id resolves to.
*/
Type_Kind :: enum u8 {
	Invalid, Void, Bool, Signed_Int, Unsigned_Int, Float, Rune,
	Raw_Pointer, Pointer, C_Pointer, Array, Slice, Dynamic_Array, Map,
	Struct, Enum, Union, Proc, String, String_View, CString_View,
	Typeid, Any_View, Dyn, Distinct, Simd, Allocator, Allocator_Error, Box,
}

Member_Kind :: enum u8 { Field, Enum_Value, Union_Variant, Parameter, Result }

/*
	One member of an aggregate. Names use static storage, so a `Member_Info`
	owns nothing and needs no cleanup.

	`value_low`/`value_high` carry an enum member's raw value in two words,
	without narrowing a signed or unsigned 128-bit value; the owning type's
	`bits` and `signed` say how to read them. Unused fields are zero.
*/
Member_Info :: struct {
	kind:       Member_Kind,
	name:       string_view,
	type:       typeid,
	offset:     int,
	value_low:  u64,
	value_high: u64,
}

/*
	The runtime half of reflection. A `typeid` is an ordinary scalar, so
	`type_info_of` is a checked lookup rather than a promise that every id is
	valid.

	Aggregate member tables expose public fields only; procedure entries retain
	written parameter and result order, and union variants retain declaration
	order. Unused scalar, relation, and member fields are zero. A `Distinct`
	entry's `element` is the type it is declared over, and the shape is that
	type's entry to describe.
*/
Type_Info :: struct {
	id:      typeid,
	kind:    Type_Kind,
	name:    string_view,
	size:    int,
	align:   int,
	bits:    int,
	signed:  bool,
	element: typeid,
	key:     typeid,
	count:   int,
	members: []Member_Info,
}

// The ordering an atomic operation asks for.
Memory_Order :: enum u8 {
	Relaxed,
	Acquire,
	Release,
	Acquire_Release,
	Sequentially_Consistent,
}

/*
	What `source_location` and `caller_location` produce. Line and column are
	one-based, and both views point at static storage.
*/
Source_Code_Location :: struct {
	file:      string_view,
	procedure: string_view,
	line:      int,
	column:    int,
}

// The empty type: what `or_return` yields for a success that carries nothing.
Unit :: struct {}

Option :: union($T: type) @(zero=none, failure=none) { none, some: T }

@(require_results)
Result :: union($T, $E: type) @(failure=err) { ok: T, err: E }

/*
	A fallible operation that produces nothing on success. Its success carries
	no payload, so its body may end without `return .ok;`.
*/
