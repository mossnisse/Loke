		where interfaces.Callable(C, proc(error: move E) -> C.Result) ---;
}

impl Status($E) {
	map_error :: proc(self: move, f: $C) -> Status(C.Result)
		where interfaces.Callable(C, proc(error: move E) -> C.Result) ---;
}

impl Option($T) {
	ok_or :: proc(self: move, error: move $E) -> Result(T, E) ---;
}

