// The standard interface catalogue (design.md "Standard interface catalogue").
//
// These are ordinary Loke declarations, not compiler predicates. The compiler's
// contribution is to make built-in receiver operations and associated members
// visible to the same structural checks a user type goes through — `hash` for
// the built-in `Hashable` types, and the iteration members for ranges and fixed
// arrays. Standard free spellings resolve to these same receiver members.
//
@(public)
package interfaces;

Equatable :: interface($T: type) {
	(a, b: T) a == b -> bool;
}

Ordered :: interface($T: type) {
	Equatable(T);
	(a, b: T) a < b -> bool;
}

Hashable :: interface($T: type) {
	Equatable(T);
	(value: T, seed: uint) value.hash(seed) -> uint;
}

Numeric :: interface($T: type) {
	T(0) -> T;
	T(1) -> T;
	(a, b: T) a + b -> T;
	(a, b: T) a - b -> T;
	(a, b: T) a * b -> T;
	(a, b: T) a / b -> T;
}

Integral :: interface($T: type) {
	Numeric(T);
	(a, b: T) a % b -> T;
	(a, b: T) a | b -> T;
	(a, b: T) a ~ b -> T;
	(a, b: T) a & b -> T;
	(a, b: T) a &~ b -> T;
	(a: T, shift: uint) a << shift -> T;
	(a: T, shift: uint) a >> shift -> T;
}

// A record satisfies this through whichever `try_clone` it answers to: the one
// its `impl` block writes, or the field-wise one the compiler generates.
// `move_only struct` removes the member, so a move-only type fails it.
Cloneable :: interface($T: type) {
	slot try_clone: proc(self: ^, allocator: Allocator) -> Result(T, Allocator_Error);
}

// What `next` hands back is `Item`, which the iterator's `Yield` makes of the
// element it traverses; with no `Yield` the two are the same type.
Iterator :: interface($Self, $Item: type) {
	slot next: proc(self: inout Self) -> Option(Item);
}

Iterable :: interface($Self: type) {
	Self.Element -> type;
	Self.Iterator -> type;
	slot iter: proc(self: ^) -> Self.Iterator;
	// What the iterator hands back, which is the element itself unless it lends
	// one. An iterator declaring no `Yield` has `Item` equal to `Element`, so
	// this accepts every iterator written before `Yield` existed.
	Iterator(Self.Iterator, Self.Iterator.Item);
}

// Reverse traversal, which `reversed()` asks for. It yields the same `Element`
// through the same `Iterator`; a traversal needing another representation is an
// ordinary adapter value with its own pair.
Reverse_Iterable :: interface($Self: type) {
	Iterable(Self);
	slot iter_reverse: proc(self: ^) -> Self.Iterator;
}

Mutable_Iterable :: interface($Self: type) {
	Self.Element -> type;
	Self.Mut_Iterator -> type;
	slot iter_mut: proc(self: inout Self) -> Self.Mut_Iterator;
	Iterator(Self.Mut_Iterator, ^mut Self.Element);
}

Sequence :: interface($Self: type) {
	Iterable(Self);
	(value: Self) value.len() -> int;
	(value: Self, index: int) value[index] -> Self.Element;
}

Mutable_Sequence :: interface($Self: type) {
	Sequence(Self);
	(value: inout Self, index: int) value[index] -> inout Self.Element;
}

Growable_Sequence :: interface($Self: type) {
	Mutable_Sequence(Self);
	(value: inout Self, element: Self.Element) value.append(element) -> _;
}
