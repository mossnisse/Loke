// The standard interface catalogue (design.md "Standard interface catalogue").
//
// These are ordinary Loke declarations, not compiler predicates. The compiler's
// contribution is to make built-in operations and associated members visible to
// the same structural checks a user type goes through — `hash` for the built-in
// `Hashable` types, and the iteration members for ranges and fixed arrays.
//
// M5 handoff: `Cloneable` is deliberately absent. Its one requirement is
//
//     slot try_clone: proc(self, allocator: Allocator) -> (T, Allocator_Error);
//
// and both `Allocator` and `Allocator_Error` arrive with M5's allocator and
// lifecycle types. Adding it here with placeholder types would make the
// catalogue lie about what satisfies it.
@(public)
package interfaces;

Equatable :: interface($T: type) {
	(a, b: T) a == b -> bool;
}

Ordered :: interface($T: type) {
	Equatable(T);
	(a, b: T) a < b -> bool;
}

Hashable :: interface($T: type) {
	Equatable(T);
	(value: T, seed: uint) hash(value, seed) -> uint;
}

Numeric :: interface($T: type) {
	T(0) -> T;
	T(1) -> T;
	(a, b: T) a + b -> T;
	(a, b: T) a - b -> T;
	(a, b: T) a * b -> T;
	(a, b: T) a / b -> T;
}

Integral :: interface($T: type) {
	Numeric(T);
	(a, b: T) a % b -> T;
	(a, b: T) a | b -> T;
	(a, b: T) a ~ b -> T;
	(a, b: T) a & b -> T;
	(a, b: T) a &~ b -> T;
	(a: T, shift: uint) a << shift -> T;
	(a: T, shift: uint) a >> shift -> T;
}

Iterator :: interface($Self, $Element: type) {
	slot next: proc(self: inout Self) -> (Element, bool);
}

Iterable :: interface($Self: type) {
	Self.Element -> type;
	Self.Iterator -> type;
	(value: Self) iter(value) -> Self.Iterator;
	Iterator(Self.Iterator, Self.Element);
}

Sequence :: interface($Self: type) {
	Iterable(Self);
	(value: Self) len(value) -> int;
	(value: Self, index: int) value[index] -> Self.Element;
}

Mutable_Sequence :: interface($Self: type) {
	Sequence(Self);
	(value: inout Self, index: int) value[index] -> inout Self.Element;
}

Growable_Sequence :: interface($Self: type) {
	Mutable_Sequence(Self);
	(value: inout Self, element: Self.Element) value.append(element);
}
