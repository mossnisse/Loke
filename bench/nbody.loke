package main;
import "core:fmt";
import "core:math";

// The n-body simulation of the Computer Language Benchmarks Game: floating-point
// arithmetic, square roots, and a fixed array of records updated in place.

PI            :: 3.141592653589793;
SOLAR_MASS    :: 4.0 * PI * PI;
DAYS_PER_YEAR :: 365.24;
STEPS         :: 5_000_000;

Body :: struct { x, y, z, vx, vy, vz, mass: f64 }

planet :: proc(x, y, z, vx, vy, vz, mass: f64) -> Body {
	return Body{
		x = x, y = y, z = z,
		vx = vx * DAYS_PER_YEAR, vy = vy * DAYS_PER_YEAR, vz = vz * DAYS_PER_YEAR,
		mass = mass * SOLAR_MASS,
	};
}

advance :: proc(bodies: inout [5]Body, dt: f64) {
	foreach (i in 0 ..< 5) {
		foreach (j in i + 1 ..< 5) {
			dx := bodies[i].x - bodies[j].x;
			dy := bodies[i].y - bodies[j].y;
			dz := bodies[i].z - bodies[j].z;
			distance_squared := dx*dx + dy*dy + dz*dz;
			magnitude := dt / (distance_squared * math.sqrt(distance_squared));
			bodies[i].vx -= dx * bodies[j].mass * magnitude;
			bodies[i].vy -= dy * bodies[j].mass * magnitude;
			bodies[i].vz -= dz * bodies[j].mass * magnitude;
			bodies[j].vx += dx * bodies[i].mass * magnitude;
			bodies[j].vy += dy * bodies[i].mass * magnitude;
			bodies[j].vz += dz * bodies[i].mass * magnitude;
		}
	}
	foreach (i in 0 ..< 5) {
		bodies[i].x += dt * bodies[i].vx;
		bodies[i].y += dt * bodies[i].vy;
		bodies[i].z += dt * bodies[i].vz;
	}
}

energy :: proc(bodies: [5]Body) -> f64 {
	total := 0.0;
	foreach (i in 0 ..< 5) {
		b := bodies[i];
		total += 0.5 * b.mass * (b.vx*b.vx + b.vy*b.vy + b.vz*b.vz);
		foreach (j in i + 1 ..< 5) {
			dx := b.x - bodies[j].x;
			dy := b.y - bodies[j].y;
			dz := b.z - bodies[j].z;
			total -= b.mass * bodies[j].mass / math.sqrt(dx*dx + dy*dy + dz*dz);
		}
	}
	return total;
}

main :: proc() {
	bodies := [5]Body{
		planet(0, 0, 0, 0, 0, 0, 1),
		planet(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01,
			1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05,
			9.54791938424326609e-04),
		planet(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01,
			-2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05,
			2.85885980666130812e-04),
		planet(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01,
			2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05,
			4.36624404335156298e-05),
		planet(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01,
			2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05,
			5.15138902046611451e-05),
	};

	// Offset the sun's momentum so the system's total is zero.
	px, py, pz := 0.0, 0.0, 0.0;
	foreach (b in bodies) {
		px += b.vx * b.mass;
		py += b.vy * b.mass;
		pz += b.vz * b.mass;
	}
	bodies[0].vx = -px / SOLAR_MASS;
	bodies[0].vy = -py / SOLAR_MASS;
	bodies[0].vz = -pz / SOLAR_MASS;

	fmt.println(energy(bodies));
	foreach (_ in 0 ..< STEPS) { advance(inout bodies, 0.01); }
	fmt.println(energy(bodies));
}
