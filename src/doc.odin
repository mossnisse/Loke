// `-doc` and `-api`: the public API of the root package, and of each package
// of the project it imports, from their checked public declarations and their
// doc comments (design.md "Doc comments"). `-doc` prints it as Markdown, and
// `-api` writes each package's interface file, Loke source without bodies
// (compiler-guide.md "Interface files"). Both read one model of a package's
// API, so they show the same declarations.
package lokec

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strings"

// What `-api` writes in each package's directory.
INTERFACE_FILE :: "api.loki"

// The root package, then each project package, in the order they were loaded.
// A project package is one whose key names no collection.
documented_packages :: proc(c: ^Compiler, root: Package_Id) -> []Package_Id {
	ids := make([dynamic]Package_Id)
	append(&ids, root)
	for &pkg in c.packages[1:] {
		if pkg.id != root && !strings.contains_rune(pkg.key, ':') {
			append(&ids, pkg.id)
		}
	}
	return ids[:]
}

// The root package's page, then one for each project package.
document_project :: proc(c: ^Compiler, root: Package_Id) -> string {
	b := strings.builder_make()
	for id, index in documented_packages(c, root) {
		if index > 0 {
			strings.write_byte(&b, '\n')
		}
		document_package(c, &b, id)
	}
	return strings.to_string(b)
}

// `-api` writes the interface file of each package `-doc` documents, and
// `-api-check` lists the ones that differ from what `-api` would write. The
// status is 1 when one differs or cannot be written.
write_interfaces :: proc(c: ^Compiler, root: Package_Id, check: bool) -> int {
	status := 0
	for id in documented_packages(c, root) {
		pkg := package_of(c, id)
		if len(pkg.files) == 0 {
			continue
		}
		path, _ := filepath.join({filepath.dir(c.sources[pkg.files[0].file].path), INTERFACE_FILE})
		text, ok := interface_text(c, id)
		if !ok {
			status = 1
			continue
		}
		// A checkout may have turned the file's line ends into CRLF.
		written, read_err := os.read_entire_file(path, context.allocator)
		if read_err == nil {
			unchanged, _ := strings.remove_all(string(written), "\r")
			if unchanged == text {
				continue
			}
		}
		if check {
			fmt.println(path)
			status = 1
		} else if os.write_entire_file(path, transmute([]u8)text) != nil {
			errorf(c, no_span(), "L0401", "cannot write `%s`", path)
			status = 1
		}
	}
	return status
}

// The interface file `-api` would write for the package holding the source at
// `path`, or for the root package when no package of the check holds it: what
// the editor's documentation command shows (compiler-guide.md "Language
// server").
interface_of_source :: proc(c: ^Compiler, path: string) -> (string, bool) {
	wanted := dir_key(canonical_dir(path))
	id := c.root_package
	search: for &pkg in c.packages[1:] {
		for file in pkg.files {
			if dir_key(canonical_dir(c.sources[file.file].path)) == wanted {
				id = pkg.id
				break search
			}
		}
	}
	return interface_text(c, id)
}

// The interface file of package `id`: its overview and package clause, the
// imports its signatures name, then its API in source order, each declaration
// without a body after its doc comment, laid out as `-fmt` lays it out. False,
// with a diagnostic, when the text would not parse, which is a compiler bug.
interface_text :: proc(c: ^Compiler, id: Package_Id) -> (string, bool) {
	a := api_package(c, id)
	body := strings.builder_make()
	write_interface_items(&body, &a, a.items[:])

	b := strings.builder_make()
	strings.write_string(&b, "// Generated by `lokec -api` from this directory's .loke files. Do not edit.\n\n")
	overview := make([dynamic]string)
	for doc in a.overview {
		if doc != "" {
			append(&overview, doc)
		}
	}
	write_doc_lines(&b, strings.join(overview[:], "\n\n"))
	fmt.sbprintfln(&b, "package %s;", a.name)

	qualifiers := make(map[string]bool)
	collect_names(&a, a.items[:], &qualifiers, qualified = true)
	imports := make([dynamic]Api_Import)
	for imported in a.imports {
		if imported.name in qualifiers && !slice.contains(imports[:], imported) {
			append(&imports, imported)
		}
	}
	slice.sort_by(imports[:], proc(x, y: Api_Import) -> bool {
		return x.path < y.path || (x.path == y.path && x.alias < y.alias)
	})
	if len(imports) > 0 {
		strings.write_byte(&b, '\n')
	}
	for imported in imports {
		if imported.alias != "" {
			fmt.sbprintfln(&b, "import %s %s;", imported.alias, imported.path)
		} else {
			fmt.sbprintfln(&b, "import %s;", imported.path)
		}
	}
	strings.write_string(&b, strings.to_string(body))

	// Copied source keeps its own line ends; the file has LF only.
	raw, _ := strings.remove_all(strings.to_string(b), "\r")
	scratch: Compiler
	defer destroy_compilation(&scratch)
	formatted, ok := "", false
	if file, added := add_loaded_source(&scratch, INTERFACE_FILE, transmute([]u8)strings.clone(raw)); added {
		formatted, ok = format_source(&scratch, file)
	}
	if !ok {
		errorf(c, no_span(), "L0405", "internal error: the interface file of package `%s` would not parse", a.name)
	}
	return formatted, ok
}

// One shown entry of a package's API.
@(private = "file")
Api_Item :: struct {
	kind:       Api_Kind,
	// `.Decl`: its name, after its `impl`'s subject for a member.
	name:       string,
	// `.Decl`: the declaration without its `;`, its comments other than doc
	// comments, or a procedure's body, and with only a struct's public fields.
	// `.Impl`: `impl Subject`. `.Delegate`: the item as written.
	text:       string,
	// `.Decl`: what ends its interface form: ` ---;` for a procedure, and for
	// anything else the `;` it was written with, which a type declaration
	// ending in `}` leaves out.
	terminator: string,
	// `.Decl`: the written attributes but `public` and `private`, which decide
	// whether it is shown at all.
	attributes: [dynamic]string,
	doc:        string,
	// The names `text`'s code uses, and the ones a `.` follows.
	names:      []string,
	qualifiers: []string,
	// `.Impl`: its members, and its subject's name when the package declares
	// that type private.
	members:         [dynamic]Api_Item,
	private_subject: string,
	// `.When`: each branch, taken or not.
	branches:   [dynamic]Api_Branch,
}

@(private = "file")
Api_Kind :: enum {
	Decl,
	Impl,
	Delegate,
	When,
}

// `head` is `when (...)`, `else when (...)`, or `else`.
@(private = "file")
Api_Branch :: struct {
	head:  string,
	taken: bool,
	items: [dynamic]Api_Item,
}

@(private = "file")
Api_Package :: struct {
	name:     string,
	key:      string,
	// Each file's package-clause doc comment.
	overview: [dynamic]string,
	items:    [dynamic]Api_Item,
	// Every import a file of the package writes, and the name it binds.
	imports:  [dynamic]Api_Import,
	// The names the code of a shown declaration uses, which decide whether an
	// `impl` of a private type is shown.
	used:     map[string]bool,
}

@(private = "file")
Api_Import :: struct {
	name:  string,
	alias: string, // as written, or empty
	path:  string, // the literal, with its quotes
}

@(private = "file")
api_package :: proc(c: ^Compiler, id: Package_Id) -> Api_Package {
	pkg := package_of(c, id)
	a := Api_Package{name = identifier_text(c, pkg.name), key = pkg.key}
	private_names := make(map[string]bool)
	defer delete(private_names)
	for file in pkg.files {
		collect_private_names(c, file, file.items, &private_names)
	}
	for file in pkg.files {
		// The clause's span is its name's.
		text := c.sources[file.file].text
		keyword := u32(strings.last_index(text[:file.package_span.lo], "package"))
		start := written_start(text, keyword, file.attributes)
		append(&a.overview, doc_comment(c, Span{file = file.file, lo = start}))
		api_items(c, &a, file, file.items, &a.items, &private_names)
	}
	// design.md "Exported names" lets a public declaration name a private type,
	// as a public procedure may return an iterator whose type is private. An
	// importer cannot name such a type, but does call its members, so an `impl`
	// of one is shown once the code of a shown declaration names the type. A
	// name is matched by its spelling.
	for {
		before := len(a.used)
		collect_names(&a, a.items[:], &a.used, qualified = false)
		if len(a.used) == before {
			break
		}
	}
	return a
}

// The names of the declarations not shown, in every `when` branch.
@(private = "file")
collect_private_names :: proc(c: ^Compiler, file: ^File, items: []Item, names: ^map[string]bool) {
	for item in items {
		#partial switch v in item {
		case ^Decl:
			if len(v.names) > 0 && !decl_is_public(c, file, v) {
				names[v.names[0].text] = true
			}
		case ^Item_Block:
			collect_private_names(c, file, v.items, names)
		case ^Item_When:
			collect_private_names(c, file, v.then.items, names)
			collect_private_names(c, file, []Item{v.otherwise}, names)
		}
	}
}

// Every `when` branch is read, taken or not, so the interface file does not
// depend on the target.
@(private = "file")
api_items :: proc(
	c: ^Compiler, a: ^Api_Package, file: ^File, items: []Item, out: ^[dynamic]Api_Item,
	private_names: ^map[string]bool,
) {
	for item in items {
		#partial switch v in item {
		case ^Decl:
			api_decl(c, file, v, "", nil, out)
		case ^Item_Foreign_Block:
			for member in v.members {
				if d, is_decl := member.(^Decl); is_decl {
					api_decl(c, file, d, "", v.attributes, out)
				}
			}
		case ^Item_Impl:
			api_impl(c, file, v, out, private_names)
		case ^Item_Import:
			append(&a.imports, Api_Import{name = import_binding_name(v), alias = v.alias.text, path = v.path})
		case ^Item_Block:
			api_items(c, a, file, v.items, out, private_names)
		case ^Item_When:
			api_when(c, a, file, v, out, private_names)
		}
	}
}

@(private = "file")
api_impl :: proc(c: ^Compiler, file: ^File, v: ^Item_Impl, out: ^[dynamic]Api_Item, private_names: ^map[string]bool) {
	text := c.sources[v.span.file].text
	subject := source_text(c, v.type)
	impl := Api_Item{kind = .Impl, text = strings.trim_space(text[v.span.lo:expr_span(v.type).hi])}
	impl.names, impl.qualifiers = code_names(impl.text)
	if name := leading_name(subject); name in private_names {
		impl.private_subject = name
	}
	for member in v.members {
		#partial switch m in member {
		case ^Decl:
			api_decl(c, file, m, subject, nil, &impl.members)
		case ^Item_Delegate:
			// `delegation_is_public`: the file's default decides.
			if has_attribute(file.attributes, "public") {
				delegated := Api_Item{kind = .Delegate}
				delegated.text = strings.trim_right(strings.trim_space(text[m.span.lo:m.span.hi]), ";")
				append(&impl.members, delegated)
			}
		}
	}
	if len(impl.members) > 0 {
		append(out, impl)
	}
}

@(private = "file")
api_when :: proc(
	c: ^Compiler, a: ^Api_Package, file: ^File, v: ^Item_When, out: ^[dynamic]Api_Item,
	private_names: ^map[string]bool,
) {
	text := c.sources[v.span.file].text
	chosen := Api_Item{kind = .When}
	node, prefix, selected := v, "", false
	for {
		branch := Api_Branch{head = strings.concatenate({prefix, strings.trim_space(text[node.span.lo:node.then.span.lo])})}
		branch.taken = node.taken && !selected
		selected ||= node.taken
		api_items(c, a, file, node.then.items, &branch.items, private_names)
		append(&chosen.branches, branch)
		#partial switch next in node.otherwise {
		case ^Item_When:
			node, prefix = next, "else "
			continue
		case ^Item_Block:
			otherwise := Api_Branch{head = "else", taken = node.resolved && !node.stalled && !selected}
			api_items(c, a, file, next.items, &otherwise.items, private_names)
			append(&chosen.branches, otherwise)
		}
		break
	}
	// A trailing branch that shows nothing changes nothing an importer reads.
	for len(chosen.branches) > 0 && len(chosen.branches[len(chosen.branches) - 1].items) == 0 {
		pop(&chosen.branches)
	}
	if len(chosen.branches) > 0 {
		append(out, chosen)
	}
}

// `block` is a foreign block's attributes, which a member's own override.
@(private = "file")
api_decl :: proc(c: ^Compiler, file: ^File, d: ^Decl, subject: string, block: []Attribute, out: ^[dynamic]Api_Item) {
	if !decl_is_public(c, file, d, block) {
		return
	}
	source := &c.sources[d.span.file]
	text := source.text
	item := Api_Item{kind = .Decl, name = d.names[0].text}
	if subject != "" {
		item.name = fmt.aprintf("%s.%s", subject, item.name)
	}
	for attribute in d.attributes {
		spelled := text[attribute.span.lo:attribute.span.hi]
		if spelled != "public" && spelled != "private" {
			append(&item.attributes, spelled)
		}
	}
	lo, hi := d.names[0].span.lo, d.span.hi
	if literal := decl_proc_literal(d); literal != nil {
		if literal.body != nil {
			hi = literal.body.span.lo
		}
		written := strings.trim_right(strings.trim_space(shown_text(source, lo, hi)), ";")
		item.text = strings.trim_space(strings.trim_suffix(written, "---"))
		item.terminator = " ---;"
	} else {
		written := strings.trim_space(shown_text(source, lo, hi))
		item.text = strings.trim_right(written, ";")
		if record := decl_struct(d); record != nil {
			item.text = public_struct(c, file, record, lo)
		}
		// A span that ends in `}` stops before a `;` written after it.
		if strings.has_suffix(written, ";") || strings.has_prefix(strings.trim_left_space(text[hi:]), ";") {
			item.terminator = ";"
		}
	}
	item.doc = doc_comment(c, Span{file = d.span.file, lo = written_start(text, lo, d.attributes)})
	item.names, item.qualifiers = code_names(item.text)
	append(out, item)
}

// Whether an importer can name `d`. A declaration no symbol records, in an
// untaken `when` branch or a generic `impl`, which is checked per instance,
// takes its visibility from its written attributes, as the checker would.
@(private = "file")
decl_is_public :: proc(c: ^Compiler, file: ^File, d: ^Decl, block: []Attribute = nil) -> bool {
	if len(d.names) == 0 || d.names[0].text == "_" {
		return false
	}
	if len(d.symbols) > 0 {
		symbol := symbol_of(c, d.symbols[0])
		// design.md "Test procedures": no importer can call a test.
		return symbol != nil && symbol.public && !symbol.is_test
	}
	// design.md "Exported names": a variable is never public.
	if d.kind == .Var || has_attribute(d.attributes, "test") || has_attribute(d.attributes, "private") {
		return false
	}
	if has_attribute(d.attributes, "public") {
		return true
	}
	if has_attribute(block, "private") {
		return false
	}
	return has_attribute(block, "public") || has_attribute(file.attributes, "public")
}

@(private = "file")
decl_struct :: proc(d: ^Decl) -> ^Type_Record {
	if len(d.values) == 1 {
		if record, is_record := d.values[0].(^Type_Record); is_record && record.kind == .Struct {
			return record
		}
	}
	return nil
}

@(private = "file")
impl_shown :: proc(a: ^Api_Package, impl: ^Api_Item) -> bool {
	return impl.private_subject == "" || impl.private_subject in a.used
}

// The names the code of the shown items uses, or with `qualified` only the
// ones a `.` follows, as `mem` in `mem.Allocator`.
@(private = "file")
collect_names :: proc(a: ^Api_Package, items: []Api_Item, into: ^map[string]bool, qualified: bool) {
	for &item in items {
		if item.kind == .Impl && !impl_shown(a, &item) {
			continue
		}
		for name in (qualified ? item.qualifiers : item.names) {
			into[name] = true
		}
		collect_names(a, item.members[:], into, qualified)
		for &branch in item.branches {
			collect_names(a, branch.items[:], into, qualified)
		}
	}
}

// The identifiers of `text`'s code, its comments and literals aside, and the
// ones a `.` follows.
@(private = "file")
code_names :: proc(text: string) -> (names, qualifiers: []string) {
	scratch: Compiler
	defer destroy_compilation(&scratch)
	append(&scratch.sources, Source{text = text, line_starts = {}})
	tokens := lex(&scratch, 0)
	defer delete(tokens)
	found := make([dynamic]string)
	qualifying := make([dynamic]string)
	for token, index in tokens {
		if token.kind == .Ident {
			append(&found, text[token.lo:token.hi])
			if index + 1 < len(tokens) && tokens[index + 1].kind == .Period {
				append(&qualifying, text[token.lo:token.hi])
			}
		}
	}
	return found[:], qualifying[:]
}

// `Ordering` of `Ordering($T, $C)`.
@(private = "file")
leading_name :: proc(written: string) -> string {
	end := 0
	for end < len(written) && (written[end] == '_' || is_alnum_ascii(written[end])) {
		end += 1
	}
	return written[:end]
}

@(private = "file")
is_alnum_ascii :: proc(b: u8) -> bool {
	return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9')
}

// `source.text[lo:hi]` without its comments other than doc comments: one on a
// line of its own goes with its line, and one ending a line with the spaces
// before it.
@(private = "file")
shown_text :: proc(source: ^Source, lo, hi: u32) -> string {
	text := source.text
	b := strings.builder_make()
	at := lo
	for comment in source.comments {
		if comment.lo < lo || comment.hi > hi || is_doc_comment(text[comment.lo:comment.hi]) {
			continue
		}
		line_start := u32(strings.last_index_byte(text[:comment.lo], '\n') + 1)
		line_end := comment.hi
		for line_end < hi && (text[line_end] == ' ' || text[line_end] == '\t' || text[line_end] == '\r') {
			line_end += 1
		}
		ends_line := line_end >= hi || text[line_end] == '\n'
		cut_lo, cut_hi := comment.lo, comment.hi
		if !ends_line {
			// Between two tokens: the space after it separates them.
		} else if line_start >= at && strings.trim_space(text[line_start:comment.lo]) == "" {
			cut_lo, cut_hi = line_start, min(line_end + 1, hi)
		} else {
			cut_lo = max(at, u32(len(strings.trim_right_space(text[:comment.lo]))))
			cut_hi = line_end
		}
		strings.write_string(&b, text[at:cut_lo])
		at = cut_hi
	}
	strings.write_string(&b, text[at:hi])
	return strings.to_string(b)
}

// The doc comments, then the package's own items, of `-doc`'s page for `id`.
@(private = "file")
document_package :: proc(c: ^Compiler, b: ^strings.Builder, id: Package_Id) {
	a := api_package(c, id)
	if a.key == "" || strings.contains_rune(a.key, ':') {
		fmt.sbprintfln(b, "# package %s", a.name)
	} else {
		fmt.sbprintfln(b, "# package %s (`./%s`)", a.name, a.key)
	}
	for doc in a.overview {
		if doc != "" {
			fmt.sbprintfln(b, "\n%s", doc)
		}
	}
	document_items(b, &a, a.items[:])
}

// Each declaration's signature, then its doc comment. The page describes the
// target it was made for, so a `when` shows only its taken branch.
@(private = "file")
document_items :: proc(b: ^strings.Builder, a: ^Api_Package, items: []Api_Item) {
	for &item in items {
		switch item.kind {
		case .Decl:
			fmt.sbprintfln(b, "\n## %s\n\n```loke", item.name)
			for attribute in item.attributes {
				fmt.sbprintfln(b, "@(%s)", attribute)
			}
			fmt.sbprintfln(b, "%s\n```", item.text)
			if item.doc != "" {
				fmt.sbprintfln(b, "\n%s", item.doc)
			}
		case .Impl:
			if impl_shown(a, &item) {
				document_items(b, a, item.members[:])
			}
		case .Delegate:
		case .When:
			for &branch in item.branches {
				if branch.taken {
					document_items(b, a, branch.items[:])
				}
			}
		}
	}
}

// The items one to a paragraph, each after its doc comment. A file-scope
// `when`'s branches keep their contents at column zero, as `core/` writes them.
@(private = "file")
write_interface_items :: proc(b: ^strings.Builder, a: ^Api_Package, items: []Api_Item, indent := "") {
	first := true
	for &item in items {
		if !item_shown(a, &item) {
			continue
		}
		if !first || indent == "" {
			strings.write_byte(b, '\n')
		}
		first = false
		switch item.kind {
		case .Decl:
			write_doc_lines(b, item.doc, indent)
			for attribute in item.attributes {
				fmt.sbprintfln(b, "%s@(%s)", indent, attribute)
			}
			fmt.sbprintfln(b, "%s%s%s", indent, item.text, item.terminator)
		case .Delegate:
			fmt.sbprintfln(b, "%s%s;", indent, item.text)
		case .Impl:
			if item.private_subject != "" {
				fmt.sbprintfln(b, "// `%s` is private to the package, but a public declaration names it.", item.private_subject)
			}
			fmt.sbprintfln(b, "%s {{", item.text)
			write_interface_items(b, a, item.members[:], "\t")
			strings.write_string(b, "}\n")
		case .When:
			for &branch, index in item.branches {
				if index > 0 {
					strings.write_string(b, "} ")
				}
				fmt.sbprintfln(b, "%s {{", branch.head)
				write_interface_items(b, a, branch.items[:])
				strings.write_byte(b, '\n')
			}
			strings.write_string(b, "}\n")
		}
	}
}

@(private = "file")
item_shown :: proc(a: ^Api_Package, item: ^Api_Item) -> bool {
	#partial switch item.kind {
	case .Impl:
		return impl_shown(a, item)
	case .When:
		for &branch in item.branches {
			for &member in branch.items {
				if item_shown(a, &member) {
					return true
				}
			}
		}
		return false
	}
	return true
}

// `doc`'s lines, each after `///`.
@(private = "file")
write_doc_lines :: proc(b: ^strings.Builder, doc: string, indent := "") {
	if doc == "" {
		return
	}
	for line in strings.split_lines(doc) {
		fmt.sbprintln(b, strings.trim_right_space(fmt.tprintf("%s/// %s", indent, line)))
	}
}

// Where something written at `lo` starts, counting its attributes: each one's
// span is its name's, after the `@(`.
@(private)
written_start :: proc(text: string, lo: u32, attributes: []Attribute) -> u32 {
	start := lo
	for attribute in attributes {
		start = min(start, u32(strings.last_index_byte(text[:attribute.span.lo], '@')))
	}
	return start
}

// `Name :: struct { ... }`, written at `lo`, with only its public fields, one
// to a line, each after its doc comment.
@(private = "file")
public_struct :: proc(c: ^Compiler, file: ^File, record: ^Type_Record, lo: u32) -> string {
	source := &c.sources[record.span.file]
	written := source.text[lo:record.span.hi]
	b := strings.builder_make()
	open := strings.index_byte(written, '{')
	if len(record.fields) == 0 {
		return fmt.aprintf("%s}", strings.trim_space(written[:open + 1]))
	}
	fmt.sbprintln(&b, strings.trim_space(written[:open + 1]))
	hidden := false
	for field in record.fields {
		if len(field.names) == 1 && field.names[0].text == "_" {
			continue // padding
		}
		public: bool
		if len(field.symbols) > 0 {
			symbol := symbol_of(c, field.symbols[0])
			public = symbol != nil && symbol.public
		} else {
			// A generic record's fields are checked per instance, and an untaken
			// `when` branch's not at all.
			public = written_is_public(field.attributes, file.attributes, file.package_name == "main")
		}
		if public {
			write_doc_lines(&b, doc_comment(c, field.span), "\t")
			field_text := strings.trim_space(shown_text(source, field.span.lo, field.span.hi))
			// Every field shown is public.
			for strings.has_prefix(field_text, "@(public)") || strings.has_prefix(field_text, "@(private)") {
				field_text = strings.trim_left_space(field_text[strings.index_byte(field_text, ')') + 1:])
			}
			fmt.sbprintfln(&b, "\t%s,", strings.trim_right(field_text, ","))
		} else {
			hidden = true
		}
	}
	if hidden {
		fmt.sbprintln(&b, "\t// and fields private to the package")
	}
	strings.write_string(&b, "}")
	return strings.to_string(b)
}

// design.md "Doc comments": the doc comments in the block directly above `at`,
// one to a line, with their markers removed.
doc_comment :: proc(c: ^Compiler, at: Span) -> string {
	source := &c.sources[at.file]
	first, last := comment_block(source, at.lo)
	lines := make([dynamic]string)
	defer delete(lines)
	for comment in source.comments[first:last] {
		written := source.text[comment.lo:comment.hi]
		if is_doc_comment(written) {
			written = written[3:]
			append(&lines, strings.has_prefix(written, " ") ? written[1:] : written)
		}
	}
	return strings.join(lines[:], "\n")
}

@(private = "file")
is_doc_comment :: proc(written: string) -> bool {
	return strings.has_prefix(written, "///") && !strings.has_prefix(written, "////")
}

// The comments directly above `lo`, as a range of `source.comments`: each on a
// line of its own, with no blank line between them or below the last.
@(private = "file")
comment_block :: proc(source: ^Source, lo: u32) -> (first, last: int) {
	text := source.text
	// The comments are in source order, so the first one ending after `lo`
	// starts the search without visiting the later ones.
	low, high := 0, len(source.comments)
	for low < high {
		middle := (low + high) / 2
		if source.comments[middle].hi > lo {
			high = middle
		} else {
			low = middle + 1
		}
	}
	first = low
	for index := low - 1; index >= 0; index -= 1 {
		comment := source.comments[index]
		below := lo if first == low else source.comments[first].lo
		gap := text[comment.hi:below]
		line_start := strings.last_index_byte(text[:comment.lo], '\n') + 1
		if strings.count(gap, "\n") != 1 || strings.trim_space(gap) != "" ||
		   strings.trim_space(text[line_start:comment.lo]) != "" {
			break
		}
		first = index
	}
	return first, low
}

// design.md "Doc comments": a doc comment in no documented item's block is
// reported. Every `when` branch counts, taken or not, so the report does not
// depend on the target.
check_doc_comments :: proc(c: ^Compiler, file: ^File) {
	source := &c.sources[file.file]
	found := false
	for comment in source.comments {
		if is_doc_comment(source.text[comment.lo:comment.hi]) {
			found = true
			break
		}
	}
	if !found {
		return
	}
	w := Doc_Walk{source = source, documented = make([]bool, len(source.comments), context.temp_allocator)}
	if file.package_name != "" {
		// The clause's span is its name's.
		keyword := u32(strings.last_index(source.text[:file.package_span.lo], "package"))
		document_block(&w, written_start(source.text, keyword, file.attributes))
	}
	for item in file.items {
		walk_documented_item(&w, item)
	}
	for comment, index in source.comments {
		if !w.documented[index] && is_doc_comment(source.text[comment.lo:comment.hi]) {
			warnf(
				c, comment, "L0260",
				"this doc comment documents nothing: it must be directly above a declaration, field, variant, member, or `package` clause, with no blank line between",
			)
		}
	}
}

@(private = "file")
Doc_Walk :: struct {
	source:     ^Source,
	documented: []bool, // per comment
}

@(private = "file")
document_block :: proc(w: ^Doc_Walk, lo: u32) {
	first, last := comment_block(w.source, lo)
	for index in first ..< last {
		w.documented[index] = true
	}
}

@(private = "file")
walk_documented_item :: proc(w: ^Doc_Walk, item: Item) {
	#partial switch v in item {
	case ^Decl:
		if len(v.names) > 0 {
			document_block(w, written_start(w.source.text, min(v.span.lo, v.names[0].span.lo), v.attributes))
		}
		walk_documented_type(w, v.declared_type)
		for value in v.values {
			walk_documented_type(w, value)
		}
	case ^Item_Impl:
		for member in v.members {
			walk_documented_item(w, member)
		}
	case ^Item_Foreign_Block:
		for member in v.members {
			walk_documented_item(w, member)
		}
	case ^Item_Block:
		for member in v.items {
			walk_documented_item(w, member)
		}
	case ^Item_When:
		walk_documented_item(w, v.then)
		walk_documented_item(w, v.otherwise)
	}
}

// The members of a type written in a declaration, and of the types written in
// those members.
@(private = "file")
walk_documented_type :: proc(w: ^Doc_Walk, e: Expr) {
	#partial switch v in e {
	case ^Type_Record:
		walk_documented_fields(w, v.fields)
		walk_documented_variants(w, v.variants)
	case ^Type_Anon_Record:
		walk_documented_fields(w, v.fields)
	case ^Type_Anon_Union:
		walk_documented_variants(w, v.variants)
	case ^Type_Enum:
		for field in v.fields {
			document_block(w, field.span.lo)
		}
	case ^Type_Interface:
		for requirement in v.requirements {
			document_block(w, requirement.span.lo)
		}
	}
}

@(private = "file")
walk_documented_fields :: proc(w: ^Doc_Walk, fields: []Field) {
	for field in fields {
		document_block(w, written_start(w.source.text, field.span.lo, field.attributes))
		walk_documented_type(w, field.type)
	}
}

@(private = "file")
walk_documented_variants :: proc(w: ^Doc_Walk, variants: []Variant) {
	for variant in variants {
		document_block(w, variant.span.lo)
		walk_documented_type(w, variant.type)
	}
}

@(private = "file")
source_text :: proc(c: ^Compiler, e: Expr) -> string {
	span := expr_span(e)
	return c.sources[span.file].text[span.lo:span.hi]
}
