// `-doc` and `-api`: the public API of the root package, and of each package
// of the project it imports, from their checked public declarations and their
// doc comments (design.md "Doc comments"). `-doc` prints it as Markdown, and
// `-api` writes each package's interface file, Loke source without bodies
// (compiler-guide.md "Interface files"). Both read one model of a package's
// API, so they show the same declarations. Building that model allocates as it
// goes and frees nothing, as a command that writes once and exits may; a
// caller that lives on, like the language server, runs it under a temporary
// allocator.
package lokec

import "core:fmt"
import "core:os"
import "core:slice"
import "core:strings"

@(private = "file")
INTERFACE_FILE :: "api.loki"

// The root package, then each project package, in the order they were loaded.
// A project package is one whose key names no collection.
@(private = "file")
documented_packages :: proc(c: ^Compiler, root: Package_Id) -> []Package_Id {
	ids := make([dynamic]Package_Id)
	append(&ids, root)
	for pkg in c.packages[1:] {
		if pkg.id != root && !strings.contains_rune(pkg.key, ':') {
			append(&ids, pkg.id)
		}
	}
	return ids[:]
}

document_project :: proc(c: ^Compiler, root: Package_Id) -> string {
	b := strings.builder_make()
	for id, index in documented_packages(c, root) {
		if index > 0 {
			strings.write_byte(&b, '\n')
		}
		document_package(c, &b, id)
	}
	return strings.to_string(b)
}

// `-api` writes the interface file of each package `-doc` documents, and
// `-api-check` lists the ones that differ from what `-api` would write. The
// status is 1 when one differs or cannot be written.
write_interfaces :: proc(c: ^Compiler, root: Package_Id, check: bool) -> int {
	status := 0
	for id in documented_packages(c, root) {
		pkg := package_of(c, id)
		if len(pkg.files) == 0 {
			continue
		}
		path := join_path({path_dir(c.sources[pkg.files[0].file].path), INTERFACE_FILE})
		text, ok := interface_text(c, id)
		if !ok {
			status = 1
			continue
		}
		// A checkout may have turned the file's line ends into CRLF.
		written, read_err := os.read_entire_file(path, context.allocator)
		if read_err == nil {
			unchanged, _ := strings.remove_all(string(written), "\r")
			if unchanged == text {
				continue
			}
		}
		if check {
			fmt.println(path)
			status = 1
		} else if os.write_entire_file(path, transmute([]u8)text) != nil {
			errorf(c, no_span(), "L0401", "cannot write `%s`", path)
			status = 1
		}
	}
	return status
}

// The interface file `-api` would write for the package holding the source at
// `path`, or for the root package when no package of the check holds it: what
// the editor's documentation command shows (compiler-guide.md "Language
// server").
interface_of_source :: proc(c: ^Compiler, path: string) -> (string, bool) {
	id, found := c.package_by_dir[dir_key(canonical_dir(path_dir(path, context.temp_allocator)))]
	return interface_text(c, found ? id : c.root_package)
}

// False, with a diagnostic, when the text would not parse or a copied
// declaration lost a token, either a compiler bug.
@(private = "file")
interface_text :: proc(c: ^Compiler, id: Package_Id) -> (string, bool) {
	a := api_package(c, id)
	b := strings.builder_make()
	strings.write_string(&b, "// Generated by `lokec -api` from this directory's .loke files. Do not edit.\n\n")
	write_doc_lines(&b, strings.join(a.overview[:], "\n\n"))
	fmt.sbprintfln(&b, "package %s;", a.name)

	imports := make([dynamic]Api_Import)
	for imported in a.imports {
		if imported.name in a.qualifiers && !slice.contains(imports[:], imported) {
			append(&imports, imported)
		}
	}
	slice.sort_by(imports[:], proc(x, y: Api_Import) -> bool {
		return x.path < y.path || (x.path == y.path && x.alias < y.alias)
	})
	if len(imports) > 0 {
		strings.write_byte(&b, '\n')
	}
	for imported in imports {
		fmt.sbprintfln(&b, "%s;", import_text(imported))
	}
	write_interface_items(&b, &a, a.items[:])

	// Copied source keeps its own line ends; the file has LF only.
	raw, _ := strings.remove_all(strings.to_string(b), "\r")
	raw = plain_comments(raw)
	scratch: Compiler
	defer destroy_compilation(&scratch)
	formatted, ok := format_text(&scratch, INTERFACE_FILE, raw)
	if !ok || a.damaged {
		errorf(c, no_span(), "L0405", "internal error: the interface file of package `%s` would not match its source", a.name)
		return "", false
	}
	return formatted, true
}

// `text` with each doc comment written `//` or `/*`. Every comment of an
// interface file is for the package's users, so `///` or `/**` would mark
// nothing.
@(private = "file")
plain_comments :: proc(text: string) -> string {
	comments := make([dynamic]Span)
	delete(lex_text(text, &comments))
	b := strings.builder_make()
	at := u32(0)
	for comment in comments {
		if written := text[comment.lo:comment.hi]; is_doc_comment(written) {
			strings.write_string(&b, text[at:comment.lo])
			strings.write_string(&b, written[:2])
			at = comment.lo + len("///")
		}
	}
	strings.write_string(&b, text[at:])
	return strings.to_string(b)
}

// One entry of a package's API.
@(private = "file")
Api_Item :: struct {
	kind:       Api_Kind,
	// `.Decl`: its name, after its `impl`'s subject for a member. `.Import`:
	// the name it binds.
	name:       string,
	// `.Decl`: the name a reference reaches it by, `Subject.name` for an
	// `impl` member.
	key:        string,
	// `.Decl`: the declaration without its `;`, its comments other than doc
	// comments, or a procedure's body, and with only a struct's public fields.
	// `.Impl`: `impl Subject`. `.Delegate` and `.Import`: the item as written.
	text:       string,
	// `.Decl`: what ends its interface form: ` ---;` for a procedure, and for
	// anything else the `;` it was written with, which a type declaration
	// ending in `}` leaves out.
	terminator: string,
	// `.Decl`: the written attributes but `public` and `private`, which decide
	// whether it is shown at all, and those a foreign block lends its members.
	attributes: [dynamic]string,
	doc:        string,
	// `.Decl`: private to the package, so shown only once a shown item refers
	// to it.
	private:    bool,
	// The declarations of the package the shown syntax refers to, by `key`,
	// and the imports it qualifies names with.
	refs:       []string,
	qualifiers: []string,
	// `.Impl`: its members, and its subject's name when the package declares
	// that type private.
	members:         [dynamic]Api_Item,
	private_subject: string,
	// `.When`: each branch, taken or not.
	branches:   [dynamic]Api_Branch,
}

@(private = "file")
Api_Kind :: enum {
	Decl,
	Impl,
	Delegate,
	Import,
	When,
}

// `head` is `when (...)`, `else when (...)`, or `else`, and `refs` and
// `qualifiers` are its condition's.
@(private = "file")
Api_Branch :: struct {
	head:       string,
	taken:      bool,
	items:      [dynamic]Api_Item,
	refs:       []string,
	qualifiers: []string,
}

@(private = "file")
Api_Package :: struct {
	name:     string,
	key:      string,
	// The package-clause doc comments, one per file that has one.
	overview: [dynamic]string,
	items:    [dynamic]Api_Item,
	// The imports written outside any `when`, which the file writes first;
	// one inside a `when` stays in its branch, as an `.Import` item.
	imports:  [dynamic]Api_Import,
	import_names: map[string]bool,
	// What the shown items refer to: private declarations, which are then
	// shown too, and imports, which are then written.
	reached:    map[string]bool,
	qualifiers: map[string]bool,
	// A comment's removal changed a copied declaration's tokens.
	damaged:  bool,
}

@(private = "file")
Api_Import :: struct {
	name:  string,
	alias: string, // as written, or empty
	path:  string, // the literal, with its quotes
}

@(private = "file")
Api_Builder :: struct {
	c:    ^Compiler,
	a:    ^Api_Package,
	file: ^File,
	// Each declaration of the package, at file scope or in an `impl`, by its
	// symbol, as its `Api_Item.key`.
	declared:      map[Symbol_Id]string,
	private_names: map[string]bool,
}

// design.md "Private names in public declarations". An importer cannot name such
// a declaration but does reach it, so it is shown, marked private, once a shown
// item refers to it. A reference follows what the checker resolved, and only in
// syntax it never resolved goes by written name.
@(private = "file")
api_package :: proc(c: ^Compiler, id: Package_Id) -> Api_Package {
	pkg := package_of(c, id)
	a := Api_Package{name = identifier_text(c, pkg.name), key = pkg.key}
	b := Api_Builder{c = c, a = &a}
	for file in pkg.files {
		b.file = file
		collect_declared(&b, file.items)
	}
	for file in pkg.files {
		b.file = file
		if doc := doc_comment(c, Span{file = file.file, lo = file.package_lo}); doc != "" {
			append(&a.overview, doc)
		}
		api_items(&b, file.items, &a.items, in_when = false)
	}
	for {
		before := len(a.reached) + len(a.qualifiers)
		collect_refs(&a, a.items[:])
		if len(a.reached) + len(a.qualifiers) == before {
			break
		}
	}
	return a
}

@(private = "file")
collect_declared :: proc(b: ^Api_Builder, items: []Item) {
	for item in items {
		#partial switch v in item {
		case ^Decl:
			declare(b, v, v.names[0].text)
			if !decl_is_public(b.c, b.file, v) {
				b.private_names[v.names[0].text] = true
			}
		case ^Item_Foreign_Block:
			for member in v.members {
				if d, is_decl := member.(^Decl); is_decl {
					declare(b, d, d.names[0].text)
				}
			}
		case ^Item_Impl:
			subject := subject_name(b.c, v.type)
			for member in v.members {
				if d, is_decl := member.(^Decl); is_decl {
					declare(b, d, fmt.aprintf("%s.%s", subject, d.names[0].text))
				}
			}
		case ^Item_Import:
			b.a.import_names[import_binding_name(v)] = true
		case ^Item_Block:
			collect_declared(b, v.items)
		case ^Item_When:
			collect_declared(b, v.then.items)
			collect_declared(b, []Item{v.otherwise})
		}
	}
}

@(private = "file")
declare :: proc(b: ^Api_Builder, d: ^Decl, key: string) {
	for symbol in d.symbols {
		b.declared[symbol] = key
	}
}

// Every `when` branch is read, taken or not, so the interface file does not
// depend on the target.
@(private = "file")
api_items :: proc(b: ^Api_Builder, items: []Item, out: ^[dynamic]Api_Item, in_when: bool) {
	for item in items {
		#partial switch v in item {
		case ^Decl:
			api_decl(b, v, nil, nil, out, nil)
		case ^Item_Foreign_Block:
			for member in v.members {
				if d, is_decl := member.(^Decl); is_decl {
					api_decl(b, d, nil, v.attributes, out, nil)
				}
			}
		case ^Item_Impl:
			api_impl(b, v, out)
		case ^Item_Import:
			imported := Api_Import{name = import_binding_name(v), alias = v.alias.text, path = v.path}
			if in_when {
				append(out, Api_Item{kind = .Import, name = imported.name, text = import_text(imported)})
			} else {
				append(&b.a.imports, imported)
			}
		case ^Item_When:
			api_when(b, v, out)
		}
	}
}

@(private = "file")
api_impl :: proc(b: ^Api_Builder, v: ^Item_Impl, out: ^[dynamic]Api_Item) {
	source := &b.c.sources[v.span.file]
	impl := Api_Item{kind = .Impl}
	impl.text = shown_text(b, source, v.span.lo, expr_span(v.type).hi)
	w := Ref_Walk{b = b}
	api_refs(&w, v.type)
	impl.refs, impl.qualifiers = w.refs[:], text_qualifiers(b.a, impl.text)
	// design.md "Private names in public declarations": a block written through
	// a private alias of a public type is on the public type.
	if name := subject_name(b.c, v.type); name in b.private_names && !subject_type_is_public(b.c, v) {
		impl.private_subject = name
	}
	// `impl Box($T)` binds `T` for its members.
	bound := make([dynamic]string)
	bind_poly_names(&bound, v.type)
	for member in v.members {
		#partial switch m in member {
		case ^Decl:
			api_decl(b, m, v, nil, &impl.members, bound[:])
		case ^Item_Delegate:
			// `delegation_is_public`: the file's default decides.
			if has_attribute(b.file.attributes, "public") {
				delegated := Api_Item{kind = .Delegate}
				delegated.text = strings.trim_right(shown_text(b, source, m.span.lo, m.span.hi), ";")
				delegated.qualifiers = text_qualifiers(b.a, delegated.text)
				append(&impl.members, delegated)
			}
		}
	}
	if len(impl.members) > 0 {
		append(out, impl)
	}
}

@(private = "file")
api_when :: proc(b: ^Api_Builder, v: ^Item_When, out: ^[dynamic]Api_Item) {
	source := &b.c.sources[v.span.file]
	chosen := Api_Item{kind = .When}
	node, prefix, selected := v, "", false
	for {
		head := shown_text(b, source, node.span.lo, node.then.span.lo)
		branch := Api_Branch{head = strings.concatenate({prefix, head}), taken = node.state == .Taken && !selected}
		selected ||= node.state == .Taken
		w := Ref_Walk{b = b}
		api_refs(&w, node.cond)
		branch.refs, branch.qualifiers = w.refs[:], text_qualifiers(b.a, head)
		api_items(b, node.then.items, &branch.items, in_when = true)
		append(&chosen.branches, branch)
		#partial switch next in node.otherwise {
		case ^Item_When:
			node, prefix = next, "else "
			continue
		case ^Item_Block:
			otherwise := Api_Branch{head = "else", taken = node.state == .Not_Taken && !selected}
			api_items(b, next.items, &otherwise.items, in_when = true)
			append(&chosen.branches, otherwise)
		}
		break
	}
	append(out, chosen)
}

// `owner` is the `impl` `d` is a member of, `block` the attributes of the foreign
// block it is a member of, which a member's own override, and `bound` the names
// its `impl` binds.
@(private = "file")
api_decl :: proc(
	b: ^Api_Builder, d: ^Decl, owner: ^Item_Impl, block: []Attribute, out: ^[dynamic]Api_Item,
	bound: []string,
) {
	// design.md "Exported names": a variable is never public. design.md "Test
	// procedures": no importer can call a test, and only `@(test)` makes one.
	if d.names[0].text == "_" || d.kind == .Var || has_attribute(d.attributes, "test") {
		return
	}
	c := b.c
	source := &c.sources[d.span.file]
	item := Api_Item{kind = .Decl, name = d.names[0].text, key = d.names[0].text}
	subject := ""
	if owner != nil {
		subject = subject_name(c, owner.type)
		item.name = fmt.aprintf("%s.%s", source_text(c, owner.type), item.name)
		item.key = fmt.aprintf("%s.%s", subject, item.key)
	}
	item.private = !decl_is_public(c, b.file, d, block)
	item.attributes = shown_attributes(b, source, d.attributes)
	w := Ref_Walk{b = b, subject = subject}
	append(&w.bound, ..bound)
	// `@(align=N)` may name a generic parameter of the record it describes.
	mark := len(w.bound)
	if len(d.values) == 1 {
		if record, is_record := d.values[0].(^Type_Record); is_record {
			bind_generic_params(&w.bound, record.generic_params)
		}
	}
	attribute_refs(&w, d.attributes)
	resize(&w.bound, mark)
	api_refs(&w, d.declared_type)
	lo := d.names[0].span.lo
	if literal := decl_proc_literal(d); literal != nil {
		item.text = proc_interface_text(b, d, literal, block)
		item.terminator = " ---;"
		api_refs(&w, literal)
		// design.md "Foreign system": a member takes the block's calling
		// convention and result requirement unless it states its own.
		if has_attribute(block, "require_results") && !has_attribute(d.attributes, "require_results") {
			append(&item.attributes, "require_results")
		}
	} else {
		written := shown_text(b, source, lo, d.span.hi)
		item.text = strings.trim_right(written, ";")
		if record := decl_struct(d); record != nil {
			item.text = public_struct(b, record, lo)
		}
		for value in d.values {
			api_refs(&w, value)
		}
		// A span that ends in `}` stops before a `;` written after it.
		if strings.has_suffix(written, ";") || strings.has_prefix(strings.trim_left_space(source.text[d.span.hi:]), ";") {
			item.terminator = ";"
		}
	}
	item.refs = w.refs[:]
	item.qualifiers = text_qualifiers(b.a, fmt.aprintf("%s %s", strings.join(item.attributes[:], " "), item.text))
	item.doc = doc_comment(c, d.span)
	append(out, item)
}

// The written attributes but `public` and `private`, each as written inside
// `@(...)`.
@(private = "file")
shown_attributes :: proc(b: ^Api_Builder, source: ^Source, attributes: []Attribute) -> [dynamic]string {
	shown := make([dynamic]string)
	for attribute in attributes {
		spelled := shown_text(b, source, attribute.span.lo, attribute.span.hi)
		if spelled != "public" && spelled != "private" {
			append(&shown, spelled)
		}
	}
	return shown
}

// The procedure's signature, without its `---` or its body, and with the calling
// convention `block` lends it.
@(private = "file")
proc_interface_text :: proc(b: ^Api_Builder, d: ^Decl, literal: ^Expr_Proc, block: []Attribute) -> string {
	source := &b.c.sources[d.span.file]
	hi := literal.body != nil ? literal.body.span.lo : d.span.hi
	written := strings.trim_right(shown_text(b, source, d.names[0].span.lo, hi), ";")
	text := strings.trim_space(strings.trim_suffix(written, "---"))
	// The checker writes the block's convention into the signature, so the text
	// says whether the member wrote its own.
	after_colons := strings.index(text, "::") + 2
	at := after_colons + strings.index(text[after_colons:], "proc") + len("proc")
	rest := strings.trim_left_space(text[at:])
	if convention, found := find_attribute(block, "default_calling_convention"); found && convention.value != nil && !strings.has_prefix(rest, "\"") {
		return fmt.aprintf("%s %s %s", text[:at], source_text(b.c, convention.value), rest)
	}
	return text
}

@(private = "file")
decl_struct :: proc(d: ^Decl) -> ^Type_Record {
	if len(d.values) == 1 {
		if record, is_record := d.values[0].(^Type_Record); is_record && record.kind == .Struct {
			return record
		}
	}
	return nil
}

// Whether a struct field is shown: a public one, but not padding.
@(private = "file")
field_shown :: proc(b: ^Api_Builder, field: ^Field) -> bool {
	for name, index in field.names {
		if name.text == "_" {
			continue
		}
		// A generic record's fields are checked per instance, and an untaken
		// `when` branch's not at all.
		if index >= len(field.symbols) {
			return written_is_public(field.attributes, b.file.attributes, b.file.package_name == "main")
		}
		symbol := symbol_of(b.c, field.symbols[index])
		return symbol != nil && symbol.public
	}
	return false
}

// `Name :: struct { ... }`, written at `lo`, with only its public fields, one
// to a line, each after its doc comment.
@(private = "file")
public_struct :: proc(b: ^Api_Builder, record: ^Type_Record, lo: u32) -> string {
	source := &b.c.sources[record.span.file]
	head := shown_text(b, source, lo, record.body_lo + 1)
	if len(record.fields) == 0 {
		return fmt.aprintf("%s}", head)
	}
	out := strings.builder_make()
	fmt.sbprintln(&out, head)
	hidden := false
	for &field in record.fields {
		if field_shown(b, &field) {
			write_doc_lines(&out, doc_comment(b.c, field.span), "\t")
			strings.write_byte(&out, '\t')
			for attribute in shown_attributes(b, source, field.attributes) {
				fmt.sbprintf(&out, "@(%s) ", attribute)
			}
			if field.is_using {
				strings.write_string(&out, "using ")
			}
			fmt.sbprintfln(&out, "%s,", shown_text(b, source, field.names[0].span.lo, field.span.hi))
		} else if len(field.names) != 1 || field.names[0].text != "_" {
			hidden = true
		}
	}
	if hidden {
		fmt.sbprintln(&out, "\t// and fields private to the package")
	}
	strings.write_string(&out, "}")
	return strings.to_string(out)
}

@(private = "file")
Ref_Walk :: struct {
	b:       ^Api_Builder,
	// The subject of the `impl` the syntax is in, whose members a written
	// name may also mean.
	subject: string,
	// The parameters and `$` names in scope, which a written name means before
	// any declaration of the package.
	bound:   [dynamic]string,
	refs:    [dynamic]string,
}

// The declarations of the package that `e` refers to. A procedure's body is
// not walked: only its signature is shown.
@(private = "file")
api_refs :: proc(w: ^Ref_Walk, e: Expr) {
	if e == nil {
		return
	}
	switch v in e {
	case ^Expr_Error, ^Expr_Literal, ^Expr_Propagated_Error, ^Type_Type, ^Type_Poly:
	case ^Expr_Ident:
		symbol := v.resolution.symbol != INVALID_SYMBOL ? v.resolution.symbol : v.symbol
		if symbol == INVALID_SYMBOL {
			ref_by_name(w, v.name)
		} else if key, declared := w.b.declared[symbol]; declared {
			append(&w.refs, key)
		}
	case ^Expr_Selector:
		// A member, as `Boxed.DEFAULT`; an import's name resolves to no
		// declaration of the package.
		if v.resolution.symbol != INVALID_SYMBOL {
			if key, declared := w.b.declared[v.resolution.symbol]; declared {
				append(&w.refs, key)
			}
		} else if ident, is_ident := v.operand.(^Expr_Ident); is_ident && ident.resolution.kind == .Unresolved && !slice.contains(w.bound[:], ident.name) {
			append(&w.refs, fmt.aprintf("%s.%s", ident.name, v.name.text))
		}
		api_refs(w, v.operand)
	case ^Expr_Index:
		api_refs(w, v.operand)
		for index in v.indices {
			api_refs(w, index)
		}
	case ^Expr_Slice:
		api_refs(w, v.operand)
		api_refs(w, v.lo)
		api_refs(w, v.hi)
	case ^Expr_Call:
		api_refs(w, v.callee)
		for argument in v.args {
			api_refs(w, argument.value)
		}
	case ^Expr_Postfix:
		api_refs(w, v.operand)
		api_refs(w, v.failure)
	case ^Expr_Unary:
		api_refs(w, v.operand)
	case ^Expr_Binary:
		api_refs(w, v.lhs)
		api_refs(w, v.rhs)
	case ^Expr_Range:
		api_refs(w, v.lo)
		api_refs(w, v.hi)
	case ^Expr_Or_Else:
		api_refs(w, v.value)
		api_refs(w, v.fallback)
	case ^Expr_Cond:
		api_refs(w, v.cond)
		api_refs(w, v.then)
		api_refs(w, v.otherwise)
	case ^Expr_Move:
		api_refs(w, v.value)
	case ^Expr_Composite:
		api_refs(w, v.type_expr)
		api_refs(w, v.via)
		for element in v.elements {
			if !key_names_field(v, element.key) {
				api_refs(w, element.key)
			}
			api_refs(w, element.value)
		}
	case ^Expr_Proc:
		mark := len(w.bound)
		bind_signature(&w.bound, v.signature)
		api_refs(w, v.signature)
		for clause in v.where_clauses {
			api_refs(w, clause)
		}
		resize(&w.bound, mark)
	case ^Expr_Proc_Group:
		for name in v.names {
			ref_by_name(w, name.text)
		}
	case ^Expr_Operator:
		api_refs(w, v.value)
	case ^Type_Pointer:
		api_refs(w, v.elem)
	case ^Type_C_Pointer:
		api_refs(w, v.elem)
	case ^Type_Slice:
		api_refs(w, v.elem)
	case ^Type_Dynamic_Array:
		api_refs(w, v.elem)
	case ^Type_Distinct:
		api_refs(w, v.elem)
	case ^Type_Dyn:
		api_refs(w, v.interface_expr)
	case ^Type_Array:
		api_refs(w, v.length)
		api_refs(w, v.elem)
	case ^Type_Map:
		api_refs(w, v.key)
		api_refs(w, v.value)
	case ^Type_Proc:
		mark := len(w.bound)
		bind_signature(&w.bound, v)
		for parameter in v.params {
			api_refs(w, parameter.type)
			api_refs(w, parameter.default)
		}
		if v.result != nil {
			api_refs(w, v.result.type)
		}
		resize(&w.bound, mark)
	case ^Type_Record:
		mark := len(w.bound)
		bind_generic_params(&w.bound, v.generic_params)
		defer resize(&w.bound, mark)
		for parameter in v.generic_params {
			api_refs(w, parameter.type)
		}
		for clause in v.where_clauses {
			api_refs(w, clause)
		}
		for &field in v.fields {
			if field_shown(w.b, &field) {
				api_refs(w, field.type)
			}
		}
		for variant in v.variants {
			api_refs(w, variant.type)
		}
	case ^Type_Anon_Record:
		for field in v.fields {
			api_refs(w, field.type)
		}
	case ^Type_Anon_Union:
		for variant in v.variants {
			api_refs(w, variant.type)
		}
	case ^Type_Enum:
		api_refs(w, v.backing)
		for field in v.fields {
			api_refs(w, field.value)
		}
	case ^Type_Interface:
		mark := len(w.bound)
		bind_generic_params(&w.bound, v.generic_params)
		defer resize(&w.bound, mark)
		for parameter in v.generic_params {
			api_refs(w, parameter.type)
		}
		for clause in v.where_clauses {
			api_refs(w, clause)
		}
		for requirement in v.requirements {
			for group in requirement.bindings {
				api_refs(w, group.type)
			}
			api_refs(w, requirement.expr)
			api_refs(w, requirement.result)
			api_refs(w, requirement.slot_type)
		}
	}
}

// Whether a literal's `key` is the name of a field. An array's index or a map's
// key is an expression, which the checker resolves; where it did not look, the
// literal's written type says.
@(private = "file")
key_names_field :: proc(v: ^Expr_Composite, key: Expr) -> bool {
	ident, is_ident := key.(^Expr_Ident)
	if !is_ident || ident.resolution.symbol != INVALID_SYMBOL || ident.symbol != INVALID_SYMBOL {
		return false
	}
	#partial switch _ in v.type_expr {
	case ^Type_Array, ^Type_Slice, ^Type_Dynamic_Array, ^Type_Map:
		return false
	}
	return true
}

// The values of `attributes` that are expressions, as `N` in `@(align=N)`.
// design.md "Attribute categories": the others' values are strings, or names
// of variants, fields, and escape levels, which are not references.
@(private = "file")
attribute_refs :: proc(w: ^Ref_Walk, attributes: []Attribute) {
	for attribute in attributes {
		if len(attribute.path) == 1 {
			switch attribute.path[0].text {
			case "zero", "failure", "initialized", "escape":
				continue
			}
		}
		api_refs(w, attribute.value)
	}
}

// Each parameter's name, and each `$` name its types and defaults bind.
@(private = "file")
bind_signature :: proc(bound: ^[dynamic]string, signature: ^Type_Proc) {
	for parameter in signature.params {
		for name in parameter.names {
			append(bound, name.name.text)
		}
		bind_poly_names(bound, parameter.type)
		bind_poly_names(bound, parameter.default)
	}
}

@(private = "file")
bind_generic_params :: proc(bound: ^[dynamic]string, parameters: []Generic_Param) {
	for parameter in parameters {
		for name in parameter.names {
			append(bound, name.text)
		}
	}
}

// The `$` names written in type syntax, as `T` in `[]$T`.
@(private = "file")
bind_poly_names :: proc(bound: ^[dynamic]string, e: Expr) {
	type_syntax_any_name(e, bound, proc(data: rawptr, node: Expr) -> bool {
		if poly, is_poly := node.(^Type_Poly); is_poly {
			append((^[dynamic]string)(data), poly.name.text)
		}
		return false
	})
}

// A name nothing resolved, and no parameter or `$` name binds: a declaration
// of the package, or in an `impl`, a member of its subject.
@(private = "file")
ref_by_name :: proc(w: ^Ref_Walk, name: string) {
	if slice.contains(w.bound[:], name) {
		return
	}
	append(&w.refs, name)
	if w.subject != "" {
		append(&w.refs, fmt.aprintf("%s.%s", w.subject, name))
	}
}

@(private = "file")
item_shown :: proc(a: ^Api_Package, item: ^Api_Item) -> bool {
	switch item.kind {
	case .Decl:
		return !item.private || item.key in a.reached
	case .Delegate:
		return true
	case .Import:
		return item.name in a.qualifiers
	case .Impl:
		if item.private_subject != "" && !(item.private_subject in a.reached) {
			return false
		}
		for &member in item.members {
			if item_shown(a, &member) {
				return true
			}
		}
	case .When:
		return shown_branches(a, item) > 0
	}
	return false
}

// How many of a `when`'s branches are written: a trailing branch that shows
// nothing changes nothing an importer reads.
@(private = "file")
shown_branches :: proc(a: ^Api_Package, item: ^Api_Item) -> int {
	count := 0
	for &branch, index in item.branches {
		for &member in branch.items {
			if item_shown(a, &member) {
				count = index + 1
				break
			}
		}
	}
	return count
}

@(private = "file")
collect_refs :: proc(a: ^Api_Package, items: []Api_Item) {
	for &item in items {
		if !item_shown(a, &item) {
			continue
		}
		mark_refs(a, item.refs, item.qualifiers)
		collect_refs(a, item.members[:])
		for &branch in item.branches[:shown_branches(a, &item)] {
			mark_refs(a, branch.refs, branch.qualifiers)
			collect_refs(a, branch.items[:])
		}
	}
}

@(private = "file")
mark_refs :: proc(a: ^Api_Package, refs, qualifiers: []string) {
	for ref in refs {
		a.reached[ref] = true
	}
	for qualifier in qualifiers {
		a.qualifiers[qualifier] = true
	}
}

@(private = "file")
import_text :: proc(imported: Api_Import) -> string {
	if imported.alias != "" {
		return fmt.aprintf("import %s %s", imported.alias, imported.path)
	}
	return fmt.aprintf("import %s", imported.path)
}

// `source.text[lo:hi]`, trimmed, without its comments other than doc comments:
// one on a line of its own goes with its line, one ending a line with the spaces
// before it, and one between two tokens leaves a space. The result must lex to
// the same tokens; the package is marked damaged if it does not.
@(private = "file")
shown_text :: proc(b: ^Api_Builder, source: ^Source, lo, hi: u32) -> string {
	text := source.text
	out := strings.builder_make()
	at := lo
	for comment in source.comments[first_comment_after(source, lo):] {
		if comment.hi > hi {
			break
		}
		if is_doc_comment(text[comment.lo:comment.hi]) {
			continue
		}
		line_start := u32(strings.last_index_byte(text[:comment.lo], '\n') + 1)
		line_end := comment.hi
		for line_end < hi && (text[line_end] == ' ' || text[line_end] == '\t' || text[line_end] == '\r') {
			line_end += 1
		}
		ends_line := line_end >= hi || text[line_end] == '\n'
		cut_lo, cut_hi := comment.lo, comment.hi
		separator := ""
		if !ends_line {
			if cut_lo > at && !strings.is_space(rune(text[cut_lo - 1])) && !strings.is_space(rune(text[cut_hi])) {
				separator = " "
			}
		} else if line_start >= at && strings.trim_space(text[line_start:comment.lo]) == "" {
			cut_lo, cut_hi = line_start, min(line_end + 1, hi)
		} else {
			cut_lo = max(at, u32(len(strings.trim_right_space(text[:comment.lo]))))
			cut_hi = line_end
		}
		strings.write_string(&out, text[at:cut_lo])
		strings.write_string(&out, separator)
		at = cut_hi
	}
	strings.write_string(&out, text[at:hi])
	shown := strings.to_string(out)
	if !slice.equal(token_texts(text[lo:hi]), token_texts(shown)) {
		b.a.damaged = true
	}
	return strings.trim_space(shown)
}

// The imports `text` qualifies a name with, as `mem` in `mem.Allocator`. The
// written text decides which imports the interface file needs: the checker
// may have resolved a qualified name to a declaration of its own package.
@(private = "file")
text_qualifiers :: proc(a: ^Api_Package, text: string) -> []string {
	tokens := lex_text(text)
	defer delete(tokens)
	found := make([dynamic]string)
	for token, index in tokens {
		name := text[token.lo:token.hi]
		// The name after a `.` is a member, whatever it is spelled like.
		member := index > 0 && tokens[index - 1].kind == .Period
		if token.kind == .Ident && !member && index + 1 < len(tokens) && tokens[index + 1].kind == .Period && name in a.import_names {
			append(&found, name)
		}
	}
	return found[:]
}

@(private = "file")
token_texts :: proc(text: string) -> []string {
	tokens := lex_text(text)
	defer delete(tokens)
	spelled := make([]string, len(tokens))
	for token, index in tokens {
		spelled[index] = text[token.lo:token.hi]
	}
	return spelled
}

@(private = "file")
document_package :: proc(c: ^Compiler, b: ^strings.Builder, id: Package_Id) {
	a := api_package(c, id)
	if a.key == "" || strings.contains_rune(a.key, ':') {
		fmt.sbprintfln(b, "# package %s", a.name)
	} else {
		fmt.sbprintfln(b, "# package %s (`./%s`)", a.name, a.key)
	}
	for doc in a.overview {
		fmt.sbprintfln(b, "\n%s", doc)
	}
	document_items(b, &a, a.items[:])
}

// The page describes the target it was made for, so a `when` shows only its
// taken branch.
@(private = "file")
document_items :: proc(b: ^strings.Builder, a: ^Api_Package, items: []Api_Item) {
	for &item in items {
		if !item_shown(a, &item) {
			continue
		}
		switch item.kind {
		case .Decl:
			fmt.sbprintfln(b, "\n## %s\n\n```loke", item.name)
			for attribute in item.attributes {
				fmt.sbprintfln(b, "@(%s)", attribute)
			}
			fmt.sbprintfln(b, "%s\n```", item.text)
			if item.private {
				fmt.sbprintfln(b, "\n%s", PRIVATE_NOTE)
			}
			if item.doc != "" {
				fmt.sbprintfln(b, "\n%s", item.doc)
			}
		case .Impl:
			document_items(b, a, item.members[:])
		case .Delegate, .Import:
		case .When:
			for &branch in item.branches {
				if branch.taken {
					document_items(b, a, branch.items[:])
				}
			}
		}
	}
}

@(private = "file")
PRIVATE_NOTE :: "Private to the package, but a public declaration names it."

// The items one to a paragraph, each after its doc comment. A file-scope
// `when`'s branches keep their contents at column zero, as `core/` writes them.
@(private = "file")
write_interface_items :: proc(b: ^strings.Builder, a: ^Api_Package, items: []Api_Item, indent := "") {
	first := true
	for &item in items {
		if !item_shown(a, &item) {
			continue
		}
		if !first || indent == "" {
			strings.write_byte(b, '\n')
		}
		first = false
		switch item.kind {
		case .Decl:
			if item.private {
				fmt.sbprintfln(b, "%s// %s", indent, PRIVATE_NOTE)
			}
			write_doc_lines(b, item.doc, indent)
			for attribute in item.attributes {
				fmt.sbprintfln(b, "%s@(%s)", indent, attribute)
			}
			fmt.sbprintfln(b, "%s%s%s", indent, item.text, item.terminator)
		case .Delegate, .Import:
			fmt.sbprintfln(b, "%s%s;", indent, item.text)
		case .Impl:
			fmt.sbprintfln(b, "%s {{", item.text)
			write_interface_items(b, a, item.members[:], "\t")
			strings.write_string(b, "}\n")
		case .When:
			for &branch, index in item.branches[:shown_branches(a, &item)] {
				if index > 0 {
					strings.write_string(b, "} ")
				}
				fmt.sbprintfln(b, "%s {{", branch.head)
				write_interface_items(b, a, branch.items[:])
				strings.write_byte(b, '\n')
			}
			strings.write_string(b, "}\n")
		}
	}
}

// `doc` as a `///` line, or as a `/** */` block when it has more than one line,
// as the bundled packages write it. Text that would open or close a block
// comment stays in `///` lines.
@(private = "file")
write_doc_lines :: proc(b: ^strings.Builder, doc: string, indent := "") {
	if doc == "" {
		return
	}
	lines := strings.split_lines(doc, context.temp_allocator)
	if len(lines) == 1 || strings.contains(doc, "/*") || strings.contains(doc, "*/") {
		for line in lines {
			fmt.sbprintln(b, strings.trim_right_space(fmt.tprintf("%s/// %s", indent, line)))
		}
		return
	}
	fmt.sbprintfln(b, "%s/**", indent)
	for line in lines {
		fmt.sbprintln(b, strings.trim_right_space(fmt.tprintf("%s\t%s", indent, line)))
	}
	fmt.sbprintfln(b, "%s*/", indent)
}
