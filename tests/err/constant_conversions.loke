package main;

// Constants that do not survive the type they are written for, a literal the
// lexer accepts and the checker cannot value, an operator with no meaning for
// its operand, and the two built-ins that need more than an argument list.

message :: proc() -> string_view { return "not a constant"; }

main :: proc() {
	fraction: int = 1.5;
	overflowing := 1e400;
	negated := !5;
	container := try_make();
	assert(1 == 1, message());
	_ = fraction; _ = overflowing; _ = negated; _ = container;
}
