package main; import "core:fmt";

// consolidation-provenance-plan.md step 1: the measured false rejections —
// valid programs the checker refuses. Unlike an ordinary rejection fixture, the
// expectations here are the thing being removed, and when the last one goes so
// does this file.
//
// Step 5 removed the first: a fresh allocation base put in a record field now
// reaches checked `free`, and that case is a positive in
// tests/run/m5b_aggregate_baseline.loke. What is left needs a call contract,
// which is step 7.

// The callback's result borrows `input` and never `scratch`, but an indirect
// call has no result contract, so every borrowed argument is assumed to be a
// possible source of the result. Step 2 chose the contract that fixes this: the
// callback parameter's type becomes
//
//     proc(input: []int, @(escape=none) scratch: []int) -> []int
//
// and step 7 enforces `@(escape=none)` in `pick`'s body and at the assignment.
pick :: proc(input: []int, scratch: []int) -> []int {
	fmt.println(scratch[0]);
	return input;
}

run_pick :: proc(chooser: proc(input: []int, scratch: []int) -> []int, input: []int) -> []int {
	scratch := [2]int{7, 8};
	return chooser(input, scratch[:]);
}

main :: proc() {
	numbers := [4]int{1, 2, 3, 4};
	fmt.println(run_pick(pick, numbers[:])[0]);
}
