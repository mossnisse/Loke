package main; import "core:fmt";

TABLE :: [3]int{1, 2, 3};

make_array :: proc() -> [3]int { return [3]int{4, 5, 6}; }

main :: proc() {
	data := [3]int{1, 2, 3};
	readable: []int = data[:];
	mutable: []mut int = data[:];

	// design.md: elements of a `[]T` are read-only.
	readable[0] = 9;

	// A read-only slice never converts to a mutable one, either way it is written.
	back: []mut int = readable;
	converted := ([]mut int)(readable);

	// Slices compare against nil and nothing else.
	other: []int = data[:];
	if (readable == other) {
		fmt.println(1);
	}

	// By-reference iteration needs `[]mut T`.
	foreach (&value in readable) {
		value += 1;
	}

	// A value with no storage cannot be sliced, and a bound is an integer.
	tail := make_array()[1:];
	flag := true;
	bad := data[flag:];

	// Materialised storage is read-only, so no mutable pointer reaches into it.
	index := runtime_index();
	slot := &mut TABLE[index];
	whole := &mut TABLE;
	view := TABLE[:];
	view[0] = 4;

	// A slice literal is written with its type, never inferred from the
	// destination.
	inferred: []int = {1, 2};

	fmt.println(len(mutable));
	fmt.println(len(converted));
	fmt.println(len(back));
}

runtime_index :: proc() -> int {
	return 1;
}
