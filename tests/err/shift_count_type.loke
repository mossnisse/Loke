package main; import "core:fmt";

// design.md: a shift count has an integer type, read as unsigned, or is an
// untyped constant a typed unsigned integer could represent. The compound form
// is held to the same rule as the binary one.
main :: proc() {
	value := 1;
	count := 2.0;
	fmt.println(value << count);
	value <<= true;
	fmt.println(value >> -1);
}
