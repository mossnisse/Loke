package main; import "core:fmt";

// m5b-plan step 2: temporaries and procedure boundaries. design.md: "A borrow
// derived from a local root cannot be returned."

Point :: struct { x: int, y: int }

returns_a_local_array :: proc() -> []int {
	local := [3]int{1, 2, 3};
	return local[:];
}

returns_a_slice_literal :: proc() -> []int {
	return [3]int{1, 2, 3}[:];
}

// design.md: "The default parameter binding itself is a callee-local read-only
// value. Taking `&parameter` borrows that local and cannot produce a returned
// pointer."
returns_a_parameter_binding :: proc(value: int) -> ^int {
	return &value;
}

// design.md: "A value temporary lives until the end of its complete expression.
// A borrow derived from it ... cannot escape it."
returns_a_temporary :: proc() -> ^Point {
	return &Point{1, 2};
}

first_half :: proc(values: []int) -> []int {
	return values[:values.len() / 2];
}

// The result summary substitutes the actual argument, so the caller's local is
// what ends here.
returns_a_substituted_local :: proc() -> []int {
	numbers := [4]int{1, 2, 3, 4};
	return first_half(numbers[:]);
}

// design.md "Procedure result contracts": a plain written signature erases
// fresh-allocation provenance, so its result cannot reach checked `free`.
indirect_allocation :: proc(make_one: proc() -> ^mut int) {
	pointer := make_one();
	free(pointer);
}

// A borrowed argument in a temporary cannot outlive the complete expression the
// temporary belongs to.
temporary_argument :: proc() -> []int {
	return first_half([4]int{1, 2, 3, 4}[:]);
}

// design.md "Parameter semantics and ABI lowering": `value: T` is a value for
// every `T`, so nothing borrowed from it outlives the call — its inline storage
// or, for a managed owner, the allocations it shares with the caller. `borrow T`
// or a receiver is what says otherwise.
Inline_Pair :: struct { items: [2]int }

returns_a_trivial_parameter_view :: proc(pair: Inline_Pair) -> []int {
	return pair.items[:];
}

returns_a_borrowed_parameter_view :: proc(pair: borrow Inline_Pair) -> []int {
	return pair.items[:];
}

// A managed field does not change the answer: the same field address, which
// once compiled and pointed into the callee's copy.
Labelled :: struct { n: int, label: string }

returns_a_managed_parameter_field :: proc(value: Labelled) -> ^int {
	return &value.n;
}

returns_a_managed_array_view :: proc(values: [2]string) -> []string {
	return values[:];
}

// Nor does storage the owner keeps in its allocation.
Bag :: struct { items: [dynamic]int }

returns_a_managed_parameter_allocation :: proc(bag: Bag) -> []int {
	return bag.items[:];
}

returns_a_string_parameter_view :: proc(text: string) -> string_view {
	return text;
}

returns_a_borrowed_allocation :: proc(bag: borrow Bag) -> []int {
	return bag.items[:];
}

// An implicit `string` to `string_view` conversion borrows its source too.
returns_a_local_string_view :: proc() -> string_view {
	text := string("a") + string("b");
	return text;
}

main :: proc() {
	fmt.println(1);
}
