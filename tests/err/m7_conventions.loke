package main;

// design.md "Calling conventions" / "Foreign-ABI-safe types":
// only `c` and `stdcall` are accepted conventions, and every by-value parameter
// and result of a foreign signature must be ABI-safe. An unsafe type names the
// member path that made it so.

Inner :: struct { s: string }
Nested :: struct { a: i32, inner: Inner }

bad_conv    :: proc "fastcall" () { }
str_param   :: proc "c" (s: string) { }
nested_bad  :: proc "c" (n: Nested) { }
array_param :: proc "c" (a: [4]i32) { }
wide_int    :: proc "c" (x: i128) -> i128 { return x; }

main :: proc() { }

// A record reached again through a procedure pointer is a legal cycle, not an
// infinite-size one: it must not switch off the record's own lifecycle check,
// nor let the pointer's signature be answered before the record has fields.
Ctx :: struct { cb: proc "c" (c: Ctx), n: i32 }
impl Ctx {
	release :: hook(drop) proc(self: inout Ctx) { self.n = 0; }
}
take_ctx :: proc "c" (c: Ctx) { }
Late :: struct { cb: proc "c" (l: Late), s: string }

// A `borrow` parameter crosses as a pointer wherever the signature is written,
// so a procedure pointer holding one is as safe inside a record as on its own.
Holder     :: struct { f: proc "c" (a: borrow [4]i32) }
use_holder :: proc "c" (h: Holder) { }

// A Loke variadic is a slice; a C variadic is written `@(c_vararg)`.
sum :: proc "c" (xs: ..i32) -> i32 { return 0; }
