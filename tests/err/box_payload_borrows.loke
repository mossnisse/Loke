package main;

// design.md "Values that contain borrows" and "Owned values": a box carries
// the borrows its payload carries, so allocation does not extend a borrow.
pointer :: proc() -> box(^int) {
	value := 42;
	return box(&value);
}

slice :: proc() -> box([]int) {
	values := [1]int{42};
	view: []int = values[:];
	return box(view);
}

View :: struct { values: []int }
record :: proc() -> box(View) {
	values := [1]int{42};
	return box(View{values[:]});
}

fallible :: proc() -> Result(box(^int), Allocator_Error) {
	value := 42;
	return try_box(&value);
}

box_parameter :: proc(value: ^int) -> box(^int) { return box(value); }
through_helper :: proc() -> box(^int) {
	value := 42;
	return box_parameter(&value);
}

stale :: proc() {
	p: Option(box(^int)) = .none;
	{
		value := 42;
		p = .some(box(&value));
	}
	switch (p) { case .some(held): assert(held^^ == 42); case .none: }
}

nested :: proc() -> box(box(^int)) {
	value := 42;
	inner := box(&value);
	return box(move(inner));
}

main :: proc() {}

// A write into a box's payload carries its borrow too.
written :: proc(other: ^int) -> box(^int) {
	value := 42;
	p := box(other);
	p^ = &value;
	return move(p);
}

no_escape :: proc(@(escape=none) value: ^int) -> box(^int) {
	return box(value);
}
