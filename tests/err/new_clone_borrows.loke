package main;

// design.md "Values that contain borrows": allocation does not extend a borrow.
pointer :: proc() -> ^mut ^int {
	value := 42;
	return new_clone(&value);
}

slice :: proc() -> ^mut []int {
	values := [1]int{42};
	view: []int = values[:];
	return new_clone(view);
}

View :: struct { values: []int }
record :: proc() -> ^mut View {
	values := [1]int{42};
	return new_clone(View{values[:]});
}

fallible :: proc() -> Result(^mut ^int, Allocator_Error) {
	value := 42;
	return try_new_clone(&value);
}

clone_parameter :: proc(value: ^int) -> ^mut ^int { return new_clone(value); }
through_helper :: proc() -> ^mut ^int {
	value := 42;
	return clone_parameter(&value);
}

stale :: proc() {
	p: ^mut ^int = nil;
	{
		value := 42;
		p = new_clone(&value);
	}
	assert(p^^ == 42);
}

nested :: proc() -> ^mut ^mut ^int {
	value := 42;
	inner := new_clone(&value);
	return new_clone(inner);
}

main :: proc() {}

// Later writes into zero-initialized allocations carry borrows too.
initialized :: proc() -> ^mut ^int {
	value := 42;
	p := new(^int);
	p^ = &value;
	return p;
}

no_escape :: proc(@(escape=none) value: ^int) -> ^mut ^int {
	return new_clone(value);
}
