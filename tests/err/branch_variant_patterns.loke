package main; import "core:fmt";

Maybe :: union { none:, some: int }

main :: proc() {
	switch (Maybe.none) {
	case .none(value): fmt.println(value);
	case .some(number): fmt.println(number);
	}
	fmt.println(value);
}

Colour :: enum { Red, Blue }

// A pattern binding follows the shadowing rule: naming an existing local is an
// error, not a silent new binding.
shadowed :: proc(opt: Option(int)) {
	number := 5;
	switch (opt) {
	case .some(number): fmt.println(number);
	case .none:
	}
}

// Only a union subject reads `.name(x)` as a pattern.
not_a_union :: proc(c: Colour) {
	switch (c) {
	case .Red(x):
	case:
	}
}

// A case that named no variant has reported that, so its binding is untyped and
// its body reports nothing of it.
Number :: union { a: int, b: string }

rejected_case_bindings :: proc(n: Number) -> int {
	switch (n) {
	case .a(x): return x;
	case .a(y): return y + 1;
	case .nope(z): return z + 1;
	case .b: return 0;
	}
}
