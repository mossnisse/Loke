package main;

import "core:fmt";

// design.md "any_view type": an `any_view` holding an erased slice borrows the
// slice variable it views, so the variable may not be reassigned while the
// view is live, whether the view is declared or assigned.

declared :: proc(a: []mut int, ys: []mut int) -> int {
	xs := a;
	v: any_view = xs;
	xs = ys;
	return v.([]mut int)[0];
}

assigned :: proc(a: []mut int, ys: []mut int) -> int {
	xs := a;
	v: any_view = 0;
	v = xs;
	xs = ys;
	return v.([]mut int)[0];
}

// `any_view(xs)` is the same conversion written out.
explicit :: proc(a: []mut int, ys: []mut int) -> int {
	xs := a;
	v: any_view = 0;
	v = any_view(xs);
	xs = ys;
	return v.([]mut int)[0];
}

// A view of a field borrows the field, read-only, as one of a local does.
Holder :: struct { items: []mut int }

field_reassigned :: proc(xs: []mut int, ys: []mut int) {
	held := Holder{xs};
	v: any_view = any_view(held.items);
	held.items = ys;
	_ = v.([]mut int)[0];
}
field_written :: proc(held: Holder) {
	v: any_view = held.items;
	held.items[0] = 5;
	_ = v.([]mut int)[0];
}
field_extracted_twice :: proc(held: Holder) {
	v1: any_view = held.items;
	v2: any_view = held.items;
	a := v1.([]mut int);
	b := v2.([]mut int);
	a[0] = b[0];
}

// Two read-only views of one field may be live together.
field_viewed_twice :: proc(held: Holder) {
	v1: any_view = held.items;
	v2: any_view = held.items;
	fmt.println(v1, v2);
}

main :: proc() {}
