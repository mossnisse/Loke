package main; import "core:fmt"; import "core:unsafe";

// The one provider-activation fixture (m5b-plan step 5). design.md's two
// rejected returns under "How root and region provenance compose" are written
// against `mem.Arena` and `[dynamic]u8`, neither of which is nameable until M6:
//
//   bad_view :: proc() -> []u8 {
//   	arena := mem.Arena();
//   	bytes: [dynamic]u8 via arena.allocator() = {};
//   	return bytes[:]; // ERROR: borrow outlives the local root `bytes`
//   }
//
//   bad_owner :: proc() -> [dynamic]u8 {
//   	arena := mem.Arena();
//   	bytes: [dynamic]u8 via arena.allocator() = {};
//   	return move(bytes); // ERROR: owner outlives allocator region `arena`
//   }
//
// Both analyses are in place; what is missing is a provider that creates a
// local region. The M5 equivalents below already fail for the two distinct
// reasons the examples are there to distinguish, so activating the exact source
// in M6 is a matter of replacing the storage, not of reopening the analysis.
// This fixture also pins how far M6b has got: `[dynamic]u8` is a complete type
// with a complete lifecycle, complete operations, iteration, formatting, and the
// unsafe conversion out of it. What is left is `mem.Arena` itself.

// The root failure: a borrow of local storage cannot be returned.
bad_view :: proc() -> []int {
	bytes := [4]int{1, 2, 3, 4};
	return bytes[:];
}

// The region failure, a different code and a different explanation: an owner
// backed by a received region cannot be kept past that region.
Buffer :: struct { id: int }

impl Buffer {
	drop :: proc(self: inout Buffer) { self.id = 0; }
}

make_buffer :: proc(allocator: Allocator) -> Buffer {
	return Buffer{1};
}

held: Buffer;

bad_owner :: proc(allocator: Allocator) {
	held = make_buffer(allocator);
}

// The M6 storage itself, complete: operations, iteration, and the unsafe
// conversion out of it all run. Only the local region provider is still absent.
usable :: proc() {
	bytes: [dynamic]u8;
	bytes.append(1, 2);
	fmt.println(len(bytes));
	foreach (b in bytes) {
		fmt.println(b);
	}
	raw := unsafe.raw_data(bytes);
	fmt.println(raw[0]);
	fmt.println(bytes);
}

main :: proc() {
	fmt.println(1);
}
