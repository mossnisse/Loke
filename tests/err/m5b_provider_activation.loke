package main; import "core:fmt"; import "core:unsafe";

// The provider-activation fixture (m5b-plan step 5). It pinned the two analyses
// design.md distinguishes under "How root and region provenance compose" while
// `mem.Arena` was still unwritable, using substitute storage that fails for the
// same two reasons.
//
// M6b step 5 supplied the provider, and `tests/err/m6b_regions` now runs
// design.md's exact source. What stays here is the pair of *substitutes*: a
// borrow of a plain local array, and an owner backed by a region this body
// received rather than created. They are different roots and a different region
// kind from the M6b ones, so keeping both keeps both paths covered.

// The root failure: a borrow of local storage cannot be returned.
bad_view :: proc() -> []int {
	bytes := [4]int{1, 2, 3, 4};
	return bytes[:];
}

// The region failure, a different code and a different explanation: an owner
// backed by a received region cannot be kept past that region.
Buffer :: struct { id: int }

impl Buffer {
	release :: hook(drop) proc(self: inout Buffer) { self.id = 0; }
}

make_buffer :: proc(allocator: Allocator) -> Buffer {
	return Buffer{1};
}

held: Buffer;

bad_owner :: proc(allocator: Allocator) {
	held = make_buffer(allocator);
}

// The M6 storage itself, complete: operations, iteration, and the unsafe
// conversion out of it all run. Only the local region provider is still absent.
usable :: proc() {
	bytes: [dynamic]u8;
	bytes.append(1, 2);
	fmt.println(len(bytes));
	foreach (b in bytes) {
		fmt.println(b);
	}
	raw := unsafe.raw_data(bytes);
	fmt.println(raw[0]);
	fmt.println(bytes);
}

main :: proc() {
	fmt.println(1);
}
