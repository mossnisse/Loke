package main;

// design.md "Comparison operators": a slice and a dynamic interface value are
// not comparable, with each other or with anything else; neither has a `nil`
// to compare against either (design.md "Zero values"). The rule is about the
// type, not about the position it is written in, so burying one in a struct
// field must not make the whole record comparable — a field-wise comparison
// there would compare addresses.

Sized :: interface($Self: type) {
	slot size: proc(self) -> int;
}

Counter :: struct { value: int }
impl Counter {
	size :: proc(self) -> int { return self.value; }
}

Boxed :: struct { items: []int };
Erased :: struct { view: dyn Sized };

main :: proc() {
	a := [2]int{1, 2};
	b := [2]int{1, 2};
	p: []mut int = &mut a[:];
	q: []mut int = &mut b[:];
	c := Counter{1};
	v := (dyn Sized)(&c);
	w := (dyn Sized)(&c);

	if (p == q) { }
	if (v == w) { }
	if (v == nil) { }

	// And rejected one level down, where no top-level shape test can see it.
	if (Boxed{items = p} == Boxed{items = q}) { }
	if (Erased{view = v} == Erased{view = w}) { }
}
