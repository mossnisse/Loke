// design.md "Global write effects" and core:thread: a spawned entry that writes
// a global every thread shares is warned about, through a callee and for a
// `static` local too, while `thread_local`, atomic operations, a `Mutex`, and a
// `@(synchronized)` variable are not; so is an entry passed to a user wrapper's
// `@(cross_thread)` parameter, at the wrapper's call, while an entry the
// wrapper names itself still is in its body; a named procedure a trampoline
// entry calls through its argument is warned about where it is passed, and
// the trampoline is not; a spawned argument may not borrow shorter-lived
// storage; and a pointer from a guard may not outlive the lock.
package main;

import "core:sync";
import "core:thread";

count: int;
hits: sync.Atomic(int);
total: thread.Mutex(int);
mine: thread_local int;

bump :: proc() { count += 1; }
indirect :: proc() { bump(); }

fine :: proc() {
	hits.add(1);
	mine += 1;
	guard := total.lock();
	guard.get() += 1;
}

with_static :: proc(n: move int) {
	calls: static int = 0;
	calls += n;
}

raw :: proc() { hits.value = 1; }

sum :: proc(values: move []int) {}

@(synchronized) vouched: int;
vouch :: proc() { vouched += 1; }

start :: proc(@(cross_thread) entry: proc()) {
	worker := thread.spawn(entry);
	own := thread.spawn(indirect);
}

trampoline :: proc(job: move proc()) { job(); }

main :: proc() {
	a := thread.spawn(indirect);
	b := thread.spawn(fine);
	c := thread.spawn(with_static, 3);
	d := thread.spawn(raw);

	local := [3]int{1, 2, 3};
	e := thread.spawn(sum, local[:]);
	f := thread.spawn(vouch);
	start(bump);
	g := thread.spawn(trampoline, bump);
}

escapes :: proc() {
	p: ^mut int;
	{
		guard := total.lock();
		p = &mut guard.get();
	}
	p^ = 1;
}
