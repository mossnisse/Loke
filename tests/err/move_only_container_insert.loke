package main;

Res :: move_only struct { id: int }

main :: proc() {
	m: map[string]Res = {};
	r := Res{ id = 1 };
	m.find_or_insert("a", r);
	_ = m.try_insert("a", r);
	d: [dynamic]Res = {};
	d.insert(0, r);
	d.append(r);
	d.append(..d[:]);
	_ = m.lookup_value("a");
	// A type-qualified call, and the operation taken as a value, follow the
	// same rules.
	_ = (map[string]Res).lookup_value(m, "a");
	_ = (map[string]Res).try_insert(inout m, "a", r);
	(map[string]Res).find_or_insert(inout m, "a", r);
	look := (map[string]Res).lookup_value;
}
