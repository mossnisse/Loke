/// design.md "Doc comments": a doc comment documents the item directly below
/// it, or below the comments between them; anywhere else it is a warning.
package main;

/// Above an import: an import is not documented.
import "core:fmt";

/// Documented, through the attribute and a maintainer note.
// A maintainer note.
@(require_results)
twice :: proc(value: int) -> int { return value * 2; }

/// Documented.
Shape :: union {
	/// A variant.
	Circle: f64,
	Square: f64,
}

/// Documented.
Colour :: enum {
	/// A member.
	Red,
	Green,
}

/// Documented.
Sized :: interface($Self: type) {
	/// A requirement.
	slot size: proc(self: Self) -> int;
}

/// Documented.
Pair :: struct {
	/// A field of an anonymous record field.
	inner: (
		/// Its own field.
		left: int,
		right: int,
	),
}

when (LOKE_OS == .Windows) {
	/// Documented, in a taken branch.
	WINDOWS :: true;
} else {
	/// Documented, in a branch that is not taken.
	ELSEWHERE :: true;
}

/// Above an impl block: the block itself is not documented.
impl Pair {
	/// Documented: an impl member.
	left_of :: proc(self) -> int { return self.inner.left; }
}

/**
	Documented, by a block doc comment.
*/
// A maintainer note.
BLOCK :: 1;

/*** Three stars: an ordinary comment, never reported. */
/**/
ORDINARY :: 2;

/** A block above a blank line. */

/// Above a blank line.

//// Four slashes: an ordinary comment, never reported.
main :: proc() {
	/// Inside a body.
	/** Inside a body, as a block. */
	x := twice(2); /// Sharing its line with code.
	fmt.println(x, undeclared);
}

/// Documented, with a field under an array.
Grid :: [4](
	/// A field.
	x: int,
);

/// Documented, with a field under a pointer.
Ptr :: ^(
	/// A field.
	y: int,
);

/// Documented, with a field under a slice.
Many :: [](
	/// A field.
	s: int,
);

/// Documented, with a field in a map's value.
Table :: map[int](
	/// A field.
	v: int,
);

/// Documented, with fields in a parameter's type and in the result.
take :: proc(p: (
	/// A field.
	z: int,
)) -> (
	/// A field.
	r: int,
) { return {r = p.z}; }

/// Documented, with a field under a field's array.
Holder :: struct {
	inner: [2](
		/// A field.
		q: int,
	),
}
/// Documented, with a field in an array's length.
Measured :: [size_of((
	/// A field.
	w: int,
))]u8;

/// Documented, with a field in a composite literal's element.
SIZES :: [1]int{size_of((
	/// A field.
	e: int,
))};

when (size_of((
	/// A field, in a `when` condition.
	c: int,
)) == 8) {
	/// Documented.
	WIDE :: true;
}

/// At the end of the file.
