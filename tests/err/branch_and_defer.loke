package main; import "core:fmt";

stray :: proc() {
	break;
	continue;
}

escaping :: proc() -> int {
	defer return 1;
	for (i := 0; i < 2; i += 1) {
		defer break;
	}
	defer {
		defer fmt.println(1);
	}
	return 0;
}

main :: proc() {
	stray();
	fmt.println(escaping());
}

switch_break :: proc(n: int) {
	switch (n) {
	case 0: break;
	case:
	}
}

// Reported where written, even where nothing reaches it; a loop inside the
// deferred code is a target its `break` may leave.
unreachable_exit :: proc() {
	for (i := 0; i < 2; i += 1) {
		defer {
			for (;;) { break; }
			panic("stop");
			continue;
		}
	}
}
