package main; import "core:fmt";

Canvas :: struct { marks: int }

Drawable :: interface($Self: type) {
	slot draw: proc(self, canvas: inout Canvas);
}

// Not dyn-compatible: a free expression requirement, a consuming receiver, and
// a slot that returns the subject.
Static_Only :: interface($Self: type) {
	(a, b: Self) a == b -> bool;
}

Consuming :: interface($Self: type) {
	slot take: proc(self: move Self) -> int;
}

Returning :: interface($Self: type) {
	slot twin: proc(self) -> Self;
}

Circle :: struct { radius: int }
Opaque :: struct { value: int }

impl Circle {
	draw :: proc(self, canvas: inout Canvas) { canvas.marks += self.radius; }
}

main :: proc() {
	c := Circle{1};
	// A concrete type that supplies no slot.
	o: Opaque = {1};
	bad := (dyn Drawable)(&o);
	// Not a pointer.
	worse := (dyn Drawable)(c);

	// Interfaces that cannot be erased.
	s: dyn Static_Only;
	m: dyn Consuming;
	r: dyn Returning;

	// A dynamic interface has no type switch.
	view := (dyn Drawable)(&c);
	// An interface has no slot by that name.
	view.paint(inout canvas);
	switch (view) {
	case Circle:
		fmt.println(1);
	}
}
