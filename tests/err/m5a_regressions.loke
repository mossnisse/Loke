package main; import "core:fmt";

Res :: struct { id: int }

impl Res {
	release :: hook(drop) proc(self: inout Res) { self.id = 0; }
	consume :: proc(self: move Res) -> int { return self.id; }
}

Box :: struct { item: Res }

stale_allocation_root :: proc() {
	p := try_new(int) or_else nil;
	free(p);
	x := 42;
	p = &mut x;
	free(p);
}

invalid_receivers :: proc() {
	static_value: static = Res{1};
	move(static_value).consume();
	box := Box{Res{2}};
	move(box.item).consume();
}

dead_deferred_use :: proc() {
	value := Res{3};
	defer fmt.println(value.id);
	drop(value);
}

continue_must_run_post :: proc() {
	x := Res{4};
	i := 0;
	for (; i < 2; drop(x)) {
		fmt.println(x.id);
		i += 1;
		continue;
	}
}
