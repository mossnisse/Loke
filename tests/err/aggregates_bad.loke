package main; import "core:fmt";

Point :: struct { x: int, y: int }
Colour :: enum { Red, Green }

SIZE :: 4;

main :: proc() {
	p := Point{1, 2};
	fmt.println(p.z);
	fmt.println(Point{1, 2, 3}.x);
	fmt.println(Point{x = 1, x = 2}.x);
	fmt.println(Point{y = 1, 2}.x);

	xs := [SIZE]int{1, 2, 3, 4};
	fmt.println(xs[4]);
	fmt.println(xs[-1]);

	c := .Green;
	fmt.println(int(c));

	n := 1;
	fmt.println(n.x);
}
