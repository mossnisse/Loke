package main; import "core:fmt";

// Storing a borrow where it outlives
// the statement that stored it. design.md listed all of this as unchecked; it is
// checked now, and what makes a case valid is the parameter's own written
// `@(escape=...)` level, since only the caller knows how long its storage lives.
//
// These came out of tests/run/m5b_aggregate_baseline.loke and
// tests/run/m5b_trust_boundary.loke, where they were labelled as gaps.

Holder :: struct { view: []int }

global_view: []int;
global_pointer: ^int;
global_holder: Holder;
tls_view: thread_local []int;

TABLE :: [4]int{1, 2, 3, 4};

// A local does not outlive the process.
local_to_global :: proc() {
	local := [3]int{1, 2, 3};
	global_view = local[:];
}

// Nor does it reach a global through a field.
local_to_global_field :: proc() {
	local := [3]int{1, 2, 3};
	global_holder.view = local[:];
}

// An unconstrained parameter proves nothing about its caller's storage.
store_in_a_global :: proc(values: []int, target: ^int) {
	global_view = values;
	global_pointer = target;
}

retain_an_argument :: proc(values: []int) {
	global_holder = Holder{values};
}

// Thread storage outlives its own thread and nothing else, so it does not
// satisfy a process-duration destination.
tls_to_process :: proc() {
	global_view = tls_view;
}

// Nor does a local reach thread storage.
local_to_thread_local :: proc(values: []int) {
	held: thread_local Holder = {};
	held.view = values;
	fmt.println(held.view.len());
}

// Callee-local storage retained in a destination the caller owns. No contract
// the caller could be given makes this one valid.
retain_local_into_inout :: proc(destination: inout Holder) {
	local := [3]int{1, 2, 3};
	destination.view = local[:];
}

// And an unconstrained parameter retained the same way.
retain_argument_into_inout :: proc(destination: inout Holder, values: []int) {
	destination.view = values;
}

// The caller's half of the same contract. A call to a `stored` parameter is the
// assignment the callee is permitted to make, so the caller answers the same
// question about the argument it supplies.
keep :: proc(destination: inout Holder, @(escape=stored) values: []int) {
	destination.view = values;
}

// A destination with process duration needs an argument that has it too.
caller_passes_a_local_to_a_global :: proc() {
	numbers := [3]int{1, 2, 3};
	keep(inout global_holder, numbers[:]);
}

// An unconstrained parameter proves nothing about the caller's storage, so the
// contract has to be carried on rather than stopping here.
caller_forwards_without_the_contract :: proc(destination: inout Holder, values: []int) {
	keep(inout destination, values);
}

// A caller-local destination needs no contract — but what it was handed still
// has to be there when it is read.
caller_outlives_the_source :: proc() -> int {
	held: Holder = {};
	{
		numbers := [3]int{1, 2, 3};
		keep(inout held, numbers[:]);
	}
	return held.view[0];
}

// Through a procedure value: the level is part of the type, so the obligation
// survives a call with no body to look at.
caller_through_a_value :: proc() -> int {
	action: proc(destination: inout Holder, @(escape=stored) values: []int) = keep;
	held: Holder = {};
	{
		numbers := [3]int{1, 2, 3};
		action(inout held, numbers[:]);
	}
	return held.view[0];
}

// A destination written through a pointer or a slice element names its root only
// once that carrier's own loans are solved, but it is the same obligation: what
// the callee may leave in the caller's storage.
through_a_pointer :: proc(destination: ^mut Holder, values: []int) {
	destination^.view = values;
}

through_an_auto_deref :: proc(destination: ^mut Holder, values: []int) {
	destination.view = values;
}

through_a_slice_element :: proc(destination: []mut Holder, values: []int) {
	destination[0].view = values;
}

// And at the caller, where the destination argument is a pointer to process
// storage rather than a place written out.
keep_through_a_pointer :: proc(destination: ^mut Holder, @(escape=stored) values: []int) {
	destination^.view = values;
}

caller_points_at_a_global :: proc() {
	numbers := [3]int{1, 2, 3};
	keep_through_a_pointer(&mut global_holder, numbers[:]);
}

// A pointer says which storage it names only once its own borrows are solved,
// so what is written through it lands where it points rather than in the
// pointer. Both the write and the call are the same question.
write_through_a_pointer_variable :: proc() -> int {
	held: Holder = {};
	p := &mut held;
	{
		numbers := [3]int{1, 2, 3};
		p^.view = numbers[:];
	}
	return held.view[0];
}

call_through_a_pointer_variable :: proc() -> int {
	held: Holder = {};
	{
		numbers := [3]int{1, 2, 3};
		p := &mut held;
		keep_through_a_pointer(p, numbers[:]);
	}
	return held.view[0];
}

main :: proc() {
	global_view = TABLE[:];
	fmt.println(global_view[0]);
}
