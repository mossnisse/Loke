package main;

// design.md "Static `foreach` expansion": a `break` or `continue` nested under
// `else if` or a `switch` case is reported once, not per copy; a slice constant
// is not a compile-time iterable.

A :: [2]int{1, 2};
S :: []int{1, 2};

main :: proc() {
	foreach ($x in A) {
		if (x == 5) { } else if (x == 1) { break; }
	}
	foreach ($y in A) {
		switch (y) { case 1: continue; case: }
	}
	foreach ($z in S) { }
}
