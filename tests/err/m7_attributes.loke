package main;

// design.md "Attributes": before M7 attributes were parsed and
// mostly ignored, so a typo was silent. Every way of writing one wrongly is now
// its own diagnostic, and the two that carry behaviour report at the use site.

@(nonsense)
a: int = 0;

@(compiler.no_alias)
b: int = 0;

@(public, public)
c: int = 0;

@(packed)
d: int = 0;

@(deprecated)
e :: proc() {}

@(public = "yes")
f: int = 0;

@(deprecated = 456)
bad_message :: proc() {}

@(deprecated = "use `g2` instead")
g :: proc() -> int { return 1; }

@(require_results)
h :: proc() -> int { return 2; }

main :: proc() {
	@(unknown_local) value := 1;
	g();
	h();
	// Binding the result discards it as quietly as the bare call above does, so
	// it answers to the same policy. `_ = h()` stays the written discard.
	uninspected := h();
}

// A delegation keeps its attributes, so they are validated like any other.
Meters :: distinct i64;
impl Meters {
	@(bogus_delegate) delegate(+);
	@(public) delegate(-);
}

// A group's policy reaches a call through an associated or method group too.
Box :: struct {}
impl Box {
	produce :: proc(value: int) -> int { return value; }
	take :: proc(self, value: int) -> int { return value; }
	@(require_results) group :: proc{produce};
	@(require_results) methods :: proc{take};
}
grouped :: proc() {
	Box.group(1);
	Box{}.methods(2);
}
