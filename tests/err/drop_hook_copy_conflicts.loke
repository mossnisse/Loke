// design.md "@(fieldwise_copy)": the attribute keeps the generated copy of a record
// with a drop hook, so it contradicts a record with no generated copy or with its
// own, and means nothing on a record with no hook.
package main;

@(move_only, fieldwise_copy) Both :: struct { fd: int }
impl Both {
	close :: hook(drop) proc(self: inout Both) {}
}

@(fieldwise_copy) Hooked :: struct { fd: int }
impl Hooked {
	close :: hook(drop) proc(self: inout Hooked) {}
	copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Hooked, Allocator_Error) {
		return .ok(Hooked{self.fd});
	}
}

@(fieldwise_copy) Copier :: struct($T: type) { value: T }
impl Copier($T) {
	close :: hook(drop) proc(self: inout) {}
	copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Copier(T), Allocator_Error) {
		return .ok(Copier(T){self.value});
	}
}

@(move_only) Token :: struct { id: int }
@(fieldwise_copy) Holder :: struct { token: Token }
impl Holder {
	close :: hook(drop) proc(self: inout Holder) {}
}

// No hook to keep a copy beside, and a hook added later must still ask.
@(fieldwise_copy) Plain :: struct { fd: int }
@(fieldwise_copy) Template :: struct($T: type) { value: T }

// A hook another diagnostic rejects still counts as written.
@(fieldwise_copy) Broken :: struct { fd: int }
impl Broken {
	close :: hook(drop) proc(self) {}
}

// Structs alone.
@(fieldwise_copy) Either :: union { a: int, b: bool }
@(fieldwise_copy) Declared :: int;

// It takes no value.
@(fieldwise_copy=true) Valued :: struct { fd: int }
impl Valued {
	close :: hook(drop) proc(self: inout Valued) {}
}

main :: proc() {
	@(fieldwise_copy) Local :: struct { fd: int }
}
