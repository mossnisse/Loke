package main; import "core:fmt";

// Ownership diagnostics (m5a-plan step 4). design.md "Managed values and
// storage": "A use that requires a value is valid only in the definitely-live
// state."

Res :: struct { id: int }

impl Res {
	release :: hook(drop) proc(self: inout Res) { self.id = 0; }
}

Pair :: struct { first: Res, second: Res }

global: Res;

Only :: move_only struct { id: int }

impl Only {
	release :: hook(drop) proc(self: inout Only) { self.id = 0; }
}

take :: proc(value: move Res) -> int {
	return value.id;
}

// A borrowed managed owner is returned by cloning, and this one has no clone.
give_back :: proc(value: Only) -> Only {
	return value;
}

borrow :: proc(value: Res) -> int {
	// A value parameter is an immutable borrow, not an owner this body may
	// consume.
	drop(value);
	return value.id;
}

main :: proc() {
	a := Res{1};
	b := move(a);
	// `a` is dead until a full assignment revives it.
	fmt.println(a.id);

	c := Res{2};
	drop(c);
	drop(c);

	// A full assignment revives a dead binding.
	c = Res{3};
	fmt.println(c.id);

	// `drop` operates on a storage location, not a field or an element.
	p := Pair{Res{4}, Res{5}};
	drop(p.first);

	// Static-duration storage is always live.
	drop(global);

	fmt.println(borrow(b));

	// A `move` parameter needs its marker at the call site.
	e := Res{9};
	fmt.println(take(e));

	// A move-only type has no copy entry point for a binding or an assignment.
	f := Only{10};
	g := f;
	g = f;

	// design.md "Borrowing iteration": traversing a place lends each element, so a
	// move-only one is read like any other and this is not a copy at all.
	table := [2]Only{Only{11}, Only{12}};
	foreach (item in table) {
		fmt.println(item.id);
	}
	// design.md "Borrowing iteration": `values()` lends the half it names, so a
	// move-only value is read like any other. `entries()` builds the `{key, value}`
	// record the table does not store, and that copy it cannot make.
	locked: map[int]Only = {};
	foreach (item in locked.values()) {
		fmt.println(item.id);
	}
	foreach (key, value in locked.entries()) {
		fmt.println(key + value.id);
	}

	// `exchange` replaces a definitely live value, and its marker is written at
	// the call site like any other `inout` operation.
	h := Res{13};
	i := exchange(h, Res{14});
	drop(h);
	j := exchange(inout h, Res{15});

	// Static-duration storage is always live, and is initialised before any code
	// runs.
	k: static Res;
	l: thread_local Res;
	drop(k);
	m := move(l);
	n: static int = borrow(Res{16});

	// Conditionally live: one path dropped it, the other did not.
	d := Res{8};
	if (b.id == 0) {
		drop(d);
	}
	fmt.println(d.id);

	// A variadic pack changes how the arguments are packed, not whether the
	// transfer is written.
	o := Res{17};
	fmt.println(take_all(o, 1, 2));
}

take_all :: proc(value: move Res, counts: ..int) -> int {
	return value.id + counts.len();
}
