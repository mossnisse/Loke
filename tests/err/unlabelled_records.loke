// design.md "Anonymous records": an unlabelled field has no name to select or
// to name in a literal, an unlabelled record is unrelated to a labelled one
// with the same field types, and `(a, b)` is a record type, not a value.
package main;

two :: proc() -> (int, bool) { return {1, true}; }
labelled :: proc() -> (n: int, ok: bool) { return {1, true}; }

main :: proc() {
	r := two();
	_ = r.n;
	l: (n: int, ok: bool) = two();
	u: (int, bool) = labelled();
	a, b := 1, 2;
	v := (a, b);
	_ = l; _ = u; _ = v;
}
