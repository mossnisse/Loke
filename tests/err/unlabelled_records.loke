// design.md "Anonymous records", "Implicit type conversions": an unlabelled
// field has no name to select, a labelled record converts implicitly only to
// the unlabelled one with its field types (never back, never to other names,
// and never inside a procedure type), and `(a, b)` is a record type, not a value.
package main;

two :: proc() -> (int, bool) { return {1, true}; }
labelled :: proc() -> (n: int, ok: bool) { return {1, true}; }

main :: proc() {
	r := two();
	_ = r.n;
	l: (n: int, ok: bool) = two();
	m: (m: int, ok: bool) = labelled();
	f: proc() -> (int, bool) = labelled;
	a, b := 1, 2;
	v := (a, b);
	same := labelled() == two();
	_ = l; _ = m; _ = f; _ = v; _ = same;
}
