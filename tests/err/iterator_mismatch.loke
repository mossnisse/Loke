package main;

// A declared `Iterator` must be what `iter` returns (design.md "Iteration
// protocol").

Countdown :: struct { start: int }
Other :: struct {}
Not_A_Type :: struct {}

impl Countdown {
	Element :: int;
	Iterator :: Other;
	iter :: proc(self) -> [1]int { return {self.start}; }
}

impl Not_A_Type {
	Element :: int;
	Iterator :: 7;
	iter :: proc(self) -> [1]int { return {1}; }
}

main :: proc() {
	foreach (v in Countdown{3}) { _ = v; }
	foreach (v in Not_A_Type{}) { _ = v; }
}
