package main;

import "core:slice";
import "core:container";

// The compile-time gates the step-1 library types install.

Not_Ordered :: struct { value: int }

main :: proc() {
	// design.md "Sorting slices": the library procedures accept `[]mut T`, and
	// passing a read-only `[]T` is a compile-time error.
	readable := []int{1, 6, 3};
	slice.sort(readable);
	slice.reverse_sort(readable);
	slice.fill(readable, 0);

	// An element type with no `<` cannot be sorted.
	records := []mut Not_Ordered{Not_Ordered{1}};
	slice.sort(records);

	// A `Small_Array` needs room, and `N > 0` is part of the type.
	empty: container.Small_Array(int, 0) = {};

	// An inherent `==` this package has but does not export. `core:slice`
	// resolves it from over there and cannot reach it -- and unlike a missing
	// `<`, a missing `==` has a field-wise stand-in sitting right there. Taking
	// it would answer `contains` with an equality this file does not use, so the
	// bound refuses instead and says what to export. `Ordered` composes
	// `Equatable`, so `sort` fails on the same requirement.
	badges := []mut Badge{Badge{2, "two"}, Badge{1, "one"}};
	slice.sort(badges);
	_ = slice.contains(badges, Badge{1, "ONE"});
}

// `==` on the rank alone, so field-wise equality is a different answer, not a
// slower spelling of the same one.
Badge :: struct { rank: int, name: string_view }

impl Badge {
	before :: operator(<) proc(a, b: Badge) -> bool { return a.rank < b.rank; }
	same :: operator(==) proc(a, b: Badge) -> bool { return a.rank == b.rank; }
}
