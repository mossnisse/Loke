package main; import "core:mem"; import "core:fmt";

// The `via` applicability rules and the one construct that is still deliberately
// not a runtime type (m6b-plan step 1, decision "`via` applicability").
//
// design.md: `via` selects the provider a destination's value is *built* with,
// so it belongs to a managed owner "whose canonical clone accepts a destination
// allocator". Everything with no destination allocation to select is rejected,
// and every static-duration form is rejected before its expression is even
// checked — a provider call is not a constant initialiser.

// An interface is not deferred: it is deliberately compile-time metadata, so it
// has its own diagnostic rather than a milestone gate.
Trait :: interface($Self: type) { }
stored: Trait;

// File-scope storage is initialised before any code runs.
pooled: int via allocator_of();

allocator_of :: proc() -> Allocator { return mem.default_allocator(); }

main :: proc() {
	// A trivial value owns no allocation, so there is nothing for a policy to
	// select.
	plain: int via allocator_of();
	// design.md "string type": assignment shares immutable backing storage
	// through a retain rather than allocating into the destination.
	text: string via allocator_of();
	// `static` and `thread_local` are rejected for the same reason file scope is.
	kept: static [dynamic]int via allocator_of();
	// A policy names an `Allocator`, not any other value.
	rows: [dynamic]int via 7;
	fmt.println(1);
}
