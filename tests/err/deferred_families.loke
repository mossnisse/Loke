package main;

// One `L0350` per deferred outer construct, and no descent into it. Every
// family M4b leaves for a later milestone keeps exactly one entry here.
Container :: struct { items: []int }

Walker :: struct { cursor: [^]int }

Viewer :: struct { text: string_view }

// An interface is not deferred: it is deliberately compile-time metadata, so it
// has its own diagnostic rather than a milestone gate.
Trait :: interface($Self: type) { }
stored: Trait;

main :: proc() {
	xs: [dynamic]int;
	table: map[int]int;
	text := "hello";
	print_int(1);
}
