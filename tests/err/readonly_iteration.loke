package main;
import "core:fmt";

// design.md "Borrowing iteration": traversing a place lends each element, and
// `&item` on that binding is a read-only pointer that keeps the original
// storage borrowed even after the step it came from.
write_element :: proc(values: []int) {
	foreach (item in values) { at := &item; at^ = 9; }
}

strengthen :: proc(values: []int) {
	foreach (item in values) {
		mutable: ^mut int = &item;
		fmt.println(mutable^);
	}
}

retained_after_drop :: proc() {
	values := [dynamic]int{1, 2};
	walker := values.iter();
	item := walker.next() or_else nil;
	drop(walker);
	drop(values);
	fmt.println(item^);
}

escape_local :: proc() -> ^int {
	values := [2]int{1, 2};
	walker := values.iter();
	return walker.next() or_else nil;
}

make_values :: proc() -> [dynamic]int { return [dynamic]int{1, 2}; }
escape_temporary :: proc() {
	view := make_values()[:];
	foreach (item in view) { fmt.println(item); }
}

mutate_slice :: proc() {
	values := [2]int{1, 2};
	source := values[:];
	frozen := source.reversed();
	source[0] = 9;
	foreach (item in frozen) { fmt.println(item); }
}

main :: proc() {}

conditional_temporary :: proc(flag: bool) -> ^int {
	left := [2]int{1, 2};
	right := [2]int{3, 4};
	walker := (left if flag else right).iter();
	return walker.next() or_else nil;
}

Packed :: struct @(packed) { tag: u8, items: [2]int }
packed_storage :: proc() {
	value: Packed = {};
	foreach (item in value.items) { at := &item; fmt.println(at^); }
}

lend_during_mutation :: proc() {
	values := [dynamic]int{1, 2};
	foreach (item in values) {
		values.append(3);
		fmt.println(item);
	}
}

// `&item` on a lending binding carries the element's own source provenance, so
// it outlives the step and ends when that source is invalidated.
escaped_element :: proc() {
	values := [dynamic]int{1, 2};
	kept: ^int = nil;
	foreach (item in values) { kept = &item; }
	values.append(3);
	fmt.println(kept^);
}

// The binding views storage the source still owns, so there is no owner here to
// release.
drop_lent_element :: proc() {
	values := [dynamic][dynamic]int{};
	foreach (item in values) { drop(item); }
}
