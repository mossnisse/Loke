package main; import "core:fmt";

// design.md "@(packed)": a packed field may be misaligned, so reflection hands
// out no address of one. Reading it with `field.get` is fine.

Packed :: struct @(packed) { tag: u8, value: int }

main :: proc() {
	p: Packed = {1, 2};
	foreach ($field in fields_of(Packed)) {
		fmt.println(field.get(&p));
		when (field.index == 1) {
			slot := field.pointer(&mut p);
			view := &field.get(&p);
		}
	}
}
