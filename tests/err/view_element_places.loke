package main;

// design.md "Weakening and reborrows": an element of a view is a place of its
// own only where it is known where the view starts. The same element, one
// through an index that is no constant, one through a copy of the view, and
// one of a view whose start a loop or a branch changes, or that is itself
// borrowed, may be the borrowed element. A branch or a loop that only shortens
// a view, and a fresh view of a dynamic array, keep the same element the same.
// So does a copy of a carrier out of an element, which reborrows the carrier
// stored in that element alone.

Counter :: struct { count: int, first: Option(^mut int) }
Link :: struct { to: ^mut int }

cond :: proc() -> bool { return true; }

same_element :: proc(xs: []mut Counter) {
	first := &mut xs[0];
	xs[0].count += 1;
	first^.count += 1;
}

variable_index :: proc(xs: []mut Counter, i: int) {
	first := &mut xs[0];
	xs[i].count += 1;
	first^.count += 1;
}

through_copy :: proc(xs: []mut Counter) {
	view := xs;
	first := &mut view[0];
	view[1].count += 1;
	first^.count += 1;
}

same_binding :: proc(xs: []mut Counter) {
	switch (xs[0].first) {
	case .some(n):
		xs[0].first = .none;
		n^ += 1;
	case .none:
	}
}

resliced_onto :: proc() {
	counters := [3]Counter{};
	view := &mut counters[:];
	second := &mut view[1];
	view = &mut view[1:];
	view[0].count += 1;
	second^.count += 1;
}

resliced_in_loop :: proc() {
	counters := [4]Counter{};
	view := &mut counters[:];
	for (i := 0; i < 2; i += 1) {
		second := &mut view[1];
		view = &mut view[1:];
		view[0].count += 1;
		second^.count += 1;
	}
}

chosen_start :: proc() {
	counters := [3]Counter{};
	view := &mut counters[:];
	if (cond()) { view = &mut view[1:]; }
	first := &mut view[0];
	view[1].count += 1;
	first^.count += 1;
}

view_borrowed :: proc() {
	counters := [3]Counter{};
	view := &mut counters[:];
	held := &mut view;
	first := &mut view[0];
	view[1].count += 1;
	first^.count += 1;
}

shortened_same_element :: proc() {
	counters := [3]Counter{};
	view := &mut counters[:];
	if (cond()) { view = &mut view[:2]; }
	first := &mut view[1];
	view[1].count += 1;
	first^.count += 1;
}

dynamic_same_element :: proc() {
	counters := [dynamic]Counter{Counter{}, Counter{}};
	view := &mut counters[:];
	first := &mut view[0];
	view[0].count += 1;
	first^.count += 1;
}

dynamic_chosen_start :: proc() {
	counters := [dynamic]Counter{Counter{}, Counter{}, Counter{}};
	view := &mut counters[:];
	if (cond()) { view = &mut view[1:]; }
	first := &mut view[0];
	view[1].count += 1;
	first^.count += 1;
}

copy_same_element :: proc() {
	x := 1;
	y := 2;
	links := [2]Link{Link{&mut x}, Link{&mut y}};
	view := &mut links[:];
	held := view[0].to;
	again := view[0].to;
	again^ = 3;
	held^ = 4;
}

copy_chosen_start :: proc() {
	x := 1;
	y := 2;
	z := 3;
	links := [3]Link{Link{&mut x}, Link{&mut y}, Link{&mut z}};
	view := &mut links[:];
	if (cond()) { view = &mut view[1:]; }
	held := view[0].to;
	again := view[1].to;
	again^ = 3;
	held^ = 4;
}

// A loop reslicing from a nonzero start moves the view each round, whatever
// else the loop does, and however the reslice reaches itself.
moved_in_loop :: proc() {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[1:]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

moved_in_branch_in_loop :: proc() {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) {
		s = &mut s[:2];
		if (cond()) { s = &mut s[1:]; }
	}
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

moved_through_another_view :: proc() {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) {
		t := &mut s[1:];
		s = &mut t[:];
	}
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

moved_in_outer_loop :: proc() {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) {
		for (j := 0; j < 2; j += 1) { s = &mut s[:2]; }
		s = &mut s[1:];
	}
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

// The loop only shortens it, but a branch after the loop moves it.
moved_after_shortening_loop :: proc() {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[:2]; }
	if (cond()) { s = &mut s[1:]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

// `first` is element 0 of what `s` held a round ago, which is element 1 of
// nothing the checker can name once a round has moved it.
kept_across_moving_rounds :: proc() {
	a := [3]Counter{};
	other := Counter{};
	s := &mut a[:];
	first := &mut other;
	for (i := 0; i < 2; i += 1) {
		s[0].count += 1;
		first^.count += 1;
		first = &mut s[1];
		s = &mut s[1:];
	}
	first^.count += 1;
}

// A loop that only shortens the view leaves each element itself.
same_element_after_shortening_loop :: proc() {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[:2]; }
	first := &mut s[0];
	s[0].count += 1;
	first^.count += 1;
}

same_element_across_shortening_rounds :: proc() {
	a := [3]Counter{};
	other := Counter{};
	s := &mut a[:];
	first := &mut other;
	for (i := 0; i < 2; i += 1) {
		s[0].count += 1;
		first^.count += 1;
		first = &mut s[0];
		s = &mut s[:2];
	}
}

// Reslices whose ends or starts are not constant say nothing of where the
// view starts or how long it is.
variable_end_in_loop :: proc(n: int) {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[:n]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

variable_start_in_loop :: proc(n: int) {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[n:]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

// An index past the longest the view may be, and a reslice past it, which
// always panics, name no element.
past_every_length_after_loop :: proc() {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[:2]; }
	first := &mut s[0];
	s[5].count += 1;
	first^.count += 1;
}

reslice_past_length_in_loop :: proc() {
	a := [3]Counter{};
	s := &mut a[0:2];
	for (i := 0; i < 2; i += 1) { s = &mut s[:5]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 1;
}

// Mutually dependent views, one starting short: the same element, a reslice that
// moves the start, starts that disagree, and a reslice or index past every length.
Pointing :: struct { p: ^mut int }

views_of_each_other_same_element :: proc(flag: bool) {
	a, b := 1, 2;
	held := [2]Pointing{{&mut a}, {&mut b}};
	base := held[:];
	s := base[:1];
	t := base[:];
	for (i := 0; i < 2; i += 1) {
		if (flag) { s = t[:]; }
		t = s[:2];
	}
	first := s[0].p;
	s[0].p^ += 1;
	first^ += 1;
}

views_of_each_other_moving :: proc(flag: bool) {
	a, b, c := 1, 2, 3;
	held := [3]Pointing{{&mut a}, {&mut b}, {&mut c}};
	base := held[:];
	s := base[:1];
	t := base[:];
	for (i := 0; i < 2; i += 1) {
		if (flag) { s = t[1:]; }
		t = s[:2];
	}
	first := s[0].p;
	s[1].p^ += 1;
	first^ += 1;
}

views_of_each_other_disagreeing :: proc(flag: bool) {
	a, b, c := 1, 2, 3;
	held := [3]Pointing{{&mut a}, {&mut b}, {&mut c}};
	base := held[:];
	s := base[1:];
	t := base[:];
	for (i := 0; i < 2; i += 1) {
		if (flag) { s = t[:]; }
		t = s[:2];
	}
	first := s[0].p;
	s[1].p^ += 1;
	first^ += 1;
}

views_of_each_other_past_every_length :: proc(flag: bool) {
	a, b, c := 1, 2, 3;
	held := [3]Pointing{{&mut a}, {&mut b}, {&mut c}};
	base := held[:];
	s := base[:1];
	t := base[:];
	for (i := 0; i < 2; i += 1) {
		if (flag) { s = t[:]; }
		t = s[:5];
	}
	first := s[0].p;
	s[1].p^ += 1;
	first^ += 1;
}

views_of_each_other_index_past_every_length :: proc(flag: bool) {
	a, b, c := 1, 2, 3;
	held := [3]Pointing{{&mut a}, {&mut b}, {&mut c}};
	base := held[:];
	s := base[:1];
	t := base[:];
	for (i := 0; i < 2; i += 1) {
		if (flag) { s = t[:]; }
		t = s[:2];
	}
	first := s[0].p;
	s[3].p^ += 1;
	first^ += 1;
}

main :: proc() {}
