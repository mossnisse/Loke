package main; import "core:fmt";

// design.md "Static `foreach` expansion": the body is checked once per element,
// and each copy is walked by the ordinary flow rules like any other block.

main :: proc() {
	values: [dynamic]int = {1};
	foreach ($n in [?]int{1}) {
		view: []mut int = values[:];
		values = {};
		fmt.println(view[0]);
	}
}
