package main; import "core:fmt";

Point :: struct { x: int, y: int }

CONSTANT :: 5;

immutable :: proc(value: int) {
	value = 1;
	fmt.println(value);
}

main :: proc() {
	CONSTANT = 6;
	1 + 2 = 3;
	Point{1, 2} = Point{3, 4};
	p := &(1 + 2);
	immutable(p^);
	values := [2]int{1, 2};
	foreach (element in values) { element = 1; }
	shape := Shape.points([2]int{1, 2});
	switch (shape) {
	case .points(held): held[0] = 9;
	case .empty:
	}
}

Shape :: union { points: [2]int, empty: }
