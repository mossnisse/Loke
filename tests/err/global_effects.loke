package main; import "core:fmt";

// design.md "Global write effects": a call writes whatever globals its callee
// may write, directly or through its callees, so a borrow of one that is live
// across the call conflicts, the call of a literal in place included.

cache: [dynamic]int;

reset :: proc() { cache.clear(); cache.shrink(); }
first :: proc(values: []int) -> int { reset(); return values[0]; }
first_value :: proc(values: [dynamic]int) -> int { reset(); return values[0]; }

Bag :: struct { items: [dynamic]int }
bag: Bag;
impl Bag { view :: proc(self: ^) -> []int { return self.items; } }
empty_bag :: proc() { bag.items.clear(); }

through_a_view_argument :: proc() -> int { return first(cache); }
through_a_value_argument :: proc() -> int { return first_value(cache); }
across_a_call :: proc() {
	view: []int = cache;
	reset();
	fmt.println(view[0]);
}
across_a_receiver_view :: proc() {
	view := bag.view();
	empty_bag();
	fmt.println(view[0]);
}

// An indirect call may run any procedure of a compatible type, and a `dyn`
// call any witness the program builds.
clears :: proc(values: []int) -> int { reset(); return 0; }
apply :: proc(f: proc(values: []int) -> int) -> int { return f(cache); }

Shape :: interface($Self: type) { slot area: proc(self) -> int; }
Circle :: struct { r: int }
impl Circle { area :: proc(self) -> int { reset(); return self.r; } }
measure :: proc(shape: dyn Shape) -> int {
	view: []int = cache;
	n := shape.area();
	return view.len() + n;
}

// Operator syntax reaches the same write effect as a named call.
Value :: struct { n: int }
impl Value {
	add :: operator(+) proc(a, b: Value) -> Value {
		reset();
		return {a.n + b.n};
	}
	read_then_reset :: operator(+) proc(values: []int, b: Value) -> Value {
		reset();
		return b;
	}
	add_assign :: operator(+=) proc(a: inout Value, b: Value) {
		reset();
		a.n += b.n;
	}
}
across_an_operator :: proc() -> int {
	view: []int = cache;
	_ = Value{1} + Value{2};
	return view[0];
}
through_an_operator_argument :: proc() -> int {
	return (cache + Value{0}).n;
}
across_a_compound_operator :: proc() -> int {
	value := Value{1};
	view: []int = cache;
	value += Value{2};
	return view[0];
}
// A literal called in place is a call through its value.
across_a_literal_call :: proc() -> int {
	view: []int = cache;
	(proc() { cache.clear(); })();
	return view[0];
}

main :: proc() {
	c := Circle{1};
	fmt.println(apply(clears), measure((dyn Shape)(&c)));
}

// A `@(synchronized)` variable's package vouches for every access to it, so a
// call that writes or reads one conflicts with no borrow of it, through a `dyn`
// slot as by name. A call that writes any other global still does.
@(synchronized) vouched: int;
plain: int;

vouched_handle :: proc() -> ^mut int { return &mut vouched; }
plain_handle :: proc() -> ^mut int { return &mut plain; }
read_vouched :: proc() -> int { return vouched; }

Counter :: struct {}
impl Counter { area :: proc(self) -> int { vouched_handle()^ += 1; return vouched; } }

across_vouched_calls :: proc(shape: dyn Shape) -> int {
	first := vouched_handle();
	second := vouched_handle();
	n := read_vouched() + shape.area();
	first^ += n;
	second^ += n;
	return n;
}
across_plain_calls :: proc() -> int {
	first := plain_handle();
	second := plain_handle();
	first^ += 1;
	return second^;
}

// `Counter` fills the slot as `Circle` does, so `shape.area()` above takes in
// its write of `vouched`, which the attribute keeps from conflicting.
count_through_a_slot :: proc() -> int {
	counter := Counter{};
	return across_vouched_calls((dyn Shape)(&counter));
}
