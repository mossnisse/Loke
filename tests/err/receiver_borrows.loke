package main; import "core:fmt";

// The rejections that bound a `self: ^` receiver's borrow (design.md "Receiver
// forms", "Temporaries and procedure boundaries").

Inline :: struct {
	items: [4]int,
	count: int,
}

impl Inline {
	view :: proc(self: ^) -> []int { return self.items[0:self.count]; }
	sum :: proc(self) -> int { return self.items[0] + self.items[1]; }
	push :: proc(self: inout Inline, value: int) {
		self.items[self.count] = value;
		self.count += 1;
	}
}

// A borrow of the receiver's own storage cannot outlive the receiver.
escaped :: proc() -> []int {
	local: Inline = {};
	return local.view();
}

// An `inout` receiver is no different: a pointer to storage the receiver itself
// owns cannot outlive it, even from a type that also carries a view which would.
// The dependency on a parameter widens as soon as one borrow names the
// parameter's own storage rather than something it carries.
Cursor :: struct {
	items: []int,
	at:    int,
}

impl Cursor {
	position :: proc(self: inout Cursor) -> ^int { return &self.at; }
}

escaped_position :: proc(source: []int) -> ^int {
	local := Cursor{source, 0};
	return local.position();
}

main :: proc() {
	x: Inline = {};
	x.push(1);

	// A mutation conflicts with a receiver-derived view that is still in use.
	v := x.view();
	x.push(2);
	fmt.println(v.len());

	// So does dropping the source out from under it.
	y: Inline = {};
	w := y.view();
	drop(y);
	fmt.println(w.len());

	values := [?]int{1, 2};
	fmt.println(escaped_position(values[:])^);
}
