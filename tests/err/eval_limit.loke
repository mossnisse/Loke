package main; import "core:fmt";

spin :: proc() -> int {
	x := 0;
	for (;;) {
		assert(true); // Exercise the step limit without exhausting storage first.
	}
	return x;
}

N :: spin();

main :: proc() {
	fmt.println(N);
}

TEXT :: grow_text();
grow_text :: proc() -> int {
	text := "x";
	for (i := 0; i < 26; i += 1) { text = text + text; }
	return text.len();
}

INTEGER :: grow_integer();
grow_integer :: proc() -> int {
	x := 0;
	for (;;) { x += 1; }
	return x;
}

ARRAY :: grow_array();
grow_array :: proc() -> int {
	xs: [dynamic]int = {};
	xs.resize(1000000);
	return xs.len();
}

// Recursion stops at `EVAL_MAX_DEPTH` calls. A recursion whose frames are fat
// with nesting runs out of stack first, which `evaluation_runs_out_of_stack_cleanly`
// covers: the source is too wide to keep here.
STACK :: grow_stack(1000);
grow_stack :: proc(n: int) -> int {
	if (n == 0) { return 0; }
	return 1 + grow_stack(n - 1);
}
