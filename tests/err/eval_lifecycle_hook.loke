package main;

// design.md "Compile-time procedure evaluation": an evaluated path makes no
// value whose drop or copy would run a hand-written hook, so such a record is
// refused where evaluation makes it, folded or built, alone or held in another
// record or a union constant, instead of being evaluated with its hook skipped.
Tracked :: struct { n: int }
impl Tracked {
	release :: hook(drop) proc(self: inout Tracked) { panic("drop ran"); }
}

Holder :: struct { inner: Tracked, count: int }
Choice :: union { held: Tracked, count: int }
HELD_CHOICE :: Choice.held(Tracked{3});

Copied :: struct { n: int }
impl Copied {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Copied, Allocator_Error) {
		return .ok(Copied{self.n + 1});
	}
}

explicit :: proc() -> int { value := Tracked{1}; drop(value); return 1; }
held :: proc() -> int { holder := Holder{count = 2}; return holder.count; }
declared :: proc() -> int { pair: [2]Tracked; return 1; }
copied :: proc() -> int { a: Copied = {}; b := a; return b.n; }
plain :: proc() -> int { return 7; }
// A union holding none, or an empty container, is fine.
empty :: proc() -> int { none: Option(Tracked) = .none; list := [dynamic]Tracked{}; return list.len(); }
union_constant :: proc() -> int { choice := HELD_CHOICE; return 1; }

EXPLICIT :: explicit();
HELD :: held();
DECLARED :: declared();
COPIED :: copied();
PLAIN :: plain();
EMPTY :: empty();
UNION_CONSTANT :: union_constant();

main :: proc() { _ = EXPLICIT + HELD + DECLARED + COPIED + PLAIN + EMPTY + UNION_CONSTANT; }
