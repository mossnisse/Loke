package main;
import "core:mem";

// design.md "`inout` results": a place in the callee's own frame ends when it
// returns.
escape :: proc() -> inout int {
	local := [4]int{1, 2, 3, 4};
	return inout local[0];
}

main :: proc() {
	escape() = 1;
}

// A region passed through a call keeps its default-provider bit, so it is not
// one a reset-capable parameter may be handed: nothing resets the default
// provider (design.md "@(allocator_reset)").
take :: proc(a: Allocator) -> Allocator { return a; }
release :: proc(@(allocator_reset) a: Allocator) { free_all(a); }
reset :: proc() {
	b := take(mem.default_allocator());
	release(b);
}
