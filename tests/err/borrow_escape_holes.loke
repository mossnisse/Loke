package main;
import "core:mem";

// design.md "`inout` results": a place in the callee's own frame ends when it
// returns.
escape :: proc() -> inout int {
	local := [4]int{1, 2, 3, 4};
	return inout local[0];
}

Guard :: struct { value: int }
impl Guard {
	release :: hook(drop) proc(self: inout Guard) { self.value = -1; }
}
make_guard :: proc() -> Guard { return {42}; }

// design.md "any_view type": a managed temporary is dropped with its statement.
erased :: proc() {
	view: any_view = make_guard();
	guard := view.as(Guard);
	_ = guard;
}

main :: proc() {
	escape() = 1;
	erased();
}

// A region passed through a call keeps its default-provider bit, so a reset
// that may name the default provider conflicts with an owner backed by it.
take :: proc(a: Allocator) -> Allocator { return a; }
reset :: proc(@(allocator_reset) a: Allocator) {
	b := take(mem.default_allocator());
	numbers: [dynamic]int via b = {};
	numbers.append(1);
	free_all(a);
	_ = numbers.len();
}
