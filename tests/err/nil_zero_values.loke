package main;

// design.md "Zero values": `nil` converts only to a reference or an unchecked
// address. Every other type's zero is `{}`, and a slice compares with nothing
// (design.md "Empty slices").

main :: proc() {
	s: []int = nil;
	v: string_view = nil;
	id: typeid = nil;
	a: Allocator = nil;
	e: Allocator_Error = nil;
	w: weak(int) = nil;
	t: []int = {};
	if (t == nil) { }
	if (id == nil) { }

	// Still accepted: a reference, an unchecked address, a shared handle.
	p: ^int = nil;
	r: rawptr = nil;
	h: shared(int) = nil;
	_ = p; _ = r; _ = h;
}
