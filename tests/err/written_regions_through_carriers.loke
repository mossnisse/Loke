// design.md "Allocator regions and region provenance": an owner a call leaves
// through a read-only carrier that reaches a mutable one, a variadic
// `..^mut T` or a `^Box` whose field is `^mut T`, keeps its region, directly
// or through a procedure forwarding the carrier. A reset while it is live is
// an error, as for a `^mut T` parameter; written through a pointer the caller
// holds rather than a place it names, a local region is an error at the call,
// as `p^ = owner` is. A local copy of such a carrier, or a value built from
// one, writes into the caller as the carrier does, whichever operand of a
// conditional supplies it and whichever field of a local holds it. An owner
// written through a pointer the caller holds, or a record holding one, lands
// in the place `&mut place` lent it, so a later reset of that region is an
// error there too, from a received allocator as from a local arena. So does an
// owner written through a mutable pointer held in a record a held mutable
// pointer reaches.
package main;

import "core:mem";
import "core:fmt";

point :: proc(allocator: Allocator, outs: ..^mut [dynamic]int) {
	outs[0]^ = make([dynamic]int, 2, allocator);
}

Box :: struct { out: ^mut [dynamic]int }
point_box :: proc(allocator: Allocator, box: ^Box) {
	box^.out^ = make([dynamic]int, 2, allocator);
}

point_direct :: proc(allocator: Allocator, out: ^mut [dynamic]int) {
	out^ = make([dynamic]int, 2, allocator);
}

forward_pack :: proc(allocator: Allocator, outs: ..^mut [dynamic]int) {
	point(allocator, ..outs);
}

forward_box :: proc(allocator: Allocator, box: ^Box) {
	point_box(allocator, box);
}

variadic :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	point(arena.allocator(), &mut out);
	free_all(arena.allocator());
	fmt.println(out[0]);
}

boxed :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	box := Box{&mut out};
	point_box(arena.allocator(), &box);
	free_all(arena.allocator());
	fmt.println(out[0]);
}

held_pointer :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	p := &mut out;
	point_direct(arena.allocator(), p);
	free_all(arena.allocator());
	fmt.println(out[0]);
}

forwarded_pack :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	forward_pack(arena.allocator(), &mut out);
	free_all(arena.allocator());
	fmt.println(out[0]);
}

forwarded_box :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	forward_box(arena.allocator(), &Box{&mut out});
	free_all(arena.allocator());
	fmt.println(out[0]);
}

copied_pack :: proc(allocator: Allocator, outs: ..^mut [dynamic]int) {
	alias := outs;
	alias[0]^ = make([dynamic]int, 2, allocator);
}

copied_box :: proc(allocator: Allocator, box: ^Box) {
	b := box^;
	b.out^ = make([dynamic]int, 2, allocator);
}

rebuilt_box :: proc(allocator: Allocator, box: ^Box) {
	b := Box{box^.out};
	b.out^ = make([dynamic]int, 2, allocator);
}

spread_copy :: proc(allocator: Allocator, outs: ..^mut [dynamic]int) {
	alias := outs;
	point(allocator, ..alias);
}

copied :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	copied_pack(arena.allocator(), &mut out);
	free_all(arena.allocator());
	fmt.println(out[0]);
}

copied_boxes :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	copied_box(arena.allocator(), &Box{&mut out});
	rebuilt_box(arena.allocator(), &Box{&mut out});
	fmt.println(out[0]);
}

spread_copied :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	spread_copy(arena.allocator(), &mut out);
	free_all(arena.allocator());
	fmt.println(out[0]);
}

Pair :: struct { unused: ^mut [dynamic]int, local: ^mut [dynamic]int }

conditional_box :: proc(allocator: Allocator, box: ^Box, flag: bool) {
	alias := box if flag else box;
	alias^.out^ = make([dynamic]int, 2, allocator);
}

field_box :: proc(allocator: Allocator, box: ^Box) {
	first: [dynamic]int = {};
	second: [dynamic]int = {};
	pair := Pair{&mut first, &mut second};
	pair.unused = box^.out;
	copy := pair;
	copy.unused^ = make([dynamic]int, 2, allocator);
}

through_fields :: proc() {
	arena := mem.Arena.init();
	out: [dynamic]int = {};
	box := Box{&mut out};
	conditional_box(arena.allocator(), &box, true);
	field_box(arena.allocator(), &box);
	fmt.println(out.len());
}

held_reset :: proc(@(allocator_reset) allocator: Allocator) {
	out: [dynamic]int = {};
	p := &mut out;
	point_direct(allocator, p);
	free_all(allocator);
	fmt.println(out[0]);
}

held_box_reset :: proc(@(allocator_reset) allocator: Allocator) {
	out: [dynamic]int = {};
	box := Box{&mut out};
	point_box(allocator, &box);
	free_all(allocator);
	fmt.println(out[0]);
}

held_body_reset :: proc(@(allocator_reset) allocator: Allocator) {
	out: [dynamic]int = {};
	p := &mut out;
	q := p;
	q^ = make([dynamic]int, 2, allocator);
	free_all(allocator);
	fmt.println(out[0]);
}

Inner :: struct { text: string }
Outer :: struct { pointer: ^mut Inner }

fill_nested :: proc(outer: ^mut Outer, allocator: Allocator) {
	outer.pointer^.text = fmt.to_string(allocator, 7);
}

held_nested_reset :: proc(@(allocator_reset) allocator: Allocator) -> string {
	inner := Inner{""};
	outer := Outer{&mut inner};
	pointer := &mut outer;
	fill_nested(pointer, allocator);
	free_all(allocator);
	return inner.text;
}

main :: proc() {}
