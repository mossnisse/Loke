package main; import "core:fmt";

// What `@(escape=...)` refuses. A
// declared level is an upper bound on what the body does, so a body that
// exceeds it, a value that promises less than its type, and a level written
// where it cannot mean anything are all errors.

// The body contradicts its own promise.
liar :: proc(input: []int, @(escape=none) scratch: []int) -> []int {
	return scratch;
}

// The same through a wrapper, so the summary has to travel to find it.
wrap_scratch :: proc(values: []int) -> []int { return values; }

indirect_liar :: proc(input: []int, @(escape=none) scratch: []int) -> []int {
	return wrap_scratch(scratch);
}

// A plain type promises less than a type that marks a parameter `none`, so it
// does not convert; an inferred contract converts only if its result never borrows it.
leaky :: proc(input: []int, scratch: []int) -> []int { return scratch; }

assign_a_weaker_callee :: proc(plain: proc(input: []int, scratch: []int) -> []int) -> int {
	chooser: proc(input: []int, @(escape=none) scratch: []int) -> []int = plain;
	leaked: proc(input: []int, @(escape=none) scratch: []int) -> []int = leaky;
	return 0;
}

// A parameter that carries no borrow cannot escape.
counts :: proc(@(escape=none) count: int) -> int { return count; }

// An unknown level.
misspelled :: proc(@(escape=sometimes) values: []int) -> []int { return values; }

main :: proc() {
	fmt.println(1);
}
