package main; import "core:fmt";

main :: proc() {
	// m6b-plan step 1: the container *type* is complete — layout, zero value,
	// lifecycle — while each operation is ungated only in the step that also
	// installs its invalidation. So the declaration is accepted and the
	// iteration is the one construct that gates.
	table: map[int]int;
	foreach (value in table) {
		fmt.println(value);
	}
}
