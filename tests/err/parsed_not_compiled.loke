package main; import "core:fmt"; import "core:unsafe";

main :: proc() {
	// m6b-plan step 4: containers iterate, and the dynamic `unsafe.raw_data`
	// overload is the handoff that still waits — it crosses the unsafe provenance
	// boundary and lands with the conversion row itself.
	table: map[int]int;
	table[1] = 2;
	foreach (key, value in table) {
		fmt.println(key + value);
	}
	xs: [dynamic]u8;
	p := unsafe.raw_data(xs);
	fmt.println(p != nil);
}
