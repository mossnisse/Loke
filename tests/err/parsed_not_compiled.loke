package main; import "core:fmt";

// The compile-time evaluator has no `foreach`. It parses, checks, and runs at
// run time; it simply has no compile-time meaning yet, so a constant that needs
// one says so rather than silently generating code.
//
// A map is rejected for its own reason and keeps its own fixture: its iteration
// order is unspecified, so the case stays closed even after this one opens.
TOTAL :: total();

total :: proc() -> int {
	xs: [dynamic]int = {1, 2, 3};
	sum := 0;
	foreach (v in xs) {
		sum += v;
	}
	return sum;
}

main :: proc() {
	fmt.println(TOTAL);
}
