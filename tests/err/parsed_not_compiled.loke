package main; import "core:fmt";

// m6b-plan step 6: the compile-time evaluator does not yet own managed
// containers. A container operation has a compiler-generated body rather than a
// written one, so asking for one during constant folding reports that there is
// nothing to evaluate.
BUILT :: build_it();

build_it :: proc() -> int {
	xs: [dynamic]int;
	xs.append(1, 2, 3);
	return len(xs);
}

main :: proc() {
	fmt.println(BUILT);
}
