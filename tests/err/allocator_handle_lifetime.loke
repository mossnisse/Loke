package main;
import "core:mem";

// design.md "Allocators": handles borrow the provider's stable control block.
after_drop :: proc() {
	owner := mem.Arena.init();
	allocator := owner.allocator();
	drop(owner);
	p := box(0, allocator);
	p^ = 42;
}

after_overwrite :: proc() {
	owner := mem.Scratch.init();
	allocator := owner.allocator();
	owner = mem.Scratch.init();
	p := box(0, allocator);
	p^ = 42;
}

temporary_handle :: proc() {
	allocator := mem.Arena.init().allocator();
	p := box(0, allocator);
	p^ = 42;
}

temporary_parent :: proc() {
	child := mem.Scratch.init(mem.Arena.init().allocator());
	p := box(0, child.allocator());
	p^ = 42;
}

forward :: proc(allocator: Allocator) -> Allocator { return allocator; }
Holder :: struct { allocator: Allocator }

forwarded :: proc() {
	owner := mem.Arena.init();
	holder := Holder{forward(owner.allocator())};
	drop(owner);
	p := box(0, holder.allocator);
	p^ = 42;
}

escaped :: proc() -> Allocator {
	owner := mem.Arena.init();
	return owner.allocator();
}

// design.md "Minimum provenance precision": a handle read out of an array of
// more than eight may be any of them, so the dependency is only possible.
merged :: proc() {
	safe := mem.Arena.init();
	owner := mem.Arena.init();
	values: [9]Allocator = {};
	values[0] = safe.allocator();
	values[8] = owner.allocator();
	allocator := values[0];
	drop(owner);
	p := box(0, allocator);
	p^ = 42;
}

main :: proc() {}
