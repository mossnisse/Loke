package main;

// design.md "Compile-time procedure evaluation": a place reached through a user
// `operator([])` is not compile-time storage yet, so evaluation stops rather
// than writing the operand's own fields.

Cells :: struct { data: [2]int }
impl Cells {
	slot :: operator([]) proc(self: inout Cells, index: int) -> inout int { return inout self.data[index]; }
}
fill :: proc() -> int { c := Cells{}; c[1] = 7; return c.data[1]; }

FILLED :: fill();

main :: proc() { _ = fill(); }
