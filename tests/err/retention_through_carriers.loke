package main;

// design.md "Retaining a borrow": a destination reached through a carrier uses
// every root that carrier may name. That carrier is the one whose pointee holds
// the place, read through every carrier outside it, as `b` in `p^.b^.value`, or
// a call's result; a lock's guard reaches the lock's storage that way.
import "core:sync";
import "core:thread";

Box :: struct { value: Option(^int), items: [dynamic]^int, keys: map[^int]int }
Holder :: struct { b: ^mut Box }

cell: static Box = {};
kept: static int = 7;
locked: static thread.Mutex(Option(^int)) = {};
watched: static thread.Monitor(Option(^int)) = {};

box_of :: proc(holder: ^mut Holder) -> ^mut Box { return holder.b; }
value_of :: proc(holder: inout Holder) -> inout Option(^int) { return inout holder.b.value; }

guarded :: proc() {
	value := 42;
	guard := locked.lock();
	guard.get() = .some(&value);
}

monitored :: proc() {
	value := 42;
	guard := watched.lock();
	guard.get() = .some(&value);
}

two_hops :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	p := &mut holder;
	p^.b^.value = .some(&value);
}

through_result :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	box_of(&mut holder).value = .some(&value);
}

through_inout_result :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	value_of(inout holder) = .some(&value);
}

appended :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	p := &mut holder;
	p^.b^.items.append(&value);
}

appended_to_result :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	box_of(&mut holder).items.append(&value);
}

keyed :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	p := &mut holder;
	p^.b^.keys[&value] = 1;
}

keep :: proc(destination: inout Box, @(escape=stored) value: ^int) { destination.value = .some(value); }

kept_through :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	p := &mut holder;
	keep(inout p^.b^, &value);
}

kept_through_result :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	keep(inout box_of(&mut holder)^, &value);
}

// A part of an `inout` result is in the place the result names.
boxed: static thread.Mutex(Box) = {};
items_of :: proc(box: inout Box) -> inout [dynamic]^int { return inout box.items; }
Duo :: struct { value: Option(^int), first: Box }
first_of :: proc(duo: inout Duo) -> inout Box { return inout duo.first; }

guarded_field :: proc() {
	value := 42;
	guard := boxed.lock();
	guard.get().value = .some(&value);
}

guarded_key :: proc() {
	value := 42;
	guard := boxed.lock();
	guard.get().keys[&value] = 1;
}

guarded_append :: proc() {
	value := 42;
	guard := boxed.lock();
	guard.get().items.append(&value);
}

appended_to_inout_result :: proc() {
	value := 42;
	items_of(inout cell).append(&value);
}

kept_in_guarded_field :: proc() {
	value := 42;
	guard := boxed.lock();
	keep_option(inout guard.get().value, &value);
}
keep_option :: proc(destination: inout Option(^int), @(escape=stored) value: ^int) { destination = .some(value); }

// A part of an `inout` result that is a field of its argument is somewhere in
// that argument, not at the same path in it: `duo.value` is not `.value` of
// `first_of(inout duo)`.
ended_in_field_result :: proc() -> int {
	duo: Duo = {};
	{
		value := 3;
		first_of(inout duo).value = .some(&value);
		duo.value = .none;
	}
	switch (duo.first.value) {
	case .some(p): return p^;
	case .none:
	}
	return 0;
}

ended_in_local_guard :: proc() -> int {
	lock: thread.Mutex(Box) = {};
	{
		value := 3;
		guard := lock.lock();
		guard.get().value = .some(&value);
	}
	guard := lock.lock();
	switch (guard.get().value) {
	case .some(p): return p^;
	case .none:
	}
	return 0;
}

// What a parameter's pointer leads to is the caller's storage too.
left_in_caller :: proc(holder: ^Holder, value: ^int) {
	holder.b.value = .some(value);
}

// What outlives the destination may be stored, and a guard of a local lock may
// reach a local that outlives it.
fine :: proc() {
	guard := locked.lock();
	guard.get() = .some(&kept);
	holder := Holder{&mut cell};
	p := &mut holder;
	p^.b^.value = .some(&kept);
	keep(inout p^.b^, &kept);
	box_of(&mut holder).items.append(&kept);
	value := 1;
	local: thread.Mutex(Option(^int)) = {};
	{
		inner := local.lock();
		inner.get() = .some(&value);
	}
	{
		guard_box := boxed.lock();
		guard_box.get().value = .some(&kept);
		guard_box.get().items.append(&kept);
		guard_box.get().keys[&kept] = 2;
	}
}

// design.md "Maps": only `m[key] = elem` creates an entry, so a lookup on the
// way to a store leaves its key in no map.
Owners :: struct { boxes: map[^int]^mut Counter }
Counter :: struct { n: int }
counted: static Counter = {};
looked_up :: proc() {
	local := 42;
	own := Owners{};
	own.boxes[&local] = &mut counted;
	p := &mut own;
	p.boxes[&local].n = 12;
	tallies[&local].n = 3;
}
tallies: static map[^int]Counter = {};

// An `inout` place lent through carriers is the destination, with what its own
// carriers reach, not what lies beside it in the same pointee.
Slot :: struct { slot: Option(^int) }
Sibling :: struct { first: Slot, other: ^mut Slot }
global_slot: static Slot = {};
keep_slot :: proc(destination: inout Slot, @(escape=stored) value: ^int) { destination.slot = .some(value); }
projected :: proc() {
	n := 1;
	pair := Sibling{other = &mut global_slot};
	p := &mut pair;
	keep_slot(inout p.first, &n);
}

// A thread-local write through an `inout` place leaves the place's read-only
// pointer to static storage no destination.
View :: struct { view: ^int }
tls: thread_local int = 5;
set :: proc(destination: inout View) { destination.view = &tls; }
written_through :: proc() {
	holder := View{view = &kept};
	p := &mut holder;
	set(inout p^);
}

// A `stored` argument lands only where the callee can write: what a mutable
// carrier reaches, and an atomic behind a read-only one, not what a read-only
// carrier points at.
Cell :: struct { latest: sync.Atomic(Option(^int)) }
Ref :: struct { cell: ^Cell }
shared: static Cell = {};
keep_through :: proc(destination: ^mut Holder, @(escape=stored) value: ^int) { destination.b.value = .some(value); }
keep_view :: proc(destination: ^mut View, @(escape=stored) value: ^int) { destination.view = value; }
publish :: proc(destination: ^Cell, @(escape=stored) value: ^int) { destination.latest.store(.some(value)); }
publish_through :: proc(destination: ^mut Ref, @(escape=stored) value: ^int) { destination.cell.latest.store(.some(value)); }
kept_through_mutable :: proc() {
	value := 42;
	holder := Holder{&mut cell};
	keep_through(&mut holder, &value);
}
published :: proc() {
	value := 42;
	publish(&shared, &value);
}
published_through :: proc() {
	value := 42;
	r := Ref{&shared};
	publish_through(&mut r, &value);
}
kept_beside_read_only :: proc() -> int {
	value := 3;
	holder := View{view = &kept};
	keep_view(&mut holder, &value);
	return holder.view^;
}

// A lock's guard writes what the lock holds through a read-only pointer, so a
// lock that can hold a borrow is a destination there, as an atomic is.
Locked :: struct { lock: ^thread.Mutex(Box) }
keep_locked :: proc(destination: ^mut Locked, @(escape=stored) value: ^int) {}
Guarded :: struct { lock: thread.Mutex(Option(^int)) }
impl Guarded {
	keep :: proc(self: ^, @(escape=stored) value: ^int) {
		guard := self.lock.lock();
		guard.get() = .some(value);
	}
}
guarded_static: static Guarded = {};
kept_behind_lock :: proc() {
	value := 42;
	holder := Locked{&boxed};
	keep_locked(&mut holder, &value);
}
kept_in_lock_receiver :: proc() {
	value := 42;
	p := &guarded_static;
	p.keep(&value);
}

// A synchronized receiver reached through a pointer is the storage that
// pointer names, and what it holds leads on where its own carriers do: through
// `mid` to the static `cell`, but not into what the atomic points at,
// which a store replaces.
Mid :: struct { slot: ^mut Box }
Mixed :: struct { cell: sync.Atomic(Option(^int)), mid: ^Mid }
impl Mixed { keep :: proc(self: ^, @(escape=stored) value: ^int) {} }
kept_beside_atomic :: proc() {
	value := 42;
	mid := Mid{&mut cell};
	mixed := Mixed{mid = &mid};
	p := &mixed;
	p.keep(&value);
}
replaced_in_local_atomic :: proc() -> int {
	value := 3;
	pointer: sync.Atomic(^int) = {value = &kept};
	p := &pointer;
	p.store(&value);
	return p.load()^;
}

main :: proc() {}
