package main;

// design.md "Weakening and reborrows": an assignment that reorders its targets'
// values leaves each carrier in one place, and any other that stores one leaves
// it in two. Which it is depends on what each expression names when it is
// evaluated (design.md "Evaluation order"), never on how it is spelled.

Link :: struct { to: ^mut int }

index: int = 0;
next :: proc() -> int { result := index; index = 1; return result; }

// The reproduction: the text repeats, and each call names another element.
through_calls :: proc(links: []mut Link) { links[next()], links[next()] = links[next()], links[next()]; }
one_value_twice :: proc(links: []mut Link) { links[0], links[1] = links[1], links[1]; }
one_variable_twice :: proc(links: []mut Link, i, j: int) { links[i], links[j] = links[j], links[j]; }

swapped :: proc(links: []mut Link) { links[0], links[1] = links[1], links[0]; }
spaced :: proc(links: []mut Link) { links[0], links[1] = links[ 1 ], links[ 0 ]; }
named_constant :: proc(links: []mut Link) { ZERO :: 0; links[ZERO], links[1] = links[1], links[0]; }
variables :: proc(links: []mut Link, i, j: int) { links[i], links[j] = links[j], links[i]; }
in_place :: proc(links: []mut Link, i, j: int) { links[i], links[j] = links[i], links[j]; }

rejected_through_calls :: proc() {
	x := 1; y := 2;
	links := [2]Link{Link{&mut x}, Link{&mut y}};
	through_calls(&mut links[:]);
	first := links[0].to;
	second := links[1].to;
	first^ = 1;
	second^ = 2;
}

rejected_one_value_twice :: proc() {
	x := 1; y := 2;
	links := [2]Link{Link{&mut x}, Link{&mut y}};
	one_value_twice(&mut links[:]);
	first := links[0].to;
	second := links[1].to;
	first^ = 1;
	second^ = 2;
}

rejected_one_variable_twice :: proc() {
	x := 1; y := 2;
	links := [2]Link{Link{&mut x}, Link{&mut y}};
	one_variable_twice(&mut links[:], 0, 1);
	first := links[0].to;
	second := links[1].to;
	first^ = 1;
	second^ = 2;
}

accepted_reorderings :: proc() {
	x := 1; y := 2;
	links := [2]Link{Link{&mut x}, Link{&mut y}};
	swapped(&mut links[:]);
	spaced(&mut links[:]);
	named_constant(&mut links[:]);
	variables(&mut links[:], 0, 1);
	in_place(&mut links[:], 0, 1);
	first := links[0].to;
	second := links[1].to;
	first^ = 1;
	second^ = 2;
}

main :: proc() {}
