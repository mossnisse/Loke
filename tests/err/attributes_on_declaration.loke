// design.md "Attributes": a type attribute describes a `struct` or `union`
// definition, so a declaration whose value is anything else cannot carry one.
package main;

Header :: struct { a: u8 }
@(packed) Alias :: Header;
@(move_only) Number :: int;
@(move_only) Kind :: enum { A }
@(zero=A) Other :: enum { A }
@(move_only) Value :: 3;

// Each one still applies only to the records it describes.
@(packed) Bad_Union :: union { a: int }
@(zero=a) Bad_Struct :: struct { a: int }
@(move_only=true) Valued :: struct { a: int }

// Written twice, in one group or two.
@(move_only, move_only) Twice :: struct { a: int }
@(packed) @(packed) Packed_Twice :: struct { a: int }

// A union is move-only like a struct.
@(move_only) Held :: union { none, id: int }

main :: proc() {
	h := Held.id(7);
	a := h;
	_ = a;
	c := Held.id(1);
	d := c.clone();
	_ = d;
}

// A lifecycle hook is a struct's, and `@(move_only)` does not make a union one.
@(move_only) Drop_Hooked :: union { none, id: int }
impl Drop_Hooked { release :: hook(drop) proc(self: inout Drop_Hooked) {} }
@(move_only) Copy_Hooked :: union { none, id: int }
impl Copy_Hooked { duplicate :: hook(copy) proc(self: ^Copy_Hooked) -> Copy_Hooked { return .none; } }
