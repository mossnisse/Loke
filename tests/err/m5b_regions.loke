package main; import "core:mem"; import "core:fmt";

// m5b-plan step 3: allocator regions and reset effects. design.md: "The
// compiler rejects `free_all`, or any call carrying the same allocator-reset
// effect, while a live owning value or borrow still refers
// to storage from that allocator."

Buffer :: struct { id: int }

impl Buffer {
	release :: hook(drop) proc(self: inout Buffer) { self.id = 0; }
}

make_buffer :: proc(value: int, allocator: Allocator) -> Buffer {
	return Buffer{value};
}

release :: proc(@(allocator_reset) allocator: Allocator) {
	free_all(allocator);
}

global_buffer: Buffer;

// design.md: "It may not hide a reset of a global or other pre-existing
// allocator: such an allocator is taken through an `@(allocator_reset)`
// parameter instead."
hidden_reset :: proc(allocator: Allocator) {
	free_all(allocator);
}

// The promise is verified transitively, so handing an unmarked parameter to a
// reset-capable procedure is the same mistake one call further out.
unmarked_wrapper :: proc(allocator: Allocator) {
	release(allocator);
}

// The effect is part of the procedure type, so an indirect call keeps it.
indirect_wrapper :: proc(allocator: Allocator, reset: proc(@(allocator_reset) a: Allocator)) {
	reset(allocator);
}

// design.md: `free_all` "frees every allocation in the allocator's region", so
// a pointer into it that is used afterwards would dangle.
alias_survives_reset :: proc(@(allocator_reset) allocator: Allocator) {
	pointer := new(int, allocator) or_else nil;
	free_all(allocator);
	fmt.println(pointer^);
}

// An owner still needing its cleanup would run that cleanup over released
// storage, whether or not it has a later use.
owner_survives_reset :: proc(@(allocator_reset) allocator: Allocator) {
	held := make_buffer(1, allocator);
	free_all(allocator);
	fmt.println(held.id);
}

// The reset does reach the allocations of the region it names, including one
// this body created: the gate above is region identity, not allocation kind.
local_arena_alias_survives_reset :: proc() {
	arena := mem.Arena.init();
	pointer := new(int, arena.allocator()) or_else nil;
	free_all(arena.allocator());
	fmt.println(pointer^);
}

// Distinct parameters are not proof of distinct regions: a caller may pass the
// same allocator handle for both.
parameter_regions_may_alias :: proc(
	@(allocator_reset) reset: Allocator,
	allocate: Allocator,
) {
	pointer := new(int, allocate) or_else nil;
	free_all(reset);
	fmt.println(pointer^);
}

// The allocation site runs again after the assignment on the loop back edge,
// so its region is both `a` and `b` even though the first iteration uses `a`.
loop_carried_allocation_region :: proc() {
	a := mem.Arena.init();
	b := mem.Arena.init();
	allocator := a.allocator();
	for (i := 0; i < 2; i += 1) {
		pointer := new(int, allocator) or_else nil;
		allocator = b.allocator();
		free_all(b.allocator());
		fmt.println(pointer^);
	}
}

// An allocation returned through a direct call keeps the callee's allocator
// region. A caller cannot receive one backed by a provider the callee destroys.
return_local_region_allocation :: proc() -> ^mut int {
	arena := mem.Arena.init();
	return new(int, arena.allocator()) or_else nil;
}

// design.md: an owner "backed by a region created in the current procedure may
// not be ... assigned to `static`, `thread_local`, or file-scope storage".
owner_escapes_to_file_scope :: proc(allocator: Allocator) {
	global_buffer = make_buffer(2, allocator);
}

owner_escapes_to_static :: proc(allocator: Allocator) {
	kept: static Buffer = Buffer{0};
	kept = make_buffer(3, allocator);
}

// The attribute states something only an `Allocator` can promise.
bad_attribute :: proc(@(allocator_reset) value: int) {
	fmt.println(value);
}

// The reset effect is part of the type, so it cannot be hidden by storing the
// procedure in a value whose type omits it.
hidden_effect :: proc() {
	handler: proc(a: Allocator) = release;
	handler(mem.default_allocator());
}

main :: proc() {
	fmt.println(1);
}

// Extracting an allocator handle does not create default-backed owned storage.
// Its erased region must remain conservative, not bypass a local arena reset.
erased_allocator_region :: proc() {
	arena := mem.Arena.init();
	allocator := arena.allocator();
	view: any_view = allocator;
	switch (restored in view.as(Allocator)) {
	case .some:
		xs: [dynamic]int via restored = {};
		xs.append(1);
		free_all(allocator);
		fmt.println(xs[0]);
	case .none:
	}
}

// Wrapping the owner in a field of
// file-scope storage does not lose the obligation its bare form has.
Holder :: struct { buffer: Buffer }

global_holder: Holder;

owner_escapes_through_a_field :: proc(allocator: Allocator) {
	global_holder.buffer = make_buffer(4, allocator);
}

// Moving a region-backed owner into an aggregate field transfers the field's
// backing-region dependency just as constructing the aggregate in one expression
// does. Returning the wrapper would outlive the local arena.
Region_Owner :: struct { data: [dynamic]int }

local_region_moved_into_field :: proc() -> Region_Owner {
	arena := mem.Arena.init();
	values: [dynamic]int via arena.allocator() = {};
	values.append(1);
	held: Region_Owner = {};
	held.data = move(values);
	return held;
}
