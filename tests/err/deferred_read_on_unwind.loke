// design.md "defer statement": a deferred statement runs during unwinding too, so
// what it reads must be live at every statement that may panic after it.
package main;
import "core:fmt";

Err :: enum { Bad }
@(move_only) Y :: struct { id: int }

risky :: proc() { panic("risky"); }

moved_before_panic :: proc() -> Result(Y, Err) {
	y := Y{5};
	errdefer fmt.println(y.id);
	z := move(y);
	risky();
	return .ok(move(z));
}

dropped_before_panic :: proc() {
	y := Y{5};
	defer fmt.println(y.id);
	drop(y);
	panic("no normal exit");
}

not_yet_assigned :: proc() {
	x: int;
	defer fmt.println(x);
	x = next();
}

next :: proc() -> int { return 1; }

// Cannot panic between the moves and the reads.
live_where_it_can_panic :: proc() -> Result(Y, Err) {
	y := Y{5};
	errdefer fmt.println(y.id);
	risky();
	return .ok(move(y));
}

assigned_without_panic :: proc() {
	x: int;
	defer fmt.println(x);
	x = 1;
}

// design.md "Evaluation order": an argument is moved before the next is
// evaluated, and before the call, either of which may panic.
eat :: proc(y: move Y, number: int) { _ = y.id; _ = number; }
risky_number :: proc() -> int { panic("risky"); }
remake :: proc(y: move Y) -> Y { return Y{y.id}; }

moved_within_panicking_statement :: proc() -> Status(Err) {
	y := Y{5};
	errdefer fmt.println(y.id);
	eat(move(y), risky_number());
	return .ok;
}

moved_and_assigned_again :: proc() -> Status(Err) {
	y := Y{5};
	errdefer fmt.println(y.id);
	y = remake(move(y));
	return .ok;
}

// An assignment drops its destination's old value after its operands, and a
// `drop` hook may panic there with one of them already moved.
@(move_only) Guard :: struct { id: int, items: [dynamic]int }
impl Guard {
	d :: hook(drop) proc(self: inout Guard) { if (self.id == 1) { panic("drop"); } }
}

moved_before_destination_drop :: proc() {
	g := Guard{id = 1};
	items: [dynamic]int = {};
	defer fmt.println(items.len());
	g, items = Guard{2, move(items)}, {};
}

main :: proc() {}
