package main;
import "core:fmt";

first :: proc(a, b: []int) -> []int { return a; }
second :: proc(a, b: []int) -> []int { return b; }
First :: type_of(first);

wrong_assignment :: proc() {
	f := first;
	f = second;
}
wrong_argument :: proc(f: First) {}
bad_call :: proc() { wrong_argument(second); }
bad_return :: proc() -> First { return second; }
bad_cast :: proc() { f := First(second); }
erased :: proc(f: proc(a, b: []int) -> []int) -> First { return f; }

Inline :: struct { items: [2]int }
impl Inline { view :: proc(self: ^) -> []int { return self.items[:]; } }
wrong_mode :: proc() { f: proc(self: Inline) -> []int = Inline.view; }
write_borrow :: proc(value: ^Inline) { value.items[0] = 9; }
escape :: proc() -> []int {
	value: Inline = {};
	f := Inline.view;
	return f(value);
}
invalidate :: proc() {
	value: Inline = {};
	f := Inline.view;
	view := f(value);
	drop(value);
	fmt.println(view[0]);
}
temporary :: proc() {
	f := Inline.view;
	view := f(Inline{{1, 2}});
	fmt.println(view[0]);
}
main :: proc() {}

Pair :: struct { first, second: []int }
ordered :: proc(a, b: []int) -> Pair { return {a, b}; }
swapped :: proc(a, b: []int) -> Pair { return {b, a}; }
wrong_fields :: proc() { f := ordered; f = swapped; }

destructure :: proc() {
	f := first;
	n := 0;
	f, n = Both{second, 1};
}

false_none :: proc(@(escape=none) value: ^int) -> ^int { return value; }
Second :: type_of(second);
Both :: struct { callback: Second, count: int }

choose_region :: proc(first, second: Allocator) -> Allocator { return first; }
other_region :: proc(first, second: Allocator) -> Allocator { return second; }
wrong_region :: proc() { f := choose_region; f = other_region; }

allocate_first :: proc(first, second: Allocator) -> ^mut int { return new(int, first) or_else nil; }
allocate_second :: proc(first, second: Allocator) -> ^mut int { return new(int, second) or_else nil; }
wrong_allocation_region :: proc() { f := allocate_first; f = allocate_second; }

same :: proc(a, b: []int) -> []int { return a; }
Excluding :: proc(a: []int, @(escape=none) b: []int) -> []int;
joined_outside :: proc(flag: bool) {
	f := first if flag else same;
	f = second;
}
joined_local :: proc(flag: bool, input: []int) -> []int {
	local := [1]int{7};
	f := first if flag else second;
	return f(input, local[:]);
}
wrong_none :: proc() { f: Excluding = second; }
wrong_none_argument :: proc(f: Excluding) {}
bad_none_call :: proc() { wrong_none_argument(first if true else second); }
plain_local :: proc(f: proc(a, b: []int) -> []int, input: []int) -> []int {
	local := [1]int{7};
	return f(input, local[:]);
}
