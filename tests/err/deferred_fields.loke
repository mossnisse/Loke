package main; import "core:fmt";

// Several deferred field types, one diagnostic: the gate is per declaration,
// not per field. `string` and `[]u8` are no longer deferred (M6a step 4), so
// what is left is the managed-container half.
Record :: struct {
	names: [dynamic]string,
	table: map[int]string,
	tag:   []u8,
}

main :: proc() {
	fmt.println(1);
}
