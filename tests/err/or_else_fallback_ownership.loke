package main;

Handle :: move_only struct { id: int }
impl Handle {
	release :: hook(drop) proc(self: inout Handle) {}
}

Outcome :: union @(failure=err) { ok: Handle, err: int }
failed :: proc() -> Outcome { return .err(1); }

main :: proc() {
	fallback := Handle{7};
	_ := failed() or_else fallback;
}
