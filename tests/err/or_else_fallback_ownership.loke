package main;

@(move_only) Handle :: struct { id: int }
impl Handle {
	release :: hook(drop) proc(self: inout Handle) {}
}

@(failure=err) Outcome :: union { ok: Handle, err: int }
failed :: proc() -> Outcome { return .err(1); }

main :: proc() {
	fallback := Handle{7};
	_ := failed() or_else fallback;
}
