package main; import "core:fmt";

positive :: proc(n: int) -> int {
	assert(n > 0, "positive() needs a positive argument, not", n);
	return n;
}

checked :: proc(n: int) -> int {
	if (n < 1) {
		panic("checked() was given nothing to check");
	}
	return n;
}

A :: positive(-1);
B :: checked(0);

main :: proc() {
	fmt.println(A);
	fmt.println(B);
}

// An argument with no scalar spelling prints as `<value>`, whatever it holds.
Holder :: struct { p: ^int }
described :: proc() -> int {
	n := 1;
	assert(false, "bad thing", &n, Holder{&n}, box(3), n);
	return n;
}
C :: described();
