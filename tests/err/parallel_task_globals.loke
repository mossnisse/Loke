// design.md "Globals while tasks run": from a block's first spawn to its join,
// a task does not write a global every thread shares, the parent does not write
// one a running task reserves, and neither reaches through one that stores a
// mutable or erased carrier. A task reserves what it may read or write, and
// every task reserves a global whose borrow outlasts the statement taking it.
package main;

import "core:fmt";
import "core:sync";

hits: int;
values: [1]int;
view: []mut int;
config: [2]int;
config_once: sync.Once;
table: [2]int;
table_view: []int;

setup :: proc() {
	view = &mut values[:];
	table_view = table[:];
}

record_hit :: proc() { hits += 1; }

read_hits :: proc() -> int { return hits; }

watch_hits :: proc(n: int) { _ = hits + n; }

increment :: proc() { view[0] += 1; }

through_helper :: proc() { increment(); }

load_config :: proc() { config[0] = 1; }

use_config :: proc() -> int {
	config_once.do(load_config);
	return config[0];
}

add :: proc(target: []mut int) { target[0] += 1; }

square :: proc(n: int) -> int { return n * n; }

main :: proc() {
	setup();
	parallel { spawn record_hit(); }
	parallel { spawn increment(); }
	parallel { spawn through_helper(); }
	answer: int;
	parallel { spawn answer = use_config(); }
	parallel { spawn add(view); }

	hits = 1;
	local := [2]int{0, 0};
	seen: int;
	parallel {
		spawn add(&mut local[:]);
		hits = 2;                    // no running task reserves `hits`
		spawn seen = read_hits();
		hits = 3;
		record_hit();
		fmt.println(view[0]);
	}

	// A spawn in a loop runs on the next iteration's statements before it.
	parallel {
		foreach (i in 0..<2) {
			hits = i;
			spawn watch_hits(i);
		}
	}

	// `setup` left a view of `table` in `table_view`, where a task may find it.
	squared: int;
	parallel {
		spawn squared = square(2);
		table[0] = 1;
	}
	fmt.println(hits, answer, local[0], seen, squared);
}
