package main;

// design.md "Allocator regions and region provenance": every region a reset
// may reach that is not this body's own needs the `@(allocator_reset)`
// promise. A marked alternative does not cover an allocator another
// parameter carries in an `Option`, the default, or one in another parameter's
// record field.
Holder :: struct { allocator: Allocator }

wrapped :: proc(@(allocator_reset) allowed: Allocator, maybe: Option(Allocator)) {
	switch (maybe) {
	case .some(selected): free_all(selected);
	case .none: free_all(allowed);
	}
}

defaulted :: proc(@(allocator_reset) allowed: Allocator, flag: bool) {
	selected := allowed if flag else Allocator{};
	free_all(selected);
}

field :: proc(@(allocator_reset) allowed: Allocator, h: Holder, flag: bool) {
	selected := allowed if flag else h.allocator;
	free_all(selected);
}

both :: proc(@(allocator_reset) allowed: Allocator, @(allocator_reset) other: Allocator, flag: bool) {
	selected := allowed if flag else other;
	free_all(selected);
}

// `or_else` yields the payload as well as the fallback, so the payload's
// region needs the promise too, unwrapped from the `Option` or from `.as`.
unwrapped :: proc(@(allocator_reset) allowed: Allocator, maybe: Option(Allocator)) {
	selected := maybe or_else allowed;
	free_all(selected);
}

projected :: proc(@(allocator_reset) allowed: Allocator, maybe: Option(Holder)) {
	free_all((maybe or_else Holder{allowed}).allocator);
}

as_variant :: proc(@(allocator_reset) allowed: Allocator, maybe: Option(Allocator)) {
	free_all(maybe.as(.some) or_else allowed);
}

// A payload this body wrote with a marked allocator is covered.
built :: proc(@(allocator_reset) allowed: Allocator, @(allocator_reset) other: Allocator) {
	maybe := Option(Allocator).some(other);
	free_all(maybe or_else allowed);
}

main :: proc() {}
