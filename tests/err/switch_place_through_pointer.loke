// design.md "Switch ownership": a switch over a place reached through a pointer
// borrows the place while a payload binding is in use, as one over a local
// does, so nothing may write the payload through any pointer to it meanwhile.
package main;

Node :: struct { value: int }
Pair :: struct { a: int, b: int }
Value :: union { pair: Pair, none }
Holder :: struct { first: Option(^mut Node), count: int, pair: Value, other: ^mut Node }

clear :: proc(h: ^mut Holder) { h^.first = .none; }
look :: proc(h: ^Holder) -> int { return h^.count; }
set_first :: proc(o: inout Option(^mut Node)) { o = .none; }
bump :: proc(n: inout int) { n += 1; }

stored :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		h^.first = .none;
		return node^.value;
	case .none:
	}
	return 0;
}

called :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		clear(h);
		return node^.value;
	case .none:
	}
	return 0;
}

copied :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		q := h;
		q^.first = .none;
		return node^.value;
	case .none:
	}
	return 0;
}

two_pointers :: proc(p: ^mut ^mut Holder) -> int {
	switch (p^^.first) {
	case .some(node):
		p^^.first = .none;
		return node^.value;
	case .none:
	}
	return 0;
}

// A pointer taken from the binding keeps the place borrowed.
kept_pointer :: proc(p: ^mut ^mut Holder) -> int {
	switch (p^^.first) {
	case .some(node):
		kept := &node;
		p^^.first = .none;
		return kept^^.value;
	case .none:
	}
	return 0;
}

to_local :: proc() -> int {
	n := Node{1};
	m := Node{2};
	held := Holder{.some(&mut n), 0, .none, &mut m};
	h := &mut held;
	switch (h^.first) {
	case .some(node):
		clear(h);
		return node^.value;
	case .none:
	}
	return 0;
}

passed_inout :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		bump(inout h^.count);
		set_first(inout h^.first);
		return node^.value;
	case .none:
	}
	return 0;
}

nested_mutable :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		switch (h^.first) { case .some(&mut m): m = node; case .none: }
		return node^.value;
	case .none:
	}
	return 0;
}

field_binding :: proc(h: ^mut Holder) -> int {
	switch (h^.pair) {
	case .pair(a, _):
		h^.count = a;
		h^.pair = .none;
		return a;
	case .none:
	}
	return 0;
}

// Legal: reads, writes beside the payload, and writes once the binding is done.
beside :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		h^.count += 1;
		bump_pointer(&mut h^.count);
		h^.other^.value = 2;
		switch (h^.first) { case .some(again): node^.value = again^.value; case .none: }
		return look(h) + node^.value;
	case .none:
	}
	return 0;
}

done_first :: proc(h: ^mut Holder) {
	for (i := 0; i < 3; i += 1) {
		switch (h^.first) {
		case .some(node):
			node^.value += i;
			clear(h);
		case .none:
		}
	}
}

repointed :: proc(h: ^mut Holder, other: ^mut Holder) -> int {
	cur := h;
	switch (cur^.first) {
	case .some(node):
		cur = other;
		cur^.first = .none;
		return node^.value;
	case .none:
	}
	return 0;
}

bump_pointer :: proc(n: ^mut int) { n^ += 1; }

// A mutable borrow beside the payload stays beside it when a record carries
// it to the call; the record's other pointers are handed on whole.
Side :: struct { n: ^mut int }
Both :: struct { n: ^mut int, h: ^mut Holder }
bump_side :: proc(s: Side) { s.n^ += 1; }
clear_both :: proc(b: Both) { b.h^.first = .none; }

wrapped_beside :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		bump_side(Side{&mut h^.count});
		return node^.value;
	case .none:
	}
	return 0;
}

wrapped_with_whole :: proc(h: ^mut Holder) -> int {
	switch (h^.first) {
	case .some(node):
		clear_both(Both{&mut h^.count, h});
		return node^.value;
	case .none:
	}
	return 0;
}

// A mutable borrow weakened to a read-only parameter writes nothing, though
// a conditional index walks it through more than one block.
Cells :: struct { first: [2]Option(^mut Node) }
ignore_cell :: proc(p: ^Option(^mut Node)) {}
clear_cell :: proc(p: ^mut Option(^mut Node)) { p^ = .none; }

conditional_weakened :: proc(c: ^mut Cells, flag: bool) -> int {
	switch (c^.first[0]) {
	case .some(node):
		ignore_cell(&mut c^.first[0 if flag else 0]);
		return node^.value;
	case .none:
	}
	return 0;
}

conditional_written :: proc(c: ^mut Cells, flag: bool) -> int {
	switch (c^.first[0]) {
	case .some(node):
		clear_cell(&mut c^.first[0 if flag else 0]);
		return node^.value;
	case .none:
	}
	return 0;
}

// A borrow of another field, taken before the switch or chosen by a
// condition, writes only that field, through itself or a call. A borrow of
// the record holding the payload still conflicts.
Outer :: struct { inner: Holder, total: int }
clear_value :: proc(v: ^mut Value) { v^ = .none; }

stored_beside :: proc(h: ^mut Holder) -> int {
	count := &mut h^.count;
	switch (h^.first) {
	case .some(node):
		count^ = 1;
		bump_pointer(count);
		return node^.value;
	case .none:
	}
	return 0;
}

loaded_beside :: proc(p: ^mut ^mut Holder) -> int {
	switch (p^^.first) {
	case .some(node):
		bump_pointer(&mut p^^.count);
		bump_side(Side{&mut p^^.count});
		return node^.value;
	case .none:
	}
	return 0;
}

chosen_beside :: proc(h: ^mut Holder, flag: bool) -> int {
	switch (h^.first) {
	case .some(node):
		bump_side(Side{&mut h^.count if flag else &mut h^.count});
		return node^.value;
	case .none:
	}
	return 0;
}

stored_payload :: proc(h: ^mut Holder) -> int {
	pair := &mut h^.pair;
	switch (h^.first) {
	case .some(node):
		clear_value(pair);
		return node^.value;
	case .none:
	}
	switch (h^.pair) {
	case .pair(p):
		return p.a;
	case .none:
	}
	return 0;
}

enclosing_payload :: proc(o: ^mut Outer) -> int {
	switch (o^.inner.first) {
	case .some(node):
		clear(&mut o^.inner);
		return node^.value;
	case .none:
	}
	return 0;
}

main :: proc() {}
