package main;

// design.md "Allocator regions and region provenance": borrowed array storage
// retains owners written through its mutable view until their actual cleanup.
fill :: proc(allocator: Allocator, values: []mut [dynamic]int) {
    values[0] = make([dynamic]int, 1, allocator);
}

array_reset :: proc(@(allocator_reset) allocator: Allocator) {
    owners: [1][dynamic]int = {};
    fill(allocator, &mut owners[:]);
    free_all(allocator);
    assert(owners[0].len() == 1);
}

Holder :: struct { output: ^mut [dynamic]int }
fill_holder :: proc(allocator: Allocator, holder: ^Holder) {
    holder.output^ = make([dynamic]int, 1, allocator);
}

stored_pointer_reset :: proc(@(allocator_reset) allocator: Allocator) {
    output: [dynamic]int = {};
    holder := Holder{&mut output};
    pointer := &holder;
    fill_holder(allocator, pointer);
    free_all(allocator);
    assert(output.len() == 1);
}

// design.md "Evaluation order": an erased user-operator result keeps the
// allocator its owner came from while a later argument resets it.
Maker :: struct { allocator: Allocator }
impl Maker {
    get :: operator([]) proc(self, index: int) -> [dynamic]int {
        return make([dynamic]int, 1, self.allocator);
    }
}
reset :: proc(@(allocator_reset) allocator: Allocator) -> int {
    free_all(allocator);
    return 0;
}
show :: proc(value: any_view, code: int) {}

erased_operator_reset :: proc(@(allocator_reset) allocator: Allocator) {
    maker := Maker{allocator};
    show(maker[0], reset(allocator));
}

main :: proc() {}
