package main;

import "core:container";

// The methods a move-only element leaves out, and what a call to one says
// (design.md "where clauses"). Each is a member the instantiation does not
// have, not a body that failed to check.

Token :: move_only struct { @(public) id: int }

Slot :: enum{Only};

main :: proc() {
	a: container.Small_Array(Token, 4) = {};

	// The copying member of `append` is gone; the rest needs a written `move(...)`.
	token := Token{1};
	a.append(token);

	// An iterator whose `next` copies has none for a move-only element.
	tokens := [1]Token{Token{4}};
	foreach (held in Copies(Token){tokens[:]}) { _ = held.id; }

	// `filled` copies one value into every slot.
	seed := Token{2};
	_ = container.Enum_Array(Slot, Token).filled(seed);

	_ = needs_size(Token{3}, Holder(Token){});
}

// An interface requirement asks the same question a call does, so it has to see
// the same member set. A slot matched by a method the bound removed would promise
// a body that was never checked and is never emitted.
Sized :: interface($C, $T: type) {
	slot size: proc(self, value: T) -> int;
}

Copies :: struct($T: type) { items: []T }
Copies_Cursor :: struct($T: type) { items: []T, at: int }

impl Copies($T) {
	Element :: T;
	iter :: proc(self) -> Copies_Cursor(T) { return {self.items, 0}; }
}

impl Copies_Cursor($T) {
	next :: proc(self: inout) -> Option(T) where is_copyable(T) {
		if (self.at >= self.items.len()) { return .none; }
		self.at += 1;
		return .some(self.items[self.at - 1]);
	}
}

Holder :: struct($T: type) { }

impl Holder($T) {
	size :: proc(self, value: T) -> int where is_copyable(T) { return 1; }
}

needs_size :: proc(value: $T, holder: $C) -> int where Sized(C, T) {
	return holder.size(value);
}
