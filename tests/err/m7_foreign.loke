package main;

// design.md "Foreign system": a foreign procedure has no body,
// a foreign global has no initializer, `@(by_ptr)` is foreign-only, `@(c_vararg)`
// marks the final variadic parameter, and a C-variadic call cannot spread.
//
// A `move` parameter and a generic member are rejected for the same reason: a C
// call acquires no cleanup responsibility, and a template has no ABI until it is
// instantiated. The generic one reports only L0624 — the convention it inherited
// from the block is not a second mistake.

Res :: struct { v: int }

foreign import libc "system:legacy_stdio_definitions.lib";

foreign libc {
	with_body :: proc "c" () { }
	bad_global: i32 = 5;
	misplaced_va :: proc "c" (@(c_vararg) a: ..any_view, trailing: i32) ---;
	printf :: proc "c" (fmt: cstring_view, @(c_vararg) args: ..any_view) -> i32 ---;
	moved :: proc "c" (v: move Res) ---;
	generic_one :: proc "c" ($T: type, v: T) -> T ---;
	typed_va :: proc "c" (@(c_vararg) a: ..int) ---;
}

not_foreign :: proc(@(by_ptr) x: i32) { }

main :: proc() {
	nums: [3]i32 = [3]i32{ 1, 2, 3 };
	printf("%d", ..nums);
}
