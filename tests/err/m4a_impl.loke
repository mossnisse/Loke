package main; import "core:fmt";

Complex :: struct { real, imaginary: f64 }
Point :: struct { x: int }

impl Complex {
	from_scalar :: hook(convert) proc(value: f64) -> Complex { return {value, 0}; }

	// `init` is an ordinary member, so this return type has no special meaning.
	init_wrong :: proc(v: int) -> int { return v; }

	// `^T` keeps the name but is not a receiver.
	bump :: proc(self: ^mut Complex) { self.real = self.real + 1.0; }

	length :: proc(self) -> f64 { return self.real; }
	grow :: proc(self: inout Complex) { self.real = self.real + 1.0; }

	// An `impl` member is a constant, a procedure, or an associated type.
	counter: int;

	// One type cannot have two members of one name.
	length :: proc(self, extra: int) -> f64 { return self.real; }
}

// A union with no `@(zero=)` has no zero value, so a declaration with no
// initialiser has nothing to start at.
Maybe :: union { number: int, nothing: }
global: Maybe;

// `self` is only a receiver inside an `impl` or `extend` block.
loose :: proc(self) -> int { return 1; }

loose_conversion :: hook(convert) proc(value: i32) -> Complex { return {f64(value), 0}; }

CONST :: Complex{1.0, 0.0};

magnitude :: proc(z: Complex) -> f64 { return z.real; }

main :: proc() {
	// A conversion hook is never applied without being written.
	scale: f64 = 5.0;
	fmt.println(int(magnitude(scale)));

	z := Complex(1.0);
	// Hook implementations are invoked through conversion syntax, not as methods.
	direct := Complex.from_scalar(1.0);
	hook_value := Complex.from_scalar;
	// No method sugar for a pointer parameter.
	z.bump();
	// A mutating receiver needs a mutable place.
	CONST.grow();
	// A method must be called.
	f := z.length;
	// A type conversion takes exactly one argument; construction uses `{}`.
	p := Point(1, 2);
	// `Complex` has no member `magnitude`.
	q := Complex.magnitude;
	fmt.println(take_ambiguous(Ambiguous(1)));
}

Ambiguous :: struct { value: int }

impl Ambiguous {
	from_i8 :: hook(convert) proc(value: i8) -> Ambiguous { return {int(value)}; }
	from_i16 :: hook(convert) proc(value: i16) -> Ambiguous { return {int(value)}; }
}

Builtin_Wrapped :: distinct i32;

impl Builtin_Wrapped {
	// The built-in i32 -> distinct conversion is non-overridable.
	bad_builtin_pair :: hook(convert) proc(value: i32) -> Builtin_Wrapped {
		return Builtin_Wrapped(value);
	}
}

take_ambiguous :: proc(value: Ambiguous) -> int { return value.value; }

// An associated member is reached through its owner. An unqualified use of one
// is an unknown type, not a construct a later milestone implements.
Ratio :: struct { n: int }

impl Ratio {
	Element :: int;
	widen :: proc(self) -> Element { return self.n; }
}
