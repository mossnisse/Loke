package main; import "core:fmt";

Complex :: struct { real, imaginary: f64 }
Point :: struct { x: int }

impl Complex {
	@(implicit)
	from_scalar :: proc(value: f64) -> Complex { return {value, 0}; }

	// An `init` overload has to produce the type it constructs.
	init_wrong :: proc(v: int) -> int { return v; }
	init :: proc{from_scalar, init_wrong};

	// `^T` keeps the name but is not a receiver.
	bump :: proc(self: ^Complex) { self.real = self.real + 1.0; }

	length :: proc(self) -> f64 { return self.real; }
	grow :: proc(self: inout Complex) { self.real = self.real + 1.0; }

	// `@(implicit)` needs a built-in parameter type.
	@(implicit)
	from_point :: proc(p: Point) -> Complex { return {0, 0}; }

	// A correctly shaped annotated procedure still has to belong to `init`.
	@(implicit)
	orphan_scalar :: proc(value: i32) -> Complex { return {f64(value), 0}; }

	// An `impl` member is a constant, a procedure, or an associated type.
	counter: int;

	// One type cannot have two members of one name.
	length :: proc(self, extra: int) -> f64 { return self.real; }
}

// A file-scope union starts at nil, because writing its tag needs code.
Maybe :: union { int }
global: Maybe = 3;

// `self` is only a receiver inside an `impl` or `extend` block.
loose :: proc(self) -> int { return 1; }

CONST :: Complex{1.0, 0.0};

magnitude :: proc(z: Complex) -> f64 { return z.real; }

main :: proc() {
	// `@(implicit)` is reachable only from an untyped constant.
	scale: f64 = 5.0;
	fmt.println(int(magnitude(scale)));

	z := Complex(1.0);
	// No method sugar for a pointer parameter.
	z.bump();
	// A mutating receiver needs a mutable place.
	CONST.grow();
	// A method must be called.
	f := z.length;
	// `Point` has no `init`.
	p := Point(1, 2);
	// `Complex` has no member `magnitude`.
	q := Complex.magnitude;
	fmt.println(take_ambiguous(1));
}

Ambiguous :: struct { value: int }

impl Ambiguous {
	@(implicit)
	from_i8 :: proc(value: i8) -> Ambiguous { return {int(value)}; }
	@(implicit)
	from_i16 :: proc(value: i16) -> Ambiguous { return {int(value)}; }
	init :: proc{from_i8, from_i16};
}

take_ambiguous :: proc(value: Ambiguous) -> int { return value.value; }

// An associated member is reached through its owner. An unqualified use of one
// is an unknown type, not a construct a later milestone implements.
Ratio :: struct { n: int }

impl Ratio {
	Element :: int;
	widen :: proc(self) -> Element { return self.n; }
}
