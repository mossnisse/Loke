package main; import "core:fmt";

// design.md "Generic types": between two blocks that both apply, the more
// specialized supplies a member (tie-breaker 5). Two equal patterns declare the
// member twice; crossed ones make a call ambiguous. Neither is a silent
// first-wins.
Box :: struct($T: type) { v: T }
impl Box($T) { get :: proc(self) -> int { return 1; } }
impl Box($T) { get :: proc(self) -> int { return 2; } }

Pair :: struct($A, $B: type) { a: A, b: B }
impl Pair($A, int) { which :: proc(self) -> int { return 1; } }
impl Pair(int, $B) { which :: proc(self) -> int { return 2; } }
impl Pair($T, $T) { same :: proc(self) -> T { return self.a; } }

// First reached by a probe that rolls its errors back; the use still reports.
Bad :: struct($T: type) { a: [size_of(T) - 2]int }
wrap :: proc(x: $T) -> Bad(T) { return {}; }
keep :: proc(x: u8) -> int { return 2; }
pick :: proc{wrap, keep};

main :: proc() {
	b: Box(int) = {5};
	fmt.println(b.get());
	p: Pair(int, int) = {1, 2};
	fmt.println(p.which());
	q: Pair(int, f64) = {1, 2.5};
	fmt.println(q.same());
	fmt.println(pick(u8(1)));
	y: Bad(u8) = {};
}
