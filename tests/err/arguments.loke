package main;

takes_two :: proc(a: int, b: int) -> int {
	return a + b;
}

aliased :: proc(value: inout int) {
	value = 1;
}

// A default may only reference parameters to its left.
backwards :: proc(a: int = b, b: int = 1) -> int {
	return a + b;
}

main :: proc() {
	print_int(takes_two(1));
	print_int(takes_two(1, 2, 3));
	print_int(takes_two(missing = 1, b = 2));
	print_int(takes_two(a = 1, 2));

	n := 1;
	aliased(n);
	aliased(inout 5);
	print_int(takes_two(inout n, 2));
	print_int(backwards());
}
