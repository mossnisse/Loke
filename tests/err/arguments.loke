package main; import "core:fmt";

takes_two :: proc(a: int, b: int) -> int {
	return a + b;
}

aliased :: proc(value: inout int) {
	value = 1;
}

// A default may only reference parameters to its left.
backwards :: proc(a: int = b, b: int = 1) -> int {
	return a + b;
}

main :: proc() {
	fmt.println(takes_two(1));
	fmt.println(takes_two(1, 2, 3));
	fmt.println(takes_two(missing = 1, b = 2));
	fmt.println(takes_two(a = 1, 2));

	n := 1;
	aliased(n);
	aliased(inout 5);
	fmt.println(takes_two(inout n, 2));
	fmt.println(backwards());
}
