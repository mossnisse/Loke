package main; import "core:fmt";

// design.md "Copy-cost diagnostics" (m5a-plan step 5). "A copy site is a point
// that duplicates a value instead of moving or borrowing it": a trivial
// aggregate copied into a `value: T` parameter, a binding, an assignment, the
// return of a borrowed managed owner by value, a place operand of `or_else` or
// `or_return`, which copies a payload out and leaves the source live, and a
// by-value `foreach` over a place, which copies one element per step.
//
// Compiled with `-copy-cost=1`, so every real copy site reports and the ones
// that are not copy sites still stay quiet — `_ = place` writes to nothing and
// is not one. At the default threshold only the allocating clones report,
// because a clone is expensive whatever its inline size while 16 bytes is not.
//
// design.md also asks that an ABI hidden-pointer transport not be mistaken for a
// semantic copy. M5a has no such transport — an aggregate argument travels as an
// LLVM value — so there is nothing here to distinguish it from yet; the
// receiver/aggregate ABI arrives with M7.

Pair :: struct { a: int, b: int }

Res :: struct { id: int }

impl Res {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Res, Allocator_Error) {
		return .ok(Res{self.id});
	}

	release :: hook(drop) proc(self: inout Res) { self.id = 0; }
}

Only :: move_only struct { id: int }

impl Only {
	release :: hook(drop) proc(self: inout Only) { self.id = 0; }
}

// A trivial aggregate parameter is a copy site.
inspect :: proc(value: Pair) -> int { return value.a; }

// A managed one is a borrow, and is not.
borrows :: proc(value: Res) -> int { return value.id; }

// A scalar is not an aggregate, so its size is never the point.
counts :: proc(value: int) -> int { return value; }

// Returning a borrowed managed owner clones.
give_back :: proc(value: Res) -> Res { return value; }

// design.md: "returning a borrowed value whose clone operation is disabled is a
// compile-time error." Size stays out of type correctness; this does not.
refuse :: proc(value: Only) -> Only { return value; }

main :: proc() {
	pair := Pair{1, 2};
	res := Res{3};
	count := 4;

	// A copy site: a place duplicated into a trivial aggregate parameter.
	fmt.println(inspect(pair));
	// Not copy sites: a managed borrow, a scalar, and a temporary.
	fmt.println(borrows(res));
	fmt.println(counts(count));
	fmt.println(inspect(Pair{5, 6}));

	// A binding and an assignment from a place.
	copied := pair;
	cloned := res;
	copied = pair;

	// A temporary transfers rather than duplicating.
	fresh := Pair{7, 8};

	fmt.println(give_back(res).id);

	// The cost is more prominent inside a loop.
	for (i := 0; i < 2; i += 1) {
		looped := pair;
	}

	// `_ = place` writes to nothing, so it is not a copy site: a clone here
	// would allocate a value the discard has no destination for and never
	// drops. A discarded temporary still transfers, and is dropped as usual.
	_ = pair;
	_ = res;
	_ = Res{9};

	// design.md "Operator ownership": a place operand leaves the source live and
	// copies a payload out of it, so a failure operator over one is a copy site.
	maybe: Option(Res) = .some(Res{8});
	unwrapped := maybe or_else Res{0};
	_ = unwrapped;

	// design.md "Borrowing iteration": traversing a place lends each element, so
	// no form of the loop is a copy site -- not the plain one and not `&item`.
	// Copying an element is written, and reports as the binding it is rather
	// than as the loop.
	items := [dynamic]Res{};
	foreach (item in items) { fmt.println(item.id); }
	foreach (&item in items) { fmt.println(item.id); }
	foreach (item in items) { saved := item; fmt.println(saved.id); }
	_ = items;
}

relay :: proc() -> Result(Res, int) {
	outcome: Result(Res, int) = .ok(Res{9});
	taken := outcome or_return;
	return .ok(taken);
}

// The sites that reach a value from inside a larger expression. Each is the
// ownership rule copying a place, exactly as a binding is, but written as
// construction -- which is what makes it the easiest copy to miss. The
// aggregate literal and the variant payload are reported above, inside `Res`'s
// own copy hook and in `relay`; these are the rest.
Holder :: struct { values: [dynamic]int }

pack :: proc(items: ..[dynamic]int) -> int { return items.len(); }

expression_sites :: proc() {
	big: [dynamic]int = {};

	held := Holder{big};                 // aggregate literal element
	_ = pack(big);                       // variadic pack element

	store: [dynamic][dynamic]int = {};
	store.insert(0, big);                // container insertion

	absent: Option([dynamic]int) = .none;
	picked := absent or_else big;        // `or_else` fallback

	// Not a copy: erasing into an `any_view` borrows what it points at, so the
	// destination's own size is not a duplication of `big`.
	fmt.println(held.values.len(), store.len(), picked.len(), big.len());
}
