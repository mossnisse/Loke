package main;

Res :: struct { id: int }

impl Res {
	release :: hook(drop) proc(self: inout Res) { self.id = 0; }
}

take :: proc(value: move Res) {}
lend :: proc(value: inout Res) -> inout Res { return inout value; }

main :: proc() {
	held := Res{7};
	p := &mut held;
	take(p^);
	callback: proc(value: move Res) = take;
	callback(p^);
	other := Res{8};
	take(lend(inout other));
}
