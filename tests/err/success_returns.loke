// design.md "Success returns": only the success is built implicitly. An
// implicit selector names a variant of the result, `nil` is never wrapped, a
// result naming a generic argument with a failure payload is never wrapped in
// any instance, and `return;` needs a success that carries nothing.
package main;

Parse_Error :: enum { Bad_Digit, Empty }
Color :: enum { Red, Green }
Connection :: move_only struct { id: int }

selector :: proc() -> Result(int, Parse_Error) {
	return .Bad_Digit;
}

payload_member :: proc() -> Result(Color, Parse_Error) {
	return .Red;
}

error_value :: proc(e: Parse_Error) -> Result(int, Parse_Error) {
	return e;
}

neither :: proc(s: string_view) -> Result(int, Parse_Error) {
	return s;
}

absent :: proc() -> Option(rawptr) {
	return nil;
}

absent_reference :: proc() -> Option(^int) {
	return nil;
}

generic_error :: proc(value: $T, error: $E) -> Result(T, E) {
	return error;
}

generic_value :: proc(value: $T, error: $E) -> Result(T, E) {
	return value;
}

unit :: proc() -> Result(Unit, Parse_Error) {
	return;
}

status_value :: proc(e: Parse_Error) -> Status(Parse_Error) {
	return e;
}

// The binding is inside the array length, an expression.
generic_length :: proc($N: int, error: [2]int) -> Result([N + 1]int, [2]int) {
	return error;
}

// A `$` name in the result is a generic argument too.
generic_dollar :: proc(value: $T, error: $E) -> Result($T, $E) {
	return error;
}

// An inline definition depends on `T` through what is written inside it.
generic_inline :: proc(value: $T, error: [2]int) -> Result([size_of(union { a: T, b: u8 })]u8, [2]int) {
	return error;
}

// So does a binding only in an inline definition's attribute. The instances
// below make both payloads `[16]u8`.
generic_attribute :: proc($N: int, error: [16]u8) -> Result([size_of(union @(align=N) { a: u8, b: u8 })]u8, [16]u8) {
	return error;
}

generic_attribute_type :: proc(value: $T, error: [16]u8) -> Result([size_of(union @(align=align_of(T)) { a: u8, b: u8 })]u8, [16]u8) {
	return error;
}

borrowed :: proc(c: Connection) -> Option(Connection) {
	return c;
}

escape :: proc() -> Option(string_view) {
	s := "local".copy();
	return s;
}

main :: proc() {
	_ = generic_error(1, 2);
	_ = generic_value(1, "x");
	_ = generic_length(1, [2]int{});
	_ = generic_dollar(1, 2);
	_ = generic_inline(1, [2]int{});
	_ = generic_attribute(8, [16]u8{});
	_ = generic_attribute_type(1, [16]u8{});
}
