// design.md "Weakening and reborrows": a borrow of a place reached through a
// pointer reborrows the pointer, and each pointer loaded on the way, for that
// place only, so other fields stay usable beside it. Copying the pointer, or
// passing it to a procedure, uses all of what it points to.
package main;

Node :: struct { value: int }
Holder :: struct { count: int, total: int, other: ^mut Node, items: [dynamic]int, cells: [2]int }
Wide :: struct { a: int, b: int, c: int, d: int, e: int, z: int }
Sides :: struct { left: Wide, right: Wide, z: int }

look :: proc(h: ^Holder) -> int { return h^.total; }
peek :: proc(n: ^int) -> int { return n^; }
touch :: proc(h: ^mut Holder) { h^.total += 1; }
add :: proc(to: ^mut int, n: int) { to^ += n; }
add_from :: proc(to: ^mut int, from: ^mut int) { to^ += from^; }

same_field :: proc(h: ^mut Holder) -> int {
	count := &h^.count;
	h^.count = 2;
	return count^;
}

read_beside_mutable :: proc(h: ^mut Holder) {
	count := &mut h^.count;
	n := h^.count;
	count^ = n;
}

call_beside_mutable :: proc(h: ^mut Holder) {
	count := &mut h^.count;
	n := look(h);
	count^ = n;
}

call_may_write :: proc(h: ^mut Holder) -> int {
	count := &h^.count;
	touch(h);
	return count^;
}

copied :: proc(h: ^mut Holder) -> int {
	count := &h^.count;
	q := h;
	q^.total = 2;
	return count^;
}

whole :: proc(h: ^mut Holder) -> int {
	count := &h^.count;
	all := &mut h^;
	all^.total = 2;
	return count^;
}

two_pointers :: proc(p: ^mut ^mut Holder) -> int {
	count := &p^^.count;
	p^^.count = 2;
	return count^;
}

loaded_copy :: proc(p: ^mut ^mut Holder) -> int {
	count := &p^^.count;
	q := p^;
	q^.total = 2;
	return count^;
}

sliced :: proc(h: ^mut Holder) -> int {
	items := h^.items[:];
	h^.items.append(1);
	return items[0];
}

dynamic_index :: proc(h: ^mut Holder, i: int) {
	cell := &mut h^.cells[0];
	h^.cells[i] = 2;
	cell^ = 1;
}

compound :: proc(h: ^mut Holder) -> int {
	count := &h^.count;
	h^.count += 1;
	return count^;
}

read_only_copy_then_write :: proc(p: ^mut ^mut Holder) -> int {
	held: ^Holder = p^;
	p^^.count = 2;
	return held^.count;
}

replaced_during_traversal :: proc(h: ^mut Holder) {
	foreach (item in h^.items) {
		h^.items = [dynamic]int{item};
	}
}

argument_twice :: proc(h: ^mut Holder) {
	add_from(&mut h^.count, &mut h^.count);
}

argument_written :: proc(h: ^mut Holder) {
	add(&mut h^.count, bump_index(&mut h^.count));
}

// A weakened mutable borrow only reads the carriers it goes through, not what
// a call in its index writes.
bump_index :: proc(q: ^mut int) -> int { q^ += 1; return 0; }

weakened_index_call :: proc(h: ^mut Holder, q: ^mut int) -> int {
	held := &q^;
	value := peek(&mut h^.cells[bump_index(q)]);
	return held^ + value;
}

weakened_conditional_index_call :: proc(h: ^mut Holder, q: ^mut int, flag: bool) -> int {
	held := &q^;
	value := peek(&mut h^.cells[0 if flag else bump_index(q)]);
	return held^ + value;
}

weakened_carrier_index_call :: proc(h: ^mut Holder, q: ^mut int) -> int {
	both := [1]^mut Holder{h};
	held := &q^;
	value := peek(&mut both[bump_index(q)]^.count);
	return held^ + value;
}

// A pointer chosen between borrows of two fields may point at either.
chosen_written :: proc(h: ^mut Holder, flag: bool) -> int {
	count := &mut h^.count;
	total := &mut h^.total;
	q := count if flag else total;
	value := &q^;
	h^.total = 1;
	return value^;
}

chosen_read :: proc(h: ^mut Holder, flag: bool) -> int {
	count := &mut h^.count;
	if (flag) { count = &mut h^.total; }
	value := &mut count^;
	total := look(h);
	value^ = 1;
	return total;
}

// Past the eight places the specification guarantees, those sharing the
// longest prefix are taken as it: the pointer may point at all of `left`, but
// only at four fields of `right`, so the conflict at `s^.left.z` names the
// limit and says the reborrow may cover it (design.md "Minimum provenance
// precision").
chosen_past_limit :: proc(s: ^mut Sides, i: int) -> int {
	q := &mut s^.left.a;
	if (i == 1) { q = &mut s^.left.b; }
	if (i == 2) { q = &mut s^.left.c; }
	if (i == 3) { q = &mut s^.left.d; }
	if (i == 4) { q = &mut s^.left.e; }
	if (i == 5) { q = &mut s^.right.a; }
	if (i == 6) { q = &mut s^.right.b; }
	if (i == 7) { q = &mut s^.right.c; }
	if (i == 8) { q = &mut s^.right.d; }
	value := &q^;
	s^.z = 1;
	s^.right.e = 2;
	s^.left.z = 3;
	return value^;
}

// Places of another storage do not lift the limit for one: a ninth place of
// `s` merges `left` as above, while `t^.right.e` stays usable.
chosen_past_limit_of_one :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	q := &mut s^.left.a;
	if (i == 1) { q = &mut s^.left.b; }
	if (i == 2) { q = &mut s^.left.c; }
	if (i == 3) { q = &mut s^.left.d; }
	if (i == 4) { q = &mut s^.left.e; }
	if (i == 5) { q = &mut s^.right.a; }
	if (i == 6) { q = &mut s^.right.b; }
	if (i == 7) { q = &mut s^.right.c; }
	if (i == 8) { q = &mut s^.right.d; }
	if (i == 9) { q = &mut t^.right.a; }
	value := &q^;
	t^.right.e = 1;
	s^.left.z = 2;
	return value^;
}

// A pointer that may point into `s` or `t` is taken to point at each of its
// places in both, so `t^.left.a` may be the place it points at.
chosen_from_other_storage :: proc(s: ^mut Sides, t: ^mut Sides, flag: bool) -> int {
	q := &mut s^.left.a;
	if (flag) { q = &mut t^.left.e; }
	value := &q^;
	t^.left.b = 1;
	t^.left.a = 2;
	return value^;
}

// A carrier repointed between choices points into the storage it names where
// each place is taken (design.md "Minimum provenance precision"). Repointed
// on one path only, it may point into either where the later places are
// taken, so they count against both: nine of `s`.
chosen_repointed_on_one_path :: proc(s: ^mut Sides, t: ^mut Sides, flag: bool, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	if (flag) { p = t; }
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	s^.right.z = 1;
	s^.left.z = 2;
	return value^;
}

// Nine places of `t` taken after the carrier is repointed to it merge as
// nine of `s` would.
chosen_repointed_past_limit :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	p = t;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	if (i == 9) { q = &mut p^.right.e; }
	value := &q^;
	t^.right.z = 1;
	t^.left.z = 2;
	return value^;
}

// Within the limits, each place taken is one the pointer may point at: one
// of `t` taken after the carrier was repointed, one of `s` taken before, and,
// as in either storage, one of `t` in `s`.
chosen_repointed_conflicts :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	p = t;
	if (i == 2) { q = &mut p^.right.a; }
	value := &q^;
	t^.right.a = 1;
	s^.left.b = 2;
	s^.right.a = 3;
	return value^;
}

// Legal: other fields, read-only borrows beside each other, and uses after
// the borrow is done.
beside :: proc(h: ^mut Holder) -> int {
	count := &mut h^.count;
	h^.total += 1;
	total := &mut h^.total;
	total^ += 1;
	h^.other^.value = 2;
	cell := &mut h^.cells[0];
	h^.cells[1] = 3;
	cell^ = h^.cells[1];
	count^ += h^.total;
	return h^.count;
}

beside_read_only :: proc(h: ^mut Holder) -> int {
	count := &h^.count;
	again := &h^.count;
	h^.total = look(h) + count^;
	return again^;
}

beside_slice :: proc(h: ^mut Holder) -> int {
	items := h^.items[:];
	h^.count += 1;
	return items[0] + h^.count;
}

two_pointers_beside :: proc(p: ^mut ^mut Holder) -> int {
	count := &mut p^^.count;
	p^^.total = 2;
	p^^.other^.value = 3;
	count^ += 1;
	return p^^.count;
}

three_pointers_beside :: proc(p: ^mut ^mut ^mut Holder) -> int {
	count := &mut p^^^.count;
	p^^^.total = 2;
	count^ += 1;
	return p^^^.count;
}

arguments_beside :: proc(h: ^mut Holder) {
	add(&mut h^.count, h^.total);
	add_from(&mut h^.count, &mut h^.total);
}

compound_beside :: proc(h: ^mut Holder) -> int {
	count := &h^.count;
	h^.total += 1;
	return count^;
}

// A mutable borrow weakened to a read-only parameter only reads, as one of a
// local does, and so does a pointer copied out to a read-only destination.
weakened :: proc(h: ^mut Holder, p: ^mut ^mut Holder) -> int {
	count := &h^.count;
	inner := &p^^.count;
	return peek(&mut h^.count) + peek(&mut p^^.count) + count^ + inner^;
}

conditional_weakened :: proc(h: ^mut Holder, flag: bool) -> int {
	cell := &h^.cells[0];
	return peek(&mut h^.cells[0 if flag else 1]) + cell^;
}

indexed_carrier_weakened :: proc(h: ^mut Holder) -> int {
	both := [1]^mut Holder{h};
	count := &both[0]^.count;
	return peek(&mut both[0]^.count) + count^;
}

read_only_copies :: proc(p: ^mut ^mut Holder) -> int {
	count := &p^^.count;
	held: ^Holder = p^;
	again: ^Holder = p^;
	return look(p^) + held^.count + again^.total + count^;
}

// A traversal of one field leaves the others usable.
traversal_beside :: proc(h: ^mut Holder) {
	foreach (item in h^.items) {
		h^.count = item;
		h^.total += item;
	}
	foreach (&mut item in h^.items) {
		item += h^.count;
	}
}

local_beside :: proc() -> int {
	n := Node{1};
	held := Holder{0, 0, &mut n, [dynamic]int{}, [2]int{}};
	h := &mut held;
	count := &mut h^.count;
	h^.total = 2;
	count^ = 3;
	return held.count;
}

// A pointer chosen between borrows of two fields points at one of them, so
// the other fields stay usable beside a borrow through it.
chosen_beside :: proc(h: ^mut Holder, flag: bool) -> int {
	count := &mut h^.count;
	total := &mut h^.total;
	q := count if flag else total;
	value := &mut q^;
	h^.cells[0] = 1;
	h^.other^.value = 2;
	value^ = 3;
	return peek(&mut q^) + h^.cells[0];
}

assigned_beside :: proc(h: ^mut Holder, flag: bool) -> int {
	q := &mut h^.count;
	if (flag) { q = &mut h^.total; }
	value := &q^;
	h^.cells[0] = 1;
	return value^;
}

chosen_among_five :: proc(w: ^mut Wide, x: bool, y: bool, u: bool, v: bool) -> int {
	a := &mut w^.a;
	b := &mut w^.b;
	c := &mut w^.c;
	d := &mut w^.d;
	e := &mut w^.e;
	q := a if x else b if y else c if u else d if v else e;
	value := &q^;
	w^.z = 1;
	return value^;
}

// Eight places, the most a pointer is guaranteed to keep apart, leave every
// other field usable (design.md "Minimum provenance precision").
chosen_at_limit :: proc(s: ^mut Sides, i: int) -> int {
	q := &mut s^.left.a;
	if (i == 1) { q = &mut s^.left.b; }
	if (i == 2) { q = &mut s^.left.c; }
	if (i == 3) { q = &mut s^.left.d; }
	if (i == 4) { q = &mut s^.left.e; }
	if (i == 5) { q = &mut s^.right.a; }
	if (i == 6) { q = &mut s^.right.b; }
	if (i == 7) { q = &mut s^.right.c; }
	value := &q^;
	s^.z = 1;
	s^.left.z = 2;
	s^.right.d = 3;
	s^.right.e = 4;
	s^.right.z = 5;
	return value^;
}

// The guarantee is for each storage: eight places of `s` and eight of `t`
// leave every other field of both usable.
chosen_at_limit_of_each :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	q := &mut s^.left.a;
	if (i == 1) { q = &mut s^.left.b; }
	if (i == 2) { q = &mut s^.left.c; }
	if (i == 3) { q = &mut s^.left.d; }
	if (i == 4) { q = &mut s^.left.e; }
	if (i == 5) { q = &mut s^.right.a; }
	if (i == 6) { q = &mut s^.right.b; }
	if (i == 7) { q = &mut s^.right.c; }
	if (i == 8) { q = &mut t^.left.a; }
	if (i == 9) { q = &mut t^.left.b; }
	if (i == 10) { q = &mut t^.left.c; }
	if (i == 11) { q = &mut t^.left.d; }
	if (i == 12) { q = &mut t^.left.e; }
	if (i == 13) { q = &mut t^.right.a; }
	if (i == 14) { q = &mut t^.right.b; }
	if (i == 15) { q = &mut t^.right.c; }
	value := &q^;
	s^.z = 1;
	s^.left.z = 2;
	s^.right.d = 3;
	t^.z = 4;
	t^.left.z = 5;
	t^.right.e = 6;
	return value^;
}

// Four places of `s` and five of `t` are each within the guarantee, so a
// field of either that the pointer cannot point at stays usable.
chosen_across_storages :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	q := &mut s^.left.a;
	if (i == 1) { q = &mut s^.left.b; }
	if (i == 2) { q = &mut s^.left.c; }
	if (i == 3) { q = &mut s^.left.d; }
	if (i == 4) { q = &mut t^.left.e; }
	if (i == 5) { q = &mut t^.right.a; }
	if (i == 6) { q = &mut t^.right.b; }
	if (i == 7) { q = &mut t^.right.c; }
	if (i == 8) { q = &mut t^.right.d; }
	value := &q^;
	s^.left.z = 1;
	t^.left.z = 2;
	return value^;
}

// The places a carrier repointed between choices takes count against the
// storage it names where each is taken: four of `s` and five of `t`.
chosen_repointed_between :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	p = t;
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	s^.left.z = 1;
	s^.right.e = 2;
	t^.left.z = 3;
	t^.z = 4;
	return value^;
}

// design.md "Minimum provenance precision": no number of definitions of `p`,
// or of blocks between them, costs a place of `s` its storage's eight. Legal.
chosen_past_redefinitions :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	p = t;
	foreach ($repeat in 0 ..< 200) { p = t; }
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	s^.left.z = 1;
	return value^;
}

chosen_past_definitions_in_branches :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	p = t;
	foreach ($repeat in 0 ..< 200) { if (i < 0) { p = t; } }
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	s^.left.z = 1;
	return value^;
}

chosen_past_branches :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	p = t;
	foreach ($repeat in 0 ..< 200) { if (i < 0) {} }
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	s^.left.z = 1;
	return value^;
}

chosen_past_loops :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	p = t;
	foreach ($repeat in 0 ..< 300) {
		for (j := 0; j < i; j += 1) {
			if (j == 1) { continue; }
			if (j == 2) { break; }
		}
	}
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	s^.left.z = 1;
	return value^;
}

// However many definitions and blocks lie between, what may reach still counts.
// Repointed on one path, `p` may still be `s`, so `s` has nine places.
chosen_past_branches_repointed_on_one_path :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	foreach ($repeat in 0 ..< 200) { if (i < 0) {} }
	if (i == 9) { p = t; }
	foreach ($repeat in 0 ..< 200) { if (i < 0) {} }
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	s^.left.z = 1;
	return value^;
}

// Nine places of `t` are past its eight, whatever came before them.
chosen_past_branches_nine_of_one :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	p = t;
	foreach ($repeat in 0 ..< 200) { if (i < 0) { p = t; } }
	q = &mut p^.left.a;
	if (i == 1) { q = &mut p^.left.b; }
	if (i == 2) { q = &mut p^.left.c; }
	if (i == 3) { q = &mut p^.left.d; }
	if (i == 4) { q = &mut p^.left.e; }
	if (i == 5) { q = &mut p^.right.a; }
	if (i == 6) { q = &mut p^.right.b; }
	if (i == 7) { q = &mut p^.right.c; }
	if (i == 8) { q = &mut p^.right.d; }
	value := &q^;
	t^.left.z = 1;
	return value^;
}

// A place taken after the repointing is still a place of what `p` then names.
chosen_past_redefinitions_conflicts :: proc(s: ^mut Sides, t: ^mut Sides, i: int) -> int {
	p := s;
	q := &mut p^.left.a;
	p = t;
	foreach ($repeat in 0 ..< 200) { if (i < 0) { p = t; } }
	if (i == 1) { q = &mut p^.right.a; }
	value := &q^;
	t^.right.a = 1;
	s^.left.a = 2;
	return value^;
}

// Past the places told apart, `p` takes what every definition may point at, and
// the field beside them stays apart.
Many :: struct { xs: [130]int, z: int }

chosen_past_tellable_places :: proc(s: ^mut Many, t: ^mut Many, i: int) -> int {
	p := &mut s^.xs[0];
	foreach ($k in 0 ..< 130) { if (i == k) { p = &mut s^.xs[k]; } }
	foreach ($k in 0 ..< 130) { if (i == k) { p = &mut t^.xs[k]; } }
	value := &p^;
	s^.xs[1] = 1;
	s^.z = 2;
	return value^;
}

main :: proc() {}
