// design.md "Iteration adapters": an adapter's view keeps its own copy of a mutable view,
// which is reported as any other copy is (compiler-guide.md "Copy-cost diagnostics"): a clone that
// may allocate whatever its size, and any other by its bytes. A loop that takes the adapter
// apart makes no view, and copies nothing. `copied()` borrows its source, so it copies
// nothing however it is used.
package main;

Cursor :: struct { at: int }
impl Cursor { next :: proc(self: inout Cursor) -> Option(^mut int) { return .none; } }
Owning :: struct { owned: [dynamic]int }
impl Owning {
	Element :: int;
	Iterator :: Cursor;
	Mut_Iterator :: Cursor;
	iter :: proc(self) -> Cursor { return {0}; }
	iter_mut :: proc(self) -> Cursor { return {0}; }
}
Large :: struct { bytes: [1024]u8, label: string }
impl Large {
	Element :: int;
	Iterator :: Cursor;
	Mut_Iterator :: Cursor;
	iter :: proc(self: ^) -> Cursor { return {0}; }
	iter_mut :: proc(self) -> Cursor { return {0}; }
}
Plain :: struct { bytes: [1024]u8 }
impl Plain {
	Element :: int;
	Iterator :: Cursor;
	Mut_Iterator :: Cursor;
	iter :: proc(self: ^) -> Cursor { return {0}; }
	iter_mut :: proc(self) -> Cursor { return {0}; }
}
Small :: struct { at: int }
impl Small {
	Element :: int;
	Iterator :: Cursor;
	Mut_Iterator :: Cursor;
	iter :: proc(self: ^) -> Cursor { return {0}; }
	iter_mut :: proc(self) -> Cursor { return {0}; }
}

stored :: proc() {
	source := Owning{};
	view := source.indexed();
	_ = view;
}

in_a_loop :: proc() {
	source := Owning{};
	for (i := 0; i < 2; i += 1) {
		view := source.indexed();
		_ = view;
	}
}

passed_to_a_loop_stored :: proc() {
	source := Owning{};
	view := source.indexed();
	foreach (element in view) { _ = element; }
}

// A plain list is borrowed, and a peeled adapter is not made.
peeled :: proc() {
	source := Owning{};
	foreach (element, index in source.indexed()) { _ = element; _ = index; }
	list := [dynamic]int{1, 2};
	foreach (element in list.reversed()) { _ = element; }
	view := list.indexed();
	_ = view;
}

// A copy that does not allocate is costed by its bytes, held as long as a clone is.
stored_large :: proc() {
	source: Large = {};
	view := source.indexed();
	foreach (value, index in view) { _ = value; _ = index; }
}

stored_plain :: proc() {
	source: Plain = {};
	view := source.indexed();
	foreach (value, index in view) { _ = value; _ = index; }
}

peeled_large :: proc() {
	source: Large = {};
	foreach (value, index in source.indexed()) { _ = value; _ = index; }
	plain: Plain = {};
	foreach (value, index in plain.indexed()) { _ = value; _ = index; }
}

stored_small :: proc() {
	source: Small = {};
	view := source.indexed();
	foreach (value, index in view) { _ = value; _ = index; }
}

copied_borrows :: proc() {
	source := Owning{};
	view := source.copied();
	foreach (element in view) { _ = element; }
	plain: Plain = {};
	foreach (value in plain.copied()) { _ = value; }
	stored := plain.copied();
	foreach (value in stored) { _ = value; }
}

// `reversed()` over a view it can only read borrows it, and so does `copied()` over
// another adapter's mutable view; one that walks its source mutably still copies it.
Reads_Back :: struct { owned: [dynamic]int }
impl Reads_Back {
	Element :: int;
	Iterator :: Cursor;
	Mut_Iterator :: Cursor;
	iter :: proc(self) -> Cursor { return {0}; }
	iter_reverse :: proc(self) -> Cursor { return {0}; }
	iter_mut :: proc(self) -> Cursor { return {0}; }
}
Walks_Back :: struct { owned: [dynamic]int }
impl Walks_Back {
	Element :: int;
	Iterator :: Cursor;
	Mut_Iterator :: Cursor;
	iter :: proc(self) -> Cursor { return {0}; }
	iter_reverse :: proc(self) -> Cursor { return {0}; }
	iter_mut :: proc(self) -> Cursor { return {0}; }
	iter_mut_reverse :: proc(self) -> Cursor { return {0}; }
}

chained_under_copied :: proc() {
	reads := Reads_Back{};
	foreach (value in reads.reversed().copied()) { _ = value; }
	backwards := reads.reversed();
	foreach (value in backwards) { _ = value; }
	walks := Walks_Back{};
	foreach (value in walks.reversed().copied()) { _ = value; }
	foreach (value in walks.copied().reversed()) { _ = value; }
	first := walks.copied().reversed();
	foreach (value in first) { _ = value; }
}

// A diagnostic case needs an error to report beside its warnings.
mismatched :: proc() -> int { return "text"; }

main :: proc() {}
