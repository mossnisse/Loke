package main;

// design.md "Yield modes": how a binding receives an element follows from what
// `next` returns. A `next` the element does not explain, and a record lent
// field by field that a custom hook forbids taking apart, remain diagnostics.

// `^mut int` over an `int` element lends it mutably, lowered like any lending
// leaf.
Lender :: struct { values: []mut int }
Lender_Iterator :: struct { source: []mut int, at: int }

impl Lender {
	Element  :: int;
	Iterator :: Lender_Iterator;

	iter :: proc(self) -> Lender_Iterator { return {self.values, 0}; }
}

impl Lender_Iterator {
	next :: proc(self: inout Lender_Iterator) -> Option(^mut int) {
		if (self.at >= self.source.len()) { return .none; }
		item := &mut self.source[self.at];
		self.at += 1;
		return .some(item);
	}
}

// A `bool` is neither an `int` nor a pointer to one.
Muddle :: struct { values: []int }
Muddle_Iterator :: struct { at: int }

impl Muddle {
	Element  :: int;
	Iterator :: Muddle_Iterator;

	iter :: proc(self) -> Muddle_Iterator { return {0}; }
}

impl Muddle_Iterator {
	next :: proc(self: inout Muddle_Iterator) -> Option(bool) { return .none; }
}

// Lending a record field by field takes it apart, which a type with a custom
// hook does not allow — the restriction a consuming destructure carries.
Guarded :: struct { key: int, value: int }

impl Guarded {
	release :: hook(drop) proc(self: inout Guarded) { self.key = 0; }
}

Keeper :: struct { entries: []Guarded }
Keeper_Iterator :: struct { at: int }

impl Keeper {
	Element  :: Guarded;
	Iterator :: Keeper_Iterator;

	iter :: proc(self) -> Keeper_Iterator { return {0}; }
}

impl Keeper_Iterator {
	next :: proc(self: inout Keeper_Iterator) -> Option((key: ^int, value: ^int)) { return .none; }
}

main :: proc() {
	storage := [2]int{1, 2};
	lender := Lender{storage[:]};
	foreach (value in lender) { _ = value; }
	_ = lender;

	muddle := Muddle{storage[:]};
	foreach (value in muddle) { _ = value; }
	_ = muddle;

	keeper := Keeper{};
	foreach (entry in keeper) { _ = entry; }
	_ = keeper;
}
