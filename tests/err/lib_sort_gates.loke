package main; import "core:slice";

// The gates on the contributed `sort` member.

Opaque :: struct { value: int }

No_Comparator :: struct { }

// One diagnostic at the container, not one per comparison inside a sort the
// caller never wrote.
unordered :: proc() {
	xs := [dynamic]Opaque{Opaque{1}};
	xs.sort();
	xs.reverse_sort();
}

// design.md "Sorting slices": a read-only slice is not sortable, so it has no
// `sort` to call. `swap` rearranges it too, and is gated the same way.
read_only :: proc() {
	readable := []int{3, 1, 2};
	readable.sort();
	readable.reverse_sort();
	readable.swap(0, 1);
	slice.swap(readable, 0, 1);
}

// A sort rearranges the whole container, so it is an invalidating access to it
// exactly as `append` is.
borrowed :: proc(out: inout int) {
	numbers := [dynamic]int{3, 1, 2};
	view := numbers[:];
	numbers.sort();
	out = view[0];
}

// `sort_by` takes a `Comparator` or a plain procedure, and says why neither
// fits: the missing `call`, or the procedure's element type.
bad_comparator :: proc() {
	values := []mut Opaque{Opaque{2}, Opaque{1}};
	slice.sort_by(values, No_Comparator{});
	slice.sort_by(values, proc(left, right: int) -> bool { return left < right; });
}

main :: proc() {
	total := 0;
	unordered();
	read_only();
	borrowed(inout total);
	bad_comparator();
}
