package main;
import "core:fmt";

// A `where` bound that calls a procedure not checked yet checks it on the spot,
// for good. The body has errors, so the bound cannot run it (L0344), and the
// body's own errors must still be reported: under a bound's rollback they once
// vanished, and the use after `move` compiled and ran.

show :: proc(x: $T) where allowed(size_of(T)) {
	fmt.println(x);
}

main :: proc() {
	show(3);
}

consume :: proc(xs: move [dynamic]int) {}

allowed :: proc(n: int) -> bool {
	if (n > 100) {
		xs: [dynamic]int = {};
		xs.append(1);
		consume(move(xs));
		fmt.println(xs[0]);
		bad: int = "text";
	}
	return true;
}
