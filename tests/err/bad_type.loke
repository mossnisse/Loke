package main; import "core:fmt";

main :: proc() {
	x: Missing = 1;
	fmt.println(x);
}

// A field whose type does not resolve is what is wrong with the record. The
// record around it is not an unimplemented construct.
Holder :: struct { n: Nope }

// A composed type is unresolved because a component of it is, so the answer
// names the component rather than the shape written around it.
composed :: proc() {
	a: []no_such_type;
	b: ^no_such_type;
	c: [4]no_such_type;
	d: [dynamic]no_such_type;
	e: [^]no_such_type;
	f: map[no_such_type]int;
	g: map[int]no_such_type;
	h: distinct no_such_type;
	i: proc(x: no_such_type);
	j: proc() -> no_such_type;
}

// A procedure whose written result does not resolve was already answered at the
// signature. Calling it is not a second mistake: the body's `return` must not
// report that the procedure returns nothing, and a caller must not report that
// the call produces no value. Both would blame the use for the declaration.
returns_missing :: proc() -> no_such_type {
	return 1;
}

calls_it :: proc() {
	_ = returns_missing();
	returns_missing();
}

// A qualifier that is not an imported package, here the built-in `box`, names no
// type. A value from that signature leaves `box` unchecked without a second
// report, and the borrow checker, which still walks this error-free body, does
// not read the call `box` left unbound.
takes_builtin :: proc(a: box.Allocator) -> Allocator { return a; }

boxes_through_it :: proc(a: Allocator) {
	b := takes_builtin(a);
	_ = box(0, b);
}
