// design.md "Task borrows and the join": what a task borrows stays lent
// until its block joins, so the parent and other tasks cannot use it.
package main;

import "core:fmt";

add_into :: proc(total: ^mut int, xs: []int) {
	foreach (x in xs) { total^ += x; }
}

fill :: proc(buffer: ^mut [4]int) {
	buffer^[0] = 1;
}

fill_list :: proc(list: ^mut [dynamic]int) {
	list^.append(1);
}

read :: proc(value: ^int) -> int {
	return value^;
}

add :: proc(target: []mut int) { target[0] += 1; }
bump :: proc(target: ^mut int) { target^ += 1; }

upper :: proc(xs: []int) -> []int { return xs[2:]; }

main :: proc() {
	xs := [4]int{1, 2, 3, 4};
	mid := 2;
	total := 0;
	parallel {
		spawn add_into(&mut total, xs[:mid]);
		spawn add_into(&mut total, xs[mid:]);
	}

	buffer: [4]int = {};
	parallel {
		spawn fill(&mut buffer);
		fmt.println(buffer[0]);
	}

	parallel {
		scratch := [dynamic]int{};
		spawn fill_list(&mut scratch);
	}

	shared := 1;
	answer: int;
	parallel {
		spawn answer = read(&shared);
		shared = 2;
	}

	// design.md "Task borrows and the join": a `[]mut` passed by name stays
	// reborrowed by the first task until the join.
	cells := [2]int{0, 0};
	view := &mut cells[:];
	parallel {
		spawn add(view);
		spawn add(view);
	}

	// A borrowed result keeps its loan after the join.
	chosen: []int;
	parallel {
		spawn chosen = upper(xs[:]);
	}
	xs[3] = 0;
	fmt.println(total, answer, chosen[0]);
}

// A view spawned on every iteration is still held by the earlier iteration's
// task; only a fresh binding, as a chunk is, is lent anew on each step.
lend_each_step :: proc(view: []mut int) {
	parallel {
		foreach (_ in 0 ..< 2) {
			spawn add(view);
		}
	}
}

// Each iteration's task holds `total` until the join, so the next iteration
// cannot lend it again.
bump_each_step :: proc() {
	total := 0;
	parallel {
		foreach (_ in 0 ..< 2) {
			spawn bump(&mut total);
		}
	}
}

// An exit the walk reaches before the spawn joins the tasks an earlier
// iteration started, so what they hold is still lent there.
write_before_spawn :: proc() -> int {
	x := 0;
	parallel {
		i := 0;
		for (;;) {
			if (i == 1) { x = 5; return x; }
			spawn read(&x);
			i += 1;
		}
	}
}

reborrow_before_spawn :: proc(values: []mut int) {
	parallel {
		i := 0;
		for (;;) {
			if (i == 1) { values[0] = 5; return; }
			spawn add(values);
			i += 1;
		}
	}
}
