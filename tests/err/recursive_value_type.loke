package main; import "core:fmt";

// A by-value cycle has no finite size; the pointer-recursive `Ok` does.
A :: struct { b: B }
B :: struct { a: A }

Ok :: struct { next: ^Ok }

// Two independent cycles reached from one root. Each path is its own: the first
// closes at `X`, and `X` is not on the way to `Y`.
Root :: struct { x: X, y: Y }
X :: struct { s: X }
Y :: struct { s: Y }

// Generic instances are checked the same way, once their fields exist, and a
// zero value is never built for one that has none.
GA :: struct($T: type) { b: GB(T) }
GB :: struct($T: type) { a: GA(T) }
GS :: struct($T: type) { s: GS(T) }

main :: proc() {
	ga: GA(int) = {};
	gs: GS(int) = {};
	fmt.println(1);
}
