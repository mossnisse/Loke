// design.md "Allocator regions and region provenance": a parameter's region at a call is
// what the body may read of its argument, which is what the carriers it holds lead to as
// well as what it names, however many loads below.
package main;

import "core:mem";

Holder :: struct { allocator: mem.Allocator }
Handles :: struct { first: ^mut Holder, second: ^mut Holder }
Outer :: struct { handles: ^Handles }

cross_field :: proc(handles: ^Handles) { handles^.first^.allocator = handles^.second^.allocator; }
cross_whole :: proc(handles: ^Handles) { handles^.first^ = handles^.second^; }
by_inout :: proc(handles: inout Handles) { handles.first^.allocator = handles.second^.allocator; }
make_through :: proc(handles: ^Handles) -> [dynamic]int { return make([dynamic]int, 1, handles^.second^.allocator); }
make_three_down :: proc(outer: ^Outer) -> [dynamic]int { return make([dynamic]int, 1, outer^.handles^.second^.allocator); }
through_local :: proc(handles: ^Handles) -> [dynamic]int {
	second := handles^.second;
	return make([dynamic]int, 1, second^.allocator);
}

field :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [64]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := Holder{kept.allocator()};
	b := Holder{allocator};
	handles := Handles{&mut a, &mut b};
	cross_field(&handles);
	d := make([dynamic]int, 1, a.allocator);
	free_all(allocator);
	return d[0];
}

whole :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [64]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := Holder{kept.allocator()};
	b := Holder{allocator};
	handles := Handles{&mut a, &mut b};
	cross_whole(&handles);
	d := make([dynamic]int, 1, a.allocator);
	free_all(allocator);
	return d[0];
}

in_place :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [64]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := Holder{kept.allocator()};
	b := Holder{allocator};
	handles := Handles{&mut a, &mut b};
	by_inout(inout handles);
	d := make([dynamic]int, 1, a.allocator);
	free_all(allocator);
	return d[0];
}

result :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [64]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := Holder{kept.allocator()};
	b := Holder{allocator};
	handles := Handles{&mut a, &mut b};
	d := make_through(&handles);
	free_all(allocator);
	return d[0];
}

result_three_down :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [64]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := Holder{kept.allocator()};
	b := Holder{allocator};
	handles := Handles{&mut a, &mut b};
	outer := Outer{&handles};
	d := make_three_down(&outer);
	free_all(allocator);
	return d[0];
}

result_through_a_local :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [64]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := Holder{kept.allocator()};
	b := Holder{allocator};
	handles := Handles{&mut a, &mut b};
	d := through_local(&handles);
	free_all(allocator);
	return d[0];
}

main :: proc() {}
