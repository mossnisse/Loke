// design.md "Lifecycle hooks and resource types": a body-local block cannot take a
// name an earlier use made the compiler generate, as a type has one printed form and
// one hash.
package main;

import "core:fmt";

main :: proc() {
	R :: struct { x: int }
	S :: struct { x: int }
	r := R{1};
	s := S{1};
	fmt.println(r);
	a := s.hash(1);
	impl R {
		format :: proc(self, writer: fmt.Writer, options: fmt.Options) {}
	}
	impl S {
		hash :: proc(self, seed: uint) -> uint { return seed; }
	}
	_ = a;
}
