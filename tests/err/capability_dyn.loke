// A `dyn` view's capability is part of its type, so claiming one the referent
// does not grant is an error at the conversion, and calling a mutating slot
// through a read-only view is a capability error rather than a missing member.
package main; import "core:fmt";

Mixed :: interface($Self: type) {
	slot size: proc(self) -> int;
	slot bump: proc(self: inout Self) ;
}

Tagged :: interface($Self: type, $Tag: type) {
	slot tag: proc(self) -> int;
}

Counter :: struct { value: int }
impl Counter {
	size :: proc(self) -> int { return self.value; }
	bump :: proc(self: inout Counter) { self.value += 1; }
	tag  :: proc(self) -> int { return self.value; }
}

generic_bump :: proc(target: inout $T) -> int where Mixed(T) {
	target.bump();
	return target.size();
}

generic_mut_tag :: proc(view: dyn mut Tagged($T)) -> int { return view.tag(); }

// The slot is on the witness; the view is what refuses to call it.
mutating_slot_through_a_reader :: proc() {
	c := Counter{1};
	view := (dyn Mixed)(&c);
	view.bump();
	fmt.println(view.size());
}

// A mutable view needs a mutable pointer.
mutable_view_from_a_reader :: proc() {
	c := Counter{1};
	view := (dyn mut Mixed)(&c);
	fmt.println(view.size());
}

// A read-only view never strengthens.
strengthens :: proc() {
	c := Counter{1};
	weak := (dyn Mixed)(&c);
	strong: dyn mut Mixed = weak;
	fmt.println(strong.size());
}

// `dyn I` satisfies `I` only when every required receiver is immutable.
reader_does_not_satisfy_a_mixed_interface :: proc() {
	c := Counter{1};
	view := (dyn Mixed)(&c);
	fmt.println(generic_bump(inout view));
}

reader_does_not_match_a_mutable_dyn_pattern :: proc() {
	c := Counter{1};
	reader := (dyn Tagged(int))(&c);
	fmt.println(generic_mut_tag(reader));
}

main :: proc() {
	mutating_slot_through_a_reader();
	mutable_view_from_a_reader();
	strengthens();
	reader_does_not_satisfy_a_mixed_interface();
	reader_does_not_match_a_mutable_dyn_pattern();
}
