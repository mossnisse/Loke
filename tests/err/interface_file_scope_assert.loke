package main;

// A file-scope assertion is checked after every declaration and `impl` in the
// package, so it may precede what it names and may sit apart from a split
// `impl`. Its diagnostic is requirement-level, exactly as in statement
// position.
static_assert(Drawable(Circle));
static_assert(Drawable(Square), "Square is drawn elsewhere");
static_assert(size_of(Header) == 16, "the wire layout changed");

// Not checked: the branch is not selected.
when (false) {
	static_assert(1 == 2, "an inactive branch is not checked");
}

// Selected, and true.
when (true) {
	static_assert(Drawable(Circle) == false);
}

@(export)
static_assert(true);

Drawable :: interface($T: type) {
	slot draw: proc(self) -> int;
}

Header :: struct { a: i32, b: i32 }

Circle :: struct { r: int }

Square :: struct { side: int }
impl Square {
	draw :: proc(self) -> bool { return true; }
}

main :: proc() {}
