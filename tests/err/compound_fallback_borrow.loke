package main;

// design.md "Operator declarations": a compound assignment converts its
// binary operator's result as a value. A view or a `dyn proc` of that
// temporary result is reported rather than left dangling; the written
// assignment keeps its temporary.
Tag :: struct { n: int }

concat :: operator(+) proc(s: string_view, t: Tag) -> string { return "x"; }
pair :: operator(+) proc(s: []int, t: Tag) -> [2]int { return {1, 2}; }

F :: dyn proc() -> int;

one :: proc() -> int { return 1; }
pick :: operator(+) proc(f: F, t: Tag) -> proc() -> int { return one; }

main :: proc() {
	s: string_view = "a";
	s += Tag{1};
	a: []int = {};
	a += Tag{1};
	f: F = one;
	f += Tag{1};
	s = s + Tag{1};
	_ = s;
	_ = a;
	_ = f;
}
