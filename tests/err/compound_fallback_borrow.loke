package main;

// design.md "Temporaries and procedure boundaries": a compound assignment's
// binary fallback result that its destination would view is extended only for
// a whole local variable. A field or a parameter keeps no temporary alive, so
// the view is reported rather than left dangling.
Tag :: struct { n: int }

concat :: operator(+) proc(s: string_view, t: Tag) -> string { return "x"; }
pair :: operator(+) proc(s: []int, t: Tag) -> [2]int { return {1, 2}; }

F :: dyn proc() -> int;

one :: proc() -> int { return 1; }
pick :: operator(+) proc(f: F, t: Tag) -> proc() -> int { return one; }

Holder :: struct {
	s: string_view,
	a: []int,
	f: F,
}

fields :: proc(h: inout Holder) {
	h.s += Tag{1};
	h.a += Tag{1};
	h.f += Tag{1};
}

parameter :: proc(s: inout string_view) {
	s += Tag{1};
}

main :: proc() {}
