package main;

// design.md "Weakening and reborrows": a mutable carrier stored in a literal's
// element is a reborrow of it, so no later element of the same literal may
// use that carrier again. Each pair below would hold two mutable views of one
// sequence.

Pair :: struct { a: []mut int, b: []mut int }
Views :: struct { a: []int, b: []int }
Inner :: struct { a: []mut int }
Outer :: struct { x: Inner, y: Inner }
View :: struct { a: []int }
Outer_View :: struct { x: View, y: View }
Counted :: struct { a: []mut int, n: int }
Wrapped :: struct { x: Inner, n: int }
Holder :: struct { ro: []int, rw: []mut int }
Held :: struct { first: Holder, second: int }
Snapshot :: struct { first: View, second: int }

use :: proc(pair: Pair) { pair.a[0] = 1; pair.b[0] = 2; }

copies :: proc(xs: []mut int) {
	use(Pair{xs, xs});
}
reslices :: proc(xs: []mut int) {
	pair := Pair{&mut xs[:1], &mut xs[1:]};
	pair.a[0] = pair.b[0];
}
mixed :: proc(xs: []mut int) {
	use(Pair{b = xs, a = &mut xs[:]});
}
array :: proc(xs: []mut int) {
	both := [2][]mut int{xs, xs};
	both[0][0] = 1;
}
returned :: proc(xs: []mut int) -> (left: []mut int, right: []mut int) {
	return {&mut xs[:1], &mut xs[1:]};
}

// design.md "Values that contain borrows": a record holding a mutable carrier
// is lent as the carrier is, in a literal and in a call.
nested :: proc(xs: []mut int) {
	both := Outer{Inner{xs}, Inner{xs}};
	both.x.a[0] = both.y.a[0];
}
nested_array :: proc(xs: []mut int) {
	both := [2]Inner{Inner{xs}, Inner{xs}};
	both[0].a[0] = 1;
}
copied_record :: proc(xs: []mut int) {
	inner := Inner{xs};
	both := Outer{inner, inner};
	both.x.a[0] = 1;
}
take :: proc(p: Inner, q: Inner) { p.a[0] = 1; q.a[0] = 2; }
passed_record :: proc(xs: []mut int) {
	inner := Inner{xs};
	take(inner, inner);
}

// The reborrow an element takes lasts until the literal is built, so a later
// element that is not itself lent may not use the carrier either.
write :: proc(xs: []mut int) -> int { xs[0] = 1; return 0; }
later_call :: proc(xs: []mut int) {
	counted := Counted{xs, write(xs)};
	counted.a[0] = 2;
}
later_read :: proc(xs: []mut int) {
	wrapped := Wrapped{Inner{xs}, xs[0]};
	wrapped.x.a[0] = 2;
}

// Different carriers, and read-only fields, are fine.
fine :: proc(xs: []mut int, ys: []mut int) {
	use(Pair{xs, ys});
	views := Views{xs, xs};
	_ = views.a[0] + views.b[0];
	take(Inner{xs}, Inner{ys});
	outer := Outer{Inner{xs}, Inner{ys}};
	outer.x.a[0] = outer.y.a[0];
	read := Outer_View{View{xs}, View{xs}};
	_ = read.x.a[0] + read.y.a[0];
}

// design.md "Evaluation order": a lent record's read-only field keeps the value
// it held before a later element writes it.
replace :: proc(slot: inout []int, @(escape=stored) value: []int) -> int {
	slot = value;
	return 0;
}
mixed_fields :: proc(external: []int, writable: []mut int) -> []int {
	local := [1]int{42};
	holder := Holder{external, writable};
	held := Held{holder, replace(inout holder.ro, local[:])};
	return held.first.ro;
}

// A captured read-only field is still a reborrow of its source, so the source
// stays suspended for writing while the literal holds it.
lent_snapshot :: proc(external: []mut int, writable: []mut int, other: []int) -> int {
	holder := Holder{external, writable};
	held := Held{holder, replace(inout holder.ro, other)};
	external[0] = 5;
	return held.first.ro[0];
}
read_only_snapshot :: proc(external: []mut int, other: []int) -> int {
	view := View{external};
	held := Snapshot{view, replace(inout view.a, other)};
	external[0] = 5;
	return held.first.a[0];
}

// A container stores a carrier as a literal's element does: appending two
// carriers is fine, and appending one twice holds two mutable views of it.
appended :: proc(xs: []mut int, ys: []mut int) {
	held := [dynamic][]mut int{};
	held.append(xs);
	held.append(ys);
	held[0][0] = held[1][0];
}
appended_twice :: proc(xs: []mut int) {
	held := [dynamic][]mut int{};
	held.append(xs);
	held.append(xs);
	held[0][0] = 1;
}

main :: proc() {}
