// design.md "Values that contain borrows": a store through a pointer that
// names one place replaces what that place held, as a store to the place
// itself does, so the borrow it held is no longer in use. Through a pointer
// that may name either of two places, each keeps what it held. A store into
// one field leaves the others as they were.
package main;

Node :: struct { value: int }
List :: struct { head: ^mut Node, tail: ^mut Node }
Lists :: struct { first: List, second: List }
cond :: proc() -> bool { return true; }

either :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4}; e := Node{5};
	l := List{&mut a, &mut b}; m := List{&mut d, &mut e};
	p := &mut l if cond() else &mut m;
	p^.head = p^.tail;
	p^.head = &mut c;
	x := p^.tail;
	x^.value = 1;
	y := p^.head;
	y^.value = 2;
}

other_field :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3};
	l := List{&mut a, &mut b};
	list := &mut l;
	list^.head = list^.tail;
	list^.tail = &mut c;
	x := l.head;
	y := &mut b;
	x^.value = 1;
	y^.value = 2;
}

other_element :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4}; e := Node{5};
	lists := [2]List{List{&mut a, &mut b}, List{&mut c, &mut d}};
	p := &mut lists;
	p[0].head = p[0].tail;
	p[1].head = &mut e;
	x := lists[0].head;
	y := &mut b;
	x^.value = 1;
	y^.value = 2;
}

// A pointer to an element chosen at run time may name either.
dynamic_element :: proc(flag: bool) {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4}; e := Node{5};
	lists := [2]List{List{&mut a, &mut d}, List{&mut b, &mut e}};
	p := &mut lists;
	i := 0 if flag else 1;
	q := &mut p[i];
	q^.head = &mut c;
	b.value = 1;
	k := lists[1].head;
	k^.value = 2;
}

// What was copied out before the store keeps its borrow.
copied_out :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3};
	l := List{&mut a, &mut b};
	list := &mut l;
	list^.head = list^.tail;
	k := list^.head;
	list^.head = &mut c;
	x := list^.tail;
	x^.value = 1;
	k^.value = 2;
}

// Legal: the copy stored first is replaced before the next is taken, or
// before anything reads the place again.
replaced :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3};
	l := List{&mut a, &mut b};
	list := &mut l;
	list^.head = list^.tail;
	list^.head = &mut c;
	x := list^.tail;
	x^.value = 1;
	y := list^.head;
	y^.value = 2;
}

replaced_after :: proc() {
	a := Node{1}; b := Node{2};
	l := List{&mut a, &mut b};
	list := &mut l;
	list^.head = list^.tail;
	again := list^.head;
	again^.value = 3;
	list^.head = list^.tail;
	last := list^.head;
	last^.value = 4;
}

nested :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4};
	both := Lists{List{&mut a, &mut b}, List{&mut c, &mut d}};
	p := &mut both;
	p^.first.head = p^.first.tail;
	again := p^.first.head;
	again^.value = 3;
	p^.first.head = p^.first.tail;
	last := p^.first.head;
	last^.value = 4;
}

indexed :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4};
	lists := [2]List{List{&mut a, &mut b}, List{&mut c, &mut d}};
	p := &mut lists;
	p[0].head = p[0].tail;
	again := p[0].head;
	again^.value = 3;
	p[0].head = p[0].tail;
	last := p[0].head;
	last^.value = 4;
}

two_pointers :: proc() {
	a := Node{1}; b := Node{2};
	l := List{&mut a, &mut b};
	held := &mut l;
	p := &mut held;
	p^^.head = p^^.tail;
	again := p^^.head;
	again^.value = 3;
	p^^.head = p^^.tail;
	last := p^^.head;
	last^.value = 4;
}

// Legal: a store into `head` through a pointer to either list leaves `tail`
// as it was, so each copy of `tail` in the loop is its own.
either_repeated :: proc() {
	a := Node{1}; b := Node{2}; d := Node{4}; e := Node{5};
	l := List{&mut a, &mut b}; m := List{&mut d, &mut e};
	p := &mut l if cond() else &mut m;
	for (i := 0; i < 2; i += 1) {
		p^.head = p^.tail;
	}
}

main :: proc() {}
