package main; import "core:fmt"; import "core:mem";

// Region provenance with real local regions (m6b-plan step 5).
//
// design.md's own rejected examples, now written against the storage they were
// always written for. M5b activated the *analyses* against substitute storage;
// what was missing was a provider that creates a local region.

// design.md "How root and region provenance compose", verbatim:
//
//   bad_view :: proc() -> []u8 {
//   	arena := mem.Arena.init();
//   	bytes: [dynamic]u8 via arena.allocator() = {};
//   	return bytes[:]; // ERROR: borrow outlives the local root `bytes`
//   }
bad_view :: proc() -> []u8 {
	arena := mem.Arena.init();
	bytes: [dynamic]u8 via arena.allocator() = {};
	return bytes[:];
}

// ...and its companion, which fails for a different reason: the owner, not a
// borrow of it, outlives the region.
//
//   bad_owner :: proc() -> [dynamic]u8 {
//   	arena := mem.Arena.init();
//   	bytes: [dynamic]u8 via arena.allocator() = {};
//   	return move(bytes); // ERROR: owner outlives allocator region `arena`
//   }
bad_owner :: proc() -> [dynamic]u8 {
	arena := mem.Arena.init();
	bytes: [dynamic]u8 via arena.allocator() = {};
	return move(bytes);
}

// design.md "Allocators": returning the array without `move` is the same
// failure, because "returning a managed local ... transfers that owned value
// into result storage without cloning".
bad_buffer :: proc() -> [dynamic]u8 {
	arena := mem.Arena.init();
	bytes: [dynamic]u8 via arena.allocator() = {};
	bytes.append(1, 2, 3);
	return bytes;
}

// design.md: "A wrapper may return a provider owner and transfer its fresh
// root, but may not return only a handle to that root."
leaked_handle :: proc() -> Allocator {
	arena := mem.Arena.init();
	return arena.allocator();
}

// A fixed-buffer arena borrows the buffer for as long as it lives, so it cannot
// outlive it either.
leaked_fixed :: proc() -> mem.Arena {
	buffer: [4096]u8 = {};
	return mem.Arena.from_buffer(buffer[:]);
}

// design.md: "release_scratch(arena.allocator()); // ERROR while `scratch` or
// `view` is live".
release_scratch :: proc(@(allocator_reset) allocator: Allocator) {
	free_all(allocator);
}

surviving_owner :: proc() {
	arena := mem.Arena.init();
	scratch: [dynamic]u8 via arena.allocator() = {};
	scratch.append(1);
	release_scratch(arena.allocator());
	fmt.println(len(scratch));
}

// design.md: an owner is dead "when it may be used later or still requires
// cleanup on an outgoing path". Dropped on one path only, it may still require
// cleanup on the other, so it keeps blocking — `Conditional` is not `Dead`.
conditionally_dropped :: proc(flag: bool) {
	arena := mem.Arena.init();
	xs: [dynamic]u8 via arena.allocator() = {};
	xs.append(1);
	if (flag) {
		drop(xs);
	}
	free_all(arena.allocator());
}

// design.md: an owner "backed by a region created in the current procedure may
// not be ... assigned to `static`, `thread_local`, or file-scope storage".
held: [dynamic]u8;

escaping_owner :: proc() {
	arena := mem.Arena.init();
	bytes: [dynamic]u8 via arena.allocator() = {};
	held = move(bytes);
}

main :: proc() {
	fmt.println(1);
}

// A provider-backed child requires its parent to stay live until the child is
// dropped, just like an ordinary owner allocated in that parent region.
surviving_child :: proc() {
	parent := mem.Arena.init();
	child := mem.Scratch.init(parent.allocator());
	free_all(parent.allocator());
	drop(child);
}
