package main; import "core:fmt";

BUDGET :: build_config(BUDGET, 5);
LABEL :: build_config(LABEL, "x");

main :: proc() {
	// A false static assertion breaks compilation, message and all.
	static_assert(BUDGET > 100, "the budget shrank");
	static_assert(LABEL == "y");
	// design.md "`caller_location()`": it names the caller, so it takes nothing.
	fmt.println(caller_location(1).line);
}
