// design.md "Borrows crossing between tasks": a borrow of the worker's own
// `thread_local` storage cannot reach the parent through what the task's call
// writes into an argument, directly or through a helper, a field, an element,
// or a callback. One the parent's own call leaves cannot later reach a task.
package main;

import "base:interfaces";

counter: thread_local int;
Holder :: struct { view: ^int }

publish :: proc(out: ^mut ^int) { out^ = &counter; }
forward :: proc(out: ^mut ^int) { publish(out); }
publish_inout :: proc(out: inout ^int) { out = &counter; }
publish_element :: proc(out: []mut ^int) { out[0] = &counter; }
publish_field :: proc(out: ^mut Holder) { out^.view = &counter; }

direct :: proc(slot: ^mut ^int) {
	parallel { spawn publish(slot); }
}

through_helper :: proc(slot: ^mut ^int) {
	parallel { spawn forward(slot); }
}

through_inout :: proc(slot: ^mut ^int) {
	parallel { spawn publish_inout(inout slot^); }
}

through_element :: proc(cells: []mut ^int) {
	parallel { spawn publish_element(cells); }
}

through_field :: proc(holder: ^mut Holder) {
	parallel { spawn publish_field(holder); }
}

invoke :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { f(out); }
relay :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { invoke(f, out); }
through_local :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { g := f; g(out); }
invoke_view :: proc(f: dyn proc(out: ^mut ^int), out: ^mut ^int) { f(out); }
read_slot :: proc(p: ^int) { _ = p^; }

through_callback :: proc() {
	other := 0;
	slot: ^int = &other;
	parallel { spawn invoke(publish, &mut slot); }
	_ = slot^;
}

through_relayed_callback :: proc(slot: ^mut ^int) {
	parallel { spawn relay(publish, slot); }
}

through_callback_local :: proc(slot: ^mut ^int) {
	parallel { spawn through_local(publish, slot); }
}

through_callable_view :: proc(slot: ^mut ^int) {
	parallel { spawn invoke_view(publish, slot); }
}

// Reported once, at the task that writes it back.
reported_once :: proc() {
	other := 0;
	slot: ^int = &other;
	parallel { spawn publish(&mut slot); }
	parallel { spawn read_slot(slot); }
}

parent_borrow_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	publish(&mut slot);
	parallel { spawn read_slot(slot); }
}

parent_callback_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	invoke(publish, &mut slot);
	parallel { spawn read_slot(slot); }
}

baseline :: proc(out: ^mut ^int) -> ^int { return &counter; }
publish_returning :: proc(out: ^mut ^int) -> ^int {
	out^ = &counter;
	return &counter;
}
Baseline :: type_of(baseline);
invoke_contract :: proc(f: Baseline, out: ^mut ^int) { _ = f(out); }
noop :: proc(out: ^mut ^int) {}
Noop :: type_of(noop);
invoke_callable :: proc(f: dyn interfaces.Callable(Noop), out: ^mut ^int) { f.call(out); }

// A contract bounds only what the result borrows.
through_contract :: proc(slot: ^mut ^int) {
	parallel { spawn invoke_contract(publish_returning, slot); }
}

// The view is the call's first argument, before the procedure's parameters.
through_callable_call :: proc(slot: ^mut ^int) {
	parallel { spawn invoke_callable(publish, slot); }
}

parent_callable_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	invoke_callable(publish, &mut slot);
	parallel { spawn read_slot(slot); }
}

// A capture literal's `call` takes its record first, which the view hides.
through_capture_literal :: proc(slot: ^mut ^int) {
	tag := 1;
	writer := proc(out: ^mut ^int) capture(tag) { out^ = &counter; };
	parallel { spawn invoke_view((dyn proc(out: ^mut ^int))(&writer), slot); }
}

// Through two mutable levels, the write lands in what `inner` points at.
publish_deep :: proc(out: ^mut ^mut ^int) { out^^ = &counter; }

through_two_levels :: proc() {
	other := 0;
	slot: ^int = &other;
	inner: ^mut ^int = &mut slot;
	parallel { spawn publish_deep(&mut inner); }
	_ = slot^;
}

parent_two_levels_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	inner: ^mut ^int = &mut slot;
	publish_deep(&mut inner);
	parallel { spawn read_slot(slot); }
}

main :: proc() {}
