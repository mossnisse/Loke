// design.md "Borrows crossing between tasks": a borrow of the worker's own
// `thread_local` storage cannot reach the parent through what the task's call
// writes into an argument, directly or through a helper, a field, an element,
// or a callback, nor through the task's result read back from a callback or
// returned by one. One the parent's own call leaves cannot later reach a task.
package main;

import "base:interfaces";

counter: thread_local int;
Holder :: struct { view: ^int }

publish :: proc(out: ^mut ^int) { out^ = &counter; }
forward :: proc(out: ^mut ^int) { publish(out); }
publish_inout :: proc(out: inout ^int) { out = &counter; }
publish_element :: proc(out: []mut ^int) { out[0] = &counter; }
publish_field :: proc(out: ^mut Holder) { out^.view = &counter; }

direct :: proc(slot: ^mut ^int) {
	parallel { spawn publish(slot); }
}

through_helper :: proc(slot: ^mut ^int) {
	parallel { spawn forward(slot); }
}

through_inout :: proc(slot: ^mut ^int) {
	parallel { spawn publish_inout(inout slot^); }
}

through_element :: proc(cells: []mut ^int) {
	parallel { spawn publish_element(cells); }
}

through_field :: proc(holder: ^mut Holder) {
	parallel { spawn publish_field(holder); }
}

invoke :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { f(out); }
relay :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { invoke(f, out); }
through_local :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { g := f; g(out); }
invoke_view :: proc(f: dyn proc(out: ^mut ^int), out: ^mut ^int) { f(out); }
read_slot :: proc(p: ^int) { _ = p^; }

through_callback :: proc() {
	other := 0;
	slot: ^int = &other;
	parallel { spawn invoke(publish, &mut slot); }
	_ = slot^;
}

through_relayed_callback :: proc(slot: ^mut ^int) {
	parallel { spawn relay(publish, slot); }
}

through_callback_local :: proc(slot: ^mut ^int) {
	parallel { spawn through_local(publish, slot); }
}

through_callable_view :: proc(slot: ^mut ^int) {
	parallel { spawn invoke_view(publish, slot); }
}

// Reported once, at the task that writes it back.
reported_once :: proc() {
	other := 0;
	slot: ^int = &other;
	parallel { spawn publish(&mut slot); }
	parallel { spawn read_slot(slot); }
}

parent_borrow_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	publish(&mut slot);
	parallel { spawn read_slot(slot); }
}

parent_callback_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	invoke(publish, &mut slot);
	parallel { spawn read_slot(slot); }
}

baseline :: proc(out: ^mut ^int) -> ^int { return &counter; }
publish_returning :: proc(out: ^mut ^int) -> ^int {
	out^ = &counter;
	return &counter;
}
Baseline :: type_of(baseline);
invoke_contract :: proc(f: Baseline, out: ^mut ^int) { _ = f(out); }
noop :: proc(out: ^mut ^int) {}
Noop :: type_of(noop);
invoke_callable :: proc(f: dyn interfaces.Callable(Noop), out: ^mut ^int) { f.call(out); }

// A contract bounds only what the result borrows.
through_contract :: proc(slot: ^mut ^int) {
	parallel { spawn invoke_contract(publish_returning, slot); }
}

// The view is the call's first argument, before the procedure's parameters.
through_callable_call :: proc(slot: ^mut ^int) {
	parallel { spawn invoke_callable(publish, slot); }
}

parent_callable_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	invoke_callable(publish, &mut slot);
	parallel { spawn read_slot(slot); }
}

// A capture literal's `call` takes its record first, which the view hides.
through_capture_literal :: proc(slot: ^mut ^int) {
	tag := 1;
	writer := proc(out: ^mut ^int) capture(tag) { out^ = &counter; };
	parallel { spawn invoke_view((dyn proc(out: ^mut ^int))(&writer), slot); }
}

// Through two mutable levels, the write lands in what `inner` points at.
publish_deep :: proc(out: ^mut ^mut ^int) { out^^ = &counter; }

through_two_levels :: proc() {
	other := 0;
	slot: ^int = &other;
	inner: ^mut ^int = &mut slot;
	parallel { spawn publish_deep(&mut inner); }
	_ = slot^;
}

parent_two_levels_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	inner: ^mut ^int = &mut slot;
	publish_deep(&mut inner);
	parallel { spawn read_slot(slot); }
}

// The result holds what the callback passed leaves, directly, through a
// relaying helper, or through a contract.
apply_result :: proc(f: proc(out: ^mut ^int), start: ^int) -> ^int {
	current := start;
	f(&mut current);
	return current;
}
relay_result :: proc(f: proc(out: ^mut ^int), start: ^int) -> ^int { return apply_result(f, start); }
Apply_Result :: type_of(apply_result);
contract_result :: proc(g: Apply_Result, f: proc(out: ^mut ^int), start: ^int) -> ^int { return g(f, start); }

result_through_callback :: proc() {
	other := 0;
	result: ^int;
	parallel { spawn result = apply_result(publish, &other); }
	_ = result^;
}

result_through_relay :: proc() {
	other := 0;
	result: ^int;
	parallel { spawn result = relay_result(publish, &other); }
	_ = result^;
}

result_through_contract :: proc() {
	other := 0;
	result: ^int;
	parallel { spawn result = contract_result(apply_result, publish, &other); }
	_ = result^;
}

// A contract whose result reads no callback admits no substitute that does.
ignore_result :: proc(f: proc(out: ^mut ^int), start: ^int) -> ^int { return start; }
Ignore_Result :: type_of(ignore_result);
take_ignore :: proc(g: Ignore_Result) {}

callback_read_outside_contract :: proc() {
	take_ignore(apply_result);
}

// A callback called through a plain type or a view returns the worker's own.
borrow_tls :: proc() -> ^int { return &counter; }
call_returning :: proc(h: proc() -> ^int) -> ^int { return h(); }
relay_returning :: proc(h: proc() -> ^int) -> ^int { return call_returning(h); }
call_view_returning :: proc(h: dyn proc() -> ^int) -> ^int { return h(); }

returned_through_callback :: proc() {
	result: ^int;
	parallel { spawn result = call_returning(borrow_tls); }
	_ = result^;
}

returned_through_relay :: proc() {
	result: ^int;
	parallel { spawn result = relay_returning(borrow_tls); }
	_ = result^;
}

returned_through_view :: proc() {
	result: ^int;
	parallel { spawn result = call_view_returning(borrow_tls); }
	_ = result^;
}

parent_returned_later_spawned :: proc() {
	slot := call_returning(borrow_tls);
	parallel { spawn read_slot(slot); }
}

// A field beside a read-only one, and copies of a callback, still carry it.
Pair :: struct { view: ^int, out: ^mut ^int }
publish_pair :: proc(pair: ^mut Pair) { pair^.out^ = &counter; }
call_copy :: proc(h: proc() -> ^int) -> ^int {
	g := h;
	return g();
}
pass_copy :: proc(h: proc() -> ^int) -> ^int {
	g := h;
	return call_copy(g);
}
named_local :: proc() -> ^int {
	g := borrow_tls;
	return g();
}

through_mutable_field :: proc() {
	other := 0;
	slot: ^int = &other;
	pair := Pair{&other, &mut slot};
	parallel { spawn publish_pair(&mut pair); }
}

returned_through_copy :: proc() {
	result: ^int;
	parallel { spawn result = pass_copy(borrow_tls); }
	_ = result^;
}

returned_through_named_local :: proc() {
	result: ^int;
	parallel { spawn result = named_local(); }
	_ = result^;
}

// A mutable field read through a read-only pointer is still written, and a
// local procedure literal is the procedure it names.
Box :: struct { out: ^mut ^int }
publish_box :: proc(box: ^mut ^Box) { box^^.out^ = &counter; }
literal_local :: proc() -> ^int {
	g: proc() -> ^int = proc() -> ^int { return &counter; };
	return g();
}

through_read_only_pointer :: proc() {
	other := 0;
	slot: ^int = &other;
	box := Box{&mut slot};
	view: ^Box = &box;
	parallel { spawn publish_box(&mut view); }
}

parent_read_only_pointer_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	box := Box{&mut slot};
	view: ^Box = &box;
	publish_box(&mut view);
	parallel { spawn read_slot(slot); }
}

returned_through_literal_local :: proc() {
	result: ^int;
	parallel { spawn result = literal_local(); }
	_ = result^;
}

// However deep a chain of read-only pointers runs, or however a type recurses,
// the mutable field at its end is written.
Link0 :: struct { out: ^mut ^int, view: ^int }
Link1 :: struct { next: ^Link0 }
Link2 :: struct { next: ^Link1 }
Link3 :: struct { next: ^Link2 }
Link4 :: struct { next: ^Link3 }
Link5 :: struct { next: ^Link4 }
publish_deep_chain :: proc(root: ^mut ^Link5) {
	root^^.next^.next^.next^.next^.next^.out^ = &counter;
}
Tree :: struct { left: ^mut Tree, right: ^Tree, view: ^int }
publish_tree :: proc(tree: ^mut Tree) { tree^.left^.left^.view = &counter; }
read_tree :: proc(tree: ^Tree) { _ = tree^.view^; }

parent_deep_chain_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	link0 := Link0{&mut slot, &other};
	link1 := Link1{&link0};
	link2 := Link2{&link1};
	link3 := Link3{&link2};
	link4 := Link4{&link3};
	link5 := Link5{&link4};
	view: ^Link5 = &link5;
	publish_deep_chain(&mut view);
	parallel { spawn read_slot(slot); }
}

parent_recursive_later_spawned :: proc(tree: ^mut Tree) {
	publish_tree(tree);
	parallel { spawn read_tree(tree); }
}

// Nor does a record cut at the depth or width budget hide a mutable field behind
// a read-only pointer inside it.
Nest0 :: struct { ptr: ^Box }
Nest1 :: struct { nest: Nest0 }
Nest2 :: struct { nest: Nest1 }
Nest3 :: struct { nest: Nest2 }
Nest4 :: struct { nest: Nest3 }
publish_nest :: proc(root: ^mut Nest4) { root^.nest.nest.nest.nest.ptr^.out^ = &counter; }
Wide :: struct { views: [8][8]string_view, ptr: ^Box }
publish_wide :: proc(wide: ^mut Wide) { wide^.ptr^.out^ = &counter; }

parent_truncated_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	box := Box{&mut slot};
	nest := Nest4{Nest3{Nest2{Nest1{Nest0{&box}}}}};
	publish_nest(&mut nest);
	parallel { spawn read_slot(slot); }
}

parent_wide_later_spawned :: proc() {
	other := 0;
	slot: ^int = &other;
	box := Box{&mut slot};
	wide := Wide{ptr = &box};
	publish_wide(&mut wide);
	parallel { spawn read_slot(slot); }
}

// A write-back below the cut may land in any carrier the cut merged with a
// mutable one, so it names the limit and says only that a read-only sibling of
// static storage may receive it.
fallback := 1;
Split0 :: struct { out: ^mut ^int, view: ^int }
Split1 :: struct { split: Split0 }
Split2 :: struct { split: Split1 }
Split3 :: struct { split: Split2 }
Split4 :: struct { split: Split3 }
publish_split :: proc(root: ^mut Split4) { root^.split.split.split.split.out^ = &counter; }

parent_truncated_sibling :: proc() {
	other := 0;
	slot: ^int = &other;
	split := Split4{Split3{Split2{Split1{Split0{&mut slot, &fallback}}}}};
	publish_split(&mut split);
	_ = slot^;
}

// A recursive type is walked on through read-only links to the mutable field.
Chain :: struct { next: Option(^Chain), out: ^mut ^int }
publish_chain :: proc(chain: ^mut Chain) {
	switch (chain^.next) {
	case .some(next):
		switch (next^.next) {
		case .some(last): last^.out^ = &counter;
		case .none:
		}
	case .none:
	}
}

parent_recursive_chain_later_spawned :: proc() {
	other := 0;
	first: ^int = &other;
	second: ^int = &other;
	slot: ^int = &other;
	last := Chain{.none, &mut slot};
	middle := Chain{.some(&last), &mut second};
	chain := Chain{.some(&middle), &mut first};
	publish_chain(&mut chain);
	parallel { spawn read_slot(slot); }
}

main :: proc() {}
