package main;

import "core:fmt";

// design.md "Temporaries and procedure boundaries": an extended temporary is
// dropped with its block's locals, so its drop hook runs at the block's end.
// What the hook reads stays borrowed until then ("Capabilities and the one
// rule"), and what it writes counts there ("Global write effects").

@(move_only) Read :: struct { data: []int, n: int }

impl Read {
	retire :: hook(drop) proc(self: inout Read) { fmt.println(self.data[0]); }
}

// Overwriting the view does not end the temporary it extended.
overwritten :: proc() {
	values := [dynamic]int{7};
	view := &Read{values[:], 1};
	view = &Read{{}, 0};
	drop(values);
	fmt.println(view^.n);
}

// The borrow may name one field; the whole temporary is still dropped.
projected :: proc() {
	values := [dynamic]int{7};
	p := &Read{values[:], 1}.n;
	fmt.println(p^);
	drop(values);
}

// Without a drop hook nothing reads the slice at the block's end.
Plain :: struct { data: []int, n: int }

unhooked :: proc() {
	values := [dynamic]int{7};
	view := &Plain{values[:], 1};
	fmt.println(view^);
	drop(values);
}

shared_values: [dynamic]int = {};

@(move_only) Clear :: struct { id: int }

impl Clear {
	retire :: hook(drop) proc(self: inout Clear) { shared_values = {}; }
}

// The hook's write happens where the block ends, while `borrowed` is live.
writes_at_block_end :: proc() {
	shared_values.append(7);
	borrowed := shared_values[:];
	{
		view := &Clear{1};
		fmt.println(view^);
	}
	fmt.println(borrowed[0]);
}

// design.md "Slice literals": the hidden array is extended too, and its
// elements are dropped with it, even after the slice is overwritten.
overwritten_slice :: proc() {
	values := [dynamic]int{7};
	view: []Read = []Read{Read{values[:], 1}};
	view = {};
	drop(values);
	fmt.println(view.len());
}

// Elements without a drop hook read nothing there.
unhooked_slice :: proc() {
	values := [dynamic]int{7};
	view: []Plain = []Plain{Plain{values[:], 1}};
	view = {};
	drop(values);
	fmt.println(view.len());
}

// An element's hook writes where the block ends, as `&Clear{1}`'s does.
slice_writes_at_block_end :: proc() {
	borrowed := shared_values[:];
	{
		view := []Clear{Clear{1}};
		fmt.println(view.len());
	}
	fmt.println(borrowed[0]);
}

main :: proc() {
	overwritten();
	projected();
	unhooked();
	writes_at_block_end();
	overwritten_slice();
	unhooked_slice();
	slice_writes_at_block_end();
}
