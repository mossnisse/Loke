package main;
import "core:mem";

// design.md "Minimum provenance precision": nesting cannot erase a provider.
L0 :: struct { inner: mem.Arena }
L1 :: struct { inner: L0 }
L2 :: struct { inner: L1 }
L3 :: struct { inner: L2 }
L4 :: struct { inner: L3 }
L5 :: struct { inner: L4 }
L6 :: struct { inner: L5 }
L7 :: struct { inner: L6 }
L8 :: struct { inner: L7 }

main :: proc() {
	owner := L8{L7{L6{L5{L4{L3{L2{L1{L0{mem.Arena.init()}}}}}}}}};
	allocator := owner.inner.inner.inner.inner.inner.inner.inner.inner.inner.allocator();
	p := new(int, allocator);
	drop(owner);
	p^ = 42;
}
