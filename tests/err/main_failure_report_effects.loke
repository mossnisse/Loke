// design.md "Program entry and exit" and "Global write effects": a failing
// `main`'s result is printed after its cleanup, while what it borrows is still
// in use, so a `format` that writes that storage conflicts, through `return`
// and through `or_return` alike.
package main;
import "core:fmt";
import "core:os";

value: int = 1;

Error :: struct { borrowed: ^int }
impl Error {
	format :: proc(self, w: fmt.Writer, o: fmt.Options) {
		value = 2;
		fmt.format_to(w, self.borrowed^);
	}
}

main :: proc() -> Result(Unit, Error) {
	failed: Result(Unit, Error) = .err(Error{&value});
	if (os.args.len() > 5) {
		failed or_return;
	}
	return .err(Error{&value});
}
