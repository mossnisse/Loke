package main; import "core:fmt";

// design.md "Zero values": a union with no `@(zero=)` has no zero value, and
// every operation that would manufacture one says so.
//
// A declaration with no initialiser is one of them, wherever its storage lives:
// a local is filled where it is reached exactly as a static one is filled before
// the program runs. `---` asks for the storage without the value, and is the way
// to hold one of these before it is assigned.

Choice :: union { number: i32, flag: bool }
Holder :: struct { id: int, choice: Choice }

// The property propagates through a struct, a non-empty fixed array, and a
// distinct type; an empty array holds no element, so it keeps its zero.
Wrapped :: struct { held: Holder }
Row :: [3]Choice;
Empty_Row :: [0]Choice;
Named :: distinct Choice;

global: Choice;
lasting: static Wrapped;
per_thread: thread_local Row;

// Accepted: an empty array has no element to fill.
still_fine: Empty_Row;
also_fine: static Empty_Row;

main :: proc() {
	// Every field an aggregate literal omits is filled with that field's zero.
	blank := Holder{};
	partial := Holder{1};
	nested := Wrapped{};

	// A fresh allocation is zeroed.
	p := new(Choice);
	q := new(Named);

	// A written length fills that many slots; a constant `0` length fills none,
	// which is how `make(T, 0, capacity)` reserves storage for one of these.
	filled := make([dynamic]Choice, 4);
	reserved := make([dynamic]Choice, 0, 8);

	// So does growth. Reserving capacity does not, and is accepted.
	ys: [dynamic]Choice;
	ys.reserve(4);
	ys.resize(4);

	// A local with no initialiser is filled with the zero where it is reached,
	// so it needs one; `---` asks for the storage alone and is accepted.
	local: Choice;
	uninitialised: Choice = ---;

	// A map of a no-zero element is indexed like any other: no map operation
	// manufactures a zero, so nothing here is rejected. `tests/run/
	// no_zero_containers.loke` runs it.

	fmt.println(blank, partial, nested, p, q, filled.len(), reserved.len(), ys.len(), global);
}
