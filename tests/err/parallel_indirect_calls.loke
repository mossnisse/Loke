// design.md "Spawn statements": the calls a task makes in turn may be
// indirect, and each task check takes the union of every body such a call
// may reach (design.md "Global write effects"); a spawned procedure value is
// in parallel_procedure_values.loke. A hand-written wrapper calling a procedure value, a
// `dyn proc` view, a capture literal, a `dyn` slot, or a procedure read from
// a field is rejected for a global write or global reach, a reserved
// allocator region, a mutable capture shared between tasks or a view that
// hides its captures, a `@(thread_affine)` capture, an endpoint kept past
// the join, and a pooled `thread_local` write, and accepted where no body it
// may call does any of those. A borrow of `thread_local` storage a callback
// leaves or returns is in parallel_written_back.loke.
//
// A wrapper's call takes in the procedure it is passed, so a spawn passing a
// clean procedure is accepted though another call passes the wrapper a
// procedure of that type that writes a global; a callback the program cannot
// follow takes the union over every procedure of its type the program uses
// as a value. Each case has a callback type of its own to keep the others out
// of its union.
package main;

import "base:interfaces";
import "core:fmt";
import "core:mem";
import "core:thread";

hits: int;
values: [1]int;
view: []mut int;
buffer: thread_local [dynamic]int;

// Globals.

call_plain :: proc(f: proc()) { f(); }
record_hit :: proc() { hits += 1; }

value_writes :: proc() {
	parallel { spawn call_plain(record_hit); }
}

call_u16 :: proc(f: dyn proc(n: u16)) { f(1); }

literal_writes :: proc() {
	k := 2;
	add := proc(n: u16) capture(k) { hits += k + int(n); };
	parallel { spawn call_u16(add); }
}

Bumper :: interface($Self: type) {
	slot bump: proc(self, n: int);
}

Counter :: struct { base: int }

impl Counter {
	bump :: proc(self, n: int) { hits += n; }
}

call_slot :: proc(d: dyn Bumper) { d.bump(1); }

slot_writes :: proc() {
	c := Counter{0};
	parallel { spawn call_slot((dyn Bumper)(&c)); }
}

Job :: struct { run: proc(n: u32) }

call_field :: proc(job: ^Job) { job.run(1); }
write_u32 :: proc(n: u32) { hits += int(n); }

field_writes :: proc(job: ^Job) {
	parallel { spawn call_field(job); }
}

call_i8 :: proc(f: proc(n: i8)) { f(1); }
increment :: proc(n: i8) { view[0] += int(n); }

value_reaches :: proc() {
	parallel { spawn call_i8(increment); }
}

call_square :: proc(f: proc(n: int) -> int) -> int { return f(3); }
square :: proc(n: int) -> int { return n * n; }

value_clean :: proc() -> int {
	r: int;
	parallel { spawn r = call_square(square); }
	return r;
}

call_u8 :: proc(f: proc(n: u8)) { f(1); }
clean_u8 :: proc(n: u8) {}
dirty_u8 :: proc(n: u8) { hits += int(n); }

clean_beside_dirty :: proc() {
	parallel { spawn call_u8(clean_u8); }
}

serial_dirty :: proc() { call_u8(dirty_u8); }

// Allocators.

call_alloc :: proc(f: proc(a: Allocator), a: Allocator) { f(a); }
allocate :: proc(a: Allocator) { xs: [dynamic]int via a = {}; xs.append(1); }

one_arena :: proc() {
	arena := mem.Arena.init();
	a := arena.allocator();
	parallel {
		spawn call_alloc(allocate, a);
		spawn call_alloc(allocate, a);
	}
}

two_arenas :: proc() {
	one := mem.Arena.init();
	two := mem.Arena.init();
	parallel {
		spawn call_alloc(allocate, one.allocator());
		spawn call_alloc(allocate, two.allocator());
	}
}

call_i32 :: proc(f: dyn proc(n: i32)) { f(1); }

captured_arena :: proc() {
	arena := mem.Arena.init();
	a := arena.allocator();
	make_list := proc(n: i32) capture(a) { xs: [dynamic]int via a = {}; xs.append(int(n)); };
	parallel {
		spawn call_i32(make_list);
		spawn call_i32(make_list);
	}
}

// Sharing.

call_i16 :: proc(f: dyn proc(n: i16)) { f(1); }

shared_mutable_capture :: proc() {
	n := 0;
	bump := proc(m: i16) capture(&mut n) { n += int(m); };
	parallel {
		spawn call_i16(bump);
		spawn call_i16(bump);
	}
}

shared_read_capture :: proc() {
	n := 0;
	look := proc(m: i16) capture(&n) { _ = n + int(m); };
	parallel {
		spawn call_i16(look);
		spawn call_i16(look);
	}
}

call_i64 :: proc(f: dyn proc(n: i64)) { f(1); }

already_erased :: proc(f: dyn proc(n: i64)) {
	parallel { spawn call_i64(f); }
}

// Thread affinity.

Window :: struct @(thread_affine) { handle: int }

call_f32 :: proc(f: dyn proc(x: f32)) { f(1); }
call_moved :: proc(f: move $C) where interfaces.Callable(C, proc()) { f(); }

affine_view :: proc() {
	w := Window{1};
	show := proc(x: f32) capture(&w) { _ = w.handle; };
	parallel { spawn call_f32(show); }
}

affine_moved :: proc() {
	w := Window{1};
	show := proc() capture(&w) { _ = w.handle; };
	parallel { spawn call_moved(move(show)); }
}

// The join check.

sender_kept :: proc() {
	jobs := thread.Channel(int).init(4);
	send, receive := jobs.split();
	drain := proc() capture(move(receive)) { foreach (job in receive) {} };
	parallel {
		spawn call_moved(move(drain));
	}
	_ = send.send(1);
}

sender_dropped :: proc() {
	jobs := thread.Channel(int).init(4);
	send, receive := jobs.split();
	drain := proc() capture(move(receive)) { foreach (job in receive) {} };
	parallel {
		spawn call_moved(move(drain));
		drop(send);
	}
}

// Pools.

call_f64 :: proc(f: proc(x: f64)) { f(1); }
grow :: proc(x: f64) { buffer.append(int(x)); }

pooled_write :: proc() {
	pool := thread.Pool.init(2);
	seen := buffer[:];
	parallel (&pool) {
		spawn call_f64(grow);
	}
	fmt.println(seen.len());
}

main :: proc() {
	view = &mut values[:];
	value_writes();
	literal_writes();
	slot_writes();
	job := Job{write_u32};
	field_writes(&job);
	value_reaches();
	fmt.println(value_clean());
	clean_beside_dirty();
	serial_dirty();
	one_arena();
	two_arenas();
	captured_arena();
	shared_mutable_capture();
	shared_read_capture();
	erased := proc(n: i64) capture(values) {};
	already_erased(erased);
	affine_view();
	affine_moved();
	sender_kept();
	sender_dropped();
	pooled_write();
}
