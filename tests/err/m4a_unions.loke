package main; import "core:fmt";

Value :: union { flag: bool, number: i32 }
Duplicate_Names :: union { n: i32, n: bool }
@(align=3) Bad_Align :: union { n: i32 }
Bad_Payload :: union { nothing: void }

// `@(zero=)` may only name the first variant, because the zero value has to
// stay all-zero.
@(zero=second) Late_Zero :: union { first: i32, second: }
@(zero=missing) No_Such_Zero :: union { first: }

// Tag 0 alone is not the all-zero representation: the payload beside it has to
// be all-zero too, and a union with no zero of its own is not.
@(zero=first) No_Zero_Payload :: union { first: Value, second: }

// `@(failure=)` designates one of exactly two variants.
@(failure=c) Three_Way :: union { a: i32, b: bool, c: }
@(failure=missing) No_Such_Failure :: union { a: i32, b: }

@(failure=bad) Outcome :: union { good: i32, bad: }

not_fallible :: proc() -> bool { return true; }
outcome :: proc() -> Outcome { return .good(1); }

// A record result is one value, and not a failure-designated union, so there is
// nowhere for `or_return` to put the failure.
several :: proc() -> (first: int, second: int) {
	x := outcome() or_return;
	return {first = x, second = 2};
}

// And one whose result is not a failure-designated union has nowhere to put it.
wrong_result :: proc() -> int {
	return outcome() or_return;
}

main :: proc() {
	v: Value = .number(1);

	// Construction: every arity and shape mistake has its own diagnostic.
	w: Value = .number();       // a payload variant with no payload
	x: Value = .number(1, 2);   // two payloads where one is taken
	n: Value = .number(p = 1);   // a named payload
	y: Value = .flag;           // a payload variant written as a complete one
	z: Value = 1;               // an implicit payload conversion
	q: Three_Way = .c(1);       // a payload where the variant takes none

	// A switch matches values, not types.
	plain := 1;
	switch (plain) {
	case int:
		fmt.println(0);
	}

	// A union case names a variant, not a type.
	switch (v) {
	case i32:
		fmt.println(1);
	}

	// With no default, every variant must be covered.
	switch (v) {
	case .number:
		fmt.println(1);
	}

	// A variant that is not there at all.
	switch (v) {
	case .flag:
	case .missing:
	}

	// `or_else` needs a union with a designated failure variant on its left.
	b := not_fallible() or_else true;

	// Only a `Unit` payload may be left out.
	r: Result(i32, bool) = .ok;

	fmt.println(b, w, x, y, z, q, r);
}
