package main; import "core:fmt";

// consolidation-provenance-plan.md step 5: the cases that content provenance
// turned from silently accepted into rejections. Each one is the wrapped form
// of a borrow whose bare form was already refused, which is the whole point:
// putting a borrow inside a value must not lose what the value owes.
//
// These came out of tests/run/m5b_aggregate_baseline.loke and
// tests/run/m5b_trust_boundary.loke, where they were labelled as gaps.

Holder :: struct { view: []int }
Pair :: struct { left: []int, right: []int }
Choice :: union { Holder, int }
Handle :: struct { target: ^int }

// The bare form is `returns_a_local_array` in tests/err/m5b_escape.loke.
// Wrapping it in a record used to hide the escape.
wrap_a_local :: proc() -> Holder {
	local := [3]int{1, 2, 3};
	return Holder{local[:]};
}

// A union alternative hid it the same way a field did.
inject_a_local :: proc() -> Choice {
	local := [3]int{1, 2, 3};
	return Holder{local[:]};
}

// `pair.left` is a read-only view of `numbers`, so the write conflicts with it
// exactly as it would if the view were held in a bare local.
field_write_conflict :: proc() -> int {
	numbers := [3]int{1, 2, 3};
	others := [3]int{4, 5, 6};
	pair := Pair{numbers[:], others[:]};
	numbers[0] = 9;
	return pair.left[0] + pair.right[0];
}

// design.md listed an alias hidden inside a user pointer-containing record as
// unchecked. It is checked now: `h.target` and `value` are the same storage.
hidden_alias :: proc() -> int {
	value := 1;
	h := Handle{&value};
	value = 2;
	return h.target^;
}

// Consuming a value hands on what it held, so the escape survives the move.
move_a_local :: proc() -> Holder {
	local := [3]int{1, 2, 3};
	held := Holder{local[:]};
	return move(held);
}

impl Holder {
	take :: proc(self: move Holder) -> []int { return self.view; }
}

consume_a_local :: proc() -> []int {
	local := [3]int{1, 2, 3};
	held := Holder{local[:]};
	return move(held).take();
}

// A type switch binds the alternative's value, so what it holds travels in.
extract_a_local :: proc() -> []int {
	local := [3]int{1, 2, 3};
	choice: Choice = Holder{local[:]};
	switch (value in choice) {
	case Holder: return value.view;
	case int:    return nil;
	}
	return nil;
}

// So does a `foreach` element.
iterate_a_local :: proc() -> []int {
	local := [3]int{1, 2, 3};
	holders := [2]Holder{Holder{local[:]}, Holder{local[:]}};
	foreach (h in holders) {
		return h.view;
	}
	return nil;
}

// A helper returning one field substitutes that field's root at the caller, so
// each of these names the array it actually borrows.
only_left :: proc(p: Pair) -> []int { return p.left; }
only_right :: proc(p: Pair) -> []int { return p.right; }

escape_through_a_field :: proc() -> []int {
	numbers := [3]int{1, 2, 3};
	others := [3]int{4, 5, 6};
	return only_left(Pair{numbers[:], others[:]});
}

escape_through_the_other_field :: proc() -> []int {
	numbers := [3]int{1, 2, 3};
	others := [3]int{4, 5, 6};
	return only_right(Pair{numbers[:], others[:]});
}

// A container carries what its elements hold, so what the value read back
// borrows is the local array and not the local table.
map_from_a_local :: proc() -> []int {
	table: map[string]Holder;
	numbers := [3]int{1, 2, 3};
	table["a"] = Holder{numbers[:]};
	held, ok := table.lookup_value("a");
	return held.view if ok else nil;
}

array_from_a_local :: proc() -> []int {
	holders: [dynamic]Holder;
	numbers := [3]int{1, 2, 3};
	holders.append(Holder{numbers[:]});
	return holders[0].view;
}

// A container-held borrow is a live borrow of its source.
container_held_borrow :: proc() -> int {
	numbers := [3]int{1, 2, 3};
	holders: [dynamic]Holder;
	holders.append(Holder{numbers[:]});
	numbers[0] = 9;
	return holders[0].view[0];
}

// An entry pointer is a borrow of the container's storage, so it cannot outlive
// the container even when what the entry holds would.
entry_pointer_escapes :: proc(values: []int) -> ^mut Holder {
	table: map[string]Holder;
	table["a"] = Holder{values};
	slot, found := table.find("a");
	return slot if found else nil;
}

// A small fixed array gives each element its own place, but only where the index
// says which one. An unknown index could be either, so it names both.
unknown_index :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	which := len(values) - 1;
	holders := [2]Holder{Holder{values}, Holder{local[:]}};
	return holders[which].view;
}

// And a write at an unknown index reaches one element without saying which, so
// it cannot erase what the others hold.
unknown_write :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	which := len(values) - 1;
	holders := [2]Holder{Holder{values}, Holder{local[:]}};
	holders[which] = Holder{values};
	return holders[1].view;
}

main :: proc() {
	fmt.println(1);
}
