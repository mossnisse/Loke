package main; import "core:unsafe";

// design.md "Uninitialized capacity": what an `Uninit(T)` does not have, and
// the shapes its three operations take.

Slot :: struct($T: type) { item: Uninit(T) }

Holder :: struct { items: [dynamic]int }

// The storage is reached through `core:unsafe` and by no other route.
reach :: proc(slot: inout Slot(int)) -> int {
	return slot.item.value;
}

// It has no `==`, and a managed `T` gives it no copy, as the record holding it
// has none without a `hook(copy)` of its own.
whole :: proc(a: Slot(int), b: Slot(int), owned: ^Slot(string)) -> bool {
	copied := owned^;
	return a.item == b.item;
}

// A variable's liveness is tracked, so neither operation may name one: `move`
// takes its value out and an ordinary assignment puts one back.
variables :: proc() {
	xs := [dynamic]int{1};
	ys := [dynamic]int{2};
	_ = unsafe.take(xs);
	unsafe.write(ys, [dynamic]int{3});
}

shapes :: proc(h: inout Holder, slot: inout Slot(int)) {
	_ = unsafe.take(h.items, 1);
	unsafe.write(h.items);
	_ = unsafe.take(7);
	unsafe.write(slot.item, "text");
	_ = unsafe.storage(slot.item);
	_ = unsafe.storage(&h.items);
	_ = unsafe.storage(&slot.item, 1);
}

// A `^Uninit(T)` lends a `^T`, which writes nothing.
read_only :: proc(slot: ^Slot(int)) {
	unsafe.storage(&slot.item)^ = 1;
	unsafe.write(slot.item, 1);
}

main :: proc() {
	h: Holder = {};
	slot: Slot(int) = {};
	variables();
	shapes(inout h, inout slot);
	read_only(&slot);
	_ = reach(inout slot);
}
