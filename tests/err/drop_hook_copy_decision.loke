// design.md "Lifecycle hooks and resource types": a record with `hook(drop)` says
// in writing how it is copied.
package main;

// No decision: the first note names the hook, and the others the three fixes.
Handle :: struct { fd: int }
impl Handle {
	close :: hook(drop) proc(self: inout Handle) {}
}

// The hook may sit in any `impl` block of the record.
Split :: struct { fd: int }
impl Split {
	read :: proc(self) -> int { return self.fd; }
}
impl Split {
	close :: hook(drop) proc(self: inout Split) {}
}

// A generic record is decided once, at its template: instantiated twice here, and
// never at all below.
Chain :: struct($T: type) { value: T }
impl Chain($T) {
	close :: hook(drop) proc(self: inout) {}
}
Unused :: struct($T: type) { value: T }
impl Unused($T) {
	close :: hook(drop) proc(self: inout) {}
}

// A move-only field does not count as the decision, and only `move_only` is
// offered, since the other two fixes cannot apply.
@(move_only) Token :: struct { id: int }
Holder :: struct { token: Token }
impl Holder {
	close :: hook(drop) proc(self: inout Holder) {}
}

// A hook another diagnostic rejects does not ask for a decision too.
Wrong :: struct { fd: int }
impl Wrong {
	close :: hook(drop) proc(self) {}
}
Plain :: struct { fd: int }
Named :: distinct Plain;
impl Named {
	close :: hook(drop) proc(self: inout Named) {}
}

// Of two drop hooks, the first is valid and asks for the decision.
Twice :: struct { fd: int }
impl Twice {
	close :: hook(drop) proc(self: inout Twice) {}
	shut :: hook(drop) proc(self: inout Twice) {}
}

// A decision, in each of its forms: none of these report.
@(move_only) Decided :: struct { fd: int }
impl Decided {
	close :: hook(drop) proc(self: inout Decided) {}
}
Copied :: struct { fd: int }
impl Copied {
	close :: hook(drop) proc(self: inout Copied) {}
	copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Copied, Allocator_Error) {
		return .ok(Copied{self.fd});
	}
}
@(fieldwise_copy) Fields :: struct { fd: int }
impl Fields {
	close :: hook(drop) proc(self: inout Fields) {}
}
@(fieldwise_copy) Cell :: struct($T: type) { value: T }
impl Cell($T) {
	close :: hook(drop) proc(self: inout) {}
}
@(move_only) Moved :: struct($T: type) { value: T }
impl Moved($T) {
	close :: hook(drop) proc(self: inout) {}
}

// No hook, nothing to decide.
Bare :: struct { fd: int }

twice :: proc($T: type) {
	// Instantiated twice, and reported once.
	Inner :: struct { fd: int }
	impl Inner {
		close :: hook(drop) proc(self: inout Inner) {}
	}
}

main :: proc() {
	a := Chain(int){1};
	b := Chain(string){"b"};
	_, _ = a, b;
	twice(int);
	twice(string);

	Local :: struct { fd: int }
	impl Local {
		close :: hook(drop) proc(self: inout Local) {}
	}

	// The hook comes in a nested block, which is still this body.
	Later :: struct { fd: int }
	{
		impl Later {
			close :: hook(drop) proc(self: inout Later) {}
		}
	}

	@(move_only) Fine :: struct { fd: int }
	impl Fine {
		close :: hook(drop) proc(self: inout Fine) {}
	}
}

// A generic record's `hook(copy)` decides only for the instances its block covers:
// one in a block of some instances leaves the drop hook's others undecided.
Narrow :: struct($T: type) { value: T }
impl Narrow($T) {
	close :: hook(drop) proc(self: inout) {}
}
impl Narrow(int) {
	copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Narrow(int), Allocator_Error) {
		return .ok(Narrow(int){self.value});
	}
}
// The drop hook's own block, or one over every instance, decides: these report nothing.
Same :: struct($T: type) { value: T }
impl Same(int) {
	close :: hook(drop) proc(self: inout) {}
	copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Same(int), Allocator_Error) {
		return .ok(Same(int){self.value});
	}
}
Wide :: struct($T: type) { value: T }
impl Wide(int) {
	close :: hook(drop) proc(self: inout) {}
}
impl Wide($T) {
	copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Wide(T), Allocator_Error) where is_copyable(T) {
		return .ok(Wide(T){self.value});
	}
}
// A repeated `$` name matches only instances whose arguments are equal, so it is
// not a block over every instance.
Pair :: struct($A: type, $B: type) { a: A, b: B }
impl Pair($A, $B) {
	close :: hook(drop) proc(self: inout) {}
}
impl Pair($T, $T) {
	copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Pair(T, T), Allocator_Error) where is_copyable(T) {
		return .ok(Pair(T, T){self.a, self.b});
	}
}
