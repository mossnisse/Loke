// standard-library.md "`core:fmt`": `zero_pad` pads an integer, so another
// value is rejected at the call by its `interfaces.Integral` bound. A `rune` is
// `Integral` but prints as its character, so it is rejected too.
package main;
import "core:fmt";

main :: proc() {
	fmt.println(fmt.zero_pad("seven", 3));
	fmt.println(fmt.zero_pad(1.5, 3));
	fmt.println(fmt.zero_pad('A', 3));
	fmt.println(fmt.zero_pad('-', 3));
	fmt.println(fmt.zero_pad(int('A'), 3));
}
