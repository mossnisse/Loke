package main;

// A map key is copied in and out, so a move-only one is rejected where the map
// type is named, including through a generic instantiation.
@(move_only) Key :: struct { id: int }
@(move_only) Other :: struct { id: int }

Table :: struct($K: type) {
	entries: map[K]int,
}

main :: proc() {
	m: map[Key]int = {};
	t: Table(Other) = {};
}
