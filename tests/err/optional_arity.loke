package main; import "core:fmt";

// design.md: a destination never changes what a producer returns. Absence and
// failure are types now, so `m[key]` is still a single-value read and the
// shapes that used to grow a trailing `bool` are `Option`-producing operations
// of their own.

Value :: union { flag: bool, number: i32 }

Plain :: struct { n: int }

// `lookup_value` copies the element out, which a move-only element has no way
// to do. `find` and `find_ref` still borrow one.
Token :: move_only struct { id: int }

main :: proc() {
	v: Value = .number(1);
	m: map[string]int = {};

	// The obsolete optional-ok arities.
	c, present := m["x"];
	d := m["x"] or_else 3;

	// A union is inspected by `switch`; neither extraction spelling applies to
	// one any more.
	e := v.(i32);
	f := v.as(i32);

	// `lookup_value` does not exist on anything but a map.
	p := Plain{1};
	q := p.lookup_value("x");

	// A move-only element cannot be copied out.
	tokens: map[int]Token = {};
	r := tokens.lookup_value(1);

	fmt.println(c, present, d, e, f, q, r);
}

erased :: proc(view: any_view) {
	// `as` names the requested type as its one positional argument.
	g := view.as();
	h := view.as(int, bool);
	i := view.as(t = int);

	// And a move-only type cannot be copied out of an erased view, whichever
	// spelling asks for it.
	value := view.as(Token);
	trapped := view.(Token);
	fmt.println(g, h, i, value, trapped.id);
}
