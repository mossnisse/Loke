// design.md "Borrowing iteration": a lent element borrows its source, so a
// view of it cannot outlive a local or temporary source, and the source
// cannot be changed while the traversal or a view of an element is in use.
// `&item` borrows the source even when the element holds borrows of its own.
// A source reached through a pointer cannot be grown during its traversal, nor
// through a pointer to that pointer, also when the header slices it.
package main;

import "core:fmt";
import "core:strings";

make_items :: proc() -> [dynamic]string {
	items := make([dynamic]string, 0, 1);
	items.append(strings.copy("temporary"));
	return items;
}

local_source :: proc() -> string_view {
	items := make([dynamic]string, 0, 1);
	items.append(strings.copy("local"));
	foreach (item in items) { return item; }
	return "";
}

temporary_source :: proc() -> string_view {
	foreach (item in make_items()) { return item; }
	return "";
}

slice_reassigned :: proc(items: []string, other: []string) {
	view := items;
	foreach (item in view) {
		view = other;
		fmt.println(item);
	}
}

grown_under_view :: proc(items: ^mut [dynamic]string) {
	kept: string_view = "";
	foreach (item in items^) { kept = item; }
	items.append(strings.copy("more"));
	fmt.println(kept);
}

first_slot :: proc(items: ^[1]string_view) -> ^string_view {
	foreach (item in items^) { return &item; }
	panic("empty");
}

array_slot_escapes :: proc() -> ^string_view {
	values := [1]string_view{"hello"};
	return first_slot(&values);
}

Views :: struct { items: [dynamic]string_view }

first_view_slot :: proc(views: ^Views) -> ^string_view {
	foreach (item in views.items) { return &item; }
	panic("empty");
}

dynamic_slot_escapes :: proc() -> ^string_view {
	views := Views{make([dynamic]string_view, 0, 1)};
	views.items.append("hello");
	return first_view_slot(&views);
}

grown_during_traversal :: proc(items: ^mut [dynamic]int) {
	foreach (item in items^) { items.append(item); }
}

grown_during_mutable_traversal :: proc(items: ^mut [dynamic]int) {
	foreach (&mut item in items^) { items.append(item); }
}

Counts :: struct { values: [dynamic]int, total: int }

field_grown_during_traversal :: proc(counts: ^mut Counts) {
	foreach (value in counts.values) { counts.values.append(value); }
}

grown_two_pointers_away :: proc(p: ^mut ^mut [dynamic]int) {
	foreach (item in p^^) { p^.append(item); }
}

grown_two_pointers_away_mutably :: proc(p: ^mut ^mut [dynamic]int) {
	foreach (&mut item in p^^) { p^.append(item); }
}

Holder :: struct { items: ^mut [dynamic]int }

grown_through_held_pointer :: proc(holder: ^mut Holder) {
	foreach (item in holder.items^) { holder.items.append(item); }
}

grown_during_sliced_traversal :: proc(p: ^mut ^mut [dynamic]int) {
	foreach (item in p^^[1:]) { p^.append(item); }
}

grown_during_sliced_held_traversal :: proc(holder: ^mut Holder) {
	foreach (item in holder.items^[:]) { holder.items.append(item); }
}

main :: proc() {}
