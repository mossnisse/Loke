package main; import "core:fmt";

Colour :: enum { Red, Green, Blue }

partial :: proc(c: Colour) {
	switch (c) {
	case .Red:
		fmt.println(1);
	}
}

duplicated :: proc(n: int) {
	switch (n) {
	case 1:
		fmt.println(1);
	case 1:
		fmt.println(2);
	case:
		fmt.println(3);
	}
}

open :: proc(n: int) {
	switch (n) {
	case 1:
		fmt.println(1);
	}
}

// The removed header binding `switch (name in subject)` is reported once.
Shape :: union { circle: f64, empty }

header_binding :: proc(shape: Shape) {
	switch (radius in shape) {
	case .circle: fmt.println(radius);
	case .empty:
	}
}

// An `any_view` lends read-only, so its case binding cannot be `&mut`.
erased_mut :: proc(value: any_view) {
	switch (value) {
	case int(&mut n): fmt.println(n);
	default:
	}
}

main :: proc() {
	partial(Colour.Red);
	duplicated(1);
	open(1);
	header_binding(.empty);
	erased_mut(1);
}
