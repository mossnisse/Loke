package main; import "core:fmt";

Colour :: enum { Red, Green, Blue }

partial :: proc(c: Colour) {
	switch (c) {
	case .Red:
		fmt.println(1);
	}
}

duplicated :: proc(n: int) {
	switch (n) {
	case 1:
		fmt.println(1);
	case 1:
		fmt.println(2);
	case:
		fmt.println(3);
	}
}

open :: proc(n: int) {
	switch (n) {
	case 1:
		fmt.println(1);
	}
}

main :: proc() {
	partial(Colour.Red);
	duplicated(1);
	open(1);
}
