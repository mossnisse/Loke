// design.md "Lifecycle hooks and resource types", "defer statement": a record
// declaration a `defer` wraps directly stays visible to the body and states its
// copy decision as any other does.
package main;

plain :: proc() {
	defer Handle :: struct { fd: int }
	impl Handle {
		close :: hook(drop) proc(self: inout Handle) {}
	}
}

failing :: proc() -> Result(int, string) {
	errdefer Failing :: struct { fd: int }
	impl Failing {
		close :: hook(drop) proc(self: inout Failing) {}
	}
	return .ok(1);
}

// Through a selected `when` branch, in either order, and beside a deferred `impl`.
through_when :: proc() {
	defer when (true) { Outer :: struct { fd: int } }
	impl Outer {
		close :: hook(drop) proc(self: inout Outer) {}
	}
}
within_when :: proc() {
	when (true) { defer Inner :: struct { fd: int } }
	impl Inner {
		close :: hook(drop) proc(self: inout Inner) {}
	}
}
deferred_impl :: proc() {
	defer Late :: struct { fd: int }
	defer impl Late {
		close :: hook(drop) proc(self: inout Late) {}
	}
}

// The attribute's own errors.
no_hook :: proc() {
	defer @(fieldwise_copy) Bare :: struct { fd: int }
}
moved :: proc() {
	defer @(move_only, fieldwise_copy) Moved :: struct { fd: int }
	impl Moved {
		close :: hook(drop) proc(self: inout Moved) {}
	}
}

// A decision, in each of its forms: none of these report.
decided :: proc() {
	defer @(move_only) Sole :: struct { fd: int }
	impl Sole {
		close :: hook(drop) proc(self: inout Sole) {}
	}
	defer @(fieldwise_copy) Fields :: struct { fd: int }
	impl Fields {
		close :: hook(drop) proc(self: inout Fields) {}
	}
	defer Copied :: struct { fd: int }
	impl Copied {
		close :: hook(drop) proc(self: inout Copied) {}
		copy :: hook(copy) proc(self, allocator: Allocator) -> Result(Copied, Allocator_Error) {
			return .ok(Copied{self.fd});
		}
	}
	defer Nothing :: struct { fd: int }
}
