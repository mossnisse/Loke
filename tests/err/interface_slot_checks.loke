package main;

// design.md "Interface bodies": slot names are unique across everything an
// interface composes. A diamond reaches one slot twice and is not a clash.
A :: interface($Self: type) { slot read: proc(self) -> int; }
B :: interface($Self: type) { slot read: proc(self) -> bool; }
Both :: interface($Self: type) { A(Self); B(Self); }

Left :: interface($Self: type) { A(Self); }
Right :: interface($Self: type) { A(Self); }
Diamond :: interface($Self: type) { Left(Self); Right(Self); }

// A bound `$N` that does not fit the parameter type is reported, not left for
// the backend.
Small :: interface($Self: type, $Limit: u8) {}

fits :: proc(x: $T, $N: int) -> bool {
	return Small(T, $N);
}

// The report shows the value as written, not the encoding that keys the
// generic cache.
Whole :: interface($Self: type, $Limit: int) {}

whole :: proc(x: $T, $F: f64) -> bool {
	return Whole(T, $F);
}

main :: proc() {
	_ = fits(1, 3);
	_ = fits(1, 300);
	_ = whole(1, 1.5);
}
