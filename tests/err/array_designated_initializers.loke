package main;

// design.md "Fixed arrays": a designated element names a constant index or
// index range inside the array, once, after the positional elements.
main :: proc() {
	n := 1;
	after := [3]int{1 = 2, 3};
	twice := [3]int{0..=1 = 4, 1 = 5};
	outside := [3]int{3 = 1};
	runtime := [3]int{n = 1};
	empty := [3]int{2..<2 = 1};
	lanes := Simd(int, 4){1 = 2};
	_ = after;
	_ = twice;
	_ = outside;
	_ = runtime;
	_ = empty;
	_ = lanes;
}
