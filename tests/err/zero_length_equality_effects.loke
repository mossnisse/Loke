package main;

import "core:fmt";

// design.md "Global write effects": beside tests/run/zero_length_equality_effects.loke,
// the elements that do exist count, and so does a `==` declared for a zero-length
// array's own type, which runs whatever its length.

values: [dynamic]int = {};

Clears :: struct { id: int }
impl Clears {
	equal :: operator(==) proc(a, b: Clears) -> bool { values = {}; return true; }
	hash :: proc(self, seed: uint) -> uint { values = {}; return seed; }
}

Holds :: struct { none: [0]Clears, one: Clears }

Own :: distinct [0]Clears;
impl Own {
	equal :: operator(==) proc(a, b: Own) -> bool { values = {}; return true; }
}

one_element :: proc(a, b: [1]Clears) {
	borrowed := values[:];
	fmt.println(a == b);
	fmt.println(borrowed[0]);
}
a_field_beside_it :: proc(a, b: Holds) {
	borrowed := values[:];
	fmt.println(a == b);
	fmt.println(borrowed[0]);
}
its_own_equality :: proc(a, b: Own) {
	borrowed := values[:];
	fmt.println(a == b);
	fmt.println(borrowed[0]);
}
a_hash :: proc(a: [1]Clears) {
	borrowed := values[:];
	fmt.println(a.hash(1));
	fmt.println(borrowed[0]);
}
a_key :: proc(a: [1]Clears, table: map[[1]Clears]int) {
	borrowed := values[:];
	fmt.println(a in table);
	fmt.println(borrowed[0]);
}

main :: proc() {}
