package main; import "core:mem"; import "core:fmt";

R :: struct { x: int }

impl R {
	// Every hook has a signature fixed by the type.
	release :: hook(drop) proc(self) { }
	// `clone` is generated from `try_clone` and is never written.
	clone :: proc(self, allocator: Allocator) -> R { return self; }
}

S :: struct { y: int }

impl S {
	copy_owned :: hook(copy) proc(self) -> S { return self; }
}

T :: struct { w: int }

impl T {
	// The allocator default is supplied by the compiler until `core:mem` is
	// nameable in M6, so a written one is rejected.
	copy_owned :: hook(copy) proc(self, allocator: Allocator = mem.default_allocator()) -> Result(T, Allocator_Error) {
		return .ok(self);
	}
}

Move_Only :: move_only struct { z: int }

impl Move_Only {
	copy_anyway :: hook(copy) proc(self, allocator: Allocator) -> Result(Move_Only, Allocator_Error) {
		return .ok(Move_Only{});
	}
}

Resource :: struct { live: bool }

impl Resource {
	release :: hook(drop) proc(self: inout Resource) { self.live = false; }
	release_again :: hook(drop) proc(self: inout Resource) { self.live = false; }
}

main :: proc() {
	// A move-only value has no copy entry point to allocate through.
	m := Move_Only{1};
	bad := new_clone(m);
	r := Resource{true};
	r.release();

	// Arity and operand shape of the allocation built-ins and `drop`.
	bad_new := new(int, a, a);
	handle := mem.default_allocator(1);
	drop();

	fmt.println(1);
}
