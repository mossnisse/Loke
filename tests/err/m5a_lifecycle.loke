package main;

R :: struct { x: int }

impl R {
	// Every hook has a signature fixed by the type.
	drop :: proc(self) { }
	// `clone` is generated from `try_clone` and is never written.
	clone :: proc(self, allocator: Allocator) -> R { return self; }
}

S :: struct { y: int }

impl S {
	try_clone :: proc(self) -> S { return self; }
}

T :: struct { w: int }

impl T {
	// The allocator default is supplied by the compiler until `core:mem` is
	// nameable in M6, so a written one is rejected.
	try_clone :: proc(self, allocator: Allocator = default_allocator()) -> (T, Allocator_Error) {
		return self, nil;
	}
}

Move_Only :: struct { z: int }

impl Move_Only {
	try_clone :: ---;
}

main :: proc() {
	// M5a frees only a binding initialised directly by `new`/`new_clone`.
	p, err := new(int);
	alias := p;
	free(alias);
	free(p);

	// A move-only value has no copy entry point to allocate through.
	m := Move_Only{1};
	bad, berr := new_clone(m);

	// The allocation-root fact is consumed by `free`, so the binding is dead
	// afterwards, and a moved-from one is dead at its source.
	q, qerr := new(int);
	free(q);
	free(q);
	r, rerr := new(int);
	moved := move(r);
	free(r);

	// Arity and operand shape of the allocation built-ins and `drop`.
	bad_new := new(int, a, a);
	handle := default_allocator(1);
	drop();

	// A region reset needs M5b's region analysis.
	a := default_allocator();
	free_all(a);

	print_int(1);
}
