package main; import "core:fmt";

// Where compile-time `foreach` stops. The built-in traversals walk storage the
// evaluator holds, but a protocol iterator is `iter`/`next` — synthesized for
// the container views, written by hand for everything else — and neither is a
// body this can run. Refused by its own reason rather than the general one, so
// the boundary is visible when someone reaches it.
TOTAL :: total();

Cells :: struct { start: int }
Cells_Iterator :: struct { current: int }

impl Cells {
	Element  :: int;
	Iterator :: Cells_Iterator;
	iter :: proc(self) -> Cells_Iterator { return {self.start}; }
}

impl Cells_Iterator {
	next :: proc(self: inout Cells_Iterator) -> Option(int) {
		if (self.current <= 0) { return .none; }
		value := self.current;
		self.current -= 1;
		return .some(value);
	}
}

total :: proc() -> int {
	sum := 0;
	foreach (cell in Cells{3}) {
		sum += cell;
	}
	return sum;
}

main :: proc() {
	fmt.println(TOTAL);
}
