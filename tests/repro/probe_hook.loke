// tests/repro_test.odin copies this beside `core:math/repro`'s own files, so
// the probe can call the slow path, which the package does not export.
package repro;

import "core:unsafe";

@(public)
slow_exp :: proc(x: f64) -> f64 {
	return unsafe.transmute(f64, exp_slow(x, F64_LAYOUT));
}

@(public)
slow_exp_f32 :: proc(x: f32) -> f32 {
	return unsafe.transmute(f32, u32(exp_slow(f64(x), F32_LAYOUT)));
}

@(public)
slow_log :: proc(x: f64) -> f64 {
	return unsafe.transmute(f64, log_slow(x, F64_LAYOUT));
}

@(public)
slow_log_f32 :: proc(x: f32) -> f32 {
	return unsafe.transmute(f32, u32(log_slow(f64(x), F32_LAYOUT)));
}

// log2's and log10's slow paths past the special cases of `log`, which
// `log2` and `log10` themselves answer.
@(public)
slow_log2 :: proc(x: f64) -> f64 { return slow_log_base(x, 0); }

@(public)
slow_log10 :: proc(x: f64) -> f64 { return slow_log_base(x, 1); }

@(public)
slow_log2_f32 :: proc(x: f32) -> f32 { return slow_log_base_f32(x, 0); }

@(public)
slow_log10_f32 :: proc(x: f32) -> f32 { return slow_log_base_f32(x, 1); }

slow_log_base :: proc(x: f64, base: int) -> f64 {
	if (!(x > 0.0 && x <= 1.7976931348623157e308) || x == 1.0) { return log_base(x, base); }
	return unsafe.transmute(f64, log_base_slow(x, base, F64_LAYOUT));
}

slow_log_base_f32 :: proc(x: f32, base: int) -> f32 {
	if (!(x > f32(0.0) && f64(x) <= 1.7976931348623157e308) || x == f32(1.0)) { return log_base_f32(x, base); }
	return unsafe.transmute(f32, u32(log_base_slow(f64(x), base, F32_LAYOUT)));
}

@(public)
slow_sin :: proc(x: f64) -> f64 { return slow_trig(x, false); }

@(public)
slow_cos :: proc(x: f64) -> f64 { return slow_trig(x, true); }

@(public)
slow_sin_f32 :: proc(x: f32) -> f32 { return slow_trig_f32(x, false); }

@(public)
slow_cos_f32 :: proc(x: f32) -> f32 { return slow_trig_f32(x, true); }

// The public procedures' tiny-argument and special cases come first; past
// them the slow path is the whole answer.
slow_trig :: proc(x: f64, want_cos: bool) -> f64 {
	ax := x;
	if (x < 0.0) { ax = 0.0 - x; }
	return unsafe.transmute(f64, trig_slow(ax, want_cos, !want_cos && x < 0.0, F64_LAYOUT));
}

slow_trig_f32 :: proc(x: f32, want_cos: bool) -> f32 {
	ax := f64(x);
	if (x < f32(0.0)) { ax = 0.0 - f64(x); }
	return unsafe.transmute(f32, u32(trig_slow(ax, want_cos, !want_cos && x < f32(0.0), F32_LAYOUT)));
}

// tan's slow path past its tiny arguments and special cases, where `tan`
// itself is the whole answer.
@(public)
slow_tan :: proc(x: f64) -> f64 {
	ax := x;
	if (x < 0.0) { ax = 0.0 - x; }
	if (!(ax >= 7.450580596923828e-09 && ax <= 1.7976931348623157e308)) { return tan(x); }
	return unsafe.transmute(f64, tan_slow(ax, x < 0.0, F64_LAYOUT));
}

@(public)
slow_tan_f32 :: proc(x: f32) -> f32 {
	ax := f64(x);
	if (x < f32(0.0)) { ax = 0.0 - f64(x); }
	if (!(ax >= 0.000244140625 && ax <= 1.7976931348623157e308)) { return tan_f32(x); }
	return unsafe.transmute(f32, u32(tan_slow(ax, x < f32(0.0), F32_LAYOUT)));
}

// pow's slow path wherever `pow` would reach its general case with z =
// y log x in range; elsewhere `pow` itself, whose table and range checks
// are the whole answer there.
@(public)
slow_pow :: proc(x: f64, y: f64) -> f64 {
	ax := x;
	if (x < 0.0) { ax = 0.0 - x; }
	kind := integer_kind(y);
	if (!pow_general(ax, y) || (x < 0.0 && kind == 0)) { return pow(x, y); }
	lh, _ := pow_log(ax);
	zh := y*lh;
	if (zh > 710.0 || zh < -746.0 || (zh < 2.7755575615628914e-17 && zh > -2.7755575615628914e-17)) { return pow(x, y); }
	result := unsafe.transmute(f64, pow_slow(ax, y, zh, F64_LAYOUT));
	if (x < 0.0 && kind == 1) { return 0.0 - result; }
	return result;
}

@(public)
slow_pow_f32 :: proc(x: f32, y: f32) -> f32 {
	ax := f64(x);
	if (x < f32(0.0)) { ax = 0.0 - f64(x); }
	kind := integer_kind(f64(y));
	if (!pow_general(ax, f64(y)) || (x < f32(0.0) && kind == 0)) { return pow_f32(x, y); }
	lh, _ := pow_log(ax);
	zh := f64(y)*lh;
	if (zh > 89.0 || zh < -104.0 || (zh < 1.4901161193847656e-08 && zh > -1.4901161193847656e-08)) { return pow_f32(x, y); }
	result := unsafe.transmute(f32, u32(pow_slow(ax, f64(y), zh, F32_LAYOUT)));
	if (x < f32(0.0) && kind == 1) { return f32(0.0) - result; }
	return result;
}

// atan2's slow path wherever `atan2` would reach its fast path; elsewhere
// `atan2` itself, whose table and tiny quotients are the whole answer there.
@(public)
slow_atan2 :: proc(y: f64, x: f64) -> f64 {
	ay := y;
	if (y < 0.0) { ay = 0.0 - y; }
	ax := x;
	if (x < 0.0) { ax = 0.0 - x; }
	if (!finite_nonzero(ay) || !finite_nonzero(ax)) { return atan2(y, x); }
	part, gap, nf, df := atan2_split(ay, ax, x < 0.0);
	if (gap < -101) { return atan2(y, x); }
	n, d := atan2_operands(gap, nf, df);
	result := unsafe.transmute(f64, atan2_slow(n, d, part, F64_LAYOUT));
	if (y < 0.0) { return 0.0 - result; }
	return result;
}

@(public)
slow_atan2_f32 :: proc(y: f32, x: f32) -> f32 {
	ay := f64(y);
	if (y < f32(0.0)) { ay = 0.0 - f64(y); }
	ax := f64(x);
	if (x < f32(0.0)) { ax = 0.0 - f64(x); }
	if (!finite_nonzero(ay) || !finite_nonzero(ax)) { return atan2_f32(y, x); }
	part, gap, nf, df := atan2_split(ay, ax, x < f32(0.0));
	if (gap < -101) { return atan2_f32(y, x); }
	n, d := atan2_operands(gap, nf, df);
	result := unsafe.transmute(f32, u32(atan2_slow(n, d, part, F32_LAYOUT)));
	if (y < f32(0.0)) { return f32(0.0) - result; }
	return result;
}

// asin's and acos's slow paths past their tiny arguments and special
// cases, below 2^-27 for asin, 2^-12 for asin_f32, and 2^-60 for acos;
// there the public procedure is the whole answer.
@(public)
slow_asin :: proc(x: f64) -> f64 {
	a := x;
	if (x < 0.0) { a = 0.0 - x; }
	if (!(a >= 7.450580596923828e-09 && a < 1.0)) { return asin(x); }
	result := unsafe.transmute(f64, slow_arc(a, false, false, F64_LAYOUT));
	if (x < 0.0) { return 0.0 - result; }
	return result;
}

@(public)
slow_asin_f32 :: proc(x: f32) -> f32 {
	a := f64(x);
	if (x < f32(0.0)) { a = 0.0 - f64(x); }
	if (!(a >= 0.000244140625 && a < 1.0)) { return asin_f32(x); }
	result := unsafe.transmute(f32, u32(slow_arc(a, false, false, F32_LAYOUT)));
	if (x < f32(0.0)) { return f32(0.0) - result; }
	return result;
}

@(public)
slow_acos :: proc(x: f64) -> f64 {
	a := x;
	if (x < 0.0) { a = 0.0 - x; }
	if (!(a >= 8.673617379884035e-19 && a < 1.0)) { return acos(x); }
	return unsafe.transmute(f64, slow_arc(a, true, x < 0.0, F64_LAYOUT));
}

@(public)
slow_acos_f32 :: proc(x: f32) -> f32 {
	a := f64(x);
	if (x < f32(0.0)) { a = 0.0 - f64(x); }
	if (!(a >= 8.673617379884035e-19 && a < 1.0)) { return acos_f32(x); }
	return unsafe.transmute(f32, u32(slow_arc(a, true, x < f32(0.0), F32_LAYOUT)));
}

slow_arc :: proc(a: f64, cosine: bool, x_negative: bool, layout: Float_Layout) -> u64 {
	a_small := a < from_bits(HALF_ROOT_ABOVE);
	wh, wl := arc_root(a);
	return arc_slow(a, wh + wl, a_small, arc_part(a_small, cosine, x_negative), layout);
}

// hypot's slow path wherever `hypot` would reach its general case;
// elsewhere `hypot` itself, whose special cases and far smaller second
// argument are the whole answer there.
@(public)
slow_hypot :: proc(x: f64, y: f64) -> f64 {
	return unsafe.transmute(f64, slow_hypot_bits(x, y, F64_LAYOUT, unsafe.transmute(u64, hypot(x, y))));
}

@(public)
slow_hypot_f32 :: proc(x: f32, y: f32) -> f32 {
	return unsafe.transmute(f32, u32(slow_hypot_bits(f64(x), f64(y), F32_LAYOUT, u64(unsafe.transmute(u32, hypot_f32(x, y))))));
}

slow_hypot_bits :: proc(x: f64, y: f64, layout: Float_Layout, public: u64) -> u64 {
	a := x;
	if (x < 0.0) { a = 0.0 - x; }
	b := y;
	if (y < 0.0) { b = 0.0 - y; }
	if (b > a) {
		t := a;
		a = b;
		b = t;
	}
	if (!finite_nonzero(a) || !finite_nonzero(b)) { return public; }
	near, a2, b2, ea := hypot_parts(a, b);
	if (!near) { return public; }
	ph, pl := two_product(a2, a2);
	qh, ql := two_product(b2, b2);
	s, e := two_sum(ph, qh);
	sh, sl := fast_two_sum(s, e + (pl + ql));
	wh, wl := pair_root(sh, sl);
	return hypot_slow(a2, b2, ea, wh + wl, layout);
}

finite_nonzero :: proc(a: f64) -> bool {
	return a > 0.0 && a <= 1.7976931348623157e308;
}

// Whether |x| and y are past pow's table: |x| finite, nonzero, and not 1,
// y finite and nonzero.
pow_general :: proc(ax: f64, y: f64) -> bool {
	ay := y;
	if (y < 0.0) { ay = 0.0 - y; }
	return ax > 0.0 && ax <= 1.7976931348623157e308 && ax != 1.0 && ay > 0.0 && ay <= 1.7976931348623157e308;
}
