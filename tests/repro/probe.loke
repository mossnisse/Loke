// tests/repro_test.odin: `core:math/repro`'s functions against their own slow
// paths over many seeded arguments, and the arguments and results it checks
// against the oracle. `probe:repro` is a copy of the package with
// `probe_hook.loke`.
package main;

import "core:fmt";
import "core:os";
import "core:unsafe";
import "probe:repro";

Generator :: struct { state: u64 }

next :: proc(g: inout Generator) -> u64 {
	g.state = g.state *% 6364136223846793005 +% 1442695040888963407;
	return g.state >> 11;
}

unit :: proc(g: inout Generator) -> f64 {
	return f64(next(inout g)) / 9007199254740992.0;
}

// 2^-e for e in 0 ..= 1000.
inverse_power :: proc(e: u64) -> f64 {
	return unsafe.transmute(f64, (1023 - e) << 52);
}

// Arguments over the whole range, subnormal results included; small ones of
// every scale; and arguments near overflow and near the bottom of the range.
argument :: proc(g: inout Generator, i: int) -> f64 {
	u := unit(inout g);
	switch (i % 4) {
	case 0: return u*1456.0 - 746.0;
	case 1:
		v := (1.0 + u)*inverse_power(next(inout g) % 61);
		if (next(inout g) % 2 == 0) { return 0.0 - v; }
		return v;
	case 2: return 709.775 + u*0.015;
	default: return u*0.4 - 745.3;
	}
}

argument_f32 :: proc(g: inout Generator, i: int) -> f32 {
	u := unit(inout g);
	switch (i % 4) {
	case 0: return f32(u*193.0 - 104.0);
	case 1:
		v := f32((1.0 + u)*inverse_power(next(inout g) % 30));
		if (next(inout g) % 2 == 0) { return f32(0.0) - v; }
		return v;
	case 2: return f32(88.70 + u*0.05);
	default: return f32(u*0.5 - 104.0);
	}
}

// Arguments of sin and cos: within pi/4, below 2^20 pi/2, of every magnitude
// up to 2^1023, and within a few ulps of a multiple of pi/2, where the
// reduction cancels most of the argument.
trig_argument :: proc(g: inout Generator, i: int) -> f64 {
	u := unit(inout g);
	v := 0.0;
	switch (i % 5) {
	case 0: v = (u*2.0 - 1.0)*0.79;
	case 1: v = (u*2.0 - 1.0)*1600000.0;
	case 2: v = (1.0 + u)*unsafe.transmute(f64, (1023 + next(inout g) % 1024) << 52);
	case 3:
		// A multiple of pi/2 rounded, then moved by up to 4 ulps.
		k := f64(1 + next(inout g) % 100000);
		near := k*1.5707963267948966;
		v = unsafe.transmute(f64, unsafe.transmute(u64, near) + next(inout g) % 9 - 4);
	default: v = (1.0 + u)*inverse_power(1 + next(inout g) % 27);
	}
	if (next(inout g) % 2 == 0) { return 0.0 - v; }
	return v;
}

trig_argument_f32 :: proc(g: inout Generator, i: int) -> f32 {
	u := unit(inout g);
	v := f32(0.0);
	switch (i % 5) {
	case 0: v = f32((u*2.0 - 1.0)*0.79);
	case 1: v = f32((u*2.0 - 1.0)*100000.0);
	case 2: v = f32((1.0 + u)*unsafe.transmute(f64, (1023 + next(inout g) % 127) << 52));
	case 3:
		k := f64(1 + next(inout g) % 10000);
		near := f32(k*1.5707963267948966);
		v = unsafe.transmute(f32, unsafe.transmute(u32, near) + u32(next(inout g) % 9) - 4);
	default: v = f32((1.0 + u)*inverse_power(1 + next(inout g) % 12));
	}
	if (next(inout g) % 2 == 0) { return f32(0.0) - v; }
	return v;
}

// Positive arguments of log: of every exponent, near 1 on either side,
// subnormal, and between 1/2 and 2.
log_argument :: proc(g: inout Generator, i: int) -> f64 {
	switch (i % 4) {
	case 0: return unsafe.transmute(f64, ((1 + next(inout g) % 2046) << 52) | (next(inout g) & 0x000fffffffffffff));
	case 1: return 1.0 + (unit(inout g)*2.0 - 1.0)*inverse_power(next(inout g) % 53);
	case 2: return unsafe.transmute(f64, 1 + next(inout g) % 0x000fffffffffffff);
	default: return 0.5 + unit(inout g)*1.5;
	}
}

log_argument_f32 :: proc(g: inout Generator, i: int) -> f32 {
	switch (i % 4) {
	case 0: return unsafe.transmute(f32, u32(((1 + next(inout g) % 254) << 23) | (next(inout g) & 0x7fffff)));
	case 1: return f32(1.0 + (unit(inout g)*2.0 - 1.0)*inverse_power(next(inout g) % 24));
	case 2: return unsafe.transmute(f32, u32(1 + next(inout g) % 0x7fffff));
	default: return f32(0.5 + unit(inout g)*1.5);
	}
}

// Arguments of pow: x up to 10 with y up to ±50; x near 1 with y of every
// scale up to 2^63; x of every exponent with y spanning results from
// overflow to underflow; negative x with integer y; x = m 2^-26, m odd and
// above 2^26.5, whose square is a midpoint; and small integers to half-
// integer powers, some of them exact.
pow_argument :: proc(g: inout Generator, i: int) -> (x: f64, y: f64) {
	u := unit(inout g);
	v := unit(inout g);
	switch (i % 6) {
	case 0: return {u*10.0, v*100.0 - 50.0};
	case 1:
		x := 1.0 + (u*2.0 - 1.0)*inverse_power(next(inout g) % 53);
		return {x, (v*2.0 - 1.0)*unsafe.transmute(f64, (1023 + next(inout g) % 64) << 52)};
	case 2:
		e := 1 + next(inout g) % 2046;
		x := unsafe.transmute(f64, (e << 52) | (next(inout g) & 0x000fffffffffffff));
		spread := 1000.0;
		if (e != 1023) { spread = 1100.0/f64(abs_difference(e, 1023)); }
		return {x, (v*2.0 - 1.0)*spread};
	case 3: return {0.0 - (0.25 + u*4.0), f64(next(inout g) % 81) - 40.0};
	case 4: return {f64(94906267 + 2*(next(inout g) % 19000000))/67108864.0, 2.0};
	default: return {f64(1 + next(inout g) % 20), f64(next(inout g) % 60)/2.0 - 10.0};
	}
}

pow_argument_f32 :: proc(g: inout Generator, i: int) -> (x: f32, y: f32) {
	u := unit(inout g);
	v := unit(inout g);
	switch (i % 6) {
	case 0: return {f32(u*10.0), f32(v*40.0 - 20.0)};
	case 1:
		x := f32(1.0 + (u*2.0 - 1.0)*inverse_power(next(inout g) % 24));
		return {x, f32((v*2.0 - 1.0)*unsafe.transmute(f64, (1023 + next(inout g) % 30) << 52))};
	case 2:
		e := 1 + next(inout g) % 254;
		x := unsafe.transmute(f32, u32((e << 23) | (next(inout g) & 0x7fffff)));
		spread := 100.0;
		if (e != 127) { spread = 120.0/f64(abs_difference(e, 127)); }
		return {x, f32((v*2.0 - 1.0)*spread)};
	case 3: return {f32(0.0 - (0.25 + u*4.0)), f32(f64(next(inout g) % 41) - 20.0)};
	case 4: return {f32(f64(5793 + 2*(next(inout g) % 1199))/4096.0), f32(2.0)};
	default: return {f32(1 + next(inout g) % 20), f32(f64(next(inout g) % 60)/2.0 - 10.0)};
	}
}

// Arguments of atan2, in every quadrant: y and x up to 10; |y| near |x|,
// on either side of the swap; magnitudes of every exponent, with quotients
// from far past overflow to far past underflow; quotients within a few ulps
// of the table's midpoints (j + 1/2)/128; small quotients near 1/256, where
// the table's first entry ends; and subnormal y over powers of two, or three
// times them, whose quotients are subnormal too and can be midpoints.
atan2_argument :: proc(g: inout Generator, i: int) -> (y: f64, x: f64) {
	u := unit(inout g);
	v := unit(inout g);
	y := 0.0;
	x := 0.0;
	switch (i % 6) {
	case 0:
		y = u*20.0 - 10.0;
		x = v*20.0 - 10.0;
	case 1:
		x = 0.5 + u;
		y = x*(1.0 + (v*2.0 - 1.0)*inverse_power(next(inout g) % 53));
	case 2:
		y = unsafe.transmute(f64, ((1 + next(inout g) % 2046) << 52) | (next(inout g) & 0x000fffffffffffff));
		x = unsafe.transmute(f64, ((1 + next(inout g) % 2046) << 52) | (next(inout g) & 0x000fffffffffffff));
	case 3:
		x = 1.0 + u;
		near := x*(f64(next(inout g) % 128) + 0.5)/128.0;
		y = unsafe.transmute(f64, unsafe.transmute(u64, near) + next(inout g) % 9 - 4);
	case 4:
		x = 1.0 + u;
		y = x*(1.0 + v)*inverse_power(8 + next(inout g) % 2);
	default:
		y = unsafe.transmute(f64, 1 + next(inout g) % 0x0010000000000000);
		x = inverse_power(next(inout g) % 60);
		if (next(inout g) % 2 == 0) { x = 3.0*x; }
	}
	if (next(inout g) % 2 == 0) { y = 0.0 - y; }
	if (next(inout g) % 2 == 0) { x = 0.0 - x; }
	return {y, x};
}

atan2_argument_f32 :: proc(g: inout Generator, i: int) -> (y: f32, x: f32) {
	u := unit(inout g);
	v := unit(inout g);
	y := f32(0.0);
	x := f32(0.0);
	switch (i % 6) {
	case 0:
		y = f32(u*20.0 - 10.0);
		x = f32(v*20.0 - 10.0);
	case 1:
		x = f32(0.5 + u);
		y = f32(f64(x)*(1.0 + (v*2.0 - 1.0)*inverse_power(next(inout g) % 24)));
	case 2:
		y = unsafe.transmute(f32, u32(((1 + next(inout g) % 254) << 23) | (next(inout g) & 0x7fffff)));
		x = unsafe.transmute(f32, u32(((1 + next(inout g) % 254) << 23) | (next(inout g) & 0x7fffff)));
	case 3:
		x = f32(1.0 + u);
		near := f32(f64(x)*(f64(next(inout g) % 128) + 0.5)/128.0);
		y = unsafe.transmute(f32, unsafe.transmute(u32, near) + u32(next(inout g) % 9) - 4);
	case 4:
		x = f32(1.0 + u);
		y = f32(f64(x)*(1.0 + v)*inverse_power(8 + next(inout g) % 2));
	default:
		y = unsafe.transmute(f32, u32(1 + next(inout g) % 0x800000));
		x = f32(inverse_power(next(inout g) % 30));
		if (next(inout g) % 2 == 0) { x = f32(3.0)*x; }
	}
	if (next(inout g) % 2 == 0) { y = f32(0.0) - y; }
	if (next(inout g) % 2 == 0) { x = f32(0.0) - x; }
	return {y, x};
}

abs_difference :: proc(a: u64, b: u64) -> u64 {
	if (a > b) { return a - b; }
	return b - a;
}

// Every pairing of these takes some row of pow's table, or its general
// case for a negative x.
POW_SPECIAL_X :: [11]u64{
	0x0000000000000000, 0x8000000000000000, 0x3ff0000000000000, 0xbff0000000000000,
	0x7ff0000000000000, 0xfff0000000000000, 0x7ff8000000000001, 0xc000000000000000,
	0x3fe0000000000000, 0x4000000000000000, 0xbfe0000000000000,
};
POW_SPECIAL_Y :: [13]u64{
	0x0000000000000000, 0x8000000000000000, 0x7ff0000000000000, 0xfff0000000000000,
	0xfff8000000000000, 0x3ff0000000000000, 0xbff0000000000000, 0x4000000000000000,
	0xc000000000000000, 0x4008000000000000, 0xc008000000000000, 0x3fe0000000000000,
	0xbff8000000000000,
};

// Every pairing of these takes some row of atan2's table, or its general
// case, tiny quotients included, and each alone some row of atan's.
ATAN2_SPECIAL :: [10]u64{
	0x0000000000000000, 0x8000000000000000, 0x7ff0000000000000, 0xfff0000000000000,
	0x7ff8000000000001, 0x3ff0000000000000, 0xbff0000000000000, 0x0000000000000001,
	0xffefffffffffffff, 0x4008000000000000,
};

bits :: proc(x: f64) -> u64 { return unsafe.transmute(u64, x); }
bits32 :: proc(x: f32) -> u64 { return u64(unsafe.transmute(u32, x)); }

// Evaluated at compile time: fast paths, the slow path for a subnormal
// result, and reductions by each method.
CONSTANT_ONE :: repro.exp(1.0);
CONSTANT_SUBNORMAL :: repro.exp(-745.0);
CONSTANT_ONE_F32 :: repro.exp_f32(1.0);
CONSTANT_SUBNORMAL_F32 :: repro.exp_f32(-100.5);
CONSTANT_SIN :: repro.sin(0.5);
CONSTANT_COS_MEDIUM :: repro.cos(1000.0);
CONSTANT_SIN_HUGE :: repro.sin(1.0e22);
CONSTANT_SIN_F32 :: repro.sin_f32(100.0);
CONSTANT_LOG :: repro.log(10.0);
CONSTANT_LOG_SUBNORMAL :: repro.log(5.0e-324);
CONSTANT_LOG_F32 :: repro.log_f32(0.75);

// `f32` arguments that reach the rare retries, found by search: `exp_f32`'s
// double-`f64` step and its slow path, the slow paths of `sin_f32` and
// `cos_f32`, and `log_f32`'s double-`f64` step and its slow path. Each is
// checked against the oracle at run time and folded, each in a constant of
// its own: a folded slow path takes up to 16 MB of the evaluator's 64.
HARD_F32 :: [6]u32{0xc16912cd, 0x4371ade3, 0x46199998, 0x3c107fe6, 0x022ae487, 0x0dc8bba4};
HARD_FUNCTIONS :: [6]Function{.Exp, .Sin, .Sin, .Cos, .Log, .Log};
HARD_0 :: repro.exp_f32(unsafe.transmute(f32, u32(0xc16912cd)));
HARD_1 :: repro.sin_f32(unsafe.transmute(f32, u32(0x4371ade3)));
HARD_2 :: repro.sin_f32(unsafe.transmute(f32, u32(0x46199998)));
HARD_3 :: repro.cos_f32(unsafe.transmute(f32, u32(0x3c107fe6)));
HARD_4 :: repro.log_f32(unsafe.transmute(f32, u32(0x022ae487)));
HARD_5 :: repro.log_f32(unsafe.transmute(f32, u32(0x0dc8bba4)));
CONSTANT_HARD :: [6]f32{HARD_0, HARD_1, HARD_2, HARD_3, HARD_4, HARD_5};

// `f64` arguments, checked and folded the same way: sin and cos at 2^-9,
// half the first step of their table, and either side of it, where the
// table index once rounded up and lost a bit of the argument; sin below
// the next half step; and 1 + 6 2^-52, whose log, x - 1 - (x - 1)^2/2 +
// ..., is about 2^-100 relative above an `f64` midpoint, so it takes
// `log`'s slow path.
HARD_F64 :: [8]u64{
	0x3f5fffffffffffff, 0x3f60000000000000, 0x3f60000000000001,
	0x3f5fffffffffffff, 0x3f60000000000000, 0x3f60000000000001,
	0x3f77ffffffffffff, 0x3ff0000000000006,
};
HARD_FUNCTIONS_F64 :: [8]Function{.Sin, .Sin, .Sin, .Cos, .Cos, .Cos, .Sin, .Log};
HARD_F64_0 :: repro.sin(unsafe.transmute(f64, u64(0x3f5fffffffffffff)));
HARD_F64_1 :: repro.sin(unsafe.transmute(f64, u64(0x3f60000000000000)));
HARD_F64_2 :: repro.sin(unsafe.transmute(f64, u64(0x3f60000000000001)));
HARD_F64_3 :: repro.cos(unsafe.transmute(f64, u64(0x3f5fffffffffffff)));
HARD_F64_4 :: repro.cos(unsafe.transmute(f64, u64(0x3f60000000000000)));
HARD_F64_5 :: repro.cos(unsafe.transmute(f64, u64(0x3f60000000000001)));
HARD_F64_6 :: repro.sin(unsafe.transmute(f64, u64(0x3f77ffffffffffff)));
HARD_F64_7 :: repro.log(unsafe.transmute(f64, u64(0x3ff0000000000006)));
CONSTANT_HARD_F64 :: [8]f64{
	HARD_F64_0, HARD_F64_1, HARD_F64_2, HARD_F64_3,
	HARD_F64_4, HARD_F64_5, HARD_F64_6, HARD_F64_7,
};

// pow's exact midpoints, which round to even: (2 - 2^-26)^2, (2 - 2^-17)^3,
// and (w^2 2^-34)^1.5 with w = 2^18 - 1, of 54 bits, and 2^-1075, half the
// smallest subnormal, beside 2^-1074 and 2^-800, both exact; and in `f32`,
// (1 + 2^-12)^2 and 66049^1.5, of 25 bits, and 2^-150.
HARD_POW :: [6][2]u64{
	{0x3ffffffffc000000, 0x4000000000000000}, {0x3ffffff800000000, 0x4008000000000000},
	{0x400ffff000020000, 0x3ff8000000000000}, {0x4000000000000000, 0xc090cc0000000000},
	{0x4000000000000000, 0xc090c80000000000}, {0x3fe0000000000000, 0x4089000000000000},
};
HARD_POW_0 :: repro.pow(unsafe.transmute(f64, u64(0x3ffffffffc000000)), 2.0);
HARD_POW_1 :: repro.pow(unsafe.transmute(f64, u64(0x3ffffff800000000)), 3.0);
HARD_POW_2 :: repro.pow(unsafe.transmute(f64, u64(0x400ffff000020000)), 1.5);
HARD_POW_3 :: repro.pow(2.0, -1075.0);
HARD_POW_4 :: repro.pow(2.0, -1074.0);
HARD_POW_5 :: repro.pow(0.5, 800.0);
CONSTANT_HARD_POW :: [6]f64{HARD_POW_0, HARD_POW_1, HARD_POW_2, HARD_POW_3, HARD_POW_4, HARD_POW_5};
HARD_POW_F32 :: [3][2]u32{{0x3f800800, 0x40000000}, {0x47810080, 0x3fc00000}, {0x40000000, 0xc3160000}};
HARD_POW_F32_0 :: repro.pow_f32(unsafe.transmute(f32, u32(0x3f800800)), f32(2.0));
HARD_POW_F32_1 :: repro.pow_f32(f32(66049.0), f32(1.5));
HARD_POW_F32_2 :: repro.pow_f32(f32(2.0), f32(-150.0));
CONSTANT_HARD_POW_F32 :: [3]f32{HARD_POW_F32_0, HARD_POW_F32_1, HARD_POW_F32_2};

// atan2's quotients exactly halfway between two subnormals, which round
// toward zero: 3 2^-1075 to 2^-1074 and 2^-1075 to 0, and in `f32`
// 3 2^-150 to 2^-149; an ordinary quotient; and two pairs found by search
// that take the slow path, pi/2 - atan t and pi/2 + atan t. Then the two
// `f32` arguments, of 14 in an exhaustive pass, that leave `atan_f32`'s
// first approximation, the one of them that reaches the slow path second.
HARD_ATAN2 :: [6][2]u64{
	{0x0000000000000003, 0x4000000000000000}, {0x0000000000000001, 0x4000000000000000},
	{0x8000000000000003, 0xc000000000000000}, {0x3ff0000000000000, 0x4000000000000000},
	{0x3fe13459a1ef4ee3, 0x3f813860690894f6}, {0x3fee2c6e81f54c8f, 0xbf585267ae6a3978},
};
HARD_ATAN2_0 :: repro.atan2(unsafe.transmute(f64, u64(3)), 2.0);
HARD_ATAN2_1 :: repro.atan2(unsafe.transmute(f64, u64(1)), 2.0);
HARD_ATAN2_2 :: repro.atan2(unsafe.transmute(f64, u64(0x8000000000000003)), -2.0);
HARD_ATAN2_3 :: repro.atan2(1.0, 2.0);
HARD_ATAN2_4 :: repro.atan2(unsafe.transmute(f64, u64(0x3fe13459a1ef4ee3)), unsafe.transmute(f64, u64(0x3f813860690894f6)));
HARD_ATAN2_5 :: repro.atan2(unsafe.transmute(f64, u64(0x3fee2c6e81f54c8f)), unsafe.transmute(f64, u64(0xbf585267ae6a3978)));
CONSTANT_HARD_ATAN2 :: [6]f64{HARD_ATAN2_0, HARD_ATAN2_1, HARD_ATAN2_2, HARD_ATAN2_3, HARD_ATAN2_4, HARD_ATAN2_5};
HARD_ATAN2_F32 :: [2][2]u32{{0x00000003, 0x40000000}, {0x3f800000, 0xc0000000}};
HARD_ATAN2_F32_0 :: repro.atan2_f32(unsafe.transmute(f32, u32(3)), f32(2.0));
HARD_ATAN2_F32_1 :: repro.atan2_f32(f32(1.0), f32(-2.0));
CONSTANT_HARD_ATAN2_F32 :: [2]f32{HARD_ATAN2_F32_0, HARD_ATAN2_F32_1};
HARD_ATAN_F32 :: [2]u32{0x3a27ba3b, 0x3d8d6b23};
HARD_ATAN_F32_0 :: repro.atan_f32(unsafe.transmute(f32, u32(0x3a27ba3b)));
HARD_ATAN_F32_1 :: repro.atan_f32(unsafe.transmute(f32, u32(0x3d8d6b23)));
CONSTANT_HARD_ATAN_F32 :: [2]f32{HARD_ATAN_F32_0, HARD_ATAN_F32_1};
CONSTANT_ATAN :: repro.atan(3.0);
CONSTANT_ATAN_F32 :: repro.atan_f32(f32(-0.25));

Function :: enum { Exp, Sin, Cos, Log }

fast64 :: proc(f: Function, x: f64) -> f64 {
	switch (f) {
	case .Exp: return repro.exp(x);
	case .Sin: return repro.sin(x);
	case .Cos: return repro.cos(x);
	case .Log: return repro.log(x);
	}
}

slow64 :: proc(f: Function, x: f64) -> f64 {
	switch (f) {
	case .Exp: return repro.slow_exp(x);
	case .Sin: return repro.slow_sin(x);
	case .Cos: return repro.slow_cos(x);
	case .Log: return repro.slow_log(x);
	}
}

fast32 :: proc(f: Function, x: f32) -> f32 {
	switch (f) {
	case .Exp: return repro.exp_f32(x);
	case .Sin: return repro.sin_f32(x);
	case .Cos: return repro.cos_f32(x);
	case .Log: return repro.log_f32(x);
	}
}

slow32 :: proc(f: Function, x: f32) -> f32 {
	switch (f) {
	case .Exp: return repro.slow_exp_f32(x);
	case .Sin: return repro.slow_sin_f32(x);
	case .Cos: return repro.slow_cos_f32(x);
	case .Log: return repro.slow_log_f32(x);
	}
}

argument64 :: proc(f: Function, g: inout Generator, i: int) -> f64 {
	if (f == .Exp) { return argument(inout g, i); }
	if (f == .Log) { return log_argument(inout g, i); }
	return trig_argument(inout g, i);
}

argument32 :: proc(f: Function, g: inout Generator, i: int) -> f32 {
	if (f == .Exp) { return argument_f32(inout g, i); }
	if (f == .Log) { return log_argument_f32(inout g, i); }
	return trig_argument_f32(inout g, i);
}

// The slow paths are the reference, and the trigonometric ones take about
// ten microseconds a call, so they meet fewer arguments.
compared :: proc(f: Function) -> int {
	if (f == .Exp) { return 50000; }
	return 20000;
}

main :: proc() {
	one := f64(os.args.len());
	fmt.println("constant",
		bits(CONSTANT_ONE) == bits(repro.exp(one)),
		bits(CONSTANT_SUBNORMAL) == bits(repro.exp(-745.0*one)),
		bits32(CONSTANT_ONE_F32) == bits32(repro.exp_f32(f32(one))),
		bits32(CONSTANT_SUBNORMAL_F32) == bits32(repro.exp_f32(f32(-100.5*one))),
		bits(CONSTANT_SIN) == bits(repro.sin(0.5*one)),
		bits(CONSTANT_COS_MEDIUM) == bits(repro.cos(1000.0*one)),
		bits(CONSTANT_SIN_HUGE) == bits(repro.sin(1.0e22*one)),
		bits32(CONSTANT_SIN_F32) == bits32(repro.sin_f32(f32(100.0*one))),
		bits(CONSTANT_LOG) == bits(repro.log(10.0*one)),
		bits(CONSTANT_LOG_SUBNORMAL) == bits(repro.log(5.0e-324*one)),
		bits32(CONSTANT_LOG_F32) == bits32(repro.log_f32(f32(0.75*one))),
		bits(CONSTANT_ATAN) == bits(repro.atan(3.0*one)),
		bits32(CONSTANT_ATAN_F32) == bits32(repro.atan_f32(f32(-0.25*one))));

	hard := HARD_F32;
	functions := HARD_FUNCTIONS;
	constants := CONSTANT_HARD;
	foreach (i in 0 ..< 6) {
		y := unsafe.transmute(f32, hard[i])*f32(one);
		result := fast32(functions[i], y);
		fmt.println(functions[i], 32, bits32(y), bits32(result));
		fmt.println("constant", bits32(constants[i]) == bits32(result));
	}
	hard64 := HARD_F64;
	functions64 := HARD_FUNCTIONS_F64;
	constants64 := CONSTANT_HARD_F64;
	foreach (i in 0 ..< 8) {
		z := unsafe.transmute(f64, hard64[i])*one;
		result := fast64(functions64[i], z);
		fmt.println(functions64[i], 64, bits(z), bits(result));
		fmt.println("constant", bits(constants64[i]) == bits(result));
	}
	hard_pow := HARD_POW;
	constants_pow := CONSTANT_HARD_POW;
	foreach (i in 0 ..< 6) {
		x := unsafe.transmute(f64, hard_pow[i][0])*one;
		y := unsafe.transmute(f64, hard_pow[i][1]);
		result := repro.pow(x, y);
		fmt.println("Pow", 64, bits(x), bits(y), bits(result));
		fmt.println("constant", bits(constants_pow[i]) == bits(result));
	}
	hard_pow32 := HARD_POW_F32;
	constants_pow32 := CONSTANT_HARD_POW_F32;
	foreach (i in 0 ..< 3) {
		x := unsafe.transmute(f32, hard_pow32[i][0])*f32(one);
		y := unsafe.transmute(f32, hard_pow32[i][1]);
		result := repro.pow_f32(x, y);
		fmt.println("Pow", 32, bits32(x), bits32(y), bits32(result));
		fmt.println("constant", bits32(constants_pow32[i]) == bits32(result));
	}
	hard_atan2 := HARD_ATAN2;
	constants_atan2 := CONSTANT_HARD_ATAN2;
	foreach (i in 0 ..< 6) {
		y := unsafe.transmute(f64, hard_atan2[i][0])*one;
		x := unsafe.transmute(f64, hard_atan2[i][1]);
		result := repro.atan2(y, x);
		fmt.println("Atan2", 64, bits(y), bits(x), bits(result));
		fmt.println("constant", bits(constants_atan2[i]) == bits(result));
	}
	hard_atan2_32 := HARD_ATAN2_F32;
	constants_atan2_32 := CONSTANT_HARD_ATAN2_F32;
	foreach (i in 0 ..< 2) {
		y := unsafe.transmute(f32, hard_atan2_32[i][0])*f32(one);
		x := unsafe.transmute(f32, hard_atan2_32[i][1]);
		result := repro.atan2_f32(y, x);
		fmt.println("Atan2", 32, bits32(y), bits32(x), bits32(result));
		fmt.println("constant", bits32(constants_atan2_32[i]) == bits32(result));
	}
	hard_atan32 := HARD_ATAN_F32;
	constants_atan32 := CONSTANT_HARD_ATAN_F32;
	foreach (i in 0 ..< 2) {
		x := unsafe.transmute(f32, hard_atan32[i])*f32(one);
		result := repro.atan_f32(x);
		fmt.println("Atan", 32, bits32(x), bits32(result));
		fmt.println("constant", bits32(constants_atan32[i]) == bits32(result));
	}
	atan2_special := ATAN2_SPECIAL;
	foreach (i in 0 ..< 10) {
		y := unsafe.transmute(f64, atan2_special[i]);
		fmt.println("Atan", 64, bits(y), bits(repro.atan(y*one)));
		fmt.println("Atan", 32, bits32(f32(y)), bits32(repro.atan_f32(f32(y)*f32(one))));
		foreach (j in 0 ..< 10) {
			x := unsafe.transmute(f64, atan2_special[j]);
			fmt.println("Atan2", 64, bits(y), bits(x), bits(repro.atan2(y*one, x)));
			fmt.println("Atan2", 32, bits32(f32(y)), bits32(f32(x)), bits32(repro.atan2_f32(f32(y)*f32(one), f32(x))));
		}
	}
	special_x := POW_SPECIAL_X;
	special_y := POW_SPECIAL_Y;
	foreach (i in 0 ..< 11) {
		foreach (j in 0 ..< 13) {
			x := unsafe.transmute(f64, special_x[i]);
			y := unsafe.transmute(f64, special_y[j]);
			fmt.println("Pow", 64, bits(x), bits(y), bits(repro.pow(x*one, y)));
			fmt.println("Pow", 32, bits32(f32(x)), bits32(f32(y)), bits32(repro.pow_f32(f32(x)*f32(one), f32(y))));
		}
	}

	g := Generator{state = 0x9e3779b97f4a7c15};
	foreach (f in [4]Function{.Exp, .Sin, .Cos, .Log}) {
		differ := 0;
		differ32 := 0;
		foreach (i in 0 ..< compared(f)) {
			x := argument64(f, inout g, i)*one;
			if (bits(fast64(f, x)) != bits(slow64(f, x))) {
				differ += 1;
				if (differ <= 5) { fmt.println("differs64", f, bits(x)); }
			}
			y := argument32(f, inout g, i)*f32(one);
			if (bits32(fast32(f, y)) != bits32(slow32(f, y))) {
				differ32 += 1;
				if (differ32 <= 5) { fmt.println("differs32", f, bits32(y)); }
			}
		}
		fmt.println("compared", f, compared(f), differ, differ32);
	}

	CHECKED :: 1000;
	foreach (f in [4]Function{.Exp, .Sin, .Cos, .Log}) {
		foreach (i in 0 ..< CHECKED) {
			x := argument64(f, inout g, i)*one;
			fmt.println(f, 64, bits(x), bits(fast64(f, x)));
			y := argument32(f, inout g, i)*f32(one);
			fmt.println(f, 32, bits32(y), bits32(fast32(f, y)));
			// The slow path on its own, normal results included.
			if (i % 4 == 0) {
				fmt.println(f, 64, bits(x), bits(slow64(f, x)));
				fmt.println(f, 32, bits32(y), bits32(slow32(f, y)));
			}
		}
	}

	differ := 0;
	differ32 := 0;
	foreach (i in 0 ..< 20000) {
		x, y := pow_argument(inout g, i);
		if (bits(repro.pow(x*one, y)) != bits(repro.slow_pow(x*one, y))) {
			differ += 1;
			if (differ <= 5) { fmt.println("differs64 Pow", bits(x), bits(y)); }
		}
		x32, y32 := pow_argument_f32(inout g, i);
		if (bits32(repro.pow_f32(x32*f32(one), y32)) != bits32(repro.slow_pow_f32(x32*f32(one), y32))) {
			differ32 += 1;
			if (differ32 <= 5) { fmt.println("differs32 Pow", bits32(x32), bits32(y32)); }
		}
	}
	fmt.println("compared Pow 20000", differ, differ32);
	foreach (i in 0 ..< CHECKED) {
		x, y := pow_argument(inout g, i);
		fmt.println("Pow", 64, bits(x), bits(y), bits(repro.pow(x*one, y)));
		x32, y32 := pow_argument_f32(inout g, i);
		fmt.println("Pow", 32, bits32(x32), bits32(y32), bits32(repro.pow_f32(x32*f32(one), y32)));
		if (i % 4 == 0) {
			fmt.println("Pow", 64, bits(x), bits(y), bits(repro.slow_pow(x*one, y)));
			fmt.println("Pow", 32, bits32(x32), bits32(y32), bits32(repro.slow_pow_f32(x32*f32(one), y32)));
		}
	}

	differ = 0;
	differ32 = 0;
	foreach (i in 0 ..< 20000) {
		y, x := atan2_argument(inout g, i);
		if (bits(repro.atan2(y*one, x)) != bits(repro.slow_atan2(y*one, x))) {
			differ += 1;
			if (differ <= 5) { fmt.println("differs64 Atan2", bits(y), bits(x)); }
		}
		y32, x32 := atan2_argument_f32(inout g, i);
		if (bits32(repro.atan2_f32(y32*f32(one), x32)) != bits32(repro.slow_atan2_f32(y32*f32(one), x32))) {
			differ32 += 1;
			if (differ32 <= 5) { fmt.println("differs32 Atan2", bits32(y32), bits32(x32)); }
		}
	}
	fmt.println("compared Atan2 20000", differ, differ32);
	foreach (i in 0 ..< CHECKED) {
		y, x := atan2_argument(inout g, i);
		fmt.println("Atan2", 64, bits(y), bits(x), bits(repro.atan2(y*one, x)));
		y32, x32 := atan2_argument_f32(inout g, i);
		fmt.println("Atan2", 32, bits32(y32), bits32(x32), bits32(repro.atan2_f32(y32*f32(one), x32)));
		if (i % 4 == 0) {
			fmt.println("Atan2", 64, bits(y), bits(x), bits(repro.slow_atan2(y*one, x)));
			fmt.println("Atan2", 32, bits32(y32), bits32(x32), bits32(repro.slow_atan2_f32(y32*f32(one), x32)));
		}
		// atan of the quotient, as an argument of its own.
		z := y/x;
		fmt.println("Atan", 64, bits(z), bits(repro.atan(z*one)));
		z32 := y32/x32;
		fmt.println("Atan", 32, bits32(z32), bits32(repro.atan_f32(z32*f32(one))));
	}
}
