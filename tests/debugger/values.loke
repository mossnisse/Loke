package main;

import "core:fmt";

Sized :: interface($Self: type) {
	slot size: proc(self) -> int;
}

Box :: struct { width: int, height: int }
impl Box {
	size :: proc(self) -> int { return self.width * self.height; }
}

// tests/corpus_test.odin `a_debugger_shows_values` stops here and reads the
// caller's locals through the natvis rules -g puts in the PDB.
stop :: proc() {}

// A parameter wider than a register is shown as the value its slot holds.
inspect :: proc(point: Box, label: string_view) {
	stop();
	fmt.println(point.width, label);
}

// Two local types of one name keep their own layouts behind a by-value field.
left :: proc() {
	Local :: struct { alpha: int, beta: int }
	Holder :: struct { inner: Local }
	held := Holder{inner = Local{alpha = 11, beta = 12}};
	stop();
	fmt.println(held.inner.alpha);
}

right :: proc() {
	Local :: struct { gamma: int, delta: int, epsilon: int }
	Holder :: struct { inner: Local }
	held := Holder{inner = Local{gamma = 21, delta = 22, epsilon = 23}};
	stop();
	fmt.println(held.inner.gamma);
}

main :: proc() {
	name := "loke";
	view: string_view = name;
	ages := map[string]int{"Bob" = 2};
	ids := map[int]string{7 = "seven"};
	count := ages["Bob"];
	text := ids[7];
	box := Box{width = 3, height = 4};
	shape := (dyn Sized)(&box);
	stop();
	fmt.println(name, view, count, text, shape.size());
	inspect(box, view);
	right();
	left();
}
