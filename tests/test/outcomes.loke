// design.md "Test procedures": each outcome a test can have, as `-test`
// reports it. A passing test's output is hidden; a failing one's is shown.
package outcomes;

import "core:fmt";

Parse_Error :: enum { Not_A_Digit }

digit :: proc(c: u8) -> Result(int, Parse_Error) {
	if (c < '0' || c > '9') { return .err(.Not_A_Digit); }
	return .ok(int(c - '0'));
}

@(test)
parses_a_digit :: proc() -> Status(Parse_Error) {
	value := digit('7') or_return;
	assert(value == 7);
}

@(test)
returns_its_failure :: proc() -> Status(Parse_Error) {
	_ = digit('x') or_return;
}

@(test)
prints_and_passes :: proc() {
	fmt.println("not shown");
}

@(test)
fails_an_assert :: proc() {
	fmt.println("shown before the assert");
	assert(1 + 1 == 3);
}

@(test)
panics_with_a_message :: proc() {
	panic("gave up at", 3);
}

@(test)
runs_after_the_failures :: proc() {
	assert((digit('0') or_else -1) == 0);
}
