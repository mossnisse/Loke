// design.md "Test procedures": a test build of a `package main` runs its tests
// in file-name order, not `main`, nor the tests of the packages it imports.
package main;

import "core:fmt";
import "core:os";

main :: proc() {
	fmt.println("main is not a test");
}

// What a test names exists in every build, so this is an ordinary procedure.
build_name :: proc() -> string_view {
	when (LOKE_BUILD_MODE == .Test) {
		return "test";
	} else {
		return "program";
	}
}

@(test)
first_file :: proc() {
	// The runner's choice of test is not one of the program's arguments.
	assert(os.args.len() == 1);
}
