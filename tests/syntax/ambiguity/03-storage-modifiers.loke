// `static` and `thread_local` are reserved words, so after a declaration's `:`
// they are always modifiers, before any type or `=`. `manual` names no
// modifier at all, so it is only ever an ordinary identifier or type name.
package main;

modified: static int = 0;
inferred: static = 0;
thread: thread_local int;
thread_inferred: thread_local = 0;
unlabeled: static (int, bool);
labeled: thread_local (a: int, b: bool);
other_type_name: manual;
manual: manual = manual;
