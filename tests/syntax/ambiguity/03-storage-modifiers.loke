// Rule 3: `static` and `thread_local` are ordinary identifiers, and are
// modifiers only before another modifier, a type, or `=`. `manual` names no
// modifier at all, so it is only ever an ordinary identifier or type name.
package main;

modified: static int = 0;
inferred: static = 0;
thread: thread_local int;
thread_inferred: thread_local = 0;
type_name: static;
other_type_name: manual;
manual: manual = manual;
