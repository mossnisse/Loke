(file package="main"
  (const names=["main"]
    (proc (proc-type)
      (block
        (switch value
          (subject (ident "x"))
          (case (int "1")
          )
        )
        (switch value
          (subject (binary In (ident "x") (ident "set")))
          (case (ident "true")
          )
        )
        (switch value
          (call (ident "init"))
          (subject (ident "figure"))
          (case (ident "int")
          )
        )
        (switch value
          (call (ident "init"))
          (subject (ident "x"))
          (case (int "1")
          )
        )
        (switch value
          (subject (ident "figure"))
          (case (call (ident "int") (ident "n")) (slice (ident "u8")) (ptr (ident "Square"))
          )
        )
        (switch value
          (subject (ident "figure"))
          (case (call (slice (ident "int")) (ident "xs"))
          )
        )
        (switch value
          (subject (ident "shape"))
          (case (call (selector _ "circle") (ident "r")) (call (selector _ "square") (unary Amp mut (ident "s")))
          )
        )
      )
    )
  )
)
