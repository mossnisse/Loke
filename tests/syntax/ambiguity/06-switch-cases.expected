(file package="main"
  (const names=["main"]
    (proc (proc-type)
      (block
        (switch value
          (subject (ident "x"))
          (case (int "1")
          )
        )
        (switch value
          (subject (binary In (ident "x") (ident "set")))
          (case (ident "true")
          )
        )
        (switch value
          (call (ident "init"))
          (subject (ident "figure"))
          (case (ident "int")
          )
        )
        (switch value
          (call (ident "init"))
          (subject (ident "x"))
          (case (int "1")
          )
        )
        (switch value
          (subject (ident "figure"))
          (case (call (ident "g") (ident "n")) (index (ident "xs") (int "0")) (postfix Caret (ident "p"))
          )
        )
        (switch value
          (subject (ident "shape"))
          (case (call (selector _ "circle") (ident "r")) (call (selector _ "square") (unary Amp mut (ident "s")))
          )
        )
        (switch value
          (subject (ident "shape"))
          (case (selector _ "empty")
          )
          (case (call (poly "variant") (unary Amp mut (ident "s")))
          )
        )
        (switch value
          (subject (ident "shape"))
          (case (poly "variant")
          )
        )
      )
    )
  )
)
