// concurrency-proposal.md "Syntax": at statement start `parallel` is a keyword
// before `{` or before a parenthesized header followed by `{`, and `spawn`
// before an identifier. Everywhere else both are names.
package main;

main :: proc() {
	parallel {
		spawn work(i, data);
		spawn low = sum(xs[:mid]);
		spawn shapes.area(circle);
		parallel {
			spawn work(0, data);
		}
	}
	parallel (pool) {
		spawn work(1, data);
	}
	parallel(pool);
	parallel(pool).wait();
	spawn(callback);
	object.spawn(args);
	(parallel{1}).run();
	spawn := parallel;
	spawn = 1;
}
