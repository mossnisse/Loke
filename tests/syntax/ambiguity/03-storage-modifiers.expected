(file package="main"
  (var names=["modified"] static type=(ident "int")
    (int "0")
  )
  (var names=["inferred"] static
    (int "0")
  )
  (var names=["thread"] thread_local type=(ident "int"))
  (var names=["thread_inferred"] thread_local
    (int "0")
  )
  (var names=["unlabeled"] static type=(record (field [] (ident "int")) (field [] (ident "bool"))))
  (var names=["labeled"] thread_local type=(record (field ["a"] (ident "int")) (field ["b"] (ident "bool"))))
  (var names=["other_type_name"] type=(ident "manual"))
  (var names=["manual"] type=(ident "manual")
    (ident "manual")
  )
)
