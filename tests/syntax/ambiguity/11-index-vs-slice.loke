// Rule 11: after `[`, a `:` makes it a slice, a `,` a multi-index, and `]` a
// single index. A slice's `mut` is its own, and what follows applies to its result.
package main;

main :: proc() {
	a := s[i];
	b := s[i, j];
	c := s[:];
	d := s[lo:];
	e := s[:hi];
	g := s[lo:hi];
	h := s[mut lo:hi];
	k := s[mut :].len();
}
