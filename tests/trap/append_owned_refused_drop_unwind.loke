// design.md "Container insertion": an `append` whose arena has no room drops
// the temporaries its pack handed over, last first, before the allocator's
// policy panics. Those not dropped yet stay registered, so a drop hook that
// panics first still leaves them to the unwind, while the borrowed place stays
// with its owner ("What the unwind runs, and what it does not").
package main;
import "core:fmt";
import "core:mem";

@(fieldwise_copy) Item :: struct { id: int }
impl Item {
    release :: hook(drop) proc(self: inout Item) {
        fmt.println("drop", self.id);
        if (self.id == 6) { panic("drop failed"); }
    }
}

main :: proc() {
    defer fmt.println("unwound");
    arena: mem.Arena = {};
    items := make([dynamic]Item, 0, arena.allocator());
    kept := Item{1};
    items.append(Item{5}, kept, Item{6});
}
