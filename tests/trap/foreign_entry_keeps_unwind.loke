package main;

import "core:fmt";

// design.md "Values that outlive every scope": a procedure Loke defines with a
// foreign calling convention attaches its thread as it enters, and entering on
// an attached thread changes nothing, so a panic inside one still drops what
// its Loke caller holds.
@(move_only) Tracked :: struct { id: int }
impl Tracked {
	release :: hook(drop) proc(self: inout Tracked) {
		fmt.println("drop", self.id);
	}
}

fail :: proc "c" () {
	panic("entered and failed");
}

main :: proc() {
	held := Tracked{1};
	fail();
}
