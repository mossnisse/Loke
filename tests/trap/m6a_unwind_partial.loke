package main;

// design.md "What the unwind runs": scope-exit cleanup runs for every *fully
// initialized* managed owner. A declaration whose initializer panics never
// completed, so it is not dropped; the declarations before it did complete, so
// they are.
//
// The registration flag is what makes that distinction runtime-visible: it is
// set only after the initializer has produced a value.

Res :: struct { id: int }

impl Res {
	drop :: proc(self: inout Res) { print_int(self.id); }
}

fail :: proc() -> int {
	panic("the initializer fails");
	return 0;
}

main :: proc() {
	first := Res{1};
	second := Res{2};
	third := Res{fail()};
	print_int(99);
}
