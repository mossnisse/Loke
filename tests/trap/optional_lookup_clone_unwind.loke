package main; import "core:fmt";

Huge :: struct { pad: [4611686018427387904]u8 }
Failing :: struct { id: int }
impl Failing {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Failing, Allocator_Error) {
		p := new(Huge, allocator) or_return;
		free(p);
		return .ok(Failing{self.id});
	}
	release :: hook(drop) proc(self: inout Failing) { if (self.id != 0) { fmt.println("drop", self.id); } }
}

make_map :: proc() -> map[int]Failing {
	m: map[int]Failing;
	m[1] = Failing{1};
	return m;
}

main :: proc() {
	destination := Failing{2};
	defer fmt.println("destination", destination.id);
	// A failed payload clone must unwind the temporary map and leave the old
	// assignment destination live. Neither the result nor the map may leak.
	destination = make_map().lookup_value(1) or_else Failing{0};
	fmt.println("unexpected return");
}
