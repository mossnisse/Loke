package main;

import "core:fmt";

// design.md "Assignment statements": each exit a deferred assignment expands at
// drops the old value only where it is live, and a panic's unwind is one. The
// normal exit finds `value` dropped and the unwind finds it live, so the unwind
// still drops the value it replaces.
@(move_only) Tracked :: struct { id: int }
impl Tracked {
	release :: hook(drop) proc(self: inout Tracked) {
		fmt.println("drop", self.id);
	}
}

may_panic :: proc(fail: bool) {
	if (fail) { panic("failed"); }
}

check :: proc(fail: bool) {
	value := Tracked{1};
	defer value = Tracked{2};
	may_panic(fail);
	drop(value);
}

main :: proc() {
	check(true);
}
