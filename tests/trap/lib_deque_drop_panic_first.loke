package main;

import "core:container";
import "core:fmt";

// standard-library.md "Deques": the first element's drop raises the panic during
// a normal scope exit, on a ring that wraps. Every other element still drops once,
// in queue order, before the storage goes.
@(move_only) Tracked :: struct { id: int }
impl Tracked {
	gone :: hook(drop) proc(self: inout) {
		if (self.id == 0) { return; }
		fmt.println("drop", self.id);
		if (self.id == 1) { panic("first drop failed"); }
	}
}

main :: proc() {
	d := container.Deque(Tracked).init(4);
	foreach (_ in 0 ..< d.cap() - 1) {
		d.append(Tracked{0});
		_ = d.pop_front();
	}
	foreach (id in 1 ..= 4) { d.append(Tracked{id}); }
	front, back := d.as_slices();
	fmt.println("wrapped", back.len() > 0);
}
