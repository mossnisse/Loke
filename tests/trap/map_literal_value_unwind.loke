// design.md "What the unwind runs, and what it does not": a map literal's
// value is owned by the literal until the map holds it, so a panic in its
// key's hash drops it, as well as the entries already inserted.
package main;
import "core:fmt";
Key :: struct { id: int }
impl Key {
    hash :: proc(self, seed: uint) -> uint { if (self.id == 2) { panic("hash failed"); } return self.id.hash(seed); }
    same :: operator(==) proc(a, b: Key) -> bool { return a.id == b.id; }
}
Res :: struct { id: int }
impl Res {
    release :: hook(drop) proc(self: inout Res) { fmt.println("drop", self.id); }
}
main :: proc() {
    defer fmt.println("unwound");
    m := map[Key]Res{Key{1} = Res{6}, Key{2} = Res{7}};
}
