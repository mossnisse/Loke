package main;
// design.md "Allocation failure": an arena constructed with `.Trap` aborts
// without unwinding when it runs out, so the `defer` below never runs.
import "core:fmt";
import "core:mem";

main :: proc() {
	defer fmt.println("unwound");
	// A `try_` form still hands the error back whatever the policy.
	scratch := mem.Scratch.init(policy = .Trap);
	switch (_ in mem.try_arena(policy = .Panic)) {
	case .ok: fmt.println("try_arena opened");
	case .err: fmt.println("try_arena failed");
	}
	buffer: [512]u8 = {};
	arena := mem.Arena.from_buffer(&mut buffer[:], policy = .Trap);
	small: [dynamic]int via arena.allocator() = {};
	small.append(1, 2, 3);
	fmt.println(small, scratch.allocator() != arena.allocator());
	// Far more than the buffer holds, and a fixed arena has no parent to grow from.
	big: [dynamic]int via arena.allocator() = {};
	big.reserve(100000);
	fmt.println("not reached", big.len());
}
