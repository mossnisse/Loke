package main; import "core:fmt"; import "core:mem";

Payload :: struct { bytes: [128]u8 }

impl Payload {
	copy_payload :: hook(copy) proc(self, allocator: Allocator) -> Result(Payload, Allocator_Error) {
		panic("copy failed");
		return .ok(Payload{});
	}
}

main :: proc() {
	room: [320]u8 = {};
	arena := mem.Arena.from_buffer(&mut room[:]);
	defer {
		// The arena has room for one box: the panicking copy left none behind.
		switch (try_box(Payload{}, arena.allocator())) {
		case .ok: fmt.println(true);
		case .err: fmt.println(false);
		}
	}
	value: Payload = {};
	switch (try_box(value, arena.allocator())) {
	case .ok:
	case .err:
	}
}
