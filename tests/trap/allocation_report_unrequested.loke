package main; import "core:fmt";

// design.md "Allocation failure": `.Panic` reports the requested size and the
// allocator. An `Allocator_Error` carries the refused size, so a failure the
// program handled leaves nothing behind, and a `try_clone` that answers `.err`
// without asking for memory has no size to report: the report names only the
// allocator.

// A `[dynamic]T` reserves room for at least eight, so this asks for 2^62 bytes.
Huge :: struct { pad: [576460752303423488]u8 }

Refusing :: struct { id: int }

impl Refusing {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Refusing, Allocator_Error) {
		refused: Allocator_Error = {};
		return .err(refused);
	}
}

main :: proc() {
	switch (try_make([dynamic]Huge, 0, 1)) {
	case .ok: fmt.println("allocated");
	case .err(failure): fmt.println("handled", failure);
	}
	r := Refusing{1};
	other := r.clone();
	fmt.println(other.id);
}
