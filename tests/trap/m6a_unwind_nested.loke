package main; import "core:fmt";

// design.md "What the unwind runs": a panic runs each unwound frame's pending
// scope-exit actions — user `defer`s and the implicit `drop` of every live
// managed owner — newest frame first, and in reverse registration order within
// each frame, exactly as a `return` leaving that frame would.
//
// The paired `m6a_abort_nested` case is the same program under `-panic=abort`,
// which prints none of this.

Res :: struct { id: int }

impl Res {
	drop :: proc(self: inout Res) { fmt.println(self.id); }
}

inner :: proc() {
	c := Res{3};
	defer fmt.println(30);
	panic("the third frame fails");
}

middle :: proc() {
	b := Res{2};
	defer fmt.println(20);
	inner();
}

main :: proc() {
	a := Res{1};
	defer fmt.println(10);
	middle();
}
