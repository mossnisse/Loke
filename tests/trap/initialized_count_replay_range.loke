// design.md "Uninitialized capacity": replay reads the count as the hook left it,
// and a count outside `0 ..= N` panics there too, before it reads an element.
package main;
import "core:fmt";
import "core:unsafe";
@(move_only) Tracked :: struct { id: int }
impl Tracked {
    release :: hook(drop) proc(self: inout Tracked) {
        fmt.println("drop", self.id);
    }
}
@(move_only) Holder :: struct {
    @(initialized=count) items: [1]Tracked,
    count: int,
}
impl Holder {
    release :: hook(drop) proc(self: inout Holder) {
        self.count = 2;
        panic("hook failed");
    }
}
main :: proc() {
    holder := Holder{};
    unsafe.write(holder.items[0], Tracked{1});
    holder.count = 1;
}
