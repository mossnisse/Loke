package main;

// design.md: "`clone` ... calls `try_clone` once and, on failure, invokes the
// supplied allocator's failure policy." M5a's fixed fallback is a
// non-unwinding trap; M6 replaces it with allocator-selected `.Panic`/`.Trap`
// dispatch (m5a-plan decision "Failure fallback").

Huge :: struct { pad: [4611686018427387904]u8 }

Failing :: struct { id: int }

impl Failing {
	try_clone :: proc(self, allocator: Allocator) -> (Failing, Allocator_Error) {
		p, err := new(Huge, allocator);
		if (err != nil) {
			return Failing{0}, err;
		}
		free(p);
		return Failing{self.id}, nil;
	}
}

Wrapper :: struct { inner: Failing }

main :: proc() {
	// The explicit entry point returns the error rather than applying a policy.
	w := Wrapper{Failing{1}};
	_, error := w.try_clone();
	if (error == nil) {
		print_int(0);
		return;
	}
	print_int(1);

	// The generated `clone` has no error to hand back, so it traps.
	other := w.clone();
	print_int(other.inner.id);
}
