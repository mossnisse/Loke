// standard-library "Channels": `split` makes a channel's first endpoints once;
// a second call panics, after the first pair's cleanup is in place.
package main;

import "core:fmt";
import "core:thread";

main :: proc() {
	channel := thread.Channel(int).init(1);
	send, receive := channel.split();
	fmt.println("split once");
	again, other := channel.split();
}
