// standard-library "`core:math/dense`": `Svd.solve` has no default for its
// relative tolerance and rejects a negative one. Zero keeps every singular
// value that is not zero.
package main;

import "core:fmt";
import "core:math/dense";

main :: proc() {
	a := dense.Matrix(f64).from_rows([2][2]f64{{2, 0}, {0, 0}});
	b := dense.Matrix(f64).from_rows([2][1]f64{{4}, {1}});
	switch (dense.svd(a.view())) {
	case .ok(s):
		x := s.solve(b.view(), 0.0);
		fmt.println(s.rank(0.0), x[0, 0], x[1, 0]);
		_ = s.solve(b.view(), -1.0);
	case .err(e):
		fmt.println(e);
	}
}
