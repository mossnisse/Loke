package main; import "core:fmt";

// design.md "Assignment statements": "If cloning fails, the compiler invokes
// that allocator's failure policy ... and leaves a previously live destination
// unchanged." M5a's fixed fallback is a non-unwinding trap, taken before the
// destination is touched (m5a-plan step 4).

Huge :: struct { pad: [4611686018427387904]u8 }

Failing :: struct { id: int }

impl Failing {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Failing, Allocator_Error) {
		p := try_new(Huge, allocator) or_return;
		free(p, allocator);
		return .ok(Failing{self.id});
	}

	release :: hook(drop) proc(self: inout Failing) { self.id = 0; }
}

main :: proc() {
	source := Failing{1};
	// The explicit entry point hands the error back, so this much runs.
	switch (_ in source.try_clone()) {
	case .ok:
		fmt.println(0);
		return;
	case .err: fmt.println(1);
	}

	// `clone` has no error to hand back, so it traps.
	destination := source.clone();
	fmt.println(destination.id);
}
