package main;

// design.md "Built-in procedures": an `assert` or `panic` borrows each value it
// prints, so a move-only local stays usable after an `assert` that holds, a
// packed field is printed from an aligned copy, and a managed temporary lives
// until the report ends. The program does not import `core:fmt`.

Token :: move_only struct { id: int }
Point :: struct { x: int, y: int }
Packed :: struct @(packed) { tag: u8, p: Point }
make_text :: proc() -> string { return "made"; }

main :: proc() {
	token := Token{7};
	assert(token.id == 7, "never", token);
	q := Packed{1, Point{2, 3}};
	assert(token.id == 7, "never", q.p, make_text());
	keep := token.id;
	panic("stop", keep, token, q.p, make_text(), 'x', nil == nil);
}
