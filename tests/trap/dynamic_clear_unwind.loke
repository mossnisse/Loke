package main;

import "core:fmt";

// design.md "Uninitialized capacity": a container shortens before it drops
// what it took, so when one element's drop hook panics, the unwind drops each
// element still in the array exactly once and then runs the outer cleanup.
Tracked :: struct { id: int }
impl Tracked {
	release :: hook(drop) proc(self: inout Tracked) {
		fmt.println("drop", self.id);
		if (self.id == 2) { panic("clear drop failed"); }
	}
}

main :: proc() {
	defer fmt.println("outer cleanup");
	values := [dynamic]Tracked{Tracked{1}, Tracked{2}, Tracked{3}};
	values.clear();
}
