package main;

import "core:fmt";

// design.md "Assignment statements": a deferred assignment on a panic's unwind
// fills a local that was already dropped, and no exit but the unwind reaches it,
// so the unwind drops the new value too.
@(move_only) Tracked :: struct { id: int }
impl Tracked {
	release :: hook(drop) proc(self: inout Tracked) {
		fmt.println("drop", self.id);
	}
}

main :: proc() {
	value := Tracked{1};
	defer value = Tracked{2};
	drop(value);
	panic("failed");
}
