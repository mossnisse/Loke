// design.md "What the unwind runs, and what it does not": a fixed array's
// generated clone that panics on one element drops the ones it already copied,
// newest first, and not the incomplete array's others.
package main;
import "core:fmt";
Tracked :: struct { id: int }
impl Tracked {
    copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked, Allocator_Error) {
        fmt.println("copy", self.id);
        if (self.id == 3) { panic("copy failed"); }
        return .ok(Tracked{self.id + 100});
    }
    release :: hook(drop) proc(self: inout Tracked) {
        if (self.id != 0) { fmt.println("drop", self.id); }
    }
}
main :: proc() {
    source := [4]Tracked{Tracked{1}, Tracked{2}, Tracked{3}, Tracked{4}};
    cloned := source;
    fmt.println(source[0].id, cloned[0].id);
}
