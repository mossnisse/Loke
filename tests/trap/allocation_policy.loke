package main; import "core:fmt";

// design.md "Allocation failure": `try_make` hands the error back; `make`
// follows the allocator's failure policy, which panics.

// A `[dynamic]T` reserves room for at least eight, so this asks for 2^62 bytes.
Huge :: struct { pad: [576460752303423488]u8 }

main :: proc() {
	switch (try_make([dynamic]Huge, 0, 1)) {
	case .ok: fmt.println("allocated");
	case .err: fmt.println("try_make failed");
	}
	switch (try_make([dynamic]Huge, 0, 2)) {
	case .ok: fmt.println("made");
	case .err: fmt.println("try_make of two failed");
	}
	p := make([dynamic]Huge, 0, 1);
	fmt.println("not reached", p.len());
}
