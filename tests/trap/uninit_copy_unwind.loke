// design.md "Uninitialized capacity": the storage has no copy of its own, so
// the record's `hook(copy)` clones what it holds. A clone that panics partway
// leaves the copy built so far to the unwind, whose drop hook releases the
// elements it counts ("What the unwind runs, and what it does not").
package main;
import "core:container";
import "core:fmt";
Tracked :: struct { id: int }
impl Tracked {
    copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked, Allocator_Error) {
        fmt.println("copy", self.id);
        if (self.id == 7) { panic("copy failed"); }
        return .ok(Tracked{self.id + 100});
    }
    release :: hook(drop) proc(self: inout Tracked) {
        if (self.id != 0) { fmt.println("drop", self.id); }
    }
}
Holder :: struct { first: Tracked, live: container.Small_Array(Tracked, 4) }
main :: proc() {
    source := Holder{ first = Tracked{1} };
    source.live.append(Tracked{5});
    source.live.append(Tracked{6});
    source.live.append(Tracked{7});
    cloned := source.clone();
}
