package main; import "core:fmt";

Key :: struct { id: int }
Resource :: struct { id: int }
impl Key {
	hash :: proc(self, seed: uint) -> uint { return seed; }
	equal :: operator(==) proc(a, b: Key) -> bool { return true; }
	release :: hook(drop) proc(self: inout Key) {
		if (self.id == 1) { fmt.println("key", self.id); panic("key drop failed"); }
	}
}
impl Resource {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Resource, Allocator_Error) {
		fmt.println("copy", self.id);
		return .ok(Resource{self.id + 100});
	}
	release :: hook(drop) proc(self: inout Resource) { if (self.id != 0) { fmt.println("drop", self.id); } }
}
main :: proc() {
	m: map[Key]Resource = {};
	m[Key{0}] = Resource{1};
	// The completed result must stay protected while its temporary key is
	// dropped. A panic here drops the result, but never drops that key twice.
	value := m.lookup_value(Key{1});
	fmt.println("unexpected return", value);
}
