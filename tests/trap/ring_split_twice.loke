// standard-library "Rings": `split` makes a ring's endpoints once; a second
// call panics, after the first pair's cleanup is in place.
package main;

import "core:fmt";
import "core:thread";

main :: proc() {
	ring := thread.Ring(int).init(1);
	send, receive := ring.split();
	fmt.println("split once");
	again, other := ring.split();
}
