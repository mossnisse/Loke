package main;

import "core:fmt";

// design.md "What the unwind runs, and what it does not": a map's whole drop
// stays registered until it finishes, and an entry whose key hook panics
// still owes its value a drop. Entry order is unspecified, so the drops are
// counted rather than printed.
keys := 0;
values := 0;
armed := false;

Key :: struct { id: int }
impl Key {
	hash :: proc(self, seed: uint) -> uint { return self.id.hash(seed); }
	equal :: operator(==) proc(a, b: Key) -> bool { return a.id == b.id; }
	release :: hook(drop) proc(self: inout Key) {
		keys += 1;
		if (armed && self.id == 2) { panic("key drop failed"); }
	}
}
Value :: struct { id: int }
impl Value {
	release :: hook(drop) proc(self: inout Value) { values += 1; }
}

main :: proc() {
	defer fmt.println("keys", keys, "values", values);
	m: map[Key]Value = {};
	m[Key{1}] = Value{1};
	m[Key{2}] = Value{2};
	m[Key{3}] = Value{3};
	// Only the drops the map's own drop runs are counted.
	keys = 0;
	values = 0;
	armed = true;
}
