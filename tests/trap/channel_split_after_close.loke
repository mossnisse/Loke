// standard-library "Channels": closing before `split` is allowed and prevents
// splitting for good, so a later `split` panics.
package main;

import "core:fmt";
import "core:thread";

main :: proc() {
	channel := thread.Channel(int).init(1);
	channel.close();
	fmt.println("closed before split");
	send, receive := channel.split();
}
