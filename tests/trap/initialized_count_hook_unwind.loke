// design.md "Uninitialized capacity": a hook shortens the count before it drops
// what it took, so the count is accurate at the panic. Replay drops the elements
// the count still names, not the ones the hook already took.
package main;
import "core:fmt";
import "core:unsafe";
@(move_only) Tracked :: struct { id: int }
impl Tracked {
    release :: hook(drop) proc(self: inout Tracked) {
        fmt.println("drop", self.id);
        if (self.id == 2) { panic("element drop failed"); }
    }
}
@(move_only) Holder :: struct {
    @(initialized=count) items: [4]Tracked,
    count: int,
}
impl Holder {
    release :: hook(drop) proc(self: inout Holder) {
        for (self.count > 0) {
            self.count -= 1;
            taken := unsafe.take(self.items[self.count]);
            drop(taken);
        }
    }
}
main :: proc() {
    holder := Holder{};
    unsafe.write(holder.items[0], Tracked{0});
    unsafe.write(holder.items[1], Tracked{1});
    unsafe.write(holder.items[2], Tracked{2});
    unsafe.write(holder.items[3], Tracked{3});
    holder.count = 4;
}
