// standard-library "`core:math/dense`": a view is checked once, when it is
// made. A 2 x 3 view with a leading dimension of 3 reaches index 7, so eight
// elements are enough and seven panic.
package main;

import "core:fmt";
import "core:math/dense";

main :: proc() {
	data := [?]f64{0, 1, 2, 3, 4, 5, 6, 7};
	fits := dense.View(f64).from_column_major(data[:], 2, 3, 3);
	fmt.println(fits[1, 2]);
	short := dense.View(f64).from_column_major(data[:7], 2, 3, 3);
	fmt.println(short[0, 0]);
}
