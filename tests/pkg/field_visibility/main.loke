package main; import "core:fmt";

import "./models";

// Reflection must expose exactly the fields ordinary access permits at the same
// lookup package (m5a-plan step 1).
visible_there :: proc() -> int {
	total := 0;
	foreach ($field in fields_of(models.Point)) {
		total += 1;
	}
	return total;
}

main :: proc() {
	built := models.build(3, 4);

	// Public fields: read, write, measure, and both literal forms.
	fmt.println(built.x + built.y);
	built.x = 10;
	fmt.println(built.x);
	fmt.println(offset_of(models.Point, x));

	positional := models.Point{1, 2};   // `scratch` is omitted, so it zero-fills
	named := models.Point{x = 1, y = 2};
	fmt.println(positional.x + named.y);

	fmt.println(models.visible_here());
	fmt.println(visible_there());
}
