package main; import "core:fmt";

// The unmanaged subset of the standard catalogue, reached through
// `-collection base=base` because M4b adds no implicit `base:` root.
import "base:interfaces";

Meters :: distinct f64;

impl Meters {
	add :: operator(+) proc(a, b: Meters) -> Meters { return Meters(f64(a) + f64(b)); }
	sub :: operator(-) proc(a, b: Meters) -> Meters { return Meters(f64(a) - f64(b)); }
	mul :: operator(*) proc(a, b: Meters) -> Meters { return Meters(f64(a) * f64(b)); }
	div :: operator(/) proc(a, b: Meters) -> Meters { return Meters(f64(a) / f64(b)); }
	eq  :: operator(==) proc(a, b: Meters) -> bool { return f64(a) == f64(b); }
	lt  :: operator(<) proc(a, b: Meters) -> bool { return f64(a) < f64(b); }
}

Opaque :: struct { value: int }

// design.md "Lifecycle hooks and resource types": records receive public copy
// operations by default, while `hook(copy)` replaces their implementation.
Counted :: struct { n: int }

impl Counted {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Counted, Allocator_Error) {
		return .ok(Counted{self.n});
	}
}

Move_Only :: move_only struct { handle: int }

Holds_Move_Only :: struct { inner: Move_Only }

total :: proc(a, b: $T) -> T where interfaces.Numeric(T) {
	return a + b;
}

duplicate :: proc(value: $T) -> T where interfaces.Cloneable(T) {
	return value.clone();
}

main :: proc() {
	static_assert(interfaces.Equatable(int));
	static_assert(interfaces.Ordered(int));
	static_assert(interfaces.Ordered(f64));
	static_assert(interfaces.Hashable(int));
	static_assert(interfaces.Hashable(rune));
	static_assert(interfaces.Numeric(int));
	static_assert(interfaces.Numeric(f64));
	static_assert(interfaces.Integral(int));

	// `Cloneable` is satisfied through whichever `try_clone` the record answers
	// to, generated or written, and not at all once it is disabled.
	static_assert(interfaces.Cloneable(Opaque));
	static_assert(interfaces.Cloneable(Counted));
	static_assert(!interfaces.Cloneable(Move_Only));
	static_assert(!interfaces.Cloneable(Holds_Move_Only));
	// A plain value is its own clone, so every copyable type satisfies it, and a
	// pointer to a move-only record is as copyable as any other pointer.
	static_assert(interfaces.Cloneable(int));
	static_assert(interfaces.Cloneable(f64));
	static_assert(interfaces.Cloneable(bool));
	static_assert(interfaces.Cloneable(rune));
	static_assert(interfaces.Cloneable(^Move_Only));
	static_assert(interfaces.Cloneable([]int));
	static_assert(interfaces.Cloneable(string_view));
	static_assert(interfaces.Cloneable(typeid));

	static_assert(!interfaces.Integral(f64));
	static_assert(!interfaces.Numeric(bool));
	// design.md "Comparison operators": a struct is comparable when all its
	// fields are, and `Equatable` takes the generated equality that follows --
	// an `==` this package declares for some other type is not in the way.
	// Slices are the standing exception: they compare against `nil` and nothing
	// else, so no equality is generated for one.
	static_assert(interfaces.Equatable(Opaque));
	static_assert(!interfaces.Equatable([]int));

	// A user `distinct` type satisfies the same catalogue entries through its
	// own operators.
	static_assert(interfaces.Equatable(Meters));
	static_assert(interfaces.Ordered(Meters));
	static_assert(interfaces.Numeric(Meters));
	static_assert(!interfaces.Integral(Meters));

	fmt.println(total(2, 3));
	fmt.println(int(f64(total(Meters(1.5), Meters(2.5)))));
	fmt.println(duplicate(6));
}
