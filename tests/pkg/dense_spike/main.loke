// dense-matrix-plan.md "Milestones": the spike. Views of an owner and of
// foreign buffers in both orders, a transpose and a block, two mutable halves
// written at once, the unchecked product against the checked one bit for
// bit, and LU at `f64` and through a dual number.
package main;

import "core:fmt";
import "core:math";
import "./dense";

check :: proc(name: string_view, ok: bool) {
	if (ok) {
		fmt.println("ok", name);
	} else {
		fmt.println("FAIL", name);
	}
}

// A forward-mode dual number, so `lu` and `solve_into` differentiate.
Dual :: struct { value, derivative: f64 }

impl Dual {
	@(public) from_f64 :: hook(convert) proc(value: f64) -> Dual { return {value, 0}; }
	@(public) from_int :: hook(convert) proc(value: int) -> Dual { return {f64(value), 0}; }
	@(public) add :: operator(+) proc(a, b: Dual) -> Dual { return {a.value + b.value, a.derivative + b.derivative}; }
	@(public) subtract :: operator(-) proc(a, b: Dual) -> Dual { return {a.value - b.value, a.derivative - b.derivative}; }
	@(public) negate :: operator(-) proc(a: Dual) -> Dual { return {-a.value, -a.derivative}; }
	@(public) multiply :: operator(*) proc(a, b: Dual) -> Dual {
		return {a.value*b.value, a.derivative*b.value + a.value*b.derivative};
	}
	@(public) divide :: operator(/) proc(a, b: Dual) -> Dual {
		return {a.value/b.value, (a.derivative*b.value - a.value*b.derivative)/(b.value*b.value)};
	}
	@(public) equal :: operator(==) proc(a, b: Dual) -> bool { return a.value == b.value; }
	@(public) less :: operator(<) proc(a, b: Dual) -> bool { return a.value < b.value; }

	sqrt :: proc(self) -> Dual {
		root := math.sqrt(self.value);
		return {root, self.derivative/(root + root)};
	}
	sin :: proc(self) -> Dual { return {math.sin(self.value), self.derivative*math.cos(self.value)}; }
	cos :: proc(self) -> Dual { return {math.cos(self.value), -self.derivative*math.sin(self.value)}; }
	asin :: proc(self) -> Dual { return {math.asin(self.value), 0}; }
	acos :: proc(self) -> Dual { return {math.acos(self.value), 0}; }
	atan2 :: proc(self, x: Dual) -> Dual { return {math.atan2(self.value, x.value), 0}; }
	abs :: proc(self) -> Dual { return -self if self.value < 0.0 else self; }
	floor :: proc(self) -> Dual { return {math.floor(self.value), 0}; }
	ceil :: proc(self) -> Dual { return {math.ceil(self.value), 0}; }
	round :: proc(self) -> Dual { return {math.round(self.value), 0}; }
	is_finite :: proc(self) -> bool { return math.is_finite(self.value); }
	is_normal :: proc(self) -> bool { return math.is_finite(self.value) && math.abs(self.value) >= math.F64_MIN_NORMAL; }
}

// A deterministic, well-conditioned test matrix: diagonally dominant, with a
// zero first element so that LU has to pivot.
filled :: proc($T: type, rows, columns: int) -> dense.Matrix(T) {
	m := dense.Matrix(T).zeros(rows, columns);
	foreach (c in 0 ..< columns) {
		foreach (r in 0 ..< rows) {
			m[r, c] = T(f64((r*7 + c*3) % 11) - 5.0);
		}
	}
	return m;
}

views :: proc() {
	// The same 2 x 3 matrix three ways: owned, column-major foreign storage
	// with a leading dimension of 3, and row-major foreign storage.
	m := dense.Matrix(f64).zeros(2, 3);
	foreach (c in 0 ..< 3) {
		foreach (r in 0 ..< 2) { m[r, c] = f64(10*r + c); }
	}
	column_major := [?]f64{0, 10, -1, 1, 11, -1, 2, 12, -1};
	row_major := [?]f64{0, 1, 2, 10, 11, 12};
	a := dense.View(f64).from_column_major(column_major[:], 2, 3, 3);
	b := dense.View(f64).from_row_major(row_major[:], 2, 3, 3);
	same := true;
	foreach (c in 0 ..< 3) {
		foreach (r in 0 ..< 2) { same = same && m.view()[r, c] == a[r, c] && a[r, c] == b[r, c]; }
	}
	check("an owner, a column-major buffer, and a row-major buffer view alike", same);
	t := b.transpose();
	check("transpose swaps the strides", t.rows() == 3 && t.columns() == 2 && t[2, 1] == 12.0 && t[0, 1] == 10.0);
	block := a.block(0, 1, 2, 2);
	check("a block starts at its corner", block[0, 0] == 1.0 && block[1, 1] == 12.0 && block.transpose()[1, 0] == 2.0);

	// Two mutable halves of one matrix, written at once.
	whole := m.view_mut();
	left, right := whole.split_columns_mut(1);
	left[1, 0] = right[1, 1];
	right[0, 0] = -1.0;
	check("split_columns_mut gives two writable halves", m[1, 0] == 12.0 && m[0, 1] == -1.0 && m[0, 2] == 2.0);
}

products :: proc() {
	a := filled(f64, 37, 29);
	b := filled(f64, 29, 41);
	fast := dense.multiply(a.view(), b.view());
	slow := dense.Matrix(f64).zeros(37, 41);
	dense.multiply_into_checked(slow.view_mut(), a.view(), b.view());
	same := true;
	foreach (c in 0 ..< 41) {
		foreach (r in 0 ..< 37) { same = same && fast[r, c] == slow[r, c]; }
	}
	check("the unchecked product equals the checked one bit for bit", same);

	// A product through a transposed view: (b^T a^T)^T = a b.
	tt := dense.Matrix(f64).zeros(41, 37);
	dense.multiply_into(tt.view_mut(), b.view().transpose(), a.view().transpose());
	transposed := true;
	foreach (c in 0 ..< 41) {
		foreach (r in 0 ..< 37) { transposed = transposed && tt[c, r] == fast[r, c]; }
	}
	check("a product of transposed views", transposed);
	fmt.println(fast[0, 0], fast[36, 40], fast[18, 20]);
}

lu :: proc() {
	n := 6;
	a := dense.Matrix(f64).zeros(n, n);
	foreach (c in 0 ..< n) {
		foreach (r in 0 ..< n) {
			distance := r - c if r > c else c - r;
			a[r, c] = 1.0/f64(1 + distance + r);
		}
		a[c, c] = a[c, c] + f64(n);
	}
	a[0, 0] = 0.0;
	switch (dense.lu(a.view())) {
	case .ok(factors):
		b := dense.Matrix(f64).zeros(n, 1);
		foreach (r in 0 ..< n) { b[r, 0] = f64(r + 1); }
		x := b.clone();
		factors.solve_into(x.view_mut());
		residual := dense.multiply(a.view(), x.view());
		worst := 0.0;
		foreach (r in 0 ..< n) { worst = math.max(worst, math.abs(residual[r, 0] - b[r, 0])); }
		check("lu solves with a small residual", worst < 64.0*math.F64_EPSILON*f64(n));
		fmt.println("determinant", factors.determinant());
	case .err(e):
		fmt.println("FAIL lu", e);
	}
	singular := dense.Matrix(f64).zeros(3, 3);
	switch (dense.lu(singular.view())) {
	case .ok(_):   check("a zero matrix is singular", false);
	case .err(e):  check("a zero matrix is singular", e == .Singular);
	}

	// d/dt of the solution of (A + t E) x = b at t = 0 is -A^-1 E x. With
	// A = [[2, 1], [1, 3]], E = [[1, 0], [0, 0]], and b = (1, 2): x = (0.2,
	// 0.6), and the derivative is -A^-1 (0.2, 0) = (-0.12, 0.04).
	d := dense.Matrix(Dual).zeros(2, 2);
	d[0, 0] = Dual{2, 1};
	d[0, 1] = Dual{1, 0};
	d[1, 0] = Dual{1, 0};
	d[1, 1] = Dual{3, 0};
	switch (dense.lu(d.view())) {
	case .ok(factors):
		rhs := dense.Matrix(Dual).zeros(2, 1);
		rhs[0, 0] = Dual{1, 0};
		rhs[1, 0] = Dual{2, 0};
		factors.solve_into(rhs.view_mut());
		fmt.println("dual", rhs[0, 0].value, rhs[0, 0].derivative, rhs[1, 0].value, rhs[1, 0].derivative);
	case .err(e):
		fmt.println("FAIL dual lu", e);
	}
}

main :: proc() {
	views();
	products();
	lu();
}
