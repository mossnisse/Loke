package main; import "core:fmt";

import "./models";

count_there :: proc() -> int {
	total := 0;
	foreach ($field in fields_of(models.Record)) {
		total += 1;
	}
	return total;
}

main :: proc() {
	// Inside the declaring package every field is visible; from here the
	// `@(private)` one is not.
	fmt.println(models.count_here());
	fmt.println(count_there());
	mixed := models.make_mixed(10, 20);
	foreach ($field in fields_of(models.Mixed)) {
		fmt.println(field.get(&mixed));
	}
}
