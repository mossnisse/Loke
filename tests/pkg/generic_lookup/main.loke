package main; import "core:fmt";

import "./container";

// Neither a caller-local `blend` nor a caller-local extension may change what an
// existing instantiation means (m4b-plan decision "Definition-site lookup").
blend :: proc(a, b: int) -> int { return 999; }

extend container.Pair(int) {
	@(public)
	label :: proc(self) -> int { return 42; }
}

main :: proc() {
	a := container.make_pair(int, 2, 3);
	b := container.make_pair(i32, 2, 3);

	// Two instantiations of one template, each with its own annotations.
	fmt.println(a.combine());        // definition-site `blend_int`: 2 + 3
	fmt.println(int(b.combine()));   // definition-site `blend_i32`: 2*10 + 3

	// `describe` selected `label` at its own definition site: the specialized
	// block for `Pair(int)`, the generic one for `Pair(i32)`, and never the
	// extension declared here.
	fmt.println(a.describe());
	fmt.println(b.describe());

	// The caller's own extension is reachable by its ordinary spelling.
	fmt.println(label(a));
}
