@(public)
package adapter;

import "../vendor";

// An extension is visible for method lookup only inside this package.
impl vendor.Vector2 {
	doubled :: proc(self) -> i32 { return (self.x + self.y) * 2; }

	// A private member opts out of the file-level public default and must not
	// consume the package-level name `init`.
	@(private)
	init :: proc(x: i32) -> vendor.Vector2 { return {x = x, y = x}; }
}

// Private members belong to their subject's namespace, so the same ordinary
// member name is valid on another extended type.
impl vendor.Other {
	@(private)
	init :: proc(x: i32) -> vendor.Other { return {value = x}; }
}

use_here :: proc(v: vendor.Vector2) -> i32 {
	return v.doubled();
}

// Every instantiation contributes its own `unwrap`, and they share the one
// package-qualified spelling: `adapter.unwrap` resolves like any other group.
impl vendor.Cell($T) {
	unwrap :: proc(self) -> T { return self.value; }
}

// The method spelling stays package-local, exactly as `doubled` does.
unwrap_here :: proc(c: vendor.Cell($T)) -> T {
	return c.unwrap();
}
