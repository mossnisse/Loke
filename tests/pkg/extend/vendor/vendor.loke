package vendor;

// A public type is only usable from outside if its fields are exported too
// (design.md "Exported names"); this case is about member lookup, not fields.
@(public)
Vector2 :: struct {
	@(public)
	x, y: i32,
}

// A generic subject: one instance per argument vector, so an extension member
// on it has one procedure per instance under one package-qualified name.
@(public)
Cell :: struct($T: type) {
	@(public)
	value: T,
}

@(public)
Other :: struct {
	@(public)
	value: i32,
}

impl Vector2 {
	@(public)
	sum :: proc(self) -> i32 { return self.x + self.y; }

	private_sum :: proc(self) -> i32 { return self.x + self.y; }
}
