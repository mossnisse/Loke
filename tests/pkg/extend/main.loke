package main; import "core:fmt";

import "./vendor";
import "./adapter";

main :: proc() {
	v := vendor.Vector2{x = 3, y = 4};
	// The inherent method is visible everywhere.
	fmt.println(int(v.sum()));
	fmt.println(int(vendor.Vector2.sum(v)));
	// The extension is not, but its named procedure is.
	fmt.println(int(adapter.use_here(v)));
	fmt.println(int(adapter.doubled(v)));
	// One extension member, two instances, one qualified name. The argument is
	// deliberately the first thing to instantiate each `Cell`: callee lookup must
	// already find the stable group, then see the member the argument adds to it.
	fmt.println(
		int(adapter.unwrap(vendor.Cell(i32){value = 7})),
		adapter.unwrap(vendor.Cell(string){value = "cell"}),
		int(adapter.unwrap_here(vendor.Cell(i32){value = 7})),
	);
}
