package main; import "core:fmt";

import "./vendor";
import "./adapter";

main :: proc() {
	v := vendor.Vector2{3, 4};
	// The inherent method is visible everywhere.
	fmt.println(int(v.sum()));
	fmt.println(int(vendor.Vector2.sum(v)));
	// The extension is not, but its named procedure is.
	fmt.println(int(adapter.use_here(v)));
	fmt.println(int(adapter.doubled(v)));
	// One extension member, two instances, one qualified name.
	number := vendor.Cell(i32){7};
	text := vendor.Cell(string){"cell"};
	fmt.println(int(adapter.unwrap(number)), adapter.unwrap(text), int(adapter.unwrap_here(number)));
}
