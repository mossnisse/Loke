package main; import "core:fmt";

// A three-package diamond: this package and `geom` both reach `util`, and the
// alias is a lexical name, not a second instance of the package.
import "geom";
import u "util";

main :: proc() {
	assert(u.as(21) == 42);
	p := geom.Point{3, 4};
	fmt.println(geom.area(p));
	fmt.println(geom.ORIGIN);
	fmt.println(u.double(21));
	fmt.println(u.SEED);
	// The same package under two names is the same declarations.
	fmt.println(geom.seed_used());
	// A hoisted procedure literal, owned and named by its own package.
	fmt.println(geom.apply(p));
	fmt.println(u.SEED + geom.ORIGIN);
}
