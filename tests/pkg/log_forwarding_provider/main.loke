@(default_logger = "./sink:factory")
package main;

import "core:fmt";
import "core:log";
import "core:thread";

import "./sink";

// A selected sink that counts each record and passes it on to the standard
// logger (standard-library "`core:log`"). The sink's `write` takes a second view
// of the standard logger's storage while the handle a record goes through may
// be one already, which a `@(synchronized)` variable allows (design.md "Global
// write effects"), and two handles in one body are in use together. Spawning
// code that logs this way is free of L0707, which the empty
// `log_forwarding_provider.expected-compile` asserts.

worker :: proc() {
	foreach (_ in 0 ..< 2) { log.warning("worker"); }
}

main :: proc() {
	log.info("started");
	helper := thread.spawn(worker);
	helper.join();

	first := log.standard_logger();
	second := log.standard_logger();
	first.write(.Error, "first");
	second.write(.Error, "second");
	fmt.println("records", sink.records());
}
