package main; import "core:fmt";

import "base:interfaces";

Countdown :: struct { start: int }
Countdown_Iterator :: struct { current: int }

impl Countdown {
	Element  :: int;
	Iterator :: Countdown_Iterator;
	iter :: proc(self) -> Countdown_Iterator { return {self.start}; }
}

impl Countdown_Iterator {
	next :: proc(self: inout Countdown_Iterator) -> (int, bool) {
		if (self.current <= 0) { return 0, false; }
		value := self.current;
		self.current -= 1;
		return value, true;
	}
}

// The associated output makes a generic loop's element type available without
// another inferred generic parameter.
first :: proc(source: $S) -> (S.Element, bool)
	where interfaces.Iterable(S) {
	iterator := iter(source);
	return iterator.next();
}

sum_all :: proc(source: $S) -> int
	where interfaces.Iterable(S) {
	total := 0;
	foreach (v in source) {
		total += v;
	}
	return total;
}

main :: proc() {
	#assert(interfaces.Iterable([3]int));
	#assert(interfaces.Iterable(Countdown));
	#assert(!interfaces.Iterable(int));

	xs := [3]int{1, 2, 3};
	a, a_ok := first(xs);
	fmt.println(a);

	half := 1 ..< 4;
	closed := 1 ..= 4;
	b, b_ok := first(half);
	fmt.println(b);

	c, c_ok := first(Countdown{5});
	fmt.println(c);

	fmt.println(sum_all(xs));
	fmt.println(sum_all(half));
	fmt.println(sum_all(closed));
	fmt.println(sum_all(Countdown{3}));

	// m6b-plan step 4: the built-in containers contribute the same protocol
	// members, so generic and direct iteration agree. A map's single `Element` is
	// its value; the key is reachable only through the two-name loop form.
	#assert(interfaces.Iterable([dynamic]int));
	#assert(interfaces.Iterable(map[int]int));
	ys: [dynamic]int = {4, 5, 6};
	fmt.println(sum_all(ys));
	d, d_ok := first(ys);
	fmt.println(d);
	m: map[int]int;
	m[1] = 10;
	m[2] = 20;
	fmt.println(sum_all(m));
}
