package main;

import "core:fmt";
import "./vendor";

// A public procedure of a generic extension reserves its name in this package
// until an instance fills it. The extension on a plain type written after it
// still takes the name, as it does when it is written first.
impl vendor.Cell($T) {
	@(public) describe :: proc(self) -> int { return 1; }
}

impl vendor.Thing {
	@(public) describe :: proc(self) -> int { return self.n; }
}

main :: proc() {
	fmt.println(vendor.Thing{n = 7}.describe(), vendor.Cell(int){value = 1}.describe());
}
