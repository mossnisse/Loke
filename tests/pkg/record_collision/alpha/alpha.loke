@(public)
package alpha;

// Two packages each export a nominal `Token`. Both print as `Token`, so an
// anonymous record built over them must be distinguished by identity rather
// than by the display spelling.
Token :: struct { id: int }

@(public)
make :: proc(id: int) -> (value: Token, weight: int) {
	return {value = Token{id = id}, weight = id * 2};
}

@(public)
read :: proc(v: (value: Token, weight: int)) -> int { return v.value.id + v.weight; }
