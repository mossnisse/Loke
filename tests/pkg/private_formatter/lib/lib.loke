package lib;

import "core:fmt";

// standard-library.md "Printed forms": a public type's `format` is `@(public)`,
// and printing uses it in every package. A private type's own `format` serves
// too, since no importer can name the type; tests/err/private_format.loke
// refuses a public type's private one.

@(public)
Shown :: struct {}

impl Shown {
	@(public)
	format :: proc(self, w: fmt.Writer, o: fmt.Options) { fmt.concat_to(w, "shown"); }
}

hidden :: struct {}

impl hidden {
	format :: proc(self, w: fmt.Writer, o: fmt.Options) { fmt.concat_to(w, "hidden"); }
}

@(public)
show_here :: proc() {
	fmt.println(Shown{}, hidden{});
	value := hidden{};
	view := (dyn fmt.Formattable)(&value);
	fmt.println(view);
}
