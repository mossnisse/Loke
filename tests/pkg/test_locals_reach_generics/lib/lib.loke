@(public) package lib;

import "core:fmt";
import "core:slice";

answer :: proc() -> int { return 42; }

@(test)
sorts_with_a_capture :: proc() {
	limit := 5;
	values := [3]int{3, 1, 2};
	slice.sort_by(&mut values[:], proc(left, right: int) -> bool capture(limit) { return left + limit < right + limit; });
	assert(values[0] == 1);
}

@(test)
prints_a_local :: proc() {
	Local :: struct { x: int }
	impl Local {
		format :: proc(self, w: fmt.Writer, o: fmt.Options) { fmt.concat_to(w, "local"); }
	}
	fmt.println(Local{x = 1});
}
