package main; import "core:fmt";
import "./iface"; import "./widget";

// design.md "Interfaces as reusable constraints" / "Runtime witnesses": a slot
// is matched by an inherent method whatever its visibility, or by an extension
// in the slot's declaring package — so satisfaction, `dyn` erasure, and a
// constrained generic body must all reach the same implementation. The body
// used ordinary visibility-filtered lookup and rejected what the bound accepted.

use :: proc(w: $T) -> int where iface.Readable(T) {
	return w.read();
}

describe :: proc(w: $T) -> int where iface.Described(T) {
	return w.read() + w.label();
}

// Through the type name, which must reach what `w.read()` does.
via_type :: proc(w: $T) -> int where iface.Readable(T) {
	return T.read(w);
}

// The erased path, which already used the satisfying lookup.
observe :: proc(v: dyn iface.Readable) -> int { return v.read(); }

main :: proc() {
	w := widget.make(5);

	// A private inherent method, reached through the bound.
	fmt.println(use(w));
	fmt.println(via_type(w));
	fmt.println(observe((dyn iface.Readable)(&w)));

	// Private extensions in the interface's own package, one of them supplying
	// a slot the composed interface inherited.
	t := widget.Tag{7};
	fmt.println(use(t));
	fmt.println(describe(t));
}
