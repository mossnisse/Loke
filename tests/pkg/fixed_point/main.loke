package main; import "core:fmt";

READY :: true;

// This import appears before an already-active import only after selection.
when (READY) {
	import "early";
}

import "conditional";

// The dependency's selected declaration is collected on the next round.
when (conditional.VALUE == 2) {
	SELECTED :: 3;
}

main :: proc() {
	fmt.println(early.VALUE);
	fmt.println(conditional.VALUE);
	fmt.println(SELECTED);
}
