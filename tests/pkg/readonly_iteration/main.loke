package main;
import "views";
import "core:fmt";

Int_Refs :: type_of([]int{}.refs());
main :: proc() {
	values := [3]int{4, 5, 6};
	local: Int_Refs = views.borrow(values[:]);
	static_assert(Int_Refs == views.Int_Refs);
	foreach (value in views.forward(local).reversed()) { fmt.println(value^); }
	walker := views.forward(local.iter());
	first := walker.next() or_else nil;
	second := walker.next() or_else nil;
	fmt.println(first^, second^);
}
