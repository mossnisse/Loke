package main;

import "core:fmt";
import "core:container";
import "base:interfaces";

// `Small_Array(T, N)` end to end (design.md "Fixed-capacity arrays"). design.md
// spells the type unqualified; here it is reached through
// the package that supplies it, and nothing else about its example changes.

Small :: container.Small_Array(int, 8);

Copied :: struct { id: int }

impl Copied {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Copied, Allocator_Error) {
		return .ok(Copied{self.id + 100});
	}
}

// Slicing through a value parameter: the receiver is immutable here, which is
// the whole reason `span` takes `self` rather than `inout`.
middle :: proc(values: Small) -> int {
	total := 0;
	foreach (value in values[1:3]) { total += value; }
	return total;
}

// The `try_` half answers `Result(Unit, Capacity_Error)`; these checks want the
// variant and, when it failed, the numbers the error carries.
report :: proc(outcome: Result(Unit, container.Capacity_Error)) {
	switch (failure in outcome) {
	case .ok:  fmt.println("ok");
	case .err: fmt.println(failure.requested_of(), failure.capacity_of(), failure);
	}
}

main :: proc() {
	// design.md's own example.
	x: Small = {};
	x.append(1, 2, 3);
	fmt.println(x.len(), x.cap()); // 3 8

	fmt.println(x, x.is_empty(), x.is_full(), x.space());

	// Indexing, in both capabilities, and slicing over the live prefix only.
	fmt.println(x[0], x[2]);
	x[1] = 9;
	fmt.println(x[1]);
	fmt.println(x[0:2]);
	fmt.println(x.slice());
	// A read-only receiver slices too, so this needs no `inout`. A writable
	// subrange is the mutable whole-prefix view, sliced.
	fmt.println(middle(x));
	fmt.println(x.slice()[0:2]);

	// Iteration, forwards and backwards.
	foreach (value in x) { fmt.println(value); }
	foreach (value in x.reversed()) { fmt.println(value); }

	// Growth to the limit, then past it.
	x.append(4, 5, 6, 7, 8);
	fmt.println(x, x.len(), x.is_full());
	report(x.try_append(9));
	fmt.println(x, x.len());

	// Nothing is written unless everything fits.
	y: Small = {};
	y.append(1, 2, 3, 4, 5, 6);
	report(y.try_append(7, 8, 9));
	fmt.println(y, y.len());
	report(y.try_append(7, 8));
	fmt.println(y, y.len());

	// Removal, ordered and not, and the last element.
	z: container.Small_Array(int, 4) = {};
	z.append(10, 20, 30, 40);
	fmt.println(z.pop(), z);
	fmt.println(z.remove(0), z);
	z.append(50);
	fmt.println(z.remove_unordered(0), z);
	fmt.println(z.pop(), z);
	fmt.println(z.pop(), z.pop());
	fmt.println(z.len(), z.pop() or_else -1);
	// The last element, then absence, from the same call.
	z.append(7);
	fmt.println(z.pop(), z.pop());

	// One generic absence contract for built-in and library containers.
	growable: [dynamic]int = {};
	fmt.println(take_last(inout growable), take_last(inout z));
	growable.append(8);
	z.append(8);
	fmt.println(take_last(inout growable), take_last(inout z));

	// A removed owning value survives reuse of the vacated inline slot.
	owned: container.Small_Array([dynamic]int, 2) = {};
	owned.append([dynamic]int{1, 2});
	last := owned.pop() or_else [dynamic]int{};
	owned.append([dynamic]int{3});
	fmt.println(last, owned[0]);

	// `append` is a procedure group even for a copyable element: a written
	// `move(...)` selects the consuming member, so `source` is dead after the
	// call rather than cloned into the array.
	source := [dynamic]int{4, 5};
	owned.append(move(source));
	fmt.println(owned[1]);

	// A one-element unmarked call selects the copying member even though that
	// group also contains a non-variadic consuming member.
	copied: container.Small_Array(Copied, 1) = {};
	copied.append(Copied{1});
	fmt.println(copied.slice()[0].id);

	// Insertion at each end and in the middle.
	w: container.Small_Array(int, 4) = {};
	w.insert(0, 2);
	w.insert(0, 1);
	w.insert(2, 4);
	w.insert(2, 3);
	fmt.println(w);
	report(w.try_insert(0, 0));
	fmt.println(w);

	w.clear();
	fmt.println(w, w.len(), w.is_empty());

	// A `Small_Array` of something that is not a number, to prove `T` is free.
	names: container.Small_Array(string_view, 3) = {};
	names.append("ada", "grace");
	fmt.println(names, names.len());

	// design.md: it supplies the same associated members a built-in sequence
	// does, and satisfies all three sequence interfaces.
	fmt.println(1 if interfaces.Iterable(Small) else 0);
	fmt.println(1 if interfaces.Reverse_Iterable(Small) else 0);
	fmt.println(1 if interfaces.Sequence(Small) else 0);
	fmt.println(1 if interfaces.Mutable_Sequence(Small) else 0);
	fmt.println(1 if interfaces.Growable_Sequence(Small) else 0);
}

take_last :: proc(values: inout $S) -> Option(int) {
	return values.pop();
}
