package main; import "core:fmt"; import "core:mem"; import "core:slice";

// `core:slice` end to end.
//
// The first two blocks are design.md's "Sorting slices" examples verbatim.

// The three element kinds `swap` has to reach: a move-only one, a copyable one
// with no zero value, and one that is both -- which nothing built on `exchange`
// could take, because it has neither a copy nor a zero to install.
Token :: move_only struct { id: int }

Shape :: union { circle: int, square: int }

Sealed :: union { held: Token, spare: Token }

Card :: struct { rank: int, tag: int }

Field_Order :: struct {
	by_tag:     bool,
	descending: ^bool,
}

impl Field_Order {
	call :: proc(self, left, right: Card) -> bool {
		a := left.rank;
		b := right.rank;
		if (self.by_tag) {
			a = left.tag;
			b = right.tag;
		}
		if (self.descending^) { return b < a; }
		return a < b;
	}
}

// A plain procedure is a comparator with no state.
by_rank :: proc(left, right: Card) -> bool { return left.rank < right.rank; }

// A comparator that is not a strict weak ordering. Nothing promises the result
// is sorted, but the runtime introsort must still stay inside the slice and
// finish: `sort_partition`'s scan away from the pivot is bounded by `low`
// precisely so arbitrary user code cannot walk it off the front.
Always_Before :: struct { }

impl Always_Before {
	call :: proc(self, left, right: int) -> bool { return true; }
}

// A `Sealed` payload, read without copying it out of the union.
id_of :: proc(value: Sealed) -> int {
	switch (token in value) {
	case .held:  return token.id;
	case .spare: return token.id;
	}
	return 0;
}

main :: proc() {
	s := []mut int{1, 6, 3, 5 ,7, 3, 0};
	slice.sort(s);
	fmt.println(s);

	r := []mut int{1, 6, 3, 5 ,7, 3, 0};
	slice.reverse_sort(r);
	fmt.println(r);

	// The shapes a sort has to get right whatever the algorithm behind it.
	empty := []mut int{};
	slice.sort(empty);
	fmt.println(empty, empty.len());

	one := []mut int{9};
	slice.sort(one);
	fmt.println(one);

	equal := []mut int{4, 4, 4, 4, 4};
	slice.sort(equal);
	fmt.println(equal);

	reversed := []mut int{9, 8, 7, 6, 5, 4, 3, 2, 1, 0};
	slice.sort(reversed);
	fmt.println(reversed);

	// Sorting is not restricted to integers: `Ordered` is the whole requirement.
	words := []mut string_view{"pear", "apple", "fig"};
	slice.sort(words);
	fmt.println(words);

	floats := []mut f64{2.5, -1.0, 0.5};
	slice.reverse_sort(floats);
	fmt.println(floats);

	// A comparator is an ordinary typed record. Its fields select policy without
	// allocation, procedure capture, or exposing callback state as `rawptr`. The
	// pointer field is a checked borrow of local state carried through the record.
	cards := []mut Card{Card{3, 20}, Card{1, 30}, Card{2, 10}};
	descending := true;
	slice.sort_by(cards, Field_Order{true, &descending});
	fmt.println(cards[0].rank, cards[1].rank, cards[2].rank);
	descending = false;
	slice.sort_by(cards, Field_Order{false, &descending});
	fmt.println(cards[0].tag, cards[1].tag, cards[2].tag);

	// The procedure, then a literal: neither needs a record around it.
	slice.sort_by(cards, by_rank);
	fmt.println(cards[0].rank, cards[1].rank, cards[2].rank);
	slice.sort_by(cards, proc(left, right: Card) -> bool { return right.tag < left.tag; });
	fmt.println(cards[0].tag, cards[1].tag, cards[2].tag);

	// Past `LOKE_RT_SORT_SMALL`, so the quicksort partition runs rather than the
	// insertion tail. A broken comparator may permute these however it likes; it
	// may not lose, duplicate, or reach past one of them.
	junk: [dynamic]int = {};
	i := 0;
	for (i < 64) {
		junk.append(i % 7);
		i = i + 1;
	}
	slice.sort_by(junk[:], Always_Before{});
	total := 0;
	i = 0;
	for (i < junk.len()) {
		total = total + junk[i];
		i = i + 1;
	}
	fmt.println("unordered comparator:", junk.len(), total);

	fmt.println(slice.is_sorted(s), slice.is_sorted(r));
	fmt.println(slice.is_reverse_sorted(r), slice.is_reverse_sorted(s));

	// A search over the sorted copy: the index, and whether it is really there.
	fmt.println(slice.binary_search(s, 5));
	fmt.println(slice.binary_search(s, 4));
	fmt.println(slice.binary_search(s, -1));
	fmt.println(slice.binary_search(s, 100));

	fmt.println(slice.contains(s, 7), slice.contains(s, 8));
	fmt.println(slice.index_of(s, 3), slice.last_index_of(s, 3));
	fmt.println(slice.index_of(s, 8));
	fmt.println(slice.min(s), slice.max(s));
	fmt.println(slice.min(empty), slice.max(empty));
	fmt.println(slice.equal(s, s), slice.equal(s, r));
	// Different lengths are unequal before any element is looked at, which is the
	// only reason `equal` can index `right` with `left`'s indices at all.
	fmt.println(slice.equal(s, one), slice.equal(one, s), slice.equal(empty, empty));

	// Places.
	scratch := []mut int{1, 2, 3, 4, 5};
	slice.swap(scratch, 0, 4);
	fmt.println(scratch);
	slice.reverse(scratch);
	fmt.println(scratch);
	slice.fill(scratch, 7);
	fmt.println(scratch);

	// `reverse` loops on `low + 1 < high`, so the lengths it must not touch and
	// the first one it must are all below five.
	foreach (n in 0 ..< 4) {
		short := []mut int{1, 2, 3}[0:n];
		slice.reverse(short);
		fmt.println(n, short);
	}

	// `swap` and `reverse` trade places rather than copying, so a move-only
	// element goes through both -- the only two procedures here that one can.
	// No copy or drop hook runs on an element either operation moves.
	tokens := []mut Token{Token{1}, Token{2}, Token{3}, Token{4}};
	slice.swap(tokens, 0, 3);
	fmt.println(tokens[0].id, tokens[3].id);
	slice.reverse(tokens);
	fmt.println(tokens[0].id, tokens[1].id, tokens[2].id, tokens[3].id);
	slice.swap(tokens, 2, 2);
	fmt.println(tokens[2].id);

	// A union that designates no zero has nothing `exchange` could install, and
	// one whose payload is move-only has no copy either. Both trade places.
	shapes := []mut Shape{Shape.circle(1), Shape.square(2)};
	slice.swap(shapes, 0, 1);
	slice.reverse(shapes);
	fmt.println(shapes.len());

	sealed := []mut Sealed{Sealed.held(Token{5}), Sealed.spare(Token{6})};
	slice.swap(sealed, 0, 1);
	fmt.println(id_of(sealed[0]), id_of(sealed[1]));
	slice.reverse(sealed);
	fmt.println(id_of(sealed[0]), id_of(sealed[1]));
	// The contributed member is the same operation the free spelling forwards to,
	// and two equal indices leave the element as it is.
	sealed.swap(0, 0);
	fmt.println(id_of(sealed[0]));

	// An owned copy outlives the view it came from, which is the whole point.
	owned := slice.clone(s);
	fmt.println(owned, owned.len(), owned.cap() >= owned.len());
	slice.reverse(owned[:]);
	fmt.println(owned);

	// The allocator is a parameter, not a fixed choice, and `try_clone` is the
	// spelling that hands back the failure instead of panicking on it.
	arena := mem.Arena.init();
	scoped := slice.clone(s, arena.allocator());
	fmt.println(scoped);
	switch (result in slice.try_clone(s, arena.allocator())) {
	case .ok: fmt.println("ok", result.len());
	case .err: fmt.println("err", result);
	}
}
