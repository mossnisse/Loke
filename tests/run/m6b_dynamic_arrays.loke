package main; import "core:fmt";

// The dynamic-array operation set, end to end (m6b-plan step 2).
//
// design.md "Dynamic arrays": literals, `make`, indexing, slicing, length and
// capacity, and the mutating operations. Every one of them is a contributed
// member, so `xs.append(1)` is an ordinary method call and the same members are
// what generic code finds.
//
// `cap` is deliberately printed only where the growth policy is pinned by the
// runtime tests; elsewhere the observable promise is `cap >= len`.

count_bytes :: proc(parts: []string) -> int {
	total := 0;
	for (i := 0; i < parts.len(); i += 1) {
		total += parts[i].len();
	}
	return total;
}

main :: proc() {
	// A literal builds a container; it is never a constant, because it allocates.
	xs := [dynamic]int{1, 2, 3};
	fmt.println(xs.len());
	fmt.println(xs[0] + xs[2]);

	// Indexing is a place: readable, writable, and compound-assignable.
	xs[1] = 20;
	xs[1] += 2;
	fmt.println(xs[1]);

	// Appending several values, and spreading another container's view.
	ys := make([dynamic]int, 0, 2) or_else {};
	ys.append(4, 5);
	ys.append(..xs[:], 6);
	fmt.println(ys.len());

	// Slicing views the current allocation and stops at the length, never at the
	// capacity: the slots past `len` hold no initialised element.
	fmt.println(ys[:].len());
	fmt.println(ys[1:3].len());

	// Removal moves the element out rather than cloning it. `remove` keeps order;
	// `remove_unordered` fills the hole with the last element.
	first := ys.remove(0);
	fmt.println(first);
	swapped := ys.remove_unordered(0);
	fmt.println(swapped);
	fmt.println(ys.len());

	// An empty container has nothing to pop.
	empty: [dynamic]int = {};
	switch (nothing in empty.pop()) {
	case .some:
		fmt.println(nothing);
		fmt.println(true);
	case .none:
		fmt.println(0);
		fmt.println(false);
	}

	// Capacity: `reserve` promises only `cap >= n`; `shrink` may keep slack, and
	// `shrink(min)` keeps at least that floor.
	empty.reserve(64);
	fmt.println(empty.cap() >= 64);
	empty.append(1, 2);
	empty.shrink();
	fmt.println(empty.cap());
	empty.reserve(64);
	empty.shrink(10);
	fmt.println(empty.cap());

	// `resize` zero-fills a grown tail and destroys a truncated one.
	empty.resize(5);
	fmt.println(empty.len());
	fmt.println(empty[4]);
	empty.resize(1);
	fmt.println(empty.len());

	// Managed elements: insertion clones, removal moves out, `clear` destroys
	// every live element and keeps the capacity.
	names: [dynamic]string = {};
	names.append("alpha", "be", "c");
	names.insert(1, "dd");
	fmt.println(names.len());
	fmt.println(names[1]);
	fmt.println(count_bytes(names[:]));
	taken := names.remove(0);
	fmt.println(taken);
	names.clear();
	fmt.println(names.len());
	fmt.println(names.cap() >= 4);
}
