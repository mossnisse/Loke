package main; import "core:mem"; import "core:fmt";

// The seed runtime's default provider, end to end (m6a-plan step 1). The
// allocation is real memory from the system heap, the handle survives being
// copied through a parameter, and the release returns the same size and
// alignment the provider was given.

Wide :: struct { a: i128, b: int }

round_trip :: proc(allocator: Allocator) -> int {
	p := try_new(Wide, allocator) or_else nil;
	if (p == nil) {
		return -1;
	}
	p.b = 7;
	total := p.b;
	free(p, allocator);
	return total;
}

main :: proc() {
	fmt.println(round_trip(mem.default_allocator()));

	// `new_clone` through the same provider, with a value whose clone can fail.
	switch (q in try_new_clone(41)) {
	case .ok:
		fmt.println(q^ + 1);
		free(q);
	case .err: fmt.println("allocation failed");
	}
}
