// design.md "Borrowing iteration": a lent element names the source's own
// storage and carries its provenance, so a view of it, or `&item`, borrows the
// source. Through a borrowed parameter, that view may be returned. A copy of
// a view element keeps only the element's own borrow (design.md "Procedure
// result contracts").
package main;

import "core:fmt";
import "core:strings";

Entry :: struct { name: string, count: int }
Doc :: struct {
	items:   [dynamic]string,
	entries: [dynamic]Entry,
}

impl Doc {
	first_long :: proc(self: ^) -> string_view {
		foreach (item in self.items) {
			if (item.len() > 3) { return item; }
		}
		return "";
	}
}

through_pointer :: proc(doc: ^Doc) -> string_view {
	foreach (item in doc.items) { return item; }
	return "";
}

// The elements live in what the slice views, not in the parameter's slot.
through_slice :: proc(items: []string) -> string_view {
	foreach (item in items) { return item; }
	return "";
}

element_pointer :: proc(doc: ^Doc) -> ^string {
	foreach (item in doc.items) {
		if (item == "second") { return &item; }
	}
	return &doc.items[0];
}

field_of_element :: proc(doc: ^Doc) -> string_view {
	foreach (entry in doc.entries) {
		if (entry.count > 1) { return entry.name; }
	}
	return "";
}

// A view kept from an earlier step does not stop the loop reading its source
// through the pointer again, as an indexed read would not.
last_through_mutable :: proc(items: ^mut [dynamic]string) -> string_view {
	kept: string_view = "";
	foreach (item in items^) { kept = item; }
	return kept;
}

first_view :: proc(values: []string_view) -> string_view {
	foreach (value in values) { return value; }
	return "";
}

Labeled :: struct { label: string_view, count: int }

first_label :: proc(values: []Labeled) -> string_view {
	foreach (value in values) { return value.label; }
	return "";
}

// A copy kept after the loop does not hold the slice.
last_then_changed :: proc(values: []mut string_view) -> string_view {
	kept: string_view = "";
	foreach (value in values) { kept = value; }
	values[0] = "changed";
	return kept;
}

// design.md "Weakening and reborrows": a traversal through a mutable pointer
// reborrows it read-only, which still allows reading the source and changing
// another field; a mutable traversal still allows changing the element.
Counts :: struct { values: [dynamic]int, total: int }

read_during_traversal :: proc(counts: ^mut Counts) -> int {
	foreach (value in counts.values) {
		counts.total += value * counts.values.len();
	}
	foreach (&mut value in counts.values) { value += 1; }
	counts.values.append(counts.total);
	return counts.total;
}

// The same holds two pointers away, and reading through the outer pointer
// beside a read-only reborrow of it is still only a read.
read_two_pointers_away :: proc(p: ^mut ^mut [dynamic]int) -> int {
	total := 0;
	foreach (value in p^^) { total += value * p^.len() + p^^[0]; }
	foreach (&mut value in p^^) { value += 1; }
	view: ^^mut [dynamic]int = p;
	total += p^.len() + view^^[0];
	p^.append(total);
	return total;
}

main :: proc() {
	numbers := make([dynamic]int, 0, 3);
	numbers.append(1, 2);
	pointer := &mut numbers;
	fmt.println(read_two_pointers_away(&mut pointer), numbers[0], numbers[1], numbers[2]);
	counts := Counts{make([dynamic]int, 0, 3), 0};
	counts.values.append(1, 2);
	fmt.println(read_during_traversal(&mut counts), counts.values[0], counts.values[1], counts.values[2]);
	// The copies view static text, so they outlive the arrays they came from.
	copied: string_view = "";
	label: string_view = "";
	{
		values := [2]string_view{"static", "text"};
		labeled := [1]Labeled{{"label", 1}};
		copied = first_view(values[:]);
		label = first_label(labeled[:]);
		fmt.println(last_then_changed(&mut values[:]));
		fmt.println(values[0]);
	}
	fmt.println(copied, label);
	doc := Doc{make([dynamic]string, 0, 2), make([dynamic]Entry, 0, 2)};
	doc.items.append(strings.copy("ab"), strings.copy("second"));
	doc.entries.append(Entry{strings.copy("one"), 1}, Entry{strings.copy("two"), 2});
	fmt.println(doc.first_long());
	fmt.println(through_pointer(&doc));
	fmt.println(through_slice(doc.items[:]));
	fmt.println(element_pointer(&doc)^);
	fmt.println(field_of_element(&doc));
	fmt.println(last_through_mutable(&mut doc.items));
	// Returning a view left every element in place.
	fmt.println(doc.items[0], doc.items[1], doc.entries[0].name, doc.entries[1].name);
}
