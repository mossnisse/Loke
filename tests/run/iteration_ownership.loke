package main;
import "core:container";
import "core:fmt";

copies: int;
Tracked :: struct { id: int, }
impl Tracked {
	copy_item :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked, Allocator_Error) {
		copies += 1;
		return .ok(Tracked{self.id});
	}
	drop_item :: hook(drop) proc(self: inout Tracked) {}
}

// design.md "Borrowing iteration": a move-only element is read like any other.
Locked :: move_only struct { id: int, }
impl Locked {
	release :: hook(drop) proc(self: inout Locked) { self.id = 0; }
}

sum :: proc(items: []Locked) -> int {
	total := 0;
	foreach (item in items) { total += item.id; }
	return total;
}

// design.md "Iteration protocol": an iterator declaring `Yield_Borrowed` hands
// back a pointer into its source, and a loop binds the element it names rather
// than the pointer. The descriptors are universe names, so this needs no import.
Lender :: struct { values: []int, }
Lender_Iterator :: struct { source: []int, at: int, }
impl Lender {
	Element  :: int;
	Iterator :: Lender_Iterator;
	iter :: proc(self) -> Lender_Iterator { return {self.values, 0}; }
}
impl Lender_Iterator {
	Yield :: Yield_Borrowed;
	next :: proc(self: inout Lender_Iterator) -> Option(^int) {
		if (self.at >= self.source.len()) { return .none; }
		item := &self.source[self.at];
		self.at += 1;
		return .some(item);
	}
}

drops: int;
Sequence :: struct { count: int, }
Cursor :: struct { at: int, count: int, active: bool, }
impl Sequence {
	Element :: int;
	Iterator :: Cursor;
	iter :: proc(self) -> Cursor { return {0, self.count, true}; }
}
impl Cursor {
	// design.md "Iteration protocol": an owned descriptor says what an iterator
	// declaring none already means, so spelling it changes nothing here.
	Yield :: Yield_Owned;

	next :: proc(self: inout Cursor) -> Option(int) {
		if (self.at >= self.count) { return .none; }
		self.at += 1;
		return .some(self.at);
	}
	finish :: hook(drop) proc(self: inout Cursor) { if (self.active) { drops += 1; } }
}

main :: proc() {
	xs: container.Small_Array(Tracked, 64) = {};
	xs.append(Tracked{1}, Tracked{2});
	copies = 0;
	view := xs.reversed().indexed();
	it := view.iter();
	fmt.println(copies);
	fmt.println(size_of(it) < size_of(xs));
	// Keep it live until here, then end the immutable traversal before mutation.
	drop(it);
	foreach (&value in xs) { value.id += 1; }
	fmt.println(copies);
	// Capacity never appears in either iterator type.
	fmt.println(size_of(container.Small_Array(int, 4).Iterator) == size_of(container.Small_Array(int, 128).Iterator));
	fmt.println(size_of(container.Small_Array(int, 4).Mut_Iterator) == size_of(container.Small_Array(int, 128).Mut_Iterator));
	// design.md "Borrowing iteration": traversing a place lends each element, so
	// a plain loop over contiguous storage clones nothing whatever the element
	// type, and copying one is written.
	owned := [dynamic]Tracked{};
	owned.append(Tracked{5});
	owned.append(Tracked{6});
	copies = 0;
	foreach (value in owned) { fmt.println(value.id); }
	foreach (value in owned.reversed()) { fmt.println(value.id); }
	fmt.println(copies);
	foreach (value in owned.copied()) { fmt.println(value.id); }
	fmt.println(copies);
	copies = 0;
	foreach (value in owned) { saved := value; fmt.println(saved.id); }
	fmt.println(copies);

	// A move-only element has no copy to make, and now needs none to be read.
	locked := [dynamic]Locked{};
	locked.append(Locked{7});
	foreach (value in locked) { fmt.println(value.id); }
	fmt.println(sum(locked[:]));
	_ = owned;
	_ = locked;

	// A user iterator that lends, and the built-in one, agree: both hand back a
	// pointer into the source, and neither copies.
	numbers := [3]int{1, 2, 3};
	foreach (value in Lender{numbers[:]}) { fmt.println(value); }
	walker := owned.iter();
	stepping := true;
	for (stepping) {
		switch (one in walker.next()) {
		case .some: fmt.println(one^.id);
		case .none: stepping = false;
		}
	}
	fmt.println(copies);

	sequence := Sequence{3};
	indexed := sequence.indexed();
	foreach (value, index in indexed) { if (value == 2) { break; } }
	fmt.println(drops);
	foreach (value, index in indexed) { continue; }
	fmt.println(drops);
}
