package main;

import "base:interfaces";
import "core:container";
import "core:fmt";
import "core:mem";

// standard-library.md "Deques": both ends, indexing, capacity, and the ways of
// reading a ring across every wrap and growth boundary.

Deque_Int :: container.Deque(int);

static_assert(interfaces.Iterable(Deque_Int));
static_assert(interfaces.Reverse_Iterable(Deque_Int));
static_assert(interfaces.Mutable_Iterable(Deque_Int));
static_assert(interfaces.Sequence(Deque_Int));
static_assert(interfaces.Mutable_Sequence(Deque_Int));
static_assert(interfaces.Growable_Sequence(Deque_Int));
static_assert(interfaces.Equatable(Deque_Int));
static_assert(interfaces.Cloneable(Deque_Int));

@(move_only) Unique :: struct { id: int }

static_assert(interfaces.Iterable(container.Deque(Unique)));
static_assert(interfaces.Reverse_Iterable(container.Deque(Unique)));
static_assert(interfaces.Mutable_Iterable(container.Deque(Unique)));
static_assert(!interfaces.Sequence(container.Deque(Unique)));
static_assert(!interfaces.Mutable_Sequence(container.Deque(Unique)));
static_assert(!interfaces.Growable_Sequence(container.Deque(Unique)));

// What generic code over a dynamic array sees is what it sees here.
sum :: proc(values: $S) -> int where interfaces.Sequence(S) {
	total := 0;
	foreach (i in 0 ..< values.len()) { total += values[i]; }
	return total;
}

add :: proc(values: inout $S, value: int) where interfaces.Growable_Sequence(S) {
	values.append(value);
}

next_random :: proc(state: inout u64) -> u64 {
	state ~= state << 13;
	state ~= state >> 7;
	state ~= state << 17;
	return state;
}

check :: proc(d: ^Deque_Int, model: ^[dynamic]int) {
	if (d.len() != model.len()) { panic("len"); }
	front, back := d.as_slices();
	if (front.len() + back.len() != model.len()) { panic("run lengths"); }
	if (back.len() > 0 && front.len() == 0) { panic("back without front"); }
	foreach (i in 0 ..< model.len()) {
		if (d.at(i)^ != model^[i]) { panic("at"); }
		run := front[i] if i < front.len() else back[i - front.len()];
		if (run != model^[i]) { panic("run"); }
	}
	at := 0;
	foreach (value in d^) {
		if (value != model^[at]) { panic("iter"); }
		at += 1;
	}
	at = model.len();
	reverse := d.iter_reverse();
	for (;;) {
		switch (reverse.next()) {
		case .some(value):
			at -= 1;
			if (value^ != model^[at]) { panic("iter_reverse"); }
			continue;
		case .none:
		}
		break;
	}
	if (at != 0) { panic("iter_reverse length"); }
}

// Random operations against a plain array, crossing every wrap and growth boundary.
model_check :: proc() {
	state: u64 = 0x2545F4914F6CDD1D;
	d: Deque_Int = {};
	model: [dynamic]int = {};
	next := 0;
	foreach (step in 0 ..< 30000) {
		choice := next_random(inout state) % 16;
		next += 1;
		if (choice < 4) {
			d.append(next);
			model.append(next);
		} else if (choice < 7) {
			d.prepend(next);
			model.insert(0, next);
		} else if (choice < 10) {
			a := d.pop();
			b := model.pop();
			if (a != b) { panic("pop"); }
		} else if (choice < 13) {
			a := d.pop_front();
			if (model.len() == 0) {
				if (a != .none) { panic("pop_front"); }
			} else {
				if (a != Option(int).some(model.remove(0))) { panic("pop_front"); }
			}
		} else if (choice == 13 && model.len() > 0) {
			index := int(next_random(inout state) % u64(model.len() + 1));
			d.insert(index, next);
			model.insert(index, next);
		} else if (choice == 14 && model.len() > 0) {
			index := int(next_random(inout state) % u64(model.len()));
			if (d.remove(index) != model.remove(index)) { panic("remove"); }
		} else if (step % 97 == 0) {
			if (next % 3 == 0) { d.shrink(); } else if (next % 3 == 1) { _ = d.make_contiguous(); } else { d.retain(proc(item: int) -> bool { return item % 5 != 0; }); }
			if (next % 3 == 2) {
				at := 0;
				for (at < model.len()) {
					if (model[at] % 5 == 0) { _ = model.remove(at); } else { at += 1; }
				}
			}
		} else if (step % 1009 == 0) {
			d.clear();
			model.clear();
		}
		check(&d, &model);
	}
	fmt.println("model ok");
}

// make_contiguous at every head and length of one capacity, so that the slide
// crosses every overlap between the back run and its destination.
contiguous_check :: proc() {
	capacity := Deque_Int.init(8).cap();
	foreach (head in 0 ..< capacity) {
		foreach (count in 0 ..= capacity) {
			d := Deque_Int.init(capacity);
			foreach (_ in 0 ..< head) {
				d.append(0);
				_ = d.pop_front();
			}
			foreach (value in 0 ..< count) { d.append(value); }
			run := d.make_contiguous();
			if (run.len() != count) { panic("contiguous length"); }
			foreach (i in 0 ..< count) {
				if (run[i] != i) { fmt.println("contiguous", head, count, run); break; }
			}
			front, back := d.as_slices();
			if (back.len() != 0 || front.len() != count) { panic("still wrapped"); }
			if (d.cap() != capacity) { panic("contiguous allocated"); }
		}
	}
	fmt.println("contiguous ok");
}

flood :: proc(light: []mut int, frontier: inout container.Deque(int), seed: int) {
	frontier.clear();
	light[seed] = 15;
	frontier.append(seed);
	for (;;) {
		switch (frontier.pop_front()) {
		case .none:
			return;
		case .some(at):
			level := light[at] - 1;
			if (level <= 0) { continue; }
			foreach (step in [2]int{-1, 1}) {
				next := at + step;
				if (next >= 0 && next < light.len() && light[next] < level) {
					light[next] = level;
					frontier.append(next);
				}
			}
		}
	}
}

Unit :: struct {}

main :: proc() {
	// The zero value is empty and usable.
	d: Deque_Int = {};
	fmt.println(d.len(), d.cap(), d.is_empty(), d.pop(), d.pop_front(), d.first(), d.last());
	d.append(1);
	d.append(2, 3);
	d.prepend(0);
	fmt.println(d, d.len(), d.cap() >= 4);
	switch (d.first()) { case .some(p): fmt.println(p^); case .none: }
	switch (d.last()) { case .some(p): fmt.println(p^); case .none: }
	switch (d.first_mut()) { case .some(p): p^ = 10; case .none: }
	switch (d.last_mut()) { case .some(p): p^ = 30; case .none: }
	d[1] = 11;
	d[2] += 9;
	fmt.println(d, d[0], d[3], d.at(2)^);

	// Traversal from either end, read and written.
	foreach (value in d) { fmt.print(value, ""); }
	fmt.println();
	foreach (&mut value in d) { value += 1; }
	mutable := d.iter_mut();
	for (;;) {
		switch (mutable.next()) { case .some(p): p^ *= 2; continue; case .none: }
		break;
	}
	backwards := d.iter_mut_reverse();
	switch (backwards.next()) { case .some(p): p^ = -1; case .none: }
	fmt.println(d);

	// Equality ignores where the ring starts. A copy is independent.
	wrapped := Deque_Int.init(8);
	foreach (_ in 0 ..< 2) { wrapped.append(0); }
	foreach (_ in 2 ..< wrapped.cap() - 2) { wrapped.append(0); }
	foreach (_ in 2 ..< wrapped.cap() - 2) { _ = wrapped.pop_front(); }
	_ = wrapped.pop_front();
	_ = wrapped.pop_front();
	foreach (value in [4]int{1, 2, 3, 4}) { wrapped.append(value); }
	straight := Deque_Int.init(16);
	foreach (value in [4]int{1, 2, 3, 4}) { straight.append(value); }
	front, back := wrapped.as_slices();
	fmt.println(front.len(), back.len(), wrapped == straight, wrapped != straight);
	copied := wrapped.clone();
	copied[0] = 9;
	fmt.println(copied, wrapped, copied == wrapped);
	front_mut, back_mut := wrapped.as_slices_mut();
	front_mut[0] = 7;
	back_mut[0] = 8;
	fmt.println(wrapped);
	via_arena_room: [1024]u8 = {};
	via_arena := mem.Arena.from_buffer(&mut via_arena_room[:]);
	placed: Deque_Int via via_arena.allocator() = wrapped.clone();
	fmt.println(placed);

	// Middle insertion and removal keep the order, whichever side moves.
	m := Deque_Int.init();
	foreach (value in 0 ..< 6) { m.append(value); }
	m.insert(0, 100);
	m.insert(1, 101);
	m.insert(8, 102);
	m.insert(7, 103);
	fmt.println(m);
	last_index := m.len() - 1;
	fmt.println(m.remove(0), m.remove(0), m.remove(last_index - 2), m.remove(last_index - 4), m);
	m.retain(proc(item: int) -> bool { return item % 2 == 0; });
	fmt.println(m);

	// Capacity is reusable, and only shrink gives it back.
	c := Deque_Int.init(10);
	before := c.cap();
	foreach (value in 0 ..< 10) { c.append(value); }
	_ = c.pop_front();
	c.clear();
	fmt.println(c.len(), c.cap() == before);
	c.append(5);
	c.shrink(3);
	fmt.println(c.cap(), c);
	c.shrink();
	fmt.println(c.cap(), c);
	fmt.println(c.try_reserve(9) == .ok, c.cap() >= 9, c.try_shrink() == .ok, c.cap());
	c.pop();
	c.shrink();
	fmt.println(c.cap());

	// An allocator of its own.
	room: [4096]u8 = {};
	arena := mem.Arena.from_buffer(&mut room[:]);
	on_arena := Deque_Int.try_init(4, arena.allocator()) or_else panic("small");
	foreach (value in 0 ..< 20) { on_arena.append(value); }
	fmt.println(on_arena.len(), on_arena.at(19)^);

	// Generic code written for a sequence.
	grown := [dynamic]int{};
	add(inout grown, 1);
	add(inout d, 1);
	fmt.println(sum(grown), sum(d));

	// Zero-sized elements need no special case.
	units: container.Deque(Unit) = {};
	foreach (_ in 0 ..< 10) { units.append(Unit{}); }
	_ = units.pop_front();
	units.prepend(Unit{});
	fmt.println(units.len(), units.pop() != .none, units.len());

	// A worked use: breadth-first search that reuses its queue.
	light: [16]int = {};
	frontier: container.Deque(int) = {};
	flood(&mut light[:], inout frontier, 3);
	capacity := frontier.cap();
	flood(&mut light[:], inout frontier, 8);
	fmt.println(light, frontier.cap() == capacity);

	model_check();
	contiguous_check();
}
