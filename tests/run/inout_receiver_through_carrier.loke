package main;

import "core:fmt";

// design.md "Weakening and reborrows": an `inout` receiver reached through a carrier
// is a borrow of that place only, and only while the call or what it returns is in
// use. A result that is not used again leaves the carrier free.

Record :: struct { items: map[int]int, count: int }

impl Record {
	count_of :: proc(self: inout) -> ^mut int { return &mut self.count; }
}

// The entry is no longer used when the map is cleared.
cleared_after_use :: proc(p: ^mut map[int]int) {
	entry := p^.find_or_insert(3, 7);
	entry^ += 1;
	fmt.println(entry^);
	p^.clear();
	fmt.println(p^.len());
}

beside_a_field :: proc(r: ^mut Record) {
	entry := r^.items.find_or_insert(3, 7);
	r^.count = 2;
	entry^ += r^.count;
	fmt.println(entry^, r^.count);
}

// The key is read from beside the receiver.
argument_beside_the_receiver :: proc(r: ^mut Record) {
	r^.items.find_or_insert(r^.count, 1)^ += 1;
	fmt.println(r^.items.len());
}

beside_an_element :: proc(rows: []mut map[int]int) {
	entry := rows[0].find_or_insert(3, 7);
	rows[1].clear();
	fmt.println(entry^, rows[1].len());
}

in_a_loop :: proc(p: ^mut map[int]int) {
	for (i := 0; i < 3; i += 1) {
		entry := p^.find_or_insert(i, 1);
		entry^ += i;
	}
	fmt.println(p^.len());
}

// What the receiver is lent to is the caller's, which holds it as the result's.
entry_of :: proc(p: ^mut map[int]int) -> ^mut int { return p^.find_or_insert(9, 9); }

// The entry stays with the map it came from when the pointer moves on.
pointer_moved_on :: proc() {
	a := map[int]int{};
	defer drop(a);
	b := map[int]int{};
	defer drop(b);
	b.find_or_insert(1, 1);
	p := &mut a;
	entry := p^.find_or_insert(3, 7);
	p = &mut b;
	p^.clear();
	fmt.println(entry^, b.len());
}

// A weakened result only reads, so a read of the map goes on beside it.
read_beside_a_weakened_entry :: proc(p: ^mut map[int]int) {
	entry: ^int = p^.find_or_insert(3, 7);
	fmt.println(p^.len(), entry^);
}

printed_beside_a_read :: proc(p: ^mut map[int]int) {
	fmt.println(p^.find_or_insert(4, 5)^, p^.len());
	p^.clear();
}

// What a removal hands back is not a borrow of the container.
popped_then_cleared :: proc(p: ^mut [dynamic]int) {
	last := p^.pop() or_else 0;
	p^.clear();
	fmt.println(last, p^.len());
}

a_user_method :: proc(r: ^mut Record) {
	count := r^.count_of();
	count^ += 1;
	r^.count += 1;
	fmt.println(r^.count);
}

main :: proc() {
	m := map[int]int{};
	defer drop(m);
	cleared_after_use(&mut m);
	r := Record{};
	defer drop(r);
	beside_a_field(&mut r);
	argument_beside_the_receiver(&mut r);
	a_user_method(&mut r);
	rows := [2]map[int]int{{}, {}};
	defer drop(rows);
	beside_an_element(&mut rows[:]);
	in_a_loop(&mut m);
	entry := entry_of(&mut m);
	entry^ += 1;
	fmt.println(entry^);
	pointer_moved_on();
	read_beside_a_weakened_entry(&mut m);
	printed_beside_a_read(&mut m);
	d := [dynamic]int{4, 6};
	defer drop(d);
	popped_then_cleared(&mut d);
}
