package main;
import "core:fmt";
import "core:slice";

// design.md "Parameter semantics and ABI lowering": a value over 4096 bytes
// crosses a call as an address. The thunks the container runtime calls pass
// elements and keys to user procedures in that same representation.
Big :: struct { id: int, pad: [4096]u8 }
impl Big {
	less :: operator(<) proc(a, b: Big) -> bool { return a.id < b.id; }
}

// A comparator taken by value is large too.
By_Id :: struct { descending: bool, pad: [4096]u8 }
impl By_Id {
	call :: proc(self, left, right: Big) -> bool {
		if (self.descending) { return left.id > right.id; }
		return left.id < right.id;
	}
}

// A key's own `hash` and `==`, each taking it by value.
Key :: struct { id: int, pad: [4096]u8 }
impl Key {
	hash :: proc(self, seed: uint) -> uint { return self.id.hash(seed); }
	same :: operator(==) proc(a, b: Key) -> bool { return a.id == b.id; }
}

main :: proc() {
	xs := [dynamic]Big{Big{2, {}}, Big{1, {}}, Big{3, {}}};
	xs.sort();
	fmt.println(xs[0].id, xs[1].id, xs[2].id);
	slice.sort_by(xs[:], By_Id{true, {}});
	fmt.println(xs[0].id, xs[1].id, xs[2].id);

	keyed: map[Key]int = {};
	keyed[Key{1, {}}] = 10;
	keyed[Key{2, {}}] = 20;
	keyed[Key{1, {}}] = 11;
	fmt.println(keyed[Key{1, {}}], keyed[Key{2, {}}], keyed.len());

	// The compiler's own pair for a large array key.
	arrays: map[[513]int]int = {};
	first: [513]int = {};
	second: [513]int = {};
	second[512] = 1;
	arrays[first] = 5;
	arrays[second] = 6;
	fmt.println(arrays[first], arrays[second], arrays.len());
}
