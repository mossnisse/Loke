package main;

import "core:fmt";
import "core:slice";

// `sort` and `reverse_sort` as contributed members.
//
// design.md writes both spellings — `s.sort()` on a dynamic array and the free
// `slice.sort(s)` — and this file is not `core:slice`, which is the whole point
// of contributing the member: an `impl [dynamic]T` written there would be an
// extension visible only inside that package.

// A user element with its own inherent `<`. The comparison the sort uses is
// this operator, not the field order or the representation.
Card :: struct { rank: int, name: string_view }

impl Card {
	// Exported, because the free spellings below resolve `<` and `==` from inside
	// `core:slice`, and design.md "Exported names" gates an inherent operator the
	// same way it gates a method. The member spellings need no such thing: the
	// sort they call is contributed, and the comparison happens in this package.
	@(public)
	before :: operator(<) proc(a, b: Card) -> bool { return a.rank < b.rank; }
	@(public)
	equal :: operator(==) proc(a, b: Card) -> bool { return a.rank == b.rank; }
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, self.name);
	}
}

// A distinct type reaching its underlying `<` through a delegation.
Meters :: distinct f64;

impl Meters {
	delegate(<, ==);
}

sorted_copy :: proc(values: []int) -> [dynamic]int {
	out := slice.clone(values);
	out.sort();
	return move(out);
}

main :: proc() {
	// design.md's own example.
	s: [dynamic]int = {};
	s.append(1, 6, 3, 5, 7, 3, 0); // [1, 6, 3, 5, 7, 3, 0]
	s.sort(); // [0, 1, 3, 3, 5, 6, 7]
	fmt.println(s);
	s.reverse_sort();
	fmt.println(s);

	// The free spelling and the member spelling are one implementation.
	a := []mut int{5, 2, 9, 2, 7};
	b := []mut int{5, 2, 9, 2, 7};
	slice.sort(a);
	b.sort();
	fmt.println(a, b, slice.equal(a, b));
	slice.reverse_sort(a);
	b.reverse_sort();
	fmt.println(a, b, slice.equal(a, b));

	// The shapes a sort has to get right whatever the algorithm behind it.
	empty: [dynamic]int = {};
	empty.sort();
	fmt.println(empty, empty.len());

	one := [dynamic]int{9};
	one.sort();
	fmt.println(one);

	same := [dynamic]int{4, 4, 4, 4, 4, 4, 4};
	same.sort();
	fmt.println(same);

	// Long enough to leave the insertion-sort cutoff and exercise the partition,
	// in the two arrangements a naive quicksort degenerates on.
	descending: [dynamic]int = {};
	foreach (i in 0 ..< 64) { descending.append(63 - i); }
	descending.sort();
	fmt.println(descending[0], descending[31], descending[63], slice.is_sorted(descending[:]));

	ascending: [dynamic]int = {};
	foreach (i in 0 ..< 64) { ascending.append(i); }
	ascending.reverse_sort();
	fmt.println(ascending[0], ascending[63], slice.is_reverse_sorted(ascending[:]));

	// A few permutations through one deterministic shuffle, so the answer is
	// checked rather than the order of one hand-written input.
	mixed: [dynamic]int = {};
	value := 1;
	foreach (i in 0 ..< 50) {
		value = (value*48271) % 2147483647;
		mixed.append(value % 100);
	}
	mixed.sort();
	fmt.println(mixed.len(), slice.is_sorted(mixed[:]), mixed[0] <= mixed[49]);

	// An element wider than a machine word, and one with its own `<`.
	cards := [dynamic]Card{Card{3, "three"}, Card{1, "one"}, Card{2, "two"}};
	cards.sort();
	fmt.println(cards);
	cards.reverse_sort();
	fmt.println(cards);

	// A managed element: sorting moves the headers, and every string survives it.
	words := [dynamic]string{"pear", "apple", "fig", "date"};
	words.sort();
	fmt.println(words);

	// A delegated `<`.
	spans := []mut Meters{Meters(3.5), Meters(-1.0), Meters(0.25)};
	spans.sort();
	fmt.println(f64(spans[0]), f64(spans[1]), f64(spans[2]));

	// A borrow of the container ends at the sort, so this is the ordinary
	// borrow-then-sort-then-read order rather than one live across it.
	fmt.println(sorted_copy([]int{3, 1, 2}));

	// The other half of "both spellings": the free ones, on the same user
	// element. `core:slice` is not this package, so its `Ordered` and `Equatable`
	// bounds resolve `<` and `==` from over there, and reach only what `Card`
	// exports -- which is why the two operators above carry `@(public)` and the
	// member spellings needed nothing. Given that, the two spellings agree.
	loose := []mut Card{Card{3, "three"}, Card{1, "one"}, Card{2, "two"}};
	slice.sort(loose);
	fmt.println(loose, slice.is_sorted(loose));
	slice.reverse_sort(loose);
	fmt.println(loose, slice.is_reverse_sorted(loose));
	slice.sort(loose);
	fmt.println(slice.binary_search(loose, Card{2, "?"}));
	// Two statements: known-gaps.md "A carrier's own loan and its elements'
	// borrows are one set".
	fmt.println(slice.min(loose));
	fmt.println(slice.max(loose));

	// `Card`s `==` compares rank alone. Field-wise equality would answer `false`
	// here, so this is the answer only the inherent operator can give.
	fmt.println(slice.contains(loose, Card{2, "?"}), slice.index_of(loose, Card{2, "?"}));

	// A delegated `<` and `==` reach the free spellings too -- and reach them
	// without `@(public)`, unlike the written operators above.
	widths := []mut Meters{Meters(3.5), Meters(-1.0), Meters(0.25)};
	slice.sort(widths);
	fmt.println(f64(widths[0]), slice.is_sorted(widths), slice.contains(widths, Meters(0.25)));
}
