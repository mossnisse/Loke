package main;

import "core:fmt";

Value :: union { bool, i32, f64 }
Box :: struct {}

impl Box {
	active_typeid :: proc(self) -> int { return 42; }
}

calls: int;

make_value :: proc() -> Value {
	calls += 1;
	return true;
}

make_box :: proc() -> Box { return {}; }

main :: proc() {
	value: Value;
	fmt.println(1 if value.active_typeid() == nil else 0);

	value = i32(7);
	fmt.println(1 if value.active_typeid() == typeid_of(i32) else 0);
	fmt.println(1 if value.active_typeid() != typeid_of(Value) else 0);

	value = 2.5;
	fmt.println(1 if value.active_typeid() == typeid_of(f64) else 0);

	fmt.println(1 if make_value().active_typeid() == typeid_of(bool) else 0);
	fmt.println(calls);

	// The compiler-provided operation wins only for a union receiver; an ordinary
	// user type may still declare a method with the same spelling.
	fmt.println(make_box().active_typeid());
}
