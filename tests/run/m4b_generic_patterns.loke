package main;

Table :: struct($Key, $Value: type) {
	key:   Key,
	value: Value,
}

// Only specializations of `Table`, binding its parameters.
lookup :: proc(t: ^Table($K, $V), key: K) -> V {
	return t^.value;
}

anything :: proc(t: ^$T) -> int { return 0; }
tables :: proc{lookup, anything};

swapped :: proc(pair: [2]$E) -> [2]E {
	return [2]E{pair[1], pair[0]};
}

main :: proc() {
	t: Table(int, i32) = {5, 7};
	print_int(int(lookup(&t, 5)));

	u: Table(i32, int) = {1, 9};
	print_int(lookup(&u, 1));

	s := swapped([2]int{4, 6});
	print_int(s[0]);
	print_int(s[1]);

	// Tie-breaker 4: `^Table($K, $V)` is more specialized than `^$T`.
	print_int(int(tables(&t, 5)));
	n := 3;
	print_int(tables(&n));
}
