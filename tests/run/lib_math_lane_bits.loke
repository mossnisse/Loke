// standard-library.md "Integer bit operations": the operations that read a bit
// pattern take a vector of integer lanes and answer lane by lane, in a vector
// of the same type, at run time, folded from constant operands, and in
// compile-time evaluation. A rotation's count is a vector too, which a scalar
// of the lane type splats to, and each lane's count is taken modulo the width.
package main;

import "core:fmt";
import "core:math";
import "core:simd";

ONES :: math.count_ones(Simd(u8, 4){0, 1, 3, 255});

spin :: proc(v: Simd(u32, 4), by: u32) -> Simd(u32, 4) { return math.rotate_left(v, by); }

folded :: proc() -> Simd(i16, 4) {
	v := Simd(i16, 4){0, 1, -1, 0x100};
	return math.leading_zeros(v) + math.trailing_zeros(v);
}
FOLDED :: folded();

main :: proc() {
	v: Simd(u8, 4) = {0, 1, 0b1011, 255};
	fmt.println(math.count_ones(v), math.leading_zeros(v), math.trailing_zeros(v), math.bit_width(v));
	fmt.println(math.reverse_bits(v));
	s := Simd(i32, 4){-1, 0, 1, 0x4000_0000};
	fmt.println(math.count_ones(s), math.leading_zeros(s), math.trailing_zeros(s), math.bit_width(s));
	w := Simd(u32, 4){1, 0x8000_0001, 0xF0, 0};
	fmt.println(spin(w, 1), math.rotate_right(w, Simd(u32, 4){1, 1, 4, 33}));
	fmt.println(math.rotate_left(s, -1), math.rotate_left(s, Simd(i32, 4){-1, 31, 32, 33}));
	fmt.println(ONES, FOLDED);
	wide: Simd(u64, 8) = 0xFF00;
	fmt.println(simd.reduce_add(math.count_ones(wide)), math.bit_width(wide)[7]);
	bytes: Simd(u8, 64) = 0x81;
	fmt.println(simd.reduce_add(math.count_ones(bytes)), math.rotate_left(bytes, 1)[63]);
}
