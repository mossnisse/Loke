package main; import "core:fmt"; import "core:io";

// `core:io` end to end (standard-library "Shared I/O contract").
//
// The protocol tests are driven by deliberately awkward in-memory streams: a
// reader that hands out at most two bytes at a time, and a writer that accepts
// at most three. A correct helper must loop.

Short_Reader :: struct {
	source: []u8,
	at:     int,
	most:   int,
}

impl Short_Reader {
	// Deliberately not `@(public)`: `io.read_to_end` reaches it through the
	// `Reader` slot, whatever this package exports.
	read :: proc(self: inout Short_Reader, destination: []mut u8) -> Result(int, io.Error) {
		if (destination.len() == 0) { return .ok(0); }
		if (self.at >= self.source.len()) {
			return .err(io.make_error(.End_Of_Input, .Read));
		}
		count := destination.len();
		if (count > self.most) { count = self.most; }
		if (count > self.source.len() - self.at) { count = self.source.len() - self.at; }
		foreach (index in 0 ..< count) {
			destination[index] = self.source[self.at + index];
		}
		self.at += count;
		return .ok(count);
	}
}

Short_Writer :: struct {
	collected: [dynamic]u8,
	most:      int,
}

impl Short_Writer {
	@(public)
	write :: proc(self: inout Short_Writer, source: []u8) -> Result(int, io.Error) {
		count := source.len();
		if (count > self.most) { count = self.most; }
		self.collected.append(..source[0:count]);
		return .ok(count);
	}
}

Broken_Writer :: struct { written: int }

impl Broken_Writer {
	@(public)
	write :: proc(self: inout Broken_Writer, source: []u8) -> Result(int, io.Error) {
		return .err(io.make_error(.Broken_Pipe, .Write, 109));
	}
}

// A `Result` carries progress or a failure, never both: this reader hands over
// its one byte, and the failure arrives on the call after. Helpers must not
// lose the byte on the way.
Error_After_Byte :: struct { done: bool }

impl Error_After_Byte {
	@(public)
	read :: proc(self: inout Error_After_Byte, destination: []mut u8) -> Result(int, io.Error) {
		if (self.done) { return .err(io.make_error(.Other, .Read)); }
		self.done = true;
		destination[0] = u8('x');
		return .ok(1);
	}
}

reader_over :: proc(text: string_view, most: int) -> Short_Reader {
	return Short_Reader{text.bytes(), 0, most};
}

// Every stream below is built from valid UTF-8 and every helper below is
// expected to reach its end, so a failure at either is a bug in the test.
text_of :: proc(bytes: []u8) -> string {
	switch (text in string.from_utf8(bytes)) {
	case .some: return text;
	case .none: panic("the test produced invalid UTF-8");
	}
}

no_line :: proc() -> string { panic("the reader ended early"); }

succeeded :: proc(outcome: Result(Unit, io.Error)) -> bool {
	switch (_ in outcome) {
	case .ok:  return true;
	case .err: return false;
	}
	return false;
}

// The failure a `Result(Unit, Error)` carries. Every use below expects one.
failed :: proc(outcome: Result(Unit, io.Error)) -> io.Error {
	switch (error in outcome) {
	case .ok:  panic("this operation was supposed to fail");
	case .err: return error;
	}
}

main :: proc() {
	static_assert(io.Reader(Short_Reader));
	static_assert(io.Writer(Short_Writer));
	static_assert(!io.Reader(Short_Writer));

	// write_all loops over partial writes.
	sink: Short_Writer = {};
	sink.most = 3;
	if (!succeeded(io.write_string(inout sink, "hello, värld"))) { fmt.println("write failed"); }
	fmt.println(sink.collected.len());
	fmt.println(text_of(sink.collected[:]));

	// read_exact fills the whole destination, and reports a short stream.
	source := reader_over("abcdef", 2);
	buffer: [6]u8 = {};
	fmt.println(succeeded(io.read_exact(inout source, buffer[:])));
	fmt.println(text_of(buffer[:]));

	short := reader_over("abc", 2);
	big: [6]u8 = {};
	fmt.println(int(io.code_of(failed(io.read_exact(inout short, big[:])))));

	// read_to_end, with and without a limit.
	whole := reader_over("one two three", 4);
	switch (bytes in io.read_to_end(inout whole)) {
	case .ok:
		fmt.println(true);
		fmt.println(bytes.len());
	case .err:
		fmt.println(false);
		fmt.println(0);
	}

	bounded := reader_over("0123456789", 3);
	switch (limited in io.read_to_end(inout bounded, limit = 5)) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(io.is(limited, .Limit_Exceeded));
	}

	// Exactly at the limit is not over it.
	edge := reader_over("01234", 3);
	switch (edge_bytes in io.read_to_end(inout edge, limit = 5)) {
	case .ok:
		fmt.println(true);
		fmt.println(edge_bytes.len());
	case .err:
		fmt.println(false);
		fmt.println(0);
	}

	// copy moves everything through a caller-sized window.
	from := reader_over("stream me", 2);
	into: Short_Writer = {};
	into.most = 4;
	window: [3]u8 = {};
	switch (moved in io.copy(inout into, inout from, window[:])) {
	case .ok:
		fmt.println(moved);
		fmt.println(true);
	case .err:
		fmt.println(0);
		fmt.println(false);
	}
	fmt.println(text_of(into.collected[:]));

	// read_line: both endings, an unterminated last line, and the end.
	lines := reader_over("first\r\nsecond\nthird", 5);
	fmt.println(io.read_line(inout lines) or_else no_line());
	fmt.println(io.read_line(inout lines) or_else no_line());
	fmt.println(io.read_line(inout lines) or_else no_line());
	switch (done in io.read_line(inout lines)) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(io.is(done, .End_Of_Input));
	}

	kept := reader_over("keep\n", 5);
	fmt.println((io.read_line(inout kept, options = io.Line_Options{true}) or_else no_line()).len());

	combined: Error_After_Byte = {};
	switch (combined_error in io.read_line(inout combined)) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(io.is(combined_error, .Other));
	}

	// The formatting bridge latches the first failure.
	formatted: Short_Writer = {};
	formatted.most = 2;
	fmt.println(succeeded(io.write_formatted_line(inout formatted, "count:", 42)));
	fmt.println(text_of(formatted.collected[:]));

	broken: Broken_Writer = {};
	failure := failed(io.write_formatted(inout broken, "anything"));
	fmt.println(io.is(failure, .Broken_Pipe));
	fmt.println(int(io.operation_of(failure)));
	fmt.println(io.native_code_of(failure));

	// An error formats through its own package's `format`.
	fmt.println(failure);
	fmt.println(io.make_error(.Not_Found, .Open));

	// And propagates with `or_return`.
	fmt.println(!succeeded(propagate()));
}

propagate :: proc() -> Result(Unit, io.Error) {
	broken: Broken_Writer = {};
	io.write_string(inout broken, "x") or_return;
	return .ok(Unit{});
}
