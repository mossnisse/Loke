package main; import "core:fmt";

Colour :: enum { Red, Green = 5, Blue }

Point :: struct { x: int, y: int }

Node :: struct { value: int, next: ^Node }

Alias :: u32;

Total :: 3 * 4 + 2;

ORIGIN :: Point{1, 2};

global_counter: int = 7;

add :: proc(a: int, b: int = 10) -> int {
	return a + b;
}

swap :: proc(p: inout Point) {
	t := p.x;
	p.x = p.y;
	p.y = t;
}

divmod :: proc(a: int, b: int) -> (q: int, r: int) {
	return {q = a / b, r = a % b};
}

fib :: proc(n: int) -> int {
	if (n < 2) { return n; }
	return fib(n - 1) + fib(n - 2);
}

main :: proc() {
	fmt.println(Total);
	fmt.println(global_counter);

	// scalar widths and wrapping, which for a signed type is spelled unsigned
	small: i8 = 127;
	small = i8(u8(small) + 1);
	fmt.println(int(small));

	u: u8 = 1;
	fmt.println(int(u << 20));

	neg: i32 = -1;
	fmt.println(int(neg >> 40));

	// floats
	f: f32 = 1.5;
	g := f * 2.0;
	fmt.println(int(g));

	// booleans and conditionals
	flag := true && !false;
	fmt.println(1 if flag else 0);

	// arrays
	xs: [4]int = {};
	xs[0] = 10;
	xs[3] = 40;
	fmt.println(xs[0] + xs[3]);

	ys := [4]int{1, 2, 3, 4};
	fmt.println(ys[2]);

	// structs
	p := Point{3, 4};
	q := Point{y = 4, x = 3};
	fmt.println(1 if p == q else 0);
	swap(inout p);
	fmt.println(p.x);

	// pointers
	r := &mut p;
	r.x = 99;
	fmt.println(p.x);

	n := Node{value = 5, next = nil};
	fmt.println(n.value);

	// enums
	c := Colour.Blue;
	switch (c) {
	case .Red:
		fmt.println(0);
	case .Green:
		fmt.println(5);
	case .Blue:
		fmt.println(6);
	}

	// loops, defer, break/continue
	sum := 0;
	for (i := 0; i < 5; i += 1) {
		if (i == 2) { continue; }
		if (i == 4) { break; }
		sum += i;
	}
	fmt.println(sum);

	// calls
	fmt.println(add(1));
	fmt.println(add(1, 2));
	fmt.println(add(b = 3, a = 4));
	fmt.println(fib(10));

	a, b := divmod(17, 5);
	fmt.println(a);
	fmt.println(b);

	// procedure values
	op: proc(a: int, b: int) -> int = add;
	fmt.println(op(2, 3));

	deferred();
}

deferred :: proc() {
	defer fmt.println(1);
	defer fmt.println(2);
	fmt.println(3);
}
