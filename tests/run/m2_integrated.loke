package main;

Colour :: enum { Red, Green = 5, Blue }

Point :: struct { x: int, y: int }

Node :: struct { value: int, next: ^Node }

Alias :: u32;

Total :: 3 * 4 + 2;

ORIGIN :: Point{1, 2};

global_counter: int = 7;

add :: proc(a: int, b: int = 10) -> int {
	return a + b;
}

swap :: proc(p: inout Point) {
	t := p.x;
	p.x = p.y;
	p.y = t;
}

divmod :: proc(a: int, b: int) -> (q: int, r: int) {
	q = a / b;
	r = a % b;
	return;
}

fib :: proc(n: int) -> int {
	if (n < 2) { return n; }
	return fib(n - 1) + fib(n - 2);
}

main :: proc() {
	print_int(Total);
	print_int(global_counter);

	// scalar widths and wrapping
	small: i8 = 127;
	small += 1;
	print_int(int(small));

	u: u8 = 1;
	print_int(int(u << 20));

	neg: i32 = -1;
	print_int(int(neg >> 40));

	// floats
	f: f32 = 1.5;
	g := f * 2.0;
	print_int(int(g));

	// booleans and conditionals
	flag := true && !false;
	print_int(1 if flag else 0);

	// arrays
	xs: [4]int;
	xs[0] = 10;
	xs[3] = 40;
	print_int(xs[0] + xs[3]);

	ys := [4]int{1, 2, 3, 4};
	print_int(ys[2]);

	// structs
	p := Point{3, 4};
	q := Point{y = 4, x = 3};
	print_int(1 if p == q else 0);
	swap(inout p);
	print_int(p.x);

	// pointers
	r := &p;
	r.x = 99;
	print_int(p.x);

	n := Node{value = 5, next = nil};
	print_int(n.value);

	// enums
	c := Colour.Blue;
	switch (c) {
	case .Red:
		print_int(0);
	case .Green:
		print_int(5);
	case .Blue:
		print_int(6);
	}

	// loops, defer, break/continue
	sum := 0;
	for (i := 0; i < 5; i += 1) {
		if (i == 2) { continue; }
		if (i == 4) { break; }
		sum += i;
	}
	print_int(sum);

	// calls
	print_int(add(1));
	print_int(add(1, 2));
	print_int(add(b = 3, a = 4));
	print_int(fib(10));

	a, b := divmod(17, 5);
	print_int(a);
	print_int(b);

	// procedure values
	op: proc(a: int, b: int) -> int = add;
	print_int(op(2, 3));

	deferred();
}

deferred :: proc() {
	defer print_int(1);
	defer print_int(2);
	print_int(3);
}
