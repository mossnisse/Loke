package main; import "core:mem"; import "core:fmt";

// `make` and the `via` allocator policy (m6b-plan step 1, decisions "Allocator
// binding" and "`via` applicability").
//
// design.md: `make` creates a container bound to the selected allocator, and
// m6b-plan is explicit that the result is bound "even when empty". The counts
// are ordinary runtime values, so a request that is representable but cannot be
// satisfied comes back as an error rather than a policy failure — `make` is one
// of the explicitly fallible primitives.
//
// No container *operation* is called here: each one is ungated in the step that
// also installs its invalidation.

Res :: struct { id: int }

impl Res {
	release :: hook(drop) proc(self: inout Res) { self.id = 0; }
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Res, Allocator_Error) {
		return .ok(Res{self.id});
	}
}

chosen :: proc() -> Allocator {
	return mem.default_allocator();
}

main :: proc() {
	// Four zero-valued elements inside a capacity of sixteen. The zero of a
	// managed element is the inert value every hook must already handle, so the
	// fill is not a construction and the drop of an untouched element is a no-op.
	switch (_ in make([dynamic]Res, 4, 16)) {
	case .ok: fmt.println(true);
	case .err: fmt.println(false);
	}

	// A map takes an optional reservation, and the allocator is recognised by its
	// type rather than by a written parameter name.
	switch (_ in make(map[int]Res, 32, mem.default_allocator())) {
	case .ok: fmt.println(true);
	case .err: fmt.println(false);
	}

	// Empty, and still bound: `make` with no counts allocates nothing.
	switch (_ in make([dynamic]string)) {
	case .ok: fmt.println(true);
	case .err: fmt.println(false);
	}

	// Representable, and far larger than any heap will give: the `Result` carries
	// the error alone.
	switch (_ in make([dynamic]i128, 0, 1152921504606846976)) {
	case .ok: fmt.println(false);
	case .err: fmt.println(true);
	}

	// A written policy on a local managed owner. The provider is selected when
	// the declaration is evaluated, and the declaration keeps it across drop and
	// revival even though the handle itself travels with the value.
	kept: [dynamic]Res via chosen();
	table: map[int]Res via mem.default_allocator();
	held: Res via chosen();
	fmt.println(held.id);
}
