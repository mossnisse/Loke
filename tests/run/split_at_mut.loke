package main;

import "core:fmt";

// design.md "Splitting a mutable slice": `split_at_mut` hands back two mutable
// halves of one `[]mut T`, both usable at once, at run time and during
// compilation alike.

// The halves are one reborrow of `xs`, so `xs` is read for `mid` first and
// both halves recurse while each is live.
merge_sort :: proc(xs: []mut int) {
	if (xs.len() <= 1) { return; }
	left, right := xs.split_at_mut(xs.len() / 2);
	merge_sort(left);
	merge_sort(right);
	merged := [dynamic]int{};
	i, j := 0, 0;
	for (; i < left.len() && j < right.len();) {
		if (left[i] <= right[j]) {
			merged.append(left[i]);
			i += 1;
		} else {
			merged.append(right[j]);
			j += 1;
		}
	}
	for (; i < left.len(); i += 1) { merged.append(left[i]); }
	for (; j < right.len(); j += 1) { merged.append(right[j]); }
	foreach (k in 0..<merged.len()) { xs[k] = merged[k]; }
}

// A half of a parameter's view may be returned, as `&mut xs[1:]` may.
tail :: proc(xs: []mut int) -> []mut int {
	_, right := xs.split_at_mut(1);
	return right;
}

// Writing through both halves of a compile-time array.
interleaved :: proc() -> [4]int {
	values := [4]int{1, 2, 3, 4};
	left, right := (&mut values[:]).split_at_mut(2);
	left[0], right[1] = right[1], left[0];
	left[1] += right[0];
	return values;
}

INTERLEAVED :: interleaved();

// The receiver is evaluated before the argument, so an argument that rebinds it
// does not change which slice is reborrowed.
replace :: proc(receiver: inout []mut int, @(escape=stored) replacement: []mut int) -> int {
	receiver = replacement;
	return 1;
}

rebound :: proc() -> [4]int {
	first := [2]int{1, 2};
	second := [2]int{3, 4};
	receiver := &mut first[:];
	halves := receiver.split_at_mut(replace(inout receiver, &mut second[:]));
	halves.left[0] = 9;
	return [4]int{first[0], first[1], second[0], second[1]};
}

REBOUND :: rebound();

main :: proc() {
	values := [dynamic]int{5, 3, 9, 1, 7, 2};
	{
		xs := &mut values[:];
		left, right := xs.split_at_mut(2);
		left[0] = 50;
		right[0] = 90;
		left[1] += right[1];
		fmt.println(left.len(), right.len());
	}
	fmt.println(values);

	// Either half may be empty, and the record's fields name them.
	xs := &mut values[:];
	whole := xs.split_at_mut(xs.len());
	fmt.println(whole.left.len(), whole.right.len());
	none := xs.split_at_mut(0);
	fmt.println(none.left.len(), none.right.len());

	merge_sort(xs);
	tail(xs)[0] = 0;
	fmt.println(values);

	names := [3]string{"Ada", "Bo", "Cy"};
	first, rest := (&mut names[:]).split_at_mut(1);
	first[0], rest[1] = rest[1], first[0];
	fmt.println(names);

	fmt.println(INTERLEAVED, INTERLEAVED == interleaved());
	fmt.println(rebound(), REBOUND == rebound());
}
