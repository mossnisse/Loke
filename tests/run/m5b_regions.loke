package main; import "core:mem"; import "core:fmt";

// m5b-plan step 3: what region provenance *permits*.

Buffer :: struct { id: int }

impl Buffer {
	release :: hook(drop) proc(self: inout Buffer) { self.id = 0; }
}

make_buffer :: proc(value: int, allocator: Allocator) -> Buffer {
	return Buffer{value};
}

// design.md: "A Loke procedure is verified: every `free_all` operation on a
// region that existed before procedure entry ... must be covered by one of the
// procedure's own `@(allocator_reset)` parameters."
release :: proc(@(allocator_reset) allocator: Allocator) {
	free_all(allocator);
}

// The promise propagates transitively through a direct wrapper.
release_twice :: proc(@(allocator_reset) allocator: Allocator) {
	release(allocator);
	release(allocator);
}

// design.md: the proof is "that no dependant survives the reset, not that every
// allocation was already freed", so an unfreed allocation whose last carrier use
// is behind us is simply released by the reset.
reset_after_last_use :: proc(@(allocator_reset) allocator: Allocator) -> int {
	pointer := new(int, allocator) or_else nil;
	if (pointer == nil) { return 0; }
	pointer^ = 7;
	total := pointer^;
	// No alias survives, so the reset is accepted even though nothing was freed.
	free_all(allocator);
	return total;
}

// design.md `@(allocator_reset)`: a reset is rejected while an owning value or
// borrow "from that region" is live. A second arena's allocations, and the
// default provider's, are none of its business -- the same answer an owner of
// another region already gets.
allocations_of_another_region :: proc() -> int {
	a := mem.Arena.init();
	b := mem.Arena.init();
	mine := new(int, b.allocator()) or_else nil;
	heap := new(int) or_else nil;
	if (mine == nil || heap == nil) { return 0; }
	mine^ = 10;
	heap^ = 20;
	free_all(a.allocator());
	total := mine^ + heap^;
	free(heap);
	return total;
}

allocate_in :: proc(allocator: Allocator) -> ^mut int {
	return new(int, allocator) or_else nil;
}

allocate_in_default :: proc() -> ^mut int {
	return new(int) or_else nil;
}

// Fresh allocation roots carry their regions through a direct result summary,
// so an unrelated local reset remains valid after either helper call.
returned_allocations_of_another_region :: proc() -> int {
	a := mem.Arena.init();
	b := mem.Arena.init();
	mine := allocate_in(b.allocator());
	heap := allocate_in_default();
	if (mine == nil || heap == nil) { return 0; }
	mine^ = 30;
	heap^ = 40;
	free_all(a.allocator());
	total := mine^ + heap^;
	free(mine, b.allocator());
	free(heap);
	return total;
}

// An owner whose scope has ended no longer blocks a reset.
reset_after_an_owner_ends :: proc(@(allocator_reset) allocator: Allocator) -> int {
	total := 0;
	{
		held := make_buffer(3, allocator);
		total = held.id;
	}
	free_all(allocator);
	return total;
}

// The default provider's region outlives the program, so an owner backed by it
// may be kept in file-scope storage.
global_buffer: Buffer;

// Storing a view in a global used to be the programmer's responsibility. It is
// checked now: the parameter says how long its storage must live, and the
// caller is held to it.
global_view: []int;
KEPT_NUMBERS :: [3]int{4, 5, 6};

store_a_view :: proc(@(escape=static) values: []int) {
	global_view = values;
}

main :: proc() {
	// The default allocator is a pre-existing region, so `main` cannot hide a
	// reset of it merely to exercise its unsupported provider entry.
	global_buffer = make_buffer(1, mem.default_allocator());
	fmt.println(global_buffer.id);

	// The contract is on the parameter, so the caller has to pass storage that
	// really outlives the process.
	store_a_view(KEPT_NUMBERS[:]);
	fmt.println(KEPT_NUMBERS[0]);

	fmt.println(allocations_of_another_region());
	fmt.println(returned_allocations_of_another_region());

}

// Region facts are path-specific: moving a local-arena owner into one field must
// not contaminate the default-backed sibling returned to the caller.
Split_Regions :: struct {
	local:  [dynamic]int,
	stable: [dynamic]int,
}

move_default_region_sibling :: proc() -> [dynamic]int {
	arena := mem.Arena.init();
	local: [dynamic]int via arena.allocator() = {};
	local.append(1);
	stable: [dynamic]int via mem.default_allocator() = {};
	stable.append(2);
	held: Split_Regions = {};
	held.local = move(local);
	held.stable = move(stable);
	return held.stable;
}
