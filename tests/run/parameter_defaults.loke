package main;
import "core:fmt";
import "core:mem";

// design.md "Default values": `name := default` takes the default's type, which
// may read the parameters to its left, and an `Option(^T)` parameter may have a
// default.
Monitor :: struct { id: int }

window :: proc(title: string, x := 0, width := x + 854, scale := 1.5, monitor: Option(^Monitor) = .none) {
	fmt.println(title, x, width, scale, monitor == .none);
}

sized :: proc(n: int, allocator := mem.default_allocator()) -> int { return n; }

// A call inside a default still sees the parameters to the default's left.
identity :: proc(x: int) -> int { return x; }
choose :: proc(a: int, b: int = identity(a)) -> int { return b; }

// A written argument reads its own scope, even when the call binds a parameter
// of the same procedure first.
countdown :: proc(a: int, b: int = 0) -> int {
	if (a > 3) { return b; }
	return countdown(a + 1, a);
}

Counter :: struct { v: int }
impl Counter {
	make :: proc(v := 7) -> Counter { return {v}; }
	add :: proc(self, by := 1) -> int { return self.v + by; }
}

main :: proc() {
	screen := Monitor{1};
	window("a");
	window("b", 10, monitor = .some(&screen));
	fmt.println(sized(3));
	c := Counter.make();
	fmt.println(c.v, c.add(), c.add(by = 5));
	fmt.println(choose(7), countdown(1));
}
