// design.md "Typed fallibility": `Status(E)` is `Result(Unit, E)`, through a
// parametric alias. Its body may end without `return .ok;` ("One result"),
// even when `E` is generic; `or_return` crosses between it and `Result(T, E)`;
// `or_else` yields `Unit` for it; `map_error` converts one that is kept; and a
// procedure generic over `Result($T, $E)` takes one.
package main;
import "core:fmt";

Disk :: enum { Full, Gone }
App_Error :: union { disk: Disk, other: int }

write :: proc(fail: bool) -> Status(Disk) {
	if (fail) {
		return .err(.Full);
	}
	fmt.println("written");
}

count :: proc(fail: bool) -> Result(int, Disk) {
	write(fail) or_return;
	return .ok(3);
}

store :: proc(fail: bool) -> Status(App_Error) {
	n := count(fail) or_return .disk;
	fmt.println("stored", n);
}

Tri :: union @(failure=broken) { fine, broken: int }

user :: proc(fail: bool) -> Tri {
	if (fail) { return .broken(7); }
}

folded :: proc() -> Status(int) {
	x := 1;
	x += 1;
}
FOLDED :: folded();

static_assert(Status(Disk) == Result(Unit, Disk));

succeeded :: proc(r: Result($T, $E)) -> bool {
	switch (r) {
	case .ok:  return true;
	case .err: return false;
	}
}

quiet :: proc(error: $E) -> Status(E) {
	_ = error;
}

main :: proc() {
	fmt.println(store(false));
	fmt.println(store(true));
	fmt.println(user(false), user(true));
	unit := write(false) or_else panic("not reached");
	fmt.println(unit);
	fmt.println(write(true) or_else Unit{});
	kept := write(true).map_error(App_Error.disk);
	fmt.println(kept);
	fmt.println(FOLDED);
	fmt.println(succeeded(write(false)), succeeded(write(true)), quiet(Disk.Gone));
	fmt.println(typeid_of(Status(Disk)));
}
