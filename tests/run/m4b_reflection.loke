package main;

Point :: struct {
	x: int,
	y: i32 `json:"why"`,
	on: bool,
}

Empty :: struct { }

Colour :: enum { Red, Green = 5, Blue }

visit :: proc(value: ^$T) {
	foreach ($field in fields_of(T)) {
		// A different static field type in each copy.
		when (type_of(field.get(value)) == int) {
			print_int(field.get(value));
		} else when (type_of(field.get(value)) == i32) {
			print_int(int(field.get(value)));
		} else {
			print_int(999);
		}
	}
}

nothing :: proc(value: ^$T) {
	foreach ($field in fields_of(T)) {
		print_int(1);
	}
}

first_colour :: proc() -> int {
	// A non-empty static expansion whose copies all return terminates the
	// surrounding procedure for missing-return analysis.
	foreach ($member in enum_values_of(Colour)) {
		return int(member.value);
	}
}

main :: proc() {
	p: Point = {7, 8, true};
	visit(&p);

	e: Empty = {};
	nothing(&e);

	// Two indices and a descriptor name.
	foreach ($member, $index in enum_values_of(Colour)) {
		print_int(index);
		print_int(int(member.value));
	}

	// `type_of` and `typeid_of` fold.
	i := 3;
	#assert(type_of(i) == int);
	#assert(typeid_of(int) == typeid_of(type_of(i)));
	#assert(typeid_of(int) != typeid_of(bool));

	// A descriptor name has type `string_view`.
	foreach ($field in fields_of(Point)) {
		#assert(type_of(field.name) == string_view);
	}

	// `field.pointer` writes through the selected field.
	foreach ($field in fields_of(Point)) {
		when (type_of(field.get(&p)) == int) {
			slot := field.pointer(&p);
			slot^ = 42;
		}
	}
	print_int(p.x);

	id := typeid_of(Point);
	other := typeid_of(Colour);
	if (id == other) { print_int(0); } else { print_int(1); }
	print_int(first_colour());
}
