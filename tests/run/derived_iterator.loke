package main;
// design.md "Iteration protocol": `Iterator` and `Mut_Iterator` are what `iter`
// and `iter_mut` return, so neither type declares them.
import "core:fmt";
import "base:interfaces";
Countdown :: struct { start: int }
Countdown_Iterator :: struct { current: int }
impl Countdown {
	Element :: int;
	iter :: proc(self) -> Countdown_Iterator { return {self.start}; }
}
impl Countdown_Iterator {
	next :: proc(self: inout Countdown_Iterator) -> Option(int) {
		if (self.current <= 0) { return .none; }
		value := self.current;
		self.current -= 1;
		return .some(value);
	}
}
Row :: struct { cells: []mut int }
Row_Cursor :: struct { cells: []mut int, at: int }
impl Row {
	Element :: int;
	iter :: proc(self) -> Row_Cursor { return {self.cells, 0}; }
	iter_mut_default :: proc(self) -> Row_Cursor { return {self.cells, 0}; }
	iter_mut_from :: proc(self, at: int) -> Row_Cursor { return {self.cells, at}; }
	iter_mut :: proc{iter_mut_default, iter_mut_from};
}
impl Row_Cursor {
	next :: proc(self: inout Row_Cursor) -> Option(^mut int) {
		if (self.at >= self.cells.len()) { return .none; }
		value := &mut self.cells[self.at];
		self.at += 1;
		return .some(value);
	}
}
Grouped :: struct { start: int }
impl Grouped {
	Element :: int;
	iter_default :: proc(self) -> Countdown_Iterator { return {self.start}; }
	iter_from :: proc(self, start: int) -> Countdown_Iterator { return {start}; }
	iter :: proc{iter_default, iter_from};
}
total :: proc(xs: $S) -> int where interfaces.Iterable(S), S.Element == int { t := 0; foreach (x in xs) { t += x; } return t; }
main :: proc() {
	foreach (v in Countdown{3}) { fmt.println(v); }
	fmt.println(total(Countdown{4}));
	fmt.println(total(Grouped{4}));
	storage := [2]int{1, 2};
	foreach (&c in Row{storage[:]}) { c += 5; }
	fmt.println(storage);
}
