package main;

import "core:fmt";

// design.md "Evaluation order": a destination stored inline in an earlier
// one keeps its place when that one is written, and a map's insertion goes
// into the map the statement left, so neither is in storage the earlier write
// replaces. A place an `inout` result names is written before an earlier
// destination's storage is dropped.
Pair :: struct { items: [dynamic]int, n: int }
Point :: struct { x: int, y: [2]int }

pick :: proc(x: inout int) -> inout int { return inout x; }

// design.md "Compile-time procedure evaluation" keeps the same places.
inline_places :: proc() -> [3]int {
	a := [2][2]int{};
	a, a[1][0] = [2][2]int{{1, 2}, {3, 4}}, 9;
	p := Point{};
	p, p.x, p.y[1] = Point{1, {2, 3}}, 5, 6;
	return {a[1][0], p.x, p.y[1]};
}

INLINE_PLACES :: inline_places();

main :: proc() {
	a := [2]int{1, 2};
	i := 1;
	a, a[i] = [2]int{4, 4}, 9;
	rows := [dynamic][dynamic]int{[dynamic]int{1}, [dynamic]int{2, 3}};
	rows[0], rows[1][1] = [dynamic]int{7}, 8;
	p := Pair{[dynamic]int{1, 2}, 0};
	p.n, p.items[0] = 5, 6;
	m := map[string]int{"a" = 1};
	m, m["b"] = map[string]int{"c" = 3}, 2;
	d := [dynamic]int{1, 2};
	d[1], d = 9, [dynamic]int{5, 6};
	fmt.println(a, rows, p.items, p.n, m["b"], m["c"], m.len(), d);
	q := &mut p;
	q^, q.n = Pair{[dynamic]int{3}, 1}, 8;
	pick(inout d[0]), d = 8, [dynamic]int{4, 5};
	m["d"], m["e"] = 4, 5;
	fmt.println(p.items, p.n, d, m["d"], m["e"], m.len());
	fmt.println(INLINE_PLACES, inline_places());
}
