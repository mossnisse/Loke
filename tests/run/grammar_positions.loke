// Spellings grammar.md allows that the parser used to reject: a field named
// `type`, a keyed literal naming that field, a storage modifier
// before a record type, and a type-only type in a comparison once
// parenthesised, a trailing comma after a plain receiver, and a call of a
// procedure literal inside parentheses. A reserved word names a field, and
// `static` applies directly to an unlabeled record.
package main;

import "core:fmt";

A :: struct { x: int }
B :: struct { type: A }

Storage :: struct { static: int, thread_local: int }

count :: proc() -> int {
	n: static (calls: int, last: int);
	n.calls += 1;
	return n.calls;
}

pairs :: proc() -> int {
	p: static (int, int);
	a, b := p;
	p = {a + 1, b + 2};
	return a + b;
}

impl A { plus :: proc(self,) -> int { return self.x + 1; } }

pointer_only :: proc(x: $T) -> bool where T == (^int) { return true; }

main :: proc() {
	b := B{};
	b.type.x = 7;
	fmt.println(b.type.x);
	k := B{type = {x = 8}};
	fmt.println(k.type.x);

	_ = count();
	fmt.println(count());

	s := Storage{static = 3, thread_local = 4};
	fmt.println(s.static + s.thread_local);
	_ = pairs();
	fmt.println(pairs());

	y := 1;
	fmt.println(pointer_only(&y));
	static_assert(type_of(&y) == (^int));

	fmt.println(A{4}.plus());
	fmt.println((proc() -> int { return 9; }()));
}
