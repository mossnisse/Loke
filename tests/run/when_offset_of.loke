package main;

import "core:fmt";

// design.md "Conditional compilation": `offset_of(T, field)` names a field of
// `T`, not a binding, so a file-scope `when` does not wait for a declaration
// spelled like it. Here the field `VALUE` shares its name with the constant the
// `when` declares.
S :: struct { VALUE: int, y: int }

when (offset_of(S, y) == 8 && offset_of(S, VALUE) == 0) {
	VALUE :: 1;
} else {
	VALUE :: 2;
}

main :: proc() {
	fmt.println(VALUE);
}
