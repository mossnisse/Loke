package main; import "core:fmt";

// design.md "Variadic parameters": a variadic procedure accepts a variable
// number of arguments, and `..slice` passes a slice as varargs. The callee
// always receives one read-only slice, so `foreach` over it is ordinary slice
// iteration (m6a-plan decision "Ordinary variadics").

sum :: proc(nums: ..int) -> int {
	total := 0;
	foreach (n in nums) { total = total + n; }
	return total;
}

// A sole compatible spread forwards its slice directly rather than rebuilding
// one, which is what makes forwarding cost nothing.
forwarded :: proc(nums: ..int) -> int { return sum(..nums); }

// Fixed parameters come first; the variadic one is always last.
offset :: proc(base: int, nums: ..int) -> int { return base + sum(..nums); }

// A default before the pack is still filled when the call omits it.
defaulted :: proc(base: int = 100, nums: ..int) -> int { return base + sum(..nums); }

// Overload ranking places trailing arguments in the pack, and design.md's
// tie-breaker still prefers a fixed-arity candidate over a variadic one.
exact :: proc(a: int, b: int) -> int { return 1000; }
packed :: proc(nums: ..int) -> int { return sum(..nums); }
one_of :: proc{exact, packed};

Res :: struct { id: int }

impl Res {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Res, Allocator_Error) {
		return .ok(Res{self.id + 100});
	}
	release :: hook(drop) proc(self: inout Res) { fmt.println(self.id); }
}

consume :: proc(values: ..Res) {
	fmt.println(values[0].id + values[1].id);
}

// A `move` parameter ahead of a pack. The transfer is written at the call
// site exactly as it is without one, and the callee owns the only copy: the
// value is destroyed once, inside `hand_over`, and not again in `main`.
hand_over :: proc(value: move Res, counts: ..int) {
	fmt.println(value.id + len(counts));
}

// design.md "Named arguments": a name reaches a fixed parameter — there is no
// way to name a pack element, so a name means the pack is empty. The written
// order is still the evaluation order.
labelled :: proc(a: int, b: int, nums: ..int) -> int {
	return a * 100 + b * 10 + len(nums);
}
loud :: proc(n: int) -> int { fmt.println(n); return n; }
// The same name through a group and through method syntax, where the receiver
// occupies slot 0 and is not one of the written arguments.
labelled_f :: proc(a: f64, nums: ..f64) -> int { return int(a) * 1000 + len(nums); }
either :: proc { labelled, labelled_f };
impl Res {
	tally :: proc(self, a: int, nums: ..int) -> int { return self.id + a * 10 + len(nums); }
}

main :: proc() {
	fmt.println(sum());
	fmt.println(sum(1, 2));
	fmt.println(sum(1, 2, 3, 4, 5));

	odds := []int{1, 3, 5};
	fmt.println(sum(..odds));
	fmt.println(sum(10, ..odds, 20));
	fmt.println(sum(..odds, ..odds));

	fmt.println(forwarded(7, 8));
	fmt.println(offset(100, 1, 2));
	fmt.println(defaulted());

	// Variadic shape is part of the procedure type, so an indirect call works.
	f: proc(nums: ..int) -> int = sum;
	fmt.println(f(4, 5));

	fmt.println(one_of(1, 2));
	fmt.println(one_of(1, 2, 3));
	fmt.println(one_of(..odds));
	fmt.println(one_of());

	// A borrowed managed argument is cloned, a temporary is moved, and both pack
	// elements are destroyed in reverse order immediately after the call.
	resource := Res{1};
	consume(resource, Res{2});
	pair := [?]Res{Res{3}, Res{4}};
	consume(Res{5}, ..pair[:]);

	handed := Res{6};
	hand_over(move(handed), 1, 2);
	fmt.println(99);

	fmt.println(labelled(1, 2, 3, 4));
	fmt.println(labelled(1, b = 2));
	fmt.println(labelled(b = 2, a = 1));
	fmt.println(labelled(b = loud(7), a = loud(8)));
	fmt.println(either(a = 1, b = 2));
	fmt.println(either(a = 2.0));
	counter := Res{20};
	fmt.println(counter.tally(a = 3));
	drop(counter);
}
