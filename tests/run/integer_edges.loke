package main; import "core:fmt";

// `MIN / -1` wraps for a *typed* operand: design.md fixes that rule per width.
// Untyped folding stays exact, so these constants are written with their type.
MINIMUM : int : -9223372036854775807 - 1;
WRAPPED_QUOTIENT : int : MINIMUM / -1;
WRAPPED_REMAINDER : int : MINIMUM % -1;

main :: proc() {
	left := 15;
	right := 3;
	fmt.println(left &~ right);

	dividend := 20;
	divisor := 3;
	fmt.println(dividend / divisor);
	fmt.println(dividend % divisor);

	minimum := -9223372036854775807 - 1;
	negative_one := -1;
	fmt.println(minimum / negative_one);
	fmt.println(minimum % negative_one);
	fmt.println(WRAPPED_QUOTIENT);
	fmt.println(WRAPPED_REMAINDER);

	one := 1;
	negative := -8;
	fmt.println(one << 64);
	fmt.println(negative >> 64);
}
