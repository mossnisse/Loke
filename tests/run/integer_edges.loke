package main; import "core:fmt";

// `MIN % -1` is 0 for a *typed* operand, where `MIN / -1` does not fit and is
// an error (tests/err/signed_overflow) or a panic (tests/trap/signed_overflow).
// Untyped folding stays exact, so the constant is written with its type.
MINIMUM : int : -9223372036854775807 - 1;
MINIMUM_REMAINDER : int : MINIMUM % -1;

main :: proc() {
	left := 15;
	right := 3;
	fmt.println(left &~ right);

	dividend := 20;
	divisor := 3;
	fmt.println(dividend / divisor);
	fmt.println(dividend % divisor);

	minimum := -9223372036854775807 - 1;
	negative_one := -1;
	fmt.println(minimum % negative_one);
	fmt.println(MINIMUM_REMAINDER);

	one := 1;
	negative := -8;
	fmt.println(one << 64);
	fmt.println(negative >> 64);
}
