package main;

import "core:cstrings";
import "core:encoding/utf16";
import "core:fmt";
import "core:mem";

// `core:cstrings` and `core:encoding/utf16` (standard-library-plan stage 1
// item 5, and the encoding stage 2 needed early).

foreign import libc "system:legacy_stdio_definitions.lib";

foreign libc {
	strlen :: proc "c" (s: cstring_view) -> uint ---;
}

// These two are constructed from valid input; a failure is a bug in the test.
no_text :: proc() -> string { panic("the test produced invalid UTF-8"); }
no_units :: proc() -> [dynamic]u16 { panic("encoding failed"); }

main :: proc() {
	// An owned zero-terminated buffer, handed to a C routine that measures it.
	switch (owned in cstrings.from_string("hej, värld")) {
	case .ok:
		fmt.println(true);
		fmt.println(owned.len());
		fmt.println(strlen(owned.view()));
	case .err:
		fmt.println(false);
		fmt.println(-1);
		fmt.println(-1);
	}

	// The empty case still produces a usable, terminated view.
	switch (empty in cstrings.from_string("")) {
	case .ok:
		fmt.println(true);
		fmt.println(empty.len());
		fmt.println(strlen(empty.view()));
	case .err:
		fmt.println(false);
		fmt.println(-1);
		fmt.println(-1);
	}

	// A Loke string may contain U+0000; a retained C string may not.
	with_zero := [?]u8{u8('a'), 0, u8('b')};
	text := string.from_utf8(with_zero[:]) or_else no_text();
	fmt.println(true);
	fmt.println(text.len());
	switch (rejected in cstrings.from_string(text)) {
	case .ok:
		fmt.println(false);
		fmt.println(false);
		fmt.println(-1);
	case .err:
		fmt.println(true);
		// The error is the enum itself now, not an erased value to extract.
		fmt.println(true);
		fmt.println(int(rejected));
	}

	// The zero value of `C_String` is an empty, terminated buffer too.
	inert: cstrings.C_String = {};
	fmt.println(inert.len());

	// A caller's allocator reaches the buffer, so exhausting it is reported as
	// `Out_Of_Memory` rather than ending the process.
	room: [160]u8 = {};
	cramped := mem.Arena.from_buffer(room[:]);
	long := "0123456789" + "0123456789" + "0123456789" + "0123456789" +
		"0123456789" + "0123456789" + "0123456789" + "0123456789" +
		"0123456789" + "0123456789" + "0123456789" + "0123456789";
	switch (starved in cstrings.from_string(long, cramped.allocator())) {
	case .ok:  fmt.println(false); fmt.println(starved.len());
	case .err: fmt.println(true); fmt.println(int(starved));
	}
	switch (starved in utf16.encode(long, cramped.allocator())) {
	case .ok:  fmt.println(false); fmt.println(starved.len());
	case .err: fmt.println(true); fmt.println(int(starved));
	}

	// UTF-16, both directions, including a surrogate pair.
	units := utf16.encode("Hej å 😀") or_else no_units();
	fmt.println(true);
	fmt.println(units.len());
	fmt.println(utf16.length_of(units[:]));
	switch (back in utf16.decode(units[0:utf16.length_of(units[:])])) {
	case .ok:
		fmt.println(true);
		fmt.println(back);
		fmt.println(back.len());
	case .err:
		fmt.println(false);
		fmt.println("");
		fmt.println(-1);
	}

	// An unpaired surrogate is invalid data, not a replacement character.
	lone := [?]u16{0xD800, 65};
	switch (_ in utf16.decode(lone[:])) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(true);
	}
	trailing := [?]u16{0xDC00};
	switch (_ in utf16.decode(trailing[:])) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(true);
	}

	// An explicit allocator reaches the decoded string.
	arena := mem.Arena.init();
	switch (scoped in utf16.decode(units[0:3], arena.allocator())) {
	case .ok:
		fmt.println(true);
		fmt.println(scoped);
	case .err:
		fmt.println(false);
		fmt.println("");
	}
}
