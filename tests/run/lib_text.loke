package main;

import "core:cstrings";
import "core:encoding/utf16";
import "core:fmt";
import "core:mem";

// `core:cstrings` and `core:encoding/utf16` (standard-library
// "`core:cstrings`" and "Package layout").

foreign import libc "system:legacy_stdio_definitions.lib";

foreign libc {
	strlen :: proc "c" (s: cstring_view) -> uint ---;
}

main :: proc() {
	// An owned zero-terminated buffer, handed to a C routine that measures it.
	switch (cstrings.from_string("hej, värld")) {
	case .ok(owned):
		fmt.println(true);
		fmt.println(owned.len());
		fmt.println(strlen(owned.view()));
		// A clone owns its own buffer, terminator included.
		copied := owned.clone();
		fmt.println(strlen(copied.view()));
	case .err:
		fmt.println(false);
		fmt.println(-1);
		fmt.println(-1);
		fmt.println(-1);
	}

	// The empty case still produces a usable, terminated view.
	switch (cstrings.from_string("")) {
	case .ok(empty):
		fmt.println(true);
		fmt.println(empty.len());
		fmt.println(strlen(empty.view()));
	case .err:
		fmt.println(false);
		fmt.println(-1);
		fmt.println(-1);
	}

	// A Loke string may contain U+0000; a retained C string may not.
	with_zero := [?]u8{u8('a'), 0, u8('b')};
	text := string.from_utf8(with_zero[:]) or_else panic("the test produced invalid UTF-8");
	fmt.println(true);
	fmt.println(text.len());
	switch (cstrings.from_string(text)) {
	case .ok:
		fmt.println(false);
		fmt.println(false);
		fmt.println(-1);
	case .err(rejected):
		fmt.println(true);
		// The error is the enum itself now, not an erased value to extract.
		fmt.println(true);
		fmt.println(int(rejected));
	}
	// Nor may zero-terminated UTF-16.
	switch (utf16.encode(text)) {
	case .ok:  fmt.println(false);
	case .err(rejected): fmt.println(rejected == .Contains_Zero);
	}

	// The zero value of `C_String` is an empty, terminated buffer too.
	inert: cstrings.C_String = {};
	fmt.println(inert.len());
	fmt.println(strlen(inert.view()));

	// A caller's allocator reaches the buffer, so exhausting it is reported as
	// `Out_Of_Memory` rather than ending the process.
	room: [160]u8 = {};
	cramped := mem.Arena.from_buffer(&mut room[:]);
	long := "0123456789" + "0123456789" + "0123456789" + "0123456789" +
		"0123456789" + "0123456789" + "0123456789" + "0123456789" +
		"0123456789" + "0123456789" + "0123456789" + "0123456789";
	switch (cstrings.from_string(long, cramped.allocator())) {
	case .ok(starved):  fmt.println(false); fmt.println(starved.len());
	case .err(starved): fmt.println(true); fmt.println(int(starved));
	}
	switch (utf16.encode(long, cramped.allocator())) {
	case .ok(starved):  fmt.println(false); fmt.println(starved.len());
	case .err(starved): fmt.println(true); fmt.println(int(starved));
	}

	// UTF-16, both directions, including a surrogate pair.
	units := utf16.encode("Hej å 😀") or_else panic("encoding failed");
	fmt.println(true);
	fmt.println(units.len());
	fmt.println(utf16.length_of(units[:]));
	switch (utf16.decode(units[0:utf16.length_of(units[:])])) {
	case .ok(back):
		fmt.println(true);
		fmt.println(back);
		fmt.println(back.len());
	case .err:
		fmt.println(false);
		fmt.println("");
		fmt.println(-1);
	}

	// An unpaired surrogate is invalid data, not a replacement character.
	lone := [?]u16{0xD800, 65};
	switch (utf16.decode(lone[:])) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(true);
	}
	trailing := [?]u16{0xDC00};
	switch (utf16.decode(trailing[:])) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(true);
	}

	// An explicit allocator reaches the decoded string.
	arena := mem.Arena.init();
	switch (utf16.decode(units[0:3], arena.allocator())) {
	case .ok(scoped):
		fmt.println(true);
		fmt.println(scoped);
	case .err:
		fmt.println(false);
		fmt.println("");
	}

	// design.md "C string views": `to_c_view()` borrows the string, so it may be
	// kept while the string lives, and the empty string's view is still readable.
	built := "ab" + "c";
	kept := built.to_c_view();
	fmt.println(strlen(kept));
	nothing := built[0:0].copy();
	fmt.println(strlen(nothing.to_c_view()));
}
