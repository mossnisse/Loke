package main;

import "core:cstrings";
import "core:encoding/utf16";
import "core:fmt";
import "core:mem";

// `core:cstrings` and `core:encoding/utf16` (standard-library-plan stage 1
// item 5, and the encoding stage 2 needed early).

foreign import libc "system:legacy_stdio_definitions.lib";

foreign libc {
	strlen :: proc "c" (s: cstring_view) -> uint ---;
}

main :: proc() {
	// An owned zero-terminated buffer, handed to a C routine that measures it.
	owned, error := cstrings.from_string("hej, värld");
	fmt.println(error == nil);
	fmt.println(owned.len());
	fmt.println(strlen(owned.view()));

	// The empty case still produces a usable, terminated view.
	empty, empty_error := cstrings.from_string("");
	fmt.println(empty_error == nil);
	fmt.println(empty.len());
	fmt.println(strlen(empty.view()));

	// A Loke string may contain U+0000; a retained C string may not.
	with_zero := [?]u8{u8('a'), 0, u8('b')};
	text, valid := string(with_zero[:]);
	fmt.println(valid);
	fmt.println(len(text));
	_, rejected := cstrings.from_string(text);
	fmt.println(rejected != nil);
	fault, present := rejected.as(cstrings.Fault);
	fmt.println(present);
	fmt.println(int(fault));

	// The zero value of `C_String` is an empty, terminated buffer too.
	inert: cstrings.C_String = {};
	fmt.println(inert.len());

	// UTF-16, both directions, including a surrogate pair.
	units, encode_error := utf16.encode("Hej å 😀");
	fmt.println(encode_error == nil);
	fmt.println(len(units));
	fmt.println(utf16.length_of(units[:]));
	back, decode_error := utf16.decode(units[0:utf16.length_of(units[:])]);
	fmt.println(decode_error == nil);
	fmt.println(back);
	fmt.println(len(back));

	// An unpaired surrogate is invalid data, not a replacement character.
	lone := [?]u16{0xD800, 65};
	_, unpaired := utf16.decode(lone[:]);
	fmt.println(unpaired != nil);
	trailing := [?]u16{0xDC00};
	_, low_first := utf16.decode(trailing[:]);
	fmt.println(low_first != nil);

	// An explicit allocator reaches the decoded string.
	arena := mem.Arena.init();
	scoped, scoped_error := utf16.decode(units[0:3], arena.allocator());
	fmt.println(scoped_error == nil);
	fmt.println(scoped);
}
