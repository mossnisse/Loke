// design.md "@(fieldwise_copy)": each copy owns its fields, and each runs the drop
// hook once. A `move_only` record states the other decision.
package main;

import "core:fmt";

// Wipes its key, and every field owns its data, so a field-wise copy is right.
@(fieldwise_copy) Key :: struct { id: int, bytes: [dynamic]u8 }
impl Key {
	wipe :: hook(drop) proc(self: inout Key) {
		fmt.println("wipe", self.id, self.bytes.len());
	}
}

@(fieldwise_copy) Cell :: struct($T: type) { value: T }
impl Cell($T) {
	release :: hook(drop) proc(self: inout) { fmt.println("release", self.value); }
}

@(move_only) Handle :: struct { fd: int }
impl Handle {
	close :: hook(drop) proc(self: inout Handle) { fmt.println("close", self.fd); }
}

consume :: proc(handle: move Handle) { fmt.println("consume", handle.fd); }

main :: proc() {
	a := Key{1, [dynamic]u8{1, 2}};
	b := a.clone();
	b.id = 2;
	b.bytes.append(3);
	fmt.println(a.id, a.bytes.len(), b.id, b.bytes.len());

	c := Cell(int){7};
	d := c.clone();
	fmt.println(c.value, d.value);

	consume(Handle{3});

	@(fieldwise_copy) Local :: struct { id: int }
	impl Local {
		release :: hook(drop) proc(self: inout Local) { fmt.println("local", self.id); }
	}
	e := Local{4};
	f := e;
	f.id = 5;
	fmt.println(e.id, f.id);
}
