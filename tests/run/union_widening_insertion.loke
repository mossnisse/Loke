// design.md "Widening by label" and "Container insertion": a borrowed smaller
// union inserted into a container whose wider element is move-only is copied at
// its own type, and the copy is handed over, so the source and the element each
// drop once. A `try_` form whose copy is refused returns the failure, leaves the
// container unchanged, and leaves the source as it was. A variadic pack copies
// a widened place the same way; an `append` pack copies through the container's
// allocator, and a refused `try_append` copy drops the rest of the pack. A copy
// adds 100 to the id.
package main;
import "core:fmt";
import "core:mem";

// A `[dynamic]T` reserves room for at least eight, so this asks for 2^62 bytes.
Huge :: struct { pad: [576460752303423488]u8 }

Res :: struct { id: int }
impl Res {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Res, Allocator_Error) {
		if (self.id == 3) {
			_ = try_make([dynamic]Huge, 0, 1, allocator) or_return;
		}
		return .ok(Res{self.id + 100});
	}
	release :: hook(drop) proc(self: inout Res) {
		if (self.id != 0) { fmt.println("drop", self.id); }
	}
}
Token :: move_only struct { id: int }
Small :: (res: Res | none:);
Wide :: (none: | res: Res | token: Token);

consume :: proc(values: ..Wide) {
	fmt.println("pack", values.len());
}

Listed :: (items: [dynamic]int | none:);
Listed_Wide :: (none: | items: [dynamic]int | n: int);

count :: proc(values: ..Listed_Wide) -> int {
	return values.len();
}

// A copy that needs more than the container's arena has is refused.
Owned :: struct { values: [dynamic]int }
impl Owned {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Owned, Allocator_Error) {
		return .ok(Owned{self.values.try_clone(allocator) or_return});
	}
}
Small_Owned :: (owned: Owned | none:);
Wide_Owned :: (none: | owned: Owned | token: Token);

arena_append :: proc() {
	buffer: [1024]u8 = {};
	arena := mem.Arena.from_buffer(&mut buffer[:]);
	source: Small_Owned = .owned(Owned{make([dynamic]int, 1024)});
	items := make([dynamic]Wide_Owned, 0, 0, arena.allocator());
	fmt.println(items.try_append(source), items.len());
}

main :: proc() {
	source: Small = .res(Res{1});
	{
		items: [dynamic]Wide = {};
		items.insert(0, source);
		fmt.println(items.try_insert(1, source), items.len());
	}
	{
		m: map[int]Wide = {};
		fmt.println(m.try_insert(0, source), m.len());
	}
	consume(source, .none);

	refused: Small = .res(Res{3});
	{
		items: [dynamic]Wide = {};
		fmt.println(items.try_insert(0, refused), items.len());
		m: map[int]Wide = {};
		fmt.println(m.try_insert(0, refused), m.len());
	}
	fmt.println(source, refused);

	listed: Listed = .items([dynamic]int{1});
	fmt.println(count(listed, .n(2)), listed);

	{
		items: [dynamic]Wide = {};
		items.append(source, .res(Res{2}));
		fmt.println(items.try_append(source, .none), items.len());
		fmt.println(items.try_append(source, .res(Res{4}), refused), items.len());
	}
	arena_append();
	fmt.println("done");
}
