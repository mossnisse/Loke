// design.md "Iteration adapters": "Static expansion uses the same adapters", so a
// static `copied()` yields the elements themselves.
package main;

import "core:fmt";

ELEMENTS :: [3]int{4, 5, 6};

main :: proc() {
	foreach ($x in (1..=3).copied()) { fmt.println(x); }
	foreach ($x in ELEMENTS.copied()) { fmt.println(x); }
	foreach ($x, $i in ELEMENTS.copied().indexed()) { fmt.println(x, i); }
	foreach ($x in ELEMENTS.reversed().copied()) { fmt.println(x); }
}
