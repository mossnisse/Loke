// design.md "Procedure result contracts": a result read through two loads, or more
// with one carrier between, names the path its last load went along, so a reset of
// the region stored through it ends nothing of the fields beside that one.
package main;

import "core:fmt";
import "core:mem";

Two :: struct { p: ^mut [dynamic]int, q: ^mut [dynamic]int }
Nest :: struct { two: ^Two }
Wide :: struct { two: ^Two, other: ^Two }
Three :: struct { nest: ^Nest }

through_two :: proc(nest: ^Nest) -> ^mut [dynamic]int { return nest^.two^.q; }
through_other :: proc(w: ^Wide) -> ^mut [dynamic]int { return w^.other^.q; }
through_three :: proc(t: ^Three) -> ^mut [dynamic]int { return t^.nest^.two^.q; }

two_loads :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [1024]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := make([dynamic]int, 1, kept.allocator());
	b := make([dynamic]int, 0, kept.allocator());
	two := Two{&mut a, &mut b};
	nest := Nest{&two};
	target := through_two(&nest);
	target^ = make([dynamic]int, 1, allocator);
	drop(b);
	free_all(allocator);
	return a[0] + 1;
}

// The first load goes along `other`, so nothing of `two` is reached.
beside_the_first :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [1024]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := make([dynamic]int, 1, kept.allocator());
	b := make([dynamic]int, 1, kept.allocator());
	c := make([dynamic]int, 1, kept.allocator());
	d := make([dynamic]int, 0, kept.allocator());
	two := Two{&mut a, &mut b};
	other := Two{&mut c, &mut d};
	w := Wide{&two, &other};
	target := through_other(&w);
	target^ = make([dynamic]int, 1, allocator);
	drop(d);
	free_all(allocator);
	return a[0] + b[0] + c[0] + 3;
}

three_loads :: proc(@(allocator_reset) allocator: mem.Allocator) -> int {
	buffer := [1024]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := make([dynamic]int, 1, kept.allocator());
	b := make([dynamic]int, 0, kept.allocator());
	two := Two{&mut a, &mut b};
	nest := Nest{&two};
	three := Three{&nest};
	target := through_three(&three);
	target^ = make([dynamic]int, 1, allocator);
	drop(b);
	free_all(allocator);
	return a[0] + 2;
}

main :: proc() {
	buffer := [4096]u8{};
	arena := mem.Arena.from_buffer(&mut buffer[:]);
	fmt.println(two_loads(arena.allocator()), beside_the_first(arena.allocator()), three_loads(arena.allocator()));
}
