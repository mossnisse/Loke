// design.md "Variadic parameters": a `..^T` pack whose pointers would take more
// than 256 KiB is allocated from the default provider and released when the call
// returns, so a spread it lends has no limit, lone or among other operands.
package main;
import "core:fmt";
import "core:container";

count :: proc(xs: ..^int) -> int { return xs.len(); }

last :: proc(xs: ..^int) -> int { return xs[xs.len() - 1]^; }

main :: proc() {
	items := make([dynamic]int);
	for (i := 0; i < 40000; i += 1) { items.append(i); }
	x := -1;
	fmt.println(count(..items), count(x, ..items, x), last(x, ..items), last(..items, x));
	// Each call releases its pack, so a loop keeps none of them.
	total := 0;
	for (i := 0; i < 50; i += 1) { total += count(..items); }
	fmt.println(total);
	// A deque's `try_append` lends its spread.
	q := container.Deque(int){};
	_ = q.try_append(..items);
	fmt.println(q.len());
}
