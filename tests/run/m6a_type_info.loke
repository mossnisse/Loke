package main; import "core:fmt"; import "core:unsafe";

// design.md "`type` and `typeid`": `type_info_of(id)` "accepts a runtime
// `typeid` and returns runtime metadata". The table is dense and keyed by the
// frozen id, so a lookup is a checked index rather than a runtime call — and a
// `typeid` is an ordinary scalar, so the check is what makes the zero id and a
// forged one answer the `Invalid` entry instead of reading past the table.

import "base:runtime";

Point :: struct {
	@(public) x: int,
	@(public) y: i32,
}

Colour :: enum { Red, Green = 5, Blue }

Huge :: enum u128 { Value = 18446744073709551617 }

// A union's members are its variants, in declaration order. The variant's name
// is its identity, so two variants sharing a payload type are two entries; a
// payloadless one reports `Unit`, and each entry's `offset` is the declaration
// index the tag holds.
Pair :: union { left: i32, right: i32, neither: }

// A distinct entry names the type it is declared over and nothing else; that
// type's own entry carries the shape, one level at a time.
Meters :: distinct f64;
Depth :: distinct Meters;

// A `typeid` is an ordinary runtime scalar, so an out-of-range value can be
// produced through unsafe storage reinterpretation.
forge :: proc(raw: i64) -> typeid {
	p := &raw;
	q := (^typeid)(rawptr(p));
	return q^;
}

main :: proc() {
	info := type_info_of(typeid_of(Point));
	fmt.println(info.size);
	fmt.println(info.members.len());
	fmt.println(int(info.kind));
	fmt.println(info.name.len());
	u := type_info_of(typeid_of(u8));
	fmt.println(u.bits);
	fmt.println(1 if u.signed else 0);
	empty: typeid = {};
	fmt.println(int(type_info_of(empty).kind), type_info_of(empty).size);
	forged := forge(999999);
	fmt.println(int(type_info_of(forged).kind), type_info_of(forged).name.len());
	c := type_info_of(typeid_of(Colour));
	fmt.println(c.members.len());
	wide := type_info_of(typeid_of(Huge));
	fmt.println(wide.members[0].value_low, wide.members[0].value_high);
	pair := type_info_of(typeid_of(Pair));
	fmt.println(int(pair.kind), pair.members.len());
	foreach (member in pair.members) {
		fmt.println(member.name, int(member.kind), member.offset,
			1 if member.type == typeid_of(i32) else 0);
	}
	depth := type_info_of(typeid_of(Depth));
	fmt.println(int(depth.kind), depth.size, depth.bits, 1 if depth.element == typeid_of(Meters) else 0);
	meters := type_info_of(depth.element);
	fmt.println(int(meters.kind), 1 if meters.element == typeid_of(f64) else 0);
	float := type_info_of(meters.element);
	fmt.println(int(float.kind), float.bits);
}
