package main;
import "core:fmt";
import "core:mem";

// design.md "`caller_location()`": a default the compiler cannot fold still names
// the call that omits it, directly, by name, through a group, from a method, and
// at compile time. Each call checks the default as written, so one holding a
// procedure literal or calling a package's built-in works as the declared one does.

offset := 0;
report :: proc(line := offset + caller_location().line) -> int { return line; }
both :: proc(base: int, line := base + caller_location().line) -> int { return line; }
label :: proc(text: string_view) -> string_view { return text; }
Pick :: proc{label, both};

T :: struct { n: int }
impl T {
	at :: proc(self, line := self.n + caller_location().line) -> int { return line; }
}

apply :: proc(f: proc(v: int) -> int, v: int) -> int { return f(v); }
doubled :: proc(line := apply(proc(v: int) -> int { return v * 2; }, caller_location().line)) -> int { return line; }
tag :: proc(text := fmt.to_string(mem.default_allocator(), "at", caller_location().line)) -> string { return text; }

AT :: both(3000);

main :: proc() {
	offset = 100;
	fmt.println(report());
	fmt.println(both(1000));
	fmt.println(both(base = 2000));
	fmt.println(Pick(4000));
	fmt.println(AT);
	fmt.println(T{n = 5000}.at());
	fmt.println(doubled());
	fmt.println(tag());
}
