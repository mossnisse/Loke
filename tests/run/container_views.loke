package main; import "core:fmt"; import "base:interfaces";

// Container views as ordinary iterable values (design.md "Iteration adapters",
// "String iteration").
//
// The six views are methods answering values: they can be stored, passed to
// generic code, returned where their lifetime permits, and stepped by hand
// through `next`. Nothing about them is `foreach` header syntax, so a user type
// bearing one of their names keeps its own member.

// A user type with every former reserved name. Each one counts its calls, so the
// output proves the receiver and the method run exactly once per loop header —
// the header does not intercept the name and evaluate something else.
calls: static int = 0;

Named :: struct {
	base: int,
}

Named_Iterator :: struct {
	current: int,
}

impl Named {
	Element  :: int;
	Iterator :: Named_Iterator;

	iter :: proc(self) -> Named_Iterator { return {self.base}; }

	// Deliberately not traversals: each answers a plain number, so a `foreach`
	// over one iterates *its* result, not the receiver.
	keys :: proc(self) -> Named { calls += 1; return Named{self.base + 1}; }
	values :: proc(self) -> Named { calls += 1; return Named{self.base + 2}; }
	entries :: proc(self) -> Named { calls += 1; return Named{self.base + 3}; }
	runes :: proc(self) -> Named { calls += 1; return Named{self.base + 4}; }
	rune_offsets :: proc(self) -> Named { calls += 1; return Named{self.base + 5}; }
	bytes :: proc(self) -> Named { calls += 1; return Named{self.base + 6}; }
}

impl Named_Iterator {
	next :: proc(self: inout Named_Iterator) -> Option(int) {
		if (self.current <= 0) { return .none; }
		value := self.current;
		self.current -= 1;
		return .some(value);
	}
}

Colour :: enum{Red, Green, Blue};

// Generic code sees a view exactly as it sees any other iterable.
count :: proc(source: $S) -> int where interfaces.Iterable(S) {
	total := 0;
	foreach (_ in source) { total += 1; }
	return total;
}

sum_ints :: proc(source: $S) -> int where interfaces.Iterable(S), S.Element == int {
	total := 0;
	foreach (n in source) { total += n; }
	return total;
}

// A view type is opaque, so a signature names it the way it names any other
// compiler-owned iterator: through a generic parameter. Returning one is valid
// while what it borrows outlives the call -- here, the caller's own map.
passthrough :: proc(view: $V) -> V {
	return view;
}

main :: proc() {
	table: map[int]int = {};
	table[2] = 20;
	table[5] = 50;

	// Each view used directly.
	keys, values, entries := 0, 0, 0;
	foreach (k in table.keys()) { keys += k; }
	foreach (v in table.values()) { values += v; }
	// design.md "Element bindings": one name over the entry receives the record of
	// addresses the table lends, so the halves are read through `^`.
	foreach (e in table.entries()) { entries += e.key^*100 + e.value^; }
	fmt.println(keys);
	fmt.println(values);
	fmt.println(entries);

	// An entry destructures exactly as a bare map loop does, and both spellings
	// bind the halves where the table holds them.
	pairs := 0;
	foreach (k, v in table.entries()) { pairs += k*100 + v; }
	foreach (k, v in table) { pairs -= k*100 + v; }
	foreach (e in table) { pairs += e.key^*100 + e.value^; }
	foreach (e in table.entries()) { pairs -= e.key^*100 + e.value^; }
	fmt.println(pairs);

	// Stored, and traversed twice: every `iter()` starts fresh.
	stored := table.keys();
	fmt.println(sum_ints(stored) + sum_ints(stored));

	// Passed generically, and returned.
	fmt.println(count(table.entries()));
	fmt.println(sum_ints(passthrough(table.values())));

	// Stepped by hand. The explicit walk and the loop agree: both lend, so what
	// `next` hands back names the value in the table (design.md "Iteration
	// protocol").
	manual := table.values();
	walker := manual.iter();
	by_hand := 0;
	walking := true;
	for (walking) {
		switch (step in walker.next()) {
		case .some: by_hand += step^;
		case .none: walking = false;
		}
	}
	fmt.println(by_hand);

	// Composition with the header adapter.
	numbered := 0;
	foreach (v, i in table.values().indexed()) { numbered += v + i; }
	fmt.println(numbered);

	// An empty source runs zero times.
	empty: map[int]int = {};
	blank: string = "";
	fmt.println(count(empty.keys()) + count(empty.values()) + count(empty.entries()));
	fmt.println(count(blank.runes()) + count(blank.rune_offsets()));

	// Text views. `runes()` is the string's own traversal, so it answers the
	// `string_view` over the same bytes; `rune_offsets()` carries byte offsets.
	text := "AÅ✓";
	foreach (r in text.runes()) { fmt.println(r); }
	foreach (r, o in text.rune_offsets()) { fmt.println(o); fmt.println(r); }
	foreach (p in text.rune_offsets()) { fmt.println(p.offset); }
	view: string_view = text.runes();
	fmt.println(count(view));
	fmt.println(count(text.rune_offsets()));
	fmt.println(count(text.bytes()));

	// A `string_view` receiver reaches the same views.
	slice_view: string_view = text[1:];
	fmt.println(count(slice_view.runes()) + count(slice_view.rune_offsets()));

	// Unicode offsets survive `.indexed()` composition: the ordinal counts runes
	// while the offset counts bytes.
	foreach (p, i in text.rune_offsets().indexed()) { fmt.println(i*100 + p.offset); }

	// `bytes()` still reverses; the map views and rune walks are forward-only.
	reversed := 0;
	foreach (b in text.bytes().reversed()) { reversed = reversed*10 + int(b)%10; }
	fmt.println(reversed);

	// A user type keeps its own members, with the same meaning in a loop header
	// as outside one. Each header calls its method once.
	subject := Named{0};
	foreach (v in subject.keys()) { fmt.println(v); }
	foreach (v in subject.values()) { fmt.println(v); }
	foreach (v in subject.entries()) { fmt.println(v); }
	foreach (v in subject.runes()) { fmt.println(v); }
	foreach (v in subject.rune_offsets()) { fmt.println(v); }
	foreach (v in subject.bytes()) { fmt.println(v); }
	outside := subject.keys();
	fmt.println(outside.base);
	fmt.println(calls);

	// An enumeration's members remain an ordinary constant expression, in a
	// runtime loop and in a static expansion.
	foreach (colour in Colour.values()) { fmt.println(colour); }
	foreach ($colour, $index in Colour.values().indexed()) { fmt.println(index); }

	// A copy taken out of a view is owned, so it outlives the map it came from.
	owning: map[int]string = {};
	owning[1] = "kept";
	saved: string = "";
	foreach (v in owning.values()) { saved = v; }
	drop(owning);
	fmt.println(saved.byte_len());

	// Mutable map traversal is explicit through the value view.
	named: map[string]int = {};
	named["only"] = 5;
	foreach (&value in named.values()) { value += 4; }
	fmt.println(named["only"]);
	numbers: [dynamic]int = {};
	numbers.append(1, 2);
	foreach (&n, i in numbers.indexed()) { n = n*10 + i; }
	foreach (n in numbers) { fmt.println(n); }
}
