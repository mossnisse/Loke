package main; import "core:fmt";
import "core:sync";

// design.md "Switch ownership": a switch over a place borrows it, and a switch
// over a temporary consumes it — the active payload transferring into the
// case's own binding, which drops exactly once on every exit of that case.
//
// Every exit is walked here: falling out, `break`, `continue`, `return`, a
// `move` out of the binding, a grouped case, a default case, and `_`.

drops: int;
copies: sync.Atomic(int);

Owned :: struct { id: int }
impl Owned {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Owned, Allocator_Error) {
		copies.add(1);
		return .ok(Owned{self.id});
	}
	release :: hook(drop) proc(self: inout Owned) { drops += 1; }
}

Handle :: move_only struct { id: int }
impl Handle {
	release :: hook(drop) proc(self: inout Handle) { drops += 1; }
}

Boxed  :: union @(zero=empty) { empty:, held: Owned, spare: Owned }
Sealed :: union { open: Handle, shut: }

held :: proc(id: int) -> Boxed { return .held(Owned{id}); }
opened :: proc(id: int) -> Sealed { return .open(Handle{id}); }

reset :: proc() { copies.store(0); drops = 0; }
report :: proc(label: string_view) { fmt.println(label, copies.load(), drops); }

// A `return` out of a consuming case still drops the binding once.
returns_from_a_case :: proc(id: int) -> int {
	switch (held(id)) {
	case .held(value):  return value.id;
	case .spare: return -1;
	case .empty: return 0;
	}
}

// So does a `return` that hands the payload on: the binding is a place, so the
// value that leaves is a copy of it.
copies_out_of_a_case :: proc(id: int) -> Owned {
	switch (held(id)) {
	case .held(value):  return value.clone();
	case .spare: return Owned{0};
	case .empty: return Owned{0};
	}
}

main :: proc() {
	// --- falling out of a case -------------------------------------------
	reset();
	{
		switch (held(1)) {
		case .held(value):  fmt.println("held", value.id);
		case .spare(value): fmt.println("spare", value.id);
		case .empty:
		}
	}
	report("fall out");

	// --- `break` through a case and out of its loop -----------------------
	reset();
	{
		for (;;) {
			switch (held(2)) {
			case .held(value):
				fmt.println("before break", value.id);
				break;
			case .spare, .empty:
			}
			fmt.println("not reached");
		}
	}
	report("break");

	// --- `continue` out of a case, from inside a loop ---------------------
	reset();
	{
		for (i := 0; i < 2; i += 1) {
			switch (held(3)) {
			case .held(value):
				fmt.println("iteration", i, value.id);
				continue;
			case .spare, .empty:
			}
			fmt.println("not reached");
		}
	}
	report("continue");

	// --- `return` out of a case ------------------------------------------
	reset();
	fmt.println(returns_from_a_case(4));
	report("return");

	reset();
	{
		copied := copies_out_of_a_case(5);
		fmt.println("copied out", copied.id);
	}
	// One clone leaving the case, and two values ending.
	report("return a copy");

	// --- a grouped or default case names the union through a local ---------
	// A case binds only a variant's payload, so a case that needs the whole
	// value switches over a place holding it, and borrows it there.
	reset();
	{
		value := held(6);
		switch (value) {
		case .held, .spare:
			fmt.println("grouped", value);
		case .empty:
		}
	}
	report("grouped");

	reset();
	{
		value := held(7);
		switch (value) {
		case .empty:
		default:
			fmt.println("default", value);
		}
	}
	report("default");

	// --- `_` acquires no binding, so the case owns the union --------------
	reset();
	{
		switch (held(8)) {
		case .held:  fmt.println("discarded");
		case .spare, .empty:
		}
	}
	report("discarded");

	// --- a place subject only lends ---------------------------------------
	reset();
	{
		kept := held(9);
		switch (kept) {
		case .held(value):  fmt.println("borrowed", value.id);
		case .spare, .empty:
		}
		// `kept` still holds its payload here, and drops it at the end of the
		// block — one value, one drop, no copy.
		fmt.println("still held", kept);
	}
	report("place subject");

	// --- a move-only payload leaves through `move` ------------------------
	// `taken` starts at the zero `Handle`, and the assignment drops that one:
	// two drops, no copy. The zero is written, because a local with no
	// initialiser would be dead on the `.shut` path.
	reset();
	{
		taken: Handle = {};
		switch (opened(10)) {
		case .open(value): taken = move(value);
		case .shut:
		}
		fmt.println("moved out", taken.id);
	}
	report("move out");

	// And a move-only payload a case simply drops.
	reset();
	{
		switch (opened(11)) {
		case .open(value): fmt.println("dropped in place", value.id);
		case .shut:
		}
	}
	report("dropped in place");
}
