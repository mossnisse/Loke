// design.md "Borrows crossing between tasks": the accepted counterpart of
// tests/err/parallel_written_back. A task may use its own `thread_local`
// storage and write back a value read from it, also through a callback, and on
// one thread a procedure may leave a borrow of its `thread_local` storage in its
// caller's, which a task may not be handed but the parent may still use.
package main;

import "core:fmt";

counter: thread_local int;

publish :: proc(out: ^mut ^int) { out^ = &counter; }
read_own :: proc(out: ^mut int) { counter += 1; out^ = counter; }
invoke :: proc(f: proc(out: ^mut int), out: ^mut int) { f(out); }
read_slot :: proc(p: ^int, out: ^mut int) { out^ = p^; }

main :: proc() {
	plain := 0;
	called := 0;
	parallel {
		spawn read_own(&mut plain);
		spawn invoke(read_own, &mut called);
	}
	other := 0;
	view: ^int = &other;
	untouched: ^int = &other;
	publish(&mut view);
	seen := 0;
	parallel {
		spawn read_slot(untouched, &mut seen);
	}
	fmt.println(plain, called, view^, seen);
}
