// design.md "Borrows crossing between tasks": the accepted counterpart of
// tests/err/parallel_written_back. A task may use its own `thread_local`
// storage and write back a value read from it, also through a callback, and on
// one thread a procedure may leave a borrow of its `thread_local` storage in its
// caller's, which a task may not be handed but the parent may still use. A
// callback that writes nothing back is told apart from one that does, though
// both fit the callback's type or contract. A write-back lands only in the
// storage the argument's mutable carriers name, not in what it points at.
package main;

import "core:fmt";

counter: thread_local int;
fallback: int;

publish :: proc(out: ^mut ^int) { out^ = &counter; }
read_own :: proc(out: ^mut int) { counter += 1; out^ = counter; }
invoke :: proc(f: proc(out: ^mut int), out: ^mut int) { f(out); }
read_slot :: proc(p: ^int, out: ^mut int) { out^ = p^; }

keep :: proc(out: ^mut ^int) { _ = out^^; }
call_back :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { f(out); }
relay :: proc(f: proc(out: ^mut ^int), out: ^mut ^int) { call_back(f, out); }
publish_returning :: proc(out: ^mut ^int) -> ^int {
	out^ = &counter;
	return &counter;
}
keep_returning :: proc(out: ^mut ^int) -> ^int { return &counter; }
Contract :: type_of(publish_returning);
call_contract :: proc(f: Contract, out: ^mut ^int) { _ = f(out); }

main :: proc() {
	plain := 0;
	called := 0;
	parallel {
		spawn read_own(&mut plain);
		spawn invoke(read_own, &mut called);
	}
	other := 0;
	view: ^int = &other;
	untouched: ^int = &other;
	publish(&mut view);
	seen := 0;
	parallel {
		spawn read_slot(untouched, &mut seen);
	}
	// `publish` is a value here; `keep` stands in for it in each task.
	call_back(publish, &mut view);
	kept_value := 7;
	kept: ^int = &kept_value;
	parallel {
		spawn call_back(keep, &mut kept);
	}
	parallel {
		spawn relay(keep, &mut kept);
	}
	parallel {
		spawn call_contract(keep_returning, &mut kept);
	}
	call_back(keep, &mut kept);
	relay(keep, &mut kept);
	kept_seen := 0;
	parallel {
		spawn read_slot(kept, &mut kept_seen);
	}
	pointed: ^int = &fallback;
	publish(&mut pointed);
	fmt.println(plain, called, view^, seen, kept_seen, pointed^);
}
