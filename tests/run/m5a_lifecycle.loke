package main; import "core:mem"; import "core:fmt";

// design.md "Lifecycle hooks and resource types" (m5a-plan step 3): a record
// receives field-wise `try_clone` and a `clone` generated from it, a custom
// hook replaces the fallible half, and a failed field-wise clone destroys the
// partially built temporary before returning zero plus the error.

// Too large for any allocator to satisfy, which is how a fixture reaches the
// failure path of an explicitly fallible operation.
Huge :: struct { pad: [4611686018427387904]u8 }

Plain :: struct {
	x: int,
	y: int,
}

Res :: struct { id: int }

impl Res {
	// A non-allocating hook accepts and ignores the allocator, and returns a nil
	// error.
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Res, Allocator_Error) {
		return .ok(Res{self.id + 100});
	}

	// The observable half of cleanup: an implicit drop is a step 4 site, but the
	// partial-clone cleanup below already has to run this exactly once per part
	// it managed to build.
	release :: hook(drop) proc(self: inout Res) {
		fmt.println(self.id);
		self.id = 0;
	}
}

Failing :: struct { id: int }

impl Failing {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Failing, Allocator_Error) {
		p := new(Huge, allocator) or_return;
		free(p);
		return .ok(Failing{self.id});
	}
}

Group :: struct {
	items: [2]Res,
	tail:  Failing,
}

empty_copies, empty_drops: int;
Empty_Element :: struct {}
impl Empty_Element {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Empty_Element, Allocator_Error) {
		empty_copies += 1;
		return .ok(Empty_Element{});
	}
	release :: hook(drop) proc(self: inout Empty_Element) { empty_drops += 1; }
}
Empty_Arrays :: struct { items: [0]Empty_Element, nested: [2][0]Empty_Element, marker: int }
Empty_Wrapper :: struct { value: Empty_Arrays }

copy_empty_borrow :: proc(value: Empty_Arrays) -> Empty_Arrays { return value; }

empty_array_copies :: proc() {
	// An empty managed array has no element hooks to call, even when its
	// element has a custom (potentially failing) copy. Keep the other fields.
	value: Empty_Arrays;
	value.marker = 7;
	fallible, error := value.try_clone();
	assert(error == nil && fallible.marker == 7);
	explicit := value.clone();
	implicit := value;
	replacement: Empty_Arrays;
	replacement = implicit;
	borrowed := copy_empty_borrow(value);
	assert(explicit.marker == 7 && replacement.marker == 7 && borrowed.marker == 7);

	// Copy dependencies are recursive even when no part can fail.
	wrapper := Empty_Wrapper{move(value)};
	wrapper_copy := wrapper.clone();
	assert(wrapper_copy.value.marker == 7);
	items: [0]Empty_Element;
	items_copy := items;
	items_copy = items;
	assert(empty_copies == 0 && empty_drops == 0);
}

main :: proc() {
	empty_array_copies();
	assert(empty_copies == 0 && empty_drops == 0);
	// Zero inline size alone does not mean trivial: a *present* element must
	// still run its hooks. The empty-array handling must not erase these calls.
	{
		present: [1]Empty_Element;
		present_copy := present;
		assert(empty_copies == 1);
	}
	assert(empty_drops == 2);

	// A record no part of which reaches a custom hook clones by copying its
	// representation, and the generated `clone` is reached with no allocator
	// written: the compiler supplies the default until `core:mem` is nameable.
	p := Plain{1, 2};
	q := p.clone();
	fmt.println(q.x + q.y);

	// An explicit allocator selects the same default provider in M5a.
	a := mem.default_allocator();
	r := p.clone(a);
	fmt.println(r.y);

	// The generated `try_clone` is field-wise: the custom hook of `Res` runs for
	// every element, so each id gains 100.
	ok := Group{[2]Res{Res{11}, Res{22}}, Failing{0}};
	single, single_error := ok.items[0].try_clone();
	if (single_error == nil) {
		fmt.println(single.id);
	}

	// `tail` fails, so the two elements already cloned into the temporary are
	// dropped in reverse part order — 122 then 111 — and the result is the inert
	// zero paired with the error.
	failed, error := ok.try_clone();
	if (error != nil) {
		fmt.println(-1);
	}
	fmt.println(failed.items[0].id);
	fmt.println(failed.tail.id);

	// design.md: `new_clone` "creates a new allocation root containing a clone of
	// the value", so it fills the allocation through the same hook.
	held, allocation_error := new_clone(Res{5});
	if (allocation_error == nil) {
		fmt.println(held^.id);
		free(held);
	}

	// And destroys the allocation it could not publish into: the two elements
	// already cloned are dropped, then the block is released.
	spare, group_error := new_clone(ok);
	if (group_error != nil) {
		fmt.println(-2);
	}

	// Falling out of `main` drops every managed local still live, in reverse
	// registration order (m5a-plan step 4): the inert `failed`, then `single`,
	// then `ok`'s two elements in reverse. `held` and `spare` are allocation
	// roots, which are manual and never dropped automatically.
}
