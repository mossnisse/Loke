package main;

import "core:fmt";

// design.md "Weakening and reborrows": a carrier suspended by a read-only
// reborrow may still be read, including copied where a read-only carrier is
// wanted, so these hold several read-only views of `xs` at once.

Views :: struct { a: []int }
Holder :: struct { ro: []int, rw: []mut int }
Held :: struct { first: Holder, second: int }

declarations :: proc(xs: []mut int) {
	v1: []int = xs;
	v2: []int = xs;
	fmt.println(v1[0], v2[1]);
}

assignments :: proc(xs: []mut int) {
	v1: []int = {};
	v2: []int = {};
	v1 = xs;
	v2 = xs;
	view := Views{{}};
	view.a = xs;
	fmt.println(v1[0], v2[1], view.a[0]);
}

records :: proc(xs: []mut int) {
	r1 := Views{xs};
	r2 := Views{xs};
	both := [2]Views{Views{xs}, Views{xs}};
	fmt.println(r1.a[0], r2.a[1], both[0].a[0], both[1].a[1]);
}

// A read-only borrow of storage behind a mutable pointer only reads the
// pointer, so several may be held at once, also two pointers away.
through_pointer :: proc(items: ^mut [dynamic]int, p: ^mut ^mut [dynamic]int) {
	first, second := &items^[0], &items^[1];
	low: []int = items^[:1];
	far: []int = p^^[1:];
	near := &p^^[0];
	fmt.println(first^, second^, low[0], far[0], near^);
}

replace :: proc(slot: inout []int, @(escape=stored) value: []int) -> int {
	slot = value;
	return 0;
}

// design.md "Evaluation order": the first element keeps the `ro` it held
// before the second assigns it, which is `external`, not `local`.
weakened_field :: proc(external: []mut int, writable: []mut int) -> []int {
	local := [1]int{42};
	holder := Holder{external, writable};
	held := Held{holder, replace(inout holder.ro, local[:])};
	return held.first.ro;
}

main :: proc() {
	values := [2]int{1, 2};
	other := [1]int{3};
	xs := &mut values[:];
	declarations(xs);
	assignments(xs);
	records(xs);
	fmt.println(weakened_field(xs, &mut other[:]));
	near := [dynamic]int{4, 5};
	far := [dynamic]int{6, 7};
	held := &mut far;
	through_pointer(&mut near, &mut held);
}
