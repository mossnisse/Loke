package main; import "core:fmt";

// design.md "`source_location() or source_location(<entity>)`" and "`caller_location()`".
// Every field is known at compile time, so a location is one constant aggregate
// over static storage and costs nothing at run time.

import "base:runtime";

target :: proc() { }

// design.md: `caller_location()` "is evaluated at each call that omits that
// argument, like any other default", so two calls on two lines disagree.
report :: proc(loc: runtime.Source_Code_Location = caller_location()) -> int {
	return loc.line;
}

// The same default reached through an overload group. `caller_location()` is
// per call site, so the group spelling must agree with the direct one.
report_n :: proc(n: int, loc: runtime.Source_Code_Location = caller_location()) -> int {
	return loc.line;
}

note :: proc { report, report_n }

main :: proc() {
	here := source_location();
	fmt.println(here.line);
	fmt.println(here.column);
	fmt.println(here.procedure.len());

	// A named entity gives its *declaration* span, not the span of naming it.
	fmt.println(source_location(target).line);

	fmt.println(report());
	fmt.println(report());
	// An explicitly written argument wins over the default.
	fmt.println(report(source_location(target)));

	// design.md "Compile-time built-ins": these are ordinary predeclared
	// identifiers, so a declaration shadows one exactly as it shadows `len`.
	{
		source_location := 5;
		fmt.println(source_location);
	}

	// A direct call and a group call on adjacent lines each report their own.
	fmt.println(report());
	fmt.println(note(1));

	// A callee declared *after* this call, direct and through a group. The
	// default belongs to the call site either way, which holds only because a
	// default is resolved with the signature rather than with the body.
	fmt.println(ahead());
	fmt.println(look(2));
}

ahead :: proc(loc: runtime.Source_Code_Location = caller_location()) -> int {
	return loc.line;
}

look_n :: proc(n: int, loc: runtime.Source_Code_Location = caller_location()) -> int {
	return loc.line;
}

look :: proc { ahead, look_n }
