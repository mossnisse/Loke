package main;
import "core:fmt";

// design.md "Temporaries and procedure boundaries": a written `dyn proc`
// conversion is the implicit conversion written out, so a local receiving one
// extends the temporary it views to the end of the block. A conversion to the
// same view type around it is an identity and extends too.

main :: proc() {
	n := 0;
	f := (dyn proc())(proc() capture(&mut n) { n += 1; });
	f();
	f();
	fmt.println(n);
	g := (dyn proc())((dyn proc())(proc() capture(&mut n) { n += 10; }));
	g();
	fmt.println(n);
}
