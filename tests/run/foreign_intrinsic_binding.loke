// design.md "Foreign system": a foreign binding may name an LLVM intrinsic that
// the program also reaches through a built-in, here `math.count_ones` on an
// `i64`. The module declares the name once; it declared it twice, and clang
// rejected the redefinition.
package main;

import "core:fmt";
import "core:math";

foreign llvm {
	@(link_name="llvm.ctpop.i64")
	popcount :: proc "c" (value: i64) -> i64 ---;
}

ones :: proc(n: i64) -> int { return math.count_ones(n); }

main :: proc() {
	fmt.println(popcount(7));
	fmt.println(ones(popcount(127)));
}
