// design.md "Evaluation order": every destination of a multiple assignment is
// evaluated before any write, so a store through a carrier the same statement
// reassigns goes where the carrier pointed before. design.md "Values that
// contain borrows": that store replaces what the place held, so the borrow it
// held there is no longer in use.
package main;
import "core:fmt";

Node :: struct { value: int }
Pair :: struct { head: ^mut Node, tail: ^mut Node }
Retarget :: struct { pair: ^mut Pair, node: ^mut Node }

// `p^.head` is `x.head`, so `x` no longer reaches `a`.
reassigned :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4};
	x := Pair{&mut a, &mut b};
	y := Pair{&mut c, &mut d};
	p := &mut x;
	p, p^.head = &mut y, p^.tail;
	h := x.head;
	a.value = 10;
	h^.value += 20;
	k := y.head;
	d.value = 30;
	k^.value += 40;
	fmt.println(a.value, b.value, c.value, d.value);
}

// The second statement goes through what the first assigned, `y`.
in_turn :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4}; e := Node{5}; f := Node{6};
	x := Pair{&mut a, &mut b};
	y := Pair{&mut c, &mut d};
	z := Pair{&mut e, &mut f};
	p := &mut x;
	p, p^.head = &mut y, p^.tail;
	p, p^.head = &mut z, p^.tail;
	h := y.head;
	c.value = 30;
	h^.value += 40;
	k := x.head;
	a.value = 10;
	k^.value += 20;
	p^.head^.value += 50;
	fmt.println(a.value, b.value, c.value, d.value, e.value, f.value);
}

// Destructuring evaluates its destinations the same way.
destructured :: proc() {
	a := Node{1}; b := Node{2}; c := Node{3}; d := Node{4};
	x := Pair{&mut a, &mut b};
	y := Pair{&mut c, &mut d};
	p := &mut x;
	p, p^.head = Retarget{&mut y, p^.tail};
	h := x.head;
	a.value = 10;
	h^.value += 20;
	fmt.println(a.value, b.value, c.value, d.value);
}

main :: proc() {
	reassigned();
	in_turn();
	destructured();
}
