// design.md "String format printing": a checked pointer prints the value it
// names, as a box does; an unchecked address still prints as an address.
package main;
import "core:fmt";
import "core:unsafe";
Node :: struct { value: int, next: Option(^Node) }
// A referent chain that returns to itself prints through its own formatter.
P :: distinct ^P;
B :: distinct Box(Option(B));
main :: proc() {
	m := map[string]int{"a" = 1};
	foreach (entry in m) { fmt.println(entry.key, entry.value, entry); }
	x := 5;
	p := &x;
	fmt.println(p, [2]^int{p, p});
	tail := Node{2, .none};
	head := Node{1, .some(&tail)};
	fmt.println(head);
	s := "hi";
	fmt.println(&s, [1]^string{&s});
	cyclic: Option(P) = .none;
	boxed: Option(B) = .none;
	fmt.println(cyclic, boxed);
	r: rawptr = &x;
	fmt.println(r == r, unsafe.raw_data([]int{1}[:]) != nil);
}
