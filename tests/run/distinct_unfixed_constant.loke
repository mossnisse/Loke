package main;
import "core:fmt";
// design.md "Implicit type conversions", "Distinct types": an unfixed constant
// converts to a distinct type as it does to the type that is declared over,
// wherever a constant converts.
Meters :: distinct f64;
Id :: distinct int;
Small :: distinct u8;
Name :: distinct string;
Flag :: distinct bool;
Letter :: distinct rune;
Serial :: distinct Id;
LIMIT :: 5;
show :: proc(length: Meters, id: Id) { fmt.println(f64(length), int(id)); }
next :: proc() -> Id { return 9; }
main :: proc() {
    show(2.5, 4);                       // arguments
    whole: Meters = 3;                  // an unfixed integer to a distinct float
    id: Id = 7;
    fmt.println(f64(whole), id < 10, id == 7, 7 == id);
    top: Small = 255;                   // in range for the underlying `u8`
    name: Name = "loke";
    flag: Flag = true;
    letter: Letter = 'a';
    code: Id = 'a';                     // a rune constant to a distinct integer
    serial: Serial = 1;                 // distinct over distinct
    fmt.println(u8(top), string(name), bool(flag), rune(letter), int(code), serial == 1);
    ids := [3]Id{1, 2, 3};              // elements
    limit: Id = LIMIT;                  // a named unfixed constant
    fmt.println(int(ids[2]), int(next()), int(limit));
    id = 8;                             // assignment
    id = 11 if int(id) > 0 else 12;     // both operands unfixed, the condition not constant
    fmt.println(int(id));
}
