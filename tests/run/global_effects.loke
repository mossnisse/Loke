package main; import "core:fmt"; import "core:sync";

// design.md "Global write effects": a call only conflicts with a borrow of a
// global its callee may actually write.

cache: [dynamic]int;
other: [dynamic]int;
counter: int;

reads :: proc(values: []int) -> int { return values.len() + counter; }
writes_other :: proc(values: []int) -> int { other.append(1); counter += 1; return values.len(); }
fill :: proc() { cache.append(1); cache.append(2); }
countdown :: proc(n: int) -> int { if (n == 0) { return 0; } return countdown(n - 1); }
apply :: proc(f: proc(values: []int) -> int) -> int { return f(cache); }

// Only the witnesses the program builds are reachable through a `dyn` call.
Shape :: interface($Self: type) { slot area: proc(self) -> int; }
Square :: struct { side: int }
impl Square { area :: proc(self) -> int { counter += 1; return self.side * self.side; } }
Circle :: struct { r: int }
impl Circle { area :: proc(self) -> int { cache.clear(); return self.r; } }
measure :: proc(shape: dyn Shape) -> int {
	view: []int = cache;
	n := shape.area();
	return view.len() + n;
}

// A drop hook and a `format` method count as the calls they are, so only the
// globals they write conflict, and a moved-out local's scope exit runs no hook.
Guard :: move_only struct { active: bool }
impl Guard {
	release :: hook(drop) proc(self: inout Guard) { if (self.active) { cache.clear(); } }
}
Tally :: struct { n: int }
impl Tally {
	format :: proc(self: ^Tally, writer: fmt.Writer, options: fmt.Options) { other.append(1); }
}
// A copy hook may count through an atomic, whose updates are not writes.
copies: sync.Atomic(int);
Counted :: struct { n: int }
impl Counted {
	dup :: hook(copy) proc(self, allocator: Allocator) -> Result(Counted, Allocator_Error) {
		copies.add(1);
		return .ok(Counted{self.n});
	}
}
consume :: proc(guard: move Guard) -> Guard { return guard; }
hooks :: proc() {
	view: []int = cache;
	guard := Guard{true};
	{
		inner := consume(move(guard));
		guard = move(inner);
	}
	fmt.print(Tally{1});
	fmt.println(view.len());
	counted := Counted{1};
	again := counted.clone();
	fmt.println(copies.load(), counted.n + again.n);
}

main :: proc() {
	hooks();
	fmt.println(cache.len());
	fill();
	fmt.println(reads(cache), writes_other(cache), countdown(3));
	fmt.println(cache);
	fmt.println(apply(reads));
	square := Square{2};
	fmt.println(measure((dyn Shape)(&square)));
	// Writing the global with no borrow of it live is fine.
	circle := Circle{1};
	fmt.println(circle.area(), cache.len());
}
