// design.md "Comparison operators", "Sorting slices": a type's own `<` or `==`
// declared as a procedure group is its own all the same. A sort orders by the
// grouped `<`; a part, a map key, and a constant compare by the grouped `==`,
// as a constant compares by any own `==` of a scalar part.
package main;

import "core:fmt";

Reverse :: distinct int;

impl Reverse {
	reversed :: proc(a, b: Reverse) -> bool { return int(b) < int(a); }
	less :: operator(<) proc { reversed };
}

// Equal when the values agree modulo 10.
Digit :: distinct int;

impl Digit {
	same :: proc(a, b: Digit) -> bool { return int(a) % 10 == int(b) % 10; }
	equal :: operator(==) proc { same };
	hash :: proc(self, seed: uint) -> uint { return uint(int(self) % 10) ~ seed; }
}

Plain :: distinct int;

impl Plain {
	equal :: operator(==) proc(a, b: Plain) -> bool { return true; }
}

Holder :: struct { digit: Digit, n: int }

GROUPED :: [2]Digit{1, 12} == [2]Digit{11, 2};
PLAIN :: [1]Plain{1} == [1]Plain{2};
static_assert(GROUPED && PLAIN);

main :: proc() {
	values: [dynamic]Reverse = {1, 3, 2};
	values.sort();
	fmt.println(values);
	fmt.println([1]Digit{3} == [1]Digit{13}, Holder{4, 0} == Holder{14, 0}, Holder{4, 0} == Holder{5, 0});
	counts: map[Digit]int = {};
	counts[Digit(7)] = 1;
	counts[Digit(17)] += 1;
	fmt.println(counts.len(), counts[Digit(27)]);
	fmt.println(GROUPED, PLAIN);
}
