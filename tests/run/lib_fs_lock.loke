package main;

import "core:fmt";
import "core:fs";
import "core:io";
import "core:os";
import "core:path";
import "core:process";
import "core:strings";
import "core:term";
import "core:time";

// `File.lock`, `try_lock`, and `unlock` (standard-library "File locking"): the
// lock belongs to a handle, so two handles in one program contend for it as two
// programs would; shared locks admit each other and an exclusive one admits
// nothing; the lock is advisory, so reads and writes through other handles go
// on; and closing or dropping a handle releases its lock. The program also runs
// itself as a child that probes the lock, so the same answers hold between two
// processes, and as one whose `lock` waits until the holder releases.

succeeded :: proc(outcome: Status(io.Error)) -> bool {
	switch (outcome) {
	case .ok:  return true;
	case .err: return false;
	}
	return false;
}

// Whether the lock was taken, or the code and operation that refused it.
attempt :: proc(outcome: Result(bool, io.Error)) {
	switch (outcome) {
	case .ok(acquired): fmt.println(acquired);
	case .err(error): fmt.println(io.code_of(error), io.operation_of(error));
	}
}

report :: proc(outcome: Status(io.Error)) {
	switch (outcome) {
	case .ok: fmt.println("ok");
	case .err(error): fmt.println(io.code_of(error), io.operation_of(error));
	}
}

root :: proc() -> string {
	switch (os.get_environment("TEMP")) {
	case .ok(outcome):
		switch (outcome) {
		case .some(base): return path.join([]string_view{base, "loke_fs_lock"});
		case .none:
		}
	case .err:
	}
	return strings.copy("loke_fs_lock");
}

open_as :: proc(file: string_view, access: fs.Access) -> fs.File {
	return fs.open(file, fs.Open_Options{access = access, disposition = .Open_Or_Create, append = false}) or_else panic("the test's file could not be opened");
}

// A handle that locks and then goes out of scope releases the lock in `drop`.
lock_and_drop :: proc(file: string_view) {
	scoped := open_as(file, .Read);
	attempt(scoped.try_lock(.Exclusive));
}

// The child: tries the lock its arguments name and answers in its exit status,
// 0 for taken, 1 for kept out, 2 for a failure.
probe :: proc(file: string_view, mode: string_view) {
	handle := fs.open_read(file) or_else os.exit(2);
	switch (handle.try_lock(fs.Lock_Mode.Exclusive if mode == "exclusive" else fs.Lock_Mode.Shared)) {
	case .ok(acquired): os.exit(0 if acquired else 1);
	case .err: os.exit(2);
	}
}

// The child that waits: kept out by the parent's exclusive lock, it writes `w`
// on its stdout and then waits in `lock`. Once that returns it writes `a`, and
// holds the lock until the parent, having seen that lock keep out another,
// writes `k` on its stdin. It answers in its exit status: 0 for that, 1 when
// `try_lock` was not kept out, 2 for a failure, and 3 when the parent's
// acknowledgement never came.
waiter :: proc(file: string_view) {
	handle := fs.open_read(file) or_else os.exit(2);
	switch (handle.try_lock(.Shared)) {
	case .ok(acquired): if (acquired) { os.exit(1); }
	case .err: os.exit(2);
	}
	// `term`'s output is unbuffered, so the parent reads this before `lock` waits.
	signal := term.stdout();
	_ = signal.write("w".bytes());
	switch (handle.lock(.Shared)) {
	case .ok:
	case .err: os.exit(2);
	}
	_ = signal.write("a".bytes());
	reply: [1]u8 = {};
	input := term.stdin();
	acknowledged := (input.read(&mut reply[:]) or_else 0) == 1 && reply[0] == u8('k');
	os.exit(0 if acknowledged else 3);
}

// The child's answer for a lock of `mode` on `file`, or -1 when it did not run.
from_another_process :: proc(file: string_view, mode: string_view) -> i32 {
	exe := os.executable_path() or_else panic("the test cannot find its own executable");
	return process.run(process.Command{
		program = exe, arguments = []string_view{"probe", file, mode},
	}) or_else -1;
}

main :: proc() {
	if (os.args.len() > 3 && os.args[1] == "probe") {
		probe(os.args[2], os.args[3]);
		return;
	}
	if (os.args.len() > 2 && os.args[1] == "waiter") {
		waiter(os.args[2]);
		return;
	}
	directory := root();
	data := path.join([]string_view{directory, "store.bin"});
	_ = fs.remove(data);
	_ = fs.remove_directory(directory);
	fmt.println(succeeded(fs.create_directories(directory)));
	fmt.println(succeeded(fs.write_text(data, "0123")));

	owner := open_as(data, .Read_Write);
	other := open_as(data, .Read);
	attempt(owner.try_lock(.Exclusive));
	attempt(other.try_lock(.Shared));
	attempt(other.try_lock(.Exclusive));
	fmt.println(from_another_process(data, "shared"));
	// One lock per handle: a second is refused rather than stacked.
	report(owner.lock(.Shared));

	// Advisory: other handles still read and write, and the size is the data's.
	fmt.println(fs.read_text(data) or_else "unreadable");
	fmt.println(succeeded(fs.append_text(data, "45")));
	writer := open_as(data, .Write);
	fmt.println(succeeded(writer.write_all_at("ab".bytes(), 0)));
	fmt.println(succeeded(writer.set_size(5)));
	fmt.println(succeeded(writer.close()));
	fmt.println(fs.read_text(data) or_else "unreadable");
	fmt.println((owner.metadata() or_else fs.Metadata{}).size);

	// Shared locks admit each other and keep out an exclusive one.
	report(owner.unlock());
	attempt(other.try_lock(.Shared));
	attempt(owner.try_lock(.Shared));
	fmt.println(from_another_process(data, "shared"), from_another_process(data, "exclusive"));
	third := open_as(data, .Read);
	attempt(third.try_lock(.Exclusive));
	report(owner.unlock());
	report(other.unlock());
	// Unlocking a handle that holds nothing is not a failure.
	report(other.unlock());

	// `lock` on a free file returns at once, and `close` releases it.
	report(third.lock(.Exclusive));
	attempt(owner.try_lock(.Shared));
	fmt.println(succeeded(third.close()));
	attempt(owner.try_lock(.Exclusive));
	report(owner.unlock());

	// So does `drop`.
	lock_and_drop(data);
	attempt(owner.try_lock(.Exclusive));
	report(owner.unlock());

	// `unlock` forgets the lock once it is released: then another handle takes
	// it, a refused `try_lock` leaves nothing to release, and the handle locks
	// again. A release that fails keeps the lock, which only a fault can show:
	// lib_fs_unlock_failure.loke.
	report(owner.lock(.Exclusive));
	report(owner.unlock());
	attempt(other.try_lock(.Exclusive));
	attempt(owner.try_lock(.Shared));
	report(owner.unlock());
	report(other.unlock());
	report(owner.lock(.Shared));
	attempt(other.try_lock(.Exclusive));
	report(owner.unlock());
	attempt(other.try_lock(.Exclusive));
	report(other.unlock());

	// An append handle that can also read locks; a write-only one is refused.
	appender := fs.open(data, fs.Open_Options{access = .Read_Write, disposition = .Open_Existing, append = true}) or_else panic("the test's file could not be opened");
	attempt(appender.try_lock(.Exclusive));
	attempt(owner.try_lock(.Shared));
	fmt.println(succeeded(appender.close()));
	write_only := fs.append(data) or_else panic("the test's file could not be opened");
	attempt(write_only.try_lock(.Shared));
	fmt.println(succeeded(write_only.close()));

	// A closed handle cannot lock, and has nothing to unlock.
	fmt.println(succeeded(other.close()));
	report(other.lock(.Shared));
	attempt(other.try_lock(.Shared));
	report(other.unlock());

	// A `lock` kept waiting returns once the holder releases, holding the lock.
	// The child says it is waiting only after it has seen the exclusive lock
	// keep it out, so the release comes after that; the pause makes it all but
	// certain that the child is inside `lock` by then, and the answers are the
	// same either way. The child then says it has the lock and keeps it until
	// told, and the proof that it does is that another handle is kept out. A
	// child that never answers, or never hears back, stalls this program until
	// the harness's deadline ends both and fails the case.
	report(owner.lock(.Exclusive));
	{
		exe := os.executable_path() or_else panic("the test cannot find its own executable");
		blocked := process.spawn(process.Command{
			program = exe, arguments = []string_view{"waiter", data}, stdin = .Pipe, stdout = .Pipe,
		}) or_else panic("the waiting child could not start");
		signal: [1]u8 = {};
		fmt.println((blocked.stdout.read(&mut signal[:]) or_else 0) == 1 && signal[0] == u8('w'));
		time.sleep(50 * time.MILLISECOND);
		report(owner.unlock());
		fmt.println((blocked.stdout.read(&mut signal[:]) or_else 0) == 1 && signal[0] == u8('a'));
		rival := open_as(data, .Read);
		attempt(rival.try_lock(.Exclusive));
		fmt.println((blocked.stdin.write("k".bytes()) or_else 0) == 1);
		fmt.println(blocked.wait() or_else -1);
		// The child's lock ended with it.
		attempt(rival.try_lock(.Exclusive));
		report(rival.unlock());
	}

	fmt.println(succeeded(owner.close()));
	fmt.println(succeeded(fs.remove(data)));
	fmt.println(succeeded(fs.remove_directory(directory)));
}
