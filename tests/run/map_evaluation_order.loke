// design.md "Evaluation order": `key in m` evaluates the key before the map, a
// map literal evaluates each entry's key before its value, and a multiple
// assignment prepares every destination before inserting any key, at compile
// time as at run time.
package main;
import "core:fmt";

key :: proc() -> string { fmt.println("key"); return "a"; }
table :: proc() -> map[string]int {
	fmt.println("table");
	return map[string]int{"a" = 7};
}

bump :: proc(n: inout int) -> int { n += 1; return n; }
keyed :: proc() -> int {
	n := 0;
	m := map[int]int{bump(inout n) = bump(inout n)};
	return (m.lookup_value(1) or_else 0) * 10 + (m.lookup_value(2) or_else 0);
}
KEYED :: keyed();

Pair :: struct { a, b: int }
grown :: proc() -> int {
	m: map[int]int = {};
	m[1], m[2] = 10, 20;
	m[3], m[4] = Pair{30, 40};
	return m[1] * 1000000 + m[2] * 10000 + m[3] * 100 + m[4];
}
GROWN :: grown();

main :: proc() {
	fmt.println(key() in table());
	fmt.println(KEYED, keyed());
	fmt.println(GROWN, grown());
}
