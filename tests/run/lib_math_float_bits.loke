package main;

import "core:fmt";
import "core:math";

// `math.to_bits` and `math.from_bits` (standard-library "`core:math`"), and the
// promise they rest on (design.md "Floating-point operators"): moving a float
// keeps its encoding.

// Through a value parameter and a return, the moves the promise names.
Holder :: struct($F: type) { value: F }

passed :: proc(value: $F) -> F {
	held := Holder(F){value};
	copied := held;
	return copied.value;
}

round_trips :: proc(bits: $B) -> bool {
	value := math.from_bits(bits);
	return math.to_bits(passed(value)) == bits;
}

ALL_F16 :: [?]u16{
	0x0000, 0x8000, 0x3C00, 0x0001, 0x03FF, 0x0400, 0x7BFF, 0x7C00, 0xFC00,
	0x7E00, 0xFE00, 0x7D01, 0xFD01, 0x7FFF, 0xFFFF,
};

ALL_F32 :: [?]u32{
	0x00000000, 0x80000000, 0x3F800000, 0x00000001, 0x007FFFFF, 0x00800000,
	0x7F7FFFFF, 0x7F800000, 0xFF800000, 0x7FC00000, 0xFFC00000, 0x7FA00001,
	0xFFA00001, 0x7F800001, 0x7FFFFFFF, 0xFFFFFFFF,
};

ALL_F64 :: [?]u64{
	0x0000000000000000, 0x8000000000000000, 0x3FF0000000000000,
	0x0000000000000001, 0x000FFFFFFFFFFFFF, 0x0010000000000000,
	0x7FEFFFFFFFFFFFFF, 0x7FF0000000000000, 0xFFF0000000000000,
	0x7FF8000000000000, 0xFFF8000000000000, 0x7FF4000000000001,
	0xFFF4000000000001, 0x7FF0000000000001, 0x7FFFFFFFFFFFFFFF,
	0xFFFFFFFFFFFFFFFF,
};

// A constant argument gives a constant.
ONE_BITS :: math.to_bits(f32(1.0));
ONE      :: math.from_bits(u64(0x3FF0000000000000));
static_assert(ONE_BITS == 0x3F800000);
static_assert(ONE == 1.0);

main :: proc() {
	// Known encodings, in both directions.
	fmt.println(math.to_bits(f16(1.0)) == u16(0x3C00));
	fmt.println(math.to_bits(f32(1.0)) == u32(0x3F800000));
	fmt.println(math.to_bits(f64(1.0)) == u64(0x3FF0000000000000));
	fmt.println(math.to_bits(f32(-2.5)) == u32(0xC0200000));
	fmt.println(math.to_bits(f64(-0.0)) == u64(0x8000000000000000));
	fmt.println(math.from_bits(u16(0x4000)), math.from_bits(u32(0x40400000)), math.from_bits(u64(0x4010000000000000)));

	// Every class, signalling NaNs among them, survives each width.
	failures := 0;
	foreach (bits in ALL_F16) { if (!round_trips(bits)) { failures += 1; } }
	foreach (bits in ALL_F32) { if (!round_trips(bits)) { failures += 1; } }
	foreach (bits in ALL_F64) { if (!round_trips(bits)) { failures += 1; } }
	fmt.println("failures", failures);

	// A signalling NaN is a NaN to the rest of the library.
	fmt.println(math.is_nan_f32(math.from_bits(u32(0x7FA00001))), math.is_nan(math.from_bits(u64(0x7FF4000000000001))));

	// Agreement with the constants `core:math` writes through `unsafe`.
	fmt.println(math.to_bits(math.F32_INFINITY) == u32(0x7F800000), math.to_bits(math.F64_MAX) == u64(0x7FEFFFFFFFFFFFFF));
}
