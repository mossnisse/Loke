package main;

import "core:fmt";

// design.md "Sorting slices": a sort uses the element's own `<` when it has
// one, and design.md "Compile-time procedure evaluation" runs that `<` during
// compilation, so each constant equals its runtime result.

Reverse :: distinct int;
impl Reverse {
	less :: operator(<) proc(a, b: Reverse) -> bool { return int(b) < int(a); }
}

// Ordered by `rank` alone, so a stable sort keeps equal ranks in input order.
Card :: struct {
	rank: int,
	tag: int,
}
impl Card {
	less :: operator(<) proc(a, b: Card) -> bool { return a.rank < b.rank; }
}

ordered :: proc() -> [4]Reverse {
	values := [4]Reverse{1, 3, 2, 4};
	view := &mut values[:];
	view.sort();
	return values;
}

reverse_ordered :: proc() -> [4]Reverse {
	values := [4]Reverse{1, 3, 2, 4};
	view := &mut values[:];
	view.reverse_sort();
	return values;
}

dynamic_ordered :: proc() -> [4]Reverse {
	values: [dynamic]Reverse = {};
	values.append(2, 4, 1, 3);
	values.sort();
	return [4]Reverse{values[0], values[1], values[2], values[3]};
}

// Each card read back as rank * 10 + tag.
dealt :: proc(descending: bool) -> [5]int {
	cards := [5]Card{{2, 0}, {1, 1}, {2, 2}, {1, 3}, {3, 4}};
	view := &mut cards[:];
	if (descending) {
		view.reverse_sort();
	} else {
		view.sort();
	}
	out: [5]int = {};
	foreach (card, index in cards.indexed()) {
		out[index] = card.rank * 10 + card.tag;
	}
	return out;
}

ORDERED :: ordered();
REVERSE_ORDERED :: reverse_ordered();
DYNAMIC_ORDERED :: dynamic_ordered();
DEALT :: dealt(false);
DEALT_DESCENDING :: dealt(true);

main :: proc() {
	fmt.println(ORDERED, ORDERED == ordered());
	fmt.println(REVERSE_ORDERED, REVERSE_ORDERED == reverse_ordered());
	fmt.println(DYNAMIC_ORDERED, DYNAMIC_ORDERED == dynamic_ordered());
	fmt.println(DEALT, DEALT == dealt(false));
	fmt.println(DEALT_DESCENDING, DEALT_DESCENDING == dealt(true));
}
