package main; import "core:fmt";

// open-questions.md "Compiler architecture audit (2026-09-28)" (A1):
// Literals past the constant budget are built at run time with zeroed omitted fields.
Record :: struct { bytes: [900000]u8, tag: int }

main :: proc() {
	r := new(Record);
	r^ = Record{tag = 4};
	fmt.println(r.tag, r.bytes[0], r.bytes[899999]);
	free(r);
}
