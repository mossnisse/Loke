package main; import "core:fmt";

// A literal past the constant budget is built at run time with zeroed
// omitted fields (comments.md A1).
Record :: struct { bytes: [900000]u8, tag: int }

main :: proc() {
	r := new(Record);
	r^ = Record{tag = 4};
	fmt.println(r.tag, r.bytes[0], r.bytes[899999]);
	free(r);
}
