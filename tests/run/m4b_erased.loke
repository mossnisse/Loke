package main; import "core:fmt";
import "core:sync";

Canvas :: struct { marks: int }

Drawable :: interface($Self: type) {
	slot draw: proc(self, canvas: inout Canvas) ;
	slot size: proc(self) -> int;
}

Tagged :: interface($Self: type, $Tag: type) {
	slot tag: proc(self) -> int;
}

Valued :: interface($Self: type, $Value: type) {
	slot value: proc(self) -> Value;
}

Int_Valued :: interface($Self: type) {
	Valued(Self, int);
}

Bumpable :: interface($Self: type) {
	slot bump: proc(self: inout Self) ;
	// A slot whose result is `inout`: the witness returns a pointer, so a call
	// through the view has to be typed and lowered as the place it is.
	slot cell: proc(self: inout Self) -> inout int;
}

Circle :: struct { radius: int }
Square :: struct { side: int }

impl Circle {
	draw :: proc(self, canvas: inout Canvas) { canvas.marks += self.radius; }
	size :: proc(self) -> int { return self.radius; }
}

impl Square {
	draw :: proc(self, canvas: inout Canvas) { canvas.marks += self.side * 4; }
	size :: proc(self) -> int { return self.side; }
}

Token :: struct { number: int }
impl Token {
	tag :: proc(self) -> int { return self.number; }
	value :: proc(self) -> int { return self.number; }
}

Counter :: struct { value: int }
impl Counter {
	bump :: proc(self: inout Counter) { self.value += 1; }
	cell :: proc(self: inout Counter) -> inout int { return inout self.value; }
}

describe :: proc(value: any_view) -> int {
	switch (value) {
	case int(v):
		return v;
	case bool(v):
		if (v) { return 1; }
		return 0;
	case Circle(v):
		return v.radius;
	case:
		return -1;
	}
}

paint :: proc(target: dyn Drawable, canvas: inout Canvas) -> int {
	target.draw(inout canvas);
	return target.size();
}

main :: proc() {
	owned_extraction();
	fmt.println(describe(7));
	fmt.println(describe(true));
	fmt.println(describe(Circle{5}));
	fmt.println(describe(1.5));

	// A temporary converted for a call stays valid through the call.
	view: any_view = 42;
	fmt.println(view.as(int) or_else -1);
	fmt.println(view.(int));

	c := Circle{3};
	s := Square{2};
	canvas: Canvas = {0};
	fmt.println(paint((dyn Drawable)(&c), inout canvas));
	fmt.println(paint((dyn Drawable)(&s), inout canvas));
	fmt.println(canvas.marks);
	more();
}

// design.md: `dyn I` itself satisfies `I` by compiler-provided forwarding slots,
// which is the bridge between static and runtime polymorphism.
paint_static :: proc(value: $T, canvas: inout Canvas) -> int where Drawable(T) {
	value.draw(inout canvas);
	return value.size();
}

more :: proc() {
	c := Circle{4};
	canvas: Canvas = {0};
	// A concrete type: a specialized direct call.
	fmt.println(paint_static(c, inout canvas));
	// A `dyn` value: witness dispatch through the forwarding slots.
	view := (dyn Drawable)(&c);
	fmt.println(paint_static(view, inout canvas));
	fmt.println(canvas.marks);

	copied := view;
	fmt.println(copied.size());

	// Distinct non-subject applications get distinct witness globals.
	token := Token{9};
	fmt.println(((dyn Tagged(int))(&token)).tag());
	fmt.println(((dyn Tagged(bool))(&token)).tag());
	// Composed applications substitute their written argument vector.
	fmt.println(((dyn Int_Valued)(&token)).value());

	// An inout dyn slot works directly and when `dyn I` itself is erased as I,
	// which exercises the compiler-provided forwarding procedure's pointer ABI.
	counter := Counter{0};
	mutable := (dyn mut Bumpable)(&mut counter);
	mutable.bump();
	mutable.cell() = 40;
	nested := (dyn mut Bumpable)(&mut mutable);
	nested.bump();
	nested.cell() += 2;
	fmt.println(nested.cell());
	fmt.println(counter.value);
}

erased_drops: int;
erased_copies: sync.Atomic(int);
Owned :: struct { id: int }
impl Owned {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Owned, Allocator_Error) {
		erased_copies.add(1);
		return .ok(Owned{self.id + 100});
	}
	release :: hook(drop) proc(self: inout Owned) { if (self.id != 0) { erased_drops += 1; } }
}

owned_extraction :: proc() {
	{
		source := Owned{1};
		view: any_view = source;
		{
			switch (view.as(Owned)) {
			case .some(held): assert(held.id == 101 && source.id == 1 && erased_copies.load() == 1);
			case .none: assert(false);
			}
		}
		assert(erased_drops == 1);
		{
			switch (view.as(Owned)) {
			case .some:
			case .none: assert(false);
			}
		}
		assert(erased_copies.load() == 2 && erased_drops == 2);
		{
			held := view.(Owned);
			assert(held.id == 101 && erased_copies.load() == 3);
		}
		assert(erased_drops == 3);
		view.as(Owned);
		assert(erased_copies.load() == 4 && erased_drops == 4);
		other: any_view = 42;
		switch (other.as(Owned)) {
		case .some: assert(false);
		case .none: assert(erased_copies.load() == 4);
		}
	}
	assert(erased_drops == 5);
}
