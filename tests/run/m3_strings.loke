package main; import "core:fmt";

// Untyped compile-time strings: joined, compared, and measured, but never
// stored in a runtime binding (m3-plan decision "Strings").
GREETING :: "hello";
NAME :: "loke";
FULL :: GREETING + ", " + NAME;
FROZEN :: joined();
joined :: proc() -> string {
	text := "hello";
	text = text + ", loke";
	return text;
}
ESCAPED :: "tab:\there\x21\n";

// Configuration is project-wide and immutable, and a default fixes both the
// result's type and what an override may say.
MODE :: build_config(MODE, "debug");
LIMIT :: build_config(LIMIT, 10);
VERBOSE :: build_config(VERBOSE, false);

main :: proc() {
	static_assert(FROZEN == FULL);
	assert(FROZEN == FULL);
	static_assert(len(FULL) == 11, "the greeting changed shape");
	static_assert(FULL == "hello, loke");
	static_assert(GREETING < NAME);
	static_assert(len(ESCAPED) == 11);

	fmt.println(len(FULL));
	fmt.println(len(ESCAPED));
	fmt.println(LIMIT);
	fmt.println(1 if VERBOSE else 0);
	fmt.println(len(MODE));
}
