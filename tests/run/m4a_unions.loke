package main; import "core:fmt";

// design.md "Unions": named variants, variant identity, and the typed failure
// protocol built on them.

Value :: union { flag: bool, count: i32, ratio: f64 }
Error_Code :: enum { Something_Bad, Something_Worse }

// Two variants carrying the same payload type. This is the proof that a
// variant's identity is its declaration index and never its payload `Type_Id`.
Pair_Of_Ints :: union { left: int, right: int }

// A payloadless variant, and a designated zero so the union has one.
Maybe_Int :: union @(zero=absent) { absent:, present: int }

// A user's own failure protocol: `or_else`/`or_return` recognise the shape, not
// the name `Result`.
Parsed :: union @(failure=bad) { good: int, bad: Error_Code }

// The natural layout, and the same variants under a written alignment.
Narrow :: union { flag: bool, small: i16 }
Wide_Aligned :: union @(align=8) { flag: bool, small: i16 }
Holder :: struct { flag: bool, value: Wide_Aligned }

caller_1 :: proc() -> Result(Unit, Error_Code) { return .ok(Unit{}); }
caller_2 :: proc() -> Result(int, Error_Code) { return .ok(123); }
failing :: proc() -> Result(int, Error_Code) { return .err(.Something_Bad); }

good :: proc() -> Result(int, Error_Code) {
	defer fmt.println(900);
	x := caller_2() or_return;
	caller_1() or_return;
	return .ok(x + 1);
}

bad :: proc() -> Result(int, Error_Code) {
	defer fmt.println(901);
	x := failing() or_return;
	return .ok(x + 1000);
}

// An `or_else` operand whose failure variant is a user's own.
fetch :: proc(fail: bool) -> Parsed {
	if (fail) { return .bad(.Something_Worse); }
	return .good(8);
}

// An ordinary member named `as`, which nothing built-in shadows on a struct.
Counter :: struct { n: int }
impl Counter {
	as :: proc(self, step: int) -> int { return self.n + step; }
}
Pair :: struct { first: Counter }
fresh_counter :: proc() -> Counter { return Counter{1}; }

Boxed :: struct { value: Value }
carry :: proc(v: Value) -> Boxed { return Boxed{v}; }
unions :: proc() -> [1]Value {
	out: [1]Value;
	out[0] = .count(2);
	return out;
}
same :: proc(v: Value) -> Value { return v; }

branch_result :: proc(flag: bool) -> Result(int, Error_Code) {
	n := 10 if flag else 20;
	caller_1() or_return;
	return .ok(n);
}

describe :: proc(v: Value) -> int {
	switch (t in v) {
	case .count:
		return int(t) + 100;
	case .flag, .ratio:
		// A grouped case cannot know which variant is active, so the binding
		// keeps the union type.
		return 200 if t == v else 201;
	}
	return -1;
}

// Which side of `Pair_Of_Ints` is active, which no payload type could answer.
side :: proc(p: Pair_Of_Ints) -> int {
	switch (n in p) {
	case .left:  return n;
	case .right: return -n;
	}
	return 0;
}

main :: proc() {
	// A union always holds a variant; the designated zero is the first one.
	m: Maybe_Int;
	fmt.println(m);
	fmt.println(Maybe_Int.present(5));

	// Every variant round-trips through construction and matching.
	v: Value = .count(7);
	fmt.println(describe(v));
	v = .flag(true);
	fmt.println(describe(v));
	v = .ratio(2.5);
	fmt.println(describe(v));
	fmt.println(v);

	// Variant identity, not payload identity.
	fmt.println(side(Pair_Of_Ints.left(3)));
	fmt.println(side(Pair_Of_Ints.right(3)));
	fmt.println(1 if Pair_Of_Ints.left(3) == Pair_Of_Ints.left(3) else 0);
	fmt.println(1 if Pair_Of_Ints.left(3) == Pair_Of_Ints.right(3) else 0);

	// Equality dispatches on the tag and then on the active payload.
	a: Value = .count(7);
	b: Value = .count(7);
	c: Value = .flag(true);
	fmt.println(1 if a == b else 0);
	fmt.println(1 if a == c else 0);
	fmt.println(1 if a != c else 0);

	// A declared member named `as` wins on every non-union receiver.
	c1 := Counter{10};
	pair := Pair{Counter{20}};
	row := [?]Counter{Counter{30}};
	fmt.println(c1.as(1));
	fmt.println(fresh_counter().as(1));
	fmt.println(pair.first.as(1));
	fmt.println(row[0].as(1));
	fmt.println(carry(a).value);
	fmt.println(unions()[0]);
	fmt.println(same(a));

	// The failure protocol.
	fmt.println(good());
	fmt.println(bad());
	fmt.println(branch_result(false));

	// `or_else` supplies a fallback and evaluates it only on the failure variant.
	fmt.println(fetch(false) or_else -1);
	fmt.println(fetch(true) or_else -1);
	fmt.println(good() or_else -1);
	fmt.println(bad() or_else -1);

	// `@(align=N)` raises the payload's alignment; `tests/layout` confirms the
	// checker and LLVM agree, and the values themselves belong here.
	fmt.println(size_of(Narrow));
	fmt.println(align_of(Narrow));
	fmt.println(size_of(Wide_Aligned));
	fmt.println(align_of(Wide_Aligned));
	fmt.println(size_of(Holder));
	fmt.println(offset_of(Holder, value));
}
