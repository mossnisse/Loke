package main; import "core:fmt";

// design.md "switch statement": `default:` is the default arm; `case:` is the same.
Direction :: enum { North, East, South, West }
Setting :: union { number: int, flag: bool, off }

name :: proc(d: Direction) -> string {
	switch (d) {
	case .North: return "up";
	default:     return "elsewhere";
	}
}

main :: proc() {
	foreach (n in 0 ..< 3) {
		switch (n) {
		case 0:  fmt.println("zero");
		default: fmt.println("other", n);
		}
	}
	fmt.println(name(.North), name(.West));

	s: Setting = .flag(true);
	switch (s) {
	case .number(n): fmt.println(n);
	default:         fmt.println("not a number");
	}
	switch (s) {
	case .off: fmt.println("off");
	default:   fmt.println("on", s);
	}

	switch (Setting.off) {
	case .number(v): fmt.println("number", v);
	default:         fmt.println("something else");
	}
}
