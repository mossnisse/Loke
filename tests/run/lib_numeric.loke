package main;

import "core:fmt";
import "core:math";

// `Complex(T)` and `Quaternion(T)` (design.md "Library numeric
// types").
//
// The first block is a hand-written `Complex_F64`, proving that the library
// type needs no facility a user could not write; the rest is the generic version
// of the same thing in `core:math`.

Complex_F64 :: struct {
	real, imaginary: f64,
}

impl Complex_F64 {
	from_components :: proc(real: f64, imaginary: f64 = 0) -> Complex_F64 {
		return {real, imaginary};
	}

	add :: operator(+) proc(left, right: Complex_F64) -> Complex_F64 {
		return {left.real + right.real, left.imaginary + right.imaginary};
	}

	multiply :: operator(*) proc(left, right: Complex_F64) -> Complex_F64 {
		return {
			left.real*right.real - left.imaginary*right.imaginary,
			left.real*right.imaginary + left.imaginary*right.real,
		};
	}

	from_scalar :: hook(convert) proc(value: f64) -> Complex_F64 {
		return {value, 0};
	}
}

C :: math.Complex(f64);
Q :: math.Quaternion(f64);

main :: proc() {
	// design.md's example.
	z := Complex_F64.from_components(1, 2);
	w := z*z + Complex_F64(2.0);  // the written conversion reaches `from_scalar`
	fmt.println(z.real, z.imaginary);
	fmt.println(w.real, w.imaginary);

	// The same arithmetic through the library's generic type.
	g := C.from_components(1, 2);
	h := g*g + C(2.0);
	fmt.println(g, h);
	fmt.println(g + g, g - g, -g);
	fmt.println(g/g);
	fmt.println(g == C.from_components(1, 2), g == h);
	fmt.println(g.conjugate(), g.norm_squared());

	// Every scalar needs the written conversion, constant or not.
	scale := 3.0;
	fmt.println(C(scale));

	// `T` is free: the same source over `f32`.
	small := math.Complex(f32).from_components(0.5, -0.25);
	fmt.println(small, small.norm_squared());

	// Quaternions do not commute, which is the whole reason they are not a pair
	// of complex numbers.
	i := Q.from_components(0, 1, 0, 0);
	j := Q.from_components(0, 0, 1, 0);
	k := Q.from_components(0, 0, 0, 1);
	fmt.println(i*j, j*i);
	fmt.println(i*j == k, j*i == -k);
	fmt.println(i*i, j*j, k*k);
	fmt.println(i*j*k);
	// The `-0` components below are the point: negating or conjugating a `+0.0`
	// gives `-0.0`, which is why neither is written `T(0) - x`.
	fmt.println(i + j, i - j, -i);
	fmt.println(i.conjugate(), i.norm_squared());
	fmt.println(Q.from_components(1, 2, 3, 4).norm_squared());
	fmt.println(i + Q(1.0));

	// ---- the floating specializations (design.md "Library numeric types") ----
	//
	// `abs`, `inverse`, and a `divide` that does not form `c*c + d*d` exist only
	// for `Complex(f32)`/`Complex(f64)` and the two `Quaternion` instances; every
	// other `T` keeps the generic operator above and gains neither.
	floating();
}

CF :: math.Complex(f32);
QF :: math.Quaternion(f32);

// Never print a NaN: `%.17g` spells one three different ways on this platform
// depending on the payload.
nan_complex :: proc(z: C) -> bool {
	return math.is_nan(z.real) && math.is_nan(z.imaginary);
}

floating :: proc() {
	// Ordinary values, both widths.
	fmt.println(C{real = 3.0, imaginary = 4.0}.abs(), CF{real = f32(3.0), imaginary = f32(4.0)}.abs());
	fmt.println(C{real = 3.0, imaginary = 4.0}.inverse(), C{real = 3.0, imaginary = 4.0}*C{real = 3.0, imaginary = 4.0}.inverse());
	fmt.println(C{real = 6.0, imaginary = 4.0}/C{real = 2.0, imaginary = 0.0}, C{real = 0.0, imaginary = 1.0}/C{real = 0.0, imaginary = 1.0});
	fmt.println(CF{real = f32(6.0), imaginary = f32(4.0)}/CF{real = f32(2.0), imaginary = f32(0.0)});

	// The regression the Smith rewrite claims: a denominator whose component
	// squares overflow but whose quotient is perfectly finite. The textbook form
	// forms `2e400`, gets `+infinity`, and answers `0+0i`.
	huge := C{real = 1.0e200, imaginary = 1.0e200};
	fmt.println(C{real = 1.0e200, imaginary = 0.0}/huge, huge/huge);
	fmt.println(huge.abs() > 1.0e200, math.is_infinite(huge.norm_squared()));
	maximum := C{real = math.F64_MAX, imaginary = math.F64_MAX}/C{real = math.F64_MAX, imaginary = math.F64_MAX};
	maximum_f32 := CF{real = math.F32_MAX, imaginary = math.F32_MAX}/CF{real = math.F32_MAX, imaginary = math.F32_MAX};
	fmt.println(maximum.real == 1.0, maximum.imaginary == 0.0,
	            maximum_f32.real == f32(1.0), maximum_f32.imaginary == f32(0.0));
	mixed := C{real = math.F64_MAX, imaginary = math.F64_MAX}/C{real = math.F64_MIN_SUBNORMAL, imaginary = math.F64_MIN_SUBNORMAL};
	mixed_f32 := CF{real = math.F32_MAX, imaginary = math.F32_MAX}/CF{real = math.F32_MIN_SUBNORMAL, imaginary = math.F32_MIN_SUBNORMAL};
	fmt.println(math.is_infinite(mixed.real), mixed.imaginary == 0.0,
	            math.is_infinite_f32(mixed_f32.real), mixed_f32.imaginary == f32(0.0));

	// The same at the other end of the range: subnormal components, where the
	// squares underflow to zero and the textbook form divides by zero.
	tiny := C{real = math.F64_MIN_SUBNORMAL, imaginary = math.F64_MIN_SUBNORMAL};
	fmt.println(tiny/tiny, tiny.norm_squared());

	// Zero, infinity, and NaN. A zero denominator divides by zero, which is the
	// ordinary scalar rule rather than a trap.
	fmt.println(C{real = 0.0, imaginary = 0.0}.abs(), C{real = math.F64_INFINITY, imaginary = 1.0}.abs());
	fmt.println(C{real = math.F64_NAN, imaginary = math.F64_INFINITY}.abs());
	fmt.println(math.is_nan(C{real = math.F64_NAN, imaginary = 0.0}.abs()));
	fmt.println(nan_complex(C{real = 1.0, imaginary = 1.0}/C{real = 0.0, imaginary = 0.0}));

	// `Quaternion.abs` is the nested `hypot`, so it survives the same overflow.
	fmt.println(Q{real = 1.0, i = 2.0, j = 2.0, k = 4.0}.abs(), QF{real = f32(1.0), i = f32(2.0), j = f32(2.0), k = f32(4.0)}.abs());
	fmt.println(Q{real = 1.0, i = 2.0, j = 2.0, k = 4.0}.inverse());
	fmt.println(Q{real = 1.0e200, i = 2.0e200, j = 2.0e200, k = 4.0e200}.abs() > 1.0e200);
	big := Q{real = 1.0e200, i = 2.0e200, j = 2.0e200, k = 4.0e200};
	fmt.println(big*big.inverse());
	maximum_q := Q{real = math.F64_MAX, i = math.F64_MAX, j = math.F64_MAX, k = math.F64_MAX}.inverse();
	maximum_qf := QF{real = math.F32_MAX, i = math.F32_MAX, j = math.F32_MAX, k = math.F32_MAX}.inverse();
	fmt.println(maximum_q.real > 0.0, maximum_q.i < 0.0,
	            maximum_q.j < 0.0, maximum_q.k < 0.0);
	fmt.println(maximum_qf.real > f32(0.0), maximum_qf.i < f32(0.0),
	            maximum_qf.j < f32(0.0), maximum_qf.k < f32(0.0));

	// Quaternion multiplication does not commute, so `inverse` is the operation
	// and there is deliberately no `/`: the caller writes which side.
	q := Q{real = 1.0, i = 2.0, j = 3.0, k = 4.0};
	fmt.println(q*q.inverse(), q.inverse()*q);

	// A zero quaternion divides zero by zero in every component.
	zero := Q{real = 0.0, i = 0.0, j = 0.0, k = 0.0}.inverse();
	fmt.println(math.is_nan(zero.real), math.is_nan(zero.i),
	            math.is_nan(zero.j), math.is_nan(zero.k));

	// Negation is unary minus, not `0 - x`: the second maps `+0.0` to `+0.0`
	// and so loses the sign of a zero that `negate` and `conjugate` are supposed
	// to flip. `sign_bit` is the only way to see it -- `+0.0 == -0.0`.
	positive := C{real = 0.0, imaginary = 0.0};
	negated := -positive;
	fmt.println(math.sign_bit(negated.real), math.sign_bit(negated.imaginary),
	            math.sign_bit(positive.conjugate().imaginary));
	negated_q := -Q{real = 0.0, i = 0.0, j = 0.0, k = 0.0};
	conjugated_q := Q{real = 0.0, i = 0.0, j = 0.0, k = 0.0}.conjugate();
	fmt.println(math.sign_bit(negated_q.real), math.sign_bit(negated_q.k),
	            math.sign_bit(conjugated_q.i), math.sign_bit(conjugated_q.k));
	// Unsigned wraps exactly as `T(0) - x` did, which is what made the change safe.
	fmt.println(-math.Complex(u32){real = 1, imaginary = 2});

	// A formatter is handed `options` so it can spell its components the way it
	// was asked to. An integer instantiation is where a base is observable.
	fmt.format_to_with(fmt.stdout(), fmt.Options{base = 16, uppercase = true}, math.Complex(i32){real = 255, imaginary = 16});
	fmt.println("");
	fmt.format_to_with(fmt.stdout(), fmt.Options{base = 16, uppercase = true}, math.Quaternion(i32){real = 255, i = 16, j = 10, k = 1});
	fmt.println("");

	// A negative component brings its own `-`, at every width and for signed
	// integers; a NaN prints as `nan` whatever its sign, so it keeps the `+`.
	fmt.println(math.Complex(f32){real = 1, imaginary = -2}, math.Complex(i8){real = -1, imaginary = -2}, math.Complex(u8){real = 1, imaginary = 2});
	fmt.println(math.Complex(f64){real = 1, imaginary = -math.F64_NAN}, math.Complex(f64){real = 1, imaginary = -0.0});
}
