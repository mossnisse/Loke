// design.md "Maps": a `distinct` type that declares neither `==` nor `hash` keys a
// map as its underlying type does, by that type's own pair when it declares one,
// as a key and as a part, at run time and in compile-time evaluation alike.
package main;
import "core:fmt";
import "base:interfaces";

Tens :: struct { v: int }
impl Tens {
	same :: operator(==) proc(a, b: Tens) -> bool { return a.v / 10 == b.v / 10; }
	hash :: proc(self, seed: uint) -> uint { return seed ~ uint(self.v / 10); }
}
Wrapped :: distinct Tens;
Holder :: struct { w: Wrapped }

// A large value is passed by address, and `==` may be in a group.
Large :: struct { a, b, c, d, e: int }
impl Large {
	same_large :: proc(a, b: Large) -> bool { return a.a == b.a; }
	same_large_int :: proc(a: Large, b: int) -> bool { return a.a == b; }
	equal :: operator(==) proc { same_large, same_large_int };
	hash :: proc(self, seed: uint) -> uint { return seed ~ uint(self.a); }
}
Wrapped_Large :: distinct Large;

// A delegated `==` keeps the underlying type's policy.
Delegated :: distinct Tens;
impl Delegated { delegate(==); }

Mode :: enum { A, B, C }
impl Mode {
	same :: operator(==) proc(a, b: Mode) -> bool { return true; }
	hash :: proc(self, seed: uint) -> uint { return seed; }
}
Wrapped_Mode :: distinct Mode;

FOLDED :: Wrapped{11}.hash(uint(7));

count_wrapped :: proc() -> int {
	m: map[Wrapped]int = {};
	m[Wrapped{11}] = 1;
	m[Wrapped{12}] = 2;
	return m.len() * 10 + m[Wrapped{13}];
}
COUNTED :: count_wrapped();

keys :: proc(m: map[$K]int) -> int where interfaces.Hashable(K) { return m.len(); }

main :: proc() {
	wrapped: map[Wrapped]int = {};
	wrapped[Wrapped{11}] = 1;
	wrapped[Wrapped{12}] = 2;
	fmt.println(wrapped.len(), wrapped[Wrapped{13}], keys(wrapped));

	holders: map[Holder]int = {};
	holders[Holder{Wrapped{21}}] = 3;
	holders[Holder{Wrapped{22}}] = 4;
	fmt.println(holders.len(), holders[Holder{Wrapped{23}}]);

	large: map[Wrapped_Large]int = {};
	large[Wrapped_Large{1, 2, 3, 4, 5}] = 5;
	large[Wrapped_Large{1, 9, 9, 9, 9}] = 6;
	fmt.println(large.len(), large[Wrapped_Large{1, 0, 0, 0, 0}]);

	delegated: map[Delegated]int = {};
	delegated[Delegated{31}] = 7;
	delegated[Delegated{32}] = 8;
	fmt.println(delegated.len(), delegated[Delegated{33}]);

	modes: map[Wrapped_Mode]int = {};
	modes[Wrapped_Mode.A] = 9;
	modes[Wrapped_Mode.C] = 10;
	fmt.println(modes.len());

	fmt.println(Wrapped{11}.hash(uint(7)) == Tens{11}.hash(uint(7)), FOLDED == Wrapped{19}.hash(uint(7)), COUNTED);
	fmt.println(interfaces.Hashable(Wrapped), interfaces.Hashable(Wrapped_Large), interfaces.Hashable([2]Wrapped));
}
