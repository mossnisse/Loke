// design.md "Allocator regions and region provenance": an allocator handle is
// not an owner, a call leaves owners only at the fields it writes, a
// container's backing allocation does not back its elements, a field copied
// from another field of the same argument takes only that field's regions,
// and `exchange` keeps the previous value's own allocator.
package main;

import "core:fmt";
import "core:mem";

State :: struct { local, stable: string }

fill :: proc(state: inout State, allocator: Allocator) {
	state.local = fmt.to_string(allocator, 42);
}

Backed :: struct { items: [dynamic]string, table: map[int]string, boxed: Box(string) }

fill_backed :: proc(backed: inout Backed, allocator: Allocator) {
	backed.items = make([dynamic]string, 1, allocator);
	backed.items[0] = "element";
	backed.table = make(map[int]string, allocator);
	backed.table[1] = "value";
	backed.boxed = box("payload", allocator);
}

Handled :: struct { allocator: Allocator, source, destination, third: string }

copy_handled :: proc(handled: inout Handled) {
	handled.destination = handled.source;
	handled.third = handled.destination;
}

forward_handled :: proc(handled: inout Handled) {
	copy_handled(inout handled);
}

copy_handled_through :: proc(handled: ^mut Handled) {
	handled^.destination = handled^.source;
}

fill_through :: proc(state: ^mut State, allocator: Allocator) {
	state^.local = fmt.to_string(allocator, 7);
}

// A handle written through a pointer keeps its region without owning storage.
handle_through_pointer :: proc() -> bool {
	arena := mem.Arena.init();
	handle: Allocator = {};
	pointer := &mut handle;
	pointer^ = arena.allocator();
	text := fmt.to_string(handle, 1);
	return text == "1";
}

// `fill` writes only `local`, so `stable` keeps its static region.
stable_field :: proc() -> string {
	arena := mem.Arena.init();
	state := State{"", "stable"};
	fill(inout state, arena.allocator());
	fmt.println(state.local);
	return state.stable;
}

stable_field_through :: proc() -> string {
	arena := mem.Arena.init();
	state := State{"", "through"};
	fill_through(&mut state, arena.allocator());
	fmt.println(state.local);
	return state.stable;
}

// `fill_backed` allocates each container in the arena but stores static
// strings in them, so what they hold outlives the arena.
stable_contents :: proc() -> [3]string {
	arena := mem.Arena.init();
	backed := Backed{make([dynamic]string), {}, box("")};
	fill_backed(inout backed, arena.allocator());
	return {backed.items[0], backed.table[1], backed.boxed^};
}

// The copied fields hold static strings; the arena handle beside them backs
// neither, directly, through a forwarding call, or through a pointer.
copied_beside_handle :: proc() -> string {
	arena := mem.Arena.init();
	handled := Handled{arena.allocator(), "copied", "", ""};
	forward_handled(inout handled);
	return handled.third;
}

copied_through_pointer :: proc() -> string {
	arena := mem.Arena.init();
	handled := Handled{arena.allocator(), "pointed", "", ""};
	copy_handled_through(&mut handled);
	return handled.destination;
}

// The extracted array is default-backed, so ending an unrelated arena is fine.
exchanged_then_reset :: proc() -> int {
	items := make([dynamic]int, 2);
	taken := exchange(inout items, {});
	arena := mem.Arena.init();
	free_all(arena.allocator());
	return taken.len() + items.len();
}

main :: proc() {
	fmt.println(handle_through_pointer());
	fmt.println(stable_field());
	fmt.println(stable_field_through());
	fmt.println(exchanged_then_reset());
	fmt.println(copied_beside_handle());
	fmt.println(copied_through_pointer());
	contents := stable_contents();
	fmt.println(contents[0], contents[1], contents[2]);
}
