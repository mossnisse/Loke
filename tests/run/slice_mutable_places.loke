// design.md "Slices": `&mut a[lo:hi]` needs a mutable array place, however it is
// reached. The operand is checked as a place, so a map element and an `inout`
// `operator([])` give one, and a value overload yielding `[]mut T` still serves.
package main;

import "core:fmt";
import "core:unsafe";

Only_Inout :: struct { cells: [4]int }

impl Only_Inout {
	at :: operator([]) proc(self: inout Only_Inout, i: int) -> inout [4]int { return inout self.cells; }
}

Both :: struct { cells: [4]int }

impl Both {
	at :: operator([]) proc(self: Both, i: int) -> [4]int { return self.cells; }
	at_mut :: operator([]) proc(self: inout Both, i: int) -> inout [4]int { return inout self.cells; }
}

Carrier :: struct { backing: [2]int }

impl Carrier {
	at :: operator([]) proc(self: Carrier, i: int) -> []mut int { return {}; }
}

Holder :: struct { cells: [4]int }

main :: proc() {
	grid := [2][4]int{};
	c := ([^][4]int)(&grid[0]);
	from_c_pointer := &mut c[1][0:2];
	from_c_pointer[0] = 5;
	fmt.println(grid[1][0]);

	only := Only_Inout{};
	from_inout := &mut only[0][0:2];
	from_inout[1] = 6;
	fmt.println(only.cells[1]);

	both := Both{};
	from_both := &mut both[0][1:3];
	from_both[0] = 8;
	fmt.println(both.cells[1], both[0][1]);

	m := map[int][4]int{};
	m[1] = [4]int{1, 2, 3, 4};
	from_map := &mut m[1][0:2];
	from_map[0] = 9;
	fmt.println(m[1][0]);

	holders := map[int]Holder{};
	holders[1] = Holder{};
	from_field := &mut holders[1].cells[2:4];
	from_field[1] = 4;
	fmt.println(holders[1].cells[3]);

	carrier := Carrier{};
	from_value := &mut carrier[0][0:0];
	fmt.println(from_value.len());
}
