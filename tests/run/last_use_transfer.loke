package main;

import "core:fmt";
import "core:mem";

// design.md "Last-use transfer": a binding or assignment that would clone a
// local nothing reads again moves it instead. The hooks print, so the output
// shows which copies ran and when each value is dropped: a moved value drops
// with its destination, never twice.

Tracked :: struct { id: int }

impl Tracked {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked, Allocator_Error) {
		fmt.println("  copy", self.id);
		return .ok(Tracked{self.id + 100});
	}
	release :: hook(drop) proc(self: inout Tracked) { fmt.println("  drop", self.id); }
}

show :: proc(label: string, t: Tracked) { fmt.println(label, t.id); }

// A `move` parameter is owned, so its last use moves too.
take :: proc(t: move Tracked) -> Tracked {
	kept := t;
	return kept;
}

main :: proc() {
	fmt.println("binding");
	{
		a := Tracked{1};
		b := a;          // moved
		show("b", b);
	}
	fmt.println("assignment");
	{
		a := Tracked{2};
		b := Tracked{3};
		b = a;           // moved; the old `b` drops
		show("b", b);
	}
	fmt.println("read afterwards");
	{
		a := Tracked{4};
		b := a;          // copied
		show("a", a);
		show("b", b);
	}
	fmt.println("read on one path");
	{
		a := Tracked{5};
		b := a;          // copied: the branch may read `a`
		if (b.id > 0) {
			show("a", a);
		}
	}
	fmt.println("deferred read");
	{
		a := Tracked{6};
		defer show("a", a);
		b := a;          // copied: the deferred statement reads `a` later
		show("b", b);
	}
	fmt.println("loop over an outer local");
	{
		a := Tracked{7};
		foreach (_ in 0 ..< 2) {
			b := a;      // copied: the next iteration reads `a`
			show("b", b);
		}
	}
	fmt.println("loop-local source");
	{
		foreach (i in 0 ..< 2) {
			a := Tracked{8 + i};
			b := a;      // moved: each iteration has its own `a`
			show("b", b);
		}
	}
	fmt.println("iterated");
	{
		list := [dynamic]int{1};
		foreach (x in list) {
			copy := list;  // copied: the loop still iterates `list`
			fmt.println("  ", x, copy);
		}
	}
	fmt.println("viewed");
	{
		list := [dynamic]int{1};
		view := list[:];
		copy := list;    // copied: `view` may still be in use
		fmt.println("  ", view, copy);
	}
	fmt.println("via");
	{
		arena := mem.Arena.init(mem.default_allocator());
		list := [dynamic]int{1};
		copy: [dynamic]int via arena.allocator() = list; // copied into the arena
		fmt.println("  ", copy);
	}
	fmt.println("move parameter");
	{
		kept := take(Tracked{10});
		show("kept", kept);
	}
	fmt.println("end");
}
