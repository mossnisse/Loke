package main; import "core:fmt";

// Map insertion has two independent failure points: cloning the incoming value
// and cloning a new key while the table grows. Neither may replace an existing
// value or publish a rehash.
Huge :: struct { pad: [4611686018427387904]u8 }

Key :: struct { id: int }

impl Key {
	release :: hook(drop) proc(self: inout Key) { self.id = 0; }
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Key, Allocator_Error) {
		if (self.id == 99) {
			p := new(Huge, allocator) or_return;
			free(p);
		}
		return .ok(Key{self.id});
	}
	hash :: proc(self, seed: uint) -> uint { return self.id.hash(seed); }
	same :: operator(==) proc(x, y: Key) -> bool { return x.id == y.id; }
}

Value :: struct { id: int }

impl Value {
	release :: hook(drop) proc(self: inout Value) { self.id = 0; }
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Value, Allocator_Error) {
		if (self.id == 99) {
			p := new(Huge, allocator) or_return;
			free(p);
		}
		return .ok(Value{self.id});
	}
}

// `try_insert` answers with `Result(Unit, Allocator_Error)`; these tests only
// care which variant came back.
succeeded :: proc(outcome: Result(Unit, Allocator_Error)) -> bool {
	switch (_ in outcome) {
	case .ok:  return true;
	case .err: return false;
	}
	return false;
}

main :: proc() {
	m: map[Key]Value = {};
	for (i := 0; i < 7; i += 1) {
		fmt.println(succeeded(m.try_insert(Key{i}, Value{i + 10})));
	}
	before := m.cap();

	// The eighth key needs growth. Its clone fails, so even table metadata stays
	// unchanged and all seven original entries remain reachable.
	fmt.println(!succeeded(m.try_insert(Key{99}, Value{80})));
	fmt.println(m.cap() == before);
	fmt.println(m.len());
	fmt.println(m[Key{6}].id);

	// A failed value clone while replacing a key leaves the old value intact.
	fmt.println(!succeeded(m.try_insert(Key{1}, Value{99})));
	fmt.println(m.len());
	fmt.println(m[Key{1}].id);
}
