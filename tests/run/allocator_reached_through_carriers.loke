// design.md "Allocator regions and region provenance": what a call may read through its
// argument's carriers is in the regions they lead to, and in no other. A reset of a region
// none of them reaches leaves the result alone.
package main;

import "core:fmt";
import "core:mem";

Holder :: struct { allocator: mem.Allocator }
Handles :: struct { first: ^mut Holder, second: ^mut Holder }

make_through :: proc(handles: ^Handles) -> [dynamic]int { return make([dynamic]int, 1, handles^.second^.allocator); }
cross_field :: proc(handles: ^Handles) { handles^.first^.allocator = handles^.second^.allocator; }

kept_apart :: proc(@(allocator_reset) other: mem.Allocator) -> int {
	buffer := [256]u8{};
	kept := mem.Arena.from_buffer(&mut buffer[:]);
	a := Holder{kept.allocator()};
	b := Holder{kept.allocator()};
	handles := Handles{&mut a, &mut b};
	d := make_through(&handles);
	cross_field(&handles);
	e := make([dynamic]int, 1, a.allocator);
	free_all(other);
	return d.len() + e.len();
}

main :: proc() {
	buffer := [256]u8{};
	arena := mem.Arena.from_buffer(&mut buffer[:]);
	fmt.println(kept_apart(arena.allocator()));
}
