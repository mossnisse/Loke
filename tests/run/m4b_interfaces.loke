package main; import "core:fmt";

Additive :: interface($T: type) {
	T(0) -> T;
	(a, b: T) a + b -> T;
}

Equatable :: interface($T: type) {
	(a, b: T) a == b -> bool;
}

Ordered :: interface($T: type) {
	Equatable(T);
	(a, b: T) a < b -> bool;
}

Source :: interface($T: type) {
	T.Element -> type;
	(value: T) value.read() -> T.Element;
}

Byte_Source :: struct { current_byte: u8 }

impl Byte_Source {
	Element :: u8;
	read :: proc(self) -> u8 { return self.current_byte; }
}

Named :: interface($T: type) {
	slot describe: proc(self) -> int;
}

impl Byte_Source {
	describe :: proc(self) -> int { return 7; }
}

Flag :: struct { on: bool }

sum3 :: proc(a, b, c: $T) -> T where Additive(T) {
	return a + b + c;
}

main :: proc() {
	// A hypothetical call must not commit an instance with its typeid request
	// suppressed. No other expression requests this record's runtime identity.
	static_assert(Has_Identity(Identity_Record));
	assert(identity(Identity_Record{1}) != nil);
	static_assert(Additive(int));
	static_assert(Additive(f64));
	static_assert(!Additive(bool));
	static_assert(Ordered(int));
	static_assert(!Ordered(Flag));
	static_assert(Source(Byte_Source));
	static_assert(!Source(Flag));
	static_assert(Named(Byte_Source));
	static_assert(!Named(Flag));
	fmt.println(sum3(1, 2, 3));
	check_more();
}

Identity_Record :: struct { value: int }
identity :: proc(value: $T) -> typeid { return typeid_of(T); }
Has_Identity :: interface($T: type) {
	(value: T) identity(value) -> typeid;
}

// Requirement order is irrelevant: an associated member required later in the
// body is available to an earlier requirement.
Reversed :: interface($T: type) {
	(value: T) value.read() -> T.Element;
	T.Element -> type;
}

// A slot is callable through method syntax inside constrained generic code.
describe_twice :: proc(value: $T) -> int where Named(T) {
	return value.describe() + value.describe();
}

check_more :: proc() {
	static_assert(Reversed(Byte_Source));
	static_assert(!Reversed(Flag));
	b: Byte_Source = {3};
	fmt.println(describe_twice(b));
}
