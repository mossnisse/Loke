package main; import "core:fmt";

// design.md "Slices" and "Materialization" (m5a-plan step 2).

NUMBERS :: [3]int{7, 42, 628};

// design.md "Slice literals": the hidden backing array is an owner in the
// surrounding lexical scope, and at file scope that scope is the module -- so
// these name storage that outlives every frame. The mutable one is written to
// below, which is the reason its array cannot be shared with an equal one.
READABLE := []int{7, 42, 628};
WRITABLE := []mut int{1, 2};
NOTHING := []int{};

sum :: proc(values: []int) -> int {
	total := 0;
	foreach (value in values) {
		total += value;
	}
	return total;
}

// A read-only parameter accepts a mutable argument by weakening.
first :: proc(values: []int) -> int {
	return values[0];
}

fill :: proc(values: []mut int, with: int) {
	foreach (&value in values) {
		value = with;
	}
}

main :: proc() {
	// Nil is the zero slice, and compares against nil.
	empty: []int = nil;
	fmt.println(empty.len());
	if (empty == nil) {
		fmt.println(1);
	}

	fib := [6]int{0, 1, 1, 2, 3, 5};

	// Whole, open, and closed forms.
	fmt.println(fib[:].len());
	fmt.println(fib[2:].len());
	fmt.println(fib[:2].len());
	fmt.println(fib[1:4].len());

	// The shorthand forms agree.
	fmt.println(fib[0:6][3]);
	fmt.println(fib[:][3]);

	// Reslicing composes, and the offsets compound.
	tail := fib[2:];
	inner := tail[1:3];
	fmt.println(inner.len());
	fmt.println(inner[0]);
	fmt.println(inner[1]);

	// `a[offset:][:length]` is the documented chunk form.
	chunk := fib[1:][:2];
	fmt.println(chunk.len());
	fmt.println(chunk[0]);

	// Slicing a mutable addressable array gives `[]mut T`, which weakens.
	writable := fib[0:3];
	writable[0] = 100;
	fmt.println(writable[0]);
	fmt.println(first(writable));
	fmt.println(sum(writable));
	// The mutable borrow has ended, so `fib` may be read through its own name
	// again and sees the write.
	fmt.println(fib[0]);

	fill(fib[3:], 9);
	fmt.println(fib[3] + fib[4] + fib[5]);

	// Literals keep the capability they are written with.
	readable := []int{1, 6, 3};
	fmt.println(readable.len());
	fmt.println(readable[1]);
	mutable := []mut int{1, 6, 3};
	mutable[0] = 99;
	fmt.println(mutable[0]);
	weakened: []int = []mut int{4, 5};
	fmt.println(weakened[1]);

	// Index binding.
	foreach (value, index in readable.indexed()) {
		fmt.println(value * 10 + index);
	}

	// Materialization: a constant index folds and asks for no storage; a runtime
	// index and a slice share one read-only object.
	fmt.println(NUMBERS[0]);
	index := runtime_index();
	fmt.println(NUMBERS[index]);
	table := NUMBERS[:];
	fmt.println(table.len());
	fmt.println(table[2]);
	fmt.println(sum(table));

	fmt.println(READABLE.len(), READABLE[0], READABLE[2], sum(READABLE));
	WRITABLE[1] = 5;
	fmt.println(WRITABLE[0], WRITABLE[1]);
	fmt.println(NOTHING.len());
}

runtime_index :: proc() -> int {
	return 1;
}

// The M5b boundary, recorded rather than checked (m5a-plan decision "Slice
// boundary"). M5a implements every value, layout, bounds, and capability rule
// for a slice and records its borrowed root only as an annotation. What M5b
// adds is the provenance half: a slice must not outlive the root it views, and
// invalidating that root must invalidate the slice. Until then, returning a
// slice of a local array, or reassigning a root while a slice of it is live,
// compiles and is the documented gap — every case below keeps its root alive
// for longer than the slice that views it.
