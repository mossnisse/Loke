// design.md "Owned values": a singly linked list as a chain of boxes. Its drop
// hook unlinks iteratively, so a long list does not nest one drop per node, and
// `unbox` hands out a move-only payload. Appending at the tail and removing in
// place walk a `^mut` cursor through mutable payload bindings, storing each
// reborrow back into the cursor (design.md "Switch ownership").
package main;

import "core:fmt";

Node :: struct($T: type) { value: T, next: Option(box(Node(T))) }
List :: struct($T: type) { head: Option(box(Node(T))), count: int }
Ticket :: move_only struct { id: int }

impl List($T) {
	push_front :: proc(self: inout, @(escape=stored) value: move T) {
		rest := exchange(inout self.head, .none);
		self.head = .some(box(Node(T){move(value), move(rest)}));
		self.count += 1;
	}

	pop_front :: proc(self: inout) -> Option(T) {
		switch (first in exchange(inout self.head, .none)) {
		case .none: return .none;
		case .some:
			value, next := move(first).unbox();
			self.head = move(next);
			self.count -= 1;
			return .some(move(value));
		}
	}

	push_back :: proc(self: inout, @(escape=stored) value: move T) {
		cursor := &mut self.head;
		for (;;) {
			switch (cursor^) {
			case .some(&mut node): cursor = &mut node.next;
			case .none:
				cursor^ = .some(box(Node(T){move(value), .none}));
				self.count += 1;
				return;
			}
		}
	}

	remove :: proc(self: inout, value: T) -> bool {
		cursor := &mut self.head;
		for (;;) {
			switch (cursor^) {
			case .none: return false;
			case .some(&mut node):
				if (node.value == value) {
					rest := exchange(inout node.next, .none);
					cursor^ = move(rest);
					self.count -= 1;
					return true;
				}
				cursor = &mut node.next;
			}
		}
	}

	release :: hook(drop) proc(self: inout) {
		rest := exchange(inout self.head, .none);
		for (true) {
			switch (node in move(rest)) {
			case .none: break;
			case .some: rest = exchange(inout node.next, .none);
			}
		}
	}
}

sum :: proc(list: ^List(int)) -> int {
	total := 0;
	cursor := &list.head;
	for (true) {
		switch (cursor^) {
		case .some(node): total += node.value; cursor = &node.next;
		case .none: break;
		}
	}
	return total;
}

main :: proc() {
	numbers: List(int) = {};
	for (i := 0; i < 200000; i += 1) {
		value := i;
		numbers.push_front(move(value));
	}
	fmt.println(numbers.count, sum(&numbers));
	fmt.println(numbers.pop_front(), numbers.pop_front(), numbers.count);

	short: List(int) = {};
	for (i := 1; i <= 5; i += 1) {
		value := i;
		short.push_back(move(value));
	}
	fmt.println(short.remove(3), short.remove(1), short.remove(5), short.remove(9), short.count);
	six := 6;
	short.push_back(move(six));
	fmt.println(short.pop_front(), short.pop_front(), short.pop_front(), short.pop_front());

	tickets: List(Ticket) = {};
	tickets.push_front(Ticket{1});
	tickets.push_front(Ticket{2});
	switch (ticket in tickets.pop_front()) {
	case .some: fmt.println("ticket", ticket.id);
	case .none:
	}
}
