package main;

import "core:fmt";
import "base:interfaces";

Box :: struct { value: int }

impl Box {
	len :: proc(self) -> int { return self.value; }
	cap :: proc(self) -> int { return self.value + 10; }
	compare :: proc(self, other: Box) -> int { return self.value - other.value; }
	probe :: proc(self) -> int { return self.value; }
	hash :: proc(self, seed: uint) -> uint { return self.value.hash(seed); }
	equals :: operator(==) proc(a, b: Box) -> bool { return a.value == b.value; }
	format :: proc(self, writer: fmt.Writer, options: fmt.Options) {
		fmt.format_to(writer, "box", self.value);
	}
}

// This ordinary lexical procedure deliberately shares a name with a method.
// It proves that the language does not rewrite arbitrary `f(x)` calls.
probe :: proc(value: Box) -> int { return 99; }

make_array :: proc(calls: inout int) -> [3]int {
	calls += 1;
	return {1, 2, 3};
}

main :: proc() {
	box := Box{7};
	other := Box{3};
	fmt.println(box.len(), len(box));
	fmt.println(box.cap(), cap(box));
	fmt.println(box.compare(other), compare(box, other));
	fmt.println(box.probe(), probe(box));

	seed := uint(17);
	fmt.println(1 if box.hash(seed) == hash(box, seed) else 0);
	fmt.println(1 if interfaces.Hashable(Box) else 0);

	xs := [3]int{1, 2, 3};
	fmt.println(xs.len(), len(xs));
	fmt.println(1 if interfaces.Sequence([3]int) else 0);
	calls := 0;
	fmt.println(len(make_array(inout calls)), make_array(inout calls).len(), calls);
	view := xs[:];
	fmt.println(view.len(), len(view));

	values := [dynamic]int{1, 2, 3};
	fmt.println(values.len(), len(values));
	fmt.println(1 if values.cap() == cap(values) else 0);

	text: string = "hej";
	fmt.println(text.len(), len(text));
	fmt.println(1 if text.hash(seed) == hash(text, seed) else 0);

	table := map[string]int{"a" = 1};
	fmt.println(table.len(), len(table));
	fmt.println(1 if table.cap() == cap(table) else 0);

	reverse := iter_reverse(xs);
	last := reverse.next();
	fmt.println(last);

	format(box, fmt.stdout(), fmt.Options{});
	fmt.println();
}
