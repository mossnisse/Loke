package main; import "core:fmt";
import "core:mem";

// Maps end to end (m6b-plan step 3).
//
// design.md "Maps": one syntax with two behaviours chosen by position. The
// whole-element assignment `m[key] = elem` is the one index form that creates an
// entry; every other position — a read, a field chain, a compound assignment, an
// `inout` argument, and `&m[key]` — names an element that must already be there,
// and panics for a missing key (`tests/trap/map_missing_key.loke` and
// `tests/trap/map_missing_field.loke`). `find`, `find_or_insert` and
// `lookup_value` are the three call forms.

Test :: struct { x: int, y: int }

// design.md: "For a user-defined key, both operations must be inherent
// implementations belonging to the key type."
Id :: struct { a: int, b: int }

impl Id {
	hash :: proc(self, seed: uint) -> uint {
		return self.a.hash(self.b.hash(seed));
	}
	same :: operator(==) proc(x, y: Id) -> bool {
		return x.a == y.a && x.b == y.b;
	}
}

// design.md "Maps": `lookup_value` copies rather than borrows, so its receiver
// is immutable and an ordinary `value:` parameter can be read through it.
borrowed_len :: proc(m: map[string][dynamic]int) -> int {
	switch (held in m.lookup_value("a")) {
	case .some: return held.len();
	case .none: return -1;
	}
	return -1;
}

built :: proc() -> map[string]int {
	out: map[string]int = {};
	out["k"] = 42;
	return out;
}

// Receiver before key, each evaluated exactly once.
noisy_map :: proc() -> map[string]int {
	fmt.println("receiver");
	return built();
}
noisy_key :: proc() -> string {
	fmt.println("key");
	return "k";
}

main :: proc() {
	lookup_regressions();
	lookup_regions();
	// A literal writes each entry `key = value`.
	m := map[string]Test{
		"Bob" = { 0, 0 },
		"Chloe" = { 1, 1 },
	};
	fmt.println(m.len());

	// design.md's own example, verbatim in behaviour.
	m["Bob"] = Test{3, 3};
	fmt.println(m["Bob"].x);
	m["Chloe"].x = 0;
	fmt.println(m["Chloe"].x);

	// A field of an element that is not there has nothing to write, so "Dana"
	// is created by the whole-element assignment instead.
	m["Dana"] = Test{7, 0};
	m["Dana"].y = 1;
	fmt.println(m.len());
	fmt.println(m["Dana"].x);
	fmt.println(m["Dana"].y);

	// `&m[key]` is an ordinary address of the existing slot.
	dana := &m["Dana"];
	fmt.println(dana^.x);
	fmt.println(m.len());

	// The three membership forms. `lookup_value` is the `Option` read: it never
	// inserts, and its payload is an independently owned value rather than a
	// pointer into the table.
	switch (entry in m.lookup_value("Bob")) {
	case .some:
		fmt.println(entry.x);
		fmt.println(true);
	case .none: fmt.println(false);
	}
	switch (_ in m.lookup_value("nobody")) {
	case .some: fmt.println(true);
	case .none: fmt.println(false);
	}
	fmt.println(m.len());
	fmt.println("Chloe" in m);
	fmt.println("nobody" in m);
	// `or_else` over the same producer.
	fmt.println((m.lookup_value("Bob") or_else Test{5, 5}).x);
	fmt.println((m.lookup_value("nobody") or_else Test{5, 5}).x);

	// `find` never inserts and hands back a pointer to the stored value.
	switch (slot in m.find("Chloe")) {
	case .some:
		fmt.println(true);
		slot^ = Test{9, 9};
	case .none: fmt.println(false);
	}
	fmt.println(m["Chloe"].y);
	switch (_ in m.find("nobody")) {
	case .some: fmt.println(true);
	case .none: fmt.println(false);
	}
	fmt.println(m.len());

	// Removal moves the stored value out and drops the key.
	switch (taken in m.remove("Bob")) {
	case .some:
		fmt.println(taken.x);
		fmt.println(true);
	case .none: fmt.println(false);
	}
	switch (_ in m.remove("Bob")) {
	case .some: fmt.println(true);
	case .none: fmt.println(false);
	}
	fmt.println(m.len());

	// Capacity and clearing.
	counts: map[string]int = {};
	counts.reserve(64);
	fmt.println(counts.cap() >= 64);
	counts["a"] = 1;
	counts["a"] += 5;
	fmt.println(counts["a"]);
	switch (_ in counts.try_insert("b", 2)) {
	case .ok:  fmt.println(true);
	case .err: fmt.println(false);
	}
	fmt.println(counts["b"]);
	// `find_or_insert` is the third lookup: the slot either way, and the caller
	// names the default it creates.
	counts.find_or_insert("c", 0)^ += 1;
	counts.find_or_insert("c", 0)^ += 1;
	fmt.println(counts["c"]);
	switch (slot in counts.try_find_or_insert("c", 99)) {
	case .ok:  fmt.println(slot^);
	case .err: fmt.println(-1);
	}
	counts.remove("c");
	counts.shrink();
	fmt.println(counts.len());
	fmt.println(counts.cap() >= 2);
	counts.clear();
	fmt.println(counts.len());

	// A destructured half lands in a map entry the same way a whole value does:
	// it inserts, and replaces an existing element without leaking it.
	halves: map[string]int = {};
	halves["x"], halves["y"] = Test{1, 2};
	fmt.println(halves["x"], halves["y"], halves.len());
	halves["x"], halves["y"] = Test{3, 4};
	fmt.println(halves["x"], halves["y"], halves.len());

	// A user key with an inherent coherent pair.
	ids: map[Id]int = {};
	ids[Id{1, 2}] = 7;
	ids[Id{3, 4}] = 8;
	fmt.println(ids[Id{1, 2}]);
	fmt.println(ids[Id{3, 4}]);
	fmt.println(Id{9, 9} in ids);
	fmt.println(ids.len());

	// Managed keys and values: both halves are cloned on insertion and
	// destroyed exactly once by `clear` or by the map's own drop.
	names: map[string]string = {};
	names["one"] = "first";
	names["two"] = "second";
	names["one"] = "replaced";
	fmt.println(names["one"]);
	fmt.println(names.len());

	// A managed payload read through `lookup_value` is cloned exactly once,
	// inside the operation: the result owns its own storage, the map keeps its
	// own, and neither frees the other's. One clone, not zero and not two.
	owned: map[string][dynamic]int = {};
	first: [dynamic]int = {};
	first.append(1);
	first.append(2);
	owned["a"] = move(first);
	copied := owned.lookup_value("a") or_else {};
	fmt.println(copied.len() > 0);
	fmt.println(copied.len());
	copied.append(3);
	fmt.println(copied.len());
	fmt.println(owned["a"].len());
	vacant := owned.lookup_value("b") or_else {};
	fmt.println(vacant.len() > 0);
	fmt.println(vacant.len());
	// The source map survives the result's cleanup.
	fmt.println(owned.len());
	// An immutable parameter and a temporary receiver both read without `inout`.
	fmt.println(borrowed_len(owned));
	fmt.println(built().lookup_value("k") or_else -1);
	fmt.println(built().lookup_value("gone") or_else -1);
	// Receiver, then key, each once.
	switch (loud in noisy_map().lookup_value(noisy_key())) {
	case .some:
		fmt.println(loud);
		fmt.println(true);
	case .none: fmt.println(false);
	}

	// A carrier payload still borrows through the map, exactly as the index it
	// replaces does: `lookup_value` trades no place provenance for `unknown`.
	views: map[int]string_view = {};
	views[1] = "borrowed";
	fmt.println(views[1]);
	switch (seen in views.lookup_value(1)) {
	case .some:
		fmt.println(seen);
		fmt.println(true);
	case .none: fmt.println(false);
	}

	names.clear();
	fmt.println(names.len());

	// Growth past the load threshold, so the table rehashes several times.
	wide: map[int]int = {};
	for (i := 0; i < 200; i += 1) {
		wide[i] = i * 2;
	}
	fmt.println(wide.len());
	fmt.println(wide[7]);
	fmt.println(wide[199]);
	total := 0;
	for (i := 0; i < 200; i += 2) {
		switch (_ in wide.remove(i)) {
		case .some: total += 1;
		case .none:
		}
	}
	fmt.println(total);
	fmt.println(wide.len());
	fmt.println(wide[3]);
	fmt.println(0 in wide);

	inout_slots();
	distinct_keys();
	shrink_floor();
}

bump :: proc(n: inout int) { n += 1; }
bump_f :: proc(n: inout f64) { n += 1.0; }
bump_either :: proc { bump, bump_f }
add_all :: proc(n: inout int, xs: ..int) { foreach (x in xs) { n += x; } }

// design.md "Maps": an `inout` argument is a place the callee writes, and it
// names an element that must already be there — the callee is handed a slot,
// not an insertion. That holds however the callee is spelled: named directly,
// reached through an overload group, or fixed ahead of a variadic pack.
inout_slots :: proc() {
	slots: map[string]int = {};
	slots["direct"] = 0;
	slots["group"] = 0;
	bump(inout slots["direct"]);
	bump_either(inout slots["group"]);
	add_all(inout slots.find_or_insert("variadic", 0)^, 1, 2, 3);
	fmt.println(slots.len());
	fmt.println(slots["direct"]);
	fmt.println(slots["group"]);
	fmt.println(slots["variadic"]);
}

key_copies, key_drops, value_copies, value_drops: int;
Tracked_Key :: struct { id: int }
Tracked_Value :: struct { id: int }
impl Tracked_Key {
	hash :: proc(self, seed: uint) -> uint { return self.id.hash(seed); }
	equal :: operator(==) proc(a, b: Tracked_Key) -> bool { return a.id == b.id; }
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked_Key, Allocator_Error) {
		key_copies += 1;
		return .ok(Tracked_Key{self.id});
	}
	release :: hook(drop) proc(self: inout Tracked_Key) { if (self.id != 0) { key_drops += 1; } }
}
impl Tracked_Value {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked_Value, Allocator_Error) {
		value_copies += 1;
		return .ok(Tracked_Value{self.id});
	}
	release :: hook(drop) proc(self: inout Tracked_Value) { if (self.id != 0) { value_drops += 1; } }
}

tracked_map :: proc() -> map[int]Tracked_Value {
	m: map[int]Tracked_Value = {};
	m[1] = Tracked_Value{2};
	return m;
}

lookup_regressions :: proc() {
	{
		key := Tracked_Key{1};
		m: map[Tracked_Key]Tracked_Value = {};
		m[key] = Tracked_Value{1};
		assert(key_copies == 1 && key_drops == 0);
		assert(value_copies == 0 && value_drops == 0);
		{
			switch (held in m.lookup_value(key = key)) {
			case .some:
				assert(held.id == 1 && key.id == 1);
				assert(value_copies == 1 && value_drops == 0 && key_drops == 0);
			case .none: assert(false);
			}
		}
		assert(value_drops == 1);
		{
			switch (_ in m.lookup_value(key)) {
			case .some:
			case .none: assert(false);
			}
		}
		assert(value_copies == 2 && value_drops == 2);
		{
			switch (_ in m.lookup_value(key)) {
			case .some:
			case .none: assert(false);
			}
		}
		assert(value_copies == 3 && value_drops == 3);
		m.lookup_value(key);
		m.lookup_value(key);
		assert(value_copies == 5 && value_drops == 5);
		switch (_ in m.lookup_value({9})) {
		case .some: assert(false);
		case .none: assert(value_copies == 5 && value_drops == 5 && key_drops == 1);
		}
		switch (_ in m.find(key = key)) {
		case .some: assert(key_drops == 1);
		case .none: assert(false);
		}
		assert(key in m);
		assert(m[key].id == 1 && key_drops == 1);
		switch (_ in m.find({1})) {
		case .some: assert(key_drops == 2);
		case .none: assert(false);
		}
		assert(Tracked_Key{1} in m);
		assert(m[Tracked_Key{1}].id == 1 && key_drops == 4);
		{
			switch (taken in m.remove(key)) {
			case .some: assert(taken.id == 1 && key_drops == 5);
			case .none: assert(false);
			}
		}
		assert(value_drops == 6 && key.id == 1);
	}
	assert(key_drops == 6);
	// design.md "Borrows and lifetimes": a temporary in a `switch` subject
	// survives until that complete statement ends, so the map `tracked_map()`
	// built is still alive while the case body runs and is destroyed with the
	// switch. Its drop used to happen before the body, which is why these
	// counts read one lower inside a case than after it — the totals either
	// side of the statement are unchanged.
	{
		switch (held in tracked_map().lookup_value(1)) {
		case .some: assert(held.id == 2 && value_copies == 6 && value_drops == 6);
		case .none: assert(false);
		}
	}
	assert(value_drops == 8);
	switch (_ in tracked_map().lookup_value(9)) {
	case .some: assert(false);
	case .none: assert(value_copies == 6 && value_drops == 8);
	}
	assert(value_drops == 9);

	// The formal key type supplies context to positional and named literals.
	grid: map[[2]int]int = {};
	grid[{1, 2}] = 17;
	assert((grid.lookup_value(key = {1, 2}) or_else -1) == 17);
	switch (ptr in grid.find({1, 2})) {
	case .some: assert(ptr^ == 17);
	case .none: assert(false);
	}

	// design.md "Maps": `find_ref` is the same probe through a read-only borrow.
	// An immutable parameter can ask it, having no `inout` to give `find`.
	borrowed_keys();
	assert(read_grid(&grid, {1, 2}) == 17);
	assert(read_grid(&grid, {3, 4}) == -1);
	switch (ptr in grid.find_ref({1, 2})) {
	case .some: assert(ptr^ == 17);
	case .none: assert(false);
	}
}

// design.md "Maps": a borrowed key queries a `map[string]V`. Nothing owned is
// built to compare against one, which is why the view need not be terminated or
// outlive the probe — only its bytes are read.
borrowed_keys :: proc() {
	m: map[string]int = {};
	m["hellope"] = 1;
	m["other"] = 2;
	view: string_view = "hellope";
	assert(view in m);
	assert(!("nope" in m));
	assert(m[view] == 1);
	assert((m.lookup_value(view) or_else -1) == 1);
	assert((m.lookup_value("missing") or_else -1) == -1);
	switch (slot in m.find(view)) {
	case .some: slot^ = 11;
	case .none: assert(false);
	}
	switch (slot in m.find_ref(view)) {
	case .some: assert(slot^ == 11);
	case .none: assert(false);
	}
	m[view] += 4;
	assert(&m[view] != nil && m[view] == 15);
	// A view into a longer buffer: the key ends where the view does.
	text: string = "hellopeXX";
	assert(text[0:7] in m && m[text[0:7]] == 15);
	assert(!(text[0:6] in m));
	// The owned spelling still reaches the same entry.
	owned: string = "other";
	assert(owned in m && m[owned] == 2 && (m.lookup_value(owned) or_else -1) == 2);
	assert((m.remove(view) or_else -1) == 15 && m.len() == 1);
}

read_grid :: proc(m: ^map[[2]int]int, key: [2]int) -> int {
	switch (ptr in m.find_ref(key)) {
	case .some: return ptr^;
	case .none:
	}
	return -1;
}

lookup_regions :: proc() {
	arena := mem.Arena.init();
	m: map[int][dynamic]int via arena.allocator() = {};
	m[1] = {9};
	held := m.lookup_value(1) or_else {};
	drop(m);
	free_all(arena.allocator());
	assert(held.len() == 1 && held[0] == 9);
}

// design.md "Maps": "A different policy wraps the key in a local `distinct`
// type with its own inherent operations." The pair belongs to the key type, so
// this one folds pairs of keys together, and a plain `map[u64]` in the same
// program keeps the built-in policy its own underlying type has.
Folded :: distinct u64;
impl Folded {
	hash :: proc(self, seed: uint) -> uint { return (u64(self) / 2).hash(seed); }
	same :: operator(==) proc(a, b: Folded) -> bool { return u64(a) / 2 == u64(b) / 2; }
}

distinct_keys :: proc() {
	folded: map[Folded]int = {};
	folded[Folded(2)] = 5;
	folded[Folded(3)] = 6;
	plain: map[u64]int = {};
	plain[2] = 5;
	plain[3] = 6;
	fmt.println(folded.len(), folded[Folded(2)]);
	fmt.println(plain.len(), plain[2]);
}

// `shrink(min)` with a floor above the current capacity leaves the capacity
// where it is, whether or not a removal left a tombstone to clear.
shrink_floor :: proc() {
	clean: map[int]int = {};
	clean[1] = 1;
	before := clean.cap();
	clean.shrink(100);
	fmt.println(clean.cap() == before);
	holed: map[int]int = {};
	holed[1] = 1;
	holed[2] = 2;
	holed.remove(1);
	before = holed.cap();
	holed.shrink(100);
	fmt.println(holed.cap() == before, holed[2]);
}
