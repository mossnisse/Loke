package main;
import "core:fmt";
import "core:container";
import "base:interfaces";

// design.md "Borrowing iteration": traversing a place lends each element, so
// inspecting move-only or expensive elements requires neither a clone nor
// mutable access to their storage, and a pointer taken with `&` outlives both
// the step and the traversal.
Entry :: move_only struct { id: int }
impl Entry {
	release :: hook(drop) proc(self: inout Entry) { self.id = 0; }
}

sum :: proc(items: []Entry) -> int {
	total := 0;
	foreach (item in items) { total += item.id; }
	return total;
}

copies: int;
Tracked :: struct { id: int }
impl Tracked {
	copy_value :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked, Allocator_Error) {
		copies += 1;
		return .ok(Tracked{self.id});
	}
	release :: hook(drop) proc(self: inout Tracked) { self.id = 0; }
}

sum_ints :: proc(source: $S) -> int where interfaces.Iterable(S), S.Element == int {
	total := 0;
	foreach (item in source) { total += item; }
	return total;
}

// A borrowing view is an ordinary `[]T`, so returning one is valid exactly while
// what it names outlives the call.
view_of :: proc(values: []int) -> []int { return values; }
make_values :: proc() -> [dynamic]int { return [dynamic]int{4, 5}; }

CONSTANT :: [2]int{21, 22};
constant_first :: proc() -> ^int {
	walker := CONSTANT.iter();
	return walker.next() or_else nil;
}

main :: proc() {
	entries := [2]Entry{Entry{3}, Entry{7}};
	fmt.println("move-only", sum(entries[:]));
	// `indexed()` lends the half its source lends, so numbering a move-only
	// sequence copies nothing and needs no copy to exist.
	foreach (entry, index in entries.indexed()) { fmt.println(index, entry.id); }
	foreach (entry in entries.reversed()) { fmt.println("reverse", entry.id); }
	// The unrelated value-copy iterator must not be emitted for move-only T.
	readonly: []Entry = entries[:];
	first := &readonly[0];
	fmt.println("indexed read", first^.id);

	tracked := [2]Tracked{Tracked{11}, Tracked{13}};
	for (pass := 0; pass < 2; pass += 1) {
		foreach (item in tracked) { fmt.println("tracked", item.id); }
	}
	fmt.println("copies", copies);
	assert(copies == 0);

	values := [dynamic]int{1, 2, 3};
	view: []int = values[:];
	fmt.println("generic", sum_ints(view), sum_ints(view.reversed()));
	fmt.println("repeat", sum_ints(view));
	foreach (item, index in view.reversed().indexed()) { fmt.println(index, item); }
	// A slice descriptor can disappear without ending the borrowed storage.
	from_slice := view_of(values[:]);
	fmt.println("returned", sum_ints(from_slice));
	walker := view.iter();
	one := walker.next() or_else nil;
	two := walker.next() or_else nil;
	drop(walker);
	fmt.println("retained", one^, two^);
	values.append(4); // all source borrows have ended
	fmt.println("resumed", values.len());
	// An element pointer taken inside the loop outlives the loop itself.
	saved: ^int = nil;
	foreach (item in values) { saved = &item; break; }
	fmt.println("past loop", saved^);
	// `indexed()` lends what its source lends, so the pairs a stored adapter hands
	// back hold element pointers that outlive the walk.
	indexed_walker := values.indexed().iter();
	indexed_one := indexed_walker.next() or_else {};
	indexed_two := indexed_walker.next() or_else {};
	drop(indexed_walker);
	fmt.println("indexed retained", indexed_one.value^, indexed_two.value^);
	fmt.println("constant", constant_first()^, constant_first() == &CONSTANT[0]);

	// Foreach keeps the temporary owner alive for the complete loop.
	foreach (item in make_values()) { fmt.println("temporary", item); }
	empty: []Entry = nil;
	foreach (item in empty) { panic("empty slice yielded"); }
	zero: [0]Entry = {};
	foreach (item in zero.reversed()) { panic("empty array yielded"); }
	fmt.println("empty", sum(empty));

	small: container.Small_Array(int, 4) = {};
	small.append(8, 9);
	fmt.println("library", sum_ints(small.view()));
}
