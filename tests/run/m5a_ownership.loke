package main; import "core:fmt"; import "core:unsafe";

// Implicit drops, `move`, and explicit `drop` (m5a-plan step 4).
//
// design.md "Managed values and storage": "Cleanup uses the same order as
// `defer`. A managed local declaration places an implicit conditional
// `defer drop(value)` at the declaration point ... Implicit drops and explicit
// deferred statements run in reverse registration order."
//
// Each procedure prints its own marker first, so the interleaving below is the
// observable order rather than a claim about it.

Res :: struct { id: int }

impl Res {
	release :: hook(drop) proc(self: inout Res) {
		if (self.id != 0) {
			fmt.println(self.id);
		}
	}
}

make_res :: proc(id: int) -> Res {
	return Res{id};
}

// Two locals, cleaned up in reverse registration order.
scope_exit :: proc() {
	fmt.println(1000);
	a := make_res(1);
	b := make_res(2);
}

// An explicit `drop` marks the variable dead, so scope exit does not run a
// second one.
explicit :: proc() {
	fmt.println(2000);
	a := make_res(3);
	drop(a);
}

// `move` transfers the representation and leaves the source dead.
moved :: proc() {
	fmt.println(3000);
	a := make_res(4);
	b := move(a);
}

// One reverse order for both kinds: `b` was registered after the `defer`, which
// was registered after `a`. With the argument true, `b` is already dead by the
// time its slot runs, which is what the hidden flag records.
interleaved :: proc(flag: bool) {
	fmt.println(4000);
	a := make_res(5);
	defer fmt.println(99);
	b := make_res(6);
	if (flag) {
		drop(b);
	}
}

// A `return` cleans up every scope it leaves, innermost first.
early :: proc(flag: bool) {
	fmt.println(5000);
	a := make_res(7);
	if (flag) {
		b := make_res(8);
		return;
	}
	c := make_res(9);
}

// Each iteration drops its own local before the next one runs.
looping :: proc() {
	fmt.println(6000);
	for (i := 0; i < 2; i += 1) {
		x := make_res(10 + i);
	}
}

// design.md: a `move` parameter transfers ownership from caller to callee, so
// the callee drops it and the caller's source is dead. A `move self` receiver
// gets its marker from method-call syntax.
consuming :: proc(value: move Res) -> int {
	return value.id;
}

impl Res {
	consume :: proc(self: move Res) -> int {
		return self.id;
	}
}

transferred :: proc() {
	fmt.println(7000);
	a := make_res(12);
	fmt.println(consuming(move(a)));
	b := make_res(13);
	fmt.println(move(b).consume());
}

// A borrowed managed parameter owns nothing it could move out, so returning it
// by value clones; the caller's own value stays live.
returns_borrow :: proc(value: Res) -> Res {
	return value;
}

// A managed local transfers into result storage instead, so scope exit does not
// drop what was just handed back.
returns_local :: proc() -> Res {
	local := make_res(15);
	return local;
}

returning :: proc() {
	fmt.println(8000);
	source := make_res(14);
	copy := returns_borrow(source);
	moved := returns_local();
	fmt.println(moved.id);
}

// design.md "Assignment statements": "Assignment has value semantics ... It does
// not create a hidden alias to the same allocation." A place names storage
// someone else still owns, so consuming it copies; a temporary transfers.
Counted :: struct { id: int }

impl Counted {
	// A custom hook makes the copy observable: a clone adds 100, a bitwise copy
	// would not.
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Counted, Allocator_Error) {
		return .ok(Counted{self.id + 100});
	}

	release :: hook(drop) proc(self: inout Counted) {
		if (self.id != 0) {
			fmt.println(self.id);
		}
	}
}

copies :: proc() {
	fmt.println(9000);
	source := Counted{1};
	binding := source;
	fmt.println(binding.id);

	// The destination's previous value is dropped once the clone succeeded.
	destination := Counted{2};
	destination = source;
	fmt.println(destination.id);
}

// A destination one path dropped and the other did not: the replacement asks
// the hidden flag rather than dropping unconditionally.
replaced :: proc(flag: bool) {
	fmt.println(9500);
	x := Counted{3};
	if (flag) {
		drop(x);
	}
	x = Counted{4};
	fmt.println(x.id);
}

// design.md: an owning temporary nothing binds is still a completed
// initialization, so it is cleaned up exactly once rather than leaked.
discarded :: proc() {
	fmt.println(9800);
	make_res(16);
	fmt.println(9801);
}

// design.md "Exchange": `exchange` "replaces a definitely live value and returns
// its previous value without cloning it ... No user code runs between those two
// moves, and the destination is never observably dead."
exchanged :: proc() {
	fmt.println(9900);
	current := make_res(17);
	previous := exchange(inout current, make_res(18));
	fmt.println(previous.id);
	fmt.println(current.id);

	// The destination's type supplies the context, so `{}` is its zero value.
	last := exchange(inout current, {});
	fmt.println(last.id);
	fmt.println(current.id);
}

// design.md "`unsafe.forget`": suppression belongs to the value, not to its
// declaration. `held` is a deliberate leak and prints nothing; `released` is an
// ordinary owner that writes its own `drop`; `automatic` is cleaned up at scope
// exit like every other local.
forgotten_owner :: proc() {
	fmt.println(9700);
	automatic := make_res(19);
	held := make_res(20);
	released := make_res(21);
	drop(released);
	unsafe.forget(move(held));
}

// "`static` creates one instance for the life of the process. The value remains
// available between calls."
counted :: proc() -> int {
	counter: static int = 0;
	counter = counter + 1;
	return counter;
}

// "At normal thread return, the runtime drops each live managed `thread_local`
// value in reverse initialization order." M5a creates no threads, so that is
// after `main` returns.
session :: proc() {
	current: thread_local Res;
	current = make_res(22);
	fmt.println(current.id);
}

main :: proc() {
	scope_exit();
	explicit();
	moved();
	interleaved(true);
	interleaved(false);
	early(true);
	early(false);
	looping();
	transferred();
	returning();
	copies();
	replaced(true);
	replaced(false);
	discarded();
	exchanged();
	forgotten_owner();
	fmt.println(counted());
	fmt.println(counted());
	session();
}
