package main; import "core:fmt";

B :: struct { value: int }
A :: struct { value: int }

raw :: proc(id: typeid) -> i64 {
	p := &id;
	return (^i64)(rawptr(p))^;
}

main :: proc() {
	second := typeid_of(u128);
	first := typeid_of(i8);
	fmt.println(raw(typeid_of(A)), raw(typeid_of(B)), raw(first), raw(second));
}
