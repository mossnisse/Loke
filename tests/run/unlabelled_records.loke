// design.md "Anonymous records": an unlabelled record is reached by position.
// It destructures, takes positional literals, nests, compares, prints without
// names, reflects with empty names, and is its own type apart from any
// labelled record with the same field types.
package main;

import "core:fmt";

divmod :: proc(a, b: int) -> (int, int) { return {a / b, a % b}; }

find :: proc(xs: []int, wanted: int) -> (int, bool) {
	foreach (x, i in xs.indexed()) {
		if (x == wanted) { return {i, true}; }
	}
	return {};
}

Pair :: (int, string_view);

// The labelled and unlabelled shapes are different types, so they overload.
describe :: proc { describe_unlabelled, describe_labelled }
describe_unlabelled :: proc(v: (int, int)) -> string_view { return "unlabelled"; }
describe_labelled :: proc(v: (a: int, b: int)) -> string_view { return "labelled"; }

names :: proc($T: type) {
	foreach ($field in fields_of(T)) {
		fmt.println(field.index, "[", field.name, "]", field.type == int);
	}
}

main :: proc() {
	q, r := divmod(17, 5);
	fmt.println(q, r);
	fmt.println(divmod(9, 4));

	index, found := find([]int{4, 5, 6}, 6);
	fmt.println(index, found);
	_, missing := find([]int{4}, 9);
	fmt.println(missing);

	pairs: [dynamic](int, string_view) = {};
	pairs.append(Pair{1, "one"});
	pairs.append({2, "two"});
	fmt.println(pairs);
	foreach (n, word in pairs) { fmt.println(n, word); }

	nested: ((int, int), bool) = {{1, 2}, true};
	inner, flag := nested;
	x, y := inner;
	fmt.println(nested, x + y, flag);

	p: Pair = {3, "three"};
	fmt.println(p == Pair{3, "three"}, p == Pair{3, "four"});

	partial: (int, bool) = {7};
	fmt.println(partial);

	o: Option((int, bool)) = .some({1, true});
	fmt.println(o);

	bare: (int, int) = {1, 2};
	named: (a: int, b: int) = {1, 2};
	fmt.println(describe(bare), describe(named));
	fmt.println((1 + 2) * 3);
	names((int, bool));
}
