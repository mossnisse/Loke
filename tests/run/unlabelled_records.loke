// design.md "Anonymous records": an unlabelled record is reached by position.
// It destructures, takes positional literals, nests, compares, prints without
// names, reflects with empty names, and is its own type apart from any
// labelled record with the same field types, which converts to it implicitly.
package main;

import "core:fmt";

divmod :: proc(a, b: int) -> (int, int) { return {a / b, a % b}; }

find :: proc(xs: []int, wanted: int) -> (int, bool) {
	foreach (x, i in xs.indexed()) {
		if (x == wanted) { return {i, true}; }
	}
	return {};
}

Pair :: (int, string_view);

minmax :: proc(a, b: int) -> (low: int, high: int) {
	if (a < b) { return {a, b}; }
	return {b, a};
}
sum_pair :: proc(pair: (int, int)) -> int { low, high := pair; return low + high; }
plain_minmax :: proc(a, b: int) -> (int, int) { return minmax(a, b); }
owned_words :: proc() -> (first: string, second: string) { return {"lo" + "ke", "records"}; }
Bounds :: (low: int, high: int);
ORIGIN :: Bounds{0, 0};

// The labelled and unlabelled shapes are different types, so they overload.
describe :: proc { describe_unlabelled, describe_labelled }
describe_unlabelled :: proc(v: (int, int)) -> string_view { return "unlabelled"; }
describe_labelled :: proc(v: (a: int, b: int)) -> string_view { return "labelled"; }

names :: proc($T: type) {
	foreach ($field in fields_of(T)) {
		fmt.println(field.index, "[", field.name, "]", field.type == int);
	}
}

main :: proc() {
	q, r := divmod(17, 5);
	fmt.println(q, r);
	fmt.println(divmod(9, 4));

	index, found := find([]int{4, 5, 6}, 6);
	fmt.println(index, found);
	_, missing := find([]int{4}, 9);
	fmt.println(missing);

	pairs: [dynamic](int, string_view) = {};
	pairs.append(Pair{1, "one"});
	pairs.append({2, "two"});
	fmt.println(pairs);
	foreach (n, word in pairs) { fmt.println(n, word); }

	nested: ((int, int), bool) = {{1, 2}, true};
	inner, flag := nested;
	x, y := inner;
	fmt.println(nested, x + y, flag);

	p: Pair = {3, "three"};
	fmt.println(p == Pair{3, "three"}, p == Pair{3, "four"});

	partial: (int, bool) = {7};
	fmt.println(partial);

	o: Option((int, bool)) = .some({1, true});
	fmt.println(o);

	bare: (int, int) = {1, 2};
	named: (a: int, b: int) = {1, 2};
	fmt.println(describe(bare), describe(named));
	fmt.println((1 + 2) * 3);
	names((int, bool));

	// design.md "Implicit type conversions": a labelled record drops its labels
	// where the unlabelled one is expected, owned fields included.
	as_pair: (int, int) = minmax(4, 2);
	fmt.println(as_pair, sum_pair(minmax(9, 3)), plain_minmax(7, 8));
	words := owned_words();
	copied: (string, string) = words;
	moved: (string, string) = move(words);
	fmt.println(copied, moved);
	constant: (int, int) = ORIGIN;
	fmt.println(constant);
	held: [dynamic](int, int) = {};
	held.append(minmax(5, 1));
	maybe: Option((int, int)) = .some(minmax(0, 3));
	fmt.println(held, maybe);
}
