package main;

import "core:fmt";
import "core:fs";
import "core:io";
import "core:os";
import "core:path";
import "core:strings";

// `core:fs` and `core:path` against a real filesystem (standard-library-plan
// stage 2, items 2 to 5).
//
// Every case runs inside an isolated temporary directory taken from the
// environment, so nothing depends on the repository working directory or on a
// developer's machine, and the directory is removed at the end.

// Every `Result(Unit, io.Error)` below is only ever asked which variant it is.
succeeded :: proc(outcome: Result(Unit, io.Error)) -> bool {
	switch (_ in outcome) {
	case .ok:  return true;
	case .err: return false;
	}
	return false;
}

// And these want the failure itself.
failure_of :: proc(outcome: Result(Unit, io.Error)) -> io.Error {
	switch (error in outcome) {
	case .ok:  return io.make_error(.Other, .Other);
	case .err: return error;
	}
}

root :: proc() -> string {
	switch (outcome in os.get_environment("TEMP")) {
	case .ok:
		switch (base in outcome) {
		case .some: return path.join([]string_view{base, "loke_fs_case"});
		case .none:
		}
	case .err:
	}
	return strings.copy("loke_fs_case");
}

in_root :: proc(directory: string_view, name: string_view) -> string {
	return path.join([]string_view{directory, name});
}

main :: proc() {
	directory := root();
	// A leftover directory from an interrupted earlier run is not a failure.
	clean_up(directory);
	fmt.println(succeeded(fs.create_directories(in_root(directory, "nested"))));

	file := in_root(directory, "notes.txt");
	fmt.println(succeeded(fs.write_text(file, "första\n")));
	// An existing file is not an already-satisfied directory creation.
	fmt.println(io.is(failure_of(fs.create_directories(file)), .Already_Exists));
	switch (text in fs.read_text(file)) {
	case .ok:
		fmt.println(true);
		fmt.println(text);
		fmt.println(text.len());
	case .err:
		fmt.println(false);
		fmt.println("");
		fmt.println(0);
	}

	// Appending adds to the end; writing truncates first.
	fmt.println(succeeded(fs.append_text(file, "andra\n")));
	both := fs.read_text(file) or_else no_text();
	fmt.println(both.len());
	foreach (line in strings.lines(both)) {
		fmt.println(line);
	}
	fmt.println(succeeded(fs.write_text(file, "kort")));
	fmt.println(fs.read_text(file) or_else no_text());

	// Bytes, including a zero byte, survive unchanged.
	binary := in_root(directory, "binary.bin");
	data := [?]u8{0, 1, 2, 0xFF, 0};
	fmt.println(succeeded(fs.write_bytes(binary, data[:])));
	switch (bytes in fs.read_bytes(binary)) {
	case .ok:
		fmt.println(true);
		fmt.println(bytes.len());
		fmt.println(int(bytes[3]));
	case .err:
		fmt.println(false);
		fmt.println(0);
		fmt.println(-1);
	}

	// Those bytes are not UTF-8, and `read_text` says so rather than repairing.
	switch (invalid in fs.read_text(binary)) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(io.is(invalid, .Invalid_Data));
	}

	// The bounded read: one below, exactly at, and one above the limit.
	switch (under in fs.read_bytes(binary, limit = 6)) {
	case .ok:
		fmt.println(true);
		fmt.println(under.len());
	case .err:
		fmt.println(false);
		fmt.println(0);
	}
	switch (exact in fs.read_bytes(binary, limit = 5)) {
	case .ok:
		fmt.println(true);
		fmt.println(exact.len());
	case .err:
		fmt.println(false);
		fmt.println(0);
	}
	switch (over in fs.read_bytes(binary, limit = 4)) {
	case .ok:
		fmt.println(false);
		fmt.println(over.len());
	case .err:
		// Nothing partial comes back with the failure.
		fmt.println(io.is(over, .Limit_Exceeded));
		fmt.println(0);
	}

	// Metadata and existence.
	switch (info in fs.metadata(file)) {
	case .ok:
		fmt.println(true);
		fmt.println(int(info.kind));
		fmt.println(info.size);
		// The modification time is nanoseconds since the Unix epoch, so a file
		// written moments ago sits between 2020 and 2100 rather than in 1601.
		fmt.println(info.modified > 1577836800000000000 && info.modified < 4102444800000000000);
	case .err:
		fmt.println(false);
		fmt.println(-1);
		fmt.println(0);
		fmt.println(false);
	}
	switch (directory_info in fs.metadata(directory)) {
	case .ok:  fmt.println(int(directory_info.kind));
	case .err: fmt.println(-1);
	}

	switch (present in fs.exists(file)) {
	case .ok:
		fmt.println(present);
		fmt.println(true);
	case .err:
		fmt.println(false);
		fmt.println(false);
	}
	switch (absent in fs.exists(in_root(directory, "nothing.txt"))) {
	case .ok:
		fmt.println(absent);
		fmt.println(true);
	case .err:
		fmt.println(true);
		fmt.println(false);
	}

	// A missing file is `Not_Found`, on every entry point.
	switch (missing in fs.open_read(in_root(directory, "nothing.txt"))) {
	case .ok:
		fmt.println(false);
		fmt.println(-1);
	case .err:
		fmt.println(io.is(missing, .Not_Found));
		fmt.println(int(io.operation_of(missing)));
	}
	fmt.println(io.is(failure_of(fs.remove(in_root(directory, "nothing.txt"))), .Not_Found));

	// A Unicode name is an ordinary name.
	unicode := in_root(directory, "vär(ld).txt");
	fmt.println(succeeded(fs.write_text(unicode, "ok")));
	fmt.println(fs.exists(unicode) or_else false);

	// The handle API: write, seek, read back, and close explicitly.
	handle_path := in_root(directory, "handle.bin");
	handle := fs.open(handle_path, fs.Open_Options{.Read_Write, .Create_Or_Truncate, false}) or_else no_file();
	fmt.println(true);
	fmt.println(succeeded(io.write_string(inout handle, "0123456789")));
	fmt.println(succeeded(handle.flush()));
	switch (position in handle.seek(4, fs.Seek_Origin.Start)) {
	case .ok:
		fmt.println(true);
		fmt.println(position);
	case .err:
		fmt.println(false);
		fmt.println(0);
	}
	window: [3]u8 = {};
	switch (count in handle.read(window[:])) {
	case .ok:
		fmt.println(true);
		fmt.println(count);
	case .err:
		fmt.println(false);
		fmt.println(0);
	}
	fmt.println(string.from_utf8(window[:]) or_else no_text());
	fmt.println(succeeded(handle.close()));
	// Close is idempotent, and the value is inert afterwards.
	fmt.println(succeeded(handle.close()));
	fmt.println(handle.is_open());
	switch (_ in handle.read(window[:])) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(true);
	}

	// A file opened for reading refuses to write, whatever the static type says.
	reader := fs.open_read(file) or_else no_file();
	one: string_view = "x";
	switch (wrong_direction in reader.write(one.bytes())) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(io.is(wrong_direction, .Unsupported));
	}
	fmt.println(succeeded(reader.close()));

	// Renaming, then reading through the new name.
	renamed := in_root(directory, "renamed.txt");
	fmt.println(succeeded(fs.rename(file, renamed)));
	fmt.println(fs.read_text(renamed) or_else no_text());

	// The directory reader yields every entry once, and skips `.` and `..`.
	entries := count_entries(directory);
	fmt.println(entries);

	clean_up(directory);
	fmt.println(fs.exists(directory) or_else true);
}

// Everything these stand in for is checked by the case that produced it; a
// failure here is a broken test environment rather than a case to cover.
no_text :: proc() -> string { panic("a file the test just wrote could not be read"); }
no_file :: proc() -> fs.File { panic("a file the test just created could not be opened"); }

// The reader is move-only and closes its search handle in `drop`, so this
// collects what it needs and lets the scope end.
count_entries :: proc(directory: string_view) -> int {
	reader: fs.Directory_Reader;
	switch (opened in fs.read_directory(directory)) {
	case .ok:  reader = move(opened);
	case .err: return -1;
	}
	total := 0;
	// `break` inside a variant switch leaves the switch, so the loop's own exit
	// is a condition rather than a jump out of a case.
	reading := true;
	for (; reading; ) {
		switch (outcome in reader.next()) {
		case .ok:
			switch (entry in outcome) {
			case .some:
				if (entry.name.len() == 0) { return -3; }
				total += 1;
			case .none: reading = false;
			}
		case .err: return -2;
		}
	}
	return total;
}

// Removes every file, then the directories. `remove` on a missing path is not
// checked here: this runs before the first case as well.
clean_up :: proc(directory: string_view) {
	reader: fs.Directory_Reader;
	switch (opened in fs.read_directory(directory)) {
	case .ok:  reader = move(opened);
	case .err: return;
	}
	names := make([dynamic]string, 0, 8) or_else {};
	reading := true;
	for (; reading; ) {
		switch (outcome in reader.next()) {
		case .ok:
			switch (entry in outcome) {
			case .some: names.append(strings.copy(entry.name));
			case .none: reading = false;
			}
		case .err: reading = false;
		}
	}
	// The reader holds a search handle over the directory being emptied, so it is
	// closed before anything is removed.
	if (!succeeded(reader.close())) { return; }
	// Indexed rather than `foreach`, so the loop borrows each stored name instead
	// of retaining a copy of it for the step.
	for (index := 0; index < names.len(); index += 1) {
		full := path.join([]string_view{directory, names[index]});
		if (!succeeded(fs.remove(full))) {
			_ = fs.remove_directory(full);
		}
	}
	_ = fs.remove_directory(in_root(directory, "nested"));
	_ = fs.remove_directory(directory);
}
