package main;

import "core:fmt";
import "core:io";
import "core:mem";
import "core:os";
import "core:path";

// Process-state allocation failures keep their normalized I/O identity. A
// deliberately small fixed arena makes UTF-16 decoding fail without depending
// on machine memory pressure.
// The process calls answer with `Result(Unit, io.Error)`; these checks only
// care which variant came back.
succeeded :: proc(outcome: Result(Unit, io.Error)) -> bool {
	switch (outcome) {
	case .ok:  return true;
	case .err: return false;
	}
	return false;
}

main :: proc() {
	name: string_view = "LOKE_STDLIB_OOM_CHECK_7E2C";
	value: string_view =
		"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" +
		"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" +
		"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
	fmt.println(succeeded(os.set_environment(name, value)));

	room: [160]u8 = {};
	arena := mem.Arena.from_buffer(&mut room[:]);
	switch (os.get_environment(name, arena.allocator())) {
	case .ok(outcome):
		// A successful read still separates "set" from "not set".
		switch (outcome) {
		case .some: fmt.println(true);
		case .none: fmt.println(false);
		}
		fmt.println(false);
	case .err(outcome):
		fmt.println(false);
		fmt.println(io.is(outcome, .Out_Of_Memory));
	}

	fmt.println(succeeded(os.unset_environment(name)));

	// The success path, which the arena above deliberately never reaches: a value
	// set and read back is the same value, and a name that was never set is
	// `.none` rather than an error.
	switch (os.set_environment(name, "round=trip")) {
	case .ok:
	case .err: fmt.println("set failed");
	}
	switch (os.get_environment(name)) {
	case .ok(found):
		switch (found) {
		case .some(text): fmt.println(text == "round=trip");
		case .none: fmt.println("unexpectedly none");
		}
	case .err: fmt.println("get failed");
	}
	switch (os.get_environment("LOKE_STDLIB_NEVER_SET_4A19")) {
	case .ok(missing):
		switch (missing) {
		case .some: fmt.println("unexpectedly some");
		case .none: fmt.println(true);
		}
	case .err: fmt.println("get failed");
	}
	fmt.println(succeeded(os.unset_environment(name)));

	// U+0000 would end the wide value early and store `a` instead.
	zero := [?]u8{u8('a'), 0, u8('b')};
	switch (os.set_environment(name, string.from_utf8(zero[:]) or_else "")) {
	case .ok:  fmt.println(false);
	case .err(outcome): fmt.println(io.is(outcome, .Invalid_Data));
	}
	switch (os.get_environment(name)) {
	case .ok(found):
		switch (found) {
		case .some: fmt.println(false);
		case .none: fmt.println(true);
		}
	case .err: fmt.println("get failed");
	}

	// Invalid names fail before reaching the platform, including read and remove.
	zero_name := string.from_utf8(zero[:]) or_else "";
	invalid_names := [?]string_view{"", "LOKE_BAD=NAME_7E2C", "=C:", zero_name};
	foreach (invalid in invalid_names) {
		switch (os.get_environment(invalid)) {
		case .ok:  fmt.println(false);
		case .err(error): fmt.println(io.is(error, .Invalid_Data), io.operation_of(error) == .Environment, io.native_code_of(error) == 0);
		}
		switch (os.set_environment(invalid, "value")) {
		case .ok:  fmt.println(false);
		case .err(error): fmt.println(io.is(error, .Invalid_Data), io.operation_of(error) == .Environment, io.native_code_of(error) == 0);
		}
		switch (os.unset_environment(invalid)) {
		case .ok:  fmt.println(false);
		case .err(error): fmt.println(io.is(error, .Invalid_Data), io.operation_of(error) == .Environment, io.native_code_of(error) == 0);
		}
	}

	// The working directory round trip. Printed as booleans, so the case does not
	// depend on where the harness runs it from.
	start := "";
	switch (os.working_directory()) {
	case .ok(here):  start = here;
	case .err: fmt.println("cwd failed");
	}
	parent := path.directory(start);
	fmt.println(start.len() > 0, path.is_absolute(start));
	fmt.println(succeeded(os.set_working_directory(parent)));
	switch (os.working_directory()) {
	case .ok(moved):  fmt.println(moved == parent, moved != start);
	case .err: fmt.println("cwd failed");
	}
	fmt.println(succeeded(os.set_working_directory(start)));
	// A directory that cannot exist is an error, not a silent no-op.
	fmt.println(succeeded(os.set_working_directory("no_such_directory_4A19\\nested")));

	// The executable is always an absolute path to a real file.
	switch (os.executable_path()) {
	case .ok(exe):
		fmt.println(exe.len() > 0, path.is_absolute(exe), path.base(exe).len() > 0);
		// An existing file cannot be the working directory: ERROR_DIRECTORY.
		switch (os.set_working_directory(exe)) {
		case .ok:  fmt.println(false);
		case .err(error): fmt.println(io.is(error, .Invalid_Path), io.operation_of(error) == .Working_Directory, io.native_code_of(error) == 267);
		}
	case .err(exe): fmt.println("exe failed");
	}
	// An incomplete extended UNC path keeps its path error and native code.
	switch (os.set_working_directory("\\\\?\\UNC\\")) {
	case .ok:  fmt.println(false);
	case .err(error): fmt.println(io.is(error, .Invalid_Path), io.operation_of(error) == .Working_Directory, io.native_code_of(error) != 0);
	}
}
