package main;

import "core:fmt";
import "core:unsafe";

// design.md "Uninitialized capacity": a fixed array field whose live prefix
// another field counts, and the two `core:unsafe` operations that move values
// across that boundary.
//
// The element is a managed owner, so every claim here is observable: a slot
// behind the count is never cloned and never released, and one in front of it
// is cloned and released exactly once.

Tracked :: struct { id: int }
impl Tracked {
	release :: hook(drop) proc(self: inout Tracked) { fmt.println("drop", self.id); }
}

// No zero value and no copy: the element kind a `[N]T` field could not hold at
// all, because the record would need a zero for it.
Held :: move_only struct { id: int }
Sealed :: union { first: Held, second: Held }

Buffer :: struct($T: type, $N: int) {
	@(public, initialized = count) items: [N]T,
	@(public) count: int,
}

Counter_First :: struct($T: type, $N: int) {
	@(public) count: int,
	@(public, initialized = count) items: [N]T,
}

impl Buffer($T, $N) {
	len :: proc(self) -> int { return self.count; }

	push :: proc(self: inout, value: move T) {
		unsafe.write(self.items[self.count], move(value));
		self.count += 1;
	}

	// The copying way in: a borrowed value is cloned into the storage, exactly
	// as an initialization takes it.
	put :: proc(self: inout, value: T) where is_copyable(T) {
		unsafe.write(self.items[self.count], value);
		self.count += 1;
	}

	// The count shortens first, so the slot the value leaves is capacity again
	// by the time anything could unwind through it.
	pop :: proc(self: inout) -> T {
		self.count -= 1;
		return unsafe.take(self.items[self.count]);
	}

	view :: proc(self: ^) -> []T { return self.items[0:self.count]; }
}

id_of :: proc(value: Sealed) -> int {
	switch (held in value) {
	case .first:  return held.id;
	case .second: return held.id;
	}
	return 0;
}

capacity_round_trip :: proc() -> int {
	buffer: Buffer(int, 2) = {};
	unsafe.write(buffer.items[0], 7);
	buffer.count = 1;
	value := unsafe.take(buffer.items[0]);
	buffer.count = 0;
	assert(buffer == Buffer(int, 2){});
	return value;
}

CAPACITY_ROUND_TRIP :: capacity_round_trip();

No_Zero :: enum { One = 1, Two = 2 }

Huge :: struct { pad: [4611686018427387904]u8 }
Fallible :: struct { id: int }
impl Fallible {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Fallible, Allocator_Error) {
		p := new(Huge, allocator) or_return;
		free(p);
		return .ok(self);
	}
	release :: hook(drop) proc(self: inout Fallible) { fmt.println("fallible drop", self.id); }
}

main :: proc() {
	// Both operations are phase-neutral when the storage is evaluator-owned.
	fmt.println(CAPACITY_ROUND_TRIP);

	// The empty record is all-zero even when a capacity element's own type has no
	// zero. This is compiled under every optimization mode by the run corpus.
	codes: Buffer(No_Zero, 2) = {};
	fmt.println(codes.count, codes.count == 0);

	// A record holding capacity has a zero value whatever the element is.
	sealed: Buffer(Sealed, 4) = {};
	fmt.println(sealed.len());
	one: Sealed = .first(Held{1});
	two: Sealed = .second(Held{2});
	sealed.push(move(one));
	sealed.push(move(two));
	fmt.println(sealed.len(), id_of(sealed.view()[0]), id_of(sealed.view()[1]));
	taken := sealed.pop();
	fmt.println(id_of(taken), sealed.len());

	// A managed element: two pushed, one retired. The retired slot keeps the
	// bits of a value that no longer exists, and neither the copy below nor the
	// drop at the end of the scope may read them.
	owners: Buffer(Tracked, 4) = {};
	first := Tracked{10};
	second := Tracked{20};
	owners.push(move(first));
	owners.push(move(second));
	retired := owners.pop();
	fmt.println("retired", retired.id, owners.len());
	drop(retired);

	copied := owners;
	fmt.println("copied", copied.len(), copied.view()[0].id);

	// The capacity a retired element left behind is not part of the value, so
	// equality and formatting stop at the count as the copy and the drop do.
	left: Buffer(int, 4) = {};
	right: Buffer(int, 4) = {};
	left.put(1);
	left.put(2);
	left.put(3);
	_ = left.pop();
	right.put(1);
	right.put(2);
	fmt.println(left == right, left);

	// A count declared before its array is already copied when the first element
	// clone fails. Partial cleanup must still use the local progress of zero.
	{
		source: Counter_First(Fallible, 2) = {};
		failing := Fallible{1};
		unsafe.write(source.items[0], move(failing));
		source.count = 1;
		switch (_ in source.try_clone()) {
		case .ok: fmt.println("unexpected clone");
		case .err: fmt.println("clone failed");
		}
	}

	fmt.println("scope end");
}
