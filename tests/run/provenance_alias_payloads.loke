// design.md "Weakening and reborrows" and "Allocator regions and region provenance":
// read-only success payloads keep their targets; writable payloads allow default owners.
package main;
import "core:mem";
import "core:fmt";

kept: Option([dynamic]string);
Wrapper :: struct { pointer: ^mut ^mut Option([dynamic]string) }
Read_Only :: struct { pointer: ^ ^mut Option([dynamic]string) }
Mixed :: struct { first: ^ ^mut Option([dynamic]string), second: ^mut ^mut Option([dynamic]string) }
inspect :: proc(pointer: ^ ^mut Option([dynamic]string)) {}
inspect_mixed :: proc(wrapper: Mixed) {}
inspect_box :: proc(wrapper: Box(Read_Only)) {}
inspect_keys :: proc(pointers: map[^ ^mut Option([dynamic]string)]int) {}
read_only_success :: proc() {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	pointer := &mut value;
	maybe: Option(^mut ^mut Option([dynamic]string)) = .some(&mut pointer);
	inspect(maybe or_else return);
	inspect(Option(^mut ^mut Option([dynamic]string)).some(&mut pointer) or_else return);
	nested: Option(Option(^mut ^mut Option([dynamic]string))) = .some(.some(&mut pointer));
	inspect((nested or_else return) or_else return);
	switch (pointer^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 10));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}
read_only_fallback :: proc() {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	pointer := &mut value;
	maybe: Option(^mut ^mut Option([dynamic]string)) = .none;
	inspect(maybe or_else &mut pointer);
	switch (pointer^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 11));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}
read_only_fields :: proc() {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	other: Option([dynamic]string) = .none;
	first := &mut value;
	second := &mut other;
	maybe: Option(Mixed) = .some(Mixed{&first, &mut second});
	inspect_mixed(maybe or_else return);
	switch (first^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 12));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}
read_only_containers :: proc() {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	pointer := &mut value;
	wrapper := box(Read_Only{&pointer});
	inspect_box(wrapper);
	pointers := map[^ ^mut Option([dynamic]string)]int{&pointer = 0};
	inspect_keys(pointers);
	switch (pointer^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 13));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}
retarget_box :: proc(wrapper: Box(Wrapper)) { wrapper.pointer^ = &mut kept; }
retarget_slice :: proc(pointers: []^mut ^mut Option([dynamic]string)) {
	if (pointers.len() > 0) { pointers[0]^ = &mut kept; }
}
retarget_keys :: proc(pointers: map[^mut ^mut Option([dynamic]string)]int) {
	foreach (pointer, _ in pointers) { pointer^ = &mut kept; break; }
}
append_default :: proc(pointer: ^mut Option([dynamic]string), value: int) {
	switch (pointer^) {
	case .some(&mut values): values.append(fmt.to_string(mem.default_allocator(), value));
	case .none:
	}
}

literal_slice :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	retarget_slice([]^mut ^mut Option([dynamic]string){&mut pointer});
	append_default(pointer, 1);
}

literal_dynamic :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	retarget_slice([dynamic]^mut ^mut Option([dynamic]string){&mut pointer});
	append_default(pointer, 2);
}

stored_box :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	wrapper := box(Wrapper{&mut pointer});
	retarget_box(wrapper);
	append_default(pointer, 3);
}

inline_box :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	retarget_box(box(Wrapper{&mut pointer}));
	append_default(pointer, 4);
}

fallible_box :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	maybe := try_box(Wrapper{&mut pointer});
	retarget_box(maybe or_else return);
	append_default(pointer, 5);
}

stored_map_key :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	pointers := map[^mut ^mut Option([dynamic]string)]int{&mut pointer = 0};
	retarget_keys(pointers);
	append_default(pointer, 6);
}

inspect_box_mixed :: proc(wrapper: Box(Mixed)) {}
inspect_view_mixed :: proc(wrapper: ^Mixed) {}
inspect_values :: proc(pointers: []^mut Option([dynamic]string)) {}
inspect_readers :: proc(pointers: []^ ^mut Option([dynamic]string)) {}
retarget_view :: proc(wrapper: ^Wrapper) { wrapper.pointer^ = &mut kept; }
replace_element :: proc(pointers: []mut ^mut Option([dynamic]string)) { pointers[0] = &mut kept; }

stored_read_only_success :: proc(named: bool, mark: int) {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	other: Option([dynamic]string) = .none;
	first := &mut value;
	second := &mut other;
	if (named) {
		result := try_box(Mixed{&first, &mut second});
		boxed := result or_else return;
		inspect_box_mixed(boxed);
	} else {
		boxed := try_box(Mixed{&first, &mut second}) or_else return;
		inspect_box_mixed(boxed);
	}
	switch (first^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), mark));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}
stored_read_only_view :: proc() {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	other: Option([dynamic]string) = .none;
	first := &mut value;
	second := &mut other;
	boxed := box(Mixed{&first, &mut second});
	view: ^Mixed = boxed;
	inspect_view_mixed(view);
	switch (first^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 16));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}
literal_element_target :: proc() {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	pointers := []^mut Option([dynamic]string){&mut value};
	inspect_values(pointers);
	switch (pointers[0]^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 17));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}
literal_read_only_target :: proc() {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	pointer := &mut value;
	pointers := []^ ^mut Option([dynamic]string){&pointer};
	inspect_readers(pointers);
	switch (pointer^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 18));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
}

implicit_box_view :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	boxed := box(Wrapper{&mut pointer});
	retarget_view(boxed);
	append_default(pointer, 7);
}

stored_box_view :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	boxed := box(Wrapper{&mut pointer});
	view: ^Wrapper = boxed;
	retarget_view(view);
	append_default(pointer, 8);
}

temporary_box_view :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	view: ^Wrapper = box(Wrapper{&mut pointer});
	retarget_view(view);
	append_default(pointer, 9);
}

implicit_array_view :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	pointers := [dynamic]^mut ^mut Option([dynamic]string){&mut pointer};
	retarget_slice(pointers);
	append_default(pointer, 10);
}

stored_array_view :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	pointers := [dynamic]^mut ^mut Option([dynamic]string){&mut pointer};
	view: []^mut ^mut Option([dynamic]string) = pointers;
	retarget_slice(view);
	append_default(pointer, 11);
}

copied_slice_literal :: proc() {
	local: Option([dynamic]string) = .none;
	pointer := &mut local;
	pointers := []^mut ^mut Option([dynamic]string){&mut pointer};
	copy := pointers;
	retarget_slice(copy);
	append_default(pointer, 12);
}

copied_mutable_slice :: proc() {
	local: Option([dynamic]string) = .none;
	pointers := []mut ^mut Option([dynamic]string){&mut local};
	copy := pointers;
	replace_element(copy);
	append_default(pointers[0], 13);
}

direct_propagated_success :: proc() -> Result(int, Allocator_Error) {
	arena := mem.Arena.init();
	value: Option([dynamic]string) = .some(make([dynamic]string));
	other: Option([dynamic]string) = .none;
	first := &mut value;
	second := &mut other;
	inspect_box_mixed(try_box(Mixed{&first, &mut second}) or_return);
	switch (first^) {
	case .some(&mut values): values.append(fmt.to_string(arena.allocator(), 19));
	case .none:
	}
	fmt.println(value);
	drop(value);
	free_all(arena.allocator());
	return .ok(19);
}

main :: proc() {
	read_only_success();
	read_only_fallback();
	read_only_fields();
	read_only_containers();
	stored_read_only_success(false, 14);
	stored_read_only_success(true, 15);
	stored_read_only_view();
	literal_element_target();
	literal_read_only_target();
	assert((direct_propagated_success() or_else return) == 19);
	kept = .some(make([dynamic]string));
	literal_slice();
	literal_dynamic();
	stored_box();
	inline_box();
	fallible_box();
	stored_map_key();
	implicit_box_view();
	stored_box_view();
	temporary_box_view();
	implicit_array_view();
	stored_array_view();
	copied_slice_literal();
	copied_mutable_slice();
	fmt.println(kept);
}
