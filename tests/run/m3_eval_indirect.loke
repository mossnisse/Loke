package main; import "core:fmt";

pair :: proc() -> (low: int, high: int) {
	return {low = 20, high = 22};
}

call_pair :: proc(f: proc() -> (low: int, high: int)) -> int {
	a, b := f();
	return a + b;
}

compute :: proc() -> int {
	// This aggregate is larger than the old scratch arena's single block.
	values: [10_000]int;
	f := proc(n: int) -> int { return n * 2; };
	return f(call_pair(pair));
}

VALUE :: compute();

main :: proc() {
	fmt.println(VALUE);
}
