// design.md "Floating-point operators": `a*b + c` rounds twice, at every
// optimization level and CPU level, and `math.fma` rounds once, whether it is
// the FMA instruction, `core:math`'s integer arithmetic, or the compile-time
// evaluator. `tests/cpu_test.odin` builds this at each `-cpu` level against the
// one `.expected`, so a level that fused a product into a sum, or computed a
// different `fma`, changes a line.
package main;

import "core:fmt";
import "core:math";
import "core:os";
import "core:unsafe";

bits64 :: proc(x: f64) -> u64 { return unsafe.transmute(u64, x); }
bits32 :: proc(x: f32) -> u32 { return unsafe.transmute(u32, x); }

// One with no constant value, so nothing below folds.
runtime_one :: proc() -> f64 { return f64(os.args.len()); }

// `(1 + 2^-27)(1 - 2^-27)` is `1 - 2^-54`, which the rounded product cannot
// hold: unfused it rounds to 1 and the sum is 0, fused the sum is `-2^-54`.
// At `f32`, `(1 + 2^-12)(1 - 2^-13)` loses its `-2^-25` the same way.
contraction :: proc() {
	one := runtime_one();
	a := one + 7.450580596923828e-09;
	b := one - 7.450580596923828e-09;
	fmt.println(a*b - one, a*b + (0.0 - one), math.fma(a, b, 0.0 - one));
	a32 := f32(one) + f32(0.000244140625);
	b32 := f32(one) - f32(0.0001220703125);
	fmt.println(a32*b32 - f32(one), math.fma_f32(a32, b32, f32(0.0) - f32(one)));

	// The shape a vectorizer widens: every lane is still two roundings.
	xs: [8]f64 = {};
	ys: [8]f64 = {};
	zs: [8]f64 = {};
	foreach (i in 0 ..< 8) {
		xs[i] = a;
		ys[i] = b;
		zs[i] = 0.0 - one;
	}
	out: [8]f64 = {};
	foreach (i in 0 ..< 8) { out[i] = xs[i]*ys[i] + zs[i]; }
	fmt.println(out[0], out[3], out[7]);
	// And an accumulation, whose order is the source's.
	sum := 0.0;
	foreach (i in 0 ..< 8) { sum = sum + xs[i]*ys[i]; }
	fmt.println(sum - 8.0*one);
}

// A finite operand of a generated case: a random significand at an exponent
// within `spread` of `centre`, with a random sign.
Generator :: struct {
	state: u64,
}

next :: proc(g: inout Generator) -> u64 {
	g.state = g.state *% 6364136223846793005 +% 1442695040888963407;
	return g.state >> 11;
}

operand :: proc(g: inout Generator, centre: int, spread: int) -> f64 {
	fraction := next(inout g) & ((u64(1) << 52) - 1);
	exponent := centre + int(next(inout g) % u64(2*spread + 1)) - spread;
	sign := (next(inout g) & 1) << 63;
	return unsafe.transmute(f64, sign | (u64(exponent + 1023) << 52) | fraction);
}

operand32 :: proc(g: inout Generator, centre: int, spread: int) -> f32 {
	fraction := math.wrap(u32, next(inout g)) & ((u32(1) << 23) - 1);
	exponent := centre + int(next(inout g) % u64(2*spread + 1)) - spread;
	sign := u32(next(inout g) & 1) << 31;
	return unsafe.transmute(f32, sign | (u32(exponent + 127) << 23) | fraction);
}

// A digest of `fma` over cases built to land near each other: an addend close
// to minus the product cancels most of it, and products near the bottom of the
// range round as subnormals. `scale` multiplies every operand by one, so the
// run-time call sees operands with no constant value.
fused_digest :: proc(scale: f64) -> u64 {
	g := Generator{state = 0x9e3779b97f4a7c15};
	digest: u64 = 0;
	foreach (i in 0 ..< 160) {
		centre := 0;
		if (i % 4 == 3) { centre = -530; }
		a := operand(inout g, centre, 3)*scale;
		b := operand(inout g, centre, 3)*scale;
		c := 0.0 - a*b;
		if (i % 2 == 0) { c = operand(inout g, 2*centre, 60)*scale; }
		if (i % 8 == 1) { c = c + operand(inout g, 2*centre - 50, 4); }
		digest = (digest ~ bits64(math.fma(a, b, c))) *% 1099511628211;
	}
	return digest;
}

fused_digest32 :: proc(scale: f32) -> u64 {
	g := Generator{state = 0x2545f4914f6cdd1d};
	digest: u64 = 0;
	foreach (i in 0 ..< 160) {
		centre := 0;
		if (i % 4 == 3) { centre = -65; }
		a := operand32(inout g, centre, 3)*scale;
		b := operand32(inout g, centre, 3)*scale;
		c := f32(0.0) - a*b;
		if (i % 2 == 0) { c = operand32(inout g, 2*centre, 20)*scale; }
		if (i % 8 == 1) { c = c + operand32(inout g, 2*centre - 22, 3); }
		digest = (digest ~ u64(bits32(math.fma_f32(a, b, c)))) *% 1099511628211;
	}
	return digest;
}

FUSED :: fused_digest(1.0);
FUSED32 :: fused_digest32(f32(1.0));

main :: proc() {
	contraction();
	run := fused_digest(runtime_one());
	run32 := fused_digest32(f32(runtime_one()));
	fmt.println(run == FUSED, run32 == FUSED32);
	fmt.println(run, run32);
}
