package main; import "core:fmt"; import "core:container";

// design.md "Zero values": a union with no `@(zero=)` has none, and every
// operation that would manufacture one is rejected for it. This is the other
// half of that rule — everything that manufactures no zero keeps working, so a
// no-zero element is an ordinary element of both containers.
//
// The rejections are in `tests/err/zero_values.loke`.

Choice :: union { a: i32, b: bool }

Tracked :: struct { id: int }
impl Tracked {
	release :: hook(drop) proc(self: inout Tracked) { fmt.println("drop", self.id); }
}
Tracked_Choice :: union { a: Tracked, b: Tracked }

// An enum with no member represented by zero has no zero value either.
Priority :: enum{Low = 1, High = 2};
Slot :: enum{First, Second, Third};
Nothing :: enum{};

succeeded :: proc(outcome: Result(Unit, Allocator_Error)) -> bool {
	switch (_ in outcome) {
	case .ok:  return true;
	case .err: return false;
	}
	return false;
}

main :: proc() {
	// A map: nothing here manufactures a zero, so a no-zero element is indexed,
	// inserted and read like any other. The contextual `.a(3)` takes its type
	// from the member's parameter.
	m: map[int]Choice = {};
	fmt.println(succeeded(m.try_insert(1, .a(3))));
	fmt.println(m.len(), 1 in m);
	switch (v in m.lookup_value(1)) {
	case .some: fmt.println(v);
	case .none: fmt.println("missing");
	}
	switch (p in m.find(1)) {
	case .some: p^ = .b(true);
	case .none:
	}
	fmt.println(m.lookup_value(1) or_else .b(false));
	switch (taken in m.remove(1)) {
	case .some: fmt.println("removed", taken);
	case .none: fmt.println("absent");
	}
	fmt.println(m.len());

	// The index forms: `m[key] = elem` writes a whole element, and every other
	// position reads or writes one that is there.
	m[2] = .b(true);
	fmt.println(m[2]);
	m[2] = .a(5);
	fmt.println(m[2], m.len());
	fmt.println(m.find_or_insert(3, .a(6))^);
	fmt.println(m.find_or_insert(3, .a(7))^, m.len());
	slot := &m[3];
	fmt.println(slot^);

	// A dynamic array: appending writes elements and popping moves one out.
	// Reserving raw capacity initialises nothing.
	xs: [dynamic]Choice = {};
	xs.append(.a(1));
	xs.append(.b(true), .a(2));
	fmt.println(xs.len(), xs[0], xs[1], xs[2]);
	fmt.println(xs.pop() or_else .a(0));
	fmt.println(xs.len());
	xs.reserve(16);
	fmt.println(xs.cap() >= 16, xs.len());
	xs.remove(0);
	fmt.println(xs.len(), xs[0]);
	xs.clear();
	fmt.println(xs.len());

	// A capacity with no length allocates storage and initialises nothing.
	ys := make([dynamic]Choice, 0, 8) or_else {};
	fmt.println(ys.len(), ys.cap() >= 8);

	// An empty fixed array of them has a zero, because it holds no element.
	none: [0]Choice = {};
	fmt.println(none.len());

	// design.md "Uninitialized capacity": a fixed-capacity container reserves
	// storage rather than elements, so it imposes exactly what the dynamic array
	// above does -- nothing. This is the same sequence, inline.
	inline: container.Small_Array(Choice, 4) = {};
	fmt.println(inline.len(), inline.is_empty());
	inline.append(.a(1), .b(true), .a(2));
	fmt.println(inline.len(), inline[0], inline[2]);
	fmt.println(inline.pop() or_else .a(0), inline.len());
	fmt.println(inline.remove(0), inline.len(), inline[0]);
	inline.clear();
	fmt.println(inline.len());

	// The retired elements were taken out rather than overwritten, so a managed
	// one is released once, when it is dropped -- not again behind the length.
	{
		held: container.Small_Array(Tracked_Choice, 3) = {};
		one: Tracked_Choice = .a(Tracked{1});
		two: Tracked_Choice = .b(Tracked{2});
		held.append_moved(move(one));
		held.append_moved(move(two));
		taken := held.remove(0);
		drop(taken);
		fmt.println(held.len());
	}

	// A new map entry is raw inert storage until the supplied no-zero value is
	// committed. Its zeroed bytes are never passed to the drop hook.
	{
		tracked: map[int]Tracked_Choice = {};
		_ = tracked.try_insert(1, .a(Tracked{7}));
	}
	{
		literal := map[int]Tracked_Choice{
			1 = .b(Tracked{8}),
			1 = .a(Tracked{9}),
		};
		fmt.println(literal.len());
	}

	// An `Enum_Array` has no zero value when its element has none, so `filled`
	// is how one is made, and it builds each slot from the value it is given.
	priorities := container.Enum_Array(Slot, Priority).filled(.Low);
	priorities[.Second] = .High;
	fmt.println(priorities);
	choices := container.Enum_Array(Slot, Choice).filled(.b(true));
	choices[.First] = .a(4);
	fmt.println(choices, choices[.Third]);
	fmt.println(container.Enum_Array(Nothing, Choice).filled(.a(1)).len());
	{
		held := container.Enum_Array(Slot, Tracked_Choice).filled(.a(Tracked{5}));
		fmt.println(held.len());
	}
}
