package main;
import "core:fmt";
import "core:mem";

pick :: proc(input, scratch: []int) -> []int { return input; }
same :: proc(input, scratch: []int) -> []int { return input; }
Pick :: type_of(pick);

run :: proc(callback: Pick, input: []int) -> []int {
	scratch := [2]int{7, 8};
	return callback(input, scratch[:]);
}
stored :: proc(input: []int) -> []int {
	callback := pick;
	callback = same;
	scratch := [1]int{9};
	return callback(input, scratch[:]);
}

Inline :: struct { items: [2]int }
impl Inline {
	view :: proc(self) -> []int { return self.items[:]; }
	sum :: proc(self) -> int { return self.items[0] + self.items[1]; }
}
read :: proc(callback: proc(self: borrow Inline) -> []int, value: borrow Inline) -> []int {
	return callback(value);
}
borrow_two :: proc(unused: int, value: borrow Inline) -> []int { return value.items[:]; }

Pair :: struct { first, second: []int }
pair :: proc(a, b: []int) -> Pair { return {a, b}; }
select_first :: proc(value: Pair) -> []int { return value.first; }
field_paths :: proc(input: []int) -> []int {
	scratch := [1]int{0};
	f := pair;
	result := f(input, scratch[:]);
	g := select_first;
	return g(result);
}
forward :: proc(callback: $T) -> T { return callback; }
recurse :: proc(input, scratch: []int, count: int) -> []int {
	if (count == 0) { return input; }
	f := recurse;
	return f(input, scratch, count - 1);
}
recursive_reader :: proc(input: []int) -> []int {
	scratch := [1]int{0};
	f := forward(recurse);
	return f(input, scratch[:], 2);
}

dropped: int;
Owned :: struct { value: int }
impl Owned {
	release :: hook(drop) proc(self: inout Owned) { dropped += 1; }
	read :: proc(self) -> int { return self.value; }
}
CONSTANT :: Inline{{8, 9}};
constant_view :: proc() -> []int {
	f := Inline.view;
	return f(CONSTANT);
}

allocate :: proc() -> ^mut int { return new(int) or_else nil; }
read_erased :: proc(value: borrow any_view) -> int { return value.as(int) or_else 0; }
view_length :: proc(value: borrow string_view) -> int { return value.len(); }

choose_allocator :: proc(first, second: Allocator) -> Allocator { return first; }
retain_allocator :: proc(input: Allocator) -> Allocator {
	scratch := mem.Arena.init();
	callback := choose_allocator;
	return callback(input, scratch.allocator());
}

main :: proc() {
	values := [2]int{1, 2};
	fmt.println(run(pick, values[:])[0], stored(values[:])[1]);
	value := Inline{{3, 4}};
	callback := Inline.view;
	fmt.println(callback(value)[0]);
	fmt.println(read(Inline.view, value)[1]);
	summer: proc(self: borrow Inline) -> int = Inline.sum;
	fmt.println(summer(value), borrow_two(0, value)[0]);
	assert(field_paths(values[:])[0] == 1);
	assert(recursive_reader(values[:])[1] == 2);
	assert(constant_view()[0] == 8);
	reader := Owned.read;
	assert(reader(Owned{5}) == 5);
	assert(dropped == 1);
	chosen: Pick = pick if values[0] == 1 else same;
	assert(run(chosen, values[:])[0] == 1);
	allocator := allocate;
	pointer := allocator();
	if (pointer != nil) { pointer^ = 12; assert(pointer^ == 12); free(pointer); }
	assert(read_erased(37) == 37);
	text: string = "hello";
	assert(view_length(text) == 5);
	arena := mem.Arena.init();
	data: [dynamic]int via retain_allocator(arena.allocator()) = {};
	data.append(11);
	assert(data[0] == 11);
}
