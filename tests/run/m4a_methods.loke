package main; import "core:fmt";

Vector2 :: struct { x, y: i32 }

impl Vector2 {
	zero :: Vector2{0, 0};
	Element :: i32;

	length_squared :: proc(self) -> i32 {
		return self.x*self.x + self.y*self.y;
	}

	scale :: proc(self: inout Vector2, factor: i32) {
		self.x *= factor;
		self.y *= factor;
	}

	consume :: proc(self: move Vector2) -> i32 { return self.x; }

	// The receiver followed by typed parameters: `self` is the receiver, not a
	// name sharing the group's written type. It keeps its immutable-borrow mode
	// whatever the group wrote, and a default written for the group belongs to
	// the parameters rather than to `self`.
	dot :: proc(self, other: Vector2) -> i32 { return self.x*other.x + self.y*other.y; }
	shifted :: proc(self, by: i32 = 10) -> i32 { return self.x + by; }

	components :: proc(x, y: i32) -> Vector2 { return {x, y}; }
	splat :: proc(value: i32) -> Vector2 { return {value, value}; }
}

Complex :: struct { real, imaginary: f64 }

impl Complex {
	components :: proc(real, imaginary: f64) -> Complex { return {real, imaginary}; }

	@(implicit)
	from_scalar :: hook(convert) proc(value: f64) -> Complex { return {value, 0}; }

	// A first parameter typed `^T` is not a receiver: no method sugar.
	bump :: proc(self: ^Complex) { self.real = self.real + 1.0; }
}

magnitude2 :: proc(z: Complex) -> f64 { return z.real*z.real + z.imaginary*z.imaginary; }

Meters :: distinct f64;
Kilometers :: distinct f64;

impl Kilometers {
	from_meters :: hook(convert) proc(value: Meters) -> Kilometers {
		return Kilometers(f64(value) / 1000.0);
	}
}

main :: proc() {
	v := Vector2{3, 4};
	fmt.println(int(v.length_squared()));
	// Method-call syntax is uniform procedure-call syntax.
	fmt.println(int(Vector2.length_squared(v)));
	fmt.println(int(v.dot(Vector2{2, 1})));
	fmt.println(int(v.shifted()));
	fmt.println(int(v.shifted(1)));
	fmt.println(int(Vector2.dot(v, v)));
	v.scale(2);
	fmt.println(int(v.x));
	fmt.println(int(move(v).consume()));

	origin := Vector2.zero;
	fmt.println(int(origin.x));
	e: Vector2.Element = 9;
	fmt.println(int(e));

	a := Vector2{1, 2};
	fmt.println(int(a.y));
	b := Vector2.splat(5);
	fmt.println(int(b.x) + int(b.y));

	z := Complex.components(3.0, 4.0);
	fmt.println(int(magnitude2(z)));
	// `2.0` is an untyped float constant, so `@(implicit)` applies.
	fmt.println(int(magnitude2(2.0)));
	scale: f64 = 5.0;
	fmt.println(int(magnitude2(Complex(scale))));
	Complex.bump(&z);
	fmt.println(int(z.real));
	distance := Kilometers(Meters(2000.0));
	fmt.println(int(f64(distance)));
}
