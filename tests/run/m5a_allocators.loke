package main; import "core:mem"; import "core:fmt";

// design.md "Allocators" and "Allocation failure" (m5a-plan step 3): the
// explicitly fallible primitives always return their error and never invoke a
// failure policy.

Handle :: move_only struct {
	id:    int,
	valid: bool,
}

released: int;
order: int;

ordered_value :: proc() -> int {
	order = order * 10 + 1;
	return 8;
}

ordered_allocator :: proc() -> Allocator {
	order = order * 10 + 2;
	return mem.default_allocator();
}

impl Handle {
	release :: hook(drop) proc(self: inout Handle) {
		if (self.valid) {
			self.valid = false;
			released += 1;
		}
	}
}

Counter :: struct {
	count: int,
}

impl Counter {
	// The canonical fallible hook, written with the fixed signature. The
	// allocator default is supplied by the compiler until `core:mem` is nameable
	// in M6.
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Counter, Allocator_Error) {
		return .ok(Counter{self.count + 1});
	}
}

// design.md "Typed fallibility": an allocating call returns
// `Result(T, Allocator_Error)`, so it propagates with `or_return` rather than
// an explicit test.
direct :: proc() -> Result(int, Allocator_Error) {
	p := try_box(0) or_return;
	p^ = 11;
	return .ok(p^);
}

// The same propagation into a user's own two-variant failure union, which
// `or_return` recognises structurally rather than by name.
Boxed :: union @(failure=broke) { held: int, broke: Allocator_Error }

wrapped :: proc() -> Boxed {
	p := try_box(0) or_return;
	p^ = 12;
	return .held(p^);
}

main :: proc() {
	// `try_box` reports failure explicitly.
	switch (try_box(0)) {
	case .ok(p):
		fmt.println(p^);
		p^ = 42;
		fmt.println(p^);
	case .err:
		fmt.println(-1);
		return;
	}

	// It takes its value as an initialization does, before its allocator.
	switch (try_box(7)) {
	case .ok(q):  fmt.println(q^);
	case .err:
	}
	switch (try_box(ordered_value(), ordered_allocator())) {
	case .ok:  fmt.println(order);
	case .err:
	}

	// An explicit allocator argument selects the same default provider.
	a := mem.default_allocator();
	switch (try_box(Counter{}, a)) {
	case .ok(r):  fmt.println(r^.count);
	case .err:
	}

	// The public `try_clone` wrapper returns the copy hook's error.
	one := Counter{5};
	switch (one.try_clone(a)) {
	case .ok(two):  fmt.println(two.count);
	case .err:
	}

	// The implementation hook is hidden behind the public `drop` operation.
	h := Handle{1, true};
	drop(h);
	if (released == 1) {
		fmt.println(1);
	}

	// `or_return` propagates an `Allocator_Error`, directly and through a
	// user-declared failure union.
	fmt.println(direct() or_else -1);
	fmt.println(1);
	fmt.println(wrapped() or_else -1);
	fmt.println(1);

	// `or_else` takes the same result and supplies a value instead of it.
	s := try_box(13) or_else box(-1);
	fmt.println(s^);
}
