package main; import "core:mem"; import "core:fmt";

// design.md "Allocators" and "Allocation failure" (m5a-plan step 3): the
// explicitly fallible primitives always return their error and never invoke a
// failure policy, and `free` returns no status.

Handle :: move_only struct {
	id:    int,
	valid: bool,
}

released: int;

impl Handle {
	release :: hook(drop) proc(self: inout Handle) {
		if (self.valid) {
			self.valid = false;
			released += 1;
		}
	}
}

Counter :: struct {
	count: int,
}

impl Counter {
	// The canonical fallible hook, written with the fixed signature. The
	// allocator default is supplied by the compiler until `core:mem` is nameable
	// in M6.
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> (Counter, Allocator_Error) {
		return Counter{self.count + 1}, nil;
	}
}

// design.md "Status results": `Allocator_Error` is a nil status, so an
// allocating call propagates with `or_return` rather than an explicit test.
direct :: proc() -> (n: int, err: Allocator_Error) {
	n = 0;
	p := new(int) or_return;
	p^ = 11;
	n = p^;
	free(p);
	return;
}

// The same propagation into a union that carries the allocator's error.
Boxed :: union { Allocator_Error }

wrapped :: proc() -> (n: int, err: Boxed) {
	n = 0;
	p := new(int) or_return;
	p^ = 12;
	n = p^;
	free(p);
	return;
}

main :: proc() {
	// `new` zero-initialises and reports failure explicitly.
	p, err := new(int);
	if (err != nil) {
		fmt.println(-1);
		return;
	}
	fmt.println(p^);
	p^ = 42;
	fmt.println(p^);
	free(p);

	// `new_clone` copies its operand into the fresh allocation.
	q, qerr := new_clone(7);
	if (qerr == nil) {
		fmt.println(q^);
		free(q);
	}

	// An explicit allocator argument selects the same default provider in M5a.
	a := mem.default_allocator();
	r, rerr := new(Counter, a);
	if (rerr == nil) {
		fmt.println(r^.count);
		free(r);
	}

	// The public `try_clone` wrapper returns the copy hook's error.
	one := Counter{5};
	two, cerr := one.try_clone(a);
	if (cerr == nil) {
		fmt.println(two.count);
	}

	// The implementation hook is hidden behind the public `drop` operation.
	h := Handle{1, true};
	drop(h);
	if (released == 1) {
		fmt.println(1);
	}

	// `or_return` propagates an `Allocator_Error`, directly and through a union.
	dn, derr := direct();
	fmt.println(dn);
	fmt.println(1 if derr == nil else 0);
	wn, werr := wrapped();
	fmt.println(wn);
	fmt.println(1 if werr == nil else 0);

	// `or_else` takes the same status and supplies a value instead of it.
	s := new(int) or_else nil;
	if (s != nil) {
		s^ = 13;
		fmt.println(s^);
		free(s);
	}
}
