// design.md "Borrows and lifetimes": an element's temporaries last until the literal's
// statement ends, but once the container holds an element of a type with no borrow, and
// it owes no drop, nothing names them, so a long literal of large calls does not keep a
// frame slot per element. 300 elements of 5000 bytes each overflowed the stack at -opt=none.
package main;

import "core:fmt";

Large :: struct { bytes: [5000]u8 }

made := 0;

make_large :: proc() -> Large {
	made += 1;
	out := Large{};
	out.bytes[0] = u8(made % 256);
	return out;
}

main :: proc() {
	items := [dynamic]Large{ make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), make_large(), 