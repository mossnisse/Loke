@(public)
package main;

import "base:interfaces";
import "core:fmt";
import "core:math";

// design.md "Integer overflow": the `core:math` policy procedures ask only for
// `interfaces.Integral`, which a distinct integer meets without wrapping
// operators of its own, so they wrap its representation instead.
Word :: distinct u32;

impl Word {
	delegate(+, -, *, /, %, |, ~, &, &~, ==, <);
	left :: operator(<<) proc(a: Word, count: uint) -> Word { return Word(u32(a) << count); }
	right :: operator(>>) proc(a: Word, count: uint) -> Word { return Word(u32(a) >> count); }
}
static_assert(interfaces.Integral(Word));

main :: proc() {
	fmt.println(
		u32(math.wrapping_add(Word(0xFFFF_FFFF), Word(2))), u32(math.wrapping_sub(Word(3), Word(5))),
		u32(math.wrapping_mul(Word(0x8000_0001), Word(2))),
	);
	fmt.println(math.checked_add(Word(3), Word(2)), math.checked_sub(Word(3), Word(5)));
	fmt.println(math.checked_mul(Word(0x8000_0000), Word(2)), math.checked_mul(Word(7), Word(6)));

	// A vector of distinct lanes wraps lane by lane through the representation.
	lanes: Simd(Word, 4) = {Word(0xFFFF_FFFF), Word(0), Word(3), Word(0x8000_0001)};
	ones: Simd(Word, 4) = {Word(1), Word(1), Word(5), Word(2)};
	fmt.println(
		Simd(u32, 4)(math.wrapping_add(lanes, ones)), Simd(u32, 4)(math.wrapping_sub(lanes, ones)),
		Simd(u32, 4)(math.wrapping_mul(lanes, ones)), WRAPPED_LANES,
	);
}

// The same at compile time.
wrapped_lanes :: proc() -> Simd(u32, 2) {
	return Simd(u32, 2)(math.wrapping_sub(Simd(Word, 2){Word(0), Word(7)}, Simd(Word, 2){Word(1), Word(9)}));
}
WRAPPED_LANES :: wrapped_lanes();
