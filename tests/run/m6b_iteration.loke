package main; import "core:fmt";

// Container iteration (m6b-plan step 4, first half).
//
// design.md: a dynamic array's value traversal yields its Element, while
// `indexed()` carries an index. A map's Element is its key/value entry and
// "**Iteration order is unspecified.**" So nothing here prints a map in table
// order; every map result is order-independent.
//
// Mutable map traversal is the value view; keys remain immutable.

main :: proc() {
	xs: [dynamic]int = {1, 2, 3};
	total := 0;
	foreach (v in xs) { total += v; }
	fmt.println(total);

	weighted := 0;
	foreach (v, i in xs.indexed()) { weighted += v * i; }
	fmt.println(weighted);

	// `&value` names the element in place.
	foreach (&v in xs) { v = v * 10; }
	fmt.println(xs[0]);
	fmt.println(xs[2]);

	// The value view selects mutable traversal through its `&` binding.
	some_map := map[string]int{"A" = 1, "C" = 9, "B" = 4};
	foreach (&value in some_map.values()) { value += 1; }
	fmt.println(some_map["A"]);
	fmt.println(some_map["C"]);
	fmt.println(some_map["B"]);

	// `values()` is the value-only traversal.
	sum := 0;
	foreach (v in some_map.values()) { sum += v; }
	fmt.println(sum);

	// Two names destructure the `{key, value}` entry; a managed key is borrowed.
	measured := 0;
	foreach (k, v in some_map) { measured += k.len() * v; }
	fmt.println(measured);

	// An empty container iterates zero times.
	empty: [dynamic]int = {};
	none: map[int]int = {};
	steps := 0;
	foreach (v in empty) { steps += 1; }
	foreach (k, v in none) { steps += 1; }
	fmt.println(steps);

	// Formatting through M6a's table, recursively. A dynamic array prints the
	// current allocation up to its length; a map prints `[key = value]` in slot
	// order, which is unspecified -- so only single-entry and empty maps are
	// printed here.
	fmt.println(xs);
	fmt.println(empty);
	fmt.println(none);
	one: map[string]int = {};
	one["only"] = 5;
	fmt.println(one);

	nested: [dynamic][dynamic]int = {};
	inner: [dynamic]int = {1, 2};
	nested.append(inner);
	fmt.println(nested);
	deep: map[int][dynamic]int = {};
	deep[7] = {8, 9};
	fmt.println(deep);
}
