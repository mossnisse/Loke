package main; import "core:fmt";

// Container iteration (m6b-plan step 4, first half).
//
// design.md: a dynamic array iterates value-and-index like a slice; a map is the
// two-name exception — the first of two names is the key, not a counter — and
// "**Iteration order is unspecified.**" So nothing here prints a map in table
// order; every map result is order-independent.
//
// "Map values can be iterated by-reference, but their keys cannot since map keys
// are immutable." A key binding borrows the stored key in place, which is what
// lets `map[string]V` be iterated without a per-iteration clone.

main :: proc() {
	xs: [dynamic]int = {1, 2, 3};
	total := 0;
	foreach (v in xs) { total += v; }
	fmt.println(total);

	weighted := 0;
	foreach (v, i in xs) { weighted += v * i; }
	fmt.println(weighted);

	// `&value` names the element in place.
	foreach (&v in xs) { v = v * 10; }
	fmt.println(xs[0]);
	fmt.println(xs[2]);

	// design.md's own map example, verbatim.
	some_map := map[string]int{"A" = 1, "C" = 9, "B" = 4};
	foreach (key, &value in some_map) { value += 1; }
	fmt.println(some_map["A"]);
	fmt.println(some_map["C"]);
	fmt.println(some_map["B"]);

	// One name binds the value.
	sum := 0;
	foreach (v in some_map) { sum += v; }
	fmt.println(sum);

	// Two names bind key and value; a managed key is borrowed, not copied.
	measured := 0;
	foreach (k, v in some_map) { measured += len(k) * v; }
	fmt.println(measured);

	// An empty container iterates zero times.
	empty: [dynamic]int;
	none: map[int]int;
	steps := 0;
	foreach (v in empty) { steps += 1; }
	foreach (k, v in none) { steps += 1; }
	fmt.println(steps);

	// Formatting through M6a's table, recursively. A dynamic array prints the
	// current allocation up to its length; a map prints `[key = value]` in slot
	// order, which is unspecified -- so only single-entry and empty maps are
	// printed here.
	fmt.println(xs);
	fmt.println(empty);
	fmt.println(none);
	one: map[string]int;
	one["only"] = 5;
	fmt.println(one);

	nested: [dynamic][dynamic]int;
	inner: [dynamic]int = {1, 2};
	nested.append(inner);
	fmt.println(nested);
	deep: map[int][dynamic]int;
	deep[7] = {8, 9};
	fmt.println(deep);
}
