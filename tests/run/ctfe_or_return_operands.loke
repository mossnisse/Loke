// design.md "Compile-time procedure evaluation": a failing `or_return` in an
// operand leaves before the later operands are evaluated, as at run time, for
// `in` (design.md "Ranges") and for a map method's later arguments.
package main;
import "core:fmt";

missing :: proc() -> Option(int) { return .none; }

unreachable_range :: proc() -> Range(int) {
	assert(false);
	return 0 ..< 10;
}

unreachable_count :: proc() -> int {
	assert(false);
	return 0;
}

in_range :: proc() -> Option(bool) {
	return .some(missing() or_return in unreachable_range());
}

insert :: proc() -> Option(int) {
	m: map[int]int = {};
	return .some(m.find_or_insert(missing() or_return, unreachable_count())^);
}

static_assert(in_range() == .none);
static_assert(insert() == .none);

main :: proc() {
	fmt.println(in_range(), insert());
}
