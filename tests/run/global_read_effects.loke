package main; import "core:fmt";

// design.md "Global write effects": a call's read of a global conflicts only with
// a mutable borrow of it that is live across the call. A read-only borrow stays
// beside it, a mutable borrow whose last use came before the call does not
// reach it, and a callee that writes through its parameter without naming the
// global reads nothing. What is rejected is in tests/err/global_read_effects.loke.

counter: int = 3;
other: int = 4;
items: [dynamic]int;

peek :: proc() -> int { return counter; }
deep :: proc() -> int { return peek(); }
item_count :: proc() -> int { return items.len(); }

// A shared borrow of a global beside a callee that reads it.
beside_a_read_only_borrow :: proc() -> int {
	p := &counter;
	n := deep();
	return p^ + n;
}
beside_a_read_only_view :: proc() -> int {
	view: []int = items[:];
	n := item_count();
	return view[0] + n;
}
beside_a_read_only_argument :: proc(p: ^int) -> int { return p^ + counter; }
in_a_read_only_traversal :: proc() -> int {
	total := 0;
	foreach (item in items) {
		total += item * item_count();
	}
	return total;
}

// A mutable borrow that is no longer in use at the call, or not yet taken.
after_its_last_use :: proc() -> int {
	p := &mut counter;
	p^ = 5;
	n := deep();
	return n;
}
before_it_is_taken :: proc() -> int {
	n := deep();
	p := &mut counter;
	p^ = n + 1;
	return p^;
}
reborrowed_after :: proc() -> int {
	p := &mut counter;
	p^ = 7;
	n := deep();
	p = &mut counter;
	p^ = n + 1;
	return counter;
}

// Taken afresh each time around a loop, and last used before the call.
fresh_each_iteration :: proc() -> int {
	total := 0;
	for (i := 0; i < 2; i += 1) {
		p := &mut counter;
		p^ = i;
		total += deep();
	}
	return total;
}

// A write through the parameter alone reads no global by name.
set :: proc(p: ^mut int, value: int) { p^ = value; }
through_the_parameter :: proc() -> int {
	set(&mut counter, 9);
	return peek();
}

// A mutable borrow of another global, and an argument evaluated before the
// borrow it is passed beside.
of_another_global :: proc() -> int {
	p := &mut other;
	p^ = deep();
	return other;
}
as_an_earlier_argument :: proc() -> int {
	two :: proc(value: int, p: ^mut int) { p^ = value + 1; }
	two(deep(), &mut counter);
	return counter;
}

// A plain write of the global, which is no borrow.
assigned_from_a_read :: proc() -> int {
	counter = deep() + 1;
	counter += deep();
	return counter;
}

// A borrow of a local the callee cannot name.
of_a_local :: proc() -> int {
	local := 1;
	p := &mut local;
	p^ = deep();
	return local;
}

// A copy hook reads its global only where a copy runs: reading a field, viewing
// the value, and a lending traversal copy nothing.
copied: [2]int = {1, 2};
Tagged :: struct { n: int }
impl Tagged {
	duplicate :: hook(copy) proc(self, allocator: Allocator) -> Result(Tagged, Allocator_Error) {
		return .ok(Tagged{self.n + copied[0]});
	}
}
viewed :: proc(t: ^Tagged) -> int { return t.n; }
without_a_copy :: proc(t: Tagged, items: [dynamic]Tagged) -> int {
	p := &mut copied[0];
	n := viewed(&t) + t.n;
	foreach (item in items) {
		n += item.n;
	}
	p^ = n;
	return copied[0];
}
written_to_a_map :: proc(items: inout map[int]Tagged) -> int {
	p := &mut copied[1];
	items[1] = Tagged{4};
	p^ = 5;
	return copied[1];
}
Key :: struct { n: int }
impl Key {
	duplicate :: hook(copy) proc(self, allocator: Allocator) -> Result(Key, Allocator_Error) {
		return .ok(Key{self.n + copied[0]});
	}
	hash :: proc(self, seed: uint) -> uint { return seed + uint(self.n); }
	same :: operator(==) proc(a, b: Key) -> bool { return a.n == b.n; }
}
looked_up_by_key :: proc(key: Key, within: map[Key]int) -> int {
	p := &mut copied[1];
	found := key in within;
	if (found) { p^ = 6; } else { p^ = 7; }
	return copied[1];
}
beside_a_read_only_borrow_of_it :: proc(t: Tagged) -> int {
	p := &copied[0];
	c := t.clone();
	return p^ + c.n;
}

main :: proc() {
	items.append(2);
	items.append(3);
	fmt.println(beside_a_read_only_borrow());
	fmt.println(beside_a_read_only_view());
	fmt.println(beside_a_read_only_argument(&counter));
	fmt.println(in_a_read_only_traversal());
	fmt.println(after_its_last_use());
	fmt.println(before_it_is_taken());
	fmt.println(reborrowed_after());
	fmt.println(fresh_each_iteration());
	fmt.println(through_the_parameter());
	fmt.println(of_another_global());
	fmt.println(as_an_earlier_argument());
	fmt.println(assigned_from_a_read());
	fmt.println(of_a_local());
	tagged := [dynamic]Tagged{};
	tagged.append(Tagged{1});
	fmt.println(without_a_copy(Tagged{1}, tagged));
	table := map[int]Tagged{};
	fmt.println(written_to_a_map(inout table));
	keyed := map[Key]int{};
	fmt.println(looked_up_by_key(Key{1}, keyed));
	fmt.println(beside_a_read_only_borrow_of_it(Tagged{1}));
}
