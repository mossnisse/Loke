package main; import "core:fmt";

show_bool :: proc(b: bool) -> int { return 1 if b else 0; }
show_int  :: proc(i: int)  -> int { return i; }
show_f32  :: proc(f: f32)  -> int { return int(f) + 100; }

show :: proc{show_bool, show_int, show_f32};

Point :: struct { x, y: int }
Tone :: enum { Low, High }

place_one :: proc(p: Point) -> int { return p.x * 10 + p.y; }
place_two :: proc(p: Point, by: int) -> int { return p.x * 10 + p.y + by; }
tone_one :: proc(t: Tone) -> int { return int(t); }
tone_two :: proc(t: Tone, by: int) -> int { return int(t) + by; }

// Every member wants the same type in that position, so an argument whose
// meaning comes from its destination has one, exactly as a method call's does.
place :: proc{place_one, place_two};
tone :: proc{tone_one, tone_two};

// design.md rank 1: `^mut T` weakening to `^T` creates no value, so it outranks
// the erasure to `any_view` instead of tying with it.
through_ptr :: proc(p: ^int) -> int { return p^; }
through_view :: proc(v: any_view) -> int { return 0; }
reach :: proc{through_ptr, through_view};

pad :: proc(i: int, by: int = 5) -> int { return i + by; }
pad3 :: proc(i: int, j: int, k: int) -> int { return i * j * k; }
padded :: proc{pad, pad3};

main :: proc() {
	fmt.println(show(true));
	// An integer constant prefers an integer destination to a floating one.
	fmt.println(show(7));
	fmt.println(show(int(7)));
	fmt.println(show(2.5));
	x: f32 = 3.0;
	fmt.println(show(x));
	fmt.println(padded(3));
	fmt.println(padded(3, 4));
	fmt.println(padded(2, 3, 4));
	fmt.println(padded(by = 40, i = 2));
	fmt.println(place({1, 2}), place({1, 2}, 100));
	fmt.println(tone(.High), tone(.High, 100));
	cell := 9;
	fmt.println(reach(&mut cell));
}
