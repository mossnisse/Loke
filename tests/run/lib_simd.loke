package main;

import "core:fmt";
import "base:runtime";
import "core:simd";

// `Simd(T, N)` end to end (design.md "SIMD vectors"). Every
// claim design.md's section makes that produces a value is checked here; the
// ones that produce a diagnostic are in `tests/err/lib_simd_gates.loke`.

Lane :: distinct f32;

main :: proc() {
	// "written as a composite literal with one element per lane, in lane order",
	// and the zero is every lane's zero.
	lanes: Simd(f32, 4) = {1.0, 2.0, 3.0, 4.0};
	zeroes: Simd(f32, 4) = {};
	fmt.println(lanes, zeroes);

	// "`v.len()` is the lane count, a compile-time constant."
	static_assert(lanes.len() == 4);
	fmt.println(lanes.len());

	// "`size_of(Simd(T, N))` is `N * size_of(T)`, and `align_of` is the size" —
	// unlike the array with the same element and count.
	fmt.println(size_of(Simd(f32, 4)), align_of(Simd(f32, 4)));
	fmt.println(size_of([4]f32), align_of([4]f32));
	fmt.println(size_of(Simd(f32, 3 + 1)), size_of(Simd(u8, 64)), align_of(Simd(u8, 64)));
	fmt.println(size_of(Simd(i64, 1)), align_of(Simd(i64, 1)));
	fmt.println(size_of(Simd(bool, 8)), align_of(Simd(bool, 8)));

	// "`v[i]` reads a lane and `v[i] = x` writes one."
	fmt.println(lanes[0], lanes[3]);
	lanes[1] = 20.0;
	fmt.println(lanes[1], lanes);

	// ----------------------------------------------------------- operators --

	a: Simd(i32, 4) = {10, 20, 30, 40};
	b: Simd(i32, 4) = {3, 7, 4, 6};
	fmt.println(a + b, a - b, a * b, a / b, a % b);
	fmt.println(a & b, a | b, a ~ b, a &~ b, ~b);
	fmt.println(a << 1, a >> 2, -a);

	// "A scalar converts to a vector implicitly wherever a vector is expected,
	// producing the splat", from either side.
	fmt.println(a + 1, 1 + a, a * 2);
	scale := 3;
	widened: Simd(int, 4) = scale;
	fmt.println(widened);

	// "A comparison yields a lane mask, not a `bool`."
	mask := a > b;
	fmt.println(mask, mask[0], mask.len());
	fmt.println(a == b, a != b, a < b, a <= b, a >= b);
	// Masks combine with the bitwise operators, which is what `&&` and `||`
	// would have been for.
	fmt.println((a > b) & (b > 3), (a > b) | (b > 3), ~(a > b));

	// Signed and unsigned differ in both shift and comparison.
	negative: Simd(i32, 4) = {-8, -1, 1, 8};
	fmt.println(negative >> 1, negative >> 40, negative < 0);
	unsigned: Simd(u32, 4) = {1, 2, 3, 4};
	fmt.println(unsigned - 2, unsigned >> 1, unsigned > 2);

	// "Signed `MIN / -1` and `MIN % -1` have the same wrapping results scalars
	// give", lane by lane beside ordinary ones.
	extreme: Simd(i32, 4) = {-2147483648, 7, -2147483648, -9};
	divisor: Simd(i32, 4) = {-1, 2, 1, -3};
	fmt.println(extreme / divisor, extreme % divisor);

	// A shift count at or beyond the width is the limit of the repeated
	// one-bit shift, exactly as for a scalar.
	wide: Simd(u32, 4) = {1, 2, 3, 4};
	fmt.println(wide << 32, wide >> 32);

	// Floats: lane-wise, and the ordinary float comparison rules.
	f: Simd(f64, 2) = {1.5, -2.5};
	fmt.println(f + 0.5, f * f, f / 2.0, -f);
	fmt.println(f < 0.0, f == f);

	// ---------------------------------------------------------- conversion --

	// "An explicit `Simd(U, N)(v)` converts each lane of `v` from `T` to `U`."
	fmt.println(Simd(i32, 4)(lanes), Simd(f64, 4)(a), Simd(i8, 4)(b), Simd(i64, 4)(b));

	// A `distinct` over a permitted element is itself permitted, and keeps its
	// own identity.
	tagged: Simd(Lane, 2) = {Lane(1.5), Lane(2.5)};
	fmt.println(tagged, tagged[0]);

	// ---------------------------------------------------------- core:simd --

	fmt.println(simd.reduce_add(a), simd.reduce_mul(b), simd.reduce_min(a), simd.reduce_max(a));
	fmt.println(simd.reduce_add(f), simd.reduce_min(f), simd.reduce_max(f));
	// "A floating-point sum and product are ordered, left to right", and the
	// ordered form is seeded with the fold's exact identity. A sum's is `-0.0`,
	// so a vector of nothing but negative zero keeps its sign; `+0.0` would not.
	negative_zero: Simd(f64, 2) = {-0.0, -0.0};
	fmt.println(simd.reduce_add(negative_zero), simd.reduce_mul(negative_zero));
	// "`reduce_min` and `reduce_max` ignore NaN lanes and answer with a number
	// whenever any lane holds one; a vector of nothing but NaN reduces to NaN."
	// The all-NaN answer is checked against itself rather than printed: NaN is
	// the one value not equal to itself, and its spelling is not design.md's.
	nan := f64(0.0) / f64(0.0);
	with_nan: Simd(f64, 4) = {1.5, nan, 3.5, 2.5};
	fmt.println(simd.reduce_min(with_nan), simd.reduce_max(with_nan));
	all_nan: Simd(f64, 2) = {nan, nan};
	lowest := simd.reduce_min(all_nan);
	highest := simd.reduce_max(all_nan);
	fmt.println(lowest != lowest, highest != highest);
	fmt.println(simd.any(mask), simd.all(mask), simd.all(a > 0), simd.any(a > 100));
	fmt.println(simd.select(mask, a, b));
	fmt.println(simd.to_array(a), simd.to_array(a)[2]);
	fmt.println(simd.from_array([4]i32{9, 8, 7, 6}));
	// The round trip is the identity, which is what makes the two conversions a
	// usable bridge rather than two separate reinterpretations.
	fmt.println(simd.all(simd.from_array(simd.to_array(a)) == a));

	// ------------------------------------------------------- compile time --

	// A constant vector folds lane-wise like any other constant, in the checker
	// and in a compile-time procedure alike.
	fmt.println(ORIGIN, DOUBLED, NEGATED, FLIPPED, OVER_HALF);
	static_assert(DOUBLED[3] == 6.0);
	static_assert(FOLDED == 4);
	fmt.println(FOLDED);

	// "An explicit `Simd(U, N)(v)` converts each lane" is a value claim, so it
	// has to hold in all three places: a written constant, an evaluated
	// procedure, and the emitted call. The last two are printed side by side.
	fmt.println(CONVERTED, CONVERTED[3]);
	fmt.println(FOLDED_CONVERSION, lane_conversion());

	// --------------------------------------------------------- reflection --

	info := type_info_of(typeid_of(Simd(f32, 4)));
	fmt.println(info.kind, info.size, info.align, info.count);
	fmt.println(info.element == typeid_of(f32), info.name);
	mask_info := type_info_of(typeid_of(Simd(bool, 4)));
	fmt.println(mask_info.kind, mask_info.count, mask_info.element == typeid_of(bool));

	// A vector is an ordinary value, so it goes in the places values go.
	holder := Holder{a, mask};
	fmt.println(holder.vector, holder.mask);
	fmt.println(doubled(a));
	table: [dynamic]Simd(i32, 4) = {};
	table.append(a);
	table.append(b);
	fmt.println(table.len(), table[1]);
	drop(table);

	// A compound assignment is that same operator plus a write, so it agrees
	// with the spelled-out form on every lane type, including a shift whose
	// count splats and a float lane that must not take the integer mnemonic.
	acc := a;
	acc += 1;
	acc <<= 1;
	acc &~= b;
	fmt.println(acc, acc == ((a + 1) << 1) &~ b);
	float_acc := f;
	float_acc *= 2.0;
	fmt.println(float_acc);
	mask_acc := mask;
	mask_acc &= b > 3;
	fmt.println(mask_acc);

	// design.md's operator table gives `&`, `|`, `~`, and `&~` `bool` lanes, so
	// a constant mask folds through them like any other constant vector.
	fmt.println(MASK_AND, MASK_OR, MASK_XOR, MASK_ANDNOT);
	fmt.println(FOLDED_COMPOUND);

	// `core:simd` is ordinary library code, so it runs at compile time too, and
	// agrees with the emitted calls lane for lane.
	fmt.println(FOLDED_LIBRARY);
	fmt.println(FOLDED_LIBRARY == library_folds());
}

Holder :: struct {
	vector: Simd(i32, 4),
	mask:   Simd(bool, 4),
}

doubled :: proc(v: Simd($T, $N)) -> Simd(T, N) {
	return v * 2;
}

ORIGIN :: Simd(f32, 4){0.0, 1.0, 2.0, 3.0};

DOUBLED :: ORIGIN * 2.0;

NEGATED :: -ORIGIN;

FLIPPED :: ~Simd(i32, 4){1, 2, 3, 4};

OVER_HALF :: ORIGIN > 1.5;

// The same folding inside a compile-time procedure, where the lanes live in the
// evaluator's own values rather than in written constants.
lane_arithmetic :: proc() -> i32 {
	v: Simd(i32, 4) = {1, 2, 3, 4};
	return (-v)[1] + (~v)[0] + (v / 2)[3] + (v << 1)[2];
}

FOLDED :: lane_arithmetic();

// The lane-wise conversion, in the checker and in the evaluator. `const_of`
// carries no lanes and the splat path answered only its own target, so both
// once refused what `convertible` permits and the backend emits.
CONVERTED :: Simd(f64, 4)(Simd(i32, 4){3, 4, 5, 6});

lane_conversion :: proc() -> i32 {
	v: Simd(i32, 4) = {3, 4, 5, 6};
	widened := Simd(f64, 4)(v);
	return i32(widened[0]) * 10 + Simd(i32, 4)(widened)[3];
}

FOLDED_CONVERSION :: lane_conversion();

MASK_A :: Simd(bool, 4){true, true, false, false};
MASK_B :: Simd(bool, 4){true, false, true, false};
MASK_AND :: MASK_A & MASK_B;
MASK_OR :: MASK_A | MASK_B;
MASK_XOR :: MASK_A ~ MASK_B;
MASK_ANDNOT :: MASK_A &~ MASK_B;

// The same compound assignments where the lanes live in the evaluator's own
// values rather than in written constants.
compound_lanes :: proc() -> Simd(i32, 4) {
	v: Simd(i32, 4) = {1, 2, 3, 4};
	v += 10;
	v *= 2;
	v >>= 1;
	return v;
}

FOLDED_COMPOUND :: compound_lanes();

// Every `core:simd` procedure, over the cases that differ between folds: a
// distinct lane, wrapping integer lanes, a signed minimum, an all-`-0.0` sum,
// `f16` lanes, an order-dependent sum, and NaN lanes a minimum skips.
library_folds :: proc() -> [16]f64 {
	d: Simd(Lane, 4) = {Lane(1.5), Lane(-2.0), Lane(4.0), Lane(0.5)};
	w: Simd(u8, 4) = {200, 3, 100, 1};
	s: Simd(i8, 4) = {-100, 3, 100, -1};
	z: Simd(f64, 2) = {-0.0, -0.0};
	h: Simd(f16, 4) = {f16(1.5), f16(2.0), f16(-3.0), f16(0.25)};
	o: Simd(f64, 4) = {1e16, 1.0, -1e16, 1.0};
	nan := f64(0.0) / f64(0.0);
	n: Simd(f64, 4) = {nan, 2.5, nan, 1.5};
	m: Simd(i32, 4) = {1, 2, 3, 4};
	mask := m > 2;
	picked := simd.select(mask, m, m * 10);
	back := simd.to_array(simd.from_array([2]i32{7, 9}));
	return {
		f64(simd.reduce_add(d)), f64(simd.reduce_mul(d)), f64(simd.reduce_min(d)), f64(simd.reduce_max(d)),
		f64(simd.reduce_add(w)), f64(simd.reduce_mul(w)), f64(simd.reduce_min(s)), f64(simd.reduce_max(s)),
		simd.reduce_add(z), f64(simd.reduce_add(h)), simd.reduce_add(o), simd.reduce_min(n),
		simd.reduce_max(n), f64(simd.reduce_add(picked)), f64(back[1]),
		1.0 if (simd.any(mask) && !simd.all(mask)) else 0.0,
	};
}

FOLDED_LIBRARY :: library_folds();
