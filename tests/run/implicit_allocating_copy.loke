package main;

import "core:fmt";

// design.md "Value semantics and the ownership rule": a place whose copy may
// allocate is copied implicitly, in every context that copies, and the copy is
// independent of it. `a` is read again after each copy, so none of them is a
// last use (design.md "Last-use transfer"); the appends at the end show that
// no copy shares its storage.

Tracked :: struct { id: int }

impl Tracked {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Tracked, Allocator_Error) {
		fmt.println("copy", self.id);
		return .ok(Tracked{self.id + 10});
	}
}

Box :: struct { values: [dynamic]int }
Held :: union { some: [dynamic]int, none: }
Numbers :: distinct [dynamic]int;
Pair :: struct { name: string, values: [dynamic]int }
Outcome :: union @(failure=failed) { done: [dynamic]int, failed: }

pack :: proc(items: ..[dynamic]int) -> int { return items.len(); }
missing :: proc() -> Outcome { return .failed; }

// A parameter is borrowed, so returning it copies.
borrowed :: proc(values: [dynamic]int) -> [dynamic]int {
	return values;
}

contexts :: proc(outcome: Outcome) {
	a := [dynamic]int{1, 2};
	b := a;
	c: [dynamic]int = {};
	c = a;
	box := Box{a};
	nested: [dynamic][dynamic]int = {};
	nested.append(a);
	count := pack(a);
	held := Held.some(a);
	wrapped := Numbers(a);
	pair := Pair{"p", [dynamic]int{3}};
	name, values := pair;
	fallback := missing() or_else a;
	chosen := outcome or_else [dynamic]int{};
	tracked := Tracked{1};
	copy := tracked;
	spread: [dynamic][dynamic]int = {};
	spread.append(..nested[:]);
	a.append(9);
	pair.values.append(9);
	nested[0].append(9);
	fmt.println(a, b, c, box.values, nested, spread, count, held, wrapped);
	fmt.println(name, values, pair.values, fallback, chosen, tracked.id, copy.id);
}

main :: proc() {
	contexts(.done([dynamic]int{5}));
	original := [dynamic]int{7};
	returned := borrowed(original);
	returned.append(8);
	fmt.println(original, returned);
}
