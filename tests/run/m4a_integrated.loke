package main; import "core:fmt";

// One program using methods, operators, named construction, a union result, and
// `or_return` together.

Money :: distinct i64;

impl Money {
	delegate(+, -, ==, !=, <, <=, >, >=);
}

Error :: enum { Overdrawn, Closed }

Account :: struct {
	balance: Money,
	open:    bool,
}

impl Account {
	open_account :: proc(balance: Money) -> Account { return {balance, true}; }
	closed :: proc() -> Account { return {Money(0), false}; }

	total :: proc(self) -> Money { return self.balance; }

	deposit :: proc(self: inout Account, amount: Money) {
		self.balance += amount;
	}

	withdraw :: proc(self: inout Account, amount: Money) -> Result(Unit, Error) {
		if (!self.open) { return .err(.Closed); }
		if (self.balance < amount) { return .err(.Overdrawn); }
		self.balance -= amount;
		return .ok(Unit{});
	}
}

Ledger :: struct { slots: [4]i64 }

impl Ledger {
	at :: operator([]) proc(self: Ledger, index: int) -> i64 { return self.slots[index]; }
	at_mut :: operator([]) proc(self: inout Ledger, index: int) -> inout i64 {
		return inout self.slots[index];
	}
}

transfer :: proc(from: inout Account, to: inout Account, amount: Money) -> Result(Money, Error) {
	from.withdraw(amount) or_return;
	to.deposit(amount);
	return .ok(amount);
}

// One variant switch describes both halves of the outcome.
describe :: proc(outcome: Result(Money, Error)) -> int {
	switch (e in outcome) {
	case .ok:  return 0;
	case .err: return 1 if e == .Overdrawn else 2;
	}
	return -1;
}

moved_or_zero :: proc(outcome: Result(Money, Error)) -> int {
	return int(i64(outcome or_else Money(0)));
}

main :: proc() {
	a := Account.open_account(Money(100));
	b := Account.closed();

	fmt.println(int(i64(a.total())));
	fmt.println(1 if b.open else 0);

	first := transfer(inout a, inout b, Money(30));
	fmt.println(moved_or_zero(first));
	fmt.println(describe(first));
	fmt.println(int(i64(a.total())));

	// `b` is closed, so the withdrawal fails and nothing moves.
	second := transfer(inout b, inout a, Money(10));
	fmt.println(moved_or_zero(second));
	fmt.println(describe(second));

	// A failure that is not "closed".
	third := transfer(inout a, inout b, Money(1000));
	fmt.println(moved_or_zero(third));
	fmt.println(describe(third));

	ledger: Ledger = {};
	ledger[2] = 9;
	fmt.println(int(ledger[2]));
	fmt.println(int(ledger[0]));

	// Delegated comparison and the `!=` fallback.
	fmt.println(1 if Money(3) < Money(4) else 0);
	fmt.println(1 if Money(3) != Money(4) else 0);
}
