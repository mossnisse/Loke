package main; import "core:fmt";

// One program using methods, operators, named construction, a union result, and
// `or_return` together.

Money :: distinct i64;

impl Money {
	delegate(+, -, ==, !=, <, <=, >, >=);
}

Error_Code :: enum { Overdrawn, Closed }
Error :: union { Error_Code }

Account :: struct {
	balance: Money,
	open:    bool,
}

impl Account {
	open_account :: proc(balance: Money) -> Account { return {balance, true}; }
	closed :: proc() -> Account { return {Money(0), false}; }

	total :: proc(self) -> Money { return self.balance; }

	deposit :: proc(self: inout Account, amount: Money) {
		self.balance += amount;
	}

	withdraw :: proc(self: inout Account, amount: Money) -> Error {
		if (!self.open) { return Error_Code.Closed; }
		if (self.balance < amount) { return Error_Code.Overdrawn; }
		self.balance -= amount;
		return nil;
	}
}

Ledger :: struct { slots: [4]i64 }

impl Ledger {
	at :: operator([]) proc(self: Ledger, index: int) -> i64 { return self.slots[index]; }
	at_mut :: operator([]) proc(self: inout Ledger, index: int) -> inout i64 {
		return inout self.slots[index];
	}
}

transfer :: proc(from: inout Account, to: inout Account, amount: Money) -> (moved: Money, err: Error) {
	moved = Money(0);
	from.withdraw(amount) or_return;
	to.deposit(amount);
	moved = amount;
	return;
}

describe :: proc(err: Error) -> int {
	switch (e in err) {
	case Error_Code:
		return 1 if e == Error_Code.Overdrawn else 2;
	case:
		return 0;
	}
	return -1;
}

main :: proc() {
	a := Account.open_account(Money(100));
	b := Account.closed();

	fmt.println(int(i64(a.total())));
	fmt.println(1 if b.open else 0);

	moved, err := transfer(inout a, inout b, Money(30));
	fmt.println(int(i64(moved)));
	fmt.println(describe(err));
	fmt.println(int(i64(a.total())));

	// `b` is closed, so the withdrawal fails and nothing moves.
	moved2, err2 := transfer(inout b, inout a, Money(10));
	fmt.println(int(i64(moved2)));
	fmt.println(describe(err2));

	// A failure that is not "closed".
	moved3, err3 := transfer(inout a, inout b, Money(1000));
	fmt.println(int(i64(moved3)));
	fmt.println(describe(err3));

	ledger: Ledger;
	ledger[2] = 9;
	fmt.println(int(ledger[2]));
	fmt.println(int(ledger[0]));

	// Delegated comparison and the `!=` fallback.
	fmt.println(1 if Money(3) < Money(4) else 0);
	fmt.println(1 if Money(3) != Money(4) else 0);
}
