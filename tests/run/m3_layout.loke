package main; import "core:fmt";

Point :: struct { x: i32, y: i64 }

// A constant with the same name as a field: `offset_of` resolves a member, not
// a lexical value (m3-plan "Unevaluated layout operands").
y :: 999;

// If a `size_of` operand were ever evaluated, this would be a compile-time
// panic rather than a size.
side_effect :: proc() -> int {
	panic();
	return 1;
}

main :: proc() {
	fmt.println(size_of(Point));
	fmt.println(align_of(Point));
	fmt.println(offset_of(Point, y));
	fmt.println(size_of(i128));
	fmt.println(align_of(f16));

	// A dead local is a legal unevaluated operand: the query inspects its type.
	dead: [4]Point;
	fmt.println(size_of(dead));
	fmt.println(dead.len());

	fmt.println(size_of(side_effect()));
}
