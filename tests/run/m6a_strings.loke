package main; import "core:fmt";

// Runtime text end to end (m6a-plan step 4).
//
// design.md "string type": a `string` is an immutable, owning UTF-8 value that
// "behaves like a simple local variable"; a literal uses static storage; a
// runtime string owns a managed buffer; assignment shares that buffer and only
// `.copy()` copies it. `string_view` is the borrowed half, and a `string`
// converts to one implicitly.

byte_count :: proc(text: string_view) -> int { return text.len(); }

main :: proc() {
	// A literal is a compile-time constant over static, zero-terminated storage.
	literal: string = "Hej, världen";
	fmt.println(literal.len());          // 13 bytes: `ä` takes two of them
	fmt.println(literal.byte_len());    // `len` is shorthand for this
	fmt.println(literal.rune_count());  // 12 scalar values

	// The implicit borrow costs nothing and needs no validation.
	fmt.println(byte_count(literal));
	fmt.println(byte_count(literal[5:]));

	// Concatenation allocates and produces an owning `string`.
	joined := "Hej" + ", " + "värld";
	fmt.println(joined.len());
	fmt.println(joined.rune_count());

	// Assignment shares the backing storage; `copy` does not.
	shared := joined;
	copied := joined.copy();
	fmt.println(1 if shared == joined else 0);
	fmt.println(1 if copied == joined else 0);

	// Lexical byte-wise order.
	fmt.println(1 if "abc" < "abd" else 0);
	fmt.println(1 if "abc" < "ab" else 0);

	// Bytes are a read-only borrow of the same storage.
	bytes := literal.bytes();
	fmt.println(bytes.len());
	fmt.println(int(bytes[0]));

	// design.md "String iteration": `rune_offsets()` carries a byte offset, so it
	// advances by 1 to 4 per step rather than counting runes.
	x: string = "AÅ✓";
	foreach (codepoint, offset in x.rune_offsets()) {
		fmt.println(offset);
		fmt.println(int(codepoint));
	}

	// Validating conversions answer with an `Option`.
	good := [?]u8{72, 105};
	switch (valid in string.from_utf8(good[:])) {
	case .some: fmt.println(valid.len());
	case .none: fmt.println(-1);
	}

	invalid := [?]u8{0xC3, 0x28};
	switch (_ in string.from_utf8(invalid[:])) {
	case .some: fmt.println(-1);
	case .none: fmt.println(0);
	}

	switch (view in string_view.from_utf8(good[:])) {
	case .some: fmt.println(view.len());
	case .none: fmt.println(-1);
	}

	// A literal has static lifetime, so it initializes a C view directly.
	terminated: cstring_view = "hej";
	switch (scanned in string.from_utf8(terminated)) {
	case .some: fmt.println(scanned.len());
	case .none: fmt.println(-1);
	}

	// And a runtime string reuses the terminator its buffer already carries.
	switch (back in string.from_utf8(joined.to_c_view())) {
	case .some: fmt.println(back.len());
	case .none: fmt.println(-1);
	}

	runes := [?]rune{'A', 0x00C5};
	switch (built in string.from_runes(runes[:])) {
	case .some: fmt.println(built.len());
	case .none: fmt.println(-1);
	}
}
