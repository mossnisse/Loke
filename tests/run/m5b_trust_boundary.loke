package main; import "core:fmt";

// design.md "What is not checked" is a list of things that must keep compiling.
// The analysis is deliberately local to one procedure body, and every bullet
// below is a case where it stops rather than guesses. This fixture is the
// executable half of that promise: if one of these starts failing, the boundary
// moved without the design saying so.

Holder :: struct { view: []int }

// A user record that happens to contain a pointer is not a compiler-known
// borrow carrier: "Version 1 has no user-defined provenance annotation."
Handle :: struct { target: ^int }

global_view: []int;
global_pointer: ^int;
global_holder: Holder;

// 1. Storing a pointer, slice, iterator, or other view in a record field is
//    still the programmer's responsibility. Storing one in a global is not: the
//    parameter says how long its storage must live, and step 8 holds the caller
//    to it. The unconstrained forms moved to tests/err/m5b_retention.loke.
store_in_a_global :: proc(@(escape=static) values: []int, @(escape=static) target: ^int) {
	global_view = values;
	global_pointer = target;
}

store_in_a_record_field :: proc(values: []int) -> Holder {
	return Holder{values};
}

// 2. A procedure retaining a borrowed argument after it returns. The contract
//    is what tells the caller that `values` must outlive the call.
retain_an_argument :: proc(@(escape=static) values: []int) {
	global_holder = Holder{values};
}

// 3. A `^T` whose provenance the compiler does not track. An indirect result has
//    unknown root provenance, and dereferencing it is the programmer's
//    responsibility -- only passing it to `free` is refused.
deref_unknown_provenance :: proc(supply: proc() -> ^int) -> int {
	pointer := supply();
	return pointer^;
}

// 4. An alias hidden inside a user pointer-containing record used to be
//    unchecked here. It is not any more: content provenance follows the borrow
//    into `Handle` and back out, so the conflicting write is rejected. The case
//    moved to tests/err/m5b_aggregate_wrapping.loke, and what remains valid is
//    the alias without the conflict.
alias_without_a_conflict :: proc() -> int {
	value := 1;
	h := Handle{&value};
	return h.target^;
}

// 5. A borrow that leaves through a callback's state. The callback's own
//    parameter carries the contract, so the caller of `run_with` is held to
//    whatever the callback promises rather than to nothing.
run_with :: proc(action: proc(@(escape=static) values: []int), @(escape=static) values: []int) {
	action(values);
}

// `rawptr` and `[^]T` carry no checked provenance either, and `core:unsafe` and
// cross-thread transfer are M6: their bullets have no source to write yet.

supply_one :: proc() -> ^int {
	pointer := new(int) or_else nil;
	if (pointer == nil) { panic("allocation failed"); }
	pointer^ = 3;
	return pointer;
}

// The callers now have to hold up their end, so what they pass has to be storage
// that really does outlive the process.
KEPT :: [3]int{4, 5, 6};
kept_target: static int = 0;

main :: proc() {
	numbers := KEPT;
	target := 0;
	store_in_a_global(KEPT[:], &mut kept_target);
	fmt.println(global_view[0] + global_pointer^);

	holder := store_in_a_record_field(numbers[:]);
	fmt.println(holder.view[1]);

	retain_an_argument(KEPT[:]);
	fmt.println(global_holder.view[2]);

	fmt.println(deref_unknown_provenance(supply_one));
	fmt.println(alias_without_a_conflict());
	run_with(store_a_view, KEPT[:]);
	fmt.println(global_view[0]);
}

store_a_view :: proc(@(escape=static) values: []int) {
	global_view = values;
}
