package main; import "core:fmt"; import "core:container";

// design.md "Indexing and slicing": a `[]mut T` destination is a place position
// for slicing, so it selects the `operator([:])` yielding `[]mut T`, as a
// built-in slice of a mutable place is one. Anywhere else the read-only
// overload is preferred.

main :: proc() {
	small: container.Small_Array(int, 4) = {};
	small.append(1);
	small.append(2);
	small.append(3);

	part: []mut int = small[0:2];
	part[1] = 20;
	whole: []mut int = small[:];
	whole[2] = 30;

	read := small[1:3];
	fmt.println(small.view(), read);
}
