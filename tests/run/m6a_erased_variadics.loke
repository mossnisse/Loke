package main; import "core:fmt";

// design.md "Variadic parameters": a `..dyn I` caller views each argument, and
// the pack is a temporary of the complete call expression. The callee may
// read, index, iterate, and forward it.

Number :: interface($Self: type) {
	slot number: proc(self: ^) -> int;
}

impl int { number :: proc(self) -> int { return self; } }
impl bool { number :: proc(self) -> int { return 0; } }
impl rune { number :: proc(self) -> int { return 0; } }

count :: proc(args: ..dyn Number) -> int { return args.len(); }

// Each element dispatches through its own witness, whatever type it views.
ints :: proc(args: ..dyn Number) -> int {
	total := 0;
	foreach (a in args) {
		total = total + a.number();
	}
	return total;
}

// A sole spread forwards the pack to another `..dyn Number` parameter.
forward :: proc(args: ..dyn Number) -> int { return ints(..args); }

main :: proc() {
	fmt.println(count());
	fmt.println(count(1, true, 'c'));
	fmt.println(ints(1, 2, true, 3));
	fmt.println(forward(10, 20, false));
	x := 5;
	fmt.println(ints(x, x));
}
