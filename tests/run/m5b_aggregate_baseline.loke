package main; import "core:fmt";

// What the checker does with a borrow
// that travels inside a value today. Every body here compiles at the revision
// this fixture was added, and each is labelled with what it must be once
// aggregate content flows:
//
//   POSITIVE  it is valid and must still compile after steps 4-6.
//   GAP       it is unsound and must be rejected by a later step. Its
//             acceptance is recorded, not required; moving it to a rejection
//             fixture is the intended outcome, not a regression.
//
// Steps 5, 6 and 8 moved the wrapping, container and retention cases out: a borrow now travels through a record
// field, a union alternative, and a call, so those GAPs are rejections and live
// in tests/err/m5b_aggregate_wrapping.loke. What is left here either must keep
// compiling or waits for containers (step 6), retention contracts (step 7), or
// storage duration (step 8).
//
// Bodies marked GAP are deliberately not called from `main`: several of them
// return a view of storage that is already gone.

Holder :: struct { view: []int }
Pair :: struct { left: []int, right: []int }
Choice :: union { held: Holder, plain: int }
Owner :: struct { numbers: [dynamic]int, view: []int }

// --- wrapping ---------------------------------------------------------------

// POSITIVE. design.md's wrap/unwrap pair: the caller keeps the root alive, so
// the borrow is valid on the way in and on the way out.
wrap :: proc(values: []int) -> Holder {
	return Holder{values};
}

unwrap :: proc(holder: Holder) -> []int {
	return holder.view;
}

wrapped_round_trip :: proc(values: []int) -> []int {
	return unwrap(wrap(values));
}

// --- fields -----------------------------------------------------------------

// POSITIVE. Two fields naming two different caller roots stay independent.
independent_fields :: proc(a: []int, b: []int) -> Pair {
	return Pair{a, b};
}

// POSITIVE. Injecting and extracting a caller's borrow through a union.
inject :: proc(values: []int) -> Choice {
	return .held(Holder{values});
}

extract :: proc(choice: Choice) -> []int {
	switch (value in choice) {
	case .held:  return value.view;
	case .plain: return nil;
	}
	return nil;
}

// --- containers -------------------------------------------------------------

// POSITIVE. A value read copies the stored value, so it depends on what that
// value borrows and not on the map root.
map_value_read :: proc(table: map[string]Holder) -> []int {
	switch (held in table.lookup_value("a")) {
	case .some: return held.view;
	case .none: return nil;
	}
	return nil;
}

// POSITIVE. An entry pointer is a borrow of the container's storage, which the
// `inout` receiver makes the caller's.
map_entry_pointer :: proc(table: inout map[string]Holder) -> ^mut Holder {
	switch (slot in table.find("a")) {
	case .some: return slot;
	case .none: return nil;
	}
	return nil;
}

// --- moving an owner that carries a borrow ----------------------------------

// POSITIVE. The move transfers the caller's borrow with the owner; the result
// does not borrow the dead source binding.
move_an_owner :: proc(values: []int) -> Owner {
	owner: Owner;
	owner.view = values;
	return move(owner);
}

// --- allocation bases -------------------------------------------------------

// POSITIVE. The bare base reaches checked `free`.
alloc_bare :: proc() {
	pointer := new(int) or_else nil;
	if (pointer == nil) { return; }
	pointer^ = 1;
	free(pointer);
}

// POSITIVE since step 5, and a measured false rejection before it: the same
// allocation base put in a record field reaches checked `free` too. An alias or
// an interior pointer still does not.
Handle :: struct { target: ^mut int }

alloc_wrapped :: proc() {
	pointer := new(int) or_else nil;
	if (pointer == nil) { return; }
	pointer^ = 1;
	handle := Handle{pointer};
	free(handle.target);
}

// POSITIVE. Two elements of a small fixed array are two places, so returning the
// one that borrows the caller's argument does not name the local the other holds.
elements_are_independent :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	holders := [2]Holder{Holder{values}, Holder{local[:]}};
	return holders[0].view;
}

// POSITIVE. The same distinction for a write: element 1 borrows `second`, so
// writing `first` conflicts with nothing that is live.
write_beside_a_borrowed_element :: proc() -> int {
	first := [3]int{1, 2, 3};
	second := [3]int{4, 5, 6};
	holders := [2]Holder{Holder{first[:]}, Holder{second[:]}};
	first[0] = 9;
	return holders[1].view[0];
}

// POSITIVE. A constant index replaces rather than joins, so after overwriting
// element 1 it no longer holds what it held.
overwrite_one_element :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	holders := [2]Holder{Holder{values}, Holder{local[:]}};
	holders[1] = Holder{values};
	return holders[1].view;
}

// POSITIVE. A removal hands back what the element held, so this borrows the
// caller's argument and not the local container it came out of.
pop_an_element :: proc(values: []int) -> []int {
	holders: [dynamic]Holder;
	holders.append(Holder{values});
	switch (held in holders.pop()) {
	case .some: return held.view;
	case .none: return nil;
	}
	return nil;
}

// POSITIVE. The same for a map, where the value's content is what travels and a
// key's is not.
remove_a_value :: proc(values: []int) -> []int {
	table: map[string]Holder;
	table["a"] = Holder{values};
	switch (held in table.remove("a")) {
	case .some: return held.view;
	case .none: return nil;
	}
	return nil;
}

// POSITIVE. Two constant keys are two entries, so reading one back does not
// inherit what the other holds. A map's key set is not part of its type, so the
// type provides the entries and this body decides which key uses which.
constant_keys_are_independent :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	table: map[string]Holder;
	table["a"] = Holder{values};
	table["b"] = Holder{local[:]};
	return table["a"].view;
}

// POSITIVE. The same through the copying lookup, which takes its key as an
// argument rather than as part of a place.
constant_key_lookup :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	table: map[string]Holder;
	table["a"] = Holder{values};
	table["b"] = Holder{local[:]};
	switch (held in table.lookup_value("a")) {
	case .some: return held.view;
	case .none: return nil;
	}
	return nil;
}

// POSITIVE. A known key replaces what it held, so the local is gone from it.
overwrite_a_key :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	table: map[string]Holder;
	table["b"] = Holder{local[:]};
	table["b"] = Holder{values};
	return table["b"].view;
}

// --- retention --------------------------------------------------------------

// POSITIVE. The retained view is one of the caller's own arguments, and the
// parameter says so, which is the obligation the caller is held to.
retain_into_inout :: proc(destination: inout Holder, @(escape=stored) values: []int) {
	destination.view = values;
}

// POSITIVE. The caller's half of that obligation. Passing an argument to a
// `stored` parameter is the assignment the callee is permitted to make, so a
// body forwarding one carries the contract on instead of stopping here. `main`
// answers the same question with two locals that live to the same point.
forward_retention :: proc(destination: inout Holder, @(escape=stored) values: []int) {
	retain_into_inout(inout destination, values);
}

// POSITIVE. The same obligation through a pointer, where the destination's root
// is what the pointer's loans say rather than a place written out.
retain_through_a_pointer :: proc(destination: ^mut Holder, @(escape=stored) values: []int) {
	destination.view = values;
}

// POSITIVE. A destination that is this body's own local needs no contract: the
// borrow travels into it and both end together.
local_through_a_pointer :: proc() -> int {
	numbers := [4]int{9, 8, 7, 6};
	held: Holder;
	retain_through_a_pointer(&mut held, numbers[:]);
	return held.view[0];
}

// POSITIVE. The same through a pointer held in a variable, where what the
// destination names is solved rather than written out. Everything here lives to
// the same point, so the borrow that travels into `held` is still valid.
local_through_a_pointer_variable :: proc() -> int {
	numbers := [4]int{5, 4, 3, 2};
	held: Holder;
	p := &mut held;
	retain_through_a_pointer(p, numbers[:]);
	p^.view = numbers[1:];
	return held.view[0];
}

// POSITIVE. A destination that cannot hold a borrow is not a destination, so a
// `stored` argument asks nothing of it.
count_into :: proc(total: inout int, @(escape=stored) values: []int) {
	total = total + values.len();
}

forward_a_count :: proc(total: inout int, values: []int) {
	count_into(inout total, values);
}

// POSITIVE. The same for process storage, written at the stronger level. The
// caller is held to it, so what it passes has to outlive the process too.
KEPT :: [4]int{5, 6, 7, 8};
promised_global: Holder;

set_promised_global :: proc(@(escape=static) values: []int) {
	promised_global = Holder{values};
}

// POSITIVE since step 5. A user `operator([:])` whose receiver field is itself a
// view returns a borrow of what that view borrows, not of the receiver's own
// storage, so replacing the receiver does not invalidate the result. The
// receiver-owns-its-storage form is still rejected, in tests/err/m5b_views.loke.
Rows :: struct { rows: []mut int }
impl Rows {
	span :: operator([:]) proc(self: inout Rows, lo: int, hi: int) -> []mut int {
		return self.rows[lo:hi];
	}
}

reslice_a_stored_view :: proc() -> int {
	numbers := [4]int{1, 2, 3, 4};
	others := [4]int{5, 6, 7, 8};
	table := Rows{numbers[0:4]};
	part := table[0:2];
	table = Rows{others[2:4]};
	return part[0];
}

// POSITIVE since step 5. The helper returns one field, so the caller
// substitutes that field's root and not everything the argument holds: writing
// the array behind the *other* field stays legal.
takes_left :: proc(p: Pair) -> []int { return p.left; }

substituted_field_only :: proc() -> int {
	numbers := [3]int{1, 2, 3};
	others := [3]int{4, 5, 6};
	view := takes_left(Pair{numbers[:], others[:]});
	others[0] = 9;
	return view[0];
}

main :: proc() {
	numbers := [4]int{1, 2, 3, 4};
	others := [4]int{5, 6, 7, 8};

	fmt.println(unwrap(wrap(numbers[:]))[0]);
	fmt.println(wrapped_round_trip(numbers[:])[1]);

	pair := independent_fields(numbers[:], others[:]);
	fmt.println(pair.left[0] + pair.right[0]);

	fmt.println(extract(inject(numbers[:]))[2]);

	table: map[string]Holder;
	table["a"] = Holder{numbers[:]};
	fmt.println(map_value_read(table)[3]);
	fmt.println(map_entry_pointer(inout table).view.len());

	fmt.println(move_an_owner(numbers[:]).view.len());

	fmt.println(elements_are_independent(numbers[:])[0]);
	fmt.println(pop_an_element(numbers[:]).len());
	fmt.println(constant_keys_are_independent(numbers[:])[0]);
	fmt.println(constant_key_lookup(numbers[:])[1]);
	fmt.println(overwrite_a_key(numbers[:])[2]);
	fmt.println(remove_a_value(numbers[:]).len());
	fmt.println(write_beside_a_borrowed_element());
	fmt.println(overwrite_one_element(numbers[:]).len());

	alloc_bare();
	alloc_wrapped();

	holder: Holder;
	retain_into_inout(inout holder, others[:]);
	set_promised_global(KEPT[:]);
	fmt.println(holder.view[0]);
	fmt.println(reslice_a_stored_view());
	fmt.println(substituted_field_only());
	fmt.println(local_through_a_pointer());
	fmt.println(local_through_a_pointer_variable());

	total := 0;
	forward_a_count(inout total, KEPT[:]);
	fmt.println(total);

	assert(pointer_field_read(numbers[:])[0] == 1);
	assert(auto_dereferenced_field_read(numbers[:])[1] == 2);
	assert(dereferenced_value_read(numbers[:]).view[2] == 3);
	assert(temporary_field_read(numbers[:])[3] == 4);
	assert(slice_element_read(numbers[:])[0] == 1);
	assert(optional_extraction_read(numbers[:])[1] == 2);
	assert(grouped_extraction_read(numbers[:])[2] == 3);
	assert(temporary_fields_are_independent(numbers[:])[0] == 1);
	assert(temporary_elements_are_independent(numbers[:])[0] == 1);
	assert(pointer_fields_are_independent(numbers[:])[0] == 1);
	assert(nested_pointer_read(numbers[:])[0] == 1);
	assert(read_does_not_borrow_wrapper(numbers[:])[0] == 1);
	assert(read_scalar_from_pointer() == 7);
	assert(erased_extraction_read(numbers[:])[0] == 1);
	assert(projected_pointer_read(numbers[:])[0] == 1);
	assert(reordered_result_field(numbers[:])[0] == 1);
	assert(reordered_parameter_field(numbers[:])[0] == 1);
	assert(nested_result_field(numbers[:])[0] == 1);
	assert(assigned_result_field(numbers[:])[0] == 1);
	assert(conditional_result_field(numbers[:], true)[0] == 1);
	assert(conditional_result_field(numbers[:], false)[0] == 1);
	assert(multiple_result_fields(numbers[:])[0] == 1);
	assert(generic_result_field(numbers[:])[0] == 1);
	assert(recursive_result_field(numbers[:])[0] == 1);
	assert(array_result_field(numbers[:])[0] == 1);
	assert(duplicate_result_field(numbers[:])[0] == 1);
	assert(named_result_field(numbers[:])[0] == 1);
	assert(static_result_field(numbers[:])[0] == 5);
	assert(union_result_field(numbers[:])[0] == 1);
	assert(field_beside_map_result(numbers[:])[0] == 1);
	assert(field_beside_map_parameter(numbers[:])[0] == 1);
	assert(truncated_whole_replacement(numbers[:])[0] == 1);
	assert(map_try_insert_keeps_unrelated_key(numbers[:])[0] == 1);
	retained_elements: [dynamic]Holder;
	append_with_contract(inout retained_elements, numbers[:]);
	assert(retained_elements[0].view[0] == 1);
	keyed := map_key_from_parameter(KEY_BYTES[:]);
	assert(keyed.len() == 1);
	track_static_aggregate_content();
	track_tls_aggregate_content();
	assert(distinct_callback_local(numbers[:])[0] == 1);
	assert(content_after_clear() == 4);
	assert(content_after_whole_replacement() == 4);
	assert(map_content_after_clear() == 4);
	assert(copy_survives_clear(numbers[:])[0] == 1);
	assert(bare_map_lookup(numbers[:])[0] == 1);
	assert(bare_map_index(numbers[:])[0] == 1);
}

// Loading content must not add a lasting borrow of the local wrapper. These
// return the caller's storage through the same paths as the rejection cases.
pointer_field_read :: proc(values: []int) -> []int {
	held := Holder{values};
	p := &held;
	return p^.view;
}

auto_dereferenced_field_read :: proc(values: []int) -> []int {
	held := Holder{values};
	p := &held;
	return p.view;
}

dereferenced_value_read :: proc(values: []int) -> Holder {
	held := Holder{values};
	p := &held;
	return p^;
}

temporary_field_read :: proc(values: []int) -> []int {
	return wrap(values).view;
}

slice_element_read :: proc(values: []int) -> []int {
	held := [1]Holder{Holder{values}};
	view := held[:];
	return view[0].view;
}

optional_extraction_read :: proc(values: []int) -> []int {
	choice: Choice = .held(Holder{values});
	switch (held in choice) {
	case .held:  return held.view;
	case .plain: return nil;
	}
	return nil;
}

grouped_extraction_read :: proc(values: []int) -> []int {
	choice: Choice = .held(Holder{values});
	switch (held in choice) {
	case .held: return held.view;
	case:       return nil;
	}
	return nil;
}

temporary_fields_are_independent :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	return Pair{values, local[:]}.left;
}

temporary_elements_are_independent :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	return [2]Holder{Holder{values}, Holder{local[:]}}[0].view;
}

pointer_fields_are_independent :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	pair := Pair{values, local[:]};
	p := &pair;
	local[0] = 9;
	return p^.left;
}

nested_pointer_read :: proc(values: []int) -> []int {
	held := Holder{values};
	p := &held;
	pp := &p;
	return pp^^.view;
}

read_does_not_borrow_wrapper :: proc(values: []int) -> []int {
	held := Holder{values};
	p := &held;
	view := p^.view;
	held = Holder{};
	return view;
}

read_scalar_from_pointer :: proc() -> int {
	value := 7;
	p := &value;
	return p^;
}

erased_extraction_read :: proc(values: []int) -> []int {
	held := Holder{values};
	erased: any_view = held;
	switch (value in erased.as(Holder)) {
	case .some: return value.view;
	case .none: return nil;
	}
	return nil;
}

Outer :: struct { pair: Pair }

projected_pointer_read :: proc(values: []int) -> []int {
	local := [3]int{1, 2, 3};
	outer: Outer;
	outer.pair.left = values;
	outer.pair.right = local[:];
	p := &outer.pair;
	return p^.left;
}

// Result paths, not parameter order or slot count, decide which argument a
// selected field borrows. The unused field may borrow a local in every case.
result_reverse :: proc(a: []int, b: []int) -> Pair { return Pair{b, a}; }
result_swap :: proc(pair: Pair) -> Pair { return Pair{pair.right, pair.left}; }
result_nested :: proc(a: []int, b: []int) -> Outer { return Outer{Pair{b, a}}; }
result_duplicate :: proc(a: []int, b: []int) -> Pair { return Pair{b, b}; }
result_array :: proc(a: []int, b: []int) -> [2]Holder {
	return [2]Holder{Holder{b}, Holder{a}};
}
// Each field of a record result carries its own dependencies, and a destructure
// gives each binding that field's root rather than a join of them all.
result_many :: proc(a: []int, b: []int) -> (first: []int, second: []int) {
	return {first = b, second = a};
}
result_generic :: proc(pair: $T) -> T { return T{pair.right, pair.left}; }
result_named :: proc(a: []int, b: []int) -> Pair {
	out: Pair;
	out.left = b;
	out.right = a;
	return out;
}

reordered_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	pair := result_reverse(local[:], values);
	return pair.left;
}

reordered_parameter_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_swap(Pair{local[:], values}).left;
}

nested_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_nested(local[:], values).pair.left;
}

assigned_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	outer: Outer;
	outer.pair = result_reverse(local[:], values);
	return outer.pair.left;
}

conditional_result_field :: proc(values: []int, choose_first: bool) -> []int {
	local := [3]int{7, 8, 9};
	pair := result_reverse(local[:], values) if choose_first else Pair{values, nil};
	return pair.left;
}

multiple_result_fields :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	first, _ := result_many(local[:], values);
	return first;
}

generic_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_generic(Pair{local[:], values}).left;
}

recursive_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_cycle_a(local[:], values, 2).left;
}

// Both the caller and one half of this cycle precede their callees. Per-path
// changes must drive the fixed point even if the whole-result union is unchanged.
result_cycle_a :: proc(a: []int, b: []int, depth: int) -> Pair {
	if (depth == 0) { return Pair{b, a}; }
	return result_cycle_b(a, b, depth - 1);
}
result_cycle_b :: proc(a: []int, b: []int, depth: int) -> Pair {
	return result_cycle_a(a, b, depth);
}

array_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_array(local[:], values)[0].view;
}

duplicate_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_duplicate(local[:], values).right;
}

named_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_named(local[:], values).left;
}

result_static :: proc(values: []int) -> Pair { return Pair{KEPT[:], values}; }
static_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_static(local[:]).left;
}

Result_Choice :: union { outer: Outer, plain: int }
result_union :: proc(a: []int, b: []int) -> Result_Choice { return .outer(Outer{Pair{a, b}}); }
union_result_field :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	switch (held in result_union(local[:], values)) {
	case .outer: return held.pair.right;
	case .plain: return nil;
	}
	return nil;
}

Result_With_Map :: struct { entries: map[string]Holder, view: []int }
result_with_map :: proc(a: []int, b: []int) -> Result_With_Map {
	table: map[string]Holder;
	table["b"] = Holder{b};
	return Result_With_Map{move(table), a};
}
field_beside_map_result :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	return result_with_map(values, local[:]).view;
}

Parameter_With_Map :: struct { entries: map[string]Holder, view: []int }
parameter_view :: proc(value: Parameter_With_Map) -> []int { return value.view; }
field_beside_map_parameter :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	table: map[string]Holder;
	table["b"] = Holder{local[:]};
	value := Parameter_With_Map{move(table), values};
	return parameter_view(value);
}

Replace_A :: struct { pair: Pair }
Replace_B :: struct { a: Replace_A }
Replace_C :: struct { b: Replace_B }
Replace_D :: struct { c: Replace_C }
truncated_whole_replacement :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	held: Replace_D;
	held.c.b.a.pair.left = local[:];
	held.c.b.a.pair = Pair{values, values};
	return held.c.b.a.pair.left;
}

// A known map key updates only its own summary slot. The local stored under
// `b` must not contaminate the caller-backed value still stored under `a`.
map_try_insert_keeps_unrelated_key :: proc(values: []int) -> []int {
	local := [3]int{7, 8, 9};
	table: map[string]Holder;
	table["a"] = Holder{values};
	err := table.try_insert("b", Holder{local[:]});
	return table["a"].view;
}

// Synthesized insertion honors the same stored contract as indexed assignment.
append_with_contract :: proc(
	destination: inout [dynamic]Holder,
	@(escape=stored) values: []int,
) {
	destination.append(Holder{values});
}

KEY_BYTES :: [3]u8{107, 101, 121};
map_key_from_parameter :: proc(bytes: []u8) -> map[string_view]int {
	table: map[string_view]int;
	view := string_view.from_utf8(bytes) or_else "";
	table[view] = 7;
	return table;
}

STABLE_NUMBERS :: [3]int{7, 8, 9};
stable_holder: Holder;
stable_view: []int;
track_static_aggregate_content :: proc() {
	stable_holder.view = STABLE_NUMBERS[:];
	stable_view = stable_holder.view;
}

stable_tls_numbers: thread_local [3]int;
stable_tls_holder: thread_local Holder;
stable_tls_view: thread_local []int;
track_tls_aggregate_content :: proc() {
	stable_tls_holder.view = stable_tls_numbers[:];
	stable_tls_view = stable_tls_holder.view;
}

retain_for_distinct_callback :: proc(
	destination: inout Holder,
	@(escape=stored) values: []int,
) {
	destination.view = values;
}
Distinct_Local_Retainer :: distinct proc(
	destination: inout Holder,
	@(escape=stored) values: []int,
);
distinct_callback_local :: proc(values: []int) -> []int {
	held: Holder;
	action := Distinct_Local_Retainer(retain_for_distinct_callback);
	action(inout held, values);
	return held.view;
}

content_after_clear :: proc() -> int {
	local := [3]int{1, 2, 3};
	other := [3]int{4, 5, 6};
	held: [dynamic]Holder;
	held.append(Holder{local[:]});
	held.clear();
	held.append(Holder{other[:]});
	local[0] = 9;
	return held[0].view[0];
}

content_after_whole_replacement :: proc() -> int {
	local := [3]int{1, 2, 3};
	other := [3]int{4, 5, 6};
	held: [dynamic]Holder;
	held.append(Holder{local[:]});
	held = [dynamic]Holder{};
	held.append(Holder{other[:]});
	local[0] = 9;
	return held[0].view[0];
}

map_content_after_clear :: proc() -> int {
	local := [3]int{1, 2, 3};
	other := [3]int{4, 5, 6};
	table: map[string]Holder;
	table["old"] = Holder{local[:]};
	table.clear();
	table["new"] = Holder{other[:]};
	local[0] = 9;
	return table["new"].view[0];
}

copy_survives_clear :: proc(values: []int) -> []int {
	held: [dynamic]Holder;
	held.append(Holder{values});
	copy := held[0];
	held.clear();
	return copy.view;
}

bare_map_lookup :: proc(values: []int) -> []int {
	table: map[string][]int;
	table["a"] = values;
	switch (result in table.lookup_value("a")) {
	case .some: return result;
	case .none: return nil;
	}
	return nil;
}

bare_map_index :: proc(values: []int) -> []int {
	table: map[string][]int;
	table["a"] = values;
	return table["a"];
}
