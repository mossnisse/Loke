package main; import "core:fmt";

// An owned temporary handed to a procedure is the caller's to clean up.
//
// design.md "Parameter semantics and ABI lowering": an ordinary `value: T`
// parameter is a non-owning borrow, so the callee never drops one. Every hook
// here prints, so a missing cleanup is a line that is not in the expected output
// and a doubled one is a line that appears twice.

Res :: struct { id: int }

impl Res {
	release :: hook(drop) proc(self: inout Res) {
		if (self.id != 0) {
			fmt.println(self.id);
		}
	}
}

make_res :: proc(id: int) -> Res { return Res{id}; }

borrows :: proc(value: Res) -> int { return value.id; }
consumes :: proc(value: move Res) -> int { return value.id; }

// The temporary is dropped after the call, not by the callee.
temporary_argument :: proc() {
	fmt.println(1000);
	fmt.println(borrows(make_res(1)));
	fmt.println(1001);
}

// A place is somebody else's; passing it borrows and drops nothing early.
place_argument :: proc() {
	fmt.println(2000);
	kept := make_res(2);
	fmt.println(borrows(kept));
	fmt.println(2001);
}

// A `move` parameter transfers ownership, so the callee's copy is the one that
// dies and the caller adds no second drop. A place belongs to whoever declared
// it, so giving it away is written out at the call.
consuming_argument :: proc() {
	fmt.println(3000);
	held := make_res(3);
	fmt.println(consumes(move(held)));
	fmt.println(3001);
}

// A temporary needs no marker: it owns its value already and leaves no lexical
// owner dead, so there is nothing for one to announce. The callee still owns
// what it was handed, and drops it exactly once.
consuming_temporary :: proc() {
	fmt.println(3100);
	fmt.println(consumes(make_res(31)));
	fmt.println(3101);
}

// A consuming receiver follows the same rule as a consuming parameter: a place
// is written `move(value).method()`, a temporary needs no marker. Only the
// callee's copy dies, so the id prints once.
impl Res {
	take :: proc(self: move Res) -> int { return self.id; }
}

consuming_receiver :: proc() {
	fmt.println(3200);
	fmt.println(make_res(32).take());
	fmt.println(3201);
	held := make_res(33);
	fmt.println(move(held).take());
	fmt.println(3202);
}

// Several temporaries in one call are each cleaned up, in reverse order.
two :: proc(a: Res, b: Res) -> int { return a.id + b.id; }

several :: proc() {
	fmt.println(4000);
	fmt.println(two(make_res(4), make_res(5)));
	fmt.println(4001);
}

// A temporary built inside a loop is cleaned up once per iteration.
looping :: proc() {
	fmt.println(5000);
	for (i := 6; i <= 7; i += 1) {
		fmt.println(borrows(make_res(i)));
	}
	fmt.println(5001);
}

main :: proc() {
	temporary_argument();
	place_argument();
	consuming_argument();
	consuming_temporary();
	consuming_receiver();
	several();
	looping();
}
