package main; import "core:fmt";

// design.md "C pointers" and "unsafe.raw_data procedure": a C pointer
// carries neither a length nor a read-only capability, and its lifetime is no
// longer checked after conversion — which is why every one of these starts at a
// visible `unsafe.` call site.

import "core:unsafe";

main :: proc() {
	values := [?]int{10, 20, 30};
	p := unsafe.raw_data(values[:]);

	// Indexing is unchecked; slicing with both bounds gives the length back.
	fmt.println(p[1]);
	tail := p[1:3];
	fmt.println(tail.len());
	fmt.println(tail[0]);

	// `x[i:]` stays a C pointer, so the bound is still absent.
	rest := p[2:];
	fmt.println(rest[0]);

	// Crossing between C pointers and checked-pointer syntax is explicit. The
	// reconstructed `^T` still has unknown provenance because `p` is unchecked.
	single := (^int)(p);
	fmt.println(single^);
	again := ([^]int)(single);
	fmt.println(again[0]);

	// Text through the unsafe boundary and back.
	text: string = "hej";
	bytes := unsafe.raw_data(text);
	switch (view in unsafe.string_view(bytes, 3)) {
	case .some: fmt.println(view.len());
	case .none: fmt.println(-1);
	}

	terminated := unsafe.cstring_view(bytes);
	switch (owned in string(terminated)) {
	case .some: fmt.println(owned.len());
	case .none: fmt.println(-1);
	}

	// The validation is real: these bytes are not UTF-8.
	raw := [?]u8{0xFF, 0xFE};
	switch (_ in unsafe.string_view(unsafe.raw_data(raw[:]), 2)) {
	case .some: fmt.println(-1);
	case .none: fmt.println(0);
	}
}
