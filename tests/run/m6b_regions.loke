package main; import "core:fmt"; import "core:mem";

// Local allocator regions (m6b-plan step 5).
//
// design.md "Allocators": "There is no ambient temporary allocator. Temporary
// storage has a reset boundary and runtime identity, so code creates a
// `mem.Scratch` or `mem.Arena` owner and passes its allocator explicitly."
//
// The control block is address-stable and the region identity *is* its address,
// so moving the owner cannot change either. `free_all` is a reusable reset: the
// region stays usable afterwards.

// design.md "Allocators": an arena
// over a local fixed buffer puts a dynamic array's storage in this frame.
in_frame :: proc() {
	buffer: [4096]u8 = {};
	arena := mem.Arena.from_buffer(buffer[:]);
	data: [dynamic]int via arena.allocator() = {};
	data.append(1, 2, 3);
	fmt.println(data.len());
	fmt.println(data[2]);
}

// design.md's own example, verbatim.
scratch_storage :: proc() {
	scratch := mem.Scratch.init();
	temporary: [dynamic]int via scratch.allocator() = {};
	temporary.reserve(64);
	fmt.println(temporary.cap() >= 64);
}

// A reset this body is allowed to perform, because it created the region. It
// ends every allocation and leaves the region usable.
reusable_reset :: proc() {
	arena := mem.Arena.init();
	{
		temporary: [dynamic]u8 via arena.allocator() = {};
		temporary.append(1, 2, 3);
		fmt.println(temporary.len());
	}
	free_all(arena.allocator());
	after: [dynamic]u8 via arena.allocator() = {};
	after.append(4, 5);
	fmt.println(after.len());
	fmt.println(after[1]);
}

// design.md: a handle "remains valid for the reset control", so using one after
// the reset is not a surviving dependant.
handle_survives_reset :: proc() {
	arena := mem.Arena.init();
	handle := arena.allocator();
	free_all(handle);
	xs: [dynamic]u8 via handle = {};
	xs.append(9);
	fmt.println(xs.len());
}

// design.md: "release_scratch(arena.allocator())" once nothing is live. The
// promise the callee carries is what lets the reset cross a call boundary at
// all; a region this body created needs no promise of its own.
release_scratch :: proc(@(allocator_reset) allocator: Allocator) {
	free_all(allocator);
}

reset_through_wrapper :: proc() {
	arena := mem.Arena.init();
	{
		scratch: [dynamic]u8 via arena.allocator() = {};
		scratch.append(1, 2, 3);
		fmt.println(scratch.len());
	}
	release_scratch(arena.allocator());
	again: [dynamic]u8 via arena.allocator() = {};
	again.append(6);
	fmt.println(again.len());
}

// design.md: "an owner is live when it may be used later or still requires
// cleanup on an outgoing path. An explicitly dropped owner is dead and no
// longer blocks reset." Scope presence cannot answer that; M5a's definite
// liveness can, and does.
dropped_owner_permits_reset :: proc() {
	arena := mem.Arena.init();
	raw: [dynamic]u8 via arena.allocator() = {};
	raw.append(1, 2, 3);
	fmt.println(raw.len());
	drop(raw);
	free_all(arena.allocator());

	// A managed owner moved out is dead in the same way.
	xs: [dynamic]u8 via arena.allocator() = {};
	xs.append(4, 5);
	ys := move(xs);
	fmt.println(ys.len());
	drop(ys);
	free_all(arena.allocator());

	after: [dynamic]u8 via arena.allocator() = {};
	after.append(6);
	fmt.println(after.len());
}

// Two providers are two regions, so one reset is not the other's business.
distinct_regions :: proc() {
	a := mem.Arena.init();
	b := mem.Arena.init();
	xs: [dynamic]u8 via a.allocator() = {};
	xs.append(1, 2);
	free_all(b.allocator());
	fmt.println(xs.len());
}

// The region grows past its first block, so the block chain is exercised.
grows :: proc() {
	arena := mem.Arena.init();
	{
		xs: [dynamic]int via arena.allocator() = {};
		for (i := 0; i < 2000; i += 1) {
			xs.append(i);
		}
		fmt.println(xs.len());
		fmt.println(xs[1999]);
	}
	free_all(arena.allocator());
	fmt.println(1);
}

// Moving a provider preserves its record address and its region identity, so
// the owner backed by it keeps working through the move.
Holder :: struct { arena: mem.Arena }

moved :: proc() {
	arena := mem.Arena.init();
	xs: [dynamic]int via arena.allocator() = {};
	xs.append(7);
	holder := Holder{move(arena)};
	xs.append(8);
	fmt.println(xs.len());
	fmt.println(xs[1]);
	fmt.println(holder.arena.allocator() != nil);
}

// Nested regions: a provider whose parent is the program default, and a fixed
// arena laid over storage the outer region supplied.
nested :: proc() {
	outer := mem.Arena.init();
	room: [dynamic]u8 via outer.allocator() = {};
	room.resize(2048);
	inner := mem.Arena.from_buffer(room[:]);
	xs: [dynamic]int via inner.allocator() = {};
	xs.append(1, 2, 3, 4);
	fmt.println(xs.len());
	fmt.println(xs[3]);
}

// design.md "Explicit runtime environments": a provider is an ordinary field of
// an application record, which is what "runtime identity, passed explicitly"
// means in practice. The record inherits the provider's move-only lifecycle.
Request_Env :: struct {
	scratch: mem.Scratch,
	id:      int,
}

in_a_record :: proc(env: inout Request_Env) -> int {
	xs: [dynamic]int via env.scratch.allocator() = {};
	xs.append(env.id, env.id * 2);
	return xs[1];
}

environment :: proc() {
	env := Request_Env{mem.Scratch.init(), 21};
	fmt.println(in_a_record(inout env));
}

// Provider-backed children use the written parent allocator. Dropping the
// child ends that dependency, after which the parent can be reset and reused.
parented :: proc() {
	outer := mem.Arena.init();
	inner := mem.Arena.init(outer.allocator());
	xs: [dynamic]int via inner.allocator() = {};
	xs.append(7, 8, 9);
	fmt.println(xs[2]);
	child := make_child(inner.allocator());
	ys: [dynamic]int via child.allocator() = {};
	ys.append(10);
	fmt.println(ys[0]);
	drop(ys);
	drop(child);
	drop(xs);
	drop(inner);
	free_all(outer.allocator());
	fmt.println(1);
}

// A wrapper transfers a fresh provider owner rather than leaking only its
// allocator handle.
make_scratch :: proc() -> mem.Scratch { return mem.Scratch.init(); }
make_child :: proc(parent: Allocator) -> mem.Scratch { return mem.Scratch.init(parent); }

wrapped_provider :: proc() {
	scratch := make_scratch();
	xs: [dynamic]int via scratch.allocator() = {};
	xs.append(12);
	fmt.println(xs[0]);
}

// The fallible constructors report the parent provider's failure without
// invoking its policy. A fixed 4096-byte parent cannot supply the 4096-byte
// initial block requested by a child.
fallible_provider :: proc() {
	buffer: [4096]u8 = {};
	parent := mem.Arena.from_buffer(buffer[:]);
	switch (_ in mem.try_arena(parent.allocator())) {
	case .ok: fmt.println(false);
	case .err: fmt.println(true);
	}
	switch (_ in mem.try_scratch(parent.allocator())) {
	case .ok: fmt.println(false);
	case .err: fmt.println(true);
	}
}

main :: proc() {
	environment();
	parented();
	wrapped_provider();
	fallible_provider();
	in_frame();
	scratch_storage();
	reusable_reset();
	handle_survives_reset();
	reset_through_wrapper();
	dropped_owner_permits_reset();
	distinct_regions();
	grows();
	moved();
	nested();
}
