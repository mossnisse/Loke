// design.md "Widening by label": an anonymous union converts to a larger one
// with each of its alternatives, in any order, at every destination: a
// declaration, an assignment, an argument, a return, a literal element, and a
// bare `or_return`, whose smaller error set propagates with no operand. A place
// is copied and keeps its value, through the destination's allocator, unless it
// is a local's last use, which transfers; a temporary transfers; a wrapping
// label keeps the layer. An explicit conversion widens as an implicit one does.
// Constants and compile-time evaluation remap the tag too.
package main;
import "core:fmt";
import "core:mem";

Io_Error :: enum { Gone }
Parse_Error :: enum { Bad_Digit }
Net_Error :: enum { Refused }

Config_Error :: (io: Io_Error | parse: Parse_Error);
App_Error :: (io: Io_Error | parse: Parse_Error | net: Net_Error);

read :: proc(fail: bool) -> Result(int, Io_Error) {
	if (fail) { return .err(.Gone); }
	return 7;
}

parse :: proc(n: int) -> Result(int, Parse_Error) {
	if (n > 100) { return .err(.Bad_Digit); }
	return n * 10;
}

read_config :: proc(fail: bool, big: bool) -> Result(int, Config_Error) {
	n := read(fail) or_return .io;
	return parse(n * 100 if big else n) or_return .parse;
}

connect :: proc(port: int) -> Result(int, Net_Error) {
	if (port == 0) { return .err(.Refused); }
	return port;
}

// The callee's labels repeated in the caller's set flatten them.
start :: proc(fail: bool, big: bool, port: int) -> Result(int, App_Error) {
	config := read_config(fail, big) or_return;
	socket := connect(port) or_return .net;
	return config + socket;
}

// A wrapping label keeps the layer.
start_layered :: proc(fail: bool) -> Result(int, (config: Config_Error | net: Net_Error)) {
	return read_config(fail, false) or_return .config;
}

Text :: (word: string | blank:);
Wide :: (blank: | number: int | word: string);

show :: proc(w: Wide) {
	switch (w) {
	case .blank: fmt.println("blank");
	case .number(n): fmt.println("number", n);
	case .word(s): fmt.println("word", s);
	}
}

// An exact match is chosen over one that needs widening.
pick_text :: proc(t: Text) -> string { return "text"; }
pick_wide :: proc(w: Wide) -> string { return "wide"; }
pick :: proc{pick_wide, pick_text}

widen :: proc(t: Text) -> Wide {
	return t;
}

made :: proc() -> Text {
	return .word("made".copy());
}

CONSTANT : Text : .blank;
WIDE_CONSTANT : Wide : CONSTANT;

folded :: proc() -> int {
	t: Text = .blank;
	w: Wide = t;
	switch (w) {
	case .blank: return 1;
	case .number(n): return n;
	case .word(_): return 3;
	}
}

FOLDED :: folded();

failing :: proc() -> Result(int, Config_Error) {
	return .err(.parse(.Bad_Digit));
}

lifted :: proc() -> Result(int, App_Error) {
	n := failing() or_return;
	return n;
}

lifted_label :: proc() -> int {
	switch (lifted()) {
	case .ok(n): return n;
	case .err(e):
		switch (e) {
		case .io: return 1;
		case .parse: return 2;
		case .net: return 3;
		}
	}
}

LIFTED :: lifted_label();

// A move-only payload transfers from an owned local, a `move`, or a temporary.
Connection :: move_only struct { id: int }
Owned :: (conn: Connection | none:);
Wider :: (none: | other: int | conn: Connection);

returned :: proc() -> Wider {
	o: Owned = .conn(Connection{id = 5});
	return o;
}

moved :: proc() -> Wider {
	o: Owned = .conn(Connection{id = 6});
	w: Wider = move(o);
	return w;
}

temporary :: proc() -> Owned {
	return .conn(Connection{id = 7});
}

id_of :: proc(w: Wider) -> int {
	switch (w) {
	case .none: return 0;
	case .other(n): return n;
	case .conn(c): return c.id;
	}
}

// A one-address source widens into a tagged union.
Node :: struct { value: int }
Link :: (node: ^Node | end:);
Step :: (skip: int | end: | node: ^Node);

// A place is copied once at its own type, a borrowed argument is not copied,
// and every value is dropped once, under its wider tag. A copy adds 100.
Res :: struct { id: int }
impl Res {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Res, Allocator_Error) {
		return .ok(Res{self.id + 100});
	}
	release :: hook(drop) proc(self: inout Res) { if (self.id != 0) { fmt.println("drop", self.id); } }
}
Few :: (res: Res | none:);
Many :: (none: | res: Res | count: int);

take :: proc(m: Many) -> int {
	switch (m) {
	case .res(r): return r.id;
	case .none: return 0;
	case .count(n): return n;
	}
}

make_few :: proc(id: int) -> Few {
	return .res(Res{id});
}

pass_back :: proc(f: Few) -> Many {
	return f;
}

lifecycle :: proc() {
	{
		few: Few = .res(Res{1});
		many: Many = few;
		fmt.println(take(many), take(few));
		fmt.println(take(make_few(2)));
		back := pass_back(few);
		moved: Many = move(few);
		fmt.println(take(back), take(moved));
	}
	fmt.println("done");
}

// A local's last use transfers instead of copying, so no copy adds 100.
last_use :: proc() {
	{
		a: Few = .res(Res{1});
		b: Many = a;
		fmt.println(take(b));
	}
	{
		c: Few = .res(Res{2});
		d: Many = .none;
		d = c;
		fmt.println(take(d));
	}
	fmt.println("transferred");
}

// A copy into a destination with a `via` clones through it, after the value.
policy :: proc() -> Allocator {
	fmt.println("via");
	return mem.default_allocator();
}
Items :: (items: [dynamic]int | none:);
Wider_Items :: (none: | items: [dynamic]int | n: int);

policies :: proc() {
	a: Items = .items([dynamic]int{1});
	b: Wider_Items via policy() = a;
	b = a;
	fmt.println(a, b);
}

// An explicit conversion remaps the tag, also where both unions share one
// storage type, and moves a payload into larger storage.
Pair :: (n: int | none:);
Swapped :: (none: | n: int);
Block :: (a: [32]int | none:);
Bigger :: (none: | a: [32]int | more: [64]int);

casts :: proc() {
	pair: Pair = .n(42);
	fmt.println(Swapped(pair), Swapped(Pair.none));
	values: [32]int = {};
	values[0], values[31] = 1, 7;
	block: Block = .a(values);
	switch (Bigger(block)) {
	case .a(xs): fmt.println(xs[0], xs[31]);
	case .none: fmt.println("none");
	case .more(_): fmt.println("more");
	}
}

cast_label :: proc() -> int {
	pair: Pair = .n(3);
	switch (Swapped(pair)) {
	case .none: return 0;
	case .n(n): return n;
	}
}

CAST :: cast_label();
CAST_CONSTANT :: Swapped(Pair.n(5));

follow :: proc(s: Step) -> int {
	switch (s) {
	case .skip(n): return n;
	case .end: return -1;
	case .node(p): return p.value;
	}
}

main :: proc() {
	fmt.println(start(false, false, 2), start(true, false, 2));
	fmt.println(start(false, true, 2), start(false, false, 0));
	fmt.println(start_layered(true));

	text: Text = .word("hello".copy());
	wide: Wide = text;          // a place is copied
	show(wide);
	show(text);                 // an argument
	show(made());               // a temporary transfers
	wide = .number(4);
	show(wide);
	wide = text;                // an assignment
	show(wide);
	show(widen(.blank));        // a return
	fmt.println(text);

	items := [2]Wide{text, .number(9)};
	fmt.println(items);
	list: [dynamic]Wide = {};
	list.append(text);
	list.append(made());
	fmt.println(list);

	fmt.println(pick(text), pick(Wide.number(1)));
	fmt.println(WIDE_CONSTANT, FOLDED);
	fmt.println(wide == text, Wide.number(1) == text);
	fmt.println(size_of(Wide) >= size_of(Text));
	fmt.println(LIFTED, lifted());

	fmt.println(id_of(returned()), id_of(moved()), id_of(temporary()));

	node := Node{value = 8};
	link: Link = .node(&node);
	end: Link = .end;
	fmt.println(follow(link), follow(end));
	lifecycle();
	last_use();
	policies();
	casts();
	fmt.println(CAST, CAST_CONSTANT);
}
