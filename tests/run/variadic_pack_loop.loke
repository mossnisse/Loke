package main;
import "core:fmt";

// design.md "Variadic parameters": a pack with a spread is sized at run time.
// Its storage ends with the call's full expression, so a loop does not keep
// every iteration's pack; enough iterations would otherwise exhaust the stack.
sum :: proc(values: ..int) -> int {
	result := 0;
	foreach (v in values) { result += v; }
	return result;
}

lengths :: proc(values: ..string) -> int {
	result := 0;
	foreach (v in values) { result += v.len(); }
	return result;
}

main :: proc() {
	values := [2]int{2, 3};
	total := 0;
	for (i := 0; i < 200000; i += 1) {
		total += sum(1, ..values[:]);
	}
	fmt.println(total);

	// A managed pack, and one reached only on some iterations.
	words := [2]string{"ab", "cde"};
	letters := 0;
	for (i := 0; i < 200000; i += 1) {
		letters += lengths("f", ..words[:]);
		if (i % 2 == 0 && sum(..values[:]) == 5) { letters += 1; }
	}
	fmt.println(letters);
}
