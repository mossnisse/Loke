package main;

Point :: struct { x: int, y: int }

// Defaults may reference `self` and parameters to their left, and are evaluated
// in parameter order once every supplied argument is bound.
scaled :: proc(base: int, factor: int = 2, bias: int = base + factor) -> int {
	return base * factor + bias;
}

// Value parameters are immutable but addressable; `inout` is a mutable alias.
bump :: proc(counter: inout int, by: int) {
	counter += by;
}

move_point :: proc(p: inout Point, dx: int, dy: int) {
	p.x += dx;
	p.y += dy;
}

// Multiple and named results.
divmod :: proc(a: int, b: int) -> (int, int) {
	return a / b, a % b;
}

minmax :: proc(a: int, b: int) -> (low: int, high: int) {
	if (a < b) {
		low = a;
		high = b;
		return;
	}
	low = b;
	high = a;
	return;
}

forward :: proc(a: int, b: int) -> (int, int) {
	return divmod(a, b);
}

// Direct and mutual recursion.
factorial :: proc(n: int) -> int {
	if (n <= 1) { return 1; }
	return n * factorial(n - 1);
}

is_even :: proc(n: int) -> bool {
	if (n == 0) { return true; }
	return is_odd(n - 1);
}

is_odd :: proc(n: int) -> bool {
	if (n == 0) { return false; }
	return is_even(n - 1);
}

// A bare early return still drains the cleanup stack.
early :: proc(n: int) -> int {
	defer print_int(-1);
	if (n < 0) {
		return 0;
	}
	return n * 2;
}

apply :: proc(f: proc(a: int, b: int) -> int, a: int, b: int) -> int {
	return f(a, b);
}

add :: proc(a: int, b: int) -> int {
	return a + b;
}

multiply :: proc(a: int, b: int) -> int {
	return a * b;
}

main :: proc() {
	print_int(scaled(3));
	print_int(scaled(3, 4));
	print_int(scaled(3, 4, 5));
	print_int(scaled(bias = 1, base = 2));
	print_int(scaled(2, factor = 3));

	n := 10;
	bump(inout n, 5);
	print_int(n);

	p := Point{1, 2};
	move_point(inout p, 10, 20);
	print_int(p.x);
	print_int(p.y);

	q, r := divmod(17, 5);
	print_int(q);
	print_int(r);

	low, high := minmax(9, 4);
	print_int(low);
	print_int(high);

	a, b := forward(20, 6);
	print_int(a);
	print_int(b);

	print_int(factorial(6));
	print_int(1 if is_even(10) else 0);
	print_int(1 if is_odd(10) else 0);

	print_int(early(3));
	print_int(early(-3));

	// A procedure value: assigned, reassigned, and called indirectly.
	op: proc(a: int, b: int) -> int = add;
	print_int(op(6, 7));
	op = multiply;
	print_int(op(6, 7));
	print_int(apply(add, 100, 23));

	// A non-capturing procedure literal is hoisted to its own function.
	square := proc(a: int, b: int) -> int { return a * a + b; };
	print_int(square(5, 1));
	print_int(apply(square, 4, 2));
}
