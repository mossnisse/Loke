package main; import "core:fmt";

Point :: struct { x: int, y: int }

// Defaults may reference `self` and parameters to their left, and are evaluated
// in parameter order once every supplied argument is bound.
scaled :: proc(base: int, factor: int = 2, bias: int = base + factor) -> int {
	return base * factor + bias;
}

// Value parameters are immutable but addressable; `inout` is a mutable alias.
bump :: proc(counter: inout int, by: int) {
	counter += by;
}

move_point :: proc(p: inout Point, dx: int, dy: int) {
	p.x += dx;
	p.y += dy;
}

// One result, spelled as an anonymous record when it carries several values.
// Every path returns the whole record; there are no result locals to fill in.
divmod :: proc(a: int, b: int) -> (quotient: int, remainder: int) {
	return {quotient = a / b, remainder = a % b};
}

minmax :: proc(a: int, b: int) -> (low: int, high: int) {
	if (a < b) {
		return {low = a, high = b};
	}
	return {low = b, high = a};
}

// A record result passes straight through, because it is one value.
forward :: proc(a: int, b: int) -> (quotient: int, remainder: int) {
	return divmod(a, b);
}

// Direct and mutual recursion.
factorial :: proc(n: int) -> int {
	if (n <= 1) { return 1; }
	return n * factorial(n - 1);
}

is_even :: proc(n: int) -> bool {
	if (n == 0) { return true; }
	return is_odd(n - 1);
}

is_odd :: proc(n: int) -> bool {
	if (n == 0) { return false; }
	return is_even(n - 1);
}

// A bare early return still drains the cleanup stack.
early :: proc(n: int) -> int {
	defer fmt.println(-1);
	if (n < 0) {
		return 0;
	}
	return n * 2;
}

apply :: proc(f: proc(a: int, b: int) -> int, a: int, b: int) -> int {
	return f(a, b);
}

add :: proc(a: int, b: int) -> int {
	return a + b;
}

multiply :: proc(a: int, b: int) -> int {
	return a * b;
}

main :: proc() {
	fmt.println(scaled(3));
	fmt.println(scaled(3, 4));
	fmt.println(scaled(3, 4, 5));
	fmt.println(scaled(bias = 1, base = 2));
	fmt.println(scaled(2, factor = 3));

	n := 10;
	bump(inout n, 5);
	fmt.println(n);

	p := Point{1, 2};
	move_point(inout p, 10, 20);
	fmt.println(p.x);
	fmt.println(p.y);

	q, r := divmod(17, 5);
	fmt.println(q);
	fmt.println(r);

	low, high := minmax(9, 4);
	fmt.println(low);
	fmt.println(high);

	a, b := forward(20, 6);
	fmt.println(a);
	fmt.println(b);

	fmt.println(factorial(6));
	fmt.println(1 if is_even(10) else 0);
	fmt.println(1 if is_odd(10) else 0);

	fmt.println(early(3));
	fmt.println(early(-3));

	// A procedure value: assigned, reassigned, and called indirectly.
	op: proc(a: int, b: int) -> int = add;
	fmt.println(op(6, 7));
	op = multiply;
	fmt.println(op(6, 7));
	fmt.println(apply(add, 100, 23));

	// A non-capturing procedure literal is hoisted to its own function.
	square := proc(a: int, b: int) -> int { return a * a + b; };
	fmt.println(square(5, 1));
	fmt.println(apply(square, 4, 2));
}
