package main;

import "core:container";
import "core:fmt";
import "core:slice";

// standard-library.md "Heaps": the algorithms work on any slice, with the order
// `sort_by` would give under the same comparator, and allocate nothing.

@(move_only) Token :: struct { id: int }

By_Id :: struct {}
impl By_Id {
	call :: proc(self, left, right: Token) -> bool { return left.id < right.id; }
}

next :: proc(state: inout u64) -> u64 {
	state ~= state << 13;
	state ~= state >> 7;
	state ~= state << 17;
	return state;
}

main :: proc() {
	// Empty and single-element slices are no-ops.
	nothing: [dynamic]int = {};
	asc := slice.Ascending(int){};
	slice.make_heap(&mut nothing[:], asc);
	slice.push_heap(&mut nothing[:], asc);
	slice.pop_heap(&mut nothing[:], asc);
	slice.sift_heap_top(&mut nothing[:], asc);
	fmt.println(slice.is_heap(nothing[:], asc));

	one := [1]int{7};
	slice.push_heap(&mut one[:], asc);
	slice.pop_heap(&mut one[:], asc);
	fmt.println(one[0], slice.is_heap(one[:], asc));

	// The layout is specified: each parent is at (i - 1) / 2.
	bad := [3]int{2, 1, 3};
	fmt.println(slice.is_heap(bad[:], asc));
	made := [5]int{4, 1, 3, 2, 5};
	slice.make_heap(&mut made[:], asc);
	fmt.println(slice.is_heap(made[:], asc), made[0]);
	slice.make_heap(&mut made[:], slice.Descending(int){});
	fmt.println(slice.is_heap(made[:], slice.Descending(int){}), made[0]);

	// A fixed-capacity queue needs nothing else, and drains in sorted order.
	open: container.Small_Array(int, 64) = {};
	state: u64 = 0x9E3779B97F4A7C15;
	model: [dynamic]int = {};
	foreach (_ in 0 ..< 64) {
		value := int(next(inout state) % 50);
		model.append(value);
		open.append(value);
		slice.push_heap(open.slice(), asc);
		if (!slice.is_heap(open.view(), asc)) { fmt.println("broken after push"); }
	}
	model.sort();
	at := 0;
	for (open.len() > 0) {
		slice.pop_heap(open.slice(), asc);
		if (!slice.is_heap(open.view()[:open.len() - 1], asc)) { fmt.println("broken after pop"); }
		top := open.pop() or_else panic("empty");
		if (top != model[at]) { fmt.println("out of order", top, model[at]); }
		at += 1;
	}
	fmt.println("drained", at);

	// sift_heap_top after the first element changed.
	sifted := [6]int{1, 2, 3, 4, 5, 6};
	sifted[0] = 9;
	slice.sift_heap_top(&mut sifted[:], asc);
	fmt.println(slice.is_heap(sifted[:], asc), sifted[0]);

	// The same comparators sort.
	sorted := [4]int{3, 1, 4, 2};
	slice.sort_by(&mut sorted[:], slice.Descending(int){});
	fmt.println(sorted);
	slice.sort_by(&mut sorted[:], asc);
	fmt.println(sorted);

	// A move-only element is sifted without a copy.
	tokens: [dynamic]Token = {};
	foreach (id in [4]int{3, 0, 2, 1}) {
		tokens.append(Token{id});
		slice.push_heap(&mut tokens[:], By_Id{});
	}
	for (tokens.len() > 0) {
		slice.pop_heap(&mut tokens[:], By_Id{});
		t := tokens.pop() or_else panic("empty");
		fmt.print(t.id, "");
	}
	fmt.println();

	// A comparator that defines no ordering loses nothing and stays in range.
	always := proc(left, right: int) -> bool { return true; };
	never := proc(left, right: int) -> bool { return false; };
	erratic := proc(left, right: int) -> bool { return (left ~ right) & 1 == 0; };
	values := [32]int{};
	foreach (i in 0 ..< values.len()) { values[i] = i; }
	slice.make_heap(&mut values[:], always);
	foreach (i in 0 ..< values.len()) { slice.push_heap(&mut values[:i + 1], always); }
	foreach (i in 0 ..< values.len()) { slice.pop_heap(&mut values[:values.len() - i], never); }
	slice.make_heap(&mut values[:], erratic);
	foreach (i in 0 ..< values.len()) { slice.pop_heap(&mut values[:values.len() - i], erratic); }
	slice.sort(&mut values[:]);
	whole := true;
	foreach (i in 0 ..< values.len()) { whole = whole && values[i] == i; }
	fmt.println("permutation", whole);
}
