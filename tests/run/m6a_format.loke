package main;

// design.md "String format printing": formatting is a receiver-method protocol.
// The `value.format(writer, options)` protocol selects that method,
// and runtime formatting is coherent per concrete `typeid`. The compiler
// supplies a formatter for every printable built-in; a package may write one
// for a type it declares, and that one wins for erased printing too.

import "core:fmt";
import "base:runtime";
import "core:mem";

Colour :: enum { Red, Green = 5, Blue }

Point :: struct {
	@(public) x: int,
	@(public) y: i32,
}

Value :: union { count: int, flag: bool }

Money :: struct { @(public) cents: int }

Meters :: distinct int;

impl Meters {
	format :: proc(self, w: fmt.Writer, o: fmt.Options) {
		fmt.format_to(w, "meters");
	}
}

// Declared in `Money`'s own package, so this is the eligible formatter.
impl Money {
	format :: proc(self, w: fmt.Writer, o: fmt.Options) {
		fmt.format_to(w, "$", self.cents);
	}
}

// A writer is one procedure and its state, so a counting sink is an ordinary
// value of the same type the standard ones have.
count_bytes :: proc(state: rawptr, bytes: [^]u8, count: int) {
	total := (^mut int)(state);
	total^ = total^ + count;
}

main :: proc() {
	// Scalars, in every shape the generated thunks spell.
	fmt.println(1, -7, u8(255), true, 'A', 3.5);

	// Text: an owning string and a borrowed view print the same bytes.
	s: string = "hej";
	v: string_view = s;
	fmt.println(s, v);

	// Pointers and identities.
	p: ^int = {};
	fmt.println(p);
	fmt.println(typeid_of(int));

	// Aggregates: enum, struct, fixed array, slice, and union.
	fmt.println(Colour.Green, Colour.Red);
	fmt.println(Point{1, 2});
	xs := [?]int{10, 20, 30};
	fmt.println(xs);
	fmt.println(xs[:]);
	u: Value = .count(4);
	fmt.println(u);

	// The user-owned formatter, direct and through the erased path.
	m := Money{250};
	fmt.println(m);

	// A location is an ordinary record, so it prints like one.
	fmt.println(source_location().procedure, source_location().line);

	// `eprint` goes to the error stream, which the corpus does not capture.
	fmt.eprintln("to stderr");

	// A writer the program supplies itself.
	total := 0;
	sink := fmt.Writer{count_bytes, rawptr(&mut total)};
	fmt.format_to(sink, 1, 22, 333);
	fmt.println(total);

	// Formatting keeps all 128 value bits, and a distinct type owns its formatter
	// rather than inheriting the formatter of its representation.
	fmt.println(i128(18446744073709551617), u128(18446744073709551617));
	fmt.println(Meters(3));
	// `Options` chooses the spelling. The seed runtime has always implemented
	// base 2 to 36 and both digit cases; `format_to_with` is what reaches them.
	out := fmt.stdout();
	fmt.format_to_with(out, fmt.Options{16, false}, u32(3405691582));
	fmt.format_to_with(out, fmt.Options{16, true}, u32(3405691582));
	fmt.println("");
	fmt.format_to_with(out, fmt.Options{2, false}, u8(5));
	fmt.format_to_with(out, fmt.Options{36, true}, int(1295));
	fmt.println("");

	// A base outside 2 to 36 reads as 10, which is what `Options` documents.
	fmt.format_to_with(out, fmt.Options{1, false}, 255);
	fmt.format_to_with(out, fmt.Options{37, false}, 255);
	fmt.println("");

	// The separator and the sign are the default path's, not the base's.
	fmt.format_to_with(out, fmt.Options{16, true}, i128(-255), u128(255));
	fmt.println("");

	// `to_string` formats into storage from the allocator it is handed. The
	// arena is sized for the scratch buffer and the string both.
	room: [4096]u8 = {};
	arena := mem.Arena.from_buffer(room[:]);
	text := fmt.to_string(arena.allocator(), "id", 7);
	fmt.println(text, text.len());

	// A float prints the shortest spelling that reads back as itself, at its own
	// width, in fixed notation from 1e-4 to below 1e17; NaN has one spelling.
	fmt.println(0.1, 0.3 - 0.1, 10.0, 1.5e10, 1e17, 0.00001);
	fmt.println(f32(0.1), f32(1) / f32(3));
	zero := 0.0;
	fmt.println(zero / zero, -1.0 / zero);
}
