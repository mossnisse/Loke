// design.md "@(concurrent_regions)": a parameter whose caller promises that
// its regions accept concurrent use. A helper lent a queue sends what it holds,
// a record that owns the queue is lent the same way, tasks share a given
// allocator and fill the slots of a given slice, and the parent uses such a
// region while they run. A procedure without the attribute stores in a type
// with it, whose calls check more. A task's parameter carries the promise as
// any other does, checked at the spawn, and so does the entry of a thread
// `thread.spawn` starts: each sends on what its own state holds. A spawned call
// hands an owner to a `@(cross_thread)` parameter as a plain call does.
package main;

import "core:fmt";
import "core:mem";
import "core:thread";

Job :: struct { id: int, values: [dynamic]int }
Burst :: struct { queue: [dynamic]Job, sent: int }

send_all :: proc(send: ^thread.Sender(Job), @(concurrent_regions) queue: inout [dynamic]Job) {
	for (case .some(job) = queue.pop()) {
		switch (send.send(move(job))) {
		case .ok:
		case .err(_): return;
		}
	}
}

impl Burst {
	flush :: proc(@(concurrent_regions) self: inout, send: ^thread.Sender(Job)) {
		send_all(send, inout self.queue);
		self.sent += 1;
	}
}

// Sends one job built with the allocator it was given.
send_built :: proc(send: ^thread.Sender(Job), @(concurrent_regions) allocator: mem.Allocator, id: int) {
	job := Job{id = id, values = make([dynamic]int, 0, 4, allocator)};
	job.values.append(id);
	_ = send.send(move(job));
}

allocate_work :: proc(allocator: mem.Allocator, n: int) -> int {
	values := make([dynamic]int, 0, n, allocator);
	foreach (i in 0 ..< n) { values.append(i); }
	return values.len();
}

fan_out :: proc(@(concurrent_regions) allocator: mem.Allocator) -> int {
	a, b, c: int;
	parallel {
		spawn a = allocate_work(allocator, 3);
		spawn b = allocate_work(allocator, 4);
		// The parent uses the region while the tasks run.
		c = allocate_work(allocator, 5);
	}
	return a + b + c;
}

fill :: proc(n: int, slot: []mut Option([dynamic]int)) {
	values: [dynamic]int = {};
	values.append(n * n);
	slot[0] = .some(move(values));
}

fill_all :: proc(@(concurrent_regions) slots: []mut Option([dynamic]int)) {
	parallel {
		foreach (slot, i in slots.chunks_mut(1).indexed()) { spawn fill(i, slot); }
	}
}

Fan :: proc(@(concurrent_regions) allocator: mem.Allocator) -> int;

unmarked_fan :: proc(allocator: mem.Allocator) -> int {
	return allocate_work(allocator, 2);
}

Keeper :: struct { kept: [dynamic]int }

// A worker that replies with what its state holds, not a copy of it.
serve :: proc(jobs: move thread.Receiver(int), replies: move thread.Sender([dynamic]int), @(concurrent_regions) keeper: move Keeper) {
	foreach (job in jobs) {
		keeper.kept.append(job);
		_ = replies.send(exchange(inout keeper.kept, {}));
	}
}

lend_kept :: proc(@(concurrent_regions) keeper: ^Keeper) -> int { return keeper.kept.len(); }

worker_replies :: proc() -> int {
	jobs := thread.Channel(int).init(1);
	replies := thread.Channel([dynamic]int).init(1);
	keeper := Keeper{};
	lent := Keeper{};
	lent.kept.append(7);
	total := 0;
	seen: int;
	parallel {
		send, take := jobs.split();
		give, receive := replies.split();
		spawn serve(move(take), move(give), move(keeper));
		spawn seen = lend_kept(&lent);
		foreach (job in 1 ..= 3) {
			_ = send.send(move(job));
			switch (receive.receive()) {
			case .some(reply): total += reply[0];
			case .none:
			}
		}
		jobs.close();
	}
	return total + seen;
}

// What a channel's `send` does with an item: it goes to another thread.
crosses :: proc(@(cross_thread, escape=static) values: move [dynamic]int) -> int { return values.len(); }

entry :: proc(@(concurrent_regions) keeper: move Keeper) {
	fmt.println(crosses(exchange(inout keeper.kept, {})));
}

main :: proc() {
	channel := thread.Channel(Job).init(8);
	send, receive := channel.split();

	queue: [dynamic]Job = {};
	queue.append(Job{id = 1});
	queue.append(Job{id = 2});
	send_all(&send, inout queue);

	burst := Burst{};
	burst.queue.append(Job{id = 3});
	burst.flush(&send);
	send_built(&send, mem.default_allocator(), 4);

	total := 0;
	foreach (_ in 0 ..< 4) {
		switch (receive.receive()) {
		case .some(job): total += job.id + job.values.len();
		case .none:
		}
	}
	fmt.println(total, burst.sent, queue.len());

	fmt.println(fan_out(mem.default_allocator()));

	slots: [dynamic]Option([dynamic]int) = {};
	foreach (_ in 0 ..< 4) { slots.append(.none); }
	fill_all(slots[mut :]);
	sum := 0;
	foreach (slot in slots) {
		switch (slot) {
		case .some(values): sum += values[0];
		case .none:
		}
	}
	fmt.println(sum);

	fan: Fan = fan_out;
	fmt.println(fan(mem.default_allocator()));
	fan = unmarked_fan;
	fmt.println(fan(mem.default_allocator()));

	fmt.println(worker_replies());
	started := Keeper{};
	started.kept.append(1);
	started.kept.append(2);
	worker := thread.spawn(entry, move(started));
	worker.join();

	crossing: [dynamic]int = {};
	crossing.append(1);
	crossed: int;
	parallel { spawn crossed = crosses(move(crossing)); }
	fmt.println(crossed);
}
