package main; import "core:fmt"; import "core:io"; import "core:term";

// `core:term`'s output half (standard-library "`core:term`").
//
// The harness captures standard output, so this is also the redirected-stream
// case: `Output` writes through whatever handle the process was given, console
// or pipe alike. Input is not read here — a corpus program has no terminal of
// its own, and `examples/greeting.loke` is where a person drives that half.

main :: proc() {
	static_assert(io.Writer(term.Output));
	static_assert(io.Reader(term.Input));

	// `fmt` buffers a redirected standard output and `term` does not, so a term
	// write flushes what `fmt` holds first; without that, this line came last.
	fmt.println("printed by fmt first");

	out := term.stdout();
	fmt.println(io.write_string(inout out, "written through term.stdout\n") == nil);
	fmt.println(io.write_formatted_line(inout out, "formatted:", 42, true) == nil);

	// A zero-length write succeeds immediately and moves nothing.
	empty: [0]u8 = {};
	count := out.write(empty[:]) or_else -1;
	fmt.println(count);
	fmt.println(count >= 0);

	// Standard error is a second, independent handle.
	problem := term.stderr();
	fmt.println(io.write_string(inout problem, "") == nil);
}
