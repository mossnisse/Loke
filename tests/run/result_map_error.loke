package main; import "core:fmt";

// Changing a Result's error domain without a second exception system.
//
// design.md "or_return operator": a failure propagates only where its payload is
// already assignable, so a parser's `Parse_Error` cannot enter an application's
// `App_Error` on its own — two variants may carry the same payload type, so
// nothing could guess which one was meant. `map_error` names the variant through
// an ordinary procedure and leaves `or_return` as the visible early return.

Parse_Error :: enum { Bad_Digit, Empty }

App_Error :: union { parse: Parse_Error, io: int }

// A union constructor is not a callable value, so the mapper is written out. It
// owns the error it is handed, and its result is the target `map_error` infers.
to_app :: proc(error: move Parse_Error) -> App_Error { return .parse(error); }

parse :: proc(ok: bool) -> Result(int, Parse_Error) {
	if (ok) { return .ok(21); }
	return .err(.Bad_Digit);
}

// The receiver is a temporary, so the transfer needs no marker.
doubled :: proc(ok: bool) -> Result(int, App_Error) {
	n := parse(ok).map_error(to_app) or_return;
	return .ok(n * 2);
}

// A bound result is a place: giving it away is written out, exactly as it is for
// a consuming parameter.
from_place :: proc() -> Result(int, App_Error) {
	outcome := parse(false);
	n := move(outcome).map_error(to_app) or_return;
	return .ok(n);
}

// A move-only success payload is relocated, never cloned, so mapping the error
// side leaves it untouched. The drop prints, so a lost or doubled one shows.
Handle :: move_only struct { id: int }

impl Handle {
	release :: hook(drop) proc(self: inout Handle) { fmt.println(self.id); }
}

open :: proc() -> Result(Handle, Parse_Error) { return .ok(Handle{7}); }

opened :: proc() -> Result(int, App_Error) {
	handle := open().map_error(to_app) or_return;
	return .ok(handle.id);
}

report :: proc(label: int, outcome: Result(int, App_Error)) {
	fmt.println(label);
	switch (r in outcome) {
	case .ok:  fmt.println(r);
	case .err: fmt.println(r);
	}
}

// design.md "Changing error domains": the mapper moves a managed error into its
// new variant. The copy hook adds 100 and the drop prints, so a clone, a lost
// drop, or a doubled one all show.
Detail :: struct { id: int }

impl Detail {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Detail, Allocator_Error) {
		return .ok(Detail{self.id + 100});
	}
	release :: hook(drop) proc(self: inout Detail) { fmt.println("drop", self.id); }
}

Detail_Error :: union { detail: Detail, io: int }

wrap :: proc(error: move Detail) -> Detail_Error { return .detail(move(error)); }

failed :: proc() -> Result(int, Detail) { return .err(Detail{5}); }

detailed :: proc() -> Result(int, Detail_Error) {
	n := failed().map_error(wrap) or_return;
	return .ok(n);
}

// A move-only error maps too, which a mapper that only borrowed it could not do:
// the token the error holds reaches the caller instead of being dropped.
Token :: move_only struct { id: int }

impl Token {
	release :: hook(drop) proc(self: inout Token) { fmt.println("drop", self.id); }
}

Full :: struct { rejected: Token }

Store_Error :: union { full: Full, io: int }

to_store :: proc(error: move Full) -> Store_Error { return .full(move(error)); }

store :: proc(token: move Token) -> Result(Unit, Full) { return .err(Full{move(token)}); }

stored :: proc() -> Result(Unit, Store_Error) {
	store(Token{6}).map_error(to_store) or_return;
	return .ok;
}

main :: proc() {
	report(1000, doubled(true));
	report(2000, doubled(false));
	report(3000, from_place());
	report(4000, opened());

	fmt.println(5000);
	switch (outcome in detailed()) {
	case .ok: fmt.println(outcome);
	case .err:
		switch (error in outcome) {
		case .detail: fmt.println(error.id);
		case .io:     fmt.println(error);
		}
	}

	fmt.println(6000);
	switch (outcome in stored()) {
	case .ok: fmt.println("stored");
	case .err:
		switch (error in outcome) {
		case .full: fmt.println(error.rejected.id);
		case .io:   fmt.println(error);
		}
	}
}
