// design.md "Weakening and reborrows": a reordering is not a copy, however a callee
// writes it. A swap or rotation through a temporary, or a copy whose landing place is
// then replaced, leaves each carrier in one place when the call returns, so the caller
// may use every one of them.
package main;
import "core:fmt";
Link :: struct { to: ^mut int }
Pair :: struct { a: ^mut int, b: ^mut int }
by_view :: proc(links: []mut Link) {
	held := links[0];
	links[0] = links[1];
	links[1] = held;
}
by_pointer :: proc(pair: ^mut Pair) {
	held := pair^.a;
	pair^.a = pair^.b;
	pair^.b = held;
}
by_inout :: proc(pair: inout Pair) {
	held := pair.a;
	pair.a = pair.b;
	pair.b = held;
}
rotated :: proc(links: []mut Link) {
	held := links[0];
	links[0] = links[1];
	links[1] = links[2];
	links[2] = held;
}
copied_then_replaced :: proc(links: []mut Link, @(escape=stored) fresh: ^mut int) {
	links[0] = links[1];
	links[0] = Link{fresh};
}
view_case :: proc() {
	a, b, c := 1, 2, 3;
	links := [3]Link{Link{&mut a}, Link{&mut b}, Link{&mut c}};
	by_view(&mut links[:]);
	links[0].to^ += 10;
	links[1].to^ += 20;
	rotated(&mut links[:]);
	links[0].to^ += 1;
	links[1].to^ += 2;
	links[2].to^ += 3;
	fmt.println(links[0].to^, links[1].to^, links[2].to^);
}
pair_case :: proc() {
	a, b := 1, 2;
	pair := Pair{&mut a, &mut b};
	by_pointer(&mut pair);
	pair.a^ += 100;
	pair.b^ += 200;
	by_inout(inout pair);
	pair.a^ += 1000;
	pair.b^ += 2000;
	fmt.println(pair.a^, pair.b^);
}
replaced_case :: proc() {
	a, b, f := 1, 2, 4;
	links := [2]Link{Link{&mut a}, Link{&mut b}};
	copied_then_replaced(&mut links[:], &mut f);
	links[0].to^ += 5;
	links[1].to^ += 6;
	fmt.println(links[0].to^, links[1].to^);
}
main :: proc() {
	view_case();
	pair_case();
	replaced_case();
}
