package main;

// Ownership/lifecycle regression cases found during the M5a implementation
// audit. The hooks make a clone and every missing cleanup observable.
Res :: struct { id: int }

impl Res {
	try_clone :: proc(self, allocator: Allocator) -> (Res, Allocator_Error) {
		return Res{self.id + 100}, nil;
	}

	drop :: proc(self: inout Res) {
		if (self.id != 0) { print_int(self.id); }
		self.id = 0;
	}
}

Box :: struct { item: Res }

conditional_move :: proc() {
	print_int(1000);
	a := Res{1};
	b := Res{2};
	flag := true;
	c := move(a) if flag else move(b);
	print_int(c.id);
}

aggregate_copy :: proc() {
	print_int(2000);
	source := Res{3};
	box := Box{source};
	print_int(box.item.id);
}

continue_runs_post :: proc() {
	print_int(3000);
	x := Res{4};
	i := 0;
	for (; i < 2; x = Res{10 + i}) {
		print_int(x.id);
		i += 1;
		continue;
	}
}

main :: proc() {
	conditional_move();
	aggregate_copy();
	continue_runs_post();
}
