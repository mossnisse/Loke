package main; import "core:fmt"; import "core:strconv";

// design.md "Compile-time procedure evaluation": slicing means at compile time
// what it means at run time. A slice views the elements it was taken from, so
// a write through a `[]mut T` reaches the original, and text slices by bytes.

tail :: proc(text: string_view) -> int { return text[1:3].len(); }
sum :: proc(xs: []int) -> int { t := 0; foreach (x in xs) { t += x; } return t; }
fill :: proc(xs: []mut int) { xs[0] = 9; }

in_array :: proc() -> int {
	a := [3]int{1, 2, 3};
	fill(a[1:]);
	return sum(a[:]) * 100 + a[1];
}

in_dynamic :: proc() -> int {
	d := [dynamic]int{4, 5, 6};
	s: []mut int = d[:2];
	fill(s);
	t: []int = s;
	n := sum(t[1:]);
	return d[0] + n;
}

rest :: proc() -> string_view { s: string_view = "héllo"; return s[3:]; }

NUMBERS :: [?]int{7, 42, 628};

A :: tail("xyz");
B :: in_array();
C :: in_dynamic();
D :: rest();
E :: strconv.parse_i64("-42") or_else 0;
F :: NUMBERS[1:];

main :: proc() {
	fmt.println(A, B, C, D, E, F);
	fmt.println(tail("xyz"), in_array(), in_dynamic(), rest());
}
