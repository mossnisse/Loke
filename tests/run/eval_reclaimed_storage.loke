// design.md "Compile-time procedure evaluation": the memory limit counts what
// evaluation holds live. Each of these arguments takes `core:math/repro`'s
// fixed-point slow path, whose integer arithmetic once kept 8 to 14 MB a call
// charged, so a constant folded four such calls but not eight; what the
// arithmetic releases is now reused. Each folded result matches the same call at
// run time.
package main;

import "core:fmt";
import "core:math/repro";
import "core:unsafe";

SIN_A :: u32(0x4371ade3);
SIN_B :: u32(0x46199998);
COS_C :: u32(0x3c107fe6);
EXP_D :: u32(0xc16912cd);

FOLDED :: [8]f32{
	repro.sin_f32(unsafe.transmute(f32, SIN_A)),
	repro.sin_f32(unsafe.transmute(f32, SIN_B)),
	repro.cos_f32(unsafe.transmute(f32, COS_C)),
	repro.exp_f32(unsafe.transmute(f32, EXP_D)),
	repro.sin_f32(unsafe.transmute(f32, SIN_A)),
	repro.sin_f32(unsafe.transmute(f32, SIN_B)),
	repro.cos_f32(unsafe.transmute(f32, COS_C)),
	repro.exp_f32(unsafe.transmute(f32, EXP_D)),
};

// Sixteen `f64` slow paths through one helper, which held 75 MB before.
LOGS :: sum_logs(16);

sum_logs :: proc(count: int) -> f64 {
	x := unsafe.transmute(f64, u64(0x3ff0000000000006));
	total := 0.0;
	for (i := 0; i < count; i += 1) {
		total += repro.log(x);
	}
	return total;
}

at_run_time :: proc(i: int, x: f32) -> f32 {
	if (i % 4 < 2) { return repro.sin_f32(x); }
	if (i % 4 == 2) { return repro.cos_f32(x); }
	return repro.exp_f32(x);
}

main :: proc() {
	arguments := [4]u32{SIN_A, SIN_B, COS_C, EXP_D};
	for (i := 0; i < 8; i += 1) {
		expected := at_run_time(i, unsafe.transmute(f32, arguments[i % 4]));
		fmt.println(unsafe.transmute(u32, FOLDED[i]) == unsafe.transmute(u32, expected));
	}
	fmt.println(unsafe.transmute(u64, LOGS) == unsafe.transmute(u64, sum_logs(16)));
}
