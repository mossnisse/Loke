package main; import "core:fmt"; import "core:strings"; import "core:mem";

// `core:strings` end to end (standard-library "`core:strings`").

// The builder's fallible half answers with `Status(Allocator_Error)`;
// these checks only care which variant came back.
succeeded :: proc(outcome: Status(Allocator_Error)) -> bool {
	switch (outcome) {
	case .ok:  return true;
	case .err: return false;
	}
	return false;
}

main :: proc() {
	text: string_view = "Hej, världen";

	// Queries. Every index is a byte offset, so `värld` starts at 5.
	fmt.println(strings.contains(text, "värld"));
	fmt.println(strings.contains(text, "world"));
	fmt.println(strings.starts_with(text, "Hej"));
	fmt.println(strings.ends_with(text, "en"));
	switch (strings.index(text, "v")) {
	case .some(at):
		fmt.println(at);
		fmt.println(true);
	case .none:
		fmt.println(-1);
		fmt.println(false);
	}
	switch (strings.index(text, "zz")) {
	case .some(missing):
		fmt.println(missing);
		fmt.println(true);
	case .none:
		fmt.println(-1);
		fmt.println(false);
	}
	fmt.println(strings.last_index("abcabc", "b") or_else -1);
	fmt.println(strings.index_byte(text, u8(',')) or_else -1);
	fmt.println(strings.index_rune(text, 'ä') or_else -1);
	fmt.println(strings.count("a,b,c", ","));
	fmt.println(strings.count("aaaa", "aa"));

	// The documented empty-needle behaviour.
	switch (strings.index("abc", "")) {
	case .some(empty_at):
		fmt.println(empty_at);
		fmt.println(true);
	case .none:
		fmt.println(-1);
		fmt.println(false);
	}
	fmt.println(strings.last_index("abc", "") or_else -1);
	fmt.println(strings.count("abc", ""));

	// Trimming borrows: no allocation, and Unicode whitespace counts.
	padded: string_view = "  hi \t";
	fmt.println(strings.trim_space(padded));
	fmt.println(strings.trim_left_space(padded).len());
	fmt.println(strings.trim_right_space("hi  ") == "hi");
	fmt.println(strings.trim("xxhixx", "x"));
	fmt.println(strings.trim_space("   ").len());

	switch (strings.cut("key=value", "=")) {
	case .some(halves):
		fmt.println(halves.before);
		fmt.println(halves.after);
		fmt.println(true);
	case .none: fmt.println(false);
	}
	switch (strings.cut("key", "=")) {
	case .some(halves):
		fmt.println(halves.before);
		fmt.println(halves.after.len());
		fmt.println(true);
	case .none:
		// No separator: the whole text is what a caller keeps.
		fmt.println("key");
		fmt.println(0);
		fmt.println(false);
	}

	// Iterators.
	foreach (part in strings.split("a,b,,c", ",")) {
		fmt.println(part.len());
	}
	foreach (field in strings.fields("  one\ttwo   three ")) {
		fmt.println(field);
	}
	foreach (line in strings.lines("first\r\nsecond\nthird")) {
		fmt.println(line);
	}
	count := 0;
	foreach (line in strings.lines("trailing\n")) {
		count += 1;
	}
	fmt.println(count);

	// Allocating transformations.
	parts := [?]string_view{"a", "b", "c"};
	fmt.println(strings.join(parts[:], "-"));
	fmt.println(strings.join(parts[:]));
	fmt.println(strings.repeat("ab", 3));
	fmt.println(strings.repeat("ab", 0).len());
	fmt.println(strings.replace("a.b.c", ".", "/"));
	fmt.println(strings.replace("a.b.c", ".", "/", 1));
	fmt.println(strings.to_upper("hej å"));
	fmt.println(strings.to_lower("HEJ Å"));
	fmt.println(strings.copy(text));

	// The edges of the byte-level fast paths.
	fmt.println(strings.repeat("abc", 7));
	fmt.println(strings.repeat("x", 5) == "xxxxx");
	fmt.println(strings.repeat("", 1 << 40).len());
	fmt.println(strings.to_upper("@AZ[`az{ éß") == "@AZ[`AZ{ éß");
	fmt.println(strings.to_lower("@AZ[`az{ É") == "@az[`az{ É");
	fmt.println(strings.trim_right_space("ä 　 ") == "ä");
	fmt.println(strings.trim_right_space("  ").len());
	fmt.println(strings.trim_space(" ok\t") == "ok");
	fmt.println(strings.trim("abc", "") == "abc");
	fmt.println(strings.index("aäb", "b") or_else -1);
	fmt.println(strings.index("ab", "abc") or_else -1);
	fmt.println(strings.last_index("ab", "abc") or_else -1);
	fmt.println(strings.index_rune("äöx", 'x') or_else -1);
	fmt.println(strings.index_rune("abc", 'z') or_else -1);
	fmt.println(strings.index_rune("abc", -1) or_else -1);
	fmt.println(strings.contains("abc", "bc"));
	lines_seen := 0;
	foreach (line in strings.lines("a\n\nb\r")) {
		lines_seen += 1;
		fmt.println(line.len());
	}
	fmt.println(lines_seen);
	foreach (part in strings.split("ab", "")) { fmt.println(part); }
	foreach (part in strings.split("a,", ",")) { fmt.println(part.len()); }
	widths: strings.String_Builder = {};
	widths.append('A');
	widths.append('ä');
	widths.append('✓');
	widths.append('😀');
	fmt.println(widths.copy_string() == "Aä✓😀");

	// The builder. Its zero value is usable and allocator-unbound.
	builder: strings.String_Builder = {};
	builder.append("hello");
	builder.append(' ');
	builder.append("värld");
	builder.append_byte_ascii(u8('!'));
	fmt.println(builder.len());
	message := builder.finish();
	fmt.println(message);
	fmt.println(builder.len());

	// And it is reusable: the allocation survives `finish`.
	builder.append("again");
	fmt.println(builder.finish());

	// An explicit allocator reaches both the buffer and the finished string.
	arena := mem.Arena.init();
	scoped := strings.init(arena.allocator());
	scoped.append("in the arena");
	fmt.println(scoped.copy_string(mem.default_allocator()));

	// The fallible surface reports instead of panicking.
	fallible: strings.String_Builder = {};
	if (!succeeded(fallible.try_reserve(16))) { fmt.println("reserve failed"); }
	if (!succeeded(fallible.try_append("ok"))) { fmt.println("append failed"); }
	if (!succeeded(fallible.try_append('!'))) { fmt.println("append failed"); }
	if (!succeeded(fallible.try_append_byte_ascii(u8('?')))) { fmt.println("append failed"); }
	switch (fallible.try_finish()) {
	case .ok(done):
		fmt.println(done);
		fmt.println(true);
	case .err:
		fmt.println("");
		fmt.println(false);
	}
	fmt.println(fallible.len());

	// More than the largest `int` in total is an allocation failure to report,
	// not a count wrapped negative and a panic.
	fallible.append("x");
	fmt.println(succeeded(fallible.try_reserve(0x7FFFFFFFFFFFFFFF)), fallible.len());
}
