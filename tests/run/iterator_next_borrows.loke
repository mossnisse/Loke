package main;

import "core:container";
import "core:fmt";

// design.md "Iteration protocol": `next` hands back `Item`, which is a pointer
// wherever the traversal lends, so code generic over the yield mode cannot print
// the element. Advancing the cursor is the whole of what this asks for.
advance :: proc(it: inout $I) { _ = it.next(); }

main :: proc() {
	xs: container.Small_Array(int, 4) = {};
	xs.append(10, 20);
	it := xs.iter();
	// Mutating the cursor repeatedly is legal while it borrows the source, and
	// what it lends names the element in place.
	first := it.next() or_else nil;
	fmt.println(first^);
	advance(inout it);
	fmt.println(it.next() == nil);
	// An owned result does not extend the source's loan past the final call.
	back := xs.reversed().copied().iter();
	last := back.next();
	xs.append(30);
	fmt.println(last, xs.len());
	drop(xs);

	y := [dynamic]int{1, 2};
	Dynamic :: [dynamic]int;
	holder: (it: Dynamic.Iterator) = {it = y.iter()};
	// A dynamic array lends, so what comes back names the element in place.
	held := holder.it.next() or_else nil;
	fmt.println(held^);
	advance(inout holder.it);
	y.append(3);
	fmt.println(y.len());
}
