package main; import "core:fmt";

// m5b-plan step 4: what erased views and user slicing *permit*. M4b's
// representations and witness dispatch are unchanged; provenance only adds the
// lifetime rules around them.

Shape :: interface($Self: type) {
	slot area: proc(self) -> int;
}

Square :: struct { side: int }

impl Square {
	area :: proc(self: Square) -> int { return self.side * self.side; }
}

Ok_Table :: struct { rows: []mut int }

impl Ok_Table {
	// An exclusive receiver may yield an exclusive slice.
	span :: operator([:]) proc(self: inout Ok_Table, lo: int, hi: int) -> []mut int {
		return self.rows[lo:hi];
	}
}

Bag :: struct { items: []int }

impl Bag {
	// design.md: the receiver's own storage is callee-local, but a view field of
	// it already borrows the caller's root, so this result may be returned.
	head :: proc(self, count: int) -> []int { return self.items[0:count]; }
}

// design.md: "Copying a borrow carrier copies the view and its root provenance",
// so an `any_view` may be copied, extracted and switched on freely while its
// subject is untouched.
erased_copies :: proc() {
	value := 7;
	view: any_view = value;
	alias := view;
	fmt.println(view.(int));
	fmt.println(alias.(int));
	switch (v in alias) {
	case int:  fmt.println(v);
	case:      fmt.println(0);
	}
	// Every view is finished, so the subject is writable again.
	value = 8;
	fmt.println(value);
}

// A `dyn` view keeps the pointer's provenance, and nil behaviour is unchanged.
dyn_views :: proc() {
	square := Square{3};
	view := (dyn Shape)(&square);
	fmt.println(view.area());
	// The dyn view has ended, so the subject may be written again.
	square.side = 4;
	fmt.println(square.side);

	absent: dyn Shape = nil;
	fmt.println(1 if absent == nil else 0);
}

user_slicing :: proc() {
	numbers := [4]int{1, 2, 3, 4};
	t := Ok_Table{numbers[0:4]};
	part := t[0:2];
	part[0] = 9;
	fmt.println(part[0] + part[1]);
}

borrowed_field_slice :: proc(values: []int) -> int {
	b := Bag{values};
	head := b.head(2);
	return head[0] + head[1];
}

main :: proc() {
	erased_copies();
	dyn_views();
	user_slicing();
	numbers := [3]int{5, 6, 7};
	fmt.println(borrowed_field_slice(numbers[:]));
}
