// design.md "Weakening and reborrows", "Places and overlap": elements of a
// view at different constant indices are different places wherever it is
// known where the view starts, so a borrow, payload binding, or traversal of
// one leaves another usable: in a view parameter, in a local view borrowed
// from an array, in one resliced from such a view by a constant before a
// loop, in one a branch or a loop only shortens, and in one borrowed whole
// from a dynamic array. A carrier copied out of one element of a local view
// leaves the carrier in another free to copy.
package main;

import "core:fmt";

Counter :: struct { count: int, total: int, first: Option(^mut int), cells: [2]int }

Node :: struct { value: int }
List :: struct { head: ^mut Node }

bump :: proc(n: ^mut int) { n^ += 1; }

cond :: proc() -> bool { return true; }

param_borrow :: proc(xs: []mut Counter) {
	first := &mut xs[0];
	xs[1].count += 1;
	bump(&mut xs[1].total);
	first^.count += 10;
}

param_binding :: proc(xs: []mut Counter) {
	switch (xs[0].first) {
	case .some(n):
		xs[1].first = .none;
		n^ += 100;
	case .none:
	}
}

param_traversal :: proc(xs: []mut Counter) {
	foreach (&mut cell in xs[0].cells) {
		cell += xs[1].cells[0];
		xs[1].cells[1] += 1;
	}
}

local_two_borrows :: proc() -> int {
	counters := [3]Counter{};
	view := &mut counters[:];
	a := &mut view[0];
	b := &mut view[2];
	a^.count = 1;
	b^.count = 2;
	a^.count += b^.count;
	return counters[0].count * 10 + counters[2].count;
}

local_resliced :: proc() -> int {
	counters := [3]Counter{};
	view := &mut counters[:];
	view = &mut view[1:];
	for (i := 0; i < 2; i += 1) {
		a := &mut view[0];
		view[1].count += 1;
		a^.count += 3;
	}
	return counters[1].count * 10 + counters[2].count;
}

local_shortened :: proc() -> int {
	counters := [3]Counter{};
	view := &mut counters[:];
	if (cond()) { view = &mut view[:2]; }
	a := &mut view[0];
	view[1].count += 1;
	a^.count += 4;
	return counters[0].count * 10 + counters[1].count;
}

local_dynamic :: proc() -> int {
	counters := [dynamic]Counter{Counter{}, Counter{}};
	view := &mut counters[:];
	a := &mut view[0];
	view[1].count += 2;
	a^.count += 5;
	return counters[0].count * 10 + counters[1].count;
}

local_copies :: proc() -> int {
	a := Node{1};
	b := Node{2};
	lists := [2]List{List{&mut a}, List{&mut b}};
	view := &mut lists[:];
	node := view[0].head;
	other := view[1].head;
	other^.value = 3;
	node^.value += 6;
	return a.value * 10 + b.value;
}

shortened_in_loop :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[:2]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 2;
	return a[0].count * 10 + a[1].count;
}

whole_in_loop :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[0:]; }
	first := &mut s[0];
	s[2].count += 1;
	first^.count += 2;
	return a[0].count * 10 + a[2].count;
}

// Each round borrows through what the round before left, from the same start.
shortened_each_round :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) {
		first := &mut s[0];
		s[1].count += 1;
		first^.count += 2;
		s = &mut s[:2];
	}
	return a[0].count * 10 + a[1].count;
}

// The borrow outlives the round that took it, and the start never moves.
kept_across_rounds :: proc() -> int {
	a := [3]Counter{};
	other := Counter{};
	s := &mut a[:];
	first := &mut other;
	for (i := 0; i < 2; i += 1) {
		first^.count += 2;
		first = &mut s[0];
		s[1].count += 1;
		s = &mut s[:2];
	}
	first^.count += 2;
	return a[0].count * 10 + a[1].count;
}

shortened_in_branch_in_loop :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 3; i += 1) {
		if (i == 1) { s = &mut s[:2]; } else { s = &mut s[0:]; }
	}
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 2;
	return a[0].count * 10 + a[1].count;
}

shortened_in_nested_loops :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) {
		s = &mut s[0:];
		for (j := 0; j < 2; j += 1) { s = &mut s[:2]; }
	}
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 2;
	return a[0].count * 10 + a[1].count;
}

shortened_through_another_view :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) {
		t := &mut s[:2];
		s = &mut t[:];
	}
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 2;
	return a[0].count * 10 + a[1].count;
}

// The start the loop keeps is the one its view came in with.
shortened_from_a_start :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	s = &mut s[1:];
	for (i := 0; i < 2; i += 1) { s = &mut s[:2]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 2;
	return a[1].count * 10 + a[2].count;
}

shortened_dynamic_in_loop :: proc() -> int {
	d := [dynamic]Counter{Counter{}, Counter{}, Counter{}};
	s := &mut d[:];
	for (i := 0; i < 2; i += 1) { s = &mut s[:2]; }
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 2;
	return d[0].count * 10 + d[1].count;
}

// Two borrows, each from its own start: whichever `s` holds, its elements
// differ, and nothing repoints it between the two uses.
shortened_of_two_borrows :: proc() -> int {
	a := [3]Counter{};
	s := &mut a[:];
	for (i := 0; i < 2; i += 1) {
		if (i == 1) { s = &mut a[1:]; }
		s = &mut s[:2];
	}
	first := &mut s[0];
	s[1].count += 1;
	first^.count += 2;
	return a[1].count * 10 + a[2].count;
}

// Mutually dependent views, one starting short. The other's length arrives only
// around the loop, and every reslice starts at zero.
Pointing :: struct { p: ^mut int }

shortened_views_of_each_other :: proc(flag: bool) -> int {
	a, b, c := 1, 2, 3;
	held := [3]Pointing{{&mut a}, {&mut b}, {&mut c}};
	base := held[:];
	s := base[:1];
	t := base[:];
	for (i := 0; i < 2; i += 1) {
		if (flag) { s = t[:]; }
		t = s[:2];
	}
	first := s[0].p;
	s[1].p^ += 1;
	first^ += 1;
	return a * 100 + b * 10 + c;
}

shortened_views_through_a_third :: proc(flag: bool) -> int {
	a, b, c := 1, 2, 3;
	held := [3]Pointing{{&mut a}, {&mut b}, {&mut c}};
	base := held[:];
	r := base[:1];
	s := base[:];
	t := base[:];
	for (i := 0; i < 2; i += 1) {
		if (flag) { r = t[:]; }
		s = r[:2];
		t = s[:];
	}
	first := r[0].p;
	r[1].p^ += 1;
	first^ += 1;
	return a * 100 + b * 10 + c;
}

main :: proc() {
	n := 1;
	counters := [2]Counter{Counter{first = .some(&mut n)}, Counter{cells = [2]int{5, 6}}};
	param_borrow(&mut counters[:]);
	param_binding(&mut counters[:]);
	param_traversal(&mut counters[:]);
	fmt.println(counters[0].count, counters[1].count, counters[1].total, n);
	fmt.println(counters[0].cells[0], counters[0].cells[1], counters[1].cells[1]);
	fmt.println(local_two_borrows(), local_resliced());
	fmt.println(local_shortened(), local_dynamic(), local_copies());
	fmt.println(shortened_in_loop(), whole_in_loop(), shortened_each_round(), kept_across_rounds());
	fmt.println(shortened_in_branch_in_loop(), shortened_in_nested_loops(), shortened_through_another_view());
	fmt.println(shortened_from_a_start(), shortened_dynamic_in_loop(), shortened_of_two_borrows());
	fmt.println(shortened_views_of_each_other(true), shortened_views_through_a_third(true));
}
