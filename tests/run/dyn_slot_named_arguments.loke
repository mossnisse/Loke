package main; import "core:fmt";

// A `dyn` slot call binds named arguments by the slot's parameter names,
// whether the view is a named local, converted in place, a field, a result, or
// a generic receiver, and so does the view type's member called by type name.

Shape :: interface($Self: type) {
	slot area: proc(self, scale: int, offset: int) -> int;
	slot grow: proc(self: inout Self, by: int);
}

Square :: struct { side: int }
impl Square {
	area :: proc(self, scale: int, offset: int) -> int { return self.side * scale + offset; }
	grow :: proc(self: inout Square, by: int) { self.side += by; }
}

Holder :: struct { view: dyn Shape }

view_of :: proc(s: ^Square) -> dyn Shape { return (dyn Shape)(s); }

scaled :: proc(x: ^$T) -> int where Shape(T) { return x^.area(offset = 0, scale = 5); }

main :: proc() {
	s := Square{3};
	view := (dyn Shape)(&s);
	fmt.println(view.area(scale = 2, offset = 1));
	fmt.println((dyn Shape)(&s).area(scale = 2, offset = 1));
	fmt.println((dyn Shape)(&s).area(offset = 1, scale = 2));
	fmt.println((dyn Shape)(&s).area(2, offset = 1));
	holder := Holder{view};
	fmt.println(holder.view.area(offset = 4, scale = 1));
	fmt.println(view_of(&s).area(scale = 3, offset = 0));
	fmt.println((dyn Shape).area(view, scale = 1, offset = 1));
	mutable := (dyn mut Shape)(&mut s);
	fmt.println(scaled(&mutable));
	(dyn mut Shape)(&mut s).grow(by = 2);
	fmt.println(s.side);
}
