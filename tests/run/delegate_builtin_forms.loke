package main;

import "core:fmt";
import "core:simd";

// design.md "Delegating operators": `delegate` generates the underlying type's
// built-in operators, whichever they are, at run time and during compilation. A
// result of another type passes through.

Text :: distinct string;

impl Text {
	delegate(+, ==, <);
}

View :: distinct string_view;

impl View {
	delegate(+, ==);
}

Bits :: distinct u32;

impl Bits {
	delegate(<<, >>);
}

Float4 :: Simd(f32, 4);
Int4 :: Simd(i32, 4);

Wide :: distinct Float4;

impl Wide {
	delegate(+, -, *, ==, !=, <);
}

Lanes :: distinct Int4;

impl Lanes {
	delegate(~, <<, &);
}

doubled :: proc(text: string) -> string { return text + text; }

folded_text :: proc() -> string {
	text := Text("con");
	text += Text("cat");
	return string(text + "!");
}

folded_lane :: proc() -> f32 {
	wide := Wide(Float4{1, 2, 3, 4});
	return Float4(-wide + wide * wide)[2];
}

folded_bits :: proc() -> u32 {
	bits := Bits(1) << Bits(4);
	bits >>= Bits(1);
	return u32(bits);
}

FOLDED_TEXT :: folded_text();
static_assert(FOLDED_TEXT == "concat!");
FOLDED_LANE :: folded_lane();
FOLDED_BITS :: folded_bits();

main :: proc() {
	text := Text("x") + Text("y");
	fmt.println(string(text));
	text += Text("z");
	fmt.println(string(text));
	temporaries := Text(doubled("a")) + Text(doubled("b"));
	fmt.println(string(temporaries), Text(doubled("a")) == Text(doubled("a")), Text(doubled("a")) < Text(doubled("b")));

	owned: string = View("left") + View("right");
	fmt.println(owned, View("p") == View("p"), FOLDED_TEXT);

	bits := Bits(1) << Bits(3);
	fmt.println(u32(bits), u32(bits >> Bits(1)), FOLDED_BITS);

	wide := Wide(Float4{1, 2, 3, 4});
	sum := wide + wide;
	negated := -sum;
	negated += wide;
	fmt.println(Float4(sum)[1], Float4(negated)[1], Float4(wide * 2.0)[3], FOLDED_LANE);
	fmt.println(simd.all(wide == wide), simd.all(wide != sum), simd.all(wide < sum));

	lanes := Lanes(Int4{1, 2, 3, 4});
	fmt.println(Int4(~lanes)[0], Int4(lanes << Lanes(Int4{1, 1, 1, 1}))[3], Int4(lanes & lanes)[2]);
}
