package main;
import "core:fmt";
import "core:mem";

// design.md "Owned values": a box carries its payload's borrows and is backed
// by its allocator's region, through helpers, nesting, and deep providers.
forward :: proc(allocator: Allocator) -> Allocator { return allocator; }
box_parameter :: proc(value: ^int) -> box(^int) { return box(value); }
box_slice :: proc(values: []int) -> box([]int) { return box(values); }
View :: struct { values: []int }
box_view :: proc(values: []int) -> box(View) { return box(View{values}); }
box_nested :: proc(value: ^int) -> box(box(^int)) {
	return box(box(value));
}
Pair :: struct { left: ^int, right: ^int }
box_pair :: proc(value: Pair) -> box(Pair) { return box(value); }

handles :: proc() {
	owner := mem.Arena.init();
	handle := forward(owner.allocator());
	moved := move(owner);
	free_all(handle);
	{
		p := box(42, handle);
		fmt.println(p^);
	}
	free_all(handle);
	{
		p := box(0, handle);
		p^ = 7;
		fmt.println(p^);
	}
	drop(moved);
}

clones :: proc() {
	value := 42;
	p := box(&value);
	fmt.println(p^^);
	p = box_parameter(&value);
	fmt.println(p^^);
	values := [2]int{3, 7};
	view: []int = values[:];
	s := box_slice(view);
	fmt.println(s^[1]);
	r := box_view(view);
	fmt.println(r.values[0]);
	fallible := try_box(&value) or_else box(&value);
	fmt.println(fallible^^);
	inner := box(&value);
	outer := box(move(inner));
	fmt.println(outer^^^);
	outer = box_nested(&value);
	fmt.println(outer^^^);
}

separate_fields :: proc() {
	value := 7;
	right: Option(box(^int)) = .none;
	{
		short := 3;
		p := box_pair(Pair{&short, &value});
		fmt.println(p.left^);
		right = .some(box(p.right));
	}
	switch (right) { case .some(kept): fmt.println(kept^^); case .none: }
}

L0 :: struct { inner: mem.Arena }
L1 :: struct { inner: L0 }
L2 :: struct { inner: L1 }
L3 :: struct { inner: L2 }
L4 :: struct { inner: L3 }
L5 :: struct { inner: L4 }
L6 :: struct { inner: L5 }
L7 :: struct { inner: L6 }
L8 :: struct { inner: L7 }

deep :: proc() {
	owner := L8{L7{L6{L5{L4{L3{L2{L1{L0{mem.Arena.init()}}}}}}}}};
	handle := owner.inner.inner.inner.inner.inner.inner.inner.inner.inner.allocator();
	{
		p := box(11, handle);
		fmt.println(p^);
	}
	drop(owner);
}

// Recursive container types terminate the provider reachability walk.
Node :: struct { children: [dynamic]Node, arena: mem.Arena }
recursive :: proc() {
	node := Node{{}, mem.Arena.init()};
	handle := node.arena.allocator();
	{
		p := box(9, handle);
		fmt.println(p^);
	}
	drop(node);
}

main :: proc() {
	handles();
	clones();
	separate_fields();
	deep();
	recursive();
}
