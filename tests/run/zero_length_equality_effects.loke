package main;

import "core:fmt";

// design.md "Global write effects": a structural `==` or generated `hash` of a `[0]T`
// has no element to compare or hash, so it calls neither of `T`'s and writes nothing
// they write, however the array is held. Each would clear `values` under `borrowed`.
// tests/err/zero_length_equality_effects.loke holds what still counts. What comparing
// one requires of `T` is unchanged, and is in tests/pkg_err/zero_length_equality.

values: [dynamic]int = {};

Clears :: struct { id: int }
impl Clears {
	equal :: operator(==) proc(a, b: Clears) -> bool { values = {}; return true; }
	hash :: proc(self, seed: uint) -> uint { values = {}; return seed; }
}

Holds :: struct { none: [0]Clears, tag: int }
Either :: union { none: [0]Clears, tag: int }
Plain :: distinct [0]Clears;

main :: proc() {
	values.append(7);
	borrowed := values[:];

	a: [0]Clears = {};
	b: [0]Clears = {};
	fmt.println(a == b, a != b);

	outer: [0][2]Clears = {};
	inner: [2][0]Clears = {};
	fmt.println(outer == outer, inner == inner);

	fmt.println(Holds{{}, 1} == Holds{{}, 1}, Holds{{}, 1} == Holds{{}, 2});
	fmt.println(Either.tag(1) == Either.tag(1));
	plain: Plain = {};
	fmt.println(plain == plain);

	fmt.println(a.hash(1) == a.hash(1));
	table: map[[0]Clears]int = {};
	table[a] = 3;
	fmt.println(a in table, table[a]);

	fmt.println(borrowed[0]);
}
