package main; import "core:fmt";

DEBUG :: build_config(DEBUG, false);

when (DEBUG) {
	LEVEL :: 2;
	Row :: struct { a: i64 };
	extra :: proc() -> int { return 100; }
} else {
	LEVEL :: 1;
	Row :: struct { a: i32 };
	extra :: proc() -> int { return 200; }
}

// The same dependency, reached through type syntax rather than named directly.
// `Row` is only declared once the branch above is selected, so this condition is
// pending until then — exactly as `size_of(Row)` would be.
when (size_of([2]Row) == 8) {
	WIDTH :: 44;
} else {
	WIDTH :: 55;
}

// A condition that needs a declaration the selected branch above supplied.
when (LEVEL > 1) {
	NAME :: 11;
} else when (LEVEL == 1) {
	NAME :: 22;
} else {
	NAME :: 33;
	this_is_never_checked: [no_such_type]qqq;
}

main :: proc() {
	fmt.println(LEVEL);
	fmt.println(NAME);
	fmt.println(WIDTH);
	fmt.println(extra());

	// Procedure-scope `when`: no new scope, and it contributes flow and defer.
	total := 0;
	when (DEBUG) {
		total += 1;
		defer fmt.println(900);
	} else {
		total += 2;
		defer fmt.println(901);
	}
	fmt.println(total);
	fmt.println(describe());
}

describe :: proc() -> int {
	when (DEBUG) {
		return 1;
	} else {
		return 2;
	}
}
