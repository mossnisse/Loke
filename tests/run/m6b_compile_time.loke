package main; import "core:fmt";

// Managed containers as compile-time temporaries (m6b-plan step 6).
//
// A compile-time container is its live contents and nothing else: there is no
// allocation to model, no provider to bind, and no address to hand out. So the
// evaluator runs the same operations the backend emits, from the same
// `container_op`, and every one of them is deterministic.
//
// What a container may *not* do is escape: design.md gives it exactly one
// constant value, the empty one, because anything else would need an allocation
// no constant can own. These constants are all scalars computed *from*
// containers.

SUM :: sum_built();
sum_built :: proc() -> int {
	xs: [dynamic]int;
	xs.append(1, 2, 3);
	xs.insert(0, 10);
	xs.resize(6);
	xs[5] = 7;
	total := 0;
	for (i := 0; i < len(xs); i += 1) {
		total += xs[i];
	}
	return total;
}

// Optional-ok, verbatim: an empty container yields the zero value and false.
POPPED :: popped();
popped :: proc() -> int {
	xs: [dynamic]int = {4, 5, 6};
	value, ok := xs.pop();
	if (!ok) { return -1; }
	empty: [dynamic]int;
	zero, empty_ok := empty.pop();
	if (empty_ok || zero != 0) { return -2; }
	return value * 100 + len(xs);
}

REMOVED :: removed();
removed :: proc() -> int {
	xs: [dynamic]int = {9, 8, 7};
	taken := xs.remove(1);
	xs.remove_unordered(0);
	return taken * 100 + xs[0] * 10 + len(xs);
}

// A map: insertion, replacement, a non-inserting read of a missing key, `in`,
// `find`, and removal.
MAPPED :: mapped();
mapped :: proc() -> int {
	m: map[string]int;
	m["a"] = 1;
	m["b"] = 2;
	m["a"] = 5;
	missing := m["zz"];
	present := 0;
	if ("b" in m) { present = 1; }
	absent := 0;
	if (!("zz" in m)) { absent = 1; }
	return m["a"] * 10000 + m["b"] * 1000 + missing * 100 + present * 10 + absent + len(m);
}

FOUND :: found();
found :: proc() -> int {
	m := map[int]int{1 = 10, 2 = 20, 1 = 30};
	slot, ok := m.find(2);
	if (!ok) { return -1; }
	slot^ = 99;
	_, gone := m.find(7);
	if (gone) { return -2; }
	taken, removed_ok := m.remove(1);
	if (!removed_ok) { return -3; }
	return taken * 1000 + m[2] * 10 + len(m);
}

// `drop` writes the inert zero representation; a later full assignment revives.
REVIVED :: revived();
revived :: proc() -> int {
	xs: [dynamic]int = {1, 2, 3};
	before := len(xs);
	drop(xs);
	xs = {7, 7};
	return before * 10 + len(xs);
}

// Value semantics: a copy does not alias its source. The copy-cost warning is
// the same one this binding earns at run time — compile-time evaluation does not
// exempt a program from the diagnostics its source has.
COPIED :: copied();
copied :: proc() -> int {
	xs: [dynamic]int = {1, 2};
	ys := xs;
	ys.append(3);
	return len(xs) * 10 + len(ys);
}

main :: proc() {
	fmt.println(SUM);
	fmt.println(POPPED);
	fmt.println(REMOVED);
	fmt.println(MAPPED);
	fmt.println(FOUND);
	fmt.println(REVIVED);
	fmt.println(COPIED);
}
