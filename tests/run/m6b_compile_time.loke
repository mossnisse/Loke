package main; import "core:fmt";

// Managed containers as compile-time temporaries (m6b-plan step 6).
//
// A compile-time container is its live contents and nothing else: there is no
// allocation to model, no provider to bind, and no address to hand out. So the
// evaluator runs the same operations the backend emits, from the same
// `container_op`, and every one of them is deterministic.
//
// What a container may *not* do is escape: design.md gives it exactly one
// constant value, the empty one, because anything else would need an allocation
// no constant can own. These constants are all scalars computed *from*
// containers.

SUM :: sum_built();
sum_built :: proc() -> int {
	xs: [dynamic]int;
	xs.append(1, 2, 3);
	xs.insert(0, 10);
	xs.resize(6);
	xs[5] = 7;
	total := 0;
	for (i := 0; i < xs.len(); i += 1) {
		total += xs[i];
	}
	return total;
}

// The `Option` protocol, verbatim: an empty container has nothing to pop.
POPPED :: popped();
popped :: proc() -> int {
	xs: [dynamic]int = {4, 5, 6};
	value := 0;
	switch (popped in xs.pop()) {
	case .some: value = popped;
	case .none: return -1;
	}
	empty: [dynamic]int;
	switch (_ in empty.pop()) {
	case .some: return -2;
	case .none:
	}
	return value * 100 + xs.len();
}

REMOVED :: removed();
removed :: proc() -> int {
	xs: [dynamic]int = {9, 8, 7};
	taken := xs.remove(1);
	xs.remove_unordered(0);
	return taken * 100 + xs[0] * 10 + xs.len();
}

// A map: insertion, replacement, a non-inserting read of a missing key, `in`,
// `find`, and removal.
MAPPED :: mapped();
mapped :: proc() -> int {
	m: map[string]int;
	m["a"] = 1;
	m["b"] = 2;
	m["a"] = 5;
	missing := m["zz"];
	present := 0;
	if ("b" in m) { present = 1; }
	absent := 0;
	if (!("zz" in m)) { absent = 1; }
	return m["a"] * 10000 + m["b"] * 1000 + missing * 100 + present * 10 + absent + m.len();
}

// The copying read agrees with its runtime lowering: one probe, no insertion,
// and an independently owned payload on a hit.
LOOKED_UP :: looked_up();
looked_up :: proc() -> int {
	m: map[string][dynamic]int;
	m["a"] = {4};
	held := m.lookup_value("a") or_else {};
	if (held.len() != 1) { return -1; }
	held.append(5);
	switch (_ in m.lookup_value("zz")) {
	case .some: return -2;
	case .none:
	}
	// The clone is independent, and the read inserted nothing.
	return held.len() * 100 + m["a"].len() * 10 + m.len();
}

FOUND :: found();
found :: proc() -> int {
	m := map[int]int{1 = 10, 2 = 20, 1 = 30};
	switch (slot in m.find(2)) {
	case .some: slot^ = 99;
	case .none: return -1;
	}
	switch (_ in m.find(7)) {
	case .some: return -2;
	case .none:
	}
	taken := 0;
	switch (removed in m.remove(1)) {
	case .some: taken = removed;
	case .none: return -3;
	}
	return taken * 1000 + m[2] * 10 + m.len();
}

// `drop` writes the inert zero representation; a later full assignment revives.
REVIVED :: revived();
revived :: proc() -> int {
	xs: [dynamic]int = {1, 2, 3};
	before := xs.len();
	drop(xs);
	xs = {7, 7};
	return before * 10 + xs.len();
}

// Value semantics: a copy does not alias its source. The copy-cost warning is
// the same one this binding earns at run time — compile-time evaluation does not
// exempt a program from the diagnostics its source has.
COPIED :: copied();
copied :: proc() -> int {
	xs: [dynamic]int = {1, 2};
	ys := xs;
	ys.append(3);
	return xs.len() * 10 + ys.len();
}

Eval_Failure :: union @(failure=err) { ok: int, err: int }
eval_source :: proc(fail: bool) -> Eval_Failure {
	if (fail) { return .err(7); }
	return .ok(4);
}
eval_propagate :: proc(fail: bool) -> Eval_Failure {
	value := eval_source(fail) or_return;
	return .ok(value + 1);
}
EVAL_OR_RETURN_OK :: eval_propagate(false) or_else -1;
EVAL_OR_RETURN_ERR :: eval_propagate(true) or_else -1;

main :: proc() {
	static_assert(TEMP_LOOKUP == 73);
	assert(temporary_lookup() == TEMP_LOOKUP);
	static_assert(CUSTOM_KEYS == 7);
	assert(custom_keys() == CUSTOM_KEYS);
	fmt.println(SUM);
	fmt.println(POPPED);
	fmt.println(REMOVED);
	fmt.println(MAPPED);
	fmt.println(LOOKED_UP);
	fmt.println(looked_up());
	fmt.println(FOUND);
	fmt.println(REVIVED);
	fmt.println(COPIED);
	fmt.println(EVAL_OR_RETURN_OK, EVAL_OR_RETURN_ERR);
}

// Equality deliberately ignores the annotation: structural comparison gives
// different answers for lookup, duplicate literals, replacement and removal.
Annotated_Key :: struct { id, annotation: int }
impl Annotated_Key {
	hash :: proc(self, seed: uint) -> uint { return self.id.hash(seed); }
	equal :: operator(==) proc(a, b: Annotated_Key) -> bool { return equal_ids(a.id, b.id); }
}

CUSTOM_KEYS :: custom_keys();
custom_keys :: proc() -> int {
	m := map[Annotated_Key]int{Annotated_Key{1, 10} = 3, Annotated_Key{1, 20} = 7};
	if (m.len() != 1 || m[Annotated_Key{1, 30}] != 7) { return -1; }
	if (!(Annotated_Key{1, 40} in m)) { return -2; }
	m[Annotated_Key{1, 50}] = 8;
	{
		switch (p in m.find(Annotated_Key{1, 60})) {
		case .some: if (p^ != 8) { return -3; }
		case .none: return -3;
		}
	}
	switch (_ in m.try_insert(Annotated_Key{1, 70}, 7)) {
	case .ok:  if (m.len() != 1) { return -4; }
	case .err: return -4;
	}
	value := 0;
	switch (removed in m.remove(Annotated_Key{1, 80})) {
	case .some: value = removed;
	case .none: return -5;
	}
	if (m.len() != 0) { return -5; }
	return value;
}
equal_ids :: proc(a, b: int) -> bool { return a == b; }

temporary_map :: proc() -> map[[2]int]int {
	m: map[[2]int]int;
	m[{1, 2}] = 73;
	return m;
}
TEMP_LOOKUP :: temporary_lookup();
temporary_lookup :: proc() -> int {
	return temporary_map().lookup_value(key = {1, 2}) or_else -1;
}
