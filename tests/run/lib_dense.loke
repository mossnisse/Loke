// standard-library "`core:math/dense`": storage, views, products, and the
// element-wise operations. Views of an owner and of foreign buffers in both
// orders, blocks and transposes against copies, splits in both directions
// through a temporary and a named view, products against `linalg.Matrix` bit
// for bit, exact integer results, the norms at the edges of the range, and
// formatting.
package main;

import "core:fmt";
import "core:math";
import "core:math/dense";
import "core:math/linalg";

check :: proc(name: string_view, ok: bool) {
	if (ok) {
		fmt.println("ok", name);
	} else {
		fmt.println("FAIL", name);
	}
}

// Deterministic elements that are not all small integers, so that a product
// rounds.
sample :: proc($T: type, rows, columns, seed: int) -> dense.Matrix(T) {
	m := dense.Matrix(T).zeros(rows, columns);
	foreach (c in 0 ..< columns) {
		foreach (r in 0 ..< rows) {
			m[r, c] = T(f64((r*7 + c*13 + seed*5) % 23) - 11.0)/T(7.0);
		}
	}
	return m;
}

// A copy of a view, element by element through the checked subscript.
copied :: proc(v: dense.View($T)) -> dense.Matrix(T) {
	result := dense.Matrix(T).zeros(v.rows(), v.columns());
	foreach (c in 0 ..< v.columns()) {
		foreach (r in 0 ..< v.rows()) { result[r, c] = v[r, c]; }
	}
	return result;
}

construction :: proc() {
	z := dense.Matrix(f64).zeros(2, 3);
	check("zeros has its shape", z.rows() == 2 && z.columns() == 3 && z[1, 2] == 0.0);
	i := dense.Matrix(int).identity(3);
	check("identity", i[0, 0] == 1 && i[1, 1] == 1 && i[2, 2] == 1 && i[0, 1] == 0 && i[2, 0] == 0);
	f := dense.Matrix(int).filled(2, 2, 7);
	check("filled", f[0, 0] == 7 && f[1, 1] == 7);
	r := dense.Matrix(int).from_rows([2][3]int{{1, 2, 3}, {4, 5, 6}});
	check("from_rows reads as it prints", r[0, 2] == 3 && r[1, 0] == 4 && r.rows() == 2 && r.columns() == 3);
	data := [?]int{1, 4, 2, 5, 3, 6};
	c := dense.Matrix(int).from_column_major(data[:], 2, 3);
	check("from_column_major is the storage order", dense.equal(c.view(), r.view()));
	empty := dense.Matrix(f64).zeros(0, 4);
	check("an empty matrix", empty.rows() == 0 && empty.columns() == 4 && dense.norm_frobenius(empty.view()) == 0.0);

	fixed := linalg.Matrix(f64, 2, 3).from_rows({{1, 2, 3}, {4, 5, 6}});
	from := dense.Matrix(f64).from_fixed(fixed);
	check("from_fixed copies", from[1, 2] == 6.0 && from[0, 1] == 2.0);
	check("to_fixed copies back", from.to_fixed(2, 3) == fixed && from.view().transpose().to_fixed(3, 2) == fixed.transpose());

	// A copy is a clone: writing one leaves the other.
	original := dense.Matrix(int).identity(2);
	copy := original.clone();
	copy[0, 1] = 9;
	check("a clone is separate storage", original[0, 1] == 0 && copy[0, 1] == 9);
	fmt.println(r, dense.Matrix(f64).zeros(0, 0), dense.Matrix(f64).from_rows([1][2]f64{{0.5, -2}}));
	fmt.println(r.view().transpose());
}

views :: proc() {
	// The same 2 x 3 matrix three ways: owned, column-major foreign storage
	// with a leading dimension of 3, and row-major foreign storage with one
	// of 4.
	m := dense.Matrix(f64).from_rows([2][3]f64{{0, 1, 2}, {10, 11, 12}});
	column_major := [?]f64{0, 10, -1, 1, 11, -1, 2, 12};
	row_major := [?]f64{0, 1, 2, -1, 10, 11, 12};
	a := dense.View(f64).from_column_major(column_major[:], 2, 3, 3);
	b := dense.View(f64).from_row_major(row_major[:], 2, 3, 4);
	check("an owner, a column-major buffer, and a row-major buffer view alike",
		dense.equal(m.view(), a) && dense.equal(a, b));
	check("the default leading dimension is packed",
		dense.equal(dense.View(f64).from_row_major(row_major[4:], 1, 3), m.view().row(1)));

	t := b.transpose();
	check("transpose swaps the shape", t.rows() == 3 && t.columns() == 2 && t[2, 1] == 12.0 && t[0, 1] == 10.0);
	check("a block of a transpose is the transpose of a block",
		dense.equal(t.block(1, 0, 2, 2), copied(b.block(0, 1, 2, 2)).view().transpose()));
	check("a row and a column", dense.equal(a.row(1), copied(b).view().block(1, 0, 1, 3))
		&& dense.equal(a.column(2), b.transpose().row(2).transpose()));
	check("an empty block", a.block(2, 3, 0, 0).rows() == 0 && a.block(0, 1, 2, 0).columns() == 0);

	values := [?]f64{1, 2, 3};
	v := dense.View(f64).from_column(values[:]);
	check("from_column is a column vector", v.rows() == 3 && v.columns() == 1 && v[2, 0] == 3.0);
}

mutable_views :: proc() {
	m := dense.Matrix(int).zeros(3, 4);
	// Through a temporary, the split consumes it; through a named view, it
	// borrows the view.
	left, right := m.view_mut().split_columns(1);
	left.fill(1);
	right.fill(2);
	check("split_columns through a temporary", m[2, 0] == 1 && m[0, 1] == 2 && m[2, 3] == 2);

	whole := m.view_mut();
	first, rest := whole.split_columns(3);
	first[0, 0] = 5;
	rest[2, 0] = 6;
	edges_ok := true;
	{
		none, all := whole.split_columns(0);
		edges_ok = none.columns() == 0 && all.columns() == 4;
	}
	{
		all, none := whole.split_columns(4);
		edges_ok = edges_ok && all.columns() == 4 && none.columns() == 0;
	}
	check("split_columns at both ends", edges_ok);
	check("split_columns through a named view", m[0, 0] == 5 && m[2, 3] == 6);

	// A row-major buffer splits by rows, and a transposed column-major view
	// does too.
	buffer := [dynamic]int{0, 0, 0, 0, 0, 0};
	top, bottom := dense.View_Mut(int).from_row_major(&mut buffer[:], 3, 2).split_rows(1);
	top.fill(1);
	bottom.fill(3);
	check("split_rows of a row-major buffer", buffer[0] == 1 && buffer[1] == 1 && buffer[2] == 3 && buffer[5] == 3);
	n := dense.Matrix(int).zeros(2, 3);
	upper, lower := n.view_mut().transpose().split_rows(2);
	upper.fill(4);
	lower.fill(8);
	check("split_rows of a transpose", n[0, 0] == 4 && n[1, 1] == 4 && n[0, 2] == 8 && n[1, 2] == 8);

	// Sub-views through a temporary and through a named view.
	k := dense.Matrix(int).zeros(3, 3);
	block := k.view_mut().block(1, 1, 2, 2);
	block[1, 1] = 9;
	named := k.view_mut();
	diagonal_row := named.row(0);
	diagonal_row[0, 2] = 7;
	column := named.column(1);
	column[0, 0] = 3;
	transposed := named.transpose();
	transposed[0, 2] = 2;
	check("block, row, column, and transpose of a View_Mut", k[2, 2] == 9 && k[0, 2] == 7 && k[0, 1] == 3 && k[2, 0] == 2);

	// The in-place operations.
	x := dense.Matrix(f64).from_rows([2][2]f64{{1, 2}, {3, 4}});
	y := dense.Matrix(f64).from_rows([2][2]f64{{0.5, 0.25}, {-1, 2}});
	x.view_mut().add_scaled(2.0, y.view());
	check("add_scaled", dense.equal(x.view(), dense.Matrix(f64).from_rows([2][2]f64{{2, 2.5}, {1, 8}}).view()));
	x.view_mut().scale_by(0.5);
	check("scale_by", x[1, 1] == 4.0 && x[0, 1] == 1.25);
	x.view_mut().copy_from(y.view().transpose());
	check("copy_from a transpose", x[0, 1] == -1.0 && x[1, 0] == 0.25);
	as_view := x.view_mut();
	check("as_view reads the same elements", as_view.as_view()[1, 0] == 0.25);
}

products :: proc() {
	// Every shape up to 4 x 4 against linalg.Matrix, bit for bit, since the
	// order is the same.
	same := true;
	same = same && agrees_with_fixed(1, 1, 1) && agrees_with_fixed(2, 3, 4) && agrees_with_fixed(4, 4, 4);
	same = same && agrees_with_fixed(3, 1, 2) && agrees_with_fixed(1, 4, 3) && agrees_with_fixed(4, 2, 1);
	check("products equal linalg.Matrix bit for bit", same);

	// A product of transposed views: (b^T a^T)^T = a b, bit for bit.
	a := sample(f64, 37, 29, 1);
	b := sample(f64, 29, 41, 2);
	ab := dense.multiply(a.view(), b.view());
	ba := dense.multiply(b.view().transpose(), a.view().transpose());
	check("a product of transposed views", dense.equal(ab.view(), ba.view().transpose()));
	// The product through a block of a larger matrix, written into a block.
	big := sample(f64, 50, 50, 3);
	out := dense.Matrix(f64).zeros(60, 60);
	dense.multiply_into(out.view_mut().block(5, 7, 37, 41), a.view(), big.view().block(10, 4, 29, 41));
	reference := dense.multiply(a.view(), copied(big.view().block(10, 4, 29, 41)).view());
	check("a product into and out of blocks", dense.equal(out.view().block(5, 7, 37, 41), reference.view())
		&& out[4, 7] == 0.0 && out[42, 47] == 0.0);
	fmt.println(ab[0, 0], ab[36, 40], ab[18, 20]);

	// Integer products are exact.
	p := dense.Matrix(int).from_rows([2][3]int{{1, 2, 3}, {4, 5, 6}});
	q := dense.Matrix(int).from_rows([3][2]int{{7, 8}, {9, 10}, {11, 12}});
	check("an integer product", dense.equal(dense.multiply(p.view(), q.view()).view(),
		dense.Matrix(int).from_rows([2][2]int{{58, 64}, {139, 154}}).view()));

	// multiply_add_into adds each term into the running element.
	acc := dense.Matrix(int).filled(2, 2, 1);
	dense.multiply_add_into(acc.view_mut(), p.view(), q.view());
	check("multiply_add_into", acc[0, 0] == 59 && acc[1, 1] == 155);
	// An inner dimension of zero: the product is zero, and the update leaves out.
	wide := dense.Matrix(int).zeros(2, 0);
	tall := dense.Matrix(int).zeros(0, 3);
	zero := dense.Matrix(int).filled(2, 3, 5);
	dense.multiply_into(zero.view_mut(), wide.view(), tall.view());
	check("an empty inner dimension gives zeros", dense.equal(zero.view(), dense.Matrix(int).zeros(2, 3).view()));
	zero.view_mut().fill(5);
	dense.multiply_add_into(zero.view_mut(), wide.view(), tall.view());
	check("and leaves an update unchanged", zero[1, 2] == 5);

	// The update's order differs from adding the product.
	big_term := dense.Matrix(f64).from_rows([1][2]f64{{1, 1}});
	column := dense.Matrix(f64).from_rows([2][1]f64{{1e16}, {1}});
	running := dense.Matrix(f64).filled(1, 1, -1e16);
	dense.multiply_add_into(running.view_mut(), big_term.view(), column.view());
	check("multiply_add_into adds term by term", running[0, 0] == 1.0);
}

agrees_with_fixed :: proc($R: int, $K: int, $C: int) -> bool {
	a := sample(f64, R, K, R + K);
	b := sample(f64, K, C, K*C);
	product := dense.multiply(a.view(), b.view());
	return product.to_fixed(R, C) == a.to_fixed(R, K)*b.to_fixed(K, C);
}

elementwise :: proc() {
	a := dense.Matrix(int).from_rows([2][2]int{{1, 2}, {3, 4}});
	b := dense.Matrix(int).from_rows([2][2]int{{10, 20}, {30, 40}});
	check("add", dense.equal(dense.add(a.view(), b.view()).view(), dense.Matrix(int).from_rows([2][2]int{{11, 22}, {33, 44}}).view()));
	check("subtract", dense.subtract(b.view(), a.view())[1, 0] == 27);
	check("scale", dense.scale(a.view(), 3)[1, 1] == 12);
	check("transpose copies", dense.transpose(a.view())[0, 1] == 3);
	out := dense.Matrix(int).zeros(2, 2);
	dense.add_into(out.view_mut(), a.view(), b.view().transpose());
	check("add_into a transposed view", out[0, 1] == 32 && out[1, 0] == 23);
	dense.subtract_into(out.view_mut(), a.view(), a.view());
	check("subtract_into", dense.equal(out.view(), dense.Matrix(int).zeros(2, 2).view()));
	dense.scale_into(out.view_mut(), b.view(), -1);
	check("scale_into", out[1, 1] == -40);
	dense.transpose_into(out.view_mut(), b.view());
	check("transpose_into", out[0, 1] == 30);

	check("trace", dense.trace(a.view()) == 5 && dense.trace(dense.Matrix(int).zeros(0, 0).view()) == 0);
	column := [?]int{1, 2, 3};
	other := [?]int{4, -5, 6};
	check("dot of two columns", dense.dot(dense.View(int).from_column(column[:]), dense.View(int).from_column(other[:])) == 12);
	check("dot of two matrices", dense.dot(a.view(), b.view()) == 300);
	check("equal needs the same shape", !dense.equal(a.view(), a.view().block(0, 0, 2, 1)));

	x := dense.Matrix(f64).from_rows([1][3]f64{{1, 1e-9, 1e9}});
	y := dense.Matrix(f64).from_rows([1][3]f64{{1 + 1e-12, 2e-9, 1e9 + 1}});
	check("approx_equal with both tolerances", dense.approx_equal(x.view(), y.view(), 1e-8, 1e-9));
	check("approx_equal outside them", !dense.approx_equal(x.view(), y.view(), 1e-10, 1e-9));
	nan := dense.Matrix(f64).filled(1, 1, math.F64_NAN);
	check("a NaN is never approximately equal", !dense.approx_equal(nan.view(), nan.view(), 1.0, 1.0));
	check("approx_equal needs the same shape", !dense.approx_equal(x.view(), x.view().block(0, 0, 1, 2), 1.0, 1.0));
}

norms :: proc() {
	a := dense.Matrix(f64).from_rows([2][3]f64{{1, -2, 3}, {-4, 5, -6}});
	check("norm_one is the largest column sum", dense.norm_one(a.view()) == 9.0);
	check("norm_infinity is the largest row sum", dense.norm_infinity(a.view()) == 15.0);
	// The running scale costs a rounding or two against the direct sum.
	within := proc(x, y: f64) -> bool { return linalg.approx_equal(x, y, 0.0, 4.0*math.F64_EPSILON); };
	fmt.println(dense.norm_frobenius(a.view()), math.sqrt(91.0));
	check("norm_frobenius", within(dense.norm_frobenius(a.view()), math.sqrt(91.0)));

	// Squares that would overflow or underflow on their own.
	huge := dense.Matrix(f64).filled(2, 2, 1e300);
	check("norm_frobenius does not overflow", dense.norm_frobenius(huge.view()) == 2e300);
	tiny := dense.Matrix(f64).filled(4, 1, 3e-300);
	check("norm_frobenius does not underflow", dense.norm_frobenius(tiny.view()) == 6e-300);
	mixed := dense.Matrix(f64).from_rows([1][2]f64{{3e200, 4e200}});
	check("norm_frobenius of 3 and 4 times a large scale", within(dense.norm_frobenius(mixed.view()), 5e200));

	edge := dense.Matrix(f64).from_rows([1][3]f64{{1, math.F64_INFINITY, 2}});
	check("an infinity gives infinity", dense.norm_frobenius(edge.view()) == math.F64_INFINITY && dense.norm_one(edge.view()) == math.F64_INFINITY);
	edge[0, 2] = math.F64_NAN;
	frobenius := dense.norm_frobenius(edge.view());
	one := dense.norm_one(edge.view());
	infinity := dense.norm_infinity(edge.view());
	check("a NaN gives NaN", frobenius != frobenius && one != one && infinity != infinity);
	fmt.println(dense.norm_frobenius(sample(f64, 7, 5, 4).view()), dense.norm_frobenius(sample(f32, 7, 5, 4).view()));
}

main :: proc() {
	construction();
	views();
	mutable_views();
	products();
	elementwise();
	norms();
}
