package main;

import "core:fmt";
import "core:container";

// design.md "Operator lookup and overload resolution", tie-breaker 1: an
// argument that owns its value — a temporary or `move(x)` — prefers a `move`
// parameter, ahead of every structural tie-breaker. A borrowed place cannot
// reach one.

// Parametric against non-parametric.
ordinary  :: proc(x: int) -> int { return 1; }
consuming :: proc(x: move $T) -> int { return 2; }
pick      :: proc{ordinary, consuming};

// Omitted defaults.
plain       :: proc(x: int) -> int { return 1; }
consuming_d :: proc(x: move int, y: int = 0) -> int { return 2; }
defaulted   :: proc{plain, consuming_d};

// Fixed arity against variadic.
Tag :: struct { id: int }
spread :: proc(values: ..Tag) -> int { return 1; }
take   :: proc(value: move Tag) -> int { return 2; }
store  :: proc{spread, take};

// With no consuming member viable, an owned argument still reaches an ordinary one.
only_int    :: proc(x: int) -> int { return 1; }
only_string :: proc(x: string_view) -> int { return 3; }
only        :: proc{only_int, only_string};

// A move-only temporary reaches `shared_from_move`, not the cloning member.
Res :: move_only struct { id: int }
make_res :: proc(id: int) -> Res { return Res{id}; }

// One source line dispatches alike for a copyable and a move-only element.
Copied :: struct { id: int }
impl Copied {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Copied, Allocator_Error) {
		return .ok(Copied{self.id + 100});
	}
}
make_copied :: proc() -> Copied { return Copied{1}; }
make_res_one :: proc() -> Res { return Res{1}; }

fill :: proc(values: inout container.Small_Array($T, 4), make: proc() -> T) {
	values.append(make());
}

// Receivers follow the same rule.
Box :: struct { n: int }
impl Box {
	look :: proc(self) -> int { return 1; }
	eat  :: proc(self: move) -> int { return 2; }
	use  :: proc{look, eat};
}
make_box :: proc() -> Box { return Box{1}; }

main :: proc() {
	v := 7;
	fmt.println(pick(v), pick(7), pick(move(v)));
	w := 7;
	fmt.println(defaulted(w), defaulted(move(w)));
	t := Tag{1};
	u := Tag{2};
	fmt.println(store(t), store(Tag{3}), store(move(u)));
	x := 7;
	fmt.println(only(move(x)));

	shared_res := shared(make_res(4));
	fmt.println(shared_res.get()^.id);

	copies: container.Small_Array(Copied, 4) = {};
	fill(inout copies, make_copied);
	owners: container.Small_Array(Res, 4) = {};
	fill(inout owners, make_res_one);
	fmt.println(copies.slice()[0].id, owners.slice()[0].id);

	b := Box{1};
	fmt.println(b.use(), make_box().use(), move(b).use());
}
