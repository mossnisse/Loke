// design.md "C pointers": `pp[i]` through a pointer to a C pointer reads through
// the header, as it does for a slice. It used to reach clang as an invalid GEP.
package main;

import "core:fmt";
import "core:unsafe";

main :: proc() {
	values := [3]int{1, 2, 3};
	c := ([^]int)(&values[0]);
	reading := &c;
	fmt.println(reading[1]);
	writing := &mut c;
	writing[1] = 7;
	fmt.println(writing[1], values[1]);
}
