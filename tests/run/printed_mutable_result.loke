package main;

import "core:fmt";

// design.md "Built-in procedures": a value printed through a mutable call result is
// viewed, not lent, so a read of its source does not touch it, and it is in use only
// until printing ends.

first_mut :: proc(d: ^mut [dynamic]int) -> ^mut int { return &mut d^[0]; }

read_of_the_source :: proc() {
	m := map[int]int{};
	defer drop(m);
	fmt.println(m.find_or_insert(3, 7)^, m.len());
}

read_of_the_source_through_a_pointer :: proc(p: ^mut [dynamic]int) {
	fmt.println(first_mut(p)^, p^.len());
}

element_of_the_source :: proc() {
	d := [dynamic]int{1};
	defer drop(d);
	fmt.println(first_mut(&mut d)^, d[0], d.len());
}

// Printing has ended.
cleared_after_printing :: proc() {
	m := map[int]int{};
	defer drop(m);
	fmt.println(m.find_or_insert(3, 7)^);
	m.clear();
	fmt.println(m.len());
}

other_storage_cleared :: proc() {
	m := map[int]int{};
	defer drop(m);
	n := map[int]int{};
	defer drop(n);
	n.find_or_insert(1, 1);
	fmt.println(m.find_or_insert(3, 7)^, n.find_or_insert(1, 1)^);
}

main :: proc() {
	read_of_the_source();
	d := [dynamic]int{4};
	defer drop(d);
	read_of_the_source_through_a_pointer(&mut d);
	element_of_the_source();
	cleared_after_printing();
	other_storage_cleared();
}
