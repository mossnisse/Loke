package main;

import "core:fmt";
import "core:math";
import "core:math/repro";
import "core:random";
import "core:unsafe";

// The ziggurat tables in `core:random` are literals (standard-library
// "Distributions"). This recomputes them from R and V with `core:math/repro`,
// whose results are the same on every machine, runs the same sampler over the
// recomputation, and requires the package's `normal` and `exponential` to give
// the same bits from the same seed. Every accepted value from a layer is
// `u * X[i]`, so a wrong entry in either `X` table changes the output; the `F`
// tables steer the wedge tests, which a quarter of a million draws reach in
// every layer, though an `F` entry off in its last bit changes a decision too
// rarely to show. So two scripted draws pin the two entries the recomputation
// moved, `NORMAL_F[94]` and `EXPONENTIAL_F[87]`: each puts a position at its
// strip's outer edge and the height at the entry, where the corrected entry
// accepts on the second draw and the one before it rejects and draws again.

NORMAL_R :: 3.6541528853610088;
NORMAL_V :: 0.00492867323399;
EXPONENTIAL_R :: 7.69711747013104972;
EXPONENTIAL_V :: 0.0039496598225815571993;

Tables :: struct {
	x: [257]f64,
	f: [257]f64,
}

normal_density :: proc(x: f64) -> f64 { return repro.exp(-0.5*x*x); }
exponential_density :: proc(x: f64) -> f64 { return repro.exp(-x); }

build :: proc(r, v: f64, normal: bool) -> Tables {
	t: Tables = {};
	t.x[0] = v / (normal_density(r) if normal else exponential_density(r));
	t.x[1] = r;
	foreach (i in 2 ..< 256) {
		previous := t.x[i - 1];
		if (normal) {
			t.x[i] = repro.sqrt(-2.0*repro.log(v / previous + normal_density(previous)));
		} else {
			t.x[i] = -repro.log(v / previous + exponential_density(previous));
		}
	}
	t.x[256] = 0.0;
	foreach (i in 0 ..< 257) {
		t.f[i] = normal_density(t.x[i]) if normal else exponential_density(t.x[i]);
	}
	return t;
}

open_unit :: proc(bits: u64) -> f64 {
	return (f64(bits >> 12) + 0.5) * (1.0 / 4503599627370496.0);
}

reference_normal :: proc(rng: inout random.Xoshiro256, t: ^Tables) -> f64 {
	for (;;) {
		bits := rng.next_u64();
		layer := int(bits & 0xFF);
		u := 2.0*open_unit(bits) - 1.0;
		x := u*t.x[layer];
		if (math.abs(x) < t.x[layer + 1]) { return x; }
		if (layer == 0) {
			for (;;) {
				tail := repro.log(open_unit(rng.next_u64())) / NORMAL_R;
				y := repro.log(open_unit(rng.next_u64()));
				if (-2.0*y >= tail*tail) {
					return (tail - NORMAL_R) if u < 0.0 else (NORMAL_R - tail);
				}
			}
		}
		height := t.f[layer + 1] + (t.f[layer] - t.f[layer + 1])*random.unit(inout rng);
		if (height < normal_density(x)) { return x; }
	}
}

reference_exponential :: proc(rng: inout random.Xoshiro256, t: ^Tables) -> f64 {
	for (;;) {
		bits := rng.next_u64();
		layer := int(bits & 0xFF);
		x := open_unit(bits)*t.x[layer];
		if (x < t.x[layer + 1]) { return x; }
		if (layer == 0) { return EXPONENTIAL_R - repro.log(open_unit(rng.next_u64())); }
		height := t.f[layer + 1] + (t.f[layer] - t.f[layer + 1])*random.unit(inout rng);
		if (height < exponential_density(x)) { return x; }
	}
}

// Two given words, then 2^63 for every later draw.
Script :: struct { first: u64, second: u64, used: int }

impl Script {
	next_u64 :: proc(self: inout) -> u64 {
		self.used += 1;
		if (self.used == 1) { return self.first; }
		if (self.used == 2) { return self.second; }
		return u64(1) << 63;
	}
}

same_bits :: proc(a, b: f64) -> bool {
	return unsafe.transmute(u64, a) == unsafe.transmute(u64, b);
}

main :: proc() {
	normal_tables := build(NORMAL_R, NORMAL_V, true);
	exponential_tables := build(EXPONENTIAL_R, EXPONENTIAL_V, false);

	// The strips' edges fall from the virtual base width to zero.
	falling := true;
	foreach (i in 0 ..< 256) {
		if (!(normal_tables.x[i] > normal_tables.x[i + 1])) { falling = false; }
		if (!(exponential_tables.x[i] > exponential_tables.x[i + 1])) { falling = false; }
	}
	fmt.println("falling", falling);

	count := 250000;
	library := random.Xoshiro256.from_seed(0xD15C0);
	reference := random.Xoshiro256.from_seed(0xD15C0);
	mismatches := 0;
	foreach (_ in 0 ..< count) {
		if (!same_bits(random.normal(inout library), reference_normal(inout reference, &normal_tables))) {
			mismatches += 1;
		}
	}
	fmt.println("normal mismatches", mismatches, library.state() == reference.state());

	mismatches = 0;
	foreach (_ in 0 ..< count) {
		if (!same_bits(random.exponential(inout library), reference_exponential(inout reference, &exponential_tables))) {
			mismatches += 1;
		}
	}
	fmt.println("exponential mismatches", mismatches, library.state() == reference.state());

	// Layer 94's wedge, a position at its edge and a unit draw just below 1.
	edge := Script{0xfffffffffffff05e, 0xffffffffffedb800, 0};
	z := random.normal(inout edge);
	fmt.println("normal at layer 94", same_bits(z, unsafe.transmute(f64, u64(4610679304012718259))), edge.used);
	// Layer 87's, for the exponential.
	edge = Script{0xfffffffffffff057, 0xfffffffffff83000, 0};
	x := random.exponential(inout edge);
	fmt.println("exponential at layer 87", same_bits(x, unsafe.transmute(f64, u64(4612262104872842401))), edge.used);
}
