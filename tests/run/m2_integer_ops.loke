package main; import "core:fmt";

// Wrapping unsigned arithmetic, signed and unsigned operators, and the two
// defined exceptional cases: an oversized shift and `MIN % -1`. Signed overflow
// panics (tests/trap/signed_overflow), so signed wrap is spelled in the unsigned
// type.
main :: proc() {
	// Unsigned arithmetic wraps, per width (design.md "Integer overflow").
	a: u8 = 255;
	a += 1;
	fmt.println(int(a));

	b: i8 = 127;
	b = i8(u8(b) + 1);
	fmt.println(int(b));

	c: u16 = 0;
	c -= 1;
	fmt.println(int(c));

	d: i64 = -9223372036854775808;
	e: i64 = -1;
	fmt.println(int(d % e));

	// Unsigned division and comparison use the unsigned opcodes: `f` is far
	// beyond i64's range, so a signed compare would call it negative.
	f: u64 = 18446744073709551615;
	g: u64 = 2;
	fmt.println(1 if f / g == 9223372036854775807 else 0);
	fmt.println(1 if f > g else 0);

	h: i64 = -1;
	fmt.println(1 if h > 2 else 0);

	// Oversized shifts, runtime count, signed and unsigned.
	count: uint = 40;
	i: i32 = -1;
	j: u32 = 4294967295;
	fmt.println(int(i >> count));
	fmt.println(int(j >> count));
	fmt.println(int(i << count));
	fmt.println(-1 >> 40);

	// Remainder keeps the sign of the dividend, constant and at runtime.
	fmt.println(-7 / 2);
	fmt.println(-7 % 2);
	fmt.println(7 / -2);
	fmt.println(7 % -2);

	k := -7;
	l := 2;
	fmt.println(k / l);
	fmt.println(k % l);

	// Bitwise, including and-not and complement.
	fmt.println(0b1111 &~ 0b0101);
	fmt.println(~0);
	m := 15;
	n := 5;
	fmt.println(m &~ n);
	fmt.println(~m);
}
