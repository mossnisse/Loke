package main; import "core:fmt"; import "core:strconv"; import "core:strings";

// `core:strconv` end to end (standard-library "`core:strconv`").
//
// A failure prints its `Parse_Error` ordinal: 0 invalid syntax, 1 invalid base,
// 2 overflow, 3 trailing data.

show_i64 :: proc(text: string_view, base: int = 0) {
	switch (strconv.parse_i64(text, base)) {
	case .ok(outcome):  fmt.println(outcome);
	case .err(outcome): fmt.println(int(outcome));
	}
}

show_f64 :: proc(text: string_view) {
	switch (strconv.parse_f64(text)) {
	case .ok(outcome):  fmt.println(outcome);
	case .err(outcome): fmt.println(int(outcome));
	}
}

main :: proc() {
	// Booleans answer with an `Option`: absence is the whole story.
	switch (strconv.parse_bool(" true ")) {
	case .some(yes):
		fmt.println(yes);
		fmt.println(true);
	case .none:
		fmt.println(false);
		fmt.println(false);
	}
	switch (strconv.parse_bool("0")) {
	case .some(no):
		fmt.println(no);
		fmt.println(true);
	case .none:
		fmt.println(false);
		fmt.println(false);
	}
	switch (strconv.parse_bool("yes")) {
	case .some: fmt.println(true);
	case .none: fmt.println(false);
	}

	// Integers, with the language's own prefixes when the base is 0, and the
	// lexer's own underscore rule.
	show_i64("42");
	show_i64("  -42  ");
	show_i64("+7");
	show_i64("0x_ff");
	show_i64("0b1011");
	show_i64("0o17");
	show_i64("1_000_000");
	show_i64("ff", 16);
	show_i64("zz", 36);
	show_i64("9223372036854775807");
	show_i64("-9223372036854775808");
	// Negative zero has no magnitude to borrow one from.
	show_i64("-0");
	show_i64("-0x0");

	// And every documented failure.
	show_i64("");
	show_i64("-");
	show_i64("12x");
	show_i64("x12");
	show_i64("2", 1);
	show_i64("9223372036854775808");
	show_i64("-9223372036854775809");

	// A prefix is recognised only when the base is 0. Under an explicit base it
	// is ordinary non-digit text, so it reports trailing data rather than
	// `Invalid_Base` -- including when it agrees with the base asked for.
	show_i64("0x10", 16);
	show_i64("0b11", 2);

	// Only lower-case prefixes, and a leading underscore only after one, as in a
	// Loke literal: `0X10` reads as decimal with trailing data, `_12` is a name.
	show_i64("0X10");
	show_i64("_12");
	show_i64("0x_10");

	switch (strconv.parse_u64("18446744073709551615")) {
	case .ok(unsigned):
		fmt.println(unsigned);
		fmt.println(true);
	case .err:
		fmt.println(0);
		fmt.println(false);
	}
	switch (strconv.parse_u64("-1")) {
	case .ok:  fmt.println(false);
	case .err: fmt.println(true);
	}

	fmt.println(strconv.parse_int("123") or_else -1);
	fmt.println(strconv.parse_uint("123") or_else 0);

	// Floating point.
	show_f64("0");
	show_f64("1");
	show_f64("-2.5");
	show_f64("1e3");
	show_f64("+0.125");
	show_f64(" 100 ");
	show_f64("");
	show_f64("1.2.3");
	show_f64("1e");
	show_f64("abc");

	// Underscores are ignored among the digits, the same rule the integer
	// parsers follow, and in the exponent too where a written literal may not.
	show_f64("1_000.5");
	show_f64("1.5_5");
	show_f64("1.5e1_0");
	show_f64("_");
	show_f64("1e_");
	show_f64("_5");
	show_f64(".5");
	show_f64("5.");

	// Correctly rounded: what `fmt` prints reads back as the same value. Scaling
	// a decimal mantissa by powers of ten got each of these an ulp off.
	show_f64("0.9999999999999999");
	show_f64("1.602176634e-19");
	show_f64("1.2345678901234567e-300");
	show_f64("1.7976931348623157e308");

	// Mantissas are accumulated without wrapping, and a finite spelling outside
	// f64's range reports Overflow instead of succeeding with infinity.
	switch (strconv.parse_f64("30000000000000000000")) {
	case .ok(large):
		fmt.println(true);
		fmt.println(large > 29000000000000000000.0 && large < 31000000000000000000.0);
	case .err:
		fmt.println(false);
		fmt.println(false);
	}
	switch (strconv.parse_f64("1e999")) {
	case .ok:  fmt.println(-1);
	case .err(float_overflow): fmt.println(int(float_overflow));
	}

	// The C library reads only the first 768 significant digits. Past them, a
	// nonzero digit still breaks a tie upwards: 2^53 + 1 is halfway between two
	// doubles, and anything above it rounds up. Before, the final 1 was dropped
	// once it was the 769th digit, and this read as 2^53.
	tie := "9007199254740993." + strings.repeat("0", 760) + "1";
	show_f64(tie);
	// A long run of leading zeros is not significant, and a huge exponent is not
	// read into a machine integer.
	show_f64("0." + strings.repeat("0", 1000) + "15e1001");
	show_f64("1e99999999999999999999");
	show_f64("-1e-99999999999999999999");
	// An exponent too long for a double still cancels a scale that long: each
	// of these is exactly one. Before, the exponent stopped growing past 100000,
	// so the first read as 0.0 and the second overflowed.
	zeros := strings.repeat("0", 10000000);
	show_f64("0." + zeros + "1e10000001");
	show_f64("1" + zeros + "e-10000000");

	// The fallible form answers the same, with the failure it can add beside
	// the text's own.
	fmt.println(strconv.try_parse_f64("2.5"), strconv.try_parse_f64("1e999"));
}
