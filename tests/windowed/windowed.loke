// compiler-guide.md "Windowed programs": linked for the GUI subsystem, so a process
// started without standard handles has none, and what it writes to standard
// error reaches a debugger instead. The argument picks how the program ends.
@(subsystem = "windows")
package main;

import "core:fmt";
import "core:os";

// Its drop runs as the main thread detaches, after `main` returns.
@(move_only) Noisy :: struct { live: bool }
impl Noisy {
	release :: hook(drop) proc(self: inout Noisy) {
		if (self.live) { fmt.eprint("dropped"); }
	}
}
noisy: thread_local Noisy;

main :: proc() -> i32 {
	fmt.println("out", os.args.len());
	fmt.eprintln("err line ö");
	if (os.args.len() > 1) {
		switch (os.args[1]) {
		case "panic": panic("asked to panic");
		// A partial line, then `exit`, which detaches no thread.
		case "exit":
			fmt.eprint("exiting");
			os.exit(4);
		case "drop": noisy = Noisy{true};
		// Longer than one debugger entry holds, cut inside a character.
		case "long":
			fmt.eprint("x");
			for (i := 0; i < 300; i += 1) { fmt.eprint("ö"); }
			fmt.eprintln();
		case:
		}
	}
	return 5;
}
