// design.md "Attributes", "Slices": a record's attributes are written on its declaration, and a
// mutable slice's `mut` in its brackets. `-migrate` rewrites what an earlier release accepted.
package main;

Packed :: struct @(packed) { a: u8 }
Token :: move_only struct { id: int }
Both :: move_only struct @(thread_affine) { id: int }
Maybe :: union @(zero=none) { none, some: int }
Generic :: struct($N: int) @(align=N) { a: u8 }
Holder :: struct { field: union @(zero=none) { none, some: int } }

// A name, not a keyword.
move_only := 3;
Named :: struct { move_only: int }

slices :: proc(values: []mut int) {
	whole := &mut values[:];
	inner := (&mut values[1:])[0:1];
	chained := (& mut values[1:2]).len();
	// The address of an element is the operator.
	element := &mut values[0];
}

sentinel :: proc() { }
