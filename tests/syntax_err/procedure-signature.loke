// Signatures: the parameter list, its names, a generic parameter's `$`, a
// procedure group's members, and the body a `where` clause still requires.
package main;

no_parameter_list :: proc -> int { return 1; }
bad_parameter :: proc(3: int) { }
Boxed :: struct(T) { value: T }

group :: proc() {
	g := proc { 1 };
	_ = g;
}

constrained :: proc(target: $T) -> int where Sized(T);

Sized :: interface($Self: type) {
	slot size: proc(self) -> int;
}

sentinel :: proc() { }

// The list runs to its `)`, so an unclosed one reads to the end of the file and
// has to come after everything else here.
unclosed :: proc(a: int { }
