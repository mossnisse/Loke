// design.md "Anonymous records": no parameter-only spelling is available in a
// record type; a `struct` declaration is what carries those. A record's fields
// are all labelled or all unlabelled, and an unlabelled one has at least two.
package main;

modes    :: (a: inout int, b: move int);
variadic :: (a: ..int);
defaults :: (a: int = 1);
single   :: proc() -> (int);
mixed    :: proc() -> (ok: bool, int);
applied  :: proc(v: Foo(x: int));
unmixed  :: proc() -> ([]int, ok: bool);

main :: proc() { }

sentinel :: proc() { }
