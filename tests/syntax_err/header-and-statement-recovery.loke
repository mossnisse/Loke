	for () { }
	for (x: ) { after_type(); }
	if (y: ) { after_type(); }
	switch (z: ) { }
	if (w := ) { after_value(); }
	if (v := 1) { after_value(); }
	if (@(tag) u > 0) { }
	@(tag) ;
	r := (1 2);
	s := move(1 2);
	after();
}

returns :: proc() -> int {
	return );
}

sentinel :: proc() { }
