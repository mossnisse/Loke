// A replaced runtime whose metadata layouts disagree with the compiler's:
// `size` and `align` are swapped, `Type_Kind` has no `Box`, and
// `Source_Code_Location` puts `column` before `line`. The bootstrap
// declarations are stubs.
@(public)
package runtime;

@(public)
Type_Kind :: enum u8 {
	Invalid, Void, Bool, Signed_Int, Unsigned_Int, Float, Rune,
	Raw_Pointer, Pointer, C_Pointer, Array, Slice, Dynamic_Array, Map,
	Struct, Enum, Union, Proc, String, String_View, CString_View,
	Typeid, Dyn, Distinct, Simd, Allocator, Allocator_Error,
}

@(public)
Type_Info :: struct {
	id:      typeid,
	kind:    Type_Kind,
	name:    string_view,
	align:   int,
	size:    int,
	element: typeid,
	key:     typeid,
	count:   int,
}

@(public)
Source_Code_Location :: struct {
	file:      string_view,
	procedure: string_view,
	column:    int,
	line:      int,
}

@(public)
Unit :: struct {}

@(public, zero=none, failure=none)
Option :: union($T: type) { none:, some: T }

@(public, failure=err)
Result :: union($T, $E: type) { ok: T, err: E }

@(public, failure=err)
Status :: union($E: type) { ok, err: E }

@(public)
Shared :: struct($T: type) { @(private) block: rawptr }

@(public)
Weak :: struct($T: type) { @(private) block: rawptr }

@(public)
Uninit :: struct($T: type) { @(private) value: T }

@(private)
shared_stub :: proc(value: $T) -> Shared(T) { return Shared(T){nil}; }

@(public)
shared :: proc{shared_stub};

@(public)
try_shared :: proc{shared_stub};

// design.md "`@(intrinsic)`": what the compiler supplies to any `base:runtime`.
@(intrinsic) Allocator :: ---;
@(intrinsic) Allocator_Error :: ---;
