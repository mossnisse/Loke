package main;
import "./keys";

// design.md "Comparison operators": a field compares by its type's own `==`,
// so one this package cannot see makes the record not comparable here.
Holder :: struct { value: keys.Key }

main :: proc() {
	a, b: Holder = {}, {};
	same := a == b;
	switch (a) {
	case: same = true;
	}
}

more :: proc() {
	shown := [1]keys.Shown{{id = 1, annotation = 2}} == [1]keys.Shown{{id = 1, annotation = 3}};
	grouped := [1]keys.Grouped{{id = 1}} == [1]keys.Grouped{{id = 1}};
	_ = shown; _ = grouped;
}
