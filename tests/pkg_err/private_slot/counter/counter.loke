package counter;

// design.md "Interface bodies": a public type's private members are not API.
// They meet no slot anywhere, and an associated constant requirement only where
// ordinary lookup sees them, which is in this package.

@(public)
Counter :: struct {
	count: int,
}

impl Counter {
	@(public)
	get :: proc(self) -> int { return self.count; }
	poke :: proc(self: inout, value: int) { self.count = value; }
	Secret :: int;
	call :: proc(self, n: int) -> int { return self.count + n; }
}
