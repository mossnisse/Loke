package main; import "core:fmt";

import "./models";

main :: proc() {
	account := models.make_account(1, 2);

	// Reading, writing, and measuring a package-private field from an importer.
	fmt.println(account.secret);
	account.secret = 3;
	fmt.println(offset_of(models.Account, secret));

	// Neither literal form is a back door; the named and positional cases must
	// agree (design.md "Exported names").
	named := models.Account{id = 1, secret = 2};
	positional := models.Account{1, 2};

	// A public field beside a private one still works, and omitting the
	// inaccessible field zero-fills rather than failing.
	fine := models.Account{id = 1};
	fmt.println(fine.id);
	fmt.println(named.id + positional.id);

	// Destructuring is not a back door either: `_` does not bypass visibility,
	// because the rule is about what this site may see, not what it retains.
	id, secret := account;
	id2, _ := account;
	fmt.println(id, secret, id2);
}
