@(public)
package adapter;

import "../vendor";

// An extension is visible for method lookup only inside this package.
impl vendor.Vector2 {
	doubled :: proc(self) -> i32 { return (self.x + self.y) * 2; }

	@(private)
	from_i32 :: hook(convert) proc(x: i32) -> vendor.Vector2 { return {x = x, y = x}; }

	// design.md "Lifecycle hooks and resource types": a hook replaces behavior
	// the compiler generates for the type, so it belongs with the type's own
	// package and an extension block cannot add one.
	release :: hook(drop) proc(self: inout vendor.Vector2) { }
}

impl vendor.Other {
	@(private)
	init :: proc(x: i32) -> vendor.Other { return {value = x}; }
}

use_here :: proc(v: vendor.Vector2) -> i32 {
	return v.doubled();
}
