@(public)
package adapter;

import "../vendor";

// An extension is visible for method lookup only inside this package.
extend vendor.Vector2 {
	doubled :: proc(self) -> i32 { return (self.x + self.y) * 2; }

	@(private)
	init :: proc(x: i32) -> vendor.Vector2 { return {x, x}; }

	// design.md "Lifecycle hooks and resource types": a hook replaces behavior
	// the compiler generates for the type, so it belongs with the type's own
	// package and `extend` cannot add one.
	drop :: proc(self: inout vendor.Vector2) { }
}

extend vendor.Other {
	@(private)
	init :: proc(x: i32) -> vendor.Other { return {x}; }
}

use_here :: proc(v: vendor.Vector2) -> i32 {
	return v.doubled();
}
