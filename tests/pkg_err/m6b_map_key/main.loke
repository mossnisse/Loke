package main; import "core:fmt"; import "./keys";

// design.md "Maps": "caller-local extensions do not qualify even if an ordinary
// interface check in that extension's package would succeed. This ensures that a
// `map[K]V` passed between packages continues to use one equality and hashing
// policy."
//
// Both operations are here, in the *using* package, and both would satisfy an
// ordinary `Hashable` query in this package. Neither enters the map's frozen
// operation table.

impl keys.Id {
	hash :: proc(self, seed: uint) -> uint { return self.v.hash(seed); }
	same :: operator(==) proc(x, y: keys.Id) -> bool { return x.v == y.v; }
}

main :: proc() {
	// The extension satisfies an ordinary local query...
	fmt.println(keys.Id{1} == keys.Id{1});
	// ...and still does not make the type a map key.
	table: map[keys.Id]int;
	fmt.println(1);
}
