package main; import "core:fmt";

import "./views";

// The summary crossed a package boundary: this result borrows `numbers`, which
// ends with this procedure.
escaping_across_a_package :: proc() -> []int {
	numbers := [4]int{1, 2, 3, 4};
	return views.first_half(numbers[:]);
}

// The same through a generic instance.
escaping_through_an_instance :: proc() -> []int {
	numbers := [4]int{1, 2, 3, 4};
	return views.head(numbers[:]);
}

// A borrow of the caller's own storage still ends where the caller says it does.
conflicting_across_a_package :: proc() {
	numbers := [4]int{1, 2, 3, 4};
	view := views.first_half(numbers[:]);
	numbers[0] = 9;
	fmt.println(view[0]);
}

// A static root the callee named survives, so this one is accepted.
constant_escapes :: proc() -> []int {
	return views.constant_view();
}

// The reset effect crossed the package boundary: handing this body's own
// allocator to an imported reset-capable procedure needs the same promise here.
resets_across_a_package :: proc(allocator: Allocator) {
	views.release(allocator);
}

// The promise written, the call is accepted; the allocation has no surviving
// carrier, so the reset releases it.
marked_across_a_package :: proc(@(allocator_reset) allocator: Allocator) {
	pointer, err := new(int, allocator);
	if (err != nil) { return; }
	pointer^ = 1;
	views.release(allocator);
}

main :: proc() {
	numbers := [4]int{1, 2, 3, 4};
	view := views.first_half(numbers[:]);
	fmt.println(view[0]);
	fmt.println(len(views.head(numbers[:])));
	fmt.println(len(constant_escapes()));
}
