// design.md "Private names in public declarations": each public declaration
// below names a private one where an importer would have to name it too.
package shapes;

@(private) Fill :: enum { Solid, Hatched }
@(private) Corner :: struct { x, y: int }
@(private) Alias :: Corner;
@(private) Bounded :: interface($T: type) { (a, b: T) a < b -> bool; }
@(private) is_small :: proc($N: int) -> bool { return N < 8; }
@(private) LIMIT :: 8;

// A parameter, and the same type again in the result, reported once.
@(public) fill_of :: proc(fill: Fill) -> Fill { return fill; }

// Nested in a slice, a pointer, and a generic type's argument.
@(public) corners :: proc() -> []Corner { return {}; }
@(public) first :: proc(at: ^Corner) -> int { return at.x; }
@(public) find :: proc() -> Option(Corner) { return .none; }

// An alias is a type too.
@(public) make_alias :: proc() -> Alias { return {}; }

// A public field, a type alias's target, and a distinct type's base.
@(public) Padded :: struct {
	@(public) fill: Fill,
	@(private) hidden: Fill, // private, so not read
}
@(public) Public_Alias :: Corner;
@(public) Distinct :: distinct Corner;

// A union's variant and a constant's type, written and inferred.
@(public) Shape :: union { Square: Corner, Circle: int }
@(public) ORIGIN: Corner : Corner{};
@(public) DEFAULT_FILL :: Fill.Solid;

// A procedure, an interface, and a constant in a `where` clause.
@(public) small :: proc($N: int) -> int where is_small(N) { return N; }
@(public) least :: proc(a, b: $T) -> T where Bounded(T) { return a if a < b else b; }
@(public) bounded :: proc($N: int) -> int where N <= LIMIT { return N; }

// A generic record's `where` clause and field, a generic `impl`'s member, and
// an interface requirement's result, none of which a symbol records.
@(public) Box :: struct($T: type) where Bounded(T) { value: T }
@(public) Pair :: struct($T: type) { @(public) first: T, @(public) second: Corner }
impl Pair($T) {
	@(public) second_of :: proc(self) -> Corner { return self.second; }
}
@(public) Cornered :: interface($T: type) { (value: T) value.corner() -> Corner; }

// The private members of a public group are not reported by name, but the
// signature the group exports is read.
@(private) area_int :: proc(side: int) -> int { return side * side; }
@(private) area_corner :: proc(corner: Corner) -> int { return corner.x * corner.y; }
@(public) area :: proc{area_int, area_corner};

// None of these is reported.
@(public) Point :: struct { x, y: int }
@(public) origin :: proc() -> Point { return {}; }
@(public) identity :: proc(value: $T) -> T { return value; }
@(public) sized :: proc(value: int = LIMIT) -> [LIMIT]int { return {}; }
@(public) twice :: proc{area_int, origin_twice};
@(private) origin_twice :: proc(point: Point) -> Point { return {point.x * 2, point.y * 2}; }
@(private) scratch :: proc(corner: Corner) -> Corner { return corner; }

// A private type's members are reached only through a value of it.
impl Corner {
	@(public) sum :: proc(self) -> int { return self.x + self.y; }
	@(public) moved :: proc(self, by: Corner) -> Corner { return {self.x + by.x, self.y + by.y}; }
}

// A public type's members are read.
impl Point {
	@(public) corner :: proc(self) -> Corner { return {self.x, self.y}; }
}

// A generic `impl`'s constant with no written type is read by its value's
// type: at the declaration when the value names no `$` name of the block, and
// in each instance when it does, passing over the type the instance binds.
@(public) Holder :: struct($T: type) { value: T }
@(public) Twin :: struct($A: type, $B: type) { a: A, b: B }
@(public) Row :: struct($N: int) { cells: [N]int }
@(private) Secret :: struct($T: type) { value: T }
@(public) Lone :: struct($T: type) { value: T }
impl Holder($T) {
	@(public) START :: Corner{}; // though the one instance binding `T` to it is `Holder(Corner)`
	@(public) TWINNED :: Twin(T, Corner){}; // by `Holder(int)`, once for both instances
	@(public) HELD :: Holder(T){}; // not reported: `T` names no type
	@(public) CORNER_SIZE :: size_of(Corner); // not reported: an `int`
	@(private) INNER :: Corner{}; // not reported: private
}
impl Row($N) {
	@(public) CORNERS :: [N]Corner{}; // by `Row(2)`
}
impl Secret($T) {
	@(public) HIDDEN :: Corner{}; // not reported: the subject is private
	@(public) Within :: Corner; // not reported: the subject is private
}
impl Lone($T) {
	@(public) LONE :: Corner{}; // with no instance
	@(public) LONE_TWIN :: Twin(T, Corner){}; // not reported: no instance gives it a type
}
@(private) instances :: proc() {
	_ = Holder(Corner).HELD;
	_ = Holder(int).HELD;
	_ = Holder(bool).HELD;
	_ = Row(2){};
	_ = Secret(int).HIDDEN;
}

// A generic `impl`'s type alias is read by its target's syntax, as any alias's
// is, whether or not the target names a `$` name of the block, and once however
// many instances there are.
@(public) Shelf :: struct($T: type) { value: T }
@(private) Point_Alias :: Point;
impl Shelf($T) {
	@(public) Inner :: Corner;
	@(public) Aliased :: Point_Alias; // a private alias of a public type
	@(public) Paired :: Twin(T, Corner);
	@(public) Mapped :: map[T]Corner;
	@(public) Callback :: proc(corner: Corner);
	@(public) Plain_Twin :: Twin(T, Point); // not reported
	@(public) Itself :: T; // not reported
}
@(private) shelves :: proc() {
	_ = Shelf(int){};
	_ = size_of(Shelf(bool).Paired);
	_ = size_of(Shelf(int).Inner);
}

// An alias written with its type is read by its target in a generic `impl` as
// in a plain one, and so is one that selects a type member from an instance,
// whether the instance is written with a `$` name or a concrete type.
@(public) Crate :: struct { value: int }
@(public) Bin :: struct($T: type) { value: T }
impl Crate {
	@(public) Typed: type : Corner;
	@(private) Hidden :: Corner;
	@(public) Sibling :: Crate.Hidden;
	@(public) Concrete :: Bin(int).Hidden;
}
impl Bin($T) {
	@(public) Typed: type : Corner;
	@(private) Hidden :: Corner;
	@(private) Hidden_Typed: type : Corner;
	@(private) Chained :: Bin(T).Hidden;
	@(public) Open :: Point;
	@(public) Sibling :: Bin(T).Hidden;
	@(public) Concrete :: Bin(int).Hidden;
	@(public) Sibling_Typed :: Bin(T).Hidden_Typed;
	@(public) Followed :: Bin(T).Chained;
	@(public) Through :: Secret(T).Within; // a private type's member
	@(public) Opened :: Bin(T).Open; // not reported
}
@(private) bins :: proc() {
	_ = size_of(Bin(int).Typed);
	_ = size_of(Bin(int).Sibling);
	_ = size_of(Bin(bool).Concrete);
}

// An alias's written type is `type` through an alias of it too, or in an
// instance that binds a `$` name to `type`; a member written as a composite type
// is a type to select; and a chain of selections is followed however long it is.
@(public) Meta :: type;
@(public) Meta_Twice :: Meta;
@(public) Tray :: struct($T: type) { value: int }
impl Tray($T) {
	@(public) Meta_Typed: Meta : Corner;
	@(public) Twice_Typed: Meta_Twice : Corner;
	@(private) Many :: []T;
	@(private) Pointed :: ^T;
	@(private) Fixed :: [2]T;
	@(private) Keyed :: map[T]int;
	@(public) Many_Leak :: Tray(T).Many;
	@(public) Pointed_Leak :: Tray(T).Pointed;
	@(public) Fixed_Leak :: Tray(T).Fixed;
	@(public) Keyed_Leak :: Tray(T).Keyed;
	@(private) H0 :: Tray(T).H1;
	@(private) H1 :: Tray(T).H2;
	@(private) H2 :: Tray(T).H3;
	@(private) H3 :: Tray(T).H4;
	@(private) H4 :: Tray(T).H5;
	@(private) H5 :: Tray(T).H6;
	@(private) H6 :: Tray(T).H7;
	@(private) H7 :: Tray(T).H8;
	@(private) H8 :: Tray(T).H9;
	@(private) H9 :: Corner;
	@(public) Chain_Leak :: Tray(T).H0;
}
@(public) Rack :: struct($T: type) { value: int }
impl Rack($T) {
	@(public) Bound_Typed: T : Corner;
}
@(private) trays :: proc() {
	_ = size_of(Tray(Point).Meta_Typed);
	_ = size_of(Tray(Point).Many_Leak);
	_ = Rack(type).Bound_Typed;
}
