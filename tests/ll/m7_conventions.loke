package main; import "core:fmt";

// design.md "Calling conventions" / "Parameter semantics and ABI lowering"
//: the Windows x64 classification of a foreign `"c"`/`"stdcall"`
// signature, pinned against what clang emits for the equivalent C declaration.
// A register-sized aggregate travels in one integer register; a larger one is
// indirect, and a larger result uses a hidden `sret` pointer. A direct `_Bool`
// is `i1 zeroext`; scalars pass as themselves. `"stdcall"` lowers like `"c"`.

S4  :: struct { a: i32 }
S16 :: struct { a: i64, b: i64 }

reg_param  :: proc "c" (s: S4) -> i32 { return s.a; }
reg_result :: proc "c" (x: i32) -> S4 { return S4{ a = x }; }
indirect   :: proc "c" (s: S16) -> i64 { return s.a + s.b; }
sret       :: proc "c" (x: i64) -> S16 { return S16{ a = x, b = x }; }
boolean    :: proc "c" (b: bool) -> bool { return !b; }
scalars    :: proc "c" (i: i32, l: i64, f: f32, d: f64, p: rawptr) -> f64 { return d; }
stdc       :: proc "stdcall" (s: S4) -> i32 { return s.a; }
borrowed: i32 = 1;
borrow      :: proc "c" () -> inout i32 { return inout borrowed; }

main :: proc() {
	fmt.println(reg_param(S4{ a = 1 }));
	fmt.println(reg_result(2).a);
	fmt.println(indirect(S16{ a = 3, b = 4 }));
	fmt.println(sret(5).a);
	fmt.println(boolean(true));
	fmt.println(scalars(1, 2, 3.0, 4.0, nil));
	fmt.println(stdc(S4{ a = 6 }));
	borrow() = 7;
}
