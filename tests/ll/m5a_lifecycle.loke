package main; import "core:fmt";

// The generated copy entry points (m5a-plan step 3). A record no part of which
// reaches a custom hook cannot fail, so its `try_clone` is the copy its
// representation already is — no call, no branch, no cleanup.

Plain :: struct { x: int, y: int }

Res :: struct { id: int }

impl Res {
	copy_owned :: hook(copy) proc(self, allocator: Allocator) -> Result(Res, Allocator_Error) {
		return .ok(Res{self.id});
	}

	release :: hook(drop) proc(self: inout Res) { self.id = 0; }
}

Group :: struct {
	first:  Res,
	second: Res,
}

main :: proc() {
	p := Plain{1, 2};
	q := p.clone();
	fmt.println(q.x);

	g := Group{Res{1}, Res{2}};
	c, error := g.try_clone();
	if (error == nil) {
		fmt.println(c.second.id);
	}
	d := g.clone();
	fmt.println(d.first.id);
}
