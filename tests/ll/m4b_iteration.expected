%struct.Range.int.* = type { i64, i64, i1 }
%t* = select i1 false, i1 %t*, i1 %t*
%t* = insertvalue %struct.Range.int.* %t*, i1 true, 2
%t* = select i1 %t*, i1 %t*, i1 %t*
br i1 %t*, label %foreach.done.*, label %foreach.step.*
foreach.head.
foreach.post.
foreach.done.
getelementptr inbounds [3 x i64], ptr
