package main;

// standard-library.md "`core:math`": the bit counts and rotations are each one
// LLVM intrinsic call, not a loop, at every optimization level. The counts
// pass `i1 false`, so a zero operand is the width rather than poison, and a
// narrow operand's count widens to `int`. The bit width subtracts `ctlz` from
// the width, the reversal is `bitreverse`, and the power-of-two round-up is
// `ctlz` and a shift behind an overflow panic, or an option in its checked
// form.

import "core:math";

main :: proc() {
	x: u64 = 12;
	b: u8 = 3;
	w: u128 = 5;
	s: i16 = 7;
	k := 3;
	_ = math.count_ones(x);
	_ = math.leading_zeros(b);
	_ = math.trailing_zeros(w);
	_ = math.rotate_left(x, k);
	_ = math.rotate_right(b, k);
	_ = math.bit_width(s);
	_ = math.reverse_bits(w);
	_ = math.is_power_of_two(s);
	_ = math.next_power_of_two(s);
	_ = math.checked_next_power_of_two(x);
}
