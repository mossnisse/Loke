package main;

import "core:fmt";

// design.md "@(packed)": viewing a packed `string` or `[dynamic]T` field reads
// its header with `align 1`, since the field may start at any byte.
Packed :: struct @(packed) { tag: u8, text: string, data: [dynamic]int }

main :: proc() {
	p := Packed{1, "hello", {3, 4}};
	text: string_view = p.text;
	data: []int = p.data;
	fmt.println(text, data[1]);
}
