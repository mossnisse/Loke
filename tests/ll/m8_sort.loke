package main; import "core:fmt"; import "core:slice";

// The sort lowering (standard-library.md "Sorting slices"): a `sort` or
// `reverse_sort` member calls `core:slice`'s instance for the element type on a
// slice of the elements, the same one `slice.sort` is, and that is `sort_by` with
// `Ascending` or `Descending`, which call the element's `<` directly. Nothing
// reaches a runtime sort.

Card :: struct { rank: int, tag: int }

impl Card {
	before :: operator(<) proc(a, b: Card) -> bool { return a.rank < b.rank; }
}

By_Tag :: struct { descending: bool }

impl By_Tag {
	call :: proc(self, a, b: Card) -> bool {
		if (self.descending) { return b.tag < a.tag; }
		return a.tag < b.tag;
	}
}

main :: proc() {
	numbers: [dynamic]int = {};
	numbers.append(3, 1, 2);
	numbers.sort();
	numbers.reverse_sort();

	view := []mut int{3, 1, 2};
	slice.sort(view);

	cards := [dynamic]Card{Card{2, 0}, Card{1, 1}};
	cards.sort();
	slice.sort_by(cards[mut :], By_Tag{true});

	fmt.println(numbers, view, cards.len());
}
