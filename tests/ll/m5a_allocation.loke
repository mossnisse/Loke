package main;

// Allocation lowering over the seed runtime's allocator ABI (m6a-plan step 1).
// Every allocation names the provider record, the exact size, and the exact
// alignment: `new` zero-initialises, `new_clone` fills a raw allocation through
// the operand's own clone hook, and `free` returns the same size and alignment
// the provider was given. The handle is a pointer to one
// `loke_rt_allocator_v1`, so passing it on copies the pointer and keeps the
// provider's state, region identity, and failure policy.

Res :: struct { id: int }

impl Res {
	try_clone :: proc(self, allocator: Allocator) -> (Res, Allocator_Error) {
		return Res{self.id}, nil;
	}

	drop :: proc(self: inout Res) { self.id = 0; }
}

main :: proc() {
	p, err := new(int);
	if (err == nil) {
		p^ = 1;
		free(p);
	}

	// A trivially copyable operand stores its representation.
	q, qerr := new_clone(7);
	if (qerr == nil) {
		free(q);
	}

	// A record whose clone can fail goes through the hook, and the allocation it
	// cannot publish into is released.
	r, rerr := new_clone(Res{2});
	if (rerr == nil) {
		free(r);
	}
	print_int(0);
}
