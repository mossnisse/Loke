package main;

// The shape of coherent formatting: ordinary Formattable witnesses keyed by
// frozen typeid, runtime-ABI wrappers for aggregates, and a checked lookup for
// each erased argument. Defaults and custom methods use the same slot ABI.

import "core:fmt";

Point :: struct {
	@(public) x: int,
	@(public) y: int,
}

Money :: struct { @(public) cents: int }

// Declared in the value type's own package, so the thunk calls it instead of
// spelling a struct.
impl Money {
	format :: proc(self, w: fmt.Writer, o: fmt.Options) {
		fmt.format_to(w, self.cents);
	}
}

main :: proc() {
	fmt.println(1, Point{2, 3}, Money{4});
}
