package main;

// design.md "Program entry and exit": the executable's C entry
// is `wmain`, so Windows hands it a UTF-16 argument vector. The runtime converts
// it once, before the initial thread attaches, which is what makes `os.args` a
// read rather than a conversion.

@(export)
exported_symbol :: proc "c" () -> i32 { return 1; }

main :: proc() {}
