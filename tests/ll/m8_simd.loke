package main;

import "core:fmt";
import "core:simd";

// The lowering design.md's "SIMD vectors" section commits to:
// `<N x T>`, lane-wise instructions, a splat as insert-plus-shuffle, a mask as
// one byte per lane, and the reductions as LLVM's own intrinsics.

main :: proc() {
	a: Simd(i32, 4) = {1, 2, 3, 4};
	b: Simd(i32, 4) = {5, 6, 7, 8};
	fmt.println(a + b, a * b);

	// A written scalar splats rather than being an ordinary operand.
	scale := 3;
	widened: Simd(int, 4) = scale;
	fmt.println(widened);

	// A comparison is an `icmp` on the vector, widened from `<N x i1>` to the
	// byte-per-lane mask.
	mask := a < b;
	fmt.println(simd.any(mask), simd.all(mask));

	// Division guards on any zero lane, which reduces before it branches.
	fmt.println(a / b);

	f: Simd(f32, 4) = {1.5, 2.5, 3.5, 4.5};
	fmt.println(f + f, simd.reduce_add(f), simd.reduce_max(f));
	fmt.println(simd.select(mask, a, b));
	fmt.println(simd.to_array(a));
}
