package main; import "core:fmt";

// design.md "Record layout attributes": the byte-exact LLVM
// bodies and the `align 1` that a packed field's load and store carry.

@(packed) Packed :: struct { x: u8, y: i32 }
@(align=16) Over :: struct { b: bool, n: i32 }
@(packed, align=8) Both :: struct { x: u8, y: i32 }
@(align=8) Empty_Over :: struct { }
@(packed, align=8) Empty_Both :: struct { }

main :: proc() {
	p := Packed{ x = 1, y = 2 };
	p.y = 3;
	o := Over{ b = true, n = 4 };
	b := Both{ x = 5, y = 6 };
	eo := Empty_Over{};
	eb := Empty_Both{};
	_ = eo; _ = eb;
	fmt.println(p.y, o.n, b.y);
}
