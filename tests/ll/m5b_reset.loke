package main;

// design.md: `free_all` "frees every allocation in the allocator's region". It
// lowers to one call through the provider's reset callback, never to a guessed
// sequence of `free` calls: only the provider knows what its region holds. The
// system-heap provider has no region and fails that call at run time.
// `release` is deliberately not called with `default_allocator()` here: a
// program cannot hide a reset of that pre-existing region in `main` merely to
// exercise an unsupported provider.

release :: proc(@(allocator_reset) allocator: Allocator) {
	free_all(allocator);
}

// Provenance changes no cleanup lowering: this managed local still drops once on
// the way out, exactly as it did before the analysis existed.
Res :: struct { id: int }

impl Res {
	drop :: proc(self: inout Res) { self.id = 0; }
}

kept :: proc() -> int {
	value := Res{1};
	return value.id;
}

main :: proc() {
	print_int(kept());
}
