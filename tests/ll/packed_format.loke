package main;

import "core:fmt"; import "core:unsafe";

// design.md "@(packed)" and "String format printing": a type's formatter reads
// its value at the type's alignment, so the record formatter hands a packed
// field's formatter an aligned copy, and reads a live-prefix count with
// `align 1`.
Packed :: struct @(packed) {
	@(public) tag: u8,
	@(public) value: u64,
	@(public) count: int,
	@(public, initialized=count) items: [2]int,
}

main :: proc() {
	value := Packed{1, 123, 0, {}};
	fmt.println(value);
}
