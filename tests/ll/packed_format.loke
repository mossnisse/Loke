package main;

import "core:fmt";

// design.md "@(packed)" and standard-library.md "Printed forms": a type's formatter reads
// its value at the type's alignment, so the record formatter hands a packed
// field's formatter an aligned copy.
@(packed) Packed :: struct {
	@(public) tag: u8,
	@(public) value: u64,
	@(public) items: [2]int,
}

main :: proc() {
	value := Packed{1, 123, {}};
	fmt.println(value);
}
