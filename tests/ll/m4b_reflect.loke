package main;

Point :: struct { x: int, y: i32 }
Colour :: enum { Red, Green }

main :: proc() {
	p: Point = {1, 2};
	// A static expansion emits its copies in order with no loop at all.
	foreach ($field in fields_of(Point)) {
		when (type_of(field.get(&p)) == int) {
			print_int(field.get(&p));
		} else {
			print_int(int(field.get(&p)));
		}
	}
	// An empty expansion emits nothing.
	foreach ($member in enum_values_of(Colour)) { }

	id := typeid_of(Point);
	other := typeid_of(Colour);
	if (id == other) { print_int(0); } else { print_int(1); }
}
