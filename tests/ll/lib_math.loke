package main;

// `core:math` binds the platform C math symbols directly, with a separate
// entry point for each width. Widening an f32 call through double can still
// print the right answer, so check the generated IR as well as runtime output.
// `sqrt` is the instruction in each width, not the C library's, and so are
// `floor`, `ceil`, `trunc`, and `round`, which LLVM turns into the C library's
// calls only below SSE4.1. `mod` is LLVM's `frem`, which LLVM turns into the
// C library's `fmod` and `fmodf`.

import "core:math";

main :: proc() {
	_ = math.sqrt(2.0);
	_ = math.sqrt_f32(f32(2.0));
	_ = math.floor(2.5);
	_ = math.ceil_f32(f32(2.5));
	_ = math.trunc(2.5);
	_ = math.round_f32(f32(2.5));
	_ = math.hypot(3.0, 4.0);
	_ = math.hypot_f32(f32(3.0), f32(4.0));
	_ = math.pow(2.0, 10.0);
	_ = math.pow_f32(f32(2.0), f32(10.0));
	_ = math.sin(1.0);
	_ = math.sin_f32(f32(1.0));
	_ = math.mod(7.0, 3.0);
	_ = math.mod_f32(f32(7.0), f32(3.0));
	_ = math.exp_f32(f32(1.0));
	_ = math.tan_f32(f32(1.0));
	_ = math.acos_f32(f32(0.0));
	// `fma` is computed in Loke, not by the C library, whose `fma` is not
	// correctly rounded in every version.
	_ = math.fma(2.0, 3.0, 4.0);
	_ = math.fma_f32(f32(2.0), f32(3.0), f32(4.0));
	// Classification is a bit test in Loke source, not a runtime call: no
	// `declare` of any kind belongs to it.
	_ = math.is_nan(1.0);
	_ = math.abs_f32(f32(-1.0));
}
