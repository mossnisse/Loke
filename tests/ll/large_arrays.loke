package main;

// comments.md A1: a zero value is written whole, and a literal past the
// constant budget is built at run time, not folded one element at a time.
buffer: [16777216]u8;
grid: [1024][1024][1024]u8;

huge :: proc() {
	a := [1000000000]int{1};
	a[5] = 2;
}

main :: proc() {
	buffer[3] = 1;
	grid[1][2][3] = 4;
}
