package main;

// comments.md "Compiler architecture audit (2026-09-28)" (A1):
// Zero values are written whole; literals past the budget are built at run time.
buffer: [16777216]u8;
grid: [1024][1024][1024]u8;

huge :: proc() {
	a := [1000000000]int{1};
	a[5] = 2;
}

main :: proc() {
	buffer[3] = 1;
	grid[1][2][3] = 4;
}
