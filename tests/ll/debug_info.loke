package main;

import "core:fmt";

// `-g`: each procedure gets a subprogram, each statement's instructions the
// location of the statement's first token, and each local a declaration whose
// type is laid out as the program stores it.
Color :: enum { Red, Green }

Point :: struct {
	x: int,
	next: ^Point,
}

Shape :: union {
	circle: f64,
	empty: Unit,
}

add :: proc(a: int, b: int) -> int {
	return a + b;
}

main :: proc() {
	total := add(40, 2);
	point := Point{x = total, next = nil};
	color := Color.Green;
	shape: Shape = .circle(1.5);
	name := "loke";
	fmt.println(point.x, color, shape, name);
	fmt.println(steps(3), lookup());
}

// Each loop's `i` and `step` belong to that loop's block, and its condition,
// update, and closing `}` each have a location of their own.
steps :: proc(n: int) -> int {
	sum := 0;
	for (i := 0; i < n; i += 1) {
		step := i;
		sum += step;
	}
	for (i := 0; i < n; i += 1) {
		step := i * 2;
		sum += step;
	}
	return sum;
}

// A map and an `any_view` are described by their headers, and natvis is given
// a typedef for each type its rules cast to (see -g's `.natvis`).
lookup :: proc() -> int {
	ages := map[string]int{"Bob" = 2};
	view: any_view = ages["Bob"];
	fmt.println(view);
	return ages.len();
}
