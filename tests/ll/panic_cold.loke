package main;

// design-review-2026-10-31.md "6.4 Checked arithmetic and bounds in loops":
// the runtime entries that end the program are declared `cold noreturn`, and
// the branch to a checked operation's panic carries weights saying it is not
// taken: an overflow and a bounds check here. `panic_begin` returns, to let a
// formatted report's arguments print, so it is only `cold`.

import "core:fmt";
import "core:os";

main :: proc() {
	xs := [3]int{1, 2, 3};
	n := os.args.len();
	fmt.println(xs[n] + n);
}
