package main; import "core:fmt";

Vec :: struct { x: i32 }
Error :: union { i32 }

impl Vec {
	double :: proc(self) -> i32 { return self.x * 2; }
	add :: operator(+) proc(a, b: Vec) -> Vec { return {a.x + b.x}; }
}

step :: proc() -> (int, Error) { return 1, nil; }

propagate :: proc() -> (n: int, err: Error) {
	defer fmt.println(0);
	n = 0;
	x := step() or_return;
	n = x;
	return;
}

main :: proc() {
	v := Vec{3};
	fmt.println(int(v.double()));
	fmt.println(int((v + v).x));

	e: Error = i32(4);
	value, ok := e.as(i32);
	fmt.println(int(value) + (1 if ok else 0));

	switch (t in e) {
	case i32:
		fmt.println(int(t));
	case:
		fmt.println(0);
	}

	n, err := propagate();
	fmt.println(n + (1 if err == nil else 0));
}
