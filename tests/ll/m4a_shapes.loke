package main; import "core:fmt";

Vec :: struct { x: i32 }
Outcome :: union @(failure=failed) { value: i32, failed: }

impl Vec {
	double :: proc(self) -> i32 { return self.x * 2; }
	add :: operator(+) proc(a, b: Vec) -> Vec { return {a.x + b.x}; }
}

step :: proc() -> Outcome { return .value(1); }

propagate :: proc() -> Outcome {
	defer fmt.println(0);
	x := step() or_return;
	return .value(x);
}

main :: proc() {
	v := Vec{3};
	fmt.println(int(v.double()));
	fmt.println(int((v + v).x));

	e: Outcome = .value(4);
	fmt.println(int(e or_else 0) + 1);

	switch (t in e) {
	case .value:
		fmt.println(int(t));
	case:
		fmt.println(0);
	}

	switch (n in propagate()) {
	case .value:  fmt.println(int(n) + 1);
	case .failed: fmt.println(0);
	}
}
