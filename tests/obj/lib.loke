package widget;

// design.md "Build modes": a non-`main` root package compiled
// with `-build-mode=obj`. The object defines the exported symbols and leaves
// its runtime and CRT references unresolved for the C host to supply.

@(export)
widget_add :: proc "c" (a: i32, b: i32) -> i32 {
	return a + b;
}

@(export, link_name="widget_answer")
answer :: proc "c" () -> i32 {
	return 42;
}

@(export)
widget_counter: i32 = 7;

Status :: enum i32 { Ready = 37 }

@(export)
widget_echo_enum :: proc "c" (value: Status) -> Status { return value; }

// design.md "Foreign-ABI-safe types": a byte-aligned record too large for a
// register crosses as the address of a copy, which Windows x64 aligns to 16
// bytes. The host's probe reports where the copy it was handed sits.
Wide :: struct { bytes: [17]u8 }

@(export)
widget_pass_wide :: proc "c" (probe: proc "c" (wide: Wide) -> i32) -> i32 {
	return probe(Wide{});
}
