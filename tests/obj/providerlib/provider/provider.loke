@(public)
package provider;

import "core:log";
import "core:mem";

// The factories the object build selects, plus the process-lifetime state they
// retain (design.md "Build-selected providers").

@(private)
storage: static [8192]u8 = {};

@(private)
region: static mem.Arena = {};

@(private)
allocators: static int = 0;

@(private)
loggers: static int = 0;

@(private)
written: static int = 0;

@(private)
fallback: static Allocator = {};

// design.md "Floating-point operators": the host calls the initializer while
// rounding upward, and the factory must still round to nearest. The host
// defines `provider_one`, 1, so nothing folds.
foreign import host "system:legacy_stdio_definitions.lib";
foreign host {
	provider_one: f64;
}

@(private)
nearest: static bool = false;

allocator_factory :: proc() -> Allocator {
	allocators += 1;
	nearest = provider_one + 1.1102230246251565e-16 == provider_one;  // 2^-53
	// Nothing is published yet, so this is the runtime's own fallback — kept so
	// the host can check that publication actually replaced it.
	fallback = mem.default_allocator();
	region = mem.Arena.from_buffer(&mut storage[:]);
	return region.allocator();
}

logger_factory :: proc() -> log.Logger {
	loggers += 1;
	return (log.Logger)(&mut sink);
}

@(private)
Sink :: struct {}

@(private)
sink: static Sink = {};

impl Sink {
	write :: proc(self: inout, level: log.Level, message: string_view) { written += 1; }
}

allocator_calls :: proc() -> int { return allocators; }
rounded_to_nearest :: proc() -> bool { return nearest; }
logger_calls :: proc() -> int { return loggers; }
records :: proc() -> int { return written; }
selected_allocator :: proc() -> Allocator { return region.allocator(); }
fallback_allocator :: proc() -> Allocator { return fallback; }
