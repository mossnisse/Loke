package main; import "core:fmt";

WIDTH  :: 72;
HEIGHT :: 28;
LIMIT  :: 32;

escape_time :: proc(cx, cy: f64) -> int {
	x, y := 0.0, 0.0;
	iteration := 0;
	for (iteration < LIMIT && x*x + y*y <= 4.0) {
		next_x := x*x - y*y + cx;
		y = 2.0*x*y + cy;
		x = next_x;
		iteration += 1;
	}
	return iteration;
}

main :: proc() {
	// Each output line is one row's total escape-time "ink". The values rise
	// around the main cardioid and make a compact numerical silhouette.
	for (row := 0; row < HEIGHT; row += 1) {
		cy := -1.15 + f64(row)*2.3/f64(HEIGHT - 1);
		ink := 0;
		for (column := 0; column < WIDTH; column += 1) {
			cx := -2.2 + f64(column)*3.2/f64(WIDTH - 1);
			ink += escape_time(cx, cy);
		}
		fmt.println(ink);
	}
}
