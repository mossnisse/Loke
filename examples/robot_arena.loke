package main; import "core:fmt";

Vec2 :: struct { x, y: int }

impl Vec2 {
	add :: operator(+) proc(a, b: Vec2) -> Vec2 {
		return {a.x + b.x, a.y + b.y};
	}

	equal :: operator(==) proc(a, b: Vec2) -> bool {
		return a.x == b.x && a.y == b.y;
	}
}

Direction :: enum { North, East, South, West }
Command   :: enum { Forward, Left, Right, Zap }

Robot :: struct {
	name:      string,
	position:  Vec2,
	direction: Direction,
	energy:    int,
	points:    int,
}

direction_vector :: proc(direction: Direction) -> Vec2 {
	switch (direction) {
	case .North: return {0, -1};
	case .East:  return {1, 0};
	case .South: return {0, 1};
	case .West:  return {-1, 0};
	}
	return {};
}

turn :: proc(direction: Direction, clockwise: bool) -> Direction {
	value := int(direction) + (1 if clockwise else 3);
	return Direction(value % 4);
}

impl Robot {
	status :: proc(self, number: int) {
		// Robot number, x, y, energy, and score.
		fmt.println(number);
		fmt.println(self.position.x);
		fmt.println(self.position.y);
		fmt.println(self.energy);
		fmt.println(self.points);
	}

	act :: proc(self: inout Robot, command: Command, other: inout Robot) {
		if (self.energy <= 0) { return; }
		switch (command) {
		case .Left:
			self.direction = turn(self.direction, false);
		case .Right:
			self.direction = turn(self.direction, true);
		case .Forward:
			destination := self.position + direction_vector(self.direction);
			if (destination.x >= 0 && destination.x < 9 &&
				destination.y >= 0 && destination.y < 7 && destination != other.position) {
				self.position = destination;
			} else {
				self.energy -= 1;
			}
		case .Zap:
			self.energy -= 2;
			delta := other.position + Vec2{-self.position.x, -self.position.y};
			if (delta.x*delta.x + delta.y*delta.y <= 4) {
				other.energy = 0 if other.energy <= 3 else other.energy - 3;
				self.points += 1;
			}
		}
	}
}

main :: proc() {
	ada := Robot{"Ada", {1, 3}, .East, 12, 0};
	loki := Robot{"Loki", {7, 3}, .West, 12, 0};
	ada_program := [12]Command{
		.Forward, .Forward, .Zap, .Forward, .Zap, .Left,
		.Forward, .Right, .Zap, .Forward, .Zap, .Forward,
	};
	loki_program := [12]Command{
		.Forward, .Forward, .Zap, .Forward, .Zap, .Right,
		.Forward, .Left, .Zap, .Forward, .Zap, .Forward,
	};

	foreach (round in 0 ..< len(ada_program)) {
		fmt.println(100 + round + 1); // round marker
		ada.act(ada_program[round], inout loki);
		loki.act(loki_program[round], inout ada);
		ada.status(1);
		loki.status(2);
	}
	// The managed names are real runtime strings; print their byte lengths along
	// with the winning robot number so the text feature participates too.
	fmt.println(len(ada.name));
	fmt.println(len(loki.name));
	fmt.println(1 if ada.points > loki.points else 2);
}
