package main;

import "core:fmt";
import "core:fs";
import "core:io";
import "core:os";
import "core:path";
import "core:strings";

// Loke's lexer, in Loke: grammar.md "Lexical structure" as src/lexer.odin
// implements it, token for token. Given a file it prints each token as
// `lokec -dump-tokens` does, `lo hi Kind` with the byte span, and each
// diagnostic's byte offset and code on stderr, exiting 1 if there was one.
// Given a directory it lexes every `.loke` file beneath it and prints the
// totals, which is the lexer of a compiler-sized program run over a corpus.
//
// The scan works on bytes: everything outside a literal or a comment is ASCII,
// and a byte offset is what a span holds. Each step takes the offset it starts
// at and returns the token, whose `hi` is where the next one starts.
//
// Usage: lexer <file.loke | directory>

Kind :: enum {
	EOF, Error,
	Ident, Int, Float, String, Raw_String, Rune,
	// keywords, reserved in every position
	Break, Case, Continue, Defer, Distinct, Dyn, Dynamic, Else, Enum, For, Foreach,
	Foreign, Hook, If, Impl, Import, In, Inout, Interface, Map, Move, Move_Only, Mut,
	Operator, Or_Else, Or_Return, Package, Proc, Return, Struct, Switch, Type, Union,
	Via, When, Where,
	// operators and punctuation
	Plus, Minus, Star, Slash, Percent, Amp, Amp_Tilde, Pipe, Tilde, Shl, Shr, And_And,
	Or_Or, Not, Eq_Eq, Not_Eq, Lt, Lt_Eq, Gt, Gt_Eq, Assign, Plus_Eq, Minus_Eq,
	Star_Eq, Slash_Eq, Percent_Eq, Pipe_Eq, Tilde_Eq, Amp_Eq, Amp_Tilde_Eq, Shl_Eq,
	Shr_Eq, Colon, Semicolon, Comma, Period, Range, Range_Incl, Range_Excl, Arrow,
	Uninit, Question, Dollar, Caret, At, Lparen, Rparen, Lbracket, Rbracket, Lbrace,
	Rbrace,
}

Token :: struct { kind: Kind, lo: int, hi: int }

// The compiler's diagnostic code; the wording stays the compiler's business.
Diagnostic :: struct { code: string, at: int }

Totals :: struct { files: int, tokens: int, diagnostics: int }

main :: proc() {
	if (os.args.len() != 2) {
		fmt.eprintln("usage: lexer <file.loke | directory>");
		os.exit(2);
	}
	target := os.args[1];
	is_directory := false;
	switch (metadata in fs.metadata(target)) {
	case .ok:  is_directory = metadata.kind == .Directory;
	case .err:
		fmt.eprintln("cannot read", target, "-", metadata);
		os.exit(1);
	}
	if (is_directory) {
		totals := Totals{};
		switch (walked in walk(target, inout totals)) {
		case .ok:
		case .err:
			fmt.eprintln("cannot read", target, "-", walked);
			os.exit(1);
		}
		fmt.println(totals.files, "files,", totals.tokens, "tokens,", totals.diagnostics, "diagnostics");
		return;
	}
	found: [dynamic]Diagnostic = {};
	switch (tokens in lex_file(target, inout found)) {
	case .ok:
		foreach (token in tokens) { fmt.println(token.lo, token.hi, token.kind); }
	case .err:
		fmt.eprintln("cannot read", target, "-", tokens);
		os.exit(1);
	}
	foreach (diagnostic in found) { fmt.eprintln(diagnostic.at, diagnostic.code); }
	if (found.len() > 0) { os.exit(1); }
}

// Every `.loke` file beneath `directory`, lexed and counted.
walk :: proc(directory: string_view, totals: inout Totals) -> Result(Unit, io.Error) {
	reader := fs.read_directory(directory) or_return;
	for (;;) {
		switch (reader.next() or_return) {
		case .some(entry):
			child := path.join([]string_view{directory, entry.name});
			if (entry.kind == .Directory) {
				walk(child, inout totals) or_return;
			} else if (entry.kind == .File && path.extension(entry.name) == ".loke") {
				found: [dynamic]Diagnostic = {};
				totals.files += 1;
				totals.tokens += (lex_file(child, inout found) or_return).len();
				totals.diagnostics += found.len();
			}
		case .none: return .ok;
		}
	}
}

// A file's tokens. One that is not UTF-8 has none: the compiler diagnoses it
// before lexing.
lex_file :: proc(file: string_view, found: inout [dynamic]Diagnostic) -> Result([dynamic]Token, io.Error) {
	bytes := fs.read_bytes(file) or_return;
	switch (text in string_view.from_utf8(bytes[:])) {
	case .some: return .ok(lex(text, inout found));
	case .none:
		error(inout found, "L0003", 0);
		return .ok({});
	}
}

// The whole token stream, ending with `EOF`, as src/lexer.odin's `lex`.
lex :: proc(text: string_view, found: inout [dynamic]Diagnostic) -> [dynamic]Token {
	tokens: [dynamic]Token = {};
	src := text.bytes();
	// grammar.md: a source file is UTF-8 *without* a byte order mark.
	if (strings.starts_with(text, "\uFEFF")) {
		error(inout found, "L0002", 0);
		return tokens;
	}
	at := 0;
	for (;;) {
		at = skip_trivia(src, at, inout found);
		token := next_token(src, at, inout found);
		tokens.append(token);
		if (token.kind == .EOF) { return tokens; }
		at = token.hi;
	}
}

// The byte at `at`, or 0 past the end, so a lookahead needs no bounds test.
peek :: proc(src: []u8, at: int) -> u8 {
	if (at < src.len()) { return src[at]; }
	return 0;
}

matches :: proc(src: []u8, at: int, text: string_view) -> bool {
	wanted := text.bytes();
	if (at + wanted.len() > src.len()) { return false; }
	foreach (b, i in wanted.indexed()) {
		if (src[at + i] != b) { return false; }
	}
	return true;
}

is_digit :: proc(ch: u8) -> bool { return ch >= '0' && ch <= '9'; }

is_hex :: proc(ch: u8) -> bool {
	return is_digit(ch) || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F');
}

hex_value :: proc(ch: u8) -> u32 {
	if (ch <= '9') { return u32(ch - '0'); }
	if (ch <= 'F') { return u32(ch - 'A' + 10); }
	return u32(ch - 'a' + 10);
}

is_ident_start :: proc(ch: u8) -> bool {
	return ch == '_' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
}

is_ident_part :: proc(ch: u8) -> bool { return is_ident_start(ch) || is_digit(ch); }

at_literal_end :: proc(src: []u8, at: int) -> bool {
	return at >= src.len() || src[at] == '\n' || src[at] == '\r';
}

ident_end :: proc(src: []u8, from: int) -> int {
	at := from;
	for (at < src.len() && is_ident_part(src[at])) { at += 1; }
	return at;
}

digits_end :: proc(src: []u8, from: int) -> int {
	at := from;
	for (at < src.len() && (is_digit(src[at]) || src[at] == '_')) { at += 1; }
	return at;
}

error :: proc(found: inout [dynamic]Diagnostic, code: string_view, at: int) {
	found.append(Diagnostic{strings.copy(code), at});
}

skip_trivia :: proc(src: []u8, from: int, found: inout [dynamic]Diagnostic) -> int {
	at := from;
	for (at < src.len()) {
		switch (src[at]) {
		case ' ', '\t', '\r', '\n': at += 1;
		case '/':
			if (peek(src, at + 1) == '/') {
				for (at < src.len() && src[at] != '\n') { at += 1; }
			} else if (peek(src, at + 1) == '*') {
				at = block_comment(src, at, inout found);
			} else {
				return at;
			}
		case: return at;
		}
	}
	return at;
}

// Block comments nest, so this counts depth rather than scanning for the first
// `*/`.
block_comment :: proc(src: []u8, from: int, found: inout [dynamic]Diagnostic) -> int {
	at := from;
	depth := 0;
	for (at < src.len()) {
		if (matches(src, at, "/*")) {
			depth += 1;
			at += 2;
		} else if (matches(src, at, "*/")) {
			depth -= 1;
			at += 2;
			if (depth == 0) { return at; }
		} else {
			at += 1;
		}
	}
	error(inout found, "L0103", from);
	return at;
}

next_token :: proc(src: []u8, lo: int, found: inout [dynamic]Diagnostic) -> Token {
	if (lo >= src.len()) { return {.EOF, lo, lo}; }
	ch := src[lo];
	if (is_ident_start(ch)) { return {keyword(src, lo, ident_end(src, lo)), lo, ident_end(src, lo)}; }
	if (is_digit(ch)) { return number(src, lo, inout found); }
	if (ch == '"') { return string_literal(src, lo, inout found); }
	if (ch == '`') { return raw_string_literal(src, lo, inout found); }
	if (ch == '\'') { return rune_literal(src, lo, inout found); }
	if (ch >= 0x80) {
		// Everything outside strings, comments and rune literals is ASCII.
		at := lo + 1;
		for (at < src.len() && src[at] >= 0x80) { at += 1; }
		error(inout found, "L0102", lo);
		return {.Error, lo, at};
	}
	return punctuation(src, lo, inout found);
}

// Contextual keywords and shadowable predeclared names remain identifiers.
keyword :: proc(src: []u8, lo: int, hi: int) -> Kind {
	// An identifier is ASCII, so its bytes are a whole view.
	switch (string_view.from_utf8(src[lo:hi]) or_else "") {
	case "break":     return .Break;
	case "case":      return .Case;
	case "continue":  return .Continue;
	case "defer":     return .Defer;
	case "distinct":  return .Distinct;
	case "dyn":       return .Dyn;
	case "dynamic":   return .Dynamic;
	case "else":      return .Else;
	case "enum":      return .Enum;
	case "for":       return .For;
	case "foreach":   return .Foreach;
	case "foreign":   return .Foreign;
	case "hook":      return .Hook;
	case "if":        return .If;
	case "impl":      return .Impl;
	case "import":    return .Import;
	case "in":        return .In;
	case "inout":     return .Inout;
	case "interface": return .Interface;
	case "map":       return .Map;
	case "move":      return .Move;
	case "move_only": return .Move_Only;
	case "mut":       return .Mut;
	case "operator":  return .Operator;
	case "or_else":   return .Or_Else;
	case "or_return": return .Or_Return;
	case "package":   return .Package;
	case "proc":      return .Proc;
	case "return":    return .Return;
	case "struct":    return .Struct;
	case "switch":    return .Switch;
	case "type":      return .Type;
	case "union":     return .Union;
	case "via":       return .Via;
	case "when":      return .When;
	case "where":     return .Where;
	case:             return .Ident;
	}
}

number :: proc(src: []u8, lo: int, found: inout [dynamic]Diagnostic) -> Token {
	at := lo;
	base := peek(src, lo + 1);
	if (src[lo] == '0' && (base == 'b' || base == 'o' || base == 'x')) {
		at += 2;
		digits := 0;
		for (at < src.len()) {
			ch := src[at];
			valid := is_hex(ch);
			if (base == 'b') { valid = ch == '0' || ch == '1'; }
			if (base == 'o') { valid = ch >= '0' && ch <= '7'; }
			if (!valid && ch != '_') { break; }
			if (ch != '_') { digits += 1; }
			at += 1;
		}
		// With a tail still to come (`0o8`, `0xzz`) `number_end` gives the better
		// message; L0110 is for a prefix with nothing after it at all.
		if (digits == 0 && !is_ident_part(peek(src, at))) {
			error(inout found, "L0110", lo);
			return {.Error, lo, at};
		}
		return number_end(src, lo, at, .Int, inout found);
	}

	kind := Kind.Int;
	at = digits_end(src, at);
	// A float needs a digit after the point, which is what keeps `1..5` from
	// swallowing the range operator.
	if (peek(src, at) == '.' && is_digit(peek(src, at + 1))) {
		kind = .Float;
		at = digits_end(src, at + 1);
	}
	if (peek(src, at) == 'e' || peek(src, at) == 'E') {
		offset := 1;
		if (peek(src, at + 1) == '+' || peek(src, at + 1) == '-') { offset = 2; }
		if (!is_digit(peek(src, at + offset))) {
			// Take a bad exponent as one token, like other malformed numbers.
			error(inout found, "L0112", lo);
			return {.Error, lo, ident_end(src, at + offset)};
		}
		kind = .Float;
		at += offset;
		for (at < src.len() && is_digit(src[at])) { at += 1; }
	}
	return number_end(src, lo, at, kind, inout found);
}

// A number never abuts a name: `0b12`, `123abc` and `1_000u` are typos, not
// two tokens; consuming the tail keeps the parser from tripping over a stray
// identifier a line later.
number_end :: proc(src: []u8, lo: int, at: int, kind: Kind, found: inout [dynamic]Diagnostic) -> Token {
	if (!is_ident_part(peek(src, at))) { return {kind, lo, at}; }
	error(inout found, "L0113", lo);
	return {.Error, lo, ident_end(src, at)};
}

escape :: proc(src: []u8, lo: int, found: inout [dynamic]Diagnostic) -> (end: int, valid: bool) {
	at := lo + 1; // the backslash
	// A line ending is not something a backslash escapes. Leaving it unconsumed
	// is what lets the caller end the literal here instead of scanning into the
	// next line looking for a closing quote.
	if (at_literal_end(src, at)) {
		error(inout found, "L0105", lo);
		return {at, false};
	}
	ch := src[at];
	at += 1;
	switch (ch) {
	case 'a', 'b', 'e', 'f', 'n', 'r', 't', 'v', '\\', '"', '\'':
		return {at, true};
	case 'x', 'u', 'U':
		count := 2 if ch == 'x' else (4 if ch == 'u' else 8);
		value: u32 = 0;
		for (i := 0; i < count; i += 1) {
			if (!is_hex(peek(src, at))) {
				error(inout found, "L0105", lo);
				return {at, false};
			}
			value = value * 16 + hex_value(src[at]);
			at += 1;
		}
		// `\x` is a raw byte; `\u` and `\U` name a character, and the surrogate
		// range has no character in it.
		if (ch != 'x' && (value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff))) {
			error(inout found, "L0114", lo);
			return {at, false};
		}
		return {at, true};
	case:
		// A digit would be C's octal byte escape, which Loke does not have.
		error(inout found, "L0105", lo);
		return {at, false};
	}
}

string_literal :: proc(src: []u8, lo: int, found: inout [dynamic]Diagnostic) -> Token {
	at := lo + 1;
	valid := true;
	for (;;) {
		if (at_literal_end(src, at)) {
			error(inout found, "L0104", lo);
			return {.Error, lo, at};
		}
		if (src[at] == '"') { return {Kind.String if valid else .Error, lo, at + 1}; }
		if (src[at] == '\\') {
			end, escaped := escape(src, at, inout found);
			at = end;
			valid = escaped && valid;
			// The escape already diagnosed the literal ending.
			if (!escaped && at_literal_end(src, at)) { return {.Error, lo, at}; }
		} else {
			at += 1;
		}
	}
}

raw_string_literal :: proc(src: []u8, lo: int, found: inout [dynamic]Diagnostic) -> Token {
	at := lo + 1;
	for (at < src.len() && src[at] != '`') { at += 1; }
	if (at >= src.len()) {
		error(inout found, "L0111", lo);
		return {.Error, lo, at};
	}
	return {.Raw_String, lo, at + 1};
}

rune_literal :: proc(src: []u8, lo: int, found: inout [dynamic]Diagnostic) -> Token {
	at := lo + 1;
	if (at_literal_end(src, at)) {
		error(inout found, "L0106", lo);
		return {.Error, lo, at};
	}
	// Consume a closed but empty literal without scanning past it.
	if (src[at] == '\'') {
		error(inout found, "L0107", lo);
		return {.Error, lo, at + 1};
	}

	valid := true;
	if (src[at] == '\\') {
		at, valid = escape(src, at, inout found);
	} else {
		// One Unicode scalar: step over a whole UTF-8 sequence.
		at += 1;
		for (at < src.len() && src[at] >= 0x80 && src[at] < 0xc0) { at += 1; }
	}

	if (peek(src, at) != '\'') {
		for (!at_literal_end(src, at) && src[at] != '\'') { at += 1; }
		if (peek(src, at) == '\'') {
			at += 1;
			if (valid) { error(inout found, "L0107", lo); }
		} else if (valid) {
			error(inout found, "L0106", lo);
		}
		return {.Error, lo, at};
	}
	return {Kind.Rune if valid else .Error, lo, at + 1};
}

Spelling :: struct { text: string_view, kind: Kind }

// First match wins, so longer operators must precede their prefixes. `:` stays
// separate because `::` and `:=` are token pairs.
OPERATORS :: [?]Spelling{
	{"&~=", .Amp_Tilde_Eq}, {"..=", .Range_Incl}, {"..<", .Range_Excl}, {"<<=", .Shl_Eq},
	{">>=", .Shr_Eq}, {"---", .Uninit}, {"&~", .Amp_Tilde}, {"&&", .And_And},
	{"||", .Or_Or}, {"==", .Eq_Eq}, {"!=", .Not_Eq}, {"<=", .Lt_Eq}, {">=", .Gt_Eq},
	{"<<", .Shl}, {">>", .Shr}, {"+=", .Plus_Eq}, {"-=", .Minus_Eq}, {"*=", .Star_Eq},
	{"/=", .Slash_Eq}, {"%=", .Percent_Eq}, {"|=", .Pipe_Eq}, {"~=", .Tilde_Eq},
	{"&=", .Amp_Eq}, {"->", .Arrow}, {"..", .Range}, {"+", .Plus}, {"-", .Minus},
	{"*", .Star}, {"/", .Slash}, {"%", .Percent}, {"&", .Amp}, {"|", .Pipe},
	{"~", .Tilde}, {"!", .Not}, {"<", .Lt}, {">", .Gt}, {"=", .Assign}, {":", .Colon},
	{";", .Semicolon}, {",", .Comma}, {".", .Period}, {"?", .Question}, {"$", .Dollar},
	{"^", .Caret}, {"@", .At}, {"(", .Lparen}, {")", .Rparen}, {"[", .Lbracket},
	{"]", .Rbracket}, {"{", .Lbrace}, {"}", .Rbrace},
};

punctuation :: proc(src: []u8, lo: int, found: inout [dynamic]Diagnostic) -> Token {
	foreach (op in OPERATORS) {
		if (matches(src, lo, op.text)) { return {op.kind, lo, lo + op.text.len()}; }
	}
	error(inout found, "L0101", lo);
	return {.Error, lo, lo + 1};
}
