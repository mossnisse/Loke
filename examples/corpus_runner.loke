package main;

import "core:fmt";
import "core:fs";
import "core:io";
import "core:mem";
import "core:os";
import "core:path";
import "core:process";
import "core:slice";
import "core:strings";
import "core:thread";

// A test harness in Loke: the shape of the Odin suite's corpora. A case is a
// `<case>.loke` file in the corpus directory, or a `<case>` package directory
// with a `<case>.expected` beside it. The harness compiles each case, runs it,
// and compares its stdout with `<case>.expected` and its stderr with
// `<case>.expected-err` when there is one. A case must exit 0, or under
// `-trap` must fail, with a `.expected-err` naming how; there `.expected` is
// optional. Under `-diagnostics` a case must not compile, and its `.expected`
// lists what the diagnostics say (`diagnosed`); `-syntax` is the same for a
// parse, which must also recover as far as the file's trailing `sentinel`.
// Under `-ir` a case must compile, and each line of its `.expected` is a shape
// its LLVM IR must contain (`ir_contains`). A `<case>.flags` file adds one
// compiler flag per line. Cases run on a thread per processor, and are reported
// in name order once all have finished.
//
// Usage: corpus_runner <compiler> <corpus directory> <scratch directory> [-trap | -diagnostics | -syntax | -ir]

Mode :: enum { Run, Trap, Diagnostics, Syntax, Ir }

main :: proc() {
	mode := Mode.Run;
	if (os.args.len() == 5) {
		switch (named in mode_named(os.args[4])) {
		case .some: mode = named;
		case .none: usage();
		}
	} else if (os.args.len() != 4) {
		usage();
	}
	compiler, corpus, scratch := os.args[1], os.args[2], os.args[3];
	cases: [dynamic]string = {};
	switch (listed in sources(corpus)) {
	case .ok:  cases = move(listed);
	case .err:
		fmt.eprintln("cannot read", corpus, "-", listed);
		os.exit(2);
	}
	reasons: [dynamic]Option(string) = {};
	reasons.resize(cases.len());
	board := shared(thread.Mutex(Board){value = {reasons = move(reasons)}});
	{
		workers: [dynamic]thread.Thread = {};
		for (i := 0; i < thread.processor_count() && i < cases.len(); i += 1) {
			workers.append(thread.spawn(work, Job{compiler, corpus, scratch, cases.clone(), mode, board.clone()}));
		}
	} // dropping a worker joins it
	passed, failed := 0, 0;
	guard := board.get().lock();
	foreach (name, index in cases.indexed()) {
		switch (reason in guard.get().reasons[index]) {
		case .none:
			fmt.println("ok  ", name);
			passed += 1;
		case .some:
			fmt.println("FAIL", name, "-", reason);
			failed += 1;
		}
	}
	fmt.println(passed, "passed,", failed, "failed");
	if (failed > 0) { os.exit(1); }
}

mode_named :: proc(flag: string_view) -> Option(Mode) {
	if (flag == "-trap") { return .some(.Trap); }
	if (flag == "-diagnostics") { return .some(.Diagnostics); }
	if (flag == "-syntax") { return .some(.Syntax); }
	if (flag == "-ir") { return .some(.Ir); }
	return .none;
}

usage :: proc() {
	fmt.eprintln("usage: corpus_runner <compiler> <corpus directory> <scratch directory> [-trap | -diagnostics | -syntax | -ir]");
	os.exit(2);
}

// What the workers share: the next case to take, and each case's outcome.
Board :: struct {
	next:    int,
	// Why each case failed; `.none` once it passed.
	reasons: [dynamic]Option(string),
}

// One worker's copy of the run, which a thread must own.
Job :: struct {
	compiler, corpus, scratch: string,
	cases: [dynamic]string,
	mode:  Mode,
	board: shared(thread.Mutex(Board)),
}

// Takes cases until none are left. A case's processes are what take the time,
// so holding the lock only to take a case and to record it is enough.
work :: proc(job: move Job) {
	for (;;) {
		index := 0;
		{
			guard := job.board.get().lock();
			index = guard.get().next;
			guard.get().next += 1;
		}
		if (index >= job.cases.len()) { return; }
		switch (check(job.compiler, job.corpus, job.scratch, job.cases[index], job.mode)) {
		case .ok:
		case .err(reason):
			guard := job.board.get().lock();
			guard.get().reasons[index] = .some(reason);
		}
	}
}

// The directory's cases, by name, so every run reports in one order. A
// directory with no `.expected` beside it is not a case but something one
// imports, as `tests/trap/providers` is.
sources :: proc(directory: string_view) -> Result([dynamic]string, io.Error) {
	reader := fs.read_directory(directory) or_return;
	names: [dynamic]string = {};
	for (;;) {
		switch (reader.next() or_return) {
		case .some(entry):
			file := entry.kind == .File && path.extension(entry.name) == ".loke";
			if (file || entry.kind == .Directory && (fs.exists(sibling(directory, entry.name, ".expected")) or_else false)) {
				names.append(strings.copy(entry.name));
			}
		case .none:
			slice.sort(names[:]);
			return .ok(move(names));
		}
	}
}

// One case: why it failed, or nothing.
check :: proc(
	compiler: string_view, corpus: string_view, scratch: string_view, entry: string_view, mode: Mode,
) -> Result(Unit, string) {
	name := path.stem(entry);
	source := path.join([]string_view{corpus, entry});
	exe := sibling(scratch, name, ".exe");
	arguments := [dynamic]string_view{source, "-o", exe};
	if (mode == .Syntax) {
		arguments.append("-dump-ast");
	} else if (mode != .Run && mode != .Trap) {
		arguments.append("-emit-ll");
	}
	flags := read(sibling(corpus, name, ".flags")) or_else "";
	foreach (flag in strings.lines(flags)) {
		if (strings.trim_space(flag).len() > 0) { arguments.append(strings.trim_space(flag)); }
	}

	built := run(process.Command{program = compiler, arguments = arguments[:]}) or_return;
	expected := read(sibling(corpus, name, ".expected"));
	if (mode == .Diagnostics || mode == .Syntax || mode == .Ir) {
		switch (wanted in expected) {
		case .some:
			if (mode == .Ir) { return shaped(sibling(scratch, name, ".ll"), built, wanted); }
			// The AST is printed before the diagnostics, so the sentinel's node in
			// it shows the parser recovered past every error to the end.
			if (mode == .Syntax && !strings.contains(text(built.stdout[:]), "(const names=[\"sentinel\"]")) {
				return .err("recovery did not reach the trailing sentinel");
			}
			return diagnosed(source, text(built.stderr[:]), built.status, wanted);
		case .none: return .err("has no .expected");
		}
	}
	trap := mode == .Trap;
	if (built.status != 0) {
		return .err(fmt.to_string(mem.default_allocator(), "does not compile:", text(built.stderr[:])));
	}
	ran := run(process.Command{program = exe}) or_return;

	expected_err := read(sibling(corpus, name, ".expected-err"));
	if (trap && ran.status == 0) { return .err("exited 0"); }
	if (trap && expected_err == .none) { return .err("has no .expected-err naming the failure"); }
	if (!trap && ran.status != 0) { return .err(fmt.to_string(mem.default_allocator(), "exited with", ran.status)); }
	if (!trap && expected == .none) { return .err("has no .expected"); }
	switch (wanted in expected) {
	case .some:
		if (normalise(text(ran.stdout[:])) != normalise(wanted)) { return .err("stdout differs"); }
	case .none:
	}
	switch (wanted in expected_err) {
	case .some:
		if (normalise(text(ran.stderr[:])) != normalise(wanted)) { return .err("stderr differs"); }
	case .none:
	}
	return .ok;
}

// The Odin suite's rules for a diagnostic case: the compile exits 1, and each
// line of `.expected` is in its diagnostics, except that one starting `!` must
// not be, `@line:column` is a span they contain, and `@no-span` means they have
// none. The errors, and the warnings located in the case's own file, number
// exactly the lines starting `L0` and `warning[`.
diagnosed :: proc(
	source: string_view, diagnostics: string_view, status: i32, expected: string_view,
) -> Result(Unit, string) {
	if (status != 1) { return .err(fmt.to_string(mem.default_allocator(), "exited with", status, "not 1")); }
	output := normalise(diagnostics);
	wanted := normalise(expected);
	errors, warnings := 0, 0;
	foreach (raw in strings.lines(wanted)) {
		line := strings.trim_space(raw);
		if (line.len() == 0) { continue; }
		if (strings.starts_with(line, "!")) {
			if (strings.contains(output, line[1:])) {
				return .err(fmt.to_string(mem.default_allocator(), "mentions", line[1:]));
			}
		} else if (line == "@no-span") {
			if (strings.contains(output, " --> ")) { return .err("has a span"); }
		} else if (strings.starts_with(line, "@")) {
			if (!strings.contains(output, strings.join([]string_view{":", line[1:]}, ""))) {
				return .err(fmt.to_string(mem.default_allocator(), "has no span", line[1:]));
			}
		} else {
			if (strings.starts_with(line, "L0")) { errors += 1; }
			if (strings.starts_with(line, "warning[")) { warnings += 1; }
			if (!strings.contains(output, line)) {
				return .err(fmt.to_string(mem.default_allocator(), "does not mention", line));
			}
		}
	}
	if (strings.count(output, "error[L") != errors) {
		return .err(fmt.to_string(mem.default_allocator(), "has", strings.count(output, "error[L"), "errors, not", errors));
	}
	if (own_warnings(output, source) != warnings) {
		return .err(fmt.to_string(mem.default_allocator(), "has", own_warnings(output, source), "warnings, not", warnings));
	}
	return .ok;
}

// An IR case compiles, and its module holds every line of `.expected`.
//
// ponytail: the Odin suite also assembles each module with clang, since a shape
// can match IR LLVM rejects; this harness would need clang found first.
shaped :: proc(ll: string_view, built: process.Output, expected: string_view) -> Result(Unit, string) {
	if (built.status != 0) {
		return .err(fmt.to_string(mem.default_allocator(), "does not compile:", text(built.stderr[:])));
	}
	ir := read(ll) or_else "";
	wanted := normalise(expected);
	foreach (raw in strings.lines(wanted)) {
		line := strings.trim_space(raw);
		if (line.len() > 0 && !ir_contains(ir, line)) {
			return .err(fmt.to_string(mem.default_allocator(), "IR does not contain", line));
		}
	}
	return .ok;
}

// A `*` in a shape matches any run of characters within one IR line, so a shape
// need not quote a numbered type name, and cannot be made of two instructions.
ir_contains :: proc(ir: string_view, shape: string_view) -> bool {
	if (!strings.contains(shape, "*")) { return strings.contains(ir, shape); }
	foreach (line in strings.lines(ir)) {
		if (line_matches(line, shape)) { return true; }
	}
	return false;
}

line_matches :: proc(line: string_view, shape: string_view) -> bool {
	at := 0;
	foreach (segment in strings.split(shape, "*")) {
		switch (strings.index(line[at:], segment)) {
		case .some(found): at += found + segment.len();
		case .none:        return false;
		}
	}
	return true;
}

// Warnings located in `source`. One raised inside `core` or `base`, as
// `-copy-cost=1` raises for every copy a program makes, is not the case's to list.
own_warnings :: proc(output: string_view, source: string_view) -> int {
	file := strings.replace(source, "\\", "/");
	count := 0;
	pending := false;
	foreach (raw in strings.lines(output)) {
		line := strings.trim_space(raw);
		if (strings.starts_with(line, "warning[")) {
			pending = true;
		} else if (pending && strings.starts_with(line, "--> ")) {
			if (strings.contains(strings.replace(line, "\\", "/"), file)) { count += 1; }
			pending = false;
		}
	}
	return count;
}

run :: proc(command: process.Command) -> Result(process.Output, string) {
	switch (outcome in process.output(command)) {
	case .ok:  return .ok(move(outcome));
	case .err: return .err(fmt.to_string(mem.default_allocator(), "cannot run", command.program, "-", outcome));
	}
}

sibling :: proc(directory: string_view, name: string_view, extension: string_view) -> string {
	file := strings.join([]string_view{name, extension}, "");
	return path.join([]string_view{directory, file});
}

// A file's text, or `.none` when it cannot be read.
read :: proc(file: string_view) -> Option(string) {
	switch (outcome in fs.read_text(file)) {
	case .ok:  return .some(outcome);
	case .err: return .none;
	}
}

text :: proc(bytes: []u8) -> string_view {
	return string_view.from_utf8(bytes) or_else "<not UTF-8>";
}

// An expected file checked out with CRLF endings still matches.
normalise :: proc(output: string_view) -> string {
	return strings.replace(output, "\r\n", "\n");
}
