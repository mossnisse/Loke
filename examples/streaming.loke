package main;

import "core:fmt";
import "core:fs";
import "core:io";
import "core:os";
import "core:term";

// The three habits the standard library expects of a program that reads files it
// did not write (standard-library "Shared I/O contract"):
//
//   1. a bounded read for untrusted input, so a huge file cannot exhaust memory;
//   2. streaming through a fixed buffer, so size does not decide feasibility;
//   3. an explicit `close`, so a flush failure is observed rather than dropped.
//
// Usage: streaming <path>

// Whole-file, but never more than a megabyte. Exceeding the limit destroys the
// partial result and reports `Limit_Exceeded`.
LIMIT :: 1024 * 1024;

summarize :: proc(path: string_view) -> Result(Unit, io.Error) {
	bytes := fs.read_bytes(path, limit = LIMIT) or_return;
	fmt.println("bytes:", bytes.len());
	return .ok;
}

// The same file again, this time without holding it in memory: one fixed buffer,
// however large the file is.
count_lines :: proc(path: string_view) -> Result(int, io.Error) {
	file := fs.open_read(path) or_return;

	lines := 0;
	window: [4096]u8 = {};
	for (;;) {
		switch (file.read(window[:])) {
		case .ok(count):
			foreach (index in 0 ..< count) {
				if (window[index] == u8('\n')) { lines += 1; }
			}
		case .err(error):
			if (!io.is(error, .End_Of_Input)) {
				// The close still runs: `file` is a managed local, and its `drop`
				// closes a live handle on every path out of this procedure.
				return .err(error);
			}
			break;
		}
	}

	// The explicit close is the one that can report. `drop` would run anyway, but
	// it cannot tell anyone what it found.
	file.close() or_return;
	return .ok(lines);
}

run :: proc() -> Result(Unit, io.Error) {
	if (os.args.len() < 2) {
		out := term.stderr();
		return io.write_string(inout out, "usage: streaming <path>\n");
	}
	path := os.view_at(1);
	summarize(path) or_return;
	lines := count_lines(path) or_return;
	fmt.println("lines:", lines);
	return .ok;
}

main :: proc() -> i32 {
	switch (outcome in run()) {
	case .ok:
		return 0;
	case .err:
		fmt.eprintln("error:", outcome);
		return 1;
	}
}
